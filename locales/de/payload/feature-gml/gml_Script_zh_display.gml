 ds_map_add(m,"This disgusting old man stinking of pee and semen can't understand. *Slurrrp*","Dieser widerliche alte Mann, der nach Pisse und Sperma stinkt, versteht es einfach nicht. *Schlürf*");
 ds_map_add(m,"Wha-what happened Rynn?","W-was ist passiert, Rynn?");
 ds_map_add(m,"AHHHGG What a pain in the ass!","AHHHG! Was für ein verdammter Mist!");
 ds_map_add(m,"Well then let's make this a unique occasion, open your eyes now.","Dann machen wir daraus ein einmaliges Erlebnis. Öffne jetzt die Augen.");
 ds_map_add(m,"He-he I-I really do not know it is my first time.","Hehe, i-ich weiß es wirklich nicht. Es ist mein erstes Mal.");
