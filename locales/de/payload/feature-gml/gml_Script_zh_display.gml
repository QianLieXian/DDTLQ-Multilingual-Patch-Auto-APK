 ds_map_add(m,"AH, AH-AH, AHHHH, HAVING SEX WITH MY STEPSON IS THE BEST!!!","AH, AH-AH, AHHHH, SEX MIT MEINEM STIEFSOHN IST DAS BESTE!!!");
 ds_map_add(m,"TAKE THIS MAMA ACCEPT MY CHILD IN YOUR WOMB!","NIMM DAS, MAMI! EMPFANG MEIN KIND IN DEINEM MUTTERLEIB!");
 ds_map_add(m,"More, HARDER Aldo! STRONGEREEEEEEEEEEEEEEE CLAIM ME AS YOURS!","Mehr, HÄRTER, Aldo! NOCH HÄRTER! MACH MICH ZU DEINER!");
 ds_map_add(m,"AHh, Ah AHHHH.","AHH, ah, AHHHH.");
 ds_map_add(m,"Look, Aldo, the truth is that...","Hör zu, Aldo, die Wahrheit ist ...");
 ds_map_add(m,"Shit... I'm afraid of what you have to say.","Scheiße ... ich habe Angst vor dem, was du mir sagen musst.");
 ds_map_add(m,"Yeah, hey we need to talk, it is very serious.","Hey, wir müssen reden. Es ist sehr ernst.");
 ds_map_add(m,"You finally came","Endlich bist du da.");
 ds_map_add(m,"Excellent work Line <3.","Ausgezeichnete Arbeit, Line <3.");
 ds_map_add(m,"... Callie asked where you were, you better go see her.","... Callie hat gefragt, wo du bist. Du solltest besser zu ihr gehen.");
 ds_map_add(m,"Oh nothing Lili why so serious hehe?","Ach, nichts, Lili. Warum so ernst, hehe?");
 ds_map_add(m,"Hey... what were you doing?","Hey ... was hast du gemacht?");
 ds_map_add(m,"... you know very well that this is a lie.","... Du weißt ganz genau, dass das eine Lüge ist.");
 ds_map_add(m,"But I assure you we did our best!","Aber ich versichere dir, wir haben unser Bestes gegeben!");
 ds_map_add(m,"I did what I could with my friend... I am sorry if you know any of those affected.","Mein Freund und ich haben getan, was wir konnten ... Es tut mir leid, falls du jemanden kennst, der betroffen ist.");
 ds_map_add(m,"Hey, i-it's not your fault, I-I am trying to be something of a hero too.","Hey, d-das ist nicht deine Schuld. I-ich versuche auch, so etwas wie ein Held zu sein.");
 ds_map_add(m,"Do I really deserve to be alive?","Verdiene ich es wirklich, am Leben zu sein?");
