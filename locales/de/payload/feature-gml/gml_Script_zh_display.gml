 ds_map_add(m,"Callie invited you to have lunch, go to her house during the day.","Callie hat dich zum Mittagessen eingeladen. Geh tagsüber zu ihr nach Hause.");
 ds_map_add(m,"A beautiful family","Eine wundervolle Familie");
 ds_map_add(m,"Where will the sister be?","Wo wird die Schwester wohl sein?");
 ds_map_add(m,"What do I do now? I want her to think of me, I want her to hate me, I want her to think of me, I want her to hate me, I want my image to never leave her head again!.","Was soll ich jetzt tun? Ich will, dass sie an mich denkt. Ich will, dass sie mich hasst. Ich will, dass sie an mich denkt. Ich will, dass sie mich hasst. Ich will, dass mein Bild nie wieder aus ihrem Kopf verschwindet!");
