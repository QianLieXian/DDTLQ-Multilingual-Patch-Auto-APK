 ds_map_add(m,"I guess I have nothing left but to clean everything again.","Dann bleibt mir wohl nichts anderes übrig, als alles noch einmal zu putzen.");
 ds_map_add(m,"How could I forget, come Line, Mommy has something just for you hehe..","Wie könnte ich das vergessen? Komm, Line. Mami hat etwas nur für dich, hehe ...");
 ds_map_add(m,"hey don't you owe something to my friend?","Hey, schuldest du meiner Freundin nicht noch etwas?");
