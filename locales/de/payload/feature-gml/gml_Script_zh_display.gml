var s=string(argument0);
if(!variable_global_exists("zh_display_map"))global.zh_display_map=-1;
if(!ds_exists(global.zh_display_map,ds_type_map)){
 global.zh_display_map=ds_map_create();
 var m=global.zh_display_map;
 ds_map_add(m,"Piercing","Stich");
 ds_map_add(m,"Impact","Wucht");
 ds_map_add(m,"Cut","Schnitt");
 ds_map_add(m,"Hp","LP");
 ds_map_add(m,"Mp","MP");
 ds_map_add(m,"Nature","Natur");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Puh, Bigg Daddy! Ich hoffe, dass er mich eines Tages wie seine kleine Tochter behandelt.");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","Irgendwie kannte sie meinen Namen. Vielleicht erfahre ich mehr darüber, wenn ich sie finde.");
 ds_map_add(m,"Ms honney","Ms. Honney");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","Ohh <3, Ms. Honney ist einfach großartig! Sie hat mich nur angesehen und sofort erkannt, wer ich wirklich bin. Ach, fast hätte ich es vergessen: Sie hat mir auch geholfen, Informationen zu bekommen. ");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","Oh, Rynn! Ich erinnere mich, wie sie völlig betrunken in der Taverne saß und irgendetwas davon faselte, dass das Imperium einen Teil der Geschichte ausgelöscht habe. Na ja, ich habe nicht richtig zugehört. Ihre Bauchmuskeln haben mich abgelenkt.");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","Oh, ich erinnere mich an diese arme kleine Frau. Lili hielt sie für ein kleines Mädchen, und sie ist vor Wut fast explodiert. Ach, warum bringt mich diese Fee ständig in Schwierigkeiten ...");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","Alina wartet immer noch auf ihre Freundin. Hoffentlich können die beiden sich bald wiedersehen.");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","Sie war ein äußerst aggressiver Dämon mit ausgeprägtem Revierverhalten. Ich konnte sie nur besiegen, indem ich ihr mit meinen Sukkubuskräften die Energie aussaugte. Hehe. Ich würde sie gern wiedersehen, aber Lili würde mich umbringen.");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","Wegen Callie habe ich ein schrecklich schlechtes Gewissen. Ich wollte nur mit ihr experimentieren, aber stattdessen habe ich sie dazu gebracht, sich in mich zu verlieben. Sie will mich sogar ihren Kindern vorstellen. Manchmal wünschte ich, ich wäre nicht halb Sukkubus. Ich verletze so viele Menschen.");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","Baina Salasaki ... ein Lebenstraum! Sogar meine Mutter kannte sie, und ich durfte tatsächlich mit ihr zusammen sein <3. Auch wenn ich es immer noch ziemlich teuer fand.");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","Oh, diese Katze! Ihretwegen bin ich jetzt neugierig auf erotische Atemkontrolle. Zum Glück ist Lili immer an meiner Seite, falls etwas schiefgeht.");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","Die arme Pussiel. Wegen mir muss sie jetzt dreimal so hart arbeiten :c.");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","Lina war stinksauer, weil sie gegen diese Schleimkatze verloren hatte. Sie bat mich sogar, mit ihr zu trainieren, obwohl ich nicht glaube, dass ihr mein Kampfstil viel bringen wird.");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","Hynoxia ... Ich glaube, sie ist die Frau, die Lili die Hypnosepistole verkauft hat. Was sie wohl sonst noch im Angebot hat?");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","Meine Heldin aus Tricotex! Ich kann kaum glauben, dass wir sie auf der Insel gefunden haben. Hoffentlich kann ich ihr eines Tages wieder helfen, diesmal in ihrer Stadt <3.");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","Sieki hat alle Frauen im VIP-Bereich der Bar unter ihrer Kontrolle. Ich frage mich, wie man so eine Stellung bekommt.");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","Vasuki ist zufällig in diese Dimension geraten. Ich habe ihr geholfen, die Dimensionsrisse zu finden, damit sie nach Hause zurückkehren konnte. Aber aus irgendeinem Grund beschloss sie, bei mir zu bleiben. Mich stört das eigentlich nicht. Vielleicht bin ich ein schrecklicher Mensch.");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","Wie könnte ich sie vergessen? Sie vereint Dominanz und Zärtlichkeit auf perfekte Weise. Ich hoffe, sie findet ihre Lieblingszigaretten. Falls nicht, sehen wir uns vielleicht wieder. Hehe.");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","Kamiko ist genauso wie Lili. Der einzige Unterschied ist, dass sie ungefähr so groß ist wie ich. Na ja, ganz gleich sind sie wohl doch nicht. Lili hat schließlich auch ihre guten Seiten.");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","Sie wollte mir helfen, ein besserer Sukkubus zu werden. Allerdings verbringt sie die meiste Zeit mit Sex, sodass ich sie kaum zu Gesicht bekomme. Vielleicht bringt sie mir ja bei, meine Zeit als Sukkubus nicht zu verschwenden? Ach, warum muss alles so kompliziert sein!");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","Maruia ist eine sehr ehrliche Orkin. Nachdem ich sie im Kampf besiegt hatte, hielt sie ihr Wort. Hm, wenn ich es irgendwie schaffen würde, dass wir noch einmal kämpfen ... Nein! Was denke ich da? Weg mit diesen schlechten Gedanken!");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","Er ist wie ich: Wir sind schüchtern, haben aber auch unsere geheimen Seiten. Hoffentlich kann er besser als ich so tun, als wäre alles ganz normal.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","Mami!!! Ich liebe meine Mami!!!");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","Ein wirklich guter Mensch, der sich sehr um den großen Hauptmann kümmert.");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","Faye ist vermutlich der unangenehmste Mensch, dem ich je begegnet bin. Wenigstens hatten wir am Ende Sex, sonst wäre ich noch verrückt geworden.");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","Bell hat eine so schöne Aufgabe. Ich hoffe, dass er noch mehr von diesen ausgestorbenen Blumen zum Sprießen bringen kann.");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","Lucy ist toll. Bitte enttäusche sie nicht mit ihrem Roman.");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","Miss Marael hat mir eine Seite des Sukkubuslebens gezeigt, die mir vorher niemand zeigen wollte. Dafür bin ich ihr dankbar.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","Lemmy hat Lili erzählt, dass ZONE-tam offenbar ein berühmter Nachrichtenreporter ist. Hm, wenn ich so darüber nachdenke: Warum verstehen sich Lili und Lemmy eigentlich so gut?");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","Gildfried ist großartig und hat einen riesigen Schwanz. Worüber habe ich gerade gesprochen?");
 ds_map_add(m,"Dannie perky","Dannie Perky");
 ds_map_add(m,"Dede restrun","Dede Restrun");
 ds_map_add(m,"Danyelle dower","Danyelle Dower");
 ds_map_add(m,"Debu Euler ku","Debu Euler Ku");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","Das ist Futaba, deine zuverlässige Futanari :0");
 ds_map_add(m,"Pink Slime","Rosa Schleim");
 ds_map_add(m,"Purple Slime","Lila Schleim");
 ds_map_add(m,"Orange Slime","Oranger Schleim");
 ds_map_add(m,"Controls","Steuerung");
 ds_map_add(m,"Settings","Einstellungen");
 ds_map_add(m,"Natural","Natürlich");
 ds_map_add(m,"Quest complete.","Quest abgeschlossen.");
 ds_map_add(m,"Use Vodka","Wodka verwenden");
 ds_map_add(m,"Use Ron","Rum verwenden");
 ds_map_add(m,"Use Beer","Bier verwenden");
 ds_map_add(m,"Use Milch","Milch verwenden");
 ds_map_add(m,"there no items here yet","Hier gibt es noch keine Gegenstände.");
 ds_map_add(m,"Fish","Fisch");
 ds_map_add(m,"it is raw we can not eat it like this Lili, maybe it is better to give it to someone else.","Der ist noch roh. So können wir ihn nicht essen, Lili. Vielleicht geben wir ihn lieber jemand anderem.");
 ds_map_add(m,"Circus flyers","Zirkus-Flyer");
 ds_map_add(m,"I have a lot of pamphlets to deliver, hopefully delivering a few will be enough.","Ich muss noch jede Menge Flyer verteilen. Hoffentlich reicht es, wenn ich ein paar davon loswerde.");
 ds_map_add(m,"Vodka","Wodka");
 ds_map_add(m,"This is my favorite is not that strong <3","Das ist mein Lieblingsgetränk. Es ist gar nicht so stark <3");
 ds_map_add(m,"My Mother Always say rum is like men, the older the better. Mmmm maybe that is why she is with my father, elves live for a long time.","Meine Mutter sagt immer, Rum sei wie Männer: Je älter, desto besser. Hmmm, vielleicht ist das der Grund, warum sie mit meinem Vater zusammen ist. Elfen leben schließlich sehr lange.");
 ds_map_add(m,"Beer","Bier");
 ds_map_add(m,"Iugg, i do not like beer, the worst thing is that when you go to the bathroom, the pee smells very strong.","Igitt, ich mag kein Bier. Das Schlimmste ist, dass der Urin nach dem Toilettengang so stark riecht.");
 ds_map_add(m,"Magic Broom","Magischer Besen");
 ds_map_add(m,"I love this broom <3, my little feet won't hurt anymore.","Ich liebe diesen Besen <3. Meine kleinen Füße werden endlich nicht mehr wehtun.");
 ds_map_add(m,"Tricotex money","Tricotex-Geld");
 ds_map_add(m,"Sam gave me this money, it is 10 dollars to use in Tricotex. I will keep it, who knows if i ever pass by.","Sam hat mir dieses Geld gegeben. Es sind 10 Dollar, die man in Tricotex ausgeben kann. Ich behalte es lieber. Wer weiß, vielleicht komme ich irgendwann dort vorbei.");
 ds_map_add(m,"Autographed photo of Sam","Autogrammfoto von Sam");
 ds_map_add(m,"I still can not believe Sam gave me a picture with his autograph <3.","Ich kann immer noch nicht glauben, dass Sam mir ein Foto mit ihrem Autogramm geschenkt hat <3.");
 ds_map_add(m,"BDSM Master/Slave Contract","BDSM-Herr-Sklave-Vertrag");
 ds_map_add(m,"My contract with Lili, because of my problems I begged her to be my master and help me to practice my succubus powers and force me to try new things <3.","Mein Vertrag mit Lili. Wegen meiner Probleme habe ich sie angefleht, meine Herrin zu werden, mir beim Üben meiner Sukkubuskräfte zu helfen und mich dazu zu bringen, neue Dinge auszuprobieren <3.");
 ds_map_add(m,"Raspberry pie","Himbeerkuchen");
 ds_map_add(m,"I am supposed to recognize the scent of this foot and then guide me through the forest to Marael's house.","Ich soll mir den Geruch dieses Fußes einprägen. Dann kann er mich durch den Wald zu Maraels Haus führen.");
 ds_map_add(m,"Haigure Gun!","Haigure-Pistole!");
 ds_map_add(m,"This gun makes move in a very vulgar way, Just the thought of people watching me, moving uncontrollably while I make a fool of myself makes me so horny.","Diese Pistole bringt einen dazu, sich auf äußerst obszöne Weise zu bewegen. Allein der Gedanke daran, dass andere mir dabei zusehen, wie ich mich unkontrolliert bewege und zum Narren mache, macht mich wahnsinnig geil.");
 ds_map_add(m,"Holy Grail","Heiliger Gral");
 ds_map_add(m,"One of the relics of the islands. I can feel energy emanating from it.","Eines der Relikte der Inseln. Ich kann spüren, wie Energie von ihm ausgeht.");
 ds_map_add(m,"Crystal sphere","Kristallkugel");
 ds_map_add(m,"I found this half buried next to some cats, it looks like something valuable, maybe it will be useful for something.","Ich habe sie halb vergraben neben ein paar Katzen gefunden. Sie sieht wertvoll aus. Vielleicht kann man sie irgendwann gebrauchen.");
 ds_map_add(m,"Oniric incense","Traumweihrauch");
 ds_map_add(m,"This is the best thing in the world! If I use it before I go to sleep I can have lucid dreams of things that happened to me <3.","Das ist das Beste auf der Welt! Wenn ich ihn vor dem Schlafengehen benutze, kann ich luzide Träume haben und Dinge erleben, die mir tatsächlich passiert sind <3.");
 ds_map_add(m,"Gilfried briefcase","Gildfrieds Aktentasche");
 ds_map_add(m,"I have to return this briefcase to Gilfried immediately.","Ich muss Gildfried diese Aktentasche sofort zurückbringen.");
 ds_map_add(m,"Golden Key","Goldener Schlüssel");
 ds_map_add(m,"There is something strange about this key, I feel like it takes my energy somehow.","Mit diesem Schlüssel stimmt etwas nicht. Ich habe das Gefühl, dass er mir irgendwie Energie entzieht.");
 ds_map_add(m,"Smoosher uniforms","Smoosher-Uniformen");
 ds_map_add(m,"The uniform of the Smoosher restaurant smells a little funny.","Die Uniform des Restaurants Smoosher riecht ein wenig seltsam.");
 ds_map_add(m,"Aphrodisiac mushroom.","Aphrodisiakum-Pilz.");
 ds_map_add(m,"Moo Premium Milk","Moo-Premium-Milch");
 ds_map_add(m,"Fura Fura Fruit","Fura-Fura-Frucht");
 ds_map_add(m,"The fura fura fruit has the effect of creating a penis if eaten by a woman.","Die Fura-Fura-Frucht lässt Frauen einen Penis wachsen, wenn sie davon essen.");
 ds_map_add(m,"Hea Hea Fruit","Hea-Hea-Frucht");
 ds_map_add(m,"The hea hea fruit has a very powerful aphrodisiac effect that will make anyone who eats it come into heat.","Die Hea-Hea-Frucht hat eine äußerst starke aphrodisierende Wirkung. Jeder, der sie isst, wird dadurch brünstig.");
 ds_map_add(m,"Smuggled fabrics","Geschmuggelte Stoffe");
 ds_map_add(m,"I understand there was a convict who wanted to sell this, they ended up taking it from her and reselling it themselves (speaking of irony).","Anscheinend wollte eine Gefangene diese Stoffe verkaufen. Am Ende wurden sie ihr abgenommen und von den anderen selbst weiterverkauft. So viel zur Ironie.");
 ds_map_add(m,"Sewing machine","Nähmaschine");
 ds_map_add(m,"Blue crystal key","Blauer Kristallschlüssel");
 ds_map_add(m,"It is a key that was found inside a strange slime.","Ein Schlüssel, der im Inneren eines seltsamen Schleims gefunden wurde.");
 ds_map_add(m,"Purple crystal key","Lila Kristallschlüssel");
 ds_map_add(m,"Pink crystal key","Rosa Kristallschlüssel");
 ds_map_add(m,"Cum jar","Sperma-Glas");
 ds_map_add(m,"Ñom yum yum it looks delicious I will let it ripen a bit before eating <3.","Mjam, mjam! Das sieht köstlich aus. Ich lasse es noch ein wenig reifen, bevor ich es esse <3.");
 ds_map_add(m,"Elf Gloves","Elfenhandschuhe");
 ds_map_add(m,"Elf Boots","Elfenstiefel");
 ds_map_add(m,"Elf Leotard","Elfenanzug");
 ds_map_add(m,"Elf Tank Top","Elfen-Top");
 ds_map_add(m,"Elf Tights","Elfenstrumpfhose");
 ds_map_add(m,"Elf Panties","Elfenhöschen");
 ds_map_add(m,"Limbo Leotard","Limbo-Anzug");
 ds_map_add(m,"Limbo Boots","Limbo-Stiefel");
 ds_map_add(m,"Cow Bras","Kuh-BH");
 ds_map_add(m,"Cow Stockings","Kuhstrümpfe");
 ds_map_add(m,"Cow Bell","Kuhglocke");
 ds_map_add(m,"Cow Panties","Kuhhöschen");
 ds_map_add(m,"OH Bunny Heels","OH-Bunny-Highheels");
 ds_map_add(m,"OH Bunny Tights","OH-Bunny-Strumpfhose");
 ds_map_add(m,"OH Bunny Top","OH-Bunny-Oberteil");
 ds_map_add(m,"OH Bunny Ears","OH-Bunny-Ohren");
 ds_map_add(m,"Face Mask","Gesichtsmaske");
 ds_map_add(m,"Cat Ears","Katzenohren");
 ds_map_add(m,"Knight Chain Mail","Ritterkettenhemd");
 ds_map_add(m,"Knight Boots","Ritterstiefel");
 ds_map_add(m,"Knight Gloves","Ritterhandschuhe");
 ds_map_add(m,"The Perverted Coat","Der perverse Mantel");
 ds_map_add(m,"Haigure Leotard","Haigure-Anzug");
 ds_map_add(m,"Limbo Gloves","Limbo-Handschuhe");
 ds_map_add(m,"Smoosher Shorts","Smoosher-Shorts");
 ds_map_add(m,"Dark Greaves","Dunkle Beinschienen");
 ds_map_add(m,"Dark Tiara","Dunkle Tiara");
 ds_map_add(m,"FurrHead","Fursuit-Kopfteil");
 ds_map_add(m,"FurrTop","Fursuit-Oberteil");
 ds_map_add(m,"FurrPants","Fursuit-Hose");
 ds_map_add(m,"FurrBoots","Fursuit-Stiefel");
 ds_map_add(m,"Nun Hat","Nonnenhaube");
 ds_map_add(m,"Nun Dress","Nonnenkleid");
 ds_map_add(m,"Nun Socks","Nonnenstrümpfe");
 ds_map_add(m,"Nun Boots","Nonnenstiefel");
 ds_map_add(m,"Pelletclad Blade","Pelletclad-Klinge");
 ds_map_add(m,"Place Holder Quest","Platzhalter-Quest");
 ds_map_add(m,"Finally, you muster the courage to embark on an adventure with your fairy familiar to find and bring back your childhood best friend.","Endlich bringst du den Mut auf, dich gemeinsam mit deiner Feenvertrauten auf ein Abenteuer zu begeben, um deine beste Freundin aus Kindertagen zu finden und zurückzuholen.");
 ds_map_add(m,"Check the cat woman's shop; there might be something that interests you.","Schau im Laden der Katzenfrau vorbei. Vielleicht findest du dort etwas Interessantes.");
 ds_map_add(m,"The cat woman who runs the shop is somewhat grumpy because she hasn't had the chance to eat lunch.","Die Katzenfrau, die den Laden führt, ist etwas mürrisch, weil sie noch keine Gelegenheit hatte, zu Mittag zu essen.");
 ds_map_add(m,"You managed to read the sinful thoughts of the fisherman. Perhaps this is your chance to explore your powers.","Du hast die sündigen Gedanken des Fischers gelesen. Vielleicht ist das deine Gelegenheit, deine Kräfte zu erkunden.");
 ds_map_add(m,"Lili pushes you to be more proactive in training your succubus powers, so she sends you to try to seduce the cat woman who runs the shop. It should be easier since you know her.","Lili drängt dich dazu, deine Sukkubuskräfte aktiver zu trainieren. Deshalb schickt sie dich los, um die Katzenfrau im Laden zu verführen. Es sollte leichter sein, da du sie bereits kennst.");
 ds_map_add(m,"There is a high-rank demon who has been stealing alcohol shipments. You decide to find and defeat her to see if you can get information about Ava.","Eine hochrangige Dämonin stiehlt Alkohollieferungen. Du beschließt, sie zu finden und zu besiegen, um vielleicht Informationen über Ava zu erhalten.");
 ds_map_add(m,"You're very lucky! You recognized one of the women who appeared in your mother's XXX magazines! She says she'll give you a special service for old times' sake.","Was für ein Glück! Du hast eine der Frauen erkannt, die in den XXX-Magazinen deiner Mutter zu sehen waren! Aus alter Verbundenheit verspricht sie dir einen besonderen Service.");
 ds_map_add(m,"You found a woman with violet pigtails at the corner of the bar. She says she can lend you money, but you must pay her back with an additional ten percent.","In einer Ecke der Bar hast du eine Frau mit violetten Zöpfen entdeckt. Sie sagt, sie könne dir Geld leihen, wenn du ihr zehn Prozent zusätzlich zurückzahlst.");
 ds_map_add(m,"There's a cat woman playing very mean pranks on the villagers, and they're blaming Callie's daughter. Find the real culprit and save Callie's daughter!","Eine Katzenfrau spielt den Dorfbewohnern üble Streiche, und alle geben Callies Tochter die Schuld. Finde die wahre Täterin und rette Callies Tochter!");
 ds_map_add(m,"The plant woman from the shop told you she's very thirsty, and Lili suggested buying her beer to see if she'll give you discounts while drunk.","Die Pflanzenfrau aus dem Laden hat dir erzählt, dass sie großen Durst hat. Lili schlägt vor, ihr Bier zu kaufen und zu sehen, ob sie dir betrunken einen Rabatt gibt.");
 ds_map_add(m,"A dragon woman fell from the sky among the prisoners and seems to be fighting to prevent a crystal from being stolen. Lili suggests we help her; maybe they'll reward us with something valuable.","Eine Drachenfrau ist mitten unter den Gefangenen vom Himmel gefallen und scheint einen Kristall vor Dieben zu schützen. Lili schlägt vor, ihr zu helfen. Vielleicht bekommen wir dafür etwas Wertvolles.");
 ds_map_add(m,"There's a strange woman with pink hair hiding in a corner of the circus. Find out why people are talking about her.","In einer Ecke des Zirkus versteckt sich eine seltsame Frau mit rosa Haaren. Finde heraus, warum alle über sie reden.");
 ds_map_add(m,"You found your favorite heroine! Sam, the protector of Tricotex. Prove that you have what it takes to embark on a capture mission with her.","Du hast deine Lieblingsheldin gefunden! Sam, die Beschützerin von Tricotex. Beweise ihr, dass du gut genug bist, um gemeinsam mit ihr einen Fangauftrag zu übernehmen.");
 ds_map_add(m,"Someone is impersonating a knight of Elira to scam people. Catch them and be the heroine you always wanted to be!","Jemand gibt sich als Ritter von Elira aus und betrügt die Leute. Finde diese Person und werde zur Heldin, die du immer sein wolltest!");
 ds_map_add(m,"Kristoff, a VIP customer at the bar, is very angry and asks if you can buy him some premium cigarettes to help him calm down.","Kristoff, ein VIP-Kunde der Bar, ist stinksauer. Er fragt dich, ob du ihm ein paar Premium-Zigaretten besorgen kannst, damit er sich beruhigt.");
 ds_map_add(m,"The hotel secretary informs you that you've caught the attention of a woman who will be waiting for you on the top floor of the hotel. Hmm, what could she want? It might be important.","Die Sekretärin des Hotels teilt dir mit, dass du die Aufmerksamkeit einer Frau erregt hast. Sie wird dich im obersten Stockwerk erwarten. Hm, was sie wohl will? Vielleicht ist es wichtig.");
 ds_map_add(m,"You've become a minion of a seemingly powerful individual! They order you to bring the dimensional fracture, which looks like a floating crystal, to leave this dimension.","Du bist zum Handlanger einer offenbar mächtigen Person geworden! Diese Person befiehlt dir, den Dimensionsriss, der wie ein schwebender Kristall aussieht, herzubringen, damit sie diese Dimension verlassen kann.");
 ds_map_add(m,"There was a collapse in the cave, leaving many miners trapped. Wait until the knight of Elira clears the passage.","In der Höhle ist ein Teil eingestürzt, und viele Bergleute sind eingeschlossen. Warte, bis die Ritterin von Elira den Durchgang freigeräumt hat.");
 ds_map_add(m,"There are some rumors of strange sounds coming from the Silent Forest at night. What could it be?","Es gibt Gerüchte über seltsame Geräusche, die nachts aus dem Stillen Wald kommen. Was könnte das sein?");
 ds_map_add(m,"An Onahole is desperate to buy a boat and is selling her body to do so. As an act of charity, help her.","Eine Wichshülse ist verzweifelt auf der Suche nach einem Boot und verkauft dafür ihren Körper. Hilf ihr aus reiner Nächstenliebe.");
 ds_map_add(m,"Ivy, a honey slime, recognizes you as an adventurer who helps people and asks if you can help her find a part of herself that hasn't returned.","Ivy, ein Honigschleim, erkennt dich als hilfsbereiten Abenteurer und bittet dich, einen Teil von ihr zu finden, der noch nicht zurückgekehrt ist.");
 ds_map_add(m,"You heard the Grand Captain of the Elira Guards arguing with a woman about the ineptitude of the knights. Maybe if you help them, they can assist you in your quest.","Du hast den Großhauptmann der Elira-Wache mit einer Frau über die Unfähigkeit der Ritter streiten hören. Vielleicht können sie dir bei deiner Suche helfen, wenn du ihnen unter die Arme greifst.");
 ds_map_add(m,"You encountered Faye, a space-dimensional traveler trapped in your dimension. You decided to help her because you felt sorry for her.","Du bist Faye begegnet, einer Reisenden zwischen den Dimensionen, die in deiner Dimension feststeckt. Aus Mitleid beschließt du, ihr zu helfen.");
 ds_map_add(m,"Vasuki tells you that something bad is happening at the mushroom house in the magenta swamp. Upon investigating, it seems that there may be human trafficking and drug activities occurring there.","Vasuki erzählt dir, dass im Pilzhaus im Magenta-Sumpf etwas Schlimmes vor sich geht. Bei deinen Nachforschungen sieht es so aus, als würden dort Menschenhandel und Drogenhandel betrieben.");
 ds_map_add(m,"You found someone smelling the flowers, but as soon as you spoke to them, they attacked you. Find out what's really going on!","Du hast eine Person dabei beobachtet, wie sie an Blumen roch. Doch kaum hast du sie angesprochen, griff sie dich an. Finde heraus, was wirklich dahintersteckt!");
 ds_map_add(m,"There's something about Marael that doesn't quite convince you. Look into what she's really hiding.","Irgendetwas an Marael überzeugt dich nicht so recht. Finde heraus, was sie wirklich verbirgt.");
 ds_map_add(m,"A letter addressed to Marael gives you clues that a woman named Willow also contacted Ava. Look for her to gather more information.","Ein an Marael adressierter Brief liefert dir Hinweise darauf, dass eine Frau namens Willow ebenfalls Kontakt zu Ava hatte. Suche sie, um mehr herauszufinden.");
 ds_map_add(m,"There's a bard woman looking for an adventurer to inspire her. Show her that you're a worthy adventurer capable of inspiring others!","Eine Bardenfrau sucht einen Abenteurer, der sie inspiriert. Beweise ihr, dass du ein würdiger Abenteurer bist, der andere inspirieren kann!");
 ds_map_add(m,"After being attacked by a pervert who opened his leather coat and showed you everything, something awakened inside of you.","Nachdem dich ein Perverser angegriffen, seinen Ledermantel geöffnet und dir alles gezeigt hat, ist etwas in dir erwacht.");
 ds_map_add(m,"The island is cordoned off because someone stole the relics from the church. As part of the deal to stay on the island, you agree to help the knights of Elira search for the relics.","Die Insel wurde abgeriegelt, weil jemand die Reliquien aus der Kirche gestohlen hat. Als Gegenleistung dafür, auf der Insel bleiben zu dürfen, erklärst du dich bereit, den Rittern von Elira bei der Suche nach den Reliquien zu helfen.");
 ds_map_add(m,"An Onahole stuck to the wall in the VIP area of the bar tells you that if you buy her entire outfit, she'll give you a rimjob!","Eine Wichshülse, die im VIP-Bereich der Bar an der Wand feststeckt, verspricht dir einen Rimjob, wenn du ihr ganzes Outfit kaufst!");
 ds_map_add(m,"Lili says you're very stinky and need a bath.","Lili sagt, dass du ziemlich stinkst und ein Bad nötig hast.");
 ds_map_add(m,"The librarian is lost, and no one knows where she is. Look for her, and perhaps you'll find more information about the people who go missing on the island.","Die Bibliothekarin ist verschwunden, und niemand weiß, wo sie steckt. Suche nach ihr. Vielleicht findest du dabei weitere Hinweise auf die Menschen, die auf der Insel verschwinden.");
 ds_map_add(m,"Gildfried, a businessman on vacation on the island, unfortunately lost his briefcase, which is very important to him.","Gildfried, ein Geschäftsmann, der auf der Insel Urlaub macht, hat leider seine für ihn sehr wichtige Aktentasche verloren.");
 ds_map_add(m,"Lemmy, a green monster outside an automated carriage, talks to Lili and asks for help because his mistress is having trouble.","Lemmy, ein grünes Monster vor einer automatischen Kutsche, spricht Lili an und bittet um Hilfe, weil seine Herrin in Schwierigkeiten steckt.");
 ds_map_add(m,"Sakura is working at the renowned fast food restaurant Smooshers! She asks for your help in searching for the lost uniforms.","Sakura arbeitet im berühmten Schnellrestaurant Smooshers! Sie bittet dich, ihr bei der Suche nach den verschwundenen Uniformen zu helfen.");
 ds_map_add(m,"One of Vasera's clones has gained autonomy. Vasera will go search for it and neutralize it. She advises you to kill it if you encounter it.","Einer von Vaseras Klonen hat einen eigenen Willen entwickelt. Vasera wird ihn suchen und unschädlich machen. Sie rät dir, ihn zu töten, falls du ihm begegnest.");
 ds_map_add(m,"Sieki got angry with you because even though she already paid the debt to MsHonney, you're still in the VIP area. Now you follow her orders to avoid making her angrier.","Sieki ist wütend auf dich, weil sie deine Schulden bei Ms. Honney bereits beglichen hat, du dich aber immer noch im VIP-Bereich herumtreibst. Jetzt befolgst du ihre Anweisungen, um sie nicht noch mehr zu verärgern.");
 ds_map_add(m,"The farmer confesses that she would like to work with less clothing. How could you help her work more comfortably?","Die Bäuerin gesteht, dass sie gern mit weniger Kleidung arbeiten würde. Wie kannst du ihr die Arbeit angenehmer machen?");
 ds_map_add(m,"The fortune teller confessed to you that she would like to have a red crystal orb because with it she could see her own future.","Die Wahrsagerin hat dir anvertraut, dass sie gern eine rote Kristallkugel hätte, mit der sie ihre eigene Zukunft sehen könnte.");
 ds_map_add(m,"The water nymph who works at the bar is looking for love but is insecure because she doesn't know if people approach her for the beer or if they genuinely want something with her.","Die Wassernymphe, die in der Bar arbeitet, sehnt sich nach Liebe, ist aber unsicher. Sie weiß nicht, ob die Leute wegen des Biers zu ihr kommen oder ob sie wirklich etwas von ihr wollen.");
 ds_map_add(m,"Accidentally, you ruin Naoki's concoction just as he's entering mating season, so you decide to help him.","Du ruinierst versehentlich Naokis Mixtur, gerade als seine Paarungszeit beginnt. Also beschließt du, ihm zu helfen.");
 ds_map_add(m,"Lucy the bard is having trouble with an Onahole, so you decide to help her with whatever she needs.","Lucy, die Bardin, hat Ärger mit einer Wichshülse. Du beschließt, ihr bei allem zu helfen, was sie braucht.");
 ds_map_add(m,"There are portals for self-satisfaction in the VIP area of the bar, but a witch won't let you use them.","Im VIP-Bereich der Bar gibt es Portale zur Selbstbefriedigung, aber eine Hexe lässt dich nicht hinein.");
 ds_map_add(m,"Sieki has a big problem and makes you a deal you can't refuse: you just have to attend to the clients in the VIP area while she's away, and you'll become a VIP customer.","Sieki hat ein großes Problem und macht dir ein Angebot, das du nicht ablehnen kannst: Du musst nur während ihrer Abwesenheit die Kunden im VIP-Bereich bedienen, und schon wirst du selbst VIP-Kunde.");
 ds_map_add(m,"A hospital robot offers anal cleaning services for just three thousand Arcs. It's not a bad idea to keep clean every now and then.","Ein Krankenhausroboter bietet für nur dreitausend Arcs eine Analreinigung an. Ab und zu sauber zu bleiben, ist eigentlich keine schlechte Idee.");
 ds_map_add(m,"A story you read in the library seems strange to you, so you decide to look for more information about it.","Eine Geschichte, die du in der Bibliothek gelesen hast, kommt dir seltsam vor. Deshalb beschließt du, mehr darüber herauszufinden.");
 ds_map_add(m,"There's a guy offering his services to make fursuits, which catches your attention, so you decide to save up for one.","Ein Typ bietet an, Fursuits anzufertigen. Das weckt dein Interesse, also beschließt du, dafür zu sparen.");
 ds_map_add(m,"There's an Onahole that has the same tone as you, which strangely excites you.","Es gibt eine Wichshülse, deren Hautton genau deinem entspricht. Seltsamerweise macht dich das ziemlich an.");
 ds_map_add(m,"In a nightclub, you find two gothic girls with big butts dancing, something you can't let pass in your life.","In einem Nachtclub entdeckst du zwei tanzende Gothic-Girls mit ziemlich großen Hintern. So eine Gelegenheit kannst du dir in deinem Leben nicht entgehen lassen.");
 ds_map_add(m,"Upon entering the usually closed public restroom, you find an idol vomiting, with many people screaming and demanding the show. What could be happening?","Als du die normalerweise verschlossene öffentliche Toilette betrittst, findest du dort ein Idol, das sich übergibt. Draußen schreien zahlreiche Leute und verlangen nach der Show. Was geht hier vor?");
 ds_map_add(m,"There is a proliferation of slimes attacking and kidnapping women. Do your best to help and get to the bottom of this!","Immer mehr Schleime greifen Frauen an und entführen sie. Hilf ihnen so gut du kannst und finde heraus, was dahintersteckt!");
 ds_map_add(m,"A being living in the pond enters Line's mind and psychologically strips her bare with questions she's not prepared to hear or face.","Ein Wesen aus dem Teich dringt in Lines Geist ein und entblößt sie psychisch mit Fragen, auf die sie weder vorbereitet ist noch denen sie sich stellen möchte.");
 ds_map_add(m,"You don't know what's happening; you have mental gaps, and days and nights seem to pass in seconds.","Du weißt nicht, was los ist. Du hast Gedächtnislücken, und Tage und Nächte scheinen in wenigen Sekunden zu vergehen.");
 ds_map_add(m,"You have committed serious mistakes that haunt you at night, so you decide to confess to expiate your sins.","Du hast schwere Fehler begangen, die dich nachts verfolgen. Deshalb beschließt du, zu beichten und für deine Sünden zu büßen.");
 ds_map_add(m,"Callie invites you to meet her family, which seems more serious than what you're looking for, but it would be rude not to go.","Callie lädt dich ein, ihre Familie kennenzulernen. Das wirkt ernster, als du es dir vorgestellt hast, aber nicht hinzugehen wäre unhöflich.");
 ds_map_add(m,"You found a place that can serve you for sleeping while you investigate the island.","Du hast einen Ort gefunden, an dem du während deiner Nachforschungen auf der Insel übernachten kannst.");
 ds_map_add(m,"You need more power, so you beg Marael to help you unlock your succubus powers.","Du brauchst mehr Macht und flehst Marael deshalb an, dir zu helfen, deine Sukkubuskräfte freizusetzen.");
 ds_map_add(m,"The thieves on the island aren't just any criminals; they were actually stealing to maintain an orphanage, without which everything would collapse.","Die Diebe auf der Insel sind keine gewöhnlichen Kriminellen. Sie haben gestohlen, um ein Waisenhaus am Leben zu erhalten. Ohne sie würde dort alles zusammenbrechen.");
 ds_map_add(m,"You met Futaba your trusted futanari in the forest, what could she be doing?","Im Wald bist du Futaba begegnet, deiner zuverlässigen Futanari. Was sie dort wohl macht?");
 ds_map_add(m,"The barn is very busy due to the issues happening on the island. Help them however you can so that the barn can open.","Wegen der Ereignisse auf der Insel herrscht auf der Farm jede Menge Betrieb. Hilf, wo du kannst, damit die Farm wieder öffnen kann.");
 ds_map_add(m,"Rynn is frustrated because the last fight with you didn't end, so she challenges you to a beer drinking duel.","Rynn ist frustriert, weil euer letzter Kampf nicht zu Ende geführt wurde. Deshalb fordert sie dich zu einem Biertrink-Duell heraus.");
 ds_map_add(m,"Lili is angry with Line because she believes Line is completely ignorant about sex, and challenges her to a competition to see who is the better onahole.","Lili ist wütend auf Line, weil sie glaubt, dass Line überhaupt keine Ahnung von Sex hat. Sie fordert sie zu einem Wettkampf heraus: Wer ist die bessere Wichshülse?");
 ds_map_add(m,"The milk on this island has very strange properties.","Die Milch auf dieser Insel hat äußerst seltsame Eigenschaften.");
 ds_map_add(m,"A fat ugly bastard bothering Rynn at the bar he leaves but you can't stop thinking about him.","Ein fetter, hässlicher Mistkerl belästigt Rynn in der Bar. Er geht zwar weg, aber du kannst nicht aufhören, an ihn zu denken.");
