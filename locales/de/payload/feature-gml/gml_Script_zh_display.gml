 ds_map_add(m,"Ok that's it!","Okay, das reicht jetzt!");
 ds_map_add(m,"Hey chill,  we can help you clean jeez girl.","Hey, ganz ruhig. Wir können dir beim Saubermachen helfen. Meine Güte, Mädchen.");
 ds_map_add(m,"Now Mr.Cabello will return tired from his work and he will see that I did nothing!!","Jetzt kommt Herr Cabello müde von der Arbeit zurück und sieht, dass ich nichts getan habe!!");
 ds_map_add(m,"You know how long it took me to clean this floor!","Weißt du eigentlich, wie lange ich gebraucht habe, um diesen Boden sauber zu bekommen?");
 ds_map_add(m,"Ups. I am really really sorry.","Ups. Es tut mir wirklich, wirklich leid.");
 ds_map_add(m,"What are you doing?!.","Was machst du da?!");
 ds_map_add(m,"The three of them managed to get every little mound of dust off the second floor.","Den dreien gelang es, jeden einzelnen Staubhaufen im zweiten Stock zu beseitigen.");
 ds_map_add(m,"After 15 minutes of thorough cleaning.","Nach 15 Minuten gründlicher Reinigung.");
