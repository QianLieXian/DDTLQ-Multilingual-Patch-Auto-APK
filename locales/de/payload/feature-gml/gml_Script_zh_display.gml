 ds_map_add(m,"* Is it really worth it?","* Ist es das wirklich wert?");
 ds_map_add(m,"* If I change, I will become something less than what I am now?","* Wenn ich mich verändere, werde ich dann zu etwas Geringerem als dem, was ich jetzt bin?");
 ds_map_add(m,"* She never managed to connect with anyone.","* Sie hat es nie geschafft, eine Verbindung zu irgendjemandem aufzubauen.");
