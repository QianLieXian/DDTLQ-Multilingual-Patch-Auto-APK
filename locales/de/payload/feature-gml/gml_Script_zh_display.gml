 ds_map_add(m,"Yeah don't worry, she will be with me if she needs help with anything or to talk to anyone, I will be here.","Ja, keine Sorge. Wenn sie Hilfe braucht oder mit jemandem reden möchte, bin ich bei ihr.");
 ds_map_add(m,"Do not worry Lili, I am a grown woman.","Keine Sorge, Lili. Ich bin eine erwachsene Frau.");
 ds_map_add(m,"I'm meeting someone so you'll be alone for a while, promise to stay out of trouble?","Ich treffe jemanden. Du wirst also eine Weile allein sein. Versprich mir, keinen Ärger zu machen?");
