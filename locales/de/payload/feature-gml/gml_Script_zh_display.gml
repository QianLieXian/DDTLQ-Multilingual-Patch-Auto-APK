 ds_map_add(m,"*Puke*","*Würg*");
 ds_map_add(m,"Wha what?","W-was?");
 ds_map_add(m,"Hey ou wat a niht witis papa bar.","Hey, wie wär's mit einer Nacht mit Papa Bär?");
 ds_map_add(m,"ON, THE FLOOR.","AUF DEN BODEN.");
 ds_map_add(m,"Maniaaaaac!","Wahnsinnige!");
 ds_map_add(m,"She's a maniac.","Sie ist eine Wahnsinnige.");
 ds_map_add(m,"With these steps I made my wife fall in love.","Mit diesen Schritten habe ich meine Frau dazu gebracht, sich in mich zu verlieben.");
 ds_map_add(m,"Then I'll wait for you there <3.","Dann warte ich dort auf dich <3.");
 ds_map_add(m,"Oh, w-well y-yeah I would like to go.","Oh, a-also ja, ich würde gern mitkommen.");
 ds_map_add(m,"* Whispers in his ear * I really have to go to the bathroom right now, don't you want to join me?","*Flüstert ihm ins Ohr* Ich muss wirklich dringend auf die Toilette. Möchtest du mich nicht begleiten?");
