 ds_map_add(m,"LiLi! do not say that ;c.","¡Lili! No digas eso ;c.");
 ds_map_add(m,"Well you heard it Line take off those boots and show those stinky feet.","Ya lo has oído, Line. Quítate las botas y enséñale esos pies apestosos.");
 ds_map_add(m,"Wow this is to fast but ok i accept it (I would have given it to her for free.","Vaya, esto ha sido muy rápido, pero vale, acepto. (Se lo habría dado gratis).");
 ds_map_add(m,"Wait what?","Espera, ¿qué?");
 ds_map_add(m,"Yeah listen we want to change we will give you a footjob for your fish.","Sí, escucha: queremos hacer un trueque. Te haremos un trabajo de pies a cambio de tus peces.");
 ds_map_add(m,"It wasn't that bad don't worry.","No estuvo tan mal, no te preocupes.");
 ds_map_add(m,"Shit really?","¿Mierda, en serio?");
 ds_map_add(m,"Yeah, and we sense you get excited when she talk about her feets.","Sí, y notamos que te emocionas cuando ella habla de sus pies.");
 ds_map_add(m,"Wait she is a half succubus?","Espera, ¿ella es medio súcubo?");
 ds_map_add(m,"Lili why did you say that :s.","Lili, ¿por qué has dicho eso? :s.");
 ds_map_add(m,"Hi dude, I'm Lili and thats my partner Line she is half succubus.","Hola, colega. Soy Lili y esta es mi compañera Line; ella es medio súcubo.");
 ds_map_add(m,"Come on Line, he has it like a stone, don't leave him waiting.","Vamos, Line. Lo tiene duro como una piedra; no lo hagas esperar.");
