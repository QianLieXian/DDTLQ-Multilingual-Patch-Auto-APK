 ds_map_add(m,"Please Vasuki I don't think I can't masturbate.","Por favor, Vasuki, creo que no puedo masturbarme yo sola.");
 ds_map_add(m,"I will go to that corner until the effect passes be-because I think the e-effect is increasing.","Iré a aquel rincón hasta que se me pase el efecto, po-porque creo que el e-efecto está aumentando.");
 ds_map_add(m,"Line no I... I can't cheat on my husband.","Line, no... Yo... no puedo engañar a mi marido.");
 ds_map_add(m,"Vasuki, please, I think I can't take it anymore.","Vasuki, por favor. Creo que ya no puedo aguantar más.");
 ds_map_add(m,"I'm-sorry, I'm not a lesbian and I-have a family.","Lo-lo siento, no soy lesbiana y tengo una familia.");
 ds_map_add(m,"Oh Vasuki, I really would like to kiss that angelic face of yours.","Oh, Vasuki, de verdad me gustaría besar esa cara tan angelical que tienes.");
 ds_map_add(m,"Yeah I think mine is an aphrodisiac, I-I feel kinda hot.","Sí, creo que la mía es afrodisíaca. S-siento un poco de calor.");
 ds_map_add(m,"Ohh... Vasuki these fruits have something strange about them.","Oh... Vasuki, estas frutas tienen algo extraño.");
 ds_map_add(m,"Vasuki and Line eat the exotic fruits.","Vasuki y Line se comen las frutas exóticas.");
 ds_map_add(m,"Ok i will eat the red one.","Vale, me comeré la roja.");
 ds_map_add(m,"I want to eat the long one.","Quiero comerme la larga.");
 ds_map_add(m,"The cows gave it to me, so that I could sell them instead of eating them, but since we don't have anything else.","Me las dieron las vacas para que las vendiera en lugar de comérmelas, pero como no tenemos nada más...");
 ds_map_add(m,"Wow i've never seen these fruits before.","Vaya, nunca había visto estas frutas.");
 ds_map_add(m,"Look Line, aren't these fruits strange? hehe.","Mira, Line, ¿no te parecen extrañas estas frutas? Jeje.");
 ds_map_add(m,"Also I think there is something more that want me to stay.","Además, creo que hay algo más que quiere que me quede.");
 ds_map_add(m,"My husband is the King he will protect the children, now I just want to be with you Line <3.","Mi marido es el rey; él protegerá a los niños. Ahora solo quiero estar contigo, Line <3.");
 ds_map_add(m,"Wha-what about-your family?","¿P-pero qué pasa con tu familia?");
 ds_map_add(m,"You know what, I could stay here a while longer and be with you.","¿Sabes qué? Podría quedarme aquí un poco más y estar contigo.");
 ds_map_add(m,"Yes, love was the best, too bad you have to go.","Sí, cariño, ha sido maravilloso. Lástima que tengas que irte.");
 ds_map_add(m,"Ohh. Line th-that was great..","Oh, Line... ha sido ge-genial...");
 ds_map_add(m,"Although, it is not that bad.","Aunque tampoco está tan mal.");
 ds_map_add(m,"*Takes off his boots*  Uhhh it seems that I have walked a lot this smell is very strong.","*Se quita las botas* Uhhh, parece que he caminado mucho. El olor es muy fuerte.");
 ds_map_add(m,"A well-deserved rest after helping every DAM islander you bump into!","¡Un descanso bien merecido después de ayudar a cada maldito isleño con el que te cruzas!");
 ds_map_add(m,"Ohh finally I will be able to rest a bit","Oh, por fin podré descansar un poco.");
 ds_map_add(m,"Help me please! I feel like I'm going to explode, I really need it!","¡Ayúdame, por favor! ¡Siento que voy a explotar, lo necesito de verdad!");
 ds_map_add(m,"Ya ssh sh I need you to put it in, I can't wait!","Ya... shh, shh. Necesito que lo metas. ¡No puedo esperar!");
 ds_map_add(m,"bu-but.","P-pero...");
 ds_map_add(m,"Now! Lili uses your weapon to create a mega cock!","¡Ahora! ¡Lili, usa tu arma para crear una megapolla!");
 ds_map_add(m,"I don't recognize you...","No te reconozco...");
 ds_map_add(m,"Oh fuck you and do not talk to me about this subject anymore!","¡Ah, que te jodan! ¡Y no vuelvas a hablarme de este tema!");
 ds_map_add(m,"I didn't think something like this could happen, Line even has people here and you didn't give a crap!","No pensé que pudiera pasar algo así. Line, ¡incluso hay gente aquí y te importó una mierda!");
 ds_map_add(m,"Shut up, I can quit this, whenever I want, did you not say you would help me in whatever I need!","¡Cállate! Puedo dejarlo cuando quiera. ¿No dijiste que me ayudarías con cualquier cosa que necesitara?");
 ds_map_add(m,"But it hasn't been long since the last time you had sex... Line I think you have to stop this for a while.","Pero no ha pasado mucho tiempo desde la última vez que tuviste sexo... Line, creo que deberías dejarlo por un tiempo.");
 ds_map_add(m,"I had not had sex in a while.","Hacía tiempo que no tenía sexo.");
 ds_map_add(m,"Line, are you okay, did you relax? It's the first time I've seen you like this.","Line, ¿estás bien? ¿Te has relajado? Es la primera vez que te veo así.");
 ds_map_add(m,"I didn't think something like this could happen.","No pensé que pudiera pasar algo así.");
 ds_map_add(m,"AHHH MY BALLLS!!","¡¡¡AHHH, MIS HUEVOS!!!");
 ds_map_add(m,"I am so sorry ;c I trie my best to contain her rage.","Lo siento muchísimo ;c. Hice todo lo posible por contener su furia.");
 ds_map_add(m,"Shit that woman hit me in the balls in the Sabbath.","Mierda, esa mujer me dio una patada en los huevos durante el aquelarre.");
 ds_map_add(m,"Yes, we are not priority because they are unconscious by magic, but I want to know if they will be alright anyway..","Sí, no somos una prioridad porque están inconscientes por culpa de la magia, pero aun así quiero saber si estarán bien...");
 ds_map_add(m,"Naoki, are you still waiting here?","Naoki, ¿sigues esperando aquí?");
 ds_map_add(m,"I'm half elf so I think it comes from that ahah.","Soy medio elfa, así que creo que viene de ahí, jaja.");
 ds_map_add(m,"Oh Maruia you are a very good orc. <3","Oh, Maruia, eres una orca estupenda. <3");
 ds_map_add(m,"I am waiting, that they attend one of the miners.","Estoy esperando a que atiendan a uno de los mineros.");
 ds_map_add(m,"Good, thanks for asking and what are you doing?.","Bien, gracias por preguntar. ¿Y tú qué haces?");
 ds_map_add(m,"Oh Line, how's everything going?","Oh, Line, ¿cómo va todo?");
 ds_map_add(m,"Oh okay do not worry, if it is just raising a lever I do not think it won't take more than 2 minutes","Oh, vale, no te preocupes. Si solo hay que levantar una palanca, no creo que tardemos más de dos minutos.");
 ds_map_add(m,"It is, our reserve generators went off and I need you to lift a lever to turn them on. They are in the left basement of the hospital.","Así es. Se apagaron nuestros generadores de reserva y necesito que levantes una palanca para encenderlos. Están en el sótano izquierdo del hospital.");
 ds_map_add(m,"Mmmm well, if it is something small","Mmmm, bueno, si es algo pequeño...");
 ds_map_add(m,"If you don't need anything, could you do me a little favor?","Si no necesitas nada, ¿podrías hacerme un pequeño favor?");
 ds_map_add(m,"Oh ,well the truth no, but thanks.","Oh, bueno, la verdad es que no, pero gracias.");
 ds_map_add(m,"Hello, good morning, are you coming for a check-up?","Hola, buenos días. ¿Vienes para una revisión?");
 ds_map_add(m,"Something like that, he told me he had to train privately for his show so I think he went to find a new hiding place to practice his magic.","Algo así. Me dijo que tenía que entrenar a solas para su espectáculo, así que creo que fue a buscar un nuevo escondite donde practicar su magia.");
 ds_map_add(m,"And he said where was he going?","¿Y te dijo adónde iba?");
 ds_map_add(m,"It seemed that he had something to do so I told him to leave, and I will wait for my sister.","Parecía que tenía algo que hacer, así que le dije que se fuera. Yo esperaré a mi hermana.");
 ds_map_add(m,"Hi Equinox, have you seen Naoki?","Hola, Equinox. ¿Has visto a Naoki?");
 ds_map_add(m,"Iugg Lili kill me please *covers her face in shame*.","Ugh, Lili, mátame, por favor. *Se cubre la cara de vergüenza*");
 ds_map_add(m,"I recommend less sex if you are not going to take care of your hygiene.","Te recomiendo que tengas menos sexo si no vas a cuidar tu higiene.");
 ds_map_add(m,"Uhhh... is it okay, I am sorry *sobs*.","Uhhh... ¿está bien? Lo siento. *Solloza*");
 ds_map_add(m,"Summary, High amount of sexual intercourse plus never having had a cleaning before will raise the price to a whopping amount.","En resumen: tener relaciones sexuales con mucha frecuencia y no haberse hecho nunca una limpieza hará que el precio se dispare.");
 ds_map_add(m,"since it would be your first time, it would probably take more than usual, plus I've worked long enough to know that you've already had sex, which raises the price.","Como sería tu primera vez, probablemente tardaría más de lo habitual. Además, llevo suficiente tiempo trabajando para saber que ya has tenido sexo, y eso aumenta el precio.");
 ds_map_add(m,"WHAT THEE!","¡¿QUÉ DEMONIOS?!");
 ds_map_add(m,"Perfect, it is only 3000 Arcs","Perfecto, solo son 3000 Arcs.");
 ds_map_add(m,"Ehhh hehe maybe it wouldn't be bad if I had a cleanup, it would be my first time.","Ehhh, jeje. Quizá no estaría mal que me hicieran una limpieza. Sería la primera vez.");
 ds_map_add(m,"It can be done without it but it is not recommended.","Se puede hacer sin eso, pero no es recomendable.");
 ds_map_add(m,"Mmmm so if someone does it for that place is it necessary what you offer me?","Mmmm, entonces, si alguien hace eso por esa zona, ¿es necesario contratar el servicio que me ofreces?");
 ds_map_add(m,"Sorry I thought it was one of those low life women. usually they come to clean up to keep working properly.","Perdona, pensé que eras una de esas mujeres de mala vida. Suelen venir a hacerse una limpieza para poder seguir trabajando con normalidad.");
 ds_map_add(m,"Oh m-me? no I just got a little lost hehe.","¿Y-yo? No, solo me he perdido un poco, jeje.");
 ds_map_add(m,"Welcome, are you coming for an anal cleansing?","Bienvenida. ¿Vienes para una limpieza anal?");
 ds_map_add(m,"You still don't have the money? don't worry, I can wait until you get it.","¿Todavía no tienes el dinero? No te preocupes, puedo esperar hasta que lo consigas.");
 ds_map_add(m,"Because of the amount I will use, you may resist, it will help me make the process go faster and also it may make the slime pop a little so you won't stain your clothes.","Por la cantidad que voy a utilizar, puede que te resistas. Eso me ayudará a acelerar el proceso y también puede hacer que el slime salte un poco, para que no te manches la ropa.");
 ds_map_add(m,"What, why?","¿Qué? ¿Por qué?");
 ds_map_add(m,"All right, please take off your clothes, turn around and I'll have to tie you up with this.","De acuerdo. Por favor, quítate la ropa, date la vuelta y tendré que atarte con esto.");
 ds_map_add(m,"All right, I'll be waiting here if you change your mind.","De acuerdo, estaré aquí esperando por si cambias de opinión.");
 ds_map_add(m,"No thanks, right now I need the Arcs.","No, gracias. Ahora mismo necesito los Arcs.");
 ds_map_add(m,"Yes please (pay for the service).","Sí, por favor. (Pagar el servicio).");
 ds_map_add(m,"Do you want to pay for anal cleaning services?","¿Quieres pagar por los servicios de limpieza anal?");
 ds_map_add(m,"When I clean everything here, you can have another cleaning.","Cuando termine de limpiar todo esto, podrás hacerte otra limpieza.");
 ds_map_add(m,"Wha-what!","¡¿Q-qué?!");
 ds_map_add(m,"I can't do much about your weird new look, but I think I might be able to beat some sense back into your head-- *cracks knuckles*","No puedo hacer mucho por tu extraño aspecto nuevo, pero creo que sí puedo devolverte el sentido común a golpes... *Se cruje los nudillos*");
 ds_map_add(m,"Hold on, squirt: YOU'RE trying to help ME? It looks like time travel can screw up your body AND your brain!","Un momento, renacuaja: ¿TÚ intentas ayudarME a MÍ? ¡Parece que viajar en el tiempo puede fastidiarte tanto el cuerpo COMO el cerebro!");
 ds_map_add(m,"Oh Lily, she looks really disoriented.","Oh, Lily, parece estar muy desorientada.");
 ds_map_add(m,"Ta-Talia ?! What happened to you? The King never told us that time travel could change our appearances!","¿Ta-Talia?! ¿Qué te ha pasado? ¡El rey nunca nos dijo que viajar en el tiempo pudiera cambiar nuestro aspecto!");
 ds_map_add(m,"Eh.. a-are you ok?(Wow is very pretty)","Eh... ¿e-estás bien? (Vaya, es muy guapa).");
 ds_map_add(m,"RGHhhh... ugh, my head's killing me! I don't remember the King saying time travel would hurt...","Rgh... Ugh, ¡me está matando la cabeza! No recuerdo que el rey dijera que viajar en el tiempo dolería...");
 ds_map_add(m,"What that fuck!","¡¿Qué coño?!");
 ds_map_add(m,"Faye super Soldier of the king","Faye, super soldado del rey");
 ds_map_add(m,"Let's get on with it already then!","¡Pues acabemos de una vez!");
 ds_map_add(m,"No, we will have to find one.","No, tendremos que encontrar a uno.");
 ds_map_add(m,"Sure, sure. Enough chatting, though. Do you know a magician who can manipulate the rift?","Sí, sí. Pero basta de charla. ¿Conoces a algún mago capaz de manipular la grieta?");
 ds_map_add(m,"What are you a hero or something?","¿Qué eres, algún tipo de héroe o algo así?");
 ds_map_add(m,"Look, time is of the essence. Every minute I spend here, is a minute less I have left to take over-- save my Kingdom.","Escucha, el tiempo apremia. Cada minuto que paso aquí es un minuto menos para conquistar-- salvar mi reino.");
 ds_map_add(m,"Yeas yes yes whatever Lili , what do you need beautiful redhead <3?","Sí, sí, sí, lo que tú digas, Lili. ¿Qué necesitas, preciosa pelirroja? <3");
 ds_map_add(m,"Hey line, are you really gonna help this brat?","Oye, Line, ¿de verdad vas a ayudar a esta mocosa?");
 ds_map_add(m,"Alright, get to it then already!","¡De acuerdo, pues ponte manos a la obra de una vez!");
 ds_map_add(m,"Yes, leave it to me and Lili.","Sí, déjamelo a mí y a Lili.");
 ds_map_add(m,"( What the fuck is she talking about? We beat you like 10 seconds ago )","(¿De qué coño está hablando? Te derrotamos hace como diez segundos).");
 ds_map_add(m,"Are you really going to help a stranger who kicked your ass?","¿De verdad vas a ayudar a una desconocida que te dio una paliza?");
 ds_map_add(m,"Mmm I have, helped others to return to their dimension and I-If you want you can call me Talia since it is the name that you murmur so much.","Mmm, he ayudado a otros a regresar a su dimensión y... S-si quieres, puedes llamarme Talia, ya que es el nombre que tanto murmuras.");
 ds_map_add(m,"* Faye begins to sob *","*Faye empieza a sollozar*");
 ds_map_add(m,"What's the true.","¿Cuál es la verdad?");
 ds_map_add(m,"The saddest thing that you didn't even make it to the year 3000 of this dimension.","Lo más triste es que ni siquiera llegaste al año 3000 de esta dimensión.");
 ds_map_add(m,"Rgh... if Talia made it through, then there's no way I'm going to catch up to her. I can't let that happen, she can't beat me--","Rgh... Si Talia lo consiguió, no hay forma de que pueda alcanzarla. No puedo permitirlo. No puede ganarme...");
 ds_map_add(m,"When you arrived, that crystal was created, it usually happens when someone reaches this dimension by mistake.","Cuando llegaste, se creó ese cristal. Suele ocurrir cuando alguien llega por accidente a esta dimensión.");
 ds_map_add(m,"Are you SURE this isn't the year 3000 AD?","¿Estás SEGURA de que esto no es el año 3000 d. C.?");
 ds_map_add(m,"No, sorry actually it's 201 AO.","No, lo siento. En realidad estamos en el año 201 AO.");
 ds_map_add(m,"This DIMENSION? You're telling me I traveled through space, not time? Shit...","¿¡ESTA DIMENSIÓN!? ¿Me estás diciendo que viajé por el espacio y no por el tiempo? Mierda...");
 ds_map_add(m,"Calm down Lili, she was disoriented from traveling to this dimension.","Tranquila, Lili. Está desorientada por haber viajado a esta dimensión.");
 ds_map_add(m,"Dumbass, we've been telling you that from the beginning!","¡Idiota, llevamos diciéndotelo desde el principio!");
 ds_map_add(m,"Wait a minute... you're not Talia.","Espera un momento... tú no eres Talia.");
 ds_map_add(m,"Yes, thank you very much Line, I will continue training for my show, you know where to find me if you need something else.","Sí, muchas gracias, Line. Seguiré entrenando para mi espectáculo. Ya sabes dónde encontrarme si necesitas algo más.");
 ds_map_add(m,"Finally, Faye We did it, you see Naoki you had the power to do it.","¡Por fin, Faye! Lo conseguimos. ¿Lo ves, Naoki? Tenías el poder para hacerlo.");
 ds_map_add(m,"Done The dimensional rift is already Ready To get to the year 3000 AD.","Listo. La grieta dimensional ya está preparada para llegar al año 3000 d. C.");
 ds_map_add(m,"Ohh Faye you are a sweetheart <3.","Oh, Faye, eres un encanto <3.");
 ds_map_add(m,"This is all very different from my time but, I am glad you are here to help me Thanks Talia.","Todo esto es muy diferente de mi época, pero me alegra que estés aquí para ayudarme. Gracias, Talia.");
 ds_map_add(m,"I am sorry to show you this facet Faye, but there was no other option to help you.","Lamento mostrarte esta faceta de mí, Faye, pero no había otra forma de ayudarte.");
 ds_map_add(m,"Oh right, you didn't know Line is half succubus is what she does best, although she acts like a saint.","Ah, cierto, no lo sabías. Line es mitad súcubo; esto es lo que mejor se le da, aunque se comporte como una santa.");
 ds_map_add(m,"Wow, the King told us the year 3000 is full of perverts, but is EVERYWHERE full of them besides 1000 AD?","Vaya, el rey nos dijo que el año 3000 está lleno de pervertidos. ¿Pero está TODO el mundo lleno de ellos, excepto en el año 1000 d. C.?");
 ds_map_add(m,"* Naoki finally calms down when he ejaculates and begins to modify the rift correctly *","*Naoki por fin se calma al eyacular y empieza a modificar correctamente la grieta*");
 ds_map_add(m,"Don't worry, this will calm you down * Line grabs naoki from behind and masturbates him until he ejaculates * ","No te preocupes, esto te tranquilizará. *Line agarra a Naoki por detrás y lo masturba hasta que eyacula*");
 ds_map_add(m,"Oh well I-I don't know *Line strips naked and walks over to naoki and starts taking off his clothes*","Oh, bueno, y-yo no sé... *Line se desnuda por completo, se acerca a Naoki y empieza a quitarle la ropa*");
 ds_map_add(m,"Calm Naoki you want me to help you with your nerves, as before.","Tranquilo, Naoki. ¿Quieres que te ayude con los nervios, como la otra vez?");
 ds_map_add(m,"Is she alright? No magicians I've ever known had to chant stuff to cast magic.","¿Está bien? Ninguno de los magos que he conocido ha tenido que recitar cosas para lanzar un hechizo.");
 ds_map_add(m,"I-I will Try*Naoki start to shake because of nerves*.","L-lo intentaré. *Naoki empieza a temblar por los nervios*");
 ds_map_add(m,"Hmm... would these earrings of mine work? They're from where I come from, 1000 AD. Maybe you can use that as a marker in time and then jump forward 2000 years?","Mmm... ¿servirían estos pendientes míos? Son de mi época, del año 1000 d. C. Quizá puedas usarlos como referencia temporal y luego avanzar 2000 años.");
 ds_map_add(m,"What?! But I have never done this, at least you have an object of that dimension that would help me to have a time reference?","¡¿Qué?! Pero nunca he hecho algo así. ¿Al menos tienes algún objeto de esa dimensión que pueda servirme como referencia temporal?");
 ds_map_add(m,"We need the dimensional rift to open in the year 3000 AD of that dimension.","Necesitamos que la grieta dimensional se abra en el año 3000 d. C. de esa dimensión.");
 ds_map_add(m,"B-but you haven't told me what to do.","P-pero todavía no me has dicho qué tengo que hacer.");
 ds_map_add(m,"Alright, so let's see some magic!","¡De acuerdo, veamos un poco de magia!");
 ds_map_add(m,"Is Talia that desperate to keep me from beating her? Sending weird robots to attack me? Sheesh.","¿Talia está tan desesperada por evitar que la derrote? ¿Ahora manda robots extraños para atacarme? En fin...");
 ds_map_add(m,"Look like the kettle thing doesn't want you to go to your dimension Faye.","Parece que esa cosa con forma de tetera no quiere que regreses a tu dimensión, Faye.");
 ds_map_add(m,"W-800 Series Gratters like myself have been employed to seal the dimensional holes created by violators, on behalf of the World Organization for Reformation of the Masses.","Los Gratters de la serie W-800, como yo, hemos sido contratados por la Organización Mundial para la Reforma de las Masas para sellar los agujeros dimensionales creados por los infractores.");
 ds_map_add(m,"One of you violated the dimensional agreement; this is a parallel timeline had agreed to distance itself from our own. I am The Timekeper W.O.R.M System model 101","Uno de ustedes ha violado el acuerdo dimensional. Esta línea temporal paralela había aceptado mantenerse separada de la nuestra. Soy el Guardián del Tiempo del sistema W.O.R.M., modelo 101.");
 ds_map_add(m,"What the hell?!","¡¿Qué demonios?!");
 ds_map_add(m,"I seems so. Hopefully I don't end up somewhere even weirder this time, no offense.","Eso parece. Espero no acabar esta vez en algún lugar aún más extraño. Sin ánimo de ofender.");
 ds_map_add(m,"Well it seems this is the goodbye.","Bueno, parece que ha llegado el momento de despedirnos.");
 ds_map_add(m,"AAAHHHHHHH Whatever, fine, it's not like anything else is working. Weird ass dimensional weirdos... * Faye takes her clothes off *","¡AAAAHHHHHH! ¡Como quieras, está bien! Tampoco es que nada más esté funcionando. Malditos bichos raros de otras dimensiones... *Faye se quita la ropa*");
 ds_map_add(m,"Please Faye Believe in me is the only way. (this is my only chance to have sex with her!)","Por favor, Faye, confía en mí. Es la única manera. (¡Es mi única oportunidad de acostarme con ella!)");
 ds_map_add(m,"You really ARE all perverts. Get sex off your mind, and let's blow this thing up!","De verdad que sois todos unos pervertidos. ¡Dejad de pensar en sexo y hagamos volar esta cosa!");
 ds_map_add(m,"Faye We have to let ourselves lose!","¡Faye, tenemos que dejarnos perder!");
 ds_map_add(m,"* Line begins to recognize a smell coming from the robot. *MHmm ... those tanks ... those tentacles, oh I know what to do!","*Line empieza a reconocer un olor que viene del robot.* Mmm... esos depósitos... esos tentáculos... ¡Oh, ya sé qué hacer!");
 ds_map_add(m,"What are you thinking so much?","¿En qué estás pensando tanto?");
 ds_map_add(m,"Mhmmm...","Mmmmmm...");
 ds_map_add(m,"It would be a good idea, if we had done some damage!","¡Sería una buena idea si al menos le hubiéramos hecho algo de daño!");
 ds_map_add(m,"How is this thing shrugging off everything we're throwing at it?  Change of strategy; Line, destroy those cylinders on it; maybe that's where its energy comes from.","¿Cómo puede esta cosa resistir todo lo que le lanzamos? Cambiemos de estrategia: Line, destruye esos cilindros que tiene encima. Quizá de ahí saque su energía.");
 ds_map_add(m,"Very proud of you Line.","Estoy muy orgulloso de ti, Line.");
 ds_map_add(m,"Shhhh Lili.","Shhhh, Lili.");
 ds_map_add(m,"Hey Line, if they only needed your milk to beat the robot, why did you make her get naked too?","Oye, Line, si solo necesitaban tu leche para derrotar al robot, ¿por qué hiciste que ella también se desnudara?");
 ds_map_add(m,"Bye...","Adiós...");
 ds_map_add(m,"Goodbye Line, it's time to go.","Adiós, Line. Es hora de irse.");
 ds_map_add(m,"Hehe yeah, that's my name <3 and Kick that Talia's ass, Faye I will wait for your return.","Jeje, sí, ese es mi nombre <3. ¡Y dale una buena paliza a Talia, Faye! Esperaré tu regreso.");
 ds_map_add(m,"Yeah, once I've got this future weapon I'm looking for, I want to see you again and thank you properly Ta-sorry your name is Line isn't it?","Sí, cuando consiga el arma del futuro que estoy buscando, quiero volver a verte y darte las gracias como es debido. Ta... perdona, te llamas Line, ¿verdad?");
 ds_map_add(m,"It sounds like you're leaving.","Parece que te vas.");
 ds_map_add(m,"We finally had a stroke of luck now it's all over.","Por fin tuvimos un golpe de suerte y ahora todo ha terminado.");
 ds_map_add(m,"We were lucky that instead of stopping it, it exploded.","Tuvimos suerte: en lugar de detenerlo, conseguimos que explotara.");
 ds_map_add(m,"Well I deduced that the robot used milk as energy just like a succubus if we allowed ourselves to be milked my milk would consume the energy of the robot's stored milk.","Bueno, deduje que el robot utilizaba leche como fuente de energía, igual que una súcubo. Si dejábamos que nos ordeñara, mi leche consumiría la energía de la leche que el robot tenía almacenada.");
 ds_map_add(m,"That didn't explain anything.","Eso no ha explicado absolutamente nada.");
 ds_map_add(m,"Hehe I-I guess <3.","Jeje, s-supongo que sí <3.");
 ds_map_add(m,"Wow, Line you have a brain.","Vaya, Line, tienes cerebro.");
 ds_map_add(m,"Well, my succubus powers helped me to know that inside those cylinders there was woman's milk and the tentacles had a substance that stimulates milk production like succubus saliva.","Bueno, mis poderes de súcubo me ayudaron a descubrir que dentro de esos cilindros había leche de mujer y que los tentáculos contenían una sustancia que estimula la producción de leche, como la saliva de las súcubos.");
 ds_map_add(m,"Ahnn... mmmmnn... t-that was intense. Line, how did you know that'd destroy him?","Ahhn... mmmnn... h-ha sido intenso. Line, ¿cómo supiste que eso lo destruiría?");
 ds_map_add(m,"I don't know how to tell Eleanor about this but I'd better finish our research and then I'll explain everything to her.","No sé cómo contarle esto a Eleanor, pero será mejor que terminemos nuestra investigación y luego se lo explicaré todo.");
 ds_map_add(m,"A body in a vegetable state... or did they mean that it had no soul? it could do so, but even a body without a soul would still have consciousness.","Un cuerpo en estado vegetativo... ¿o querían decir que no tenía alma? Podría ser, pero incluso un cuerpo sin alma seguiría teniendo consciencia.");
 ds_map_add(m,"they asked me for a body .... without a conscience but alive... I don't really know what they meant.","Me pidieron un cuerpo... sin consciencia, pero vivo... La verdad, no sé muy bien a qué se referían.");
 ds_map_add(m,"They appeared.","Aparecieron.");
 ds_map_add(m,"* The book is dirty and only a few pages are readable *","*El libro está sucio y solo se pueden leer unas pocas páginas*");
 ds_map_add(m,"Clearly not a success but they work for now. If I catch the target I can use them to verify the individual.","Está claro que no ha sido un éxito, pero por ahora funcionan. Si capturo al objetivo, podré utilizarlos para verificar su identidad.");
 ds_map_add(m,"Although these beings are able to accomplish their sole objective, they lack the ability to reason, making them unable to move from the place where they are prostrate.","Aunque estos seres son capaces de cumplir su único objetivo, carecen de capacidad de razonamiento, por lo que no pueden moverse del lugar donde yacen postrados.");
 ds_map_add(m,"Have only one objective, to catch and verify that the host is compatible with Eleonor.","Tienen un único objetivo: capturar al huésped y comprobar si es compatible con Eleonor.");
 ds_map_add(m,"I was able to create the first primitive, circular body by surface tension.","Conseguí crear el primer cuerpo primitivo y circular mediante tensión superficial.");
 ds_map_add(m,"Kamiko the wyvern","Kamiko, la wyvern");
 ds_map_add(m,"Well, thanks to you, the town is much safer, besides that you solved the alcohol problem, I guess that's fine.","Bueno, gracias a ti, el pueblo es mucho más seguro. Además, has resuelto el problema del alcohol, así que supongo que está bien.");
 ds_map_add(m,"I will also bring her to be milked.","También la traeré para ordeñarla.");
 ds_map_add(m,"Can I take this criminal with me? It would be a great help.","¿Puedo llevarme a esta criminal? Sería de gran ayuda.");
 ds_map_add(m,"Oh never mind, I have a better idea.","Oh, olvídalo. Se me ha ocurrido algo mejor.");
 ds_map_add(m,"*Kamiko let's out an embarrassing moan as her tits are being milked dry. She stands defeated*","*Kamiko suelta un gemido de vergüenza mientras le ordeñan las tetas hasta dejarlas vacías. Se queda allí, derrotada.*");
 ds_map_add(m,"Please shut up, we are talking here.","Por favor, cállate. Estamos hablando.");
 ds_map_add(m,"MOOO! - MOOO! Nghgh - MOOOooo~ ","¡MUUU! - ¡MUUU! Nghgh - ¡MUUUuuu~");
 ds_map_add(m,"Traveler I'm sorry to tell you that right now I don't have all the reward.","Viajero, lamento decirte que ahora mismo no tengo toda la recompensa.");
 ds_map_add(m,"MOOO! - MOOOooo~ ngh...","¡MUUU! - ¡MUUUuuu~ ngh...");
 ds_map_add(m,"Uuughh.. m-moo... mo-Nghh!~ Mooo-mooo","Uuughh... m-muuu... mu-Nghh!~ Muuu-muuu");
 ds_map_add(m,"H-hngh!!... Dammit-ahh~ How did it come to this?!","¡H-hngh!!... ¡Maldita sea-ahh~! ¿Cómo hemos llegado a esto?!");
 ds_map_add(m,"Hey here you don't talk you damn cow!","¡Eh, aquí no hablas tú, maldita vaca!");
 ds_map_add(m,"You'll pay for this!!","¡¡¡Pagarás por esto!!!");
 ds_map_add(m,"Are you listening?!.","¡¿Me estás escuchando?!");
 ds_map_add(m,"Hey! What the fuck are you doing?!","¡Eh! ¡¿Qué coño estás haciendo?!");
 ds_map_add(m,"(I don't think they dared to turn it on)","(No creo que se atrevieran a encenderlo).");
 ds_map_add(m,"I think our little friend has not made her daily milk quota.","Creo que nuestra amiguita no ha alcanzado su cuota diaria de leche.");
 ds_map_add(m,"Go turn on the machine.","Enciende la máquina.");
 ds_map_add(m,"Ehh .. and how?","Eh... ¿y cómo?");
 ds_map_add(m,"It seems that we will have to make her speak.","Parece que tendremos que hacerla hablar.");
 ds_map_add(m,"(Big thing i just won't say anything)","(Como si fuera gran cosa. No pienso decir ni una palabra).");
 ds_map_add(m,"Oh yes, listen Lili if they say something else I think they increase the time in jail.","Oh, sí. Escucha, Lili: si dicen algo más, creo que les aumentarán la condena.");
 ds_map_add(m,"Line, I understand that cows can only say moo.","Line, tengo entendido que las vacas solo pueden decir «muu».");
 ds_map_add(m,"Ah go fuck yourself.","Ah, vete a la mierda.");
 ds_map_add(m,"hehe clearly it is Lili.","Jeje, está claro que es Lili.");
 ds_map_add(m,"Uyy look Line is not a cute cow <3?","Uyyy, ¿a que Line no es una vaquita adorable? <3");
 ds_map_add(m,"What do you want?!","¡¿Qué quieres?!");
 ds_map_add(m,"Ohh of course we will go to see her haha.","Oh, claro que iremos a verla, jajaja.");
 ds_map_add(m,"If you want, you can go see the criminal while I count the money.","Si quieres, puedes ir a ver a la criminal mientras yo cuento el dinero.");
 ds_map_add(m,"Sure just give me a second.","Claro, dame un segundo.");
 ds_map_add(m,"Lili, manners.","Lili, modales.");
 ds_map_add(m,"Where is the reward?","¿Dónde está la recompensa?");
 ds_map_add(m,"*whispering * Line turn on the machine and let's get the hell out of here.","*En voz baja* Line, enciende la máquina y larguémonos de aquí de una maldita vez.");
 ds_map_add(m,"What...?","¿Qué...?");
 ds_map_add(m,"In a way I'm here because I want hu-hu-hu.","En cierto modo, estoy aquí porque quiero, je-je-je.");
 ds_map_add(m,"Oh darling there is no guard here who dares to raise his voice to me.","Oh, cariño, aquí no hay ningún guardia que se atreva a alzarme la voz.");
 ds_map_add(m,"Hey I have a question, why are you talking shouldn't you say moo?","Oye, tengo una pregunta: ¿por qué hablas? ¿No se supone que debes decir muu?");
 ds_map_add(m,"Now you can turn on that machine I have a lot of milk in these udders.","Ya puedes encender esa máquina. Tengo las ubres llenas de leche.");
 ds_map_add(m,"Oh thanks.","Oh, gracias.");
 ds_map_add(m,"I will not tell a soul.","No se lo contaré a nadie.");
 ds_map_add(m,"Oh no-no need, uhh.. could you do not tell anyone what I did to beat you hehe.. ple-please.","Oh, n-no hace falta. Ehhh... ¿podrías no contarle a nadie cómo conseguí vencerte? Jeje... p-por favor.");
 ds_map_add(m,"But you came and you made me feel so, so good hu-hu.","Pero viniste y me hiciste sentir tan, tan bien. Je, je.");
 ds_map_add(m,"I like the place, maybe I killed and drank so much because I was frustrated.","Me gusta este lugar. Quizá mataba y bebía tanto porque estaba frustrada.");
 ds_map_add(m,"Calm down, I have no grudge towards my little half succubus.","Tranquila, no le guardo rencor a mi pequeña medio súcubo.");
 ds_map_add(m,"Uh.. hello, do you... enjoy the place? I mean ... hello :c.","Eh... hola, ¿te... gusta este lugar? Quiero decir... hola :c.");
 ds_map_add(m,"It seems that we meet again.","Parece que volvemos a encontrarnos.");
 ds_map_add(m,"Turn on the machine Line see if she shut up.","Line, enciende la máquina. A ver si así se calla.");
 ds_map_add(m,"Tristan is not a puppet!.","¡Tristan no es un títere!");
 ds_map_add(m,"Looking at the bright side they let you keep the puppet.","Míralo por el lado bueno: al menos te dejaron quedarte con el muñeco.");
 ds_map_add(m,"And that fairy i guess.","Y con ese hada, supongo.");
 ds_map_add(m,"When I come out I will take revenge on you and Sam!.","¡Cuando salga de aquí me vengaré de ti y de Sam!");
 ds_map_add(m,"Oh it's you, you really think i'll stay here forever.","Oh, eres tú. ¿De verdad crees que me quedaré aquí para siempre?");
 ds_map_add(m,"Is this a reference?.","¿Es una referencia?");
 ds_map_add(m,"Beep bo bop.","Bip, bo, bop.");
 ds_map_add(m,"Plz do-do not do it (uff yeah, God yes, I want to scream and moan while everyone looks at me)","P-por favor, no lo hagas (uff, sí, Dios mío, sí, quiero gritar y gemir mientras todos me miran).");
 ds_map_add(m,"Not even if they tickle you while they suck your milk.","¿Ni siquiera si te hacen cosquillas mientras te ordeñan?");
 ds_map_add(m,"Mm-m moo (what's planned?)","M-muuu (¿qué tenéis planeado?).");
 ds_map_add(m,"hey cows just say moo!","¡Eh, vacas, solo podéis decir muu!");
 ds_map_add(m,"Lili .. n-do-do not do anything weird please.","Lili... n-no hagas ninguna locura, por favor.");
 ds_map_add(m,"I'll turn on the machine.","Voy a encender la máquina.");
 ds_map_add(m,"Mmm.. yeah. I already have it on.","Mmm... sí. Ya está encendida.");
 ds_map_add(m,"Did you put on your cow clothes?","¿Ya te has puesto el traje de vaca?");
 ds_map_add(m,"Go to the upper left corner, there will be a machine waiting for you to suck your milk.","Ve a la esquina superior izquierda. Allí habrá una máquina esperando para extraerte la leche.");
 ds_map_add(m,"Take this, you will have to eat this fruit has a special effect that makes you produce more milk than if you were pregnant.","Toma, cómete esta fruta. Tiene un efecto especial que hace que produzcas más leche que durante un embarazo.");
 ds_map_add(m,"(Wow, just say you want to get milked to the brain)","(Vaya, dilo directamente: quieres que te ordeñen hasta dejarte sin cerebro).");
 ds_map_add(m,"... The truth is that I think I deserve the punishment, she gave me a lot of money, I feel guilty that people suffered for it.","... La verdad es que creo que me merezco el castigo. Ella me dio muchísimo dinero y me siento culpable porque otras personas sufrieron por ello.");
 ds_map_add(m,"So the only option you have is to be milked to pay your sentence and I'll set you free.","Así que tu única opción es cumplir la condena mediante el ordeño. Cuando termines, te dejaré libre.");
 ds_map_add(m,"Look, I can't let her go without serving some kind of sentence.","Mira, no puedo dejarla marchar sin que cumpla algún tipo de condena.");
 ds_map_add(m,"Hey hey low the voice that others will think of me, Ehemm! well back to the topic, until now she has been a remarkable citizen.","Eh, eh, habla más bajo. Los demás van a pensar mal de mí. Ejem... Volviendo al tema, hasta ahora ha sido una ciudadana ejemplar.");
 ds_map_add(m,"Plus she rimmed the white demon to capture her while you stared and did nothing!","¡Además, ella le hizo un beso negro al demonio blanco para atraparlo mientras tú te quedabas mirando sin hacer nada!");
 ds_map_add(m,"Hey come on, give us a warning, we have done more than any citizen of Elira.","¡Vamos, danos una advertencia y ya está! Hemos hecho más que cualquier ciudadano de Elira.");
 ds_map_add(m,"That rat said everything to have less sentence time, Line was the only one who made a deal with her.","Esa rata lo contó todo para reducir su condena. Line fue la única que llegó a un acuerdo con ella.");
 ds_map_add(m,"Wait and how do you know that they made a loan to Line.","Espera, ¿y cómo sabes que le concedieron un préstamo a Line?");
 ds_map_add(m,"She is a thief and to launder the money she makes illegal loans, by law the borrower also has a penalty.","Es una ladrona y blanquea el dinero que consigue mediante préstamos ilegales. Según la ley, quien pide prestado también recibe una sanción.");
 ds_map_add(m,"You see that woman with purple hair.","¿Ves a esa mujer de pelo morado?");
 ds_map_add(m,"WHAT!?","¡¿QUÉ?!");
 ds_map_add(m,"Line... sorry to tell you that you are under arrest.","Line... siento decirte que estás arrestada.");
 ds_map_add(m,"Ay Lili, don't be paranoid, we are heroes, maybe she called us to catch another criminal.","Ay, Lili, no seas paranoica. Somos héroes; quizá nos ha llamado para atrapar a otro criminal.");
 ds_map_add(m,"It seems serious, we better escape.","Esto parece serio. Será mejor que escapemos.");
 ds_map_add(m,"Could you come for a moment.","¿Podrías venir un momento?");
 ds_map_add(m,"Line!","¡Line!");
 ds_map_add(m,"shut up.","Cállate.");
 ds_map_add(m,"Hey now you have your mother's long tongue when you are completely aroused.","Vaya, cuando estás completamente excitada también sacas la lengua larga de tu madre.");
 ds_map_add(m,"Ok line that's all we need you can go","Vale, Line, eso es todo lo que necesitamos. Puedes irte.");
 ds_map_add(m,"Moo moo ranch","Rancho Muuu Muuu");
 ds_map_add(m,"Welcome to the Moo moo ranch prison and producer of the best breast milk of all dimensions. we also hire women and sell the best aphrodisiac fruits to fulfill any sexual desire <3.","¡Bienvenido al Rancho Muuu Muuu, prisión y productor de la mejor leche materna de todas las dimensiones! También contratamos mujeres y vendemos las mejores frutas afrodisíacas para satisfacer cualquier deseo sexual <3.");
 ds_map_add(m,"What!?.","¡¿Qué?!");
 ds_map_add(m,"Nyann!.","¡Miauu!");
 ds_map_add(m,"We already beat you, surrender like a good kitten.","Ya te hemos vencido. Ríndete como una buena gatita.");
 ds_map_add(m,"Stop thinking with your horn we have to go back.","Deja de pensar con el cuerno. Tenemos que volver.");
 ds_map_add(m,"She did not stay with me :c hopefully I can see her again hehe.","No se quedó conmigo :c. Ojalá pueda volver a verla, jeje.");
 ds_map_add(m,"She escaped I stayed here taking care of you.","Ella escapó. Yo me quedé aquí cuidando de ti.");
 ds_map_add(m,"Where did the lady cat go?","¿Adónde se ha ido la mujer gato?");
 ds_map_add(m,"Shit Line you pass out.","Mierda, Line, te has desmayado.");
 ds_map_add(m,"In the meantime you can enjoy the activities the island has to offer.","Mientras tanto, puedes disfrutar de las actividades que ofrece la isla.");
 ds_map_add(m,"Oh, I didn't know :c.","Oh, no lo sabía :c.");
 ds_map_add(m,"Sorry miss, right now the great captain is busy looking for a con artist posing as one of us.","Lo siento, señorita. Ahora mismo el gran capitán está ocupado buscando a un estafador que se hace pasar por uno de nosotros.");
 ds_map_add(m,"Great let's go right away someone could be in danger.","¡Genial! Vamos enseguida. Alguien podría estar en peligro.");
 ds_map_add(m,"I do Sam :D, it is east of town, passing the bridge of lovers.","Sí, Sam :D. Está al este del pueblo, cruzando el Puente de los Enamorados.");
 ds_map_add(m,"Ok going back to the topic, I was informed that the criminal would be in the magenta swamp, do you know where it is?","Bien, volviendo al tema, me han informado de que la criminal está en el Pantano Magenta. ¿Sabes dónde queda?");
 ds_map_add(m,"Maybe you could hahaha.","Quizá sí que podrías hacerlo, jajaja.");
 ds_map_add(m,"Really? because I want to live in your armpits o.O.","¿De verdad? Porque quiero vivir en tus axilas o.O.");
 ds_map_add(m,"Don't worry Lili, it happens to me often and in fact it flatters me.","No te preocupes, Lili. Me pasa a menudo y, de hecho, hasta me halaga.");
 ds_map_add(m,"Jeez Line self control.","Por Dios, Line, contrólate.");
 ds_map_add(m,"*Line can't stop leering at Sam muscular and sweaty body*","*Line no puede dejar de mirar con lascivia el cuerpo musculoso y sudoroso de Sam.*");
 ds_map_add(m,"Oh by the way I think something happened to your friend.","Por cierto, creo que le ha pasado algo a tu amiga.");
 ds_map_add(m,"Yeah Sam we can handle it all <3 .","Así es, Sam. Podemos encargarnos de todo <3.");
 ds_map_add(m,"Wow, you weren't lying, you two are really strong.","Vaya, no mentías. Sois realmente fuertes.");
 ds_map_add(m,"Please help me, don't let her take the crystal.","Por favor, ayúdame. No dejes que se lleve el cristal.");
 ds_map_add(m,"Hey leave her alone!","¡Eh, déjala en paz!");
 ds_map_add(m,"Help the dragon maybe she gives us a reward.","Ayuda a la dragona. Quizá nos dé una recompensa.");
 ds_map_add(m,"Lili what do we do?","Lili, ¿qué hacemos?");
 ds_map_add(m,"For now we block the exit until the guards arrive.","Por ahora bloquearemos la salida hasta que lleguen los guardias.");
 ds_map_add(m,"We are prisoners if we get into someone else's fight they will increase our sentence.","Somos prisioneras. Si nos metemos en la pelea de otra persona, nos aumentarán la condena.");
 ds_map_add(m,"And why don't you help her?!","¡¿Y por qué no la ayudas?!");
 ds_map_add(m,"That dragon woman fell from the sky and the lamia seems to have stole something from her.","Esa mujer dragón cayó del cielo y parece que la lamia le ha robado algo.");
 ds_map_add(m,"Hey! what's happening here?","¡Eh! ¿Qué está pasando aquí?");
 ds_map_add(m,"Vasuki The Silver Dragon of Luminous","Vasuki, la Dragona Plateada de Luminous");
 ds_map_add(m,"Thank you very much you are very kind <3.","Muchísimas gracias. Eres muy amable <3.");
 ds_map_add(m,"We know where it is, we will help you to return home.","Sabemos dónde está. Te ayudaremos a volver a casa.");
 ds_map_add(m,"This one came with me, the other one from what I could see ended up in a place with many bright blue rocks.","Esta llegó conmigo. La otra, por lo que pude ver, terminó en un lugar lleno de rocas azules brillantes.");
 ds_map_add(m,"Oh don't worry, the truth is I would like to go back but this crystal is only half the fracture.","Oh, no te preocupes. La verdad es que quiero volver, pero este cristal solo representa la mitad de la grieta.");
 ds_map_add(m,"Lili! Excuse her, she was born without touch.","¡Lili! Perdónala, nació sin tacto.");
 ds_map_add(m,"Wow.. it's a lot to digest but at least you already have the crystal to return to that horrible place.","Vaya... Es mucha información que asimilar, pero al menos ya tienes el cristal para regresar a ese horrible lugar.");
 ds_map_add(m,"Yes, my dimension is called Luminous, right now a corrupt god is wreaking havoc and that is why my dimension has these dimensional fractures.","Sí, mi dimensión se llama Luminous. Ahora mismo un dios corrupto está causando estragos allí, y por eso han aparecido estas grietas dimensionales.");
 ds_map_add(m,"Wait do you come from another dimension?","Espera, ¿vienes de otra dimensión?");
 ds_map_add(m,"That crystal is really a dimensional rift and my only way to get back home.","Ese cristal es en realidad una grieta dimensional y mi única forma de regresar a casa.");
 ds_map_add(m,"That crystal, why is it so important to you?","Ese cristal, ¿por qué es tan importante para ti?");
 ds_map_add(m,"Relax, it was nothing.","Tranquila, no ha sido nada.");
 ds_map_add(m,"Yes, Thanks for helping me, I didn't have any more energy to fight.","Sí, gracias por ayudarme. Ya no me quedaban fuerzas para seguir luchando.");
 ds_map_add(m,"Are you ok?","¿Estás bien?");
 ds_map_add(m,"Oh sorry I will go take it now.","Oh, perdona. Iré a buscarlo ahora mismo.");
 ds_map_add(m,"Wait you forgot to take the crystal.","Espera, te has olvidado de recoger el cristal.");
 ds_map_add(m,"Ahhhh you are right let's do it.","¡Ahhh, tienes razón! Vamos a hacerlo.");
 ds_map_add(m,"Come on line just look at her, undress her with your dirty eyes, don't you want to see her like this all the time?","Vamos, Line, mírala. Desnúdala con esa mirada tan lasciva. ¿No te gustaría verla así todo el tiempo?");
 ds_map_add(m,"But I do not understand, why do all that?","Pero no lo entiendo. ¿Para qué hacer todo eso?");
 ds_map_add(m,"Look, if they find you before you start the robbery they will only give you a warning and the farmer will be able to work naked.","Mira, si te descubren antes de empezar el robo, solo te darán una advertencia y la granjera podrá trabajar desnuda.");
 ds_map_add(m,"....Whhaat?","... ¿Qu-qué?");
 ds_map_add(m,"Exactly..","Exactamente...");
 ds_map_add(m,"You are insane! I do not want to go to jail.","¡Estás loca! No quiero ir a la cárcel.");
 ds_map_add(m,"Look, if the farmer wants to be more comfortable at work, why don't you try to steal this milk?","Escucha, si la granjera quiere trabajar más cómoda, ¿por qué no intentas robar esta leche?");
 ds_map_add(m,"What is it?","¿Qué pasa?");
 ds_map_add(m,"Hey Line I think I have an idea.","Oye, Line, creo que se me ha ocurrido algo.");
 ds_map_add(m,"Hey you people, what are you doing!","¡Eh, vosotros! ¿Qué estáis haciendo?");
 ds_map_add(m,"Ohh.... fine..","Ohhh... está bien...");
 ds_map_add(m,"get naked, if that doesn't get you noticed, nothing will.","Desnúdate. Si eso no consigue llamar la atención, nada lo hará.");
 ds_map_add(m,"What do we do then?","¿Y entonces qué hacemos?");
 ds_map_add(m,"Mmm this woman does not realize what is going on around her, no wonder the inmates are escaping.","Mmm, esta mujer ni siquiera se da cuenta de lo que ocurre a su alrededor. No me extraña que los presos se escapen.");
 ds_map_add(m,"Ohh ok I will just move it from one side to the other..","Oh, vale. Solo tengo que moverlo de un lado a otro...");
 ds_map_add(m,"Wait Line Do not take it out of the box just move it.","Espera, Line. No lo saques de la caja, solo muévelo.");
 ds_map_add(m,"Line starts to take out the milk bucket.","Line empieza a sacar el cubo de leche.");
 ds_map_add(m,"What act?","¿Qué actuación?");
 ds_map_add(m,"Ah shut up the act is over.","Ah, cállate. La actuación ha terminado.");
 ds_map_add(m,"Why did you untie me?!","¡¿Por qué me has desatado?!");
 ds_map_add(m,"She says she understands and will never do it again.","Dice que lo entiende y que no volverá a hacerlo.");
 ds_map_add(m,"Mmmhemm hemmmMmmm.","Mmm, ajá, mmmm...");
 ds_map_add(m,"I will give you only one warning but if you steal again I swear I will take you to the guards.","Solo te daré una advertencia. Pero si vuelves a robar, juro que te llevaré ante los guardias.");
 ds_map_add(m,"Have a nice day Miss the prison-farm is a good place to buy aphrodisiacs as well as exemplifying the sentences of people who break the law.","Que tenga un buen día, señorita. La granja-prisión es un buen lugar para comprar afrodisíacos y también para ver cómo se castiga a quienes infringen la ley.");
 ds_map_add(m,"You found one of the stolen relics! I'll give the news to the captain, you can go and return it to the church and I know they will be grateful.","¡Has encontrado una de las reliquias robadas! Informaré al capitán. Puedes llevarla de vuelta a la iglesia; sé que te lo agradecerán.");
 ds_map_add(m,"Oh it's out of order, I really want to go to the bathroom :c.","Oh, está fuera de servicio. De verdad necesito ir al baño :c.");
 ds_map_add(m,"Well, it is out of order anyway.","Bueno, de todas formas está fuera de servicio.");
 ds_map_add(m,"I cannot get in here, it is the men's room.","No puedo entrar aquí. Es el baño de hombres.");
 ds_map_add(m,"Hey watchout!","¡Eh, cuidado!");
 ds_map_add(m,"No, over my dead body you ruin my whole plan!","¡No! ¡Tendrás que pasar por encima de mi cadáver si quieres arruinar todo mi plan!");
 ds_map_add(m,"Ehhh... Agh it's ok what should I do.","Ehhh... agh, está bien. ¿Qué tengo que hacer?");
 ds_map_add(m,"Not anymore, Line owes me.","Ya no. Ahora Line me debe un favor.");
 ds_map_add(m,"WHAT? But I'm the one who has to do it.","¡¿QUÉ?! Pero soy yo quien tiene que hacerlo.");
 ds_map_add(m,"Line? I need your help damn it, go to my place now!","¿Line? ¡Necesito tu ayuda, maldita sea! ¡Ven a mi casa ahora mismo!");
 ds_map_add(m,"Oh that's a bit aggressive.","Vaya, eso ha sido un poco agresivo.");
 ds_map_add(m,"That's what worries me, you bloody gambler, if I see that you've turned the place into a casino I swear I'll kill you!","Eso es precisamente lo que me preocupa, maldito jugador. ¡Como descubra que has convertido este lugar en un casino, te juro que te mato!");
 ds_map_add(m,"Don't worry SieKi I will run the place even better than you.","No te preocupes, Sieki. Administraré el lugar incluso mejor que tú.");
 ds_map_add(m,"Shit, I really don't want to but I didn't have time to look for someone.","Mierda, de verdad no quiero hacerlo, pero no he tenido tiempo de buscar a otra persona.");
 ds_map_add(m,"Then she will take your place for a while, Sieki?","Entonces, ¿ella ocupará tu puesto durante un tiempo, Sieki?");
 ds_map_add(m,"Stay out of my business!","¡No te metas en mis asuntos!");
 ds_map_add(m,"and let me make it clear you are working so be professional and don't touch anything on my desk!","Y que quede claro: estás trabajando, así que compórtate profesionalmente y ¡no toques nada de mi escritorio!");
 ds_map_add(m,"Oh I am sorry I am sorry I am running right now.","Oh, lo siento, lo siento. Ya estoy saliendo corriendo.");
 ds_map_add(m,"Line what are you waiting for stop talking and go to work!","Line, ¿a qué esperas? ¡Deja de hablar y ponte a trabajar!");
 ds_map_add(m,"Of course, there is no problem <3.","Por supuesto, no hay ningún problema <3.");
 ds_map_add(m,"W-would you really come ;c?","¿D-de verdad vendrías? ;c");
 ds_map_add(m,"Oh, okay, I-I will visit you when you do.","Oh, vale. Y-yo iré a visitarte cuando te hayas instalado.");
 ds_map_add(m,"Ahhh fuck you, I'll make my own secret club with gambling and pachinko!","¡Ahhh, que te den! ¡Montaré mi propio club secreto con apuestas y pachinko!");
 ds_map_add(m,"Thank you for opening your mind to me. It's been a long time since people came to see me. I'll give you advice as a gift. I see an evil being behind you, exposing your weakness. A shell of a being. If you don't find your ego, it will take its place, and you'll lose the little bit of individuality you have now.","Gracias por abrirme tu mente. Hacía mucho tiempo que nadie venía a visitarme. Te daré un consejo como regalo. Veo un ser maligno detrás de ti que está dejando al descubierto tus debilidades. Es una criatura vacía. Si no encuentras tu propio yo, ocupará tu lugar y perderás la poca individualidad que todavía conservas.");
 ds_map_add(m,"Ah, I-I'm sorry, Line. No, no, I can't. My head, ah, it hurts. I don't know what's happening.","Ah, lo-lo siento, Line. No, no puedo. Me duele la cabeza, ah... No sé qué está pasando.");
 ds_map_add(m,"Sh-shut up! I do not understand anything, Lili. Attack the serpent, please! I need you, please, make it stop!","¡C-cállate! No entiendo nada, Lili. ¡Ataca a la serpiente, por favor! ¡Te necesito, por favor, haz que pare!");
 ds_map_add(m,"You're a shallow, flat shell of a person. It's hard to even call you an individual. Your super ego in society makes people idolize you like a hero, a role model. But when you're alone, your id surfaces, revealing nothing more than an animal devoid of any reasoning.","Eres una persona superficial y vacía, una simple carcasa. Cuesta incluso llamarte individuo. Tu superyó hace que la sociedad te idolatre como a una heroína, como a un modelo a seguir. Pero cuando estás sola, aflora tu ello y no queda más que un animal incapaz de razonar.");
 ds_map_add(m,"P-p-please, do not m-make me think about my family anymore. I-I beg you, get out of my head.","P-p-por favor, no me hagas pensar más en mi familia. T-te lo suplico, sal de mi cabeza.");
 ds_map_add(m,"Please, get out of my head. I do not want to hear anymore.","Por favor, sal de mi cabeza. No quiero escuchar más.");
 ds_map_add(m,"You're right. You're a slut, and you're a saint. Your life has been about living between two extremes.","Tienes razón. Eres una zorra y una santa. Tu vida ha consistido en vivir entre dos extremos.");
 ds_map_add(m,"Line, calm down. Ahh, my head, what's happening?","Line, cálmate. Ahhh, me duele la cabeza. ¿Qué está pasando?");
 ds_map_add(m,"IT'S A LIE! I-I-I was always a good daughter in the village, a model daughter! I never did anything to shame my father!","¡ES MENTIRA! ¡Y-yo siempre fui una buena hija en el pueblo, una hija ejemplar! ¡Nunca hice nada que avergonzara a mi padre!");
 ds_map_add(m,"Do you really want them to know what you are? A shameless woman whose only motive is carnal relief. Your father is better off without knowing you; your mother saved him from seeing his daughter fall into a hopeless pit.","¿De verdad quieres que sepan cómo eres? Una mujer sin vergüenza cuyo único objetivo es satisfacer sus deseos carnales. Tu padre está mejor sin saberlo; tu madre le ahorró tener que ver a su hija caer en un abismo sin salida.");
 ds_map_add(m,"Wh-what! No, she w-wanted to h-help me get to kn-know myself, to t-truly experience and s-shape myself through int-interacting with other people!","¡¿Q-qué?! No, ella q-quería a-ayudarme a conocerme a mí misma, a v-vivir experiencias de verdad y a f-forjar mi identidad relacionándome con otras personas.");
 ds_map_add(m,"Your mother helped you leave the village just so you wouldn't cause problems for your father.","Tu madre te ayudó a abandonar el pueblo simplemente para que no le causaras problemas a tu padre.");
 ds_map_add(m,"Line, are you okay?!","¡Line! ¿Estás bien?!");
 ds_map_add(m,"Ah!? Why do I hear you in my head?","¡¿Ah?! ¿Por qué oigo tu voz dentro de mi cabeza?");
 ds_map_add(m,"But you're just a nymphomaniac without morals, the nightmare of your father and the mistake of your mother.","Pero no eres más que una ninfómana sin moral, la pesadilla de tu padre y el error de tu madre.");
 ds_map_add(m,"*Starts to cry* Sniff, sniff, th-thank you, really. I thought I was a j-joke, just a nymphomaniac in the form of an elf who can not even be a w-woman of values like my f-father wanted.","*Empieza a llorar* Snif, snif... m-muchas gracias, de verdad. Pensaba que era una b-broma, solo una ninfómana con forma de elfa que ni siquiera podía ser una m-mujer con los valores que mi p-padre quería.");
 ds_map_add(m,"You're in a place where everyone gets what they want\nyour powers can't have an effect when everyone is already at the highest level of ecstasy.","Estás en un lugar donde todo el mundo consigue lo que desea.\nTus poderes no pueden surtir efecto cuando todos ya están en el nivel máximo de éxtasis.");
 ds_map_add(m,"B-ut I am succubus, they should be the ones desiring me more!","P-pero soy una súcubo. ¡Se supone que ellos deberían desearme más a mí!");
 ds_map_add(m,"The most accurate thing is that your friend was a warrior dragon, something not commonly seen in those places. You shouldn't worry; they just desired her more.","Lo más probable es que tu amiga fuera una dragona guerrera, algo poco habitual en esos lugares. No te preocupes; simplemente la deseaban más a ella.");
 ds_map_add(m,"Being half succubus doesn't necessarily mean you have to be the best in the sex. It could be due to various factors that VIPs liked your friend more than you.","Ser mitad súcubo no significa necesariamente que tengas que ser la mejor en el sexo. Puede haber muchos motivos por los que los VIP prefirieran a tu amiga antes que a ti.");
 ds_map_add(m,"Th-the thing is, it seemed like people enjoyed being with her more than with me, and, well, being half succubus makes me feel like I am a disgrace, as if it were a mistake or something like that.","L-lo que pasa es que parecía que la gente disfrutaba más estando con ella que conmigo. Y, bueno, ser mitad súcubo me hace sentir como una deshonra, como si fuera un error o algo así.");
 ds_map_add(m,"Oh? Emm I think I have a question... *looks around* Not long ago, a friend and I were working in a VIP area on the island as onaholes.","¿Oh? Ehh, creo que tengo una pregunta... *Mira a su alrededor* Hace poco, una amiga y yo trabajábamos como muñecas sexuales en una zona VIP de la isla.");
 ds_map_add(m,"Hello, I'm Veritus and I can answer any question!","¡Hola! Soy Veritus y puedo responder cualquier pregunta.");
 ds_map_add(m,"It sticking out its little tongue, it is so adorable! <3","¡Está sacando su pequeña lengua! ¡Es adorable! <3");
 ds_map_add(m,"Look at the sea serpent, it is so cute! <3","¡Mira la serpiente marina! ¡Es tan mona! <3");
 ds_map_add(m,"Verity Pond","Estanque de la Verdad");
 ds_map_add(m,"Warning! $%&/(%/ &$#%% in the Pond: Speaking to it is akin to facing a mirror of your innermost self. It can answer questions, but its cost is unknown and can negatively affect people. Caution and respect are advised, avoiding deceit. Enjoy the pond with care and consideration.","¡Advertencia! $%&/(%/ &$#%% en el estanque: hablar con él es como enfrentarte a un espejo de tu yo más profundo. Puede responder preguntas, pero se desconoce el precio que exige y podría afectar negativamente a las personas. Se recomienda actuar con precaución y respeto, evitando cualquier engaño. Disfruta del estanque con cuidado y consideración.");
 ds_map_add(m,"Maybe I better leave.","Quizá será mejor que me vaya.");
 ds_map_add(m,"Lili, did I wake up before you?","Lili, ¿me he despertado antes que tú?");
 ds_map_add(m,"Ugh, what a horrible nightmare has happened?","Uf, ¿qué ha sido esa horrible pesadilla?");
 ds_map_add(m,"Lovers bridge","Puente de los Enamorados");
 ds_map_add(m,"Hey you cannot pass without paying the toll.","Eh, no puedes pasar sin pagar el peaje.");
 ds_map_add(m,"Hey! What do you think you're doing?","¡Eh! ¿Qué te crees que estás haciendo?");
 ds_map_add(m,"It's the only thing you deserve for having the nerve to believe you can catch me.","Es lo único que mereces por atreverte a creer que podrías atraparme.");
 ds_map_add(m,"Here you have my stinking foot","Toma, aquí tienes mi pie apestoso.");
 ds_map_add(m,"Like the closet thirsty succubus that you are.","Como la sedienta y reprimida súcubo que eres.");
 ds_map_add(m,"You will have to touch yourself here in front of passersby.","Tendrás que masturbarte aquí, delante de todos los transeúntes.");
 ds_map_add(m,"Hehe I know a way that you can save your little friend.","Jeje, conozco una forma de salvar a tu amiguita.");
 ds_map_add(m,"Please do not take Lili.","Por favor, no te lleves a Lili.");
 ds_map_add(m,"I'll keep your fairy, it will sell very well on the black market.","Me quedaré con tu hada. Se venderá muy bien en el mercado negro.");
 ds_map_add(m,"I told you that your attempt to catch me was useless.","Ya te dije que tu intento de atraparme era inútil.");
 ds_map_add(m,"Well it does not matter I will go to your base.","Bueno, no importa. Iré a vuestra base.");
 ds_map_add(m,"But it seems you wanted it to come to this.","Pero parece que querías que las cosas acabaran así.");
 ds_map_add(m,"Hahaha you disgust me if you told me that before you would have saved yourself the humiliation.","Jajajaja, me das asco. Si me lo hubieras dicho antes, te habrías ahorrado esta humillación.");
 ds_map_add(m,"Yes! and I'll take out the wanted posters.","¡Sí! Y también retiraré los carteles de búsqueda.");
 ds_map_add(m,"Ple-please do not take Lili, we have a base you can hide.","P-por favor, no te lleves a Lili. Tenemos una base donde puedes esconderte.");
 ds_map_add(m,"Do not worry, we will give you 1000 Arcs as a reward, you just have to go and pick it up at the jail-farm.","No te preocupes, te daremos 1000 Arcs como recompensa. Solo tienes que ir a recogerlos a la granja-prisión.");
 ds_map_add(m,"Lili! do not be rude.","¡Lili! No seas maleducada.");
 ds_map_add(m,"And our reward?","¿Y nuestra recompensa?");
 ds_map_add(m,"Oh.. there is nothing to be thankful for.","Oh... no hay nada que agradecer.");
 ds_map_add(m,"Thank you again, traveler, and this is the third criminal that we arrest thanks to you.","Gracias de nuevo, viajera. Ya es el tercer criminal que conseguimos arrestar gracias a vosotras.");
 ds_map_add(m,"But calm down if you lick the sweat you can pass your humiliation faster.","Pero tranquila, si lames el sudor, podrás superar esta humillación más rápido.");
 ds_map_add(m,"The only way you can get rid of this is by reaching climax.","La única forma de librarte de esto es llegando al orgasmo.");
 ds_map_add(m,"Ple-please let me go I can not continue like this.","P-por favor, déjame ir. No puedo seguir así.");
 ds_map_add(m,"I am a special Type of wyvern that can secrete an aphrodisiac and use it at will..","Soy un tipo especial de guiverno capaz de segregar un afrodisíaco y utilizarlo cuando quiera.");
 ds_map_add(m,"Bu-but why do I feel like this?","P-pero ¿por qué me siento así?");
 ds_map_add(m,"Haha and what if I'm not for the others you are just perverts who skipped the toll.","Jaja, ¿y si no lo soy? Para los demás, vosotros solo sois unos pervertidos que se han saltado el peaje.");
 ds_map_add(m,"Shit, you're not a guard!","¡Mierda, no eres un guardia!");
 ds_map_add(m,"Do you really think that I would let go without paying?","¿De verdad crees que te dejaría marchar sin pagar?");
 ds_map_add(m,"What the hell AHHHH.","¡¿Pero qué demonios?! ¡AAAAH!");
 ds_map_add(m,"I-I'm sorry Lili I ca-can not contain myself I do not know what's happening to me.","L-lo siento, Lili. No p-puedo contenerme. No sé qué me está pasando.");
 ds_map_add(m,"What the hell damn pervert !? do not touch yourself in public have some dignity!","¡¿Pero qué demonios, maldito pervertido?! ¡No te toques en público! ¡Ten un poco de dignidad!");
 ds_map_add(m,"I do not know, I feel very hot.","No lo sé. Tengo muchísimo calor.");
 ds_map_add(m,"Ah?.","¿Ah?");
 ds_map_add(m,"Oh .. Lili I do-do not feel good.","Oh... Lili, n-no me encuentro bien.");
 ds_map_add(m,"Just what I like to hear, from now on you'll help me cover all my tracks, haha~.","Eso es justo lo que quería oír. A partir de ahora me ayudarás a borrar todas mis huellas, jajaja~.");
 ds_map_add(m,"Yes! and I will take out all the wanted posters for the liberation of Line.","¡Sí! Y retiraré todos los carteles de búsqueda para liberar a Line.");
 ds_map_add(m,"We have a base where you can hide, but at least free Lili.","Tenemos una base donde puedes esconderte, pero al menos libera a Lili.");
 ds_map_add(m,"I know that you are the person who is in the wanted posters.","Sé que eres la persona que aparece en los carteles de búsqueda.");
 ds_map_add(m,"Wait please let me talk.","Espera, por favor, déjame hablar.");
 ds_map_add(m,"Uhh I see you finished how about a second round.","Uhh, veo que has terminado. ¿Qué tal una segunda ronda?");
 ds_map_add(m,"It would help me a lot to write my new novel, as I need new sources of inspiration, thank you for listening to my request, that's all I had to say, now I will continue with my next song.","Me ayudaría muchísimo a escribir mi nueva novela, porque necesito nuevas fuentes de inspiración. Gracias por escuchar mi petición. Eso era todo lo que quería decir. Ahora continuaré con mi siguiente canción.");
 ds_map_add(m,"Before I start my next song if anyone knows a hero or adventurer would you be so kind to introduce him to me.","Antes de empezar mi siguiente canción, si alguien conoce a algún héroe o aventurero, ¿sería tan amable de presentármelo?");
 ds_map_add(m,"Thank you all so much for listening <3.","Muchísimas gracias a todos por escucharme <3.");
 ds_map_add(m,"Lucy Monroe the wandering bard","Lucy Monroe, la barda errante");
 ds_map_add(m,"NOOOOOOOOOOOOOO!","¡¡¡NOOOOOOOOOOOOOO!");
 ds_map_add(m,"Lili, I need a coat, like right right now.","Lili, necesito un abrigo. Ahora mismo, pero ahora mismo.");
 ds_map_add(m,"OH no, please Line, NO!","¡Oh, no! ¡Por favor, Line, NO!");
 ds_map_add(m,"I think this experience has just awakened something inside me, something bad.","Creo que esta experiencia acaba de despertar algo dentro de mí. Algo malo.");
 ds_map_add(m,"Yeah?","¿Sí?");
 ds_map_add(m,"Uff thats my signal.","Uf, esa es mi señal.");
 ds_map_add(m,"That's all I'll call the guards","Ya basta. Voy a llamar a los guardias.");
 ds_map_add(m,"Yes! I mean no, I dont know D:.","¡Sí! Quiero decir, no... No lo sé D:.");
 ds_map_add(m,"Fuck no you weirdo.","¡Ni de coña, bicho raro!");
 ds_map_add(m,"You like what you see hehehe.","Te gusta lo que ves, jejeje.");
 ds_map_add(m,":O Lili she squirt in front of us!",":O ¡Lili, ha tenido un squirt delante de nosotros!");
 ds_map_add(m,"What that hell are you doing?!","¡¿Pero qué demonios estás haciendo?!");
 ds_map_add(m,"Yes wait, I have something to show you, where is it? oh it's here!","¡Sí, espera! Tengo algo que enseñarte. ¿Dónde está? ¡Ah, aquí!");
 ds_map_add(m,"Oh di-did you call me?","Oh, ¿m-me llamabas?");
 ds_map_add(m,"Yes you, the one with blue hair!","¡Sí, tú, la de pelo azul!");
 ds_map_add(m,"Ah?","¿Ah?");
 ds_map_add(m,"Hey you, come here!","¡Eh, tú! ¡Ven aquí!");
 ds_map_add(m,"I've never done this you dirty pervert! Now go do what you came here to do!","¡Nunca había hecho algo así, maldito pervertido asqueroso! ¡Ahora ve y haz lo que viniste a hacer!");
 ds_map_add(m,"Lili, you are a genius. Are you sure you haven't done this before?","Lili, eres un genio. ¿Seguro que nunca habías hecho esto antes?");
 ds_map_add(m,"If you do so with no one in front of you, you may attract the attention of a guard.","Si haces eso sin que haya nadie delante, podrías llamar la atención de algún guardia.");
 ds_map_add(m,"Just yell and get someone's attention will come and when they are in front of you open your coat.","Solo tienes que gritar para llamar la atención de alguien. Cuando se acerque, abre el abrigo.");
 ds_map_add(m,"But I need someone to come, what do I do then?","Pero necesito que alguien venga. ¿Qué hago entonces?");
 ds_map_add(m,"Ahhh, look I won't look for anyone but I'll be with you.","Ahhh, escucha, no voy a buscar a nadie, pero me quedaré contigo.");
 ds_map_add(m,"B-but Lili I really need you :c.","P-pero, Lili, de verdad te necesito :c.");
 ds_map_add(m,"What no way!?","¡¿Qué?! ¡¿En serio?!");
 ds_map_add(m,"Ehem, I am going to change my clothes, you-you bring someone.","Ejem, voy a cambiarme de ropa. T-tú trae a alguien.");
 ds_map_add(m,"I worry about you sometimes Line.","A veces me preocupas, Line.");
 ds_map_add(m,"Hehehehehe Eeeehhhhhh.","Jejejejeje... ¡Eeeeeeh!");
 ds_map_add(m,"Thank you Lili.","Gracias, Lili.");
 ds_map_add(m,"*Patting Line's head *Oh ya ya, you'll be all right.","*Le da unas palmaditas en la cabeza a Line* Oh, ya, ya. Todo irá bien.");
 ds_map_add(m,"yes, although she pulls my hair in a way that I don't like :c.","Sí, aunque me tira del pelo de una forma que no me gusta :c.");
 ds_map_add(m,"Don't worry, I just said it to make her go away.","No te preocupes, solo lo dije para que se marchara.");
 ds_map_add(m,"Ay Lili, where can I hide?","Ay, Lili, ¿dónde puedo esconderme?");
 ds_map_add(m,"OH ok :c","Oh, vale :c.");
 ds_map_add(m,"Tsk I have to go but if I see you here again, you're dead.","Tsk, tengo que irme, pero si vuelvo a verte aquí, estás muerta.");
 ds_map_add(m,"Ehh you better hide you made a lot of noise the guards are coming!","¡Eh, será mejor que te escondas! ¡Has hecho demasiado ruido y vienen los guardias!");
 ds_map_add(m,"AHh Lili help me!","¡Aaaah, Lili, ayúdame!");
 ds_map_add(m,"Who do you think you are? Stealing my place, I've been stripping here for weeks!","¿Quién te crees que eres? ¡Me estás quitando el sitio! ¡Llevo semanas desnudándome aquí!");
 ds_map_add(m,"Come here you stupid bitch.","Ven aquí, estúpida zorra.");
 ds_map_add(m,"Me? I am not doing anything, I swear.","¿Yo? No estoy haciendo nada, lo juro.");
 ds_map_add(m,"What the hell are you doing here? This is my place.","¿Qué demonios haces aquí? Este es mi sitio.");
 ds_map_add(m,"Hey you!","¡Eh, tú!");
 ds_map_add(m,"Shouldn't we take it to the guards?","¿No deberíamos entregárselo a los guardias?");
 ds_map_add(m,"Wow it's a scarlet crystal sphere! We could pass it on to the fortune teller since she was looking for it.","¡Vaya, es una esfera de cristal escarlata! Podríamos dársela a la adivina, ya que estaba buscándola.");
 ds_map_add(m,"Look Lili what I found.","Mira, Lili, lo que he encontrado.");
 ds_map_add(m,"Mmmmm... no, we could use it for something or sell it :V.","Mmmmm... no. Podríamos utilizarla para algo o venderla :V.");
 ds_map_add(m,"Should not we take it to the guards?","¿No deberíamos entregársela a los guardias?");
 ds_map_add(m,"Hey! that ball is not the one I handed it to him, it looks like glass.","¡Eh! Esa bola no es la que le entregué. Parece de cristal.");
 ds_map_add(m,"Look Lili the red ball!","¡Mira, Lili, la bola roja!");
 ds_map_add(m,"Magenta swamp.","Pantano Magenta.");
 ds_map_add(m,"Welcome to the Magenta swamp, the place where the most brutal mud fights in the world take place!!","¡¡Bienvenidos al Pantano Magenta, donde tienen lugar las peleas de barro más brutales del mundo!!");
 ds_map_add(m,"Oh you talk like you don't Like it, looks like Jessi spoiled you alot, you bad little girl.","Oh, hablas como si no te gustara. Parece que Jessi te ha malcriado muchísimo, pequeña traviesa.");
 ds_map_add(m,"Playtime is over Elena, leave the puppet and the diaper on the floor and you won't get hurt.","Se acabó el juego, Elena. Deja el títere y el pañal en el suelo y no te haremos daño.");
 ds_map_add(m,"Yeah what she said, you will not kidnap anyone while we are here.","Eso mismo. Mientras estemos aquí, no secuestrarás a nadie.");
 ds_map_add(m,"Stop right there you criminal scum!","¡Alto ahí, escoria criminal!");
 ds_map_add(m,"Of course Line, there is no problem with that.","Por supuesto, Line. No hay ningún problema.");
 ds_map_add(m,"At least can we accompany you to the entrance of the town?","Al menos, ¿podemos acompañarte hasta la entrada del pueblo?");
 ds_map_add(m,"I'm sorry Line I really have to go.","Lo siento, Line. De verdad tengo que irme.");
 ds_map_add(m,"Oh... I thought we could spend a little more time together but, its ok.","Oh... Pensaba que podríamos pasar un poco más de tiempo juntas, pero está bien.");
 ds_map_add(m,"I have to return to Tricotex with my partner, sadly being a hero is a job that never ends.","Tengo que regresar a Tricotex con mi compañero. Por desgracia, ser héroe es un trabajo que nunca termina.");
 ds_map_add(m,"We made it Sam now that we caught the criminal, but now what will you do?","Lo conseguimos, Sam. Ya hemos atrapado a la criminal, pero ¿qué harás ahora?");
 ds_map_add(m,"Girls. You did a good job. I'll take her to the jail-farm to serve her sentence.","Chicas, habéis hecho un buen trabajo. La llevaré a la granja-prisión para que cumpla su condena.");
 ds_map_add(m,"Fairy where?","¿Dónde está el hada?");
 ds_map_add(m,"Well I would have gotten away with it, if it weren't for these nosy kids and their fairy.","Me habría salido con la mía si no fuera por estos niños entrometidos y su hada.");
 ds_map_add(m,"Yes, there will be no ABC Daycare here on the island!","¡Sí! ¡Aquí en la isla no habrá ninguna Guardería ABC!");
 ds_map_add(m,"Your days kidnapping people are over.","Se acabó para ti eso de secuestrar gente.");
 ds_map_add(m,"Game over Elena we already beat you, you can't escape.","Se acabó, Elena. Ya te hemos derrotado, no puedes escapar.");
 ds_map_add(m,"Please someone help me I don't want to wear a diaper!","¡Por favor, que alguien me ayude! ¡No quiero llevar pañales!");
 ds_map_add(m,"It seems that I must teach these bad girls how to behave.","Parece que tendré que enseñarles a estas chicas malas cómo deben comportarse.");
 ds_map_add(m,"To fight!","¡A luchar!");
 ds_map_add(m,"Thank you Line, with you helping my I know can get back home.","Gracias, Line. Con tu ayuda sé que podré volver a casa.");
 ds_map_add(m,"Don't worry Vasuki we will get the crystal.","No te preocupes, Vasuki. Conseguiremos el cristal.");
 ds_map_add(m,"Line these two will not leave the crystal we will have to take it by force.","Line, estas dos no van a entregar el cristal. Tendremos que quitárselo por la fuerza.");
 ds_map_add(m,"Sorry, but we also need these Crystals for the people we love.","Lo siento, pero nosotros también necesitamos estos cristales para las personas que queremos.");
 ds_map_add(m,"Please, I have family my children await my return.","Por favor, tengo una familia. Mis hijos esperan que regrese.");
 ds_map_add(m,"Stop kidding this crystal is the only thing that separates Vasuki from her home.","Deja de bromear. Este cristal es lo único que separa a Vasuki de su hogar.");
 ds_map_add(m,"This Crystal belongs to Red Team!","¡Este cristal pertenece al Equipo Rojo!");
 ds_map_add(m,"Why are your so mean?","¿Por qué eres tan mala?");
 ds_map_add(m,"Ay Line you are very kind to me hehe.","Ay, Line, eres muy amable conmigo, jeje.");
 ds_map_add(m,"Sounds great, I heard they grow special fruits there, I would love to eat something new with you <3.","Suena genial. He oído que allí cultivan frutas especiales. Me encantaría probar algo nuevo contigo <3.");
 ds_map_add(m,"Yes. I think it would be for the best, I even have some fruits that the cows gave me.","Sí. Creo que será lo mejor. Incluso tengo algunas frutas que me dieron las vacas.");
 ds_map_add(m,"Come to my house so you can rest and then return to your dimension, Vasuki, something could happen to you if you fall unconscious in the change of dimensions.","Vasuki, ven a mi casa a descansar y después podrás regresar a tu dimensión. Podría pasarte algo si pierdes el conocimiento durante el cambio dimensional.");
 ds_map_add(m,"I have not rested since I came to this dimension.","No he descansado desde que llegué a esta dimensión.");
 ds_map_add(m,"Vasuki do you feel good?","Vasuki, ¿te encuentras bien?");
 ds_map_add(m,"Now, I just have to ...","Ahora solo tengo que...");
 ds_map_add(m,"Oh sorry Lili thank you so much to you too.","Oh, perdona, Lili. Muchísimas gracias a ti también.");
 ds_map_add(m,"Ehemmmm.","Ejemmmm.");
 ds_map_add(m,"Thank you very much Line, I can finally return home.","Muchísimas gracias, Line. Por fin puedo regresar a casa.");
 ds_map_add(m,"We made it <3!","¡Lo conseguimos <3!");
 ds_map_add(m,"Count on me Vasuki you will have my full support.","Cuenta conmigo, Vasuki. Tendrás todo mi apoyo.");
 ds_map_add(m,"Line, will you help me to get proof? and thus reveal to the whole island what is going on here.","Line, ¿me ayudarás a conseguir pruebas para revelar a toda la isla lo que está ocurriendo aquí?");
 ds_map_add(m,"That so terrible she looked such a good woman.","Qué terrible. Parecía una mujer tan buena.");
 ds_map_add(m,"I believe they are involved.","Creo que están involucrados.");
 ds_map_add(m,"I went to tell the guards before I started my investigation and they told me that there was nothing unusual going on in this house.","Antes de empezar mi investigación, fui a informar a los guardias, pero me dijeron que no ocurría nada extraño en esta casa.");
 ds_map_add(m,"What! we must tell the great captain.","¡¿Qué?! Tenemos que informar al gran capitán.");
 ds_map_add(m,"Very bad I'm afraid Lili, I heard things like, money laundering, trafficking of people and drugs.","Me temo que es algo muy grave, Lili. He oído cosas sobre blanqueo de dinero, tráfico de personas y drogas.");
 ds_map_add(m,"Come on how bad can this place be it's almost a paradise, well apart from that white demon.","Vamos, ¿tan malo puede ser este lugar? Es casi un paraíso, salvo por ese demonio blanco.");
 ds_map_add(m,"Well I work as a bounty hunter to help around the house and in one of my jobs I heard some very bad things about this place.","Trabajo como cazarrecompensas para ayudar en casa y, durante uno de mis encargos, escuché cosas bastante desagradables sobre este lugar.");
 ds_map_add(m,"Line... well I'm investigating this place.","Line... bueno, estoy investigando este lugar.");
 ds_map_add(m,"Hi Vasuki, what are you doing here?","Hola, Vasuki. ¿Qué haces aquí?");
 ds_map_add(m,"I don't think entering a house without Vasuki is good idea.","No creo que sea buena idea entrar en una casa sin Vasuki.");
 ds_map_add(m,"Hehe thank you.","Jeje, gracias.");
 ds_map_add(m,"Bell that is beautiful.","Bell, qué bonito.");
 ds_map_add(m,"If I can get it, I could save it from extinction and give a second chance to the island and its people.","Si consigo encontrarla, podré salvarla de la extinción y darle una segunda oportunidad a la isla y a sus habitantes.");
 ds_map_add(m,"Yes, but when I heard that one of them was still alive I couldn't stop myself from looking for it.","Sí, pero cuando oí que una de ellas seguía viva, no pude resistirme a buscarla.");
 ds_map_add(m,"So it's just a strange flower? because in this island nowadays everything has aphrodisiacs..","Entonces, ¿solo es una flor extraña? Porque hoy en día en esta isla todo lleva afrodisíacos...");
 ds_map_add(m,"Hehe not really, in ancient times this flower was used for its aphrodisiac properties and because of that the people of the island drove it to extinction.","Jeje, no exactamente. En la antigüedad esta flor se utilizaba por sus propiedades afrodisíacas y, por culpa de ello, los habitantes de la isla la llevaron a la extinción.");
 ds_map_add(m,"And why are you looking so hard for that flower, does it grant wishes or something?","¿Y por qué buscas esa flor con tanto empeño? ¿Concede deseos o algo así?");
 ds_map_add(m,"Someone must have hidden this path for some reason, maybe the flower is there.","Alguien debió de ocultar este camino por algún motivo. Quizá la flor esté allí.");
 ds_map_add(m,"Mmm.. I think I see a path behind the cat tails.","Mmm... creo que veo un camino detrás de las espadañas.");
 ds_map_add(m,"Exactly, they shouldn't grow so close together, someone must have planted them there.","Exactamente. No deberían crecer tan juntas. Alguien debió de plantarlas allí.");
 ds_map_add(m,"Yes, there are a many.","Sí, hay muchísimas.");
 ds_map_add(m,"Line you see those cat tails","Line, ¿ves esas espadañas?");
 ds_map_add(m,"Lili don't be mean you can fly, besides I have my tights wet :c","Lili, no seas mala. Tú puedes volar y, además, tengo las medias empapadas :c.");
 ds_map_add(m,"I do not want to go through all these plants.","No quiero atravesar todas estas plantas.");
 ds_map_add(m,"Hey girl! if you want to harvest some mushrooms you better pay to play.","¡Eh, chica! Si quieres recoger setas, más te vale pagar para participar.");
 ds_map_add(m,"Thanks for playing! come and get your Arcs.","¡Gracias por jugar! Ven a recoger tus Arcs.");
 ds_map_add(m,"OH I almost forgot, since you managed to harvest your first mushroom perfectly, you can keep it.","¡Ah, casi se me olvida! Como has conseguido recoger tu primera seta a la perfección, puedes quedártela.");
 ds_map_add(m,"Great wait a second while your opponent arrives.","¡Genial! Espera un momento mientras llega tu oponente.");
 ds_map_add(m,"The prize for winning is 100 Arcs.","El premio por ganar es de 100 Arcs.");
 ds_map_add(m,"The game ends when one of the contestants makes the opponent pass the boundary line.","La partida termina cuando uno de los participantes consigue arrastrar al otro más allá de la línea límite.");
 ds_map_add(m,"Once the game starts you must press the button when the bar is at maximum so you will use all your strength to pull the rope.","Cuando empiece el juego, pulsa el botón cuando la barra esté al máximo. Así tirarás de la cuerda con todas tus fuerzas.");
 ds_map_add(m,"Hey want to play danglinging-ass-rope? You can play for 50 Arcs.","¡Eh! ¿Quieres jugar a la cuerda colgante del culo? Cuesta 50 Arcs.");
 ds_map_add(m,"Good luck next time, I look forward to seeing you if you want to play again.","¡Buena suerte la próxima vez! Aquí estaré si quieres volver a jugar.");
 ds_map_add(m,"Hey to use the onaholes you need a ticket!","¡Eh! ¡Necesitas un boleto para usar las muñecas sexuales!");
 ds_map_add(m,"Calm lili, but thanks for saying that <3 you are the best fairy a half elf can have.","Tranquila, Lili, pero gracias por decir eso <3. Eres el mejor hada que podría tener una semielfa.");
 ds_map_add(m,"A proud half succubus!","¡Una orgullosa mitad súcubo!");
 ds_map_add(m,"She is a proud half succubus!","¡Es una orgullosa mitad súcubo!");
 ds_map_add(m,"Hey, don't give her money after sex like she's a whore !","¡Eh, no le des dinero después de acostarte con ella como si fuera una puta!");
 ds_map_add(m,"Keep the money, I have to go now.","Quédate con el dinero, ahora tengo que irme.");
 ds_map_add(m,"Ohh god I really need that.","Oh, Dios, de verdad necesito eso.");
 ds_map_add(m,"Hi I'm SailorCum just turn around to give you a rimjob.","Hola, soy SailorCum. Date la vuelta y te haré un beso negro.");
 ds_map_add(m,"WHAT ONlY 10 Arcs!? I'm GOING TO KILL YOU DROGITAS!","¿¡QUÉ, SOLO 10 ARCS!? ¡VOY A MATAROS, DROGITAS!");
 ds_map_add(m,"Ah.. whatever, why not.","Ah... como quieras. ¿Por qué no?");
 ds_map_add(m,"Lili you are a master negotiator. o.O","Lili, eres una negociadora de primera. o.O");
 ds_map_add(m,"Virgin of the ears, we will give you 10 arc no more nor less and you must give us a Deviant fruit so Line can grows a penis.","Virgen de las orejas, te daremos 10 Arcs, ni uno más ni uno menos, y tú nos darás una fruta desviada para que Line pueda desarrollar un pene.");
 ds_map_add(m,"Well, don't you want to use Zoi? to start raising money only 30 Arcs while she is still a virgin.","Bueno, ¿no quieres usar a Zoi para empezar a ganar dinero? Solo 30 Arcs mientras siga siendo virgen.");
 ds_map_add(m,"Here you pay with Arcs, seeing the good side at least now you know.","Aquí se paga con Arcs. Míralo por el lado bueno: al menos ahora ya lo sabes.");
 ds_map_add(m,"No wonder they all came to my hole. :c","Con razón todos venían a mi agujero. :c");
 ds_map_add(m,"The entrance of the town there is a gold mine literally everyone in town has is basically garbage here.","A la entrada del pueblo hay una mina de oro. Literalmente, todo el mundo tiene oro; aquí prácticamente no vale nada.");
 ds_map_add(m,"Explain yourself fairy!!","¡Explícate, hada!");
 ds_map_add(m,"Wh-WHAT!?","¿¡Q-QUÉ!?");
 ds_map_add(m,"Hey I'm sorry to tell you that gold is worth nothing here so you're stranded until you can buy a boat on this island.","Oye, siento decírtelo, pero aquí el oro no vale nada. Te quedarás atrapada hasta que puedas comprar un barco en esta isla.");
 ds_map_add(m,"Ohh .. okay but be nice please.","Oh... vale, pero sé amable, por favor.");
 ds_map_add(m,"So you prefer that they make a fool of themselves when buying the boat?","¿Así que prefieres que hagan el ridículo al comprar el barco?");
 ds_map_add(m,"Do not bother them Lili let's keep going.","No las molestes, Lili. Sigamos adelante.");
 ds_map_add(m,"... Wow, what a dumm ass I will tell her the truth.","... Vaya, qué idiota. Voy a decirle la verdad.");
 ds_map_add(m,"Finally we can start our adventure once and for all.","Por fin podremos empezar nuestra aventura de una vez por todas.");
 ds_map_add(m,"We did it drogitas, we finally have enough gold to buy a boat!","¡Lo conseguimos, Drogitas! ¡Por fin tenemos suficiente oro para comprar un barco!");
 ds_map_add(m,"... You are lucky to be cute Line.","... Menos mal que eres mona, Line.");
 ds_map_add(m,"I don't think she was a virgin, Lili.","No creo que fuera virgen, Lili.");
 ds_map_add(m,"DROGITAS!","¡DROGITAS!");
 ds_map_add(m,"New offer a20 arcs since she talks a lot!","¡Nueva oferta: 20 Arcs, porque habla demasiado!");
 ds_map_add(m,"Hey wait give me a brake that woman left me a little tired.","¡Eh, espera, dame un respiro! Esa mujer me ha dejado agotada.");
 ds_map_add(m,"New onahole offer at 30 arcs take advantage now that it is still virgin!","¡Nueva oferta de muñeca sexual por 30 Arcs! ¡Aprovecha mientras todavía sea virgen!");
 ds_map_add(m,"Attention everyone!","¡Atención, todo el mundo!");
 ds_map_add(m,"Yeah was great thanks Lili! <3","¡Sí, ha sido genial! ¡Gracias, Lili! <3");
 ds_map_add(m,"So you have fun Line? <3","¿Te has divertido, Line? <3");
