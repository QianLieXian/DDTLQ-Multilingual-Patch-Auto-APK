 ds_map_add(m,"We'll take some time, we'll be doing girl things.","Tardaremos un rato. Vamos a hacer cosas de chicas.");
 ds_map_add(m,"That' s enough! go to the goddamn bathroom.","¡Ya basta! ¡Vete al maldito baño!");
 ds_map_add(m,"Hold on Line and we'll see what we can do.","Aguanta, Line. Veremos qué podemos hacer.");
 ds_map_add(m,"Hey hey,I don't want to be part of this conversation anymore.","Eh, eh, ya no quiero formar parte de esta conversación.");
 ds_map_add(m,"Hey, I don't have those tas!","¡Eh, yo no tengo esas aficiones!");
 ds_map_add(m,"Well if you want to see my friend pee herself that's fine, I don't judge other people's tastes.","Bueno, si quieres ver cómo mi amiga se mea encima, no pasa nada. No juzgo los gustos de los demás.");
 ds_map_add(m,"I can't let anyone pass.","No puedo dejar pasar a nadie.");
 ds_map_add(m,"Please we need your help? or do you want to see her pee.","Por favor, necesitamos tu ayuda. ¿O acaso quieres verla mearse encima?");
 ds_map_add(m,"Ohh Lili I can't hold on any longer.","Ohhh, Lili, ya no puedo aguantar más.");
