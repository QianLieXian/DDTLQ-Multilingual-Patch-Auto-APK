 ds_map_add(m,"Today you will lose your virginity on both sides.","Hoy perderás la virginidad por delante y por detrás.");
 ds_map_add(m,"I love it I hope you can stand this.","Me encanta. Espero que puedas soportarlo.");
 ds_map_add(m,"Ehh well yes it i-it's m-my first time (AHhhh I am a horrible hypocrite).","Eh, bueno, sí. Es-es mi-mi primera vez. (AAAAhhh, soy una hipócrita horrible).");
 ds_map_add(m,"Hehe you look like a very innocent girl.","Jeje, pareces una chica muy inocente.");
 ds_map_add(m,"Now we just have to find proof of what is going on here.","Ahora solo tenemos que encontrar pruebas de lo que está pasando aquí.");
 ds_map_add(m,"Ah there's no need to thanks me hehe.","Ah, no hace falta que me des las gracias, jeje.");
 ds_map_add(m,"Well done Lili. <3","Bien hecho, Lili. <3");
 ds_map_add(m,"...(fucking fairy)","...(Maldita hada).");
 ds_map_add(m,"Oh of course you don't want to know.","Oh, claro, seguro que no quieres saberlo.");
