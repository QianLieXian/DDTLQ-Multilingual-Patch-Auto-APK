 ds_map_add(m,"Limbo Leotard","Malla de Limbo");
 ds_map_add(m,"Limbo Boots","Botas de Limbo");
 ds_map_add(m,"Cow Bras","Sujetador de vaca");
 ds_map_add(m,"Cow Stockings","Medias de vaca");
 ds_map_add(m,"Cow Bell","Cencerro");
 ds_map_add(m,"Cow Panties","Bragas de vaca");
 ds_map_add(m,"OH Bunny Heels","Tacones de conejita OH");
 ds_map_add(m,"OH Bunny Tights","Medias de conejita OH");
 ds_map_add(m,"OH Bunny Top","Top de conejita OH");
 ds_map_add(m,"OH Bunny Ears","Orejas de conejita OH");
 ds_map_add(m,"Face Mask","Máscara");
 ds_map_add(m,"Cat Ears","Orejas de gato");
 ds_map_add(m,"Knight Chain Mail","Cota de malla de caballero");
 ds_map_add(m,"Knight Boots","Botas de caballero");
 ds_map_add(m,"Knight Gloves","Guantes de caballero");
 ds_map_add(m,"The Perverted Coat","El abrigo pervertido");
 ds_map_add(m,"Haigure Leotard","Malla Haigure");
 ds_map_add(m,"Limbo Gloves","Guantes de Limbo");
 ds_map_add(m,"Smoosher-T-Shirt","Camiseta de Smoosher");
 ds_map_add(m,"Smoosher Shorts","Pantalones cortos de Smoosher");
 ds_map_add(m,"Dark Greaves","Grebas oscuras");
 ds_map_add(m,"Dark Tiara","Tiara oscura");
 ds_map_add(m,"FurrHead","Cabeza de furro");
 ds_map_add(m,"FurrTop","Parte superior de furro");
 ds_map_add(m,"FurrPants","Pantalones de furro");
 ds_map_add(m,"FurrBoots","Botas de furro");
 ds_map_add(m,"Nun Hat","Toca de monja");
 ds_map_add(m,"Nun Dress","Vestido de monja");
 ds_map_add(m,"Nun Socks","Calcetines de monja");
 ds_map_add(m,"Nun Boots","Botas de monja");
 ds_map_add(m,"Pelletclad Blade","Hoja Pelletclad");
 ds_map_add(m,"Place Holder Quest","Misión provisional");
 ds_map_add(m,"Finally, you muster the courage to embark on an adventure with your fairy familiar to find and bring back your childhood best friend.","Por fin reúnes el valor para emprender una aventura con tu hada familiar y encontrar a tu mejor amiga de la infancia para traerla de vuelta.");
 ds_map_add(m,"Check the cat woman's shop; there might be something that interests you.","Echa un vistazo a la tienda de la mujer gato; puede que encuentres algo que te interese.");
 ds_map_add(m,"The cat woman who runs the shop is somewhat grumpy because she hasn't had the chance to eat lunch.","La mujer gato que lleva la tienda está algo gruñona porque todavía no ha podido almorzar.");
 ds_map_add(m,"You managed to read the sinful thoughts of the fisherman. Perhaps this is your chance to explore your powers.","Has conseguido leer los pensamientos pecaminosos del pescador. Quizá sea tu oportunidad de explorar tus poderes.");
 ds_map_add(m,"Lili pushes you to be more proactive in training your succubus powers, so she sends you to try to seduce the cat woman who runs the shop. It should be easier since you know her.","Lili te anima a entrenar tus poderes de súcubo de forma más activa, así que te manda a intentar seducir a la mujer gato de la tienda. Debería ser más fácil porque ya la conoces.");
 ds_map_add(m,"There is a high-rank demon who has been stealing alcohol shipments. You decide to find and defeat her to see if you can get information about Ava.","En la isla hay una demonio de alto rango que roba cargamentos de alcohol. Decides encontrarla y derrotarla para ver si puedes conseguir información sobre Ava.");
 ds_map_add(m,"You're very lucky! You recognized one of the women who appeared in your mother's XXX magazines! She says she'll give you a special service for old times' sake.","¡Qué suerte tienes! ¡Has reconocido a una de las mujeres que aparecían en las revistas XXX de tu madre! Dice que te dará un servicio especial por los viejos tiempos.");
 ds_map_add(m,"You found a woman with violet pigtails at the corner of the bar. She says she can lend you money, but you must pay her back with an additional ten percent.","Encontraste a una mujer con coletas violetas en un rincón del bar. Dice que puede prestarte dinero, pero tendrás que devolverle un diez por ciento más.");
 ds_map_add(m,"There's a cat woman playing very mean pranks on the villagers, and they're blaming Callie's daughter. Find the real culprit and save Callie's daughter!","Hay una mujer gato que gasta bromas muy crueles a los aldeanos, pero todos culpan a la hija de Callie. ¡Encuentra a la verdadera culpable y salva a la hija de Callie!");
 ds_map_add(m,"The plant woman from the shop told you she's very thirsty, and Lili suggested buying her beer to see if she'll give you discounts while drunk.","La mujer planta de la tienda te dijo que tiene muchísima sed, y Lili sugirió comprarle cerveza para ver si te hace algún descuento cuando esté borracha.");
 ds_map_add(m,"A dragon woman fell from the sky among the prisoners and seems to be fighting to prevent a crystal from being stolen. Lili suggests we help her; maybe they'll reward us with something valuable.","Una mujer dragón cayó del cielo entre los prisioneros y parece estar luchando para impedir que le roben un cristal. Lili propone ayudarla; quizá nos recompensen con algo valioso.");
 ds_map_add(m,"There's a strange woman with pink hair hiding in a corner of the circus. Find out why people are talking about her.","Hay una extraña mujer de pelo rosa escondida en un rincón del circo. Averigua por qué habla todo el mundo de ella.");
 ds_map_add(m,"You found your favorite heroine! Sam, the protector of Tricotex. Prove that you have what it takes to embark on a capture mission with her.","¡Has encontrado a tu heroína favorita! Sam, la protectora de Tricotex. Demuéstrale que estás a la altura para acompañarla en una misión de captura.");
 ds_map_add(m,"Someone is impersonating a knight of Elira to scam people. Catch them and be the heroine you always wanted to be!","Alguien se hace pasar por caballero de Elira para estafar a la gente. ¡Atrápalo y conviértete en la heroína que siempre quisiste ser!");
 ds_map_add(m,"Kristoff, a VIP customer at the bar, is very angry and asks if you can buy him some premium cigarettes to help him calm down.","Kristoff, un cliente VIP del bar, está furioso y te pregunta si puedes comprarle unos cigarrillos prémium para ayudarlo a calmarse.");
 ds_map_add(m,"The hotel secretary informs you that you've caught the attention of a woman who will be waiting for you on the top floor of the hotel. Hmm, what could she want? It might be important.","La recepcionista del hotel te informa de que has llamado la atención de una mujer que te esperará en la última planta. Mmm, ¿qué querrá? Puede que sea importante.");
 ds_map_add(m,"You've become a minion of a seemingly powerful individual! They order you to bring the dimensional fracture, which looks like a floating crystal, to leave this dimension.","¡Te has convertido en el secuaz de alguien que parece muy poderoso! Te ordena traerle la fractura dimensional, que tiene aspecto de cristal flotante, para poder abandonar esta dimensión.");
 ds_map_add(m,"There was a collapse in the cave, leaving many miners trapped. Wait until the knight of Elira clears the passage.","Se ha producido un derrumbe en la cueva y muchos mineros han quedado atrapados. Espera a que la caballera de Elira despeje el paso.");
 ds_map_add(m,"There are some rumors of strange sounds coming from the Silent Forest at night. What could it be?","Circulan rumores sobre unos sonidos extraños que vienen del Bosque Silencioso por la noche. ¿Qué será?");
 ds_map_add(m,"An Onahole is desperate to buy a boat and is selling her body to do so. As an act of charity, help her.","Una muñeca sexual está desesperada por comprar un barco y vende su cuerpo para conseguirlo. Haz una buena obra y ayúdala.");
 ds_map_add(m,"Ivy, a honey slime, recognizes you as an adventurer who helps people and asks if you can help her find a part of herself that hasn't returned.","Ivy, una slime de miel, te reconoce como un aventurero que ayuda a la gente y te pide que la ayudes a encontrar una parte de sí misma que todavía no ha regresado.");
 ds_map_add(m,"You heard the Grand Captain of the Elira Guards arguing with a woman about the ineptitude of the knights. Maybe if you help them, they can assist you in your quest.","Has oído al gran capitán de la Guardia de Elira discutir con una mujer sobre la incompetencia de los caballeros. Quizá, si los ayudas, ellos puedan echarte una mano en tu misión.");
 ds_map_add(m,"You encountered Faye, a space-dimensional traveler trapped in your dimension. You decided to help her because you felt sorry for her.","Te encontraste con Faye, una viajera entre dimensiones espaciales atrapada en la tuya. Decidiste ayudarla porque te dio pena.");
 ds_map_add(m,"Vasuki tells you that something bad is happening at the mushroom house in the magenta swamp. Upon investigating, it seems that there may be human trafficking and drug activities occurring there.","Vasuki te cuenta que está pasando algo malo en la casa de los hongos del pantano magenta. Al investigar, parece que allí podría haber trata de personas y tráfico de drogas.");
 ds_map_add(m,"You found someone smelling the flowers, but as soon as you spoke to them, they attacked you. Find out what's really going on!","Encontraste a alguien oliendo las flores, pero en cuanto le hablaste, te atacó. ¡Averigua qué está pasando realmente!");
 ds_map_add(m,"There's something about Marael that doesn't quite convince you. Look into what she's really hiding.","Hay algo en Marael que no termina de convencerte. Investiga qué es lo que oculta en realidad.");
 ds_map_add(m,"A letter addressed to Marael gives you clues that a woman named Willow also contacted Ava. Look for her to gather more information.","Una carta dirigida a Marael te da pistas de que una mujer llamada Willow también se puso en contacto con Ava. Búscala para conseguir más información.");
 ds_map_add(m,"There's a bard woman looking for an adventurer to inspire her. Show her that you're a worthy adventurer capable of inspiring others!","Una barda está buscando a un aventurero que la inspire. ¡Demuéstrale que eres una aventurera digna, capaz de inspirar a los demás!");
 ds_map_add(m,"After being attacked by a pervert who opened his leather coat and showed you everything, something awakened inside of you.","Después de que un pervertido te atacara abriéndose el abrigo de cuero y enseñándotelo todo, algo despertó en tu interior.");
 ds_map_add(m,"The island is cordoned off because someone stole the relics from the church. As part of the deal to stay on the island, you agree to help the knights of Elira search for the relics.","La isla está acordonada porque alguien robó las reliquias de la iglesia. Como parte del acuerdo para poder quedarte en la isla, aceptas ayudar a los caballeros de Elira a buscar las reliquias.");
 ds_map_add(m,"An Onahole stuck to the wall in the VIP area of the bar tells you that if you buy her entire outfit, she'll give you a rimjob!","Una muñeca sexual pegada a la pared de la zona VIP del bar te dice que, si le compras todo el conjunto de ropa, ¡te hará un beso negro!");
 ds_map_add(m,"Lili says you're very stinky and need a bath.","Lili dice que apestas y que necesitas darte un baño.");
 ds_map_add(m,"The librarian is lost, and no one knows where she is. Look for her, and perhaps you'll find more information about the people who go missing on the island.","La bibliotecaria ha desaparecido y nadie sabe dónde está. Búscala; quizá encuentres más información sobre la gente que desaparece en la isla.");
 ds_map_add(m,"Gildfried, a businessman on vacation on the island, unfortunately lost his briefcase, which is very important to him.","Gildfried, un empresario que está de vacaciones en la isla, ha perdido por desgracia su maletín, que es muy importante para él.");
 ds_map_add(m,"Lemmy, a green monster outside an automated carriage, talks to Lili and asks for help because his mistress is having trouble.","Lemmy, un monstruo verde que está junto a un carruaje automático, habla con Lili y pide ayuda porque su ama tiene problemas.");
 ds_map_add(m,"Sakura is working at the renowned fast food restaurant Smooshers! She asks for your help in searching for the lost uniforms.","¡Sakura trabaja en el famoso restaurante de comida rápida Smooshers! Te pide ayuda para encontrar los uniformes perdidos.");
 ds_map_add(m,"One of Vasera's clones has gained autonomy. Vasera will go search for it and neutralize it. She advises you to kill it if you encounter it.","Uno de los clones de Vasera ha desarrollado voluntad propia. Vasera irá a buscarlo para neutralizarlo. Te aconseja matarlo si te lo encuentras.");
 ds_map_add(m,"Sieki got angry with you because even though she already paid the debt to MsHonney, you're still in the VIP area. Now you follow her orders to avoid making her angrier.","Sieki se enfadó contigo porque, aunque ya pagó la deuda con la señorita Honney, sigues en la zona VIP. Ahora obedeces sus órdenes para no enfadarla aún más.");
 ds_map_add(m,"The farmer confesses that she would like to work with less clothing. How could you help her work more comfortably?","La granjera confiesa que le gustaría trabajar con menos ropa. ¿Cómo podrías ayudarla a trabajar más cómoda?");
 ds_map_add(m,"The fortune teller confessed to you that she would like to have a red crystal orb because with it she could see her own future.","La adivina te confesó que le gustaría tener un orbe de cristal rojo, porque así podría ver su propio futuro.");
 ds_map_add(m,"The water nymph who works at the bar is looking for love but is insecure because she doesn't know if people approach her for the beer or if they genuinely want something with her.","La ninfa acuática que trabaja en el bar busca el amor, pero se siente insegura porque no sabe si la gente se acerca por la cerveza o porque de verdad quiere algo con ella.");
 ds_map_add(m,"Accidentally, you ruin Naoki's concoction just as he's entering mating season, so you decide to help him.","Accidentalmente arruinas la mezcla de Naoki justo cuando está entrando en época de apareamiento, así que decides ayudarlo.");
 ds_map_add(m,"Lucy the bard is having trouble with an Onahole, so you decide to help her with whatever she needs.","Lucy, la barda, tiene problemas con una muñeca sexual, así que decides ayudarla con lo que necesite.");
 ds_map_add(m,"There are portals for self-satisfaction in the VIP area of the bar, but a witch won't let you use them.","En la zona VIP del bar hay portales para darse placer, pero una bruja no te deja usarlos.");
 ds_map_add(m,"Sieki has a big problem and makes you a deal you can't refuse: you just have to attend to the clients in the VIP area while she's away, and you'll become a VIP customer.","Sieki tiene un problema enorme y te hace una oferta que no puedes rechazar: solo tienes que atender a los clientes de la zona VIP mientras ella no está, y te convertirás en cliente VIP.");
 ds_map_add(m,"A hospital robot offers anal cleaning services for just three thousand Arcs. It's not a bad idea to keep clean every now and then.","Un robot del hospital ofrece servicios de limpieza anal por solo tres mil Arcs. No es mala idea mantenerse limpio de vez en cuando.");
 ds_map_add(m,"A story you read in the library seems strange to you, so you decide to look for more information about it.","Una historia que leíste en la biblioteca te parece extraña, así que decides buscar más información sobre ella.");
 ds_map_add(m,"There's a guy offering his services to make fursuits, which catches your attention, so you decide to save up for one.","Hay un tipo que ofrece servicios para confeccionar trajes de furro. Te llama la atención, así que decides ahorrar para comprarte uno.");
 ds_map_add(m,"There's an Onahole that has the same tone as you, which strangely excites you.","Hay una muñeca sexual cuyo tono de piel es igual al tuyo, y eso, por alguna extraña razón, te excita.");
 ds_map_add(m,"In a nightclub, you find two gothic girls with big butts dancing, something you can't let pass in your life.","En una discoteca encuentras a dos chicas góticas de grandes traseros bailando. No puedes dejar pasar una oportunidad así en tu vida.");
 ds_map_add(m,"Upon entering the usually closed public restroom, you find an idol vomiting, with many people screaming and demanding the show. What could be happening?","Al entrar en el baño público, que normalmente está cerrado, encuentras a una idol vomitando, mientras mucha gente grita y exige que empiece el espectáculo. ¿Qué estará pasando?");
 ds_map_add(m,"There is a proliferation of slimes attacking and kidnapping women. Do your best to help and get to the bottom of this!","Hay una proliferación de slimes que atacan y secuestran mujeres. ¡Haz todo lo posible por ayudarlas y descubre qué hay detrás de esto!");
 ds_map_add(m,"A being living in the pond enters Line's mind and psychologically strips her bare with questions she's not prepared to hear or face.","Un ser que vive en el estanque entra en la mente de Line y la desnuda psicológicamente con preguntas que no está preparada para escuchar ni afrontar.");
 ds_map_add(m,"You don't know what's happening; you have mental gaps, and days and nights seem to pass in seconds.","No sabes qué está pasando: tienes lagunas mentales y los días y las noches parecen pasar en cuestión de segundos.");
 ds_map_add(m,"You have committed serious mistakes that haunt you at night, so you decide to confess to expiate your sins.","Has cometido errores graves que te atormentan por las noches, así que decides confesarte para expiar tus pecados.");
 ds_map_add(m,"Callie invites you to meet her family, which seems more serious than what you're looking for, but it would be rude not to go.","Callie te invita a conocer a su familia. Parece algo más serio de lo que buscas, pero sería de mala educación no ir.");
 ds_map_add(m,"You found a place that can serve you for sleeping while you investigate the island.","Has encontrado un lugar donde puedes dormir mientras investigas la isla.");
 ds_map_add(m,"You need more power, so you beg Marael to help you unlock your succubus powers.","Necesitas más poder, así que le suplicas a Marael que te ayude a desbloquear tus poderes de súcubo.");
 ds_map_add(m,"The thieves on the island aren't just any criminals; they were actually stealing to maintain an orphanage, without which everything would collapse.","Los ladrones de la isla no son delincuentes cualquiera: en realidad robaban para mantener un orfanato, sin el cual todo se vendría abajo.");
 ds_map_add(m,"You met Futaba your trusted futanari in the forest, what could she be doing?","Te encontraste con Futaba, tu futanari de confianza, en el bosque. ¿Qué estará haciendo allí?");
 ds_map_add(m,"The barn is very busy due to the issues happening on the island. Help them however you can so that the barn can open.","El granero está hasta arriba de trabajo debido a los problemas que ocurren en la isla. Ayúdalos en lo que puedas para que el granero pueda abrir.");
 ds_map_add(m,"Rynn is frustrated because the last fight with you didn't end, so she challenges you to a beer drinking duel.","Rynn está frustrada porque la última pelea contigo quedó sin terminar, así que te reta a un duelo de beber cerveza.");
 ds_map_add(m,"Lili is angry with Line because she believes Line is completely ignorant about sex, and challenges her to a competition to see who is the better onahole.","Lili está enfadada con Line porque cree que no sabe absolutamente nada de sexo, y la reta a competir para ver quién es la mejor muñeca sexual.");
 ds_map_add(m,"The milk on this island has very strange properties.","La leche de esta isla tiene propiedades muy extrañas.");
 ds_map_add(m,"A fat ugly bastard bothering Rynn at the bar he leaves but you can't stop thinking about him.","Un gordo y asqueroso cabrón estaba molestando a Rynn en el bar. Ya se ha ido, pero no puedes dejar de pensar en él.");
