 ds_map_add(m,"Oh-ok, you are really exited is kinda... hot.","Ah, o-okay. Estás muy emocionado; eso es un poco... excitante.");
 ds_map_add(m,"No, don't you dare leave them on.","No, ni se te ocurra dejártelas puestas.");
 ds_map_add(m,"Ok, well, I already took off my boots, do you want me to take off my tights as well?","Vale, ya me he quitado las botas. ¿Quieres que me quite también las medias?");
 ds_map_add(m,"Mmm... No, because you get excited all the time, but thanks.","Mmm... No, porque te emocionas por cualquier cosa, pero gracias.");
 ds_map_add(m,"You are the best Lili <3 and I hope you can talk to me like that more often.","Eres la mejor, Lili <3. Espero que me hables así más a menudo.");
 ds_map_add(m,"Ohh my little and beautiful Line is growing. I will look for another guy less shy so you can satisfy yourself.","Ohhh, mi pequeña y preciosa Line está creciendo. Buscaré a otro chico menos tímido para que puedas darte el gusto.");
 ds_map_add(m,"I really didn't want to do it,but when he came in my mouth I couldn't control myself.","De verdad no quería hacerlo, pero cuando se corrió en mi boca no pude controlarme.");
 ds_map_add(m,"Wow you must be thirsty just doing a footjob you took away all his energy.","Vaya, debes de tener mucha sed. Con solo hacerle un trabajo de pies le has quitado toda la energía.");
