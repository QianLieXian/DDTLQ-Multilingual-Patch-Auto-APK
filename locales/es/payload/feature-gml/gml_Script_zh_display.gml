 ds_map_add(m,"Hey wait you are the adventurer who defeated the demon that stole alcohol?","¡Eh, espera! ¿Eres la aventurera que derrotó al demonio que robaba el alcohol?");
 ds_map_add(m,"Go to the door on your left Sieki is waiting for you.","Ve a la puerta de la izquierda. Sieki te está esperando.");
