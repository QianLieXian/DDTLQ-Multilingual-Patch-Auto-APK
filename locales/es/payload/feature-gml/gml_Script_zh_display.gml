 ds_map_add(m,"Come on Line we have to get into the hospital it looks like they are coming out of somewhere inside the building!","¡Vamos, Line! Tenemos que entrar en el hospital. ¡Parece que están saliendo de algún lugar del interior del edificio!");
 ds_map_add(m,"This must be the last key.","Esta debe de ser la última llave.");
