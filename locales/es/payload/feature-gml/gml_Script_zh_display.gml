var s=string(argument0);
if(!variable_global_exists("zh_display_map"))global.zh_display_map=-1;
if(!ds_exists(global.zh_display_map,ds_type_map)){
 global.zh_display_map=ds_map_create();
 var m=global.zh_display_map;
 ds_map_add(m,"Piercing","Perforante");
 ds_map_add(m,"Impact","Impacto");
 ds_map_add(m,"Cut","Corte");
 ds_map_add(m,"Hp","PV");
 ds_map_add(m,"Mp","PM");
 ds_map_add(m,"Nature","Naturaleza");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Uf, papito grandote... Ojalá algún día me trate como a su hijita.");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","De algún modo supo mi nombre. Quizá, si la encuentro, pueda averiguar por qué me conoce.");
 ds_map_add(m,"Ms honney","Srta. Honney");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","¡Ohhh <3! La señorita Honney es genial. Con solo verme supo quién soy de verdad. ¡Ah, casi se me olvida! También me ayudó a conseguir información. ");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","¡Oh, Rynn! Recuerdo que estaba borrachísima en la taberna y balbuceaba algo sobre cómo el Imperio había borrado parte de la historia o algo así. Bueno, no le presté mucha atención; me distraje mirando sus abdominales.");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","Oh, recuerdo a esta pobre bajita. Lili la confundió con una niña pequeña y ella montó en cólera. Ahhh, ¿por qué esta hada siempre me mete en líos...?");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","Alina sigue esperando a su amiga. Ojalá pueda verla pronto.");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","Era una demonio muy agresiva y territorial. La única forma de vencerla fue absorber su energía con mis poderes de súcubo, jeje. No me importaría volver a verla, pero Lili me mataría.");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","Me arrepiento muchísimo de lo de Callie. Hice que se enamorara de mí cuando yo solo quería estar con ella para experimentar, ¡y hasta quiere presentarme a sus hijos! A veces desearía no ser medio súcubo. Hago mucho daño a la gente.");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","Baina Salasaki, mi sueño hecho realidad. ¡Hasta mi madre la conocía y pude estar con ella! <3 Aunque sigo pensando que fue un poco caro.");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","¡Oh, esta gata! Por su culpa ahora me da curiosidad la asfixia erótica. Menos mal que Lili siempre está a mi lado por si algo sale mal.");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","Pobre Pussiel. Por mi culpa ahora tiene que trabajar el triple :c.");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","Lina se enfadó muchísimo por perder contra esa gata slime. Incluso me pidió que la ayudara a entrenar, aunque no creo que mi estilo de combate le sirva de mucho.");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","Hynoxia... Creo que es la mujer que le vendió la pistola hipnótica a Lili. Me pregunto qué más tendrá a la venta.");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","¡Mi heroína de Tricotex! No puedo creer que la hayamos encontrado en la isla. Espero poder ayudarla otra vez algún día, pero esta vez en su ciudad <3.");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","Sieki es quien controla a todas las mujeres de la zona VIP del bar. Me pregunto cómo habrá conseguido llegar a ese puesto.");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","Vasuki llegó a esta dimensión por casualidad. La ayudé a encontrar las grietas dimensionales para que pudiera volver a casa, pero por alguna razón decidió quedarse aquí conmigo. La verdad, no me molesta. Quizá soy una persona horrible.");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","¿Cómo voy a olvidarla? Tiene la combinación perfecta de autoridad y delicadeza. Espero que encuentre los cigarrillos que le gustan, aunque, si no los encuentra, quizá volvamos a vernos, jeje.");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","Kamiko es igualita a Lili; la única diferencia es que tiene mi estatura. Bueno, no son tan iguales: Lili también tiene su lado bueno.");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","Quería ayudarme a convertirme en una mejor súcubo, aunque pasa casi todo el tiempo teniendo sexo y apenas la veo. ¿Será que intenta enseñarme a no desperdiciar el tiempo siendo súcubo? ¡Ahhh, por qué tiene que ser todo tan complicado!");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","Maruia es una orca muy honesta; cumplió su palabra cuando la vencí en combate. Mmm... Si de alguna manera consigo que volvamos a luchar... ¡No! ¿En qué estoy pensando? ¡Fuera, malos pensamientos, fuera!");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","Es igual que yo: somos tímidos, pero ambos tenemos nuestro lado secreto. Espero que se le dé mejor que a mí eso de mantener las apariencias.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","¡¡¡Mamá!!! ¡¡¡Quiero muchísimo a mi mamá!!!");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","Una persona muy buena que se preocupa mucho por el gran capitán.");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","Faye debe de ser la persona más desagradable que he conocido. Menos mal que al menos acabamos teniendo sexo, porque, si no, me habría vuelto loca.");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","Bell tiene una misión preciosa. Espero que consiga hacer brotar más de esas flores extintas.");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","Lucy es genial. Espero que no la decepciones con su novela.");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","La señorita Marael me mostró una faceta de las súcubos que nadie había querido enseñarme antes, y se lo agradezco.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","Lemmy le dijo a Lili que, al parecer, ZONE-tam es un reportero muy famoso. Mmm, ahora que lo pienso, ¿por qué se llevan tan bien Lili y Lemmy?");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","Gildfried es increíble y tiene una polla enorme... ¿De qué estaba hablando?");
 ds_map_add(m,"Dannie perky","Dannie Perky");
 ds_map_add(m,"Dede restrun","Dede Restrun");
 ds_map_add(m,"Danyelle dower","Danyelle Dower");
 ds_map_add(m,"Debu Euler ku","Debu Euler Ku");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","Ella es Futaba, tu futanari de confianza :0");
 ds_map_add(m,"Pink Slime","Slime rosa");
 ds_map_add(m,"Purple Slime","Slime morado");
 ds_map_add(m,"Orange Slime","Slime naranja");
