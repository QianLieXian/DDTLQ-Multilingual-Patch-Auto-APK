 ds_map_add(m,"Oh god, YES I am going, I am coming!","¡Oh, Dios mío, SÍ! ¡Me voy, me estoy corriendo!");
 ds_map_add(m,"Wof WOOF BArK Bakk GRRrr","¡Guau, GUAU, GUAU, GRRR!");
 ds_map_add(m,"Good, that's slutty now bark how happy you are!","¡Muy bien, qué guarrilla! ¡Ahora ladra para que todos sepan lo contenta que estás!");
 ds_map_add(m,"* drooling * Im rely ejoyig tis Co-cough!","*Babeando* ¡Lo es-toy disfrutando mu-mucho! ¡Co-cof!");
 ds_map_add(m,"You just enjoy and practice your doggie swim.","Tú disfruta y practica el nado perrito.");
 ds_map_add(m,"You don't need to take off your clothes, I'll make you a hole and that will be enough.","No necesitas quitarte la ropa. Haré un agujero y con eso bastará.");
