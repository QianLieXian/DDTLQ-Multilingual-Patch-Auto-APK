 ds_map_add(m,"What, what's going on?","¿Qué? ¿Qué está pasando?");
 ds_map_add(m,"A well ... Bye ....                                            I'm your fan :v.","Ah, bueno... Adiós... Soy tu fan :v.");
 ds_map_add(m,"I_I have to go now :v","Y-yo ya me tengo que ir :v.");
 ds_map_add(m,"Really? I-I can explain it again, I have no proble-","¿De verdad? P-puedo explicártelo otra vez, no me supondría ningún proble-");
 ds_map_add(m,"I understo-","Lo he entend-");
 ds_map_add(m,"You do not like it? What I did is use your slogan and well re use i-","¿No te gusta? Lo que hice fue utilizar tu eslogan y, bueno, reutili-");
 ds_map_add(m,"You are welcome, because I am Line your Heroine of trust :D.","De nada, porque soy Line, tu heroína de confianza :D.");
 ds_map_add(m,"... Th-thank you very much.","... Mu-muchísimas gracias.");
 ds_map_add(m,"Finally Line finishes cleaning up and there is no trace of the embarrassing event.","Por fin Line termina de limpiar y no queda ni rastro del vergonzoso incidente.");
