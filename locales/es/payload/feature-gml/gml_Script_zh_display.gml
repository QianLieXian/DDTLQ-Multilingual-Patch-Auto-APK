 ds_map_add(m,"Settings","Ajustes");
 ds_map_add(m,"Quest complete.","Misión completada.");
 ds_map_add(m,"Use Vodka","Usar vodka");
 ds_map_add(m,"Use Ron","Usar ron");
 ds_map_add(m,"Use Beer","Usar cerveza");
 ds_map_add(m,"Use Milch","Usar leche");
 ds_map_add(m,"there no items here yet","Todavía no hay objetos aquí.");
 ds_map_add(m,"Fish","Pescado");
 ds_map_add(m,"it is raw we can not eat it like this Lili, maybe it is better to give it to someone else.","Está crudo, Lili. No podemos comérnoslo así. Quizá sea mejor dárselo a otra persona.");
 ds_map_add(m,"Circus flyers","Folletos del circo");
 ds_map_add(m,"I have a lot of pamphlets to deliver, hopefully delivering a few will be enough.","Tengo un montón de folletos que repartir. Ojalá con entregar unos cuantos sea suficiente.");
 ds_map_add(m,"This is my favorite is not that strong <3","Es mi favorito y no es tan fuerte <3");
 ds_map_add(m,"Rum","Ron");
 ds_map_add(m,"My Mother Always say rum is like men, the older the better. Mmmm maybe that is why she is with my father, elves live for a long time.","Mi madre siempre dice que el ron es como los hombres: cuanto más añejo, mejor. Mmmm, quizá por eso está con mi padre; los elfos viven muchísimo tiempo.");
 ds_map_add(m,"Beer","Cerveza");
 ds_map_add(m,"Iugg, i do not like beer, the worst thing is that when you go to the bathroom, the pee smells very strong.","Puaj, no me gusta la cerveza. Lo peor es que, cuando vas al baño, la orina huele muchísimo.");
 ds_map_add(m,"Magic Broom","Escoba mágica");
 ds_map_add(m,"I love this broom <3, my little feet won't hurt anymore.","Me encanta esta escoba <3. ¡Ya no me dolerán mis piececitos!");
 ds_map_add(m,"Tricotex money","Dinero de Tricotex");
 ds_map_add(m,"Sam gave me this money, it is 10 dollars to use in Tricotex. I will keep it, who knows if i ever pass by.","Sam me dio este dinero. Son 10 dólares que se pueden gastar en Tricotex. Me lo guardaré; quién sabe si algún día pasaré por allí.");
 ds_map_add(m,"Autographed photo of Sam","Foto autografiada de Sam");
 ds_map_add(m,"I still can not believe Sam gave me a picture with his autograph <3.","Todavía no me creo que Sam me haya regalado una foto con su autógrafo <3.");
 ds_map_add(m,"BDSM Master/Slave Contract","Contrato BDSM de ama y esclava");
 ds_map_add(m,"My contract with Lili, because of my problems I begged her to be my master and help me to practice my succubus powers and force me to try new things <3.","Mi contrato con Lili. Por mis problemas, le rogué que fuera mi ama, me ayudara a practicar mis poderes de súcubo y me obligara a probar cosas nuevas <3.");
 ds_map_add(m,"Raspberry pie","Tarta de frambuesa");
 ds_map_add(m,"I am supposed to recognize the scent of this foot and then guide me through the forest to Marael's house.","Se supone que debo reconocer el olor de este pie y luego seguirlo por el bosque hasta la casa de Marael.");
 ds_map_add(m,"Haigure Gun!","¡Pistola Haigure!");
 ds_map_add(m,"This gun makes move in a very vulgar way, Just the thought of people watching me, moving uncontrollably while I make a fool of myself makes me so horny.","Esta pistola hace que te muevas de una forma muy vulgar. Solo pensar que la gente me está mirando mientras me contoneo sin control y hago el ridículo me pone muchísimo.");
 ds_map_add(m,"Holy Grail","Santo Grial");
 ds_map_add(m,"One of the relics of the islands. I can feel energy emanating from it.","Una de las reliquias de las islas. Puedo sentir la energía que emana de ella.");
 ds_map_add(m,"Crystal sphere","Esfera de cristal");
 ds_map_add(m,"I found this half buried next to some cats, it looks like something valuable, maybe it will be useful for something.","Encontré esto medio enterrado junto a unos gatos. Parece algo valioso; quizá sirva para algo.");
 ds_map_add(m,"Oniric incense","Incienso onírico");
 ds_map_add(m,"This is the best thing in the world! If I use it before I go to sleep I can have lucid dreams of things that happened to me <3.","¡Es lo mejor del mundo! Si lo uso antes de dormir, puedo tener sueños lúcidos sobre cosas que me han pasado <3.");
 ds_map_add(m,"Gilfried briefcase","Maletín de Gildfried");
 ds_map_add(m,"I have to return this briefcase to Gilfried immediately.","Tengo que devolverle este maletín a Gildfried cuanto antes.");
 ds_map_add(m,"Golden Key","Llave dorada");
 ds_map_add(m,"There is something strange about this key, I feel like it takes my energy somehow.","Hay algo extraño en esta llave. Siento que, de alguna manera, absorbe mi energía.");
 ds_map_add(m,"Smoosher uniforms","Uniformes de Smoosher");
 ds_map_add(m,"The uniform of the Smoosher restaurant smells a little funny.","El uniforme del restaurante Smoosher tiene un olor un poco raro.");
 ds_map_add(m,"Aphrodisiac mushroom.","Seta afrodisíaca.");
 ds_map_add(m,"Moo Premium Milk","Leche prémium Moo");
 ds_map_add(m,"Fura Fura Fruit","Fruta Fura Fura");
 ds_map_add(m,"The fura fura fruit has the effect of creating a penis if eaten by a woman.","La fruta Fura Fura hace que a las mujeres les crezca un pene si la comen.");
 ds_map_add(m,"Hea Hea Fruit","Fruta Hea Hea");
 ds_map_add(m,"The hea hea fruit has a very powerful aphrodisiac effect that will make anyone who eats it come into heat.","La fruta Hea Hea tiene un efecto afrodisíaco potentísimo que hace entrar en celo a cualquiera que la coma.");
 ds_map_add(m,"Smuggled fabrics","Telas de contrabando");
 ds_map_add(m,"I understand there was a convict who wanted to sell this, they ended up taking it from her and reselling it themselves (speaking of irony).","Por lo que entiendo, una convicta quería vender estas telas. Se las quitaron y luego las revendieron ellos mismos (menuda ironía).");
 ds_map_add(m,"Sewing machine","Máquina de coser");
 ds_map_add(m,"Blue crystal key","Llave de cristal azul");
 ds_map_add(m,"It is a key that was found inside a strange slime.","Es una llave que encontraron dentro de un slime extraño.");
 ds_map_add(m,"Purple crystal key","Llave de cristal morado");
 ds_map_add(m,"Pink crystal key","Llave de cristal rosa");
 ds_map_add(m,"Cum jar","Tarro de semen");
 ds_map_add(m,"Ñom yum yum it looks delicious I will let it ripen a bit before eating <3.","Ñam, ñam, ¡qué buena pinta! Dejaré que madure un poco antes de comérmelo <3.");
 ds_map_add(m,"Elf Gloves","Guantes élficos");
 ds_map_add(m,"Elf Boots","Botas élficas");
 ds_map_add(m,"Elf Leotard","Malla élfica");
 ds_map_add(m,"Elf Tank Top","Camiseta sin mangas élfica");
 ds_map_add(m,"Elf Tights","Medias élficas");
