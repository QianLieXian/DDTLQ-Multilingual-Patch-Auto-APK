 ds_map_add(m,"Sorry Line but now we can't play together.","Lo siento, Line, pero ahora no podemos jugar juntas.");
 ds_map_add(m,"Thank you are so sweet , if you want a discount you must give me a better compliment haha.","Gracias, qué dulce eres. Si quieres un descuento, tendrás que hacerme un cumplido mejor, jaja.");
 ds_map_add(m,"Oh, thank God, you are the best thing that has happened so far I was very hungry.","¡Oh, gracias a Dios! Eres lo mejor que me ha pasado hasta ahora; tenía muchísima hambre.");
