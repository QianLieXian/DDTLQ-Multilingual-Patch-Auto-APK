 ds_map_add(m,"Oh I remember you are from that show! sorry, I am-I am kind of a clumsy. ( I have no idea who the hell she is :v )","¡Oh, ya recuerdo! ¡Sales en ese programa! Lo siento, soy un poco torpe. (No tengo ni idea de quién coño es :v).");
 ds_map_add(m,"I AM FUTABA YOUR TRUSTED FUTANARI, OFFICIAL PURPLECRIT COMMUNICATOR!","¡SOY FUTABA, TU FUTANARI DE CONFIANZA Y COMUNICADORA OFICIAL DE PURPLECRIT!");
