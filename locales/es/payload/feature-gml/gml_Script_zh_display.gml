 ds_map_add(m,"A wena :D.","¡Buena! :D");
 ds_map_add(m,"Wena cochino larry.","¡Buena, Larry, cochino!");
 ds_map_add(m,"Why is this girl taking so long?","¿Por qué tarda tanto esta chica?");
 ds_map_add(m,"Oh, cutie I can upgrade a block of hearts every so often on the grid in addition to doing some cut damage.","Oye, preciosa, además de infligir algo de daño cortante, cada cierto tiempo puedo mejorar un bloque de corazones del tablero.");
 ds_map_add(m,"No but, could you tell me again how you fight?","No, pero ¿podrías volver a explicarme cómo luchas?");
 ds_map_add(m,"No right now actually.","No, ahora mismo no.");
 ds_map_add(m,"Yes Big sis <3!","¡Sí, hermanita mayor <3!");
 ds_map_add(m,"You want a little break cutie","¿Quieres descansar un poco, preciosa?");
 ds_map_add(m,"No thanks, could you tell me again how you fight?","No, gracias. ¿Podrías volver a explicarme cómo luchas?");
 ds_map_add(m,"Sorry big sis not rigt now.","Perdona, hermanita, ahora no puedo. u.u");
 ds_map_add(m,"Yes, Big Sis.","Sí, hermanita.");
 ds_map_add(m,"Do you want me to help you in battles?","¿Quieres que te ayude en los combates?");
 ds_map_add(m,"So do your best Line <3.","Así que da lo mejor de ti, Line <3.");
 ds_map_add(m,"A training battle will do.","Con un combate de entrenamiento bastará.");
 ds_map_add(m,"First of all I need to see your current status as a succubus in a more precise way.","En primer lugar, necesito evaluar con más precisión tu estado actual como súcubo.");
 ds_map_add(m,"So how do we start?","Entonces, ¿por dónde empezamos?");
 ds_map_add(m,"Well said! <3","¡Bien dicho! <3");
 ds_map_add(m,"I know .. I guess it will hurt my mother if I never get better as a succubus.","Lo sé... Supongo que mi madre se pondría triste si nunca mejoro como súcubo.");
 ds_map_add(m,"But line, beautiful, it is your culture we gain power and energy having sex, you must start thinking about yourself.","Pero, Line, preciosa, en nuestra cultura obtenemos poder y energía mediante el sexo; tienes que empezar a pensar en ti misma.");
 ds_map_add(m,"And my father is a very respectable elf. What would he think of me, I don't want to hurt him?","Y mi padre es un elfo muy respetable. ¿Qué pensaría de mí? No quiero hacerle daño.");
 ds_map_add(m,"But I was always such a shy girl, that I never asked my mother to teach me.","Pero siempre he sido tan tímida que nunca me atreví a pedirle a mi madre que me enseñara.");
 ds_map_add(m,"I ... I want to be a better succubus","Yo... quiero ser una mejor súcubo.");
 ds_map_add(m,"hey quiet fairy, I just want to teach your friend some tricks so that she is a little more prepared for the world.","Oye, hada silenciosa, solo quiero enseñarle unos trucos a tu amiga para que esté un poco más preparada para el mundo.");
 ds_map_add(m,"Hey! What's wrong? Line is a great succubus!","¡Eh! ¿Qué pasa? ¡Line es una súcubo estupenda!");
 ds_map_add(m,"You are a succubus but I see that you have a long way to go, your power is minimal compared to others.","Eres una súcubo, pero aún te queda mucho camino por recorrer. Tu poder es mínimo comparado con el de las demás.");
 ds_map_add(m,"Help me with what?","¿Ayudarme con qué?");
 ds_map_add(m,"I made this little meeting to help you.","Organicé esta pequeña reunión para ayudarte.");
 ds_map_add(m,"Why did you want to see me?","¿Por qué querías verme?");
 ds_map_add(m,"Mmm?( this woman does not give me confidence )","¿Mmm? (Esta mujer no me inspira confianza).");
 ds_map_add(m,"If only you knew what I was my little fairy.","Si supieras cómo era yo antes, hadita.");
 ds_map_add(m,"How do you know who Line is and what she is?","¿Cómo sabes quién es Line y qué es?");
 ds_map_add(m,"Oh.. thanks hehe.","Oh... gracias, jeje.");
 ds_map_add(m,"Yes, and you are a cute little half succubus you right Line.","Sí, y tú eres una pequeña y adorable medio súcubo, ¿verdad, Line?");
 ds_map_add(m,"E-excuse me, did you leave a message to the receptionist for me?","D-disculpa, ¿dejaste un mensaje para mí en recepción?");
 ds_map_add(m,"Come on Line try again I need to know better your current state I know you can do more.","Vamos, Line, inténtalo otra vez. Necesito conocer mejor tu estado actual. Sé que puedes dar más de ti.");
 ds_map_add(m,"Just give me one second.","Dame un segundo.");
 ds_map_add(m,"Mmmm... Hehe ok big Sis I will do my best <3","Mmm... Jeje, está bien, hermanita. Haré todo lo posible <3");
 ds_map_add(m,"Great Line you already know something about the case more than I do find them and I'll give you a prize Tehehehe.","¡Genial, Line! Ya sabes más sobre el caso que yo. Encuéntralos y te daré un premio, jejeje.");
 ds_map_add(m,"I already know that story.","Esa historia ya me la sé.");
 ds_map_add(m,"A Slime Cat is apparently stealing it.","Al parecer, un gato slime está robándoselo.");
 ds_map_add(m,"Well, if you want me to help Line become a better succubus, first help me recover the clothes from the restaurant.","Bueno, si quieres que ayude a Line a convertirse en una mejor súcubo, primero ayúdame a recuperar los uniformes del restaurante.");
 ds_map_add(m,"The truth is that I do know but I hope you don't do it simply because it's moral 101.","La verdad es que sí lo sé, pero espero que no lo hagas, aunque solo sea por una cuestión de moral básica.");
 ds_map_add(m,"It's for the greater good plus I eat well here if you know what I mean.","Es por el bien común y, además, aquí como bastante bien, si me entiendes.");
 ds_map_add(m,"Oh, don't get mad, I'm working so I don't always sleep in that pigsty you call a house.","Oye, no te enfades. Estoy trabajando para no tener que dormir siempre en ese cuchitril que llamas casa.");
 ds_map_add(m,"I mean, weren't you supposed to help Line become a better succubus or something?","Quiero decir, ¿no se suponía que ibas a ayudar a Line a convertirse en una mejor súcubo o algo así?");
 ds_map_add(m,"Big Sis, what are you doing here?","Hermanita, ¿qué haces aquí?");
 ds_map_add(m,"Did you find the Outfits?","¿Encontraste los uniformes?");
 ds_map_add(m,"I will give you a prize, just come behind the counter.","Te daré un premio. Solo tienes que pasar detrás del mostrador.");
 ds_map_add(m,"Oh... it is ok.","Oh... está bien.");
 ds_map_add(m,"That cat is a thief and we need them for the waitresses as we are full.","Ese gato es un ladrón y necesitamos los uniformes para las camareras; estamos hasta arriba de trabajo.");
 ds_map_add(m,"Oops, you look great but I'll need them back.","Uy, te queda genial, pero tendrás que devolvérmelo.");
 ds_map_add(m,"Mmmm yeah, I took it from a slime cat, I think it looks pretty good on me.","Mmm, sí, se lo quité a un gato slime. Creo que me queda bastante bien.");
 ds_map_add(m,"Wow Line those Smoosher outfits?","¡Vaya, Line! ¿Esos son los uniformes de Smoosher?");
 ds_map_add(m,"All right, come behind the counter.","Muy bien, pasa detrás del mostrador.");
 ds_map_add(m,"Big Sis found them! Wh-which ones my prize hehe?","¡La hermanita los encontró! ¿C-cuál es mi premio? Jeje.");
 ds_map_add(m,"I do the basics, cut damage and every so often I upgrade a cut cube.","Sé lo básico: inflijo daño cortante y, de vez en cuando, mejoro un bloque cortante.");
 ds_map_add(m,"Yes.","Sí.");
 ds_map_add(m,"You are tired alredy?","¿Ya estás cansada?");
 ds_map_add(m,"Sorry, I cant right now u.u.","Lo siento, ahora no puedo. u.u");
 ds_map_add(m,"mmm ok.","Mmm, vale.");
 ds_map_add(m,"Hey I am bored Wanna do something?","Oye, me aburro. ¿Quieres hacer algo?");
 ds_map_add(m,"Is that you Line? c'mon in","¿Eres tú, Line? Pasa.");
 ds_map_add(m,"Moo","Muu");
 ds_map_add(m,"I recommend you to improve your life so you don't die with one of my attacks.","Te recomiendo que mejores tu vida para que no mueras de un solo ataque mío.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but big of the damage I do to the enemy you get it too, sadly I'm not good at team fighting.","Mi estilo de combate es bastante normal. Hago mucho daño mágico, pero gran parte del daño que inflijo al enemigo también te lo llevas tú. Por desgracia, no se me da bien luchar en equipo.");
 ds_map_add(m,"No thanks.","No, gracias.");
 ds_map_add(m,"Yes I need to do something by my own sorry :c","Sí, tengo que hacer algo por mi cuenta. Perdona :c");
 ds_map_add(m,"You look tired, do you want to rest?","Pareces cansada. ¿Quieres descansar?");
 ds_map_add(m,"I recommend you to improve your life and nature so that I am the one doing the damage while you concentrate on surviving my attacks and those of the enemies.","Te recomiendo que mejores tu vida y tu naturaleza; así yo me encargo de hacer daño mientras tú te concentras en sobrevivir a mis ataques y a los de los enemigos.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but half of the damage I do to the enemy you get it too, I'm not good at team fighting.","Mi estilo de combate es bastante normal. Hago mucho daño mágico, pero tú también recibes la mitad del daño que inflijo al enemigo. No se me da bien luchar en equipo.");
 ds_map_add(m,"Not really hehe but thanks.","No exactamente, jeje, pero gracias.");
 ds_map_add(m,"Can you help me in my adventure <3?.","¿Puedes acompañarme en mi aventura <3?.");
 ds_map_add(m,"Thanks for the help, you need something?","Gracias por tu ayuda. ¿Necesitas algo?");
 ds_map_add(m,"That depends on them and their resistance.","Eso depende de ellos y de su resistencia.");
 ds_map_add(m,".... Mhmm Sir? please don't kill anyone.","... Ejem, ¿señor? Por favor, no mate a nadie.");
 ds_map_add(m,"Ohh you are so kind and thoughtful <3 hehe.","Oh, eres muy amable y considerado <3, jeje.");
 ds_map_add(m,"I told your fairy that I would get money.","Le dije a tu hada que conseguiría dinero.");
 ds_map_add(m,"Mr. Vasera, what are you doing here?","Señor Vasera, ¿qué hace aquí?");
 ds_map_add(m,"If you want to go with me to look for him, I won't stop you, but I won't defend you either, you should take care of yourselves.","Si quieren acompañarme a buscarlo, no se lo impediré, pero tampoco las protegeré. Tendrán que cuidarse solas.");
 ds_map_add(m,"How thoughtful. <3","Qué considerado. <3");
 ds_map_add(m,"The truth is I am already looking for it, I just told them to be careful.","La verdad es que ya lo estoy buscando; solo les dije que tuvieran cuidado.");
 ds_map_add(m,"Hey wait we could help you look for it so you can absorb it again and get your full strength.","¡Eh, espera! Podemos ayudarte a encontrarlo para que vuelvas a absorberlo y recuperes toda tu fuerza.");
 ds_map_add(m,"Oh this is not good.","Oh, esto no pinta bien.");
 ds_map_add(m,"Somehow got consciousness and I don't know what it is capable of but if it has a part of my strength it is better to prepare yourself.","De algún modo ha adquirido conciencia y no sé de qué es capaz. Pero, si tiene parte de mi poder, será mejor que te prepares.");
 ds_map_add(m,"Mmm there is something wrong with this godless dimension the clones I previously used on you, they all came back to me and I absorbed them except for one.","Mmm, algo va mal en esta dimensión sin dioses. Todos los clones que había usado antes contigo regresaron a mí y los absorbí, excepto uno.");
 ds_map_add(m,"What wh-why!","¿Qué? ¿P-pero por qué?");
 ds_map_add(m,"Line I must inform you that if you see me again you must kill me if you get the chance.","Line, debo advertirte de que, si vuelves a verme, tendrás que matarme en cuanto tengas la oportunidad.");
 ds_map_add(m,"si quieren acompañarme a buscarlo no las detendre pero tampoco las defendere deben cuidarse por utedes misma","Si quieren acompañarme a buscarlo, no se lo impediré, pero tampoco las defenderé. Deben cuidarse ustedes mismas.");
 ds_map_add(m,"Que considerado <3","Qué considerado <3");
 ds_map_add(m,"yo ya lo estoy buscando la verdad solo les dije que tengan cuidado","La verdad es que ya lo estoy buscando; solo les dije que tuvieran cuidado.");
 ds_map_add(m,"oye espera no puede ayudarno a buscarlo asi lo vuelves a absorver y consigues toda tu fuerza","Oye, espera, ¿no podrían ayudarnos a buscarlo? Así podrás volver a absorberlo y recuperar toda tu fuerza.");
 ds_map_add(m,"pe-pe pero.","P-pero...");
 ds_map_add(m,"de alguna forma consiguio consencia y nose de que es capaz pero si tiene una parte de mi fuerza mejor es que te preparez.","De algún modo ha adquirido conciencia y no sé de qué es capaz, pero, si tiene parte de mi poder, será mejor que te prepares.");
 ds_map_add(m,"Mmm hay algo malo en esta dimension sin dioses los clones que anteriormente use contigo todos volvieron a mi y los absorvi excepto uno.","Mmm, algo va mal en esta dimensión sin dioses. Todos los clones que usé antes contigo regresaron a mí y los absorbí, excepto uno.");
 ds_map_add(m,"Que porque!","¿¡Por qué?!");
 ds_map_add(m,"Line debo informarte que si me ves denuevo debes matarme si esque tienes la oportunidad.","Line, debo avisarte: si vuelves a verme, tienes que matarme si tienes la oportunidad.");
 ds_map_add(m,"Please... Help me, I need those crystals to go back home.","Por favor... ayúdame. Necesito esos cristales para volver a casa.");
 ds_map_add(m,"Well I do moderate piercing damage and upgrade a piercing cube on the grid every so often.","Bueno, inflijo un daño perforante moderado y, de vez en cuando, mejoro un bloque perforante del tablero.");
 ds_map_add(m,"I still want you to accompany me.","Aun así, quiero que me acompañes.");
 ds_map_add(m,"Yes please, I have other things to do.","Sí, por favor. Tengo otras cosas que hacer.");
 ds_map_add(m,"Do you want me to stay here for a while?","¿Quieres que me quede aquí un rato?");
 ds_map_add(m,"Sorry, I have other things to do.","Lo siento, tengo otras cosas que hacer.");
 ds_map_add(m,"join me vasuki <3.","Ven conmigo, Vasuki <3.");
 ds_map_add(m,"Oh you need something?","Oh, ¿necesitas algo?");
 ds_map_add(m,"The quest will be available in later updates.","Esta misión estará disponible en futuras actualizaciones.");
 ds_map_add(m,"Great ... I ran out of cigarettes.","Genial... me he quedado sin cigarrillos.");
 ds_map_add(m,"Here, it's 100 Arcs just... dont blow it.","Toma, son 100 Arcs. Solo... no los malgastes.");
 ds_map_add(m,"Of course there is no problem, count on me.","Claro que sí, no hay problema. Cuenta conmigo.");
 ds_map_add(m,"If you can bring some premium cigarettes, you would do me a favor, since this is my last day on the island.","Si pudieras traerme unos cigarrillos prémium, me harías un favor, porque hoy es mi último día en la isla.");
 ds_map_add(m,"This day has been terrible, my personal onahole is sick and I also ran out of cigarettes.","Hoy ha sido un día horrible: mi muñeca sexual personal está enferma y, además, me he quedado sin cigarrillos.");
 ds_map_add(m,"Wh-what?","¿Q-qué?");
 ds_map_add(m,"Hey wait.","Oye, espera.");
 ds_map_add(m,"But its ok, im leaving.","Pero no pasa nada, me voy.");
 ds_map_add(m,"Oh so-sorry I am good helping people.","Oh, p-perdona. Se me da bien ayudar a la gente.");
 ds_map_add(m,"What do you care.","¿Y a ti qué te importa?");
 ds_map_add(m,"So-so something happend?","E-entonces, ¿ha pasado algo?");
 ds_map_add(m,"hurry up i'm running out of patience.","Date prisa, se me está acabando la paciencia.");
 ds_map_add(m,"To the ground now!","¡Al suelo, ahora!");
 ds_map_add(m,"What?!","¿¡Qué?!");
 ds_map_add(m,"Hey, what I'm saying we'll do right here, right now.","Oye, lo que digo es que lo haremos aquí mismo, ahora mismo.");
 ds_map_add(m,"Oh its ok.","Oh, no pasa nada.");
 ds_map_add(m,"Oh, haha I like the idea but I don't have much time left I have to leave now.","Oh, jaja, me gusta la idea, pero ya no me queda mucho tiempo. Tengo que irme.");
 ds_map_add(m,"I could b-be your onahole fo-for wasting your time.","Podría s-ser tu muñeca sexual para compensarte por hacerte perder el tiempo.");
 ds_map_add(m,"In what way?","¿De qué manera?");
 ds_map_add(m,"Wh-wait im very sorry maybe i ca-can help in another way.","E-espera, lo siento mucho. Quizá p-pueda ayudarte de otra forma.");
 ds_map_add(m,"Damn this is all a waste of time, thanks for nothing.","Maldita sea, esto ha sido una pérdida de tiempo. Gracias por nada.");
 ds_map_add(m,"I regret to inform you that the cigarettes you are looking for do not exist on the island :c.","Lamento informarte de que los cigarrillos que buscas no existen en la isla :c.");
 ds_map_add(m,"Please don't bring me bad news.","Por favor, no me des malas noticias.");
 ds_map_add(m,"Umm kristoff.","Eh... Kristoff.");
 ds_map_add(m,"What are you looking at!","¡¿Qué miras?!");
 ds_map_add(m,"What are you looking at!?","¡¿Qué estás mirando?!");
 ds_map_add(m,"Well lady have a good day.","Bueno, señora, que tenga un buen día.");
 ds_map_add(m,"*Kamiko grabs Line tightly and kisses her for a long minute*","*Kamiko agarra a Line con fuerza y la besa durante un largo minuto*");
 ds_map_add(m,"Oh ok. (at least it's something)","Oh, vale. (Al menos es algo).");
 ds_map_add(m,"But the kiss will be a french kiss.","Pero será un beso con lengua.");
 ds_map_add(m,"Oh ok great. (I thought, she would think of something better :/ )","Oh, vale, genial. (Pensé que se le ocurriría algo mejor :/).");
 ds_map_add(m,"Hmmm, Aren't you the cutest thing?, just a kiss from you would be enough.","Mmm, ¿no eres la cosita más adorable? Con un beso tuyo me basta.");
 ds_map_add(m,"isn't there some other way to pay it? *wink wink*","¿No hay otra forma de pagar? *guiño, guiño*");
 ds_map_add(m,"You don't have enough arcs, get out of here and let people with money pass.","No tienes suficientes Arcs. Lárgate y deja pasar a la gente que sí tiene dinero.");
 ds_map_add(m,"Excellent lady, have a nice day <3.","Excelente, señora. Que tenga un buen día <3.");
 ds_map_add(m,"Do you really think you idiots can catch me? Haha, I have done this all over Elira. I'll just have to shut you up.","¿De verdad creen, idiotas, que pueden atraparme? Ja, ja. He hecho esto por toda Elira. Tendré que hacerlos callar.");
 ds_map_add(m,"I told you Line, let's capture her maybe the guards give us money.","Te lo dije, Line. ¡Atrápala! Quizá los guardias nos den una recompensa.");
 ds_map_add(m,"Stop ... Haha looks like you're not the smart one on the team Line.","Espera... Ja, ja, parece que tú no eres precisamente la más lista del equipo, Line.");
 ds_map_add(m,"No Line! I will bring the great captain, she is the criminal they are looking for.","¡No, Line! Iré a buscar a la gran capitana. Ella es la criminal que están buscando.");
 ds_map_add(m,"O-oh ok i will pay.","O-oh, está bien, pagaré.");
 ds_map_add(m,"Look... I hate taking people there, we can make a deal, if you give me the rate plus the fine and 200 arcs to keep our little secret, I'll let you go.","Escucha... Odio tener que llevar a la gente allí. Podemos llegar a un acuerdo: si me das la tarifa, la multa y 200 Arcs para guardar nuestro pequeño secreto, te dejaré ir.");
 ds_map_add(m,"Lili! Do you see what you have done!","¡Lili! ¡¿Ves lo que has hecho?!");
 ds_map_add(m,"It's over now, I'll have to take you to the jail-farm, for repeated harassment to Elira's authority.","Se acabó. Tendré que llevarte a la granja penitenciaria por acosar repetidamente a las autoridades de Elira.");
 ds_map_add(m,"Line don't be so naive, she has only a glove and a shoulder pad from the outfit of a guard.","Line, no seas ingenua. Solo lleva un guante y una hombrera del uniforme de un guardia.");
 ds_map_add(m,"Whaaat!?","¡¿Quééé?!");
 ds_map_add(m,"The truth is that it is too late, I will have to fine you with 100 arcs for lack of respect for authority.","La verdad es que ya es demasiado tarde. Te impondré una multa de 100 Arcs por faltarle el respeto a la autoridad.");
 ds_map_add(m,"LiLi do not offend the guard.","Lili, no provoques a la guardia.");
 ds_map_add(m,"What? Ha ha? just look at my guard outfit you must be mistaking me with someone else.","¿Qué? ¿Ja, ja? Mira mi uniforme de guardia. Debes de confundirme con otra persona.");
 ds_map_add(m,"Exit","Salir");
 ds_map_add(m,"Bribe her with something. (Lili's idea)","Sobórnala con algo. (Idea de Lili)");
 ds_map_add(m,"Pay the fare. (500 Arcs)","Pagar el peaje. (500 Arcs)");
 ds_map_add(m,"This is the bitch from the wanted poster! (Lili say)","¡Es la zorra del cartel de búsqueda! (Dice Lili)");
 ds_map_add(m,"Due to the high use of the bridge, it started to require maintenance, so I'm here to collect the toll.","Debido al uso intenso del puente, ahora necesita mantenimiento, así que estoy aquí para cobrar el peaje.");
 ds_map_add(m,"I'm not very good at fighting is not my style but I do what I can since I'm half wyvern I use poison, it's not very powerful but I cut their healing by 50% and I strike a punch or two even though I'm not very strong.","No se me da muy bien luchar; no es lo mío, pero hago lo que puedo. Como soy mitad guiverno, uso veneno. No es muy potente, pero reduce la curación del enemigo un 50 % y le doy uno o dos puñetazos, aunque no soy muy fuerte.");
 ds_map_add(m,"No, could you tell me again how you fight?","No, ¿podrías volver a explicarme cómo luchas?");
 ds_map_add(m,"You wanna quit for the day?","¿Quieres dejarlo por hoy?");
 ds_map_add(m,"Sorry, I cant right now.","Lo siento, ahora no puedo.");
 ds_map_add(m,"Of course <3.","Claro <3.");
 ds_map_add(m,"Ready to make some mess?","¿Listo para causar un buen lío?");
 ds_map_add(m,"Come back when you have Arcs.","Vuelve cuando tengas Arcs.");
 ds_map_add(m,"There you have it, you little rascal.","Aquí tienes, pequeño bribón.");
 ds_map_add(m,"Not now.","Ahora no.");
 ds_map_add(m,"Ok","Vale");
 ds_map_add(m,"Unfortunately I can't find him, I'll sell it to you for a thousand Arcs if you want it so badly.","Por desgracia, no consigo encontrarlo. Si tanto lo quieres, te lo venderé por mil Arcs.");
 ds_map_add(m,"You want to buy the briefcase I have? I was thinking of blackmailing the guy who lost it.","¿Quieres comprar el maletín que tengo? Pensaba chantajear al tipo que lo perdió.");
 ds_map_add(m,"And don't even think of taking a single Arc out of here, don't you see that why we have worked so hard, so that I can sleep like my ancestors. Yep Surrounded by money.","Y ni se te ocurra llevarte ni un solo Arc de aquí. ¿No ves que hemos trabajado tan duro para que pueda dormir como mis antepasados? Sí, rodeado de dinero.");
 ds_map_add(m,"Hey Line you figured out where I keep all my Arcs.","Oye, Line, has descubierto dónde guardo todos mis Arcs.");
 ds_map_add(m,"Umm eh em. h-hi.","Mmm, eh... em... h-hola.");
 ds_map_add(m,"Theres nothing to explain, you blew up those girls!","No hay nada que explicar. ¡Hiciste explotar a esas chicas!");
 ds_map_add(m,"Please let me explain.","Por favor, déjame explicarlo.");
 ds_map_add(m,"Well the truth is that I don't like to fight, but I can support you by recovering 10% of your life from time to time.","La verdad es que no me gusta luchar, pero puedo apoyarte recuperando un 10 % de tu vida de vez en cuando.");
 ds_map_add(m,"No never.","No, nunca.");
 ds_map_add(m,"you want to rest?","¿Quieres descansar?");
 ds_map_add(m,"Actually yes,could you tell me again how you fight?","En realidad sí. ¿Podrías volver a explicarme cómo luchas?");
 ds_map_add(m,"This Quest is only for patreons.","Esta misión es solo para mecenas de Patreon.");
 ds_map_add(m,"Remember, if you find her, bring her with me in the sencond Floor of the hotel even if she doesn't want to.","Recuerda: si la encuentras, tráela conmigo al segundo piso del hotel, aunque no quiera.");
 ds_map_add(m,"How annoying you are!.","¡Qué pesada eres!");
 ds_map_add(m,"Oh you still have the strength to fight? I guess it will be a second round.","Oh, ¿todavía tienes fuerzas para luchar? Supongo que habrá una segunda ronda.");
 ds_map_add(m,"Yes, yes I understand you, sorry for wasting your time :c.","Sí, sí, te entiendo. Perdona por hacerte perder el tiempo :c.");
 ds_map_add(m,"Thanks Line but I'm looking for an adventurer a little more mmmm.... recognizable one that wherever he goes, people will recognize him, you know what I mean right?","Gracias, Line, pero busco a un aventurero un poco más... mmm... conocido. Alguien a quien la gente reconozca vaya donde vaya. Ya sabes a qué me refiero, ¿no?");
 ds_map_add(m,"Oh well, I don't know, but still, if you need help, uh a-here I am.","Oh, bueno, no lo sé, pero si necesitas ayuda, eh... a-aquí estoy.");
 ds_map_add(m,"Really? I don't see you being the adventurous type.","¿De verdad? No pareces del tipo aventurero.");
 ds_map_add(m,"Oh.. ehmm h-hi i am Line I am adventurer","Oh... eh... h-hola, soy Line, soy aventurera.");
 ds_map_add(m,"Uff this novel will practically write itself.","Uf, esta novela prácticamente se escribirá sola.");
 ds_map_add(m,"I am also half succubus :v.","También soy mitad súcubo :v.");
 ds_map_add(m,"OHh, an orthodox elf who discovers her sexuality, Line your life is gold.","¡Oh! Una elfa tradicional que descubre su sexualidad. Line, tu vida es oro puro.");
 ds_map_add(m,"Hey, hey hey  she is not a whore she is just exploring her sexuality.","¡Eh, eh, eh! No es una puta, solo está explorando su sexualidad.");
 ds_map_add(m,"Wow Line you are such a whore you must have a million stories please let me join you on your journey.","¡Vaya, Line, eres una zorra de cuidado! Debes de tener un millón de historias. Por favor, déjame acompañarte en tu viaje.");
 ds_map_add(m,"Lili! ( Please someone kill me )","¡Lili! (Que alguien me mate, por favor).");
 ds_map_add(m,"HAHAHA because they don't have it, she defeated the demon by taking her energy by giving her a rimjob.","JAJAJA, porque no lo tienen. Derrotó al demonio absorbiendo su energía al hacerle un beso negro.");
 ds_map_add(m,"Wow I had no idea that elves could summon sacred fires.","Vaya, no tenía ni idea de que los elfos podían invocar fuego sagrado.");
 ds_map_add(m,"Well you know... fire ehh sacred ... of elf (Iam a terrible liar :C).","Bueno, ya sabes... fuego, eh... sagrado... de elfo. (Soy una mentirosa terrible :C).");
 ds_map_add(m,"OHHH and what is this super attack?!","¡¡¡Y esa qué es, una supertécnica?!");
 ds_map_add(m,"OHh. that, I ahemm. We fought an epic battle where I was on the verge of losing but luckily I channeled all my strength into one last attack and BAM I knocked her down and she fell unconscious.","Oh, eso... Ejem. Libramos una batalla épica en la que estuve a punto de perder, pero, por suerte, concentré todas mis fuerzas en un último ataque y ¡BUM!, la derribé y cayó inconsciente.");
 ds_map_add(m,"How did you defeat the white demon in the forest? The whole town is talking about you winning her but nobody knows exactly how?","¿Cómo derrotaste al demonio blanco del bosque? Todo el pueblo habla de que la venciste, pero nadie sabe exactamente cómo.");
 ds_map_add(m,"OHh hu-hu-hu wha-what kind of experiences do you need.","Oh, ju-ju-ju, ¿q-qué tipo de experiencias necesitas?");
 ds_map_add(m,"PLEASE let me join you on your journey my novel depends on you I need all the experience you can give me.","¡POR FAVOR, déjame acompañarte en tu viaje! Mi novela depende de ti. Necesito todas las experiencias que puedas contarme.");
 ds_map_add(m,"Ehh yes I am she hehe.","Eh, sí, soy yo, jeje.");
 ds_map_add(m,"Hey, are you the traveler who defeated the demon that stole the alcohol supplies?!","¡Oye! ¿Eres la viajera que derrotó al demonio que robó las reservas de alcohol?");
 ds_map_add(m,"Well I do moderate magic damage and upgrade a magic cube on the grid every so often.","Bueno, inflijo un daño mágico moderado y, de vez en cuando, mejoro un bloque mágico del tablero.");
 ds_map_add(m,"Yes I need to do something by my own sorry. :c","Sí, tengo que hacer algo por mi cuenta. Lo siento. :c");
 ds_map_add(m,"You want to rest?","¿Quieres descansar?");
 ds_map_add(m,"Can you help me in my adventure. <3?.","¿Puedes acompañarme en mi aventura? <3?.");
 ds_map_add(m,"Oh hehe thanks <3.","Oh, jeje, gracias <3.");
 ds_map_add(m,"The world is a better place with you in it, whether you like it or not.","El mundo es un lugar mejor contigo en él, te guste o no.");
 ds_map_add(m,"Really? well that would help me a lot and don't worry it's the first time I've seen a fairy like that haha.\nWell, if you find it, please do not view its content, it is classified from my work.","¿De verdad? Eso me ayudaría muchísimo. Y no te preocupes, es la primera vez que veo un hada así, jaja.\nBueno, si la encuentras, por favor no mires su contenido; es información confidencial de mi trabajo.");
 ds_map_add(m,"Lili! \n Oh I am so-sorry she is a bit aggressive but she has a good heart if you want we can help you look for your briefcase.","¡Lili!\nOh, lo siento, es un poco agresiva, pero tiene buen corazón. Si quieres, podemos ayudarte a buscar tu maletín.");
 ds_map_add(m,"Ya great but I didn't ask you about your life","Sí, genial, pero no te he preguntado por tu vida.");
 ds_map_add(m,"Sorry I had a horrible day I lost my briefcase and I had a lot of important information in it now I have to start from scratch.","Lo siento, he tenido un día horrible. Perdí mi maletín y tenía mucha información importante dentro; ahora tengo que empezar de cero.");
 ds_map_add(m,"Lili do not say it like that!","¡Lili, no lo digas así!");
 ds_map_add(m,"Hey shut up, you're in a library.","Oye, cállate, estás en una biblioteca.");
 ds_map_add(m,"AHh I'll have to start all over again.\nWhere can my briefcase be?","¡Ahh, tendré que empezar todo de nuevo!\n¿Dónde estará mi maletín?");
 ds_map_add(m,"Did you find my briefcase?","¿Encontraste mi maletín?");
 ds_map_add(m,"My briefcase should be here somewhere","Mi maletín debe de estar por aquí, en alguna parte.");
 ds_map_add(m,"Well I do moderate Impact damage to the enemy and between each fight I can try to win more Arcs.","Bueno, inflijo un daño de impacto moderado al enemigo y, entre combate y combate, puedo intentar conseguir más Arcs.");
 ds_map_add(m,"Actually could you tell me again how you fight?","En realidad, ¿podrías volver a explicarme cómo luchas?");
 ds_map_add(m,"No now.","Ahora no.");
 ds_map_add(m,"Yes please I am a little tired.","Sí, por favor. Estoy un poco cansada.");
 ds_map_add(m,"Are we done for the day?","¿Hemos terminado por hoy?");
 ds_map_add(m,"In a fight I do moderate impact damage plus I can make the enemy give us double the Arcs for the trouble he gave us..","En combate inflijo un daño de impacto moderado y, además, puedo hacer que el enemigo nos pague el doble de Arcs por todos los problemas que nos ha causado.");
 ds_map_add(m,"Do you need something line?","¿Necesitas algo, Line?");
 ds_map_add(m,"But once they atone for their sins they will be returned to them is the law of the island.","Pero, cuando expían sus pecados, se les devuelven. Es la ley de la isla.");
 ds_map_add(m,"Oh no, hahaha that would be crazy. I just steal their eyes and place them on my body.","Oh, no, jajaja. Eso sería una locura. Solo les robo los ojos y me los coloco en el cuerpo.");
 ds_map_add(m,"And how are you supposed to do your justice, you don't kill them... right?","¿Y cómo piensas hacer justicia? No los matas... ¿verdad?");
 ds_map_add(m,"As I pray I can hear the prayers of women in trouble and bring justice.","Cuando rezo, puedo oír las plegarias de las mujeres en apuros y hacer justicia.");
 ds_map_add(m,"I am Ragnuda the dodomeki and I judge men who cheat on their wives.","Soy Ragnuda, la dodomeki, y juzgo a los hombres que engañan a sus esposas.");
 ds_map_add(m,"Oh I am sorry it's just weird to see someone here at night... and naked. :v","Oh, perdona. Es que resulta raro encontrarse con alguien aquí de noche... y desnudo. :v");
 ds_map_add(m,"You interrupted my prayers.","Has interrumpido mis plegarias.");
 ds_map_add(m,"What a brave boy ;c","Qué chico tan valiente ;c");
 ds_map_add(m,"MOooOOOo!","¡¡¡Muuuu!!!");
 ds_map_add(m,"Line Look","¡Line, mira!");
 ds_map_add(m,"A somewhat ironic ending I guess Hahaha.","Un final algo irónico, supongo. Jajaja.");
 ds_map_add(m,"Shale vale :v.","Bueno, vale :v.");
 ds_map_add(m,"I was told that I can earn some money by selling my own 'milk'.","Me dijeron que podía ganar algo de dinero vendiendo mi propia «leche».");
 ds_map_add(m,"And now I have no money to go back home ;c.","Y ahora no tengo dinero para volver a casa ;c.");
 ds_map_add(m,"Well... I came on vacation to this island but I spent my money driking milk.","Bueno... Vine de vacaciones a esta isla, pero me gasté todo el dinero bebiendo leche.");
 ds_map_add(m,"What happened to you?","¿Qué te ha pasado?");
 ds_map_add(m,"Ah I really don't want to do this.","Ay, de verdad no quiero hacer esto.");
 ds_map_add(m,"Oh he doesn't have a cow outfit.","Vaya, no tiene un disfraz de vaca.");
 ds_map_add(m,"Haha its ok take care.","Jaja, no pasa nada. Cuídate.");
 ds_map_add(m,"Oh, yeah sorry it will have to be for another day :c.","Ah, sí, perdona. Tendrá que ser otro día :c.");
 ds_map_add(m,"Line! focus on your objective, we are looking for your friend.","¡Line! Concéntrate en tu objetivo; estamos buscando a tu amiga.");
 ds_map_add(m,"Oh I am not really a drinking person hehe but if you want I can.... join you you know.","Oh, no suelo beber mucho, jeje, pero si quieres puedo... acompañarte, ya sabes.");
 ds_map_add(m,"Hi, sweetie, would you like to join me for a drink?","Hola, cariño. ¿Te apetece tomar algo conmigo?");
 ds_map_add(m,"make me bitch","Oblígame, zorra.");
 ds_map_add(m,"Get the hell out of my territory you thot","¡Lárgate de mi territorio de una puta vez, zorra!");
 ds_map_add(m,"It may already be time to get back to work, I miss announcing the news.","Ya va siendo hora de volver al trabajo. Echo de menos presentar las noticias.");
 ds_map_add(m,"I wouldn't miss it for anything in the world.","No me lo perdería por nada del mundo.");
 ds_map_add(m,"Mmm.. hi there will be a mini show at the circus I would appreciate it if you could go.","Mmm... Hola. El circo va a ofrecer un pequeño espectáculo y te agradecería mucho que vinieras.");
 ds_map_add(m,"*blushed* th-thank you it is a relief that you liked it.","*Se sonroja* G-gracias. Me alegra que te haya gustado.");
 ds_map_add(m,"That was a great show.","Ha sido un espectáculo estupendo.");
 ds_map_add(m,"Sorry (but I didn't do anything :c).","Perdón (aunque no he hecho nada :c).");
 ds_map_add(m,"She is very sorry, say sorry *covers Line's mouth*","Está muy arrepentida. Pide perdón. *Le tapa la boca a Line*");
 ds_map_add(m,"Oh, well if you wan..","Ah, bueno, si quieres...");
 ds_map_add(m,"Excuse me? that no way of speaking if I were your mother I would punish you.","¿Perdona? Esa no es forma de hablar. Si yo fuera tu madre, te castigaría.");
 ds_map_add(m,"Shit! Line look at that ass.","¡Joder! Line, ¡mira ese culo!");
 ds_map_add(m,"Finally I finished cleaning this floor, Mr.Cabello will be happy <3.","Por fin terminé de limpiar esta planta. El señor Cabello estará contento <3.");
 ds_map_add(m,"Thanks Line for the help <3.","Gracias por ayudarme, Line <3.");
 ds_map_add(m,"MMm where to go next, what place will inspire me? to write my next hit.","Mmm... ¿Adónde iré ahora? ¿Qué lugar me inspirará para escribir mi próximo éxito?");
 ds_map_add(m,"But, what?...well whatever. I hope you can accomplish your mission miss but if it gets too dangerous run away please I don't want my book to be tainted by someone dying or getting lost in the woods.","Pero, ¿qué...? Bueno, da igual. Espero que cumplas tu misión, señorita, pero si se vuelve demasiado peligroso, huye, por favor. No quiero que mi libro quede marcado porque alguien muera o se pierda en el bosque.");
 ds_map_add(m,"I will do my best I will be worthy of the sword *reverence*.","Haré todo lo posible. Seré digna de la espada. *Hace una reverencia*");
 ds_map_add(m,"What are you talking about? I never said you were going to look for her, and I don't really care either, no one has taken her out so far.","¿De qué estás hablando? Nunca dije que fueras a buscarla y, la verdad, tampoco me importa. Hasta ahora nadie ha conseguido sacarla.");
 ds_map_add(m,"Thank you very much I will not let you down and I will bring the sword.","¡Muchísimas gracias! No te decepcionaré y traeré la espada.");
 ds_map_add(m,"Well one enters the forest and must follow these directions up, down, left, left, left, right, down and finally up. But beware that even if I am not here, the spiritual energy of one of my ancestors may try to deny you passage..","Bueno, entras en el bosque y sigues estas direcciones: arriba, abajo, izquierda, izquierda, izquierda, derecha, abajo y, por último, arriba. Pero cuidado: aunque yo no esté aquí, la energía espiritual de uno de mis antepasados podría impedirte el paso...");
 ds_map_add(m,"And how I got there!","¡¿Y cómo llegué yo hasta allí?!");
 ds_map_add(m,"Yes, but there came a time when I really understood that she didn't need me to take care of her, she was quite lost in the forest and to get her out you have to have the requirements I wrote down, even so I don't understand how that helps to get the sword out.","Sí, pero llegó un momento en que comprendí que ella no necesitaba que la cuidara. Estaba completamente perdida en el bosque y, para sacarla de allí, hay que cumplir los requisitos que anoté. Aun así, no entiendo qué tiene eso que ver con sacar la espada.");
 ds_map_add(m,"What the heck?!","¡¿Pero qué demonios?!");
 ds_map_add(m,"Oh relax you will be surprised to know that it is true my family was the one who took care of the sword although we never managed to get it off the anvil.","Tranquila, te sorprendería saber que es verdad. Mi familia era la encargada de cuidar la espada, aunque nunca conseguimos sacarla del yunque.");
 ds_map_add(m,"Uh sorry sir my friend fell out of the crib when she was a baby we won't bother you anymore eh hehe ehh..","Eh... Disculpe, señor. Mi amiga se cayó de la cuna cuando era bebé. Ya no le molestaremos, je, je...");
 ds_map_add(m,"YES! You know that when I read your story I did not feel that the sword is true and I can feel it on the island.","¡SÍ! ¿Sabes? Cuando leí tu historia no creí que la espada fuera real, pero ahora puedo sentir que está en la isla.");
 ds_map_add(m,"Mmmm yes I am surprised to find fans here, was it because of the back cover?","Mmm, sí. Me sorprende encontrar fans por aquí. ¿Ha sido por lo que pone en la contraportada?");
 ds_map_add(m,"Hello sir, are you by any chance the author of The Pelletclad Blade?","Hola, señor. ¿Es usted, por casualidad, el autor de *La Hoja Pelletclad*?");
 ds_map_add(m,"You say that because of the sheets in his hand...I guess it's worth a try.","¿Lo dices por los papeles que lleva en la mano...? Supongo que vale la pena intentarlo.");
 ds_map_add(m,"Looks like a writer?","¿Tiene pinta de escritor?");
 ds_map_add(m,"Ehh it must be because of the years it was stored out in the open hehe.","Eh... Será por todos esos años que ha pasado a la intemperie, jeje.");
 ds_map_add(m,"What, you managed to get the sword I'm glad it has a new owner but why does it smell so strange?","¿Qué? ¿Conseguiste la espada? Me alegra que tenga una nueva dueña, pero ¿por qué huele tan raro?");
 ds_map_add(m,"Hey do you want something really chingon?.","Oye, ¿quieres algo realmente chingón?");
 ds_map_add(m,"Oh give me a second I'm getting my suit ready.","Espera un segundo, estoy preparando mi traje.");
 ds_map_add(m,"Mmmhe MMMhe I understand I will have it ready when I bring the 5000 arcs leave it all to me.","Mmm, mmm, entendido. Lo tendré listo cuando traigas los 5000 Arcs. Déjalo todo en mis manos.");
 ds_map_add(m,"Mmmm ok but I want this for my furrsuit *whispering* shp shp shp shapa shapa shapa.","Mmm, vale, pero quiero esto para mi traje furry. *Susurrando* shp shp shp shapa shapa shapa.");
 ds_map_add(m,"I know it's expensive but understand that the suit is custom made with all the specifications you want.","Sé que es caro, pero entiende que el traje se confecciona a medida y con todas las especificaciones que quieras.");
 ds_map_add(m,"Great it's only 5000 Arcs","Genial, solo son 5000 Arcs.");
 ds_map_add(m,"You've already convinced me how much it costs!","¡Ya me has convencido! ¿Cuánto cuesta?");
 ds_map_add(m,"I'm not going to lie to you, it's expensive, but if it's any incentive Miss Marael says that sex in a furrisuit is quite an experience.","No te voy a mentir, es caro, pero, por si te anima, la señorita Marael dice que el sexo con un traje furry es toda una experiencia.");
 ds_map_add(m,"Now I want to be a furry!","¡Ahora quiero ser furry!");
 ds_map_add(m,"Yes haha she was part of the furry community before deciding to live life as a goat woman.","Sí, jajaja. Antes formaba parte de la comunidad furry, hasta que decidió vivir como una mujer cabra.");
 ds_map_add(m,"Really?!","¿¡En serio!?");
 ds_map_add(m,"Oh you talk about Miss Marael what a nice woman she was my first time.","Ah, hablas de la señorita Marael. Qué mujer tan encantadora... Fue mi primera vez.");
 ds_map_add(m,"Mmm... I am half succubus and I cannot even transform myself to the taste of others, I met a succubus who decided to live life as a black goat woman, I would really like to change my form and know how it would be like to be a real succubus.","Mmm... Soy mitad súcubo y ni siquiera puedo cambiar de forma para adaptarme a los gustos de los demás. Conocí a una súcubo que decidió vivir como una mujer cabra negra. Me encantaría cambiar de forma y saber qué se siente al ser una auténtica súcubo.");
 ds_map_add(m,"Not all of us are lucky enough to be born as one or transform ourselves but with these costumes we have the opportunity to live life from a different perspective.","No todos tenemos la suerte de nacer así o de poder transformarnos, pero estos disfraces nos permiten vivir la vida desde otra perspectiva.");
 ds_map_add(m,"Well, it all depends on whether you admire atropomorphic animals like wolves.","Bueno, depende de si te gustan los animales antropomórficos, como los lobos.");
 ds_map_add(m,"Mmm I do not know what's in it for me?","Mmm, no sé. ¿Qué gano yo con esto?");
 ds_map_add(m,"I don't know Line looks like a weirdo.","No sé, Line. Parece un rarito.");
 ds_map_add(m,"Would you like to be part of our community?","¿Te gustaría formar parte de nuestra comunidad?");
 ds_map_add(m,"OH how cute I love your fluffy little ears <3.","¡Oh, qué monada! Me encantan tus orejitas peludas <3.");
 ds_map_add(m,"Indeed, I am an honorable member of the furry community.","En efecto, soy un miembro honorable de la comunidad furry.");
 ds_map_add(m,"... H-hi e- that's a costume?","... H-hola... ¿E-es un disfraz?");
 ds_map_add(m,"Ohmm HI I am Snugglepaws!","¡Ejem! ¡Hola, soy Snugglepaws!");
 ds_map_add(m,"No I am still short of money :c.","No, todavía me falta dinero :c.");
 ds_map_add(m,"Did you get the money?","¿Conseguiste el dinero?");
 ds_map_add(m,"Thank you very much Mr. Snugglepaws.","Muchas gracias, señor Snugglepaws.");
 ds_map_add(m,"Let's go home Lili, I need your help!","¡Vamos a casa, Lili! ¡Necesito tu ayuda!");
 ds_map_add(m,"Ohhhh I love it I love it I love it I love it that's all I wanted <3!","¡Ooooh, me encanta, me encanta, me encanta, me encanta! ¡Es justo lo que quería <3!");
 ds_map_add(m,"Here it is, your furrsuit of rabbit woman with movable mouth, automatic blinking, with soft light blue magenta hair!","Aquí tienes tu traje furry de mujer conejo, con boca móvil, parpadeo automático y un suave pelaje azul claro y magenta.");
 ds_map_add(m,"Oh it's okay I'll wait here <3.","Está bien, esperaré aquí <3.");
 ds_map_add(m,"Yes, everything is here. (pay 5000 Arcs)","Sí, está todo aquí. (Pagar 5000 Arcs)");
 ds_map_add(m,"Not yet.","Todavía no.");
 ds_map_add(m,"Thank you very much but I am no longer Line now call me Bluebell.","Muchas gracias, pero ya no soy Line. Ahora llámame Bluebell.");
 ds_map_add(m,"Go Line I know what you want to do.","Adelante, Line. Sé lo que quieres hacer.");
 ds_map_add(m,"... good, thank you.","... Bien, gracias.");
 ds_map_add(m,"Oh Bluebell did you like the suit?","Oh, Bluebell, ¿te gustó el traje?");
 ds_map_add(m,"Oh hehe we really have a very similar voice, masturbating thinking about my own voice will be something very strange hehe although something exciting.","Je, je... De verdad tenemos una voz muy parecida. Masturbarme pensando en mi propia voz sería muy raro, jeje, aunque también algo excitante.");
 ds_map_add(m,"Wow you sound a lot like me, haha ,well I have a fura fura fruit if you want to eat one.","¡Vaya, tu voz se parece muchísimo a la mía! Jaja. Bueno, tengo una fruta Fura Fura, por si quieres probarla.");
 ds_map_add(m,"No, no, no, no, I-I want to hehe sorry for overthinking it.","No, no, no, no... ¡S-sí quiero! Jeje, perdona, le he dado demasiadas vueltas.");
 ds_map_add(m,"If you don't want to, it's okay, lady.","Si no quieres, no pasa nada, señorita.");
 ds_map_add(m,"Oh Mmmm (exactly, pretend to think so they don't find out you're desperate).","Oh, mmm... (Eso es, finge que te lo estás pensando para que no se note que estás desesperada).");
 ds_map_add(m,"Hello Miss, by any chance do you want to use my hole?","Hola, señorita. Por casualidad, ¿quieres usar mi agujero?");
 ds_map_add(m,"Only the family may enter this sanctuary.","Solo los miembros de la familia pueden entrar en este santuario.");
 ds_map_add(m,"Come on Run! I bet 1000 Arcs on you Hu HU HU HU HUghg!.","¡Vamos, corre! ¡He apostado 1000 Arcs por ti! ¡Ju, ju, ju, ju, ju!");
 ds_map_add(m,"I'll do it sir, don't worry. Line now you've gone too far give it some space.","Yo me encargo, señor, no se preocupe. Line, esta vez te has pasado. Dale un poco de espacio.");
 ds_map_add(m,"Please someone get this girl out of my vital space.","Por favor, que alguien saque a esta chica de mi espacio personal.");
 ds_map_add(m,"OH! *approaches at too uncomfortable a distance* thank you thank you thank you very much sir I will use your wisdom with care.","¡OH! *Se acerca a una distancia demasiado incómoda* ¡Gracias, gracias, muchísimas gracias, señor! Tendré mucho cuidado al aplicar su sabiduría.");
 ds_map_add(m,"Eheee... I guess every time I'm going to do something that involves force I pound my chest for some reason it makes me feel stronger.","Eeeh... Supongo que cada vez que voy a hacer algo que requiere fuerza me golpeo el pecho. Por alguna razón, eso me hace sentir más fuerte.");
 ds_map_add(m,"Can you tell me how to get the strength of a gorilla please please pleaseeeeee?","¿Puedes decirme cómo conseguir la fuerza de un gorila? ¡Por favor, por favor, por favooooor!");
 ds_map_add(m,"... The last time I checked, I was indeed.","... La última vez que lo comprobé, sí que lo era.");
 ds_map_add(m,"Ho hello are you a gorilla?","H-hola, ¿eres un gorila?");
 ds_map_add(m,"No no no we are just travelers looking for our friend ;c.","No, no, no. Solo somos viajeras que buscan a una amiga ;c.");
 ds_map_add(m,"Oh I *hip* see, you are allies of the empire trying to erase part of history.","Ah, ya *eructo* veo. Sois aliadas del imperio que intentan borrar parte de la historia.");
 ds_map_add(m,"hey miss hero we're a little busy it was good your story and all, but we have to keep moving.","Oye, señorita heroína, estamos un poco ocupadas. Tu historia y todo eso ha estado bien, pero tenemos que seguir.");
 ds_map_add(m,"doesn't matter! you should know this world is forgetting *hip*roes and I'll make them remember.","¡Da igual! Debes saber que este mundo está olvidando a los *eructo*héroes, ¡y yo haré que los recuerde!");
 ds_map_add(m,"Mmm ... n-no, i didn't know i'm half elf half succubus actually.","Mmm... N-no, no lo sabía. En realidad, soy mitad elfa y mitad súcubo.");
 ds_map_add(m,"Thats nice really nice you *hip* know my father protect all the humanity and they dont even know *hip*t.","Qué bien, qué bien. ¿Sabes? *Eructo* Mi padre protege a toda la humanidad y ni siquiera lo saben *eructo*.");
 ds_map_add(m,"Eh, I'm not the bartender but if you want I'll call her.","Eh, no soy la camarera, pero si quieres la llamo.");
 ds_map_add(m,"Hey, yo skinny girl do something good and bring me some beer *hip*.","Oye, flacucha, haz algo útil y tráeme una cerveza *eructo*.");
 ds_map_add(m,"You know what, I'm not going to go kill the demon that steals the beer shipments. it's my freaking vacation!","¿Sabes qué? No pienso ir a matar al demonio que roba los cargamentos de cerveza. ¡Estoy de malditas vacaciones!");
 ds_map_add(m,"AHHGG! I came to relax on the only island that has no alcohol.","¡AAARGH! Vine a relajarme a la única isla que no tiene alcohol.");
 ds_map_add(m,"Line ... let's get out of here.","Line... vámonos de aquí.");
 ds_map_add(m,"Oh don't worry i have being in this place before. i will repair it and problem solve.","No te preocupes, ya he estado aquí antes. Lo arreglaré y problema resuelto.");
 ds_map_add(m,"I-it's not funny, you broke the table with the fight","N-no tiene gracia. Habéis roto la mesa durante la pelea.");
 ds_map_add(m,"And I think with this fight the effect of the beer were off Hahaha.","Y creo que con esta pelea se me ha pasado el efecto de la cerveza. Jajaja.");
 ds_map_add(m,"You fight very well, I don't think you're with the weaklings of the empire.","Peleas muy bien. No creo que estés del lado de los debiluchos del imperio.");
 ds_map_add(m,"I will repair it after a few drinks haha.","Lo arreglaré después de unas copas, jaja.");
 ds_map_add(m,"it doesn't matter break his ass Line!","¡Da igual! ¡Line, revienta ese culo!");
 ds_map_add(m,"Woomy!","¡Woomy!");
 ds_map_add(m,"So you are the prankster!","¡Así que tú eres la bromista!");
 ds_map_add(m,"Ngyes!","¡Ngyes!");
 ds_map_add(m,"I need you to come with me because of you an innocent woman will go to jail!","¡Tienes que venir conmigo! ¡Por tu culpa, una mujer inocente acabará en la cárcel!");
 ds_map_add(m,"Woomy Woomy!","¡Woomy, Woomy!");
 ds_map_add(m,"I guess as long as she doesn't make any more trouble it's okay for her to stay here.","Supongo que puede quedarse aquí, siempre que no vuelva a causar problemas.");
 ds_map_add(m,"I guess when he fled he found this cave.","Supongo que encontró esta cueva cuando huyó.");
 ds_map_add(m,"Why is it here anyway?","Por cierto, ¿qué hace esto aquí?");
 ds_map_add(m,"Oh... could happen to anyone.","Oh... Le podría pasar a cualquiera.");
 ds_map_add(m,"I also remember when you beat him, he attacked you and you fainted and pissed yourself, what a day.","También recuerdo que, después de que lo vencieras, te atacó, te desmayaste y te measte encima. Menudo día.");
 ds_map_add(m,"Look Lili is the cat that almost put Callie in jail, well, she end up in jail anyways but you know.","Mira, Lili, es la gata que casi consigue que Callie acabara en la cárcel. Bueno, al final sí terminó allí, pero ya me entiendes.");
 ds_map_add(m,"RAWR!","¡GRAAA!");
 ds_map_add(m,"I hope Whipsie is doing well on Tricotex.","Espero que Whipsie esté bien en Tricotex.");
 ds_map_add(m,"This farm reminds me of home.","Esta granja me recuerda a casa.");
 ds_map_add(m,"Take it for granted me and Line can against everything!","¡Ten por seguro que Line y yo podemos con todo!");
 ds_map_add(m,"I guess a little help wouldn't hurt, but I'll have to see if they are both up to the task to be my partner.","Supongo que un poco de ayuda no vendría mal, pero primero tendré que ver si las dos están a la altura para ser mis compañeras.");
 ds_map_add(m,"Sorry sam for her lack of delicacy, she a big fan of you.. and so am I, but I mean who doesn't hehe.","Perdona, Sam, por su falta de tacto. Es una gran admiradora tuya... y yo también. Aunque, bueno, ¿quién no lo es? Jeje.");
 ds_map_add(m,"Wow really can we help to capture it ?!","¡Vaya, en serio! ¿Podemos ayudar a capturarlo?!");
 ds_map_add(m,"For now she is the one who takes care of the city, I come to this island because a Tricotex criminal came here.","Por ahora ella es quien se ocupa de la ciudad. Yo he venido a esta isla porque un criminal de Tricotex ha llegado hasta aquí.");
 ds_map_add(m,"Yeah and where is your partner Whipsy :c?","Sí, ¿y dónde está tu compañera Whipsy :c?");
 ds_map_add(m,"Oh well, actually we are not from here, but we knew your stories of how you saved the streets of Tricotex while we travel.","Bueno, en realidad no somos de aquí, pero durante nuestro viaje oímos tus historias sobre cómo salvaste las calles de Tricotex.");
 ds_map_add(m,"Wow, I didn't think anyone would recognize me around here.","Vaya, no esperaba que nadie me reconociera por aquí.");
 ds_map_add(m,"H-hi you are Sa-Sam the hero o-of the Tricotex right :O?","H-hola. E-eres Sa-Sam, el héroe de Tricotex, ¿verdad :O?");
 ds_map_add(m,"You come for the rematch?","¿Has venido por la revancha?");
 ds_map_add(m,"Haha it's very simple, I do a lot of impact damage.","Jaja, es muy sencillo: inflijo mucho daño de impacto.");
 ds_map_add(m,"I still want to accompany you.","Aun así, quiero acompañarte.");
 ds_map_add(m,"sorry same I have other things to do.","Lo siento, Sam. Tengo otras cosas que hacer.");
 ds_map_add(m,"If you don't have time to catch the criminal, we can part ways for a while.","Si no tienes tiempo para atrapar al criminal, podemos separarnos por un rato.");
 ds_map_add(m,"No sorry, could you tell me again how you fight?","No, lo siento. ¿Podrías explicarme otra vez cómo luchas?");
 ds_map_add(m,"Sorry same I have other things to do.","Lo siento, Sam. Tengo otras cosas que hacer.");
 ds_map_add(m,"Let's catch that criminal <3.","Vamos a atrapar a ese criminal <3.");
 ds_map_add(m,"Now you have time to help me catch the criminal?","¿Ahora tienes tiempo para ayudarme a atrapar al criminal?");
 ds_map_add(m,"Come back as you were!","¡Vuelve a tu forma original!");
 ds_map_add(m,"I do a lot of magic damage that's all you need to know.","Inflijo mucho daño mágico. Eso es todo lo que necesitas saber.");
 ds_map_add(m,"I am sorry I have to go to the bathroom :c.","Lo siento, tengo que ir al baño :c.");
 ds_map_add(m,"Sorry but, could you tell me again how you fight?","Perdona, pero ¿podrías explicarme otra vez cómo luchas?");
 ds_map_add(m,"I really want to help you Faye.","De verdad quiero ayudarte, Faye.");
 ds_map_add(m,"Hey, if you don't have time to help me just say it, it will be faster for me to look for myself.","Oye, si no tienes tiempo para ayudarme, dímelo sin más. Me resultará más rápido buscar por mi cuenta.");
 ds_map_add(m,"Oh ok.. lets go.","Ah, vale... Vamos.");
 ds_map_add(m,"I don't want to waste your time. :c","No quiero hacerte perder el tiempo :c.");
 ds_map_add(m,"If you want to help me just don't waste my time.","Si quieres ayudarme, no me hagas perder el tiempo.");
 ds_map_add(m,"I will rest a little here.","Descansaré un rato aquí.");
 ds_map_add(m,"I think it's southeast from here.","Creo que está al sureste de aquí.");
 ds_map_add(m,"Where is she now?","¿Dónde está ahora?");
 ds_map_add(m,"Yes, I think a cow that escaped from the farm ran into the idiot that did this to me.","Sí, creo que una vaca que se escapó de la granja embistió al idiota que me hizo esto.");
 ds_map_add(m,"Do you know where he went or if anyone saw him?","¿Sabes adónde fue o si alguien lo vio?");
 ds_map_add(m,"Thanks, I came to buy some milk and something covered me in this stuff.","Gracias. Vine a comprar leche y algo me cubrió de esta porquería.");
 ds_map_add(m,"Calm down, I will help you.","Tranquila, te ayudaré.");
 ds_map_add(m,"Shit somebody help me get this out","¡Mierda! ¡Que alguien me ayude a quitarme esto!");
 ds_map_add(m,"Yeah, she went to the cultivation of nana leaves","Sí, fue al cultivo de hojas de nana.");
 ds_map_add(m,"Thanks, I came from buying some special milk and something covered me with this thing.","Gracias. Venía de comprar leche especial y algo me cubrió con esta cosa.");
 ds_map_add(m,"Shit somebody help me get this out.","¡Mierda! ¡Que alguien me ayude a quitarme esto!");
 ds_map_add(m,"Oh ok, if that is what you want but let me tell you that I fight a little different than the rest.","Ah, vale, si es lo que quieres. Pero te advierto que mi forma de luchar es un poco distinta a la de los demás.");
 ds_map_add(m,"You beat him ?! Please fight me in a sparring match.","¿¡Lo derrotaste!? ¡Por favor, pelea conmigo en un combate de entrenamiento!");
 ds_map_add(m,"I know you will, with enough practice you will beat him like I did <3.","Sé que lo conseguirás. Con suficiente práctica, lo vencerás igual que hice yo <3.");
 ds_map_add(m,"I would like to be stronger to face it again.","Me gustaría ser más fuerte para volver a enfrentarme a él.");
 ds_map_add(m,"I am happy to hear you are ok.","Me alegra saber que estás bien.");
 ds_map_add(m,"Thanks for the help, traveler.","Gracias por tu ayuda, viajera.");
 ds_map_add(m,"*Line blushes* Y-yes probably not hehe.","*Line se sonroja* S-sí, probablemente no, jeje.");
 ds_map_add(m,"Besides, I don't think your way of fighting will work for me anyway hahaha.","Además, no creo que tu forma de luchar me sirva de todos modos, jajaja.");
 ds_map_add(m,"I need to practice more but thanks anyway.","Tengo que practicar más, pero gracias de todos modos.");
 ds_map_add(m,"Proklyat'ye.","Maldita sea.");
 ds_map_add(m,"AHhh. my head how did I get here, Hi-Hikari is that you?","¡Aaah! Me duele la cabeza. ¿Cómo he llegado aquí? ¿Hi-Hikari, eres tú?");
 ds_map_add(m,"I love this part of town, although playing pachinco nothing beats it. You should come to my store maybe you will win a prize <3","Me encanta esta zona del pueblo, aunque nada supera jugar al pachinko. Deberías pasarte por mi tienda; quizá ganes un premio <3.");
 ds_map_add(m,"Isn't it precious? This river is so peaceful, a perfect view for my retirement.","¿No es precioso? Este río es tan tranquilo... Una vista perfecta para mi jubilación.");
 ds_map_add(m,"When you have the money come see me on the top floor of the hotel.","Cuando tengas el dinero, ven a verme a la última planta del hotel.");
 ds_map_add(m,"If you can get 1000 arcs I'll give you a girlfriend deal hehe.","Si consigues 1000 Arcs, te ofreceré un trato de novia, jeje.");
 ds_map_add(m,"How much?","¿Cuánto cuesta?");
 ds_map_add(m,"Haha so cute I'm sorry but I charged large amounts of money.","Jaja, qué mona. Lo siento, pero cobro muchísimo.");
 ds_map_add(m,"hey she's a shy succubus why don't you help her out for old times.","Oye, es una súcubo tímida. ¿Por qué no la ayudas, por los viejos tiempos?");
 ds_map_add(m,"Yes but that was a long time ago.","Sí, pero eso fue hace mucho tiempo.");
 ds_map_add(m,"Yes- yes I think you were this escort for shy succubus.","S-sí, sí. Creo que eras la acompañante de la súcubo tímida.");
 ds_map_add(m,"Oh so you do know me.","Ah, entonces sí me conoces.");
 ds_map_add(m,"Oh! I remembered she was in the XXX magazines that your mother had.","¡Oh! Ya recuerdo, salía en las revistas XXX que tenía tu madre.");
 ds_map_add(m,"I don't think a girl with such innocent looks knows who I am.","No creo que una chica con una cara tan inocente sepa quién soy.");
 ds_map_add(m,"He-hello, do I know you from somewhere?","H-hola, ¿nos conocemos de algún sitio?");
 ds_map_add(m,"I can't wait for you to have the money line, haha I haven't done this for a long time.","No veo la hora de que tengas el dinero, Line. Jaja, hace mucho que no hago esto.");
 ds_map_add(m,"And you already know the prize <3.","Y ya sabes cuál es el premio <3.");
 ds_map_add(m,"The first to undress the other wins.","Gana quien consiga desnudar primero a la otra.");
 ds_map_add(m,"If you fail to undress I will take off one of your clothes.","Si no consigues desnudarme, te quitaré una prenda a ti.");
 ds_map_add(m,"You will have attempts to undress me and you have to pay attention to where to touch.","Tendrás varios intentos para desnudarme y tendrás que fijarte en dónde tocar.");
 ds_map_add(m,"Oh you don't have enough Arcs.","Oh, no tienes suficientes Arcs.");
 ds_map_add(m,"Oh ok i will waiting here.","Ah, vale. Te esperaré aquí.");
 ds_map_add(m,"Well to start heating things up we'll play a little game.","Bueno, para ir calentando el ambiente, jugaremos a un pequeño juego.");
 ds_map_add(m,"No right now.","Ahora mismo no.");
 ds_map_add(m,"So Line you want to buy ten minute in heaven <3?","Entonces, Line, ¿quieres comprar diez minutos en el paraíso <3?");
 ds_map_add(m,"sorry it's a bad habit from the past let's try again <3.","Perdona, es una mala costumbre de antes. Vamos a intentarlo otra vez <3.");
 ds_map_add(m,"You left me alone and naked in bed, and the maid also saw me ;C.","Me dejaste sola y desnuda en la cama, ¡y encima la criada también me vio ;C!");
 ds_map_add(m,"haha it looks like you learned a lot <3.","Jaja, parece que has aprendido mucho <3.");
 ds_map_add(m,"Oh but something bad will happen but not to me.","Oh, pero algo malo va a pasar... aunque a mí no.");
 ds_map_add(m,"She says get out of this place oh you're an idiot something could happen to you.","Ella dice que salgas de aquí. ¡Ay, eres un idiota! Podría pasarte algo.");
 ds_map_add(m,"Excuse? What the fuck did you say.","¿Perdona? ¿Qué coño has dicho?");
 ds_map_add(m,"Hey, what are you doing here? This is not a place for children.","Oye, ¿qué haces aquí? Este no es lugar para niños.");
 ds_map_add(m,"And Baku still hasn't come back from the bathroom I'm starting to lose my patience.","Baku todavía no ha vuelto del baño. Se me está acabando la paciencia.");
 ds_map_add(m,"This sucks, there is no alcohol and everyone thinks I'm a minor.","Qué mierda, no hay alcohol y todo el mundo cree que soy menor de edad.");
 ds_map_add(m,"I think the next thing I'll do is go to the farm, dress like a cow and get milked.","Creo que lo siguiente será ir a la granja, disfrazarme de vaca y dejar que me ordeñen.");
 ds_map_add(m,"She says get out of this place something could happen to you.","Ella dice que salgas de aquí, que podría pasarte algo.");
 ds_map_add(m,"Excuse me, What the fuck did you say?.","¿Cómo dices? ¿Qué coño acabas de decir?");
 ds_map_add(m,"Fuck you.","Que te jodan.");
 ds_map_add(m,"Looks Like you have nowhere to run.","Parece que ya no tienes adónde huir.");
 ds_map_add(m,"Hu-hu-hu.","Ju, ju, ju.");
 ds_map_add(m,"After this I hope you rectify what you said.","Después de esto, espero que retires lo que has dicho.");
 ds_map_add(m,"So she's probably fine.","Entonces, probablemente esté bien.");
 ds_map_add(m,"Well.. this is an island to free yourself and explore sexuality freely. Most likely, she's been fucking someone since yesterday.","Bueno... esta isla es para liberarse y explorar la sexualidad sin tapujos. Lo más probable es que lleve desde ayer follando con alguien.");
 ds_map_add(m,"I guess you're right thanks that calms me down a bit.","Supongo que tienes razón. Gracias, eso me tranquiliza un poco.");
 ds_map_add(m,"Stay calm if something bad has happened, the most likely thing is that the guards would have already told you something.","Tranquila. Si hubiera pasado algo malo, lo más probable es que los guardias ya te hubieran avisado.");
 ds_map_add(m,"LiLi calm Alina","Lili tranquiliza a Alina");
 ds_map_add(m,"Line calm Alina","Line tranquiliza a Alina");
 ds_map_add(m,"I won a contest to travel to this island with my girlfriend but she went out yesterday to buy and has not returned yet.","Gané un concurso para viajar a esta isla con mi novia, pero ayer salió de compras y todavía no ha vuelto.");
 ds_map_add(m,"But why would it be a bad idea to come? seems like a nice place.","Pero ¿por qué iba a ser mala idea venir? Parece un sitio agradable.");
 ds_map_add(m,"Oh sorry I heard as I passing by.","Ah, perdón, lo oí al pasar.");
 ds_map_add(m,"Coming to this island was a bad idea.","Venir a esta isla fue una mala idea.");
 ds_map_add(m,"Lili!! ok im sorry for everything ok bye.","¡¡Lili!! Vale, perdón por todo, ¿de acuerdo? Adiós.");
 ds_map_add(m,"Yeah there's no need to fight.","Sí, no hace falta pelearse.");
 ds_map_add(m,"I'm sorry for making a fight, it was wrong.","Perdón por haber empezado la pelea. Estuvo mal.");
 ds_map_add(m,"Thank you you are nothing like your fairy friend.","Gracias. No te pareces en nada a tu amiga hada.");
 ds_map_add(m,"While I'm looking for my friend I'll look for yours, don't worry, everything will be fine.","Mientras busco a mi amiga, también buscaré a la tuya. No te preocupes, todo saldrá bien.");
 ds_map_add(m,"I'm so sorry for what my fairy said.","Siento mucho lo que ha dicho mi hada.");
 ds_map_add(m,"It has been a tiring day I will go to look for her after a nap.","Ha sido un día agotador. Iré a buscarla después de echarme una siesta.");
 ds_map_add(m,"Oh poor little thing it's ok if it's true I will help you.","Ay, pobrecita. Está bien, si es verdad, te ayudaré.");
 ds_map_add(m,"Blub blub blip :c","Glu, glu, blip :c");
 ds_map_add(m,"AHHHH that's what he said! Believe me or not that's your problem.","¡¡¡AAAAH, eso fue lo que dijo!!! Me creas o no, es tu problema.");
 ds_map_add(m,"Mmm really he said? I do not believe you at all Lili, do you know the story of peter and the wolf?","Mmm, ¿de verdad dijo eso? No te creo en absoluto, Lili. ¿Conoces el cuento de Pedro y el lobo?");
 ds_map_add(m,"He said that his owner is out of control, they went to drink but on the way someone stole the key that his mistress uses as a demonic seal.","Dijo que su dueña está fuera de control. Iban a beber, pero por el camino alguien robó la llave que su ama usa como sello demoníaco.");
 ds_map_add(m,"What did he say?","¿Qué ha dicho?");
 ds_map_add(m,"Bleb Bleb blub blub bleb,blub blub, blip blop blop.","Bleb, bleb, glu, glu, bleb, glu, glu, blip, blop, blop.");
 ds_map_add(m,"Ya easy, I'll take care of it \nHey what's going on? Why is that thing moving like crazy if you're having sex in there at least try to keep a low profile.","Sí, fácil, yo me encargo.\nOye, ¿qué está pasando? ¿Por qué se mueve esa cosa como loca? Si estáis follando ahí dentro, al menos intentad no llamar tanto la atención.");
 ds_map_add(m,"Blob blip blop D:!","¡Blob, blip, blop D:!");
 ds_map_add(m,"Oh Mmmm blup, blep blip?","¿Oh, mmm, blup, blep, blip?");
 ds_map_add(m,"Bleb Bleb blub blub bleb.","Bleb, bleb, glu, glu, bleb.");
 ds_map_add(m,"Blurpblupblip?","¿Blurpblupblip?");
 ds_map_add(m,"Blupblurulip!","¡Blupblurulip!");
 ds_map_add(m,"Fuck it Line is fight or nothing!","¡A la mierda, Line! ¡O peleamos o nada!");
 ds_map_add(m,"Dissa-what?!","¿Desapa-qué?!");
 ds_map_add(m,"Bu-but I do not have much money ;c.","P-pero no tengo mucho dinero ;c.");
 ds_map_add(m,"I'm sorry but you have to disappear or pay your bill as a member.","Lo siento, pero tendrás que desaparecer o pagar la cuota de socio.");
 ds_map_add(m,"This is a secret place for members only, and the cost to be one is 10.000 arcs per month.","Este es un lugar secreto exclusivo para miembros, y la cuota es de 10.000 Arcs al mes.");
 ds_map_add(m,"I am Sieki and I really meant how you got here?","Soy Sieki. Lo que quería preguntar es cómo has llegado hasta aquí.");
 ds_map_add(m,"Ohmm... a friend told me here I could get some information about the girls on the island? I am looking for Sieki.","Mmm... Un amigo me dijo que aquí podía conseguir información sobre las chicas de la isla. Busco a Sieki.");
 ds_map_add(m,"You are the traveler what are you doing here?!","¡Tú eres la viajera! ¿Qué haces aquí?!");
 ds_map_add(m,"Wait for me in the forest south of the hospital.","Espérame en el bosque, al sur del hospital.");
 ds_map_add(m,"Dont worry I will take care of this demond","No te preocupes, yo me encargaré de este demonio.");
 ds_map_add(m,"Thank you very much for helping us so much we started it for you when we started selling the special milk of these cows.","Muchísimas gracias por toda tu ayuda. Empezamos con esto por ti cuando comenzamos a vender la leche especial de estas vacas.");
 ds_map_add(m,"Um, yeah, it is okay,","Eh, sí, no pasa nada.");
 ds_map_add(m,"Can you return it to the church? I would appreciate it a lot since I'm still organizing the cases of the other relics.","¿Puedes devolverla a la iglesia? Te lo agradecería muchísimo, porque todavía estoy organizando los expedientes de las otras reliquias.");
 ds_map_add(m,"(Phew, how stressful.) Well, it does not matter. The important thing is that the relic is back.","(Uf, qué estrés). Bueno, no importa. Lo importante es que la reliquia ha vuelto.");
 ds_map_add(m,"Hmm, well, when the robbery happened, you weren't even on the island. I guess I can rule you out as a suspect.","Mmm, bueno, cuando ocurrió el robo ni siquiera estabas en la isla. Supongo que puedo descartarte como sospechosa.");
 ds_map_add(m,"*Starts to sweat but maintains eye contact *... Crazy, right?","*Empieza a sudar, pero mantiene el contacto visual*... Una locura, ¿verdad?");
 ds_map_add(m,"But your story still seems strange...","Pero tu historia sigue pareciéndome extraña...");
 ds_map_add(m,"Hmm, the witnesses said the thief went south of the church.","Mmm, los testigos dijeron que el ladrón fue hacia el sur de la iglesia.");
 ds_map_add(m,"I-it's possible that the person got l-lost or went m-mad in the forest and ended up l-leaving it behind. I-I didn't find anything else besides the relic.","E-es posible que esa persona se p-perdiera o se v-volviera loca en el bosque y acabara d-dejándola allí. N-no encontré nada más aparte de la reliquia.");
 ds_map_add(m,"Wait, but how is that possible? Why would it be lying there?!","¡Espera! ¿Cómo es posible? ¿Por qué iba a estar tirada allí?!");
 ds_map_add(m,"Captain, I found a relic in the forest.","Capitana, he encontrado una reliquia en el bosque.");
 ds_map_add(m,"Have you left the relic at the church already?","¿Ya has dejado la reliquia en la iglesia?");
 ds_map_add(m,"Yes, we will be exemplary citizens of society!","¡Sí, seremos ciudadanos ejemplares!");
 ds_map_add(m,"We already know what to do Line!","¡Ya sabemos qué hacer, Line!");
 ds_map_add(m,"Very well, I appreciate you staying safe.","Muy bien. Me alegra que hayas vuelto sana y salva.");
 ds_map_add(m,"I won't even think about the place, that's how dedicated I am to not making trouble!","¡Ni siquiera pensaré en ese lugar! ¡Así de comprometida estoy con no meterme en líos!");
 ds_map_add(m,"Lastly, there is a scammer posing as a guard you can see her description on the flyers around town and if I were to say one place you shouldn't go it would be the bridge that leads to the magenta swamp.","Por último, hay una estafadora que se hace pasar por guardia. Puedes ver su descripción en los carteles repartidos por el pueblo. Y si hay un lugar al que no deberías ir, es el puente que lleva al pantano magenta.");
 ds_map_add(m,"I think I'm familiar with your description, we'll stay out of it <3","Creo que me suena la descripción. Nos mantendremos alejadas <3");
 ds_map_add(m,"Sometimes from time to time, a foreign heroine comes to catch criminals escaping from her sector, so if you see a lady in a bikini with light blue hair around here in the jail-farm, don't bother her.","De vez en cuando viene una heroína de fuera para capturar a criminales que han escapado de su jurisdicción. Así que, si ves por aquí, en la granja-prisión, a una mujer de pelo azul claro y en bikini, no la molestes.");
 ds_map_add(m,"Noted :O","Anotado :O");
 ds_map_add(m,"Right, first of all stay away from the group of guards in the bar where they are planning how to defeat a demon that steals supplies.","Bien, lo primero: mantente alejada del grupo de guardias del bar. Están planeando cómo derrotar a un demonio que roba suministros.");
 ds_map_add(m,"... and which places should we not go to stay out of the way :v?","... ¿Y a qué lugares no deberíamos ir para no estorbar :v?");
 ds_map_add(m,"No, stay out of the issue, citizens.","No, ciudadanos, no os metáis en esto.");
 ds_map_add(m,"Hey, what if we help solve those problems?","Oye, ¿y si ayudamos a resolver esos problemas?");
 ds_map_add(m,"The barn will be up and running again once we have dealt with the problems.","El granero volverá a funcionar cuando hayamos resuelto los problemas.");
 ds_map_add(m,"We are at the limit because of the increase in crime on the islands.","Estamos al límite por el aumento de la delincuencia en las islas.");
 ds_map_add(m,"Now you cannot enter the barn.","Ahora no puedes entrar en el granero.");
 ds_map_add(m,"Remember, don't be heroes, not everyone can be a guard of Elira.","Recuerda: no te hagas la heroína. No todo el mundo puede ser guardia de Elira.");
 ds_map_add(m,"But you can ask local owners or even artists on the streets.","Pero puedes preguntar a los comerciantes locales o incluso a los artistas callejeros.");
 ds_map_add(m,"I see a lot of people a day, so I couldn't tell you that I did see her.","Veo a muchísima gente cada día, así que no sabría decirte si la he visto.");
 ds_map_add(m,"Oh thank you very much, by chance you have seen a woman with wings on her head.","Ah, muchas gracias. Por casualidad, ¿has visto a una mujer con alas en la cabeza?");
 ds_map_add(m,"Welcome to the cariel town.","Bienvenida al pueblo de Cariel.");
 ds_map_add(m,"Oh-ok :c.","Ah, vale :c.");
 ds_map_add(m,"I'm sorry miss but it's closed for now.","Lo siento, señorita, pero ahora mismo está cerrado.");
 ds_map_add(m,"The great captain gave the order to take care of the town while she searches for the demon.","La gran capitana dio la orden de proteger el pueblo mientras ella busca al demonio.");
 ds_map_add(m,"Then what do we do?","Entonces, ¿qué hacemos?");
 ds_map_add(m,"That bastard.","Ese cabrón.");
 ds_map_add(m,"Everything indicates that so far.","Hasta ahora, todo apunta a eso.");
 ds_map_add(m,"Is the cause of alcohol not reaching the town?","¿Es por eso que no llega alcohol al pueblo?");
 ds_map_add(m,"The traveler defeated a succubus but this is a high rank demon.","La viajera derrotó a una súcubo, pero este es un demonio de alto rango.");
 ds_map_add(m,"A demon? I heard a traveler beat her.","¿Un demonio? He oído que una viajera la derrotó.");
 ds_map_add(m,"Yes, apparently there is something on the outskirts of town.","Sí, al parecer ocurre algo en las afueras del pueblo.");
 ds_map_add(m,"What seriously?","¿Qué? ¿En serio?");
 ds_map_add(m,"This for you traveler!!!","¡¡¡Esto es para ti, viajera!!!");
 ds_map_add(m,"I think this is the last beer in the bar.","Creo que esta es la última cerveza del bar.");
 ds_map_add(m,"I'm finall *hip* drunk enough to tell Callie to go out with me.","Por fin estoy lo bastante borracho *¡hip!* como para invitar a Callie a salir.");
 ds_map_add(m,"No drinks.. no courage.","Sin alcohol... no hay valor.");
 ds_map_add(m,"Life makes sense again <3 !!","¡La vida vuelve a tener sentido <3!");
 ds_map_add(m,"I should patrol while I wait for the next shipment.","Debería patrullar mientras espero el próximo cargamento.");
 ds_map_add(m,"Finally Beer!!!!","¡¡¡Por fin, cerveza!!!");
 ds_map_add(m,"This is so boring.","Qué aburrimiento.");
 ds_map_add(m,"yes unfortunately, that's why I must hurry","Sí, por desgracia. Por eso tengo que darme prisa.");
 ds_map_add(m,"what and were there people there ?!","¿Qué? ¿Y había gente allí?!");
 ds_map_add(m,"I'm sorry miss there was a landslide will be available when I manage to open the way.","Lo siento, señorita. Ha habido un derrumbe; podrá pasar cuando consiga despejar el camino.");
 ds_map_add(m,"Please, can you go see how the miners are, I would go but I'm very tired.","Por favor, ¿puedes ir a ver cómo están los mineros? Iría yo, pero estoy agotado.");
 ds_map_add(m,"Sound cooler.","Suena más genial.");
 ds_map_add(m,"Why Lilian?","¿Por qué Lilian?");
 ds_map_add(m,"Lilian for you.","Lilian, para ti.");
 ds_map_add(m,"Understood Miss Faery.","Entendido, señorita hada.");
 ds_map_add(m,"The great captain told me to stay here until she came back.","La gran capitana me ordenó quedarme aquí hasta que regresara.");
 ds_map_add(m,"there is a dangerous demon prowling, I advise you to go to the town which is a safer place","Hay un demonio peligroso merodeando por la zona. Te aconsejo que vayas al pueblo, que es más seguro.");
 ds_map_add(m,"Sorry Miss the pass to the forest is closed.","Lo siento, señorita, el paso al bosque está cerrado.");
 ds_map_add(m,"Now let us pass!","¡Ahora déjennos pasar!");
 ds_map_add(m,"Excuse me? We are the bounty hunters hired by the great captain to kill the demond.","¿Perdón? Somos cazarrecompensas contratados por la gran capitana para matar al demonio.");
 ds_map_add(m,"I'll stay here guarding.","Me quedaré aquí vigilando.");
 ds_map_add(m,"I will rest here a little.","Descansaré un rato aquí.");
 ds_map_add(m,"Excuse me?","¿Perdona?");
 ds_map_add(m,"these guards are idiots they didn't even see the trail.","Estos guardias son idiotas; ni siquiera vieron el rastro.");
 ds_map_add(m,"I will go see maybe we will find something.","Iré a echar un vistazo. Quizá encontremos algo.");
 ds_map_add(m,"Look Line there's a trace of this thing coming behind the red tent.","Mira, Line, hay un rastro de esa cosa que viene de detrás de la tienda roja.");
 ds_map_add(m,"Ok calm down I will help you get this thing off.","Vale, cálmate. Te ayudaré a quitarte esa cosa.");
 ds_map_add(m,"I would not know very well which of her children it could be, but I do know that it was a lady cat.","No sabría decir cuál de sus crías podría ser, pero sí sé que era una gata.");
 ds_map_add(m,"Sir, did you see where the culprit went, was it really the daughter of the cat that sells clothes the culprit?.","Señor, ¿vio adónde fue la culpable? ¿De verdad fue la hija de la gata que vende ropa?");
 ds_map_add(m,"Seems to be waking up.","Parece que está despertando.");
 ds_map_add(m,"Hey look Lili.","¡Eh, mira, Lili!");
 ds_map_add(m,"Tell me something I do not know.","Cuéntame algo que no sepa.");
 ds_map_add(m,"We are the best guards in town.","Somos los mejores guardias del pueblo.");
 ds_map_add(m,"Let's look for the guard who was left unconscious.","Busquemos al guardia que dejaron inconsciente.");
 ds_map_add(m,"Yea even the culprit could know something about Ava and the strange things that happen on the island.","Sí, incluso la culpable podría saber algo sobre Ava y las cosas extrañas que ocurren en la isla.");
 ds_map_add(m,"Lili we must help them they do not seem to be lying.","Lili, tenemos que ayudarlos. No parece que estén mintiendo.");
 ds_map_add(m,"Mama I swear I didn't it was a blue cat.","¡Mamá, te juro que no fui yo! Fue una gata azul.");
 ds_map_add(m,"What!!","¡¡¿Qué?!!");
 ds_map_add(m,"Due  she is a minor, you will have to pay the fine at the jail-farm.","Como es menor de edad, tendrás que pagar la multa en la granja-prisión.");
 ds_map_add(m,"One of her daughter's pranks left one of the guards unconscious.","Una de las travesuras de su hija dejó inconsciente a uno de los guardias.");
 ds_map_add(m,"I'm afraid that is more serious than that.","Me temo que es más grave que eso.");
 ds_map_add(m,"Now leave if you are not going to buy something.","Ahora márchate si no vas a comprar nada.");
 ds_map_add(m,"Oh c'mon are just pranks how serious it can be.","Vamos, solo son travesuras. ¿Qué tan grave puede ser?");
 ds_map_add(m,"Miss I must inform your daughter she has been seen making pranks to the people of this town.","Señora, debo informarle de que han visto a su hija gastando bromas a la gente del pueblo.");
 ds_map_add(m,"Mom!! are you listening to me? ;c Mom!!!.","¡¡Mamá!! ¿Me estás escuchando? ;c ¡¡¡Mamá!!!");
 ds_map_add(m,"And the guards are blaming me.","Y los guardias me echan la culpa a mí.");
 ds_map_add(m,"Mom there is a cat doing pranks to people.","Mamá, hay una gata que está gastando bromas a la gente.");
 ds_map_add(m,"leave my mommy alone.","Deja en paz a mi mamá.");
 ds_map_add(m,"I'm not going to that place with that sucking milk machine 2000.","No pienso ir a ese sitio con esa máquina ordeñadora 2000.");
 ds_map_add(m,"Come on miss, accompany me to jail-farm.","Vamos, señorita, acompáñeme a la granja-prisión.");
 ds_map_add(m,"Calm love, I'll be back in a few days.","Tranquila, cariño. Volveré dentro de unos días.");
 ds_map_add(m,"But mommy ;c","Pero, mamá ;c");
 ds_map_add(m,"I don't care, it's was worthed.","Me da igual, valió la pena.");
 ds_map_add(m,"I will take you to the jail-farm for assault on social security entities.","Te llevaré a la granja-prisión por agredir a agentes encargados de mantener el orden público.");
 ds_map_add(m,"And you fucking inoperative social parasite you should learn how to do your fucking job before you put people in jail.","Y tú, parásito social inútil de mierda, deberías aprender a hacer tu puto trabajo antes de meter a la gente en la cárcel.");
 ds_map_add(m,"Of course they are innocent, children cover your ears.","Claro que son inocentes. Niños, tápense los oídos.");
 ds_map_add(m,"Really? It seems her daughters were innocent after all.","¿De verdad? Parece que, después de todo, sus hijas eran inocentes.");
 ds_map_add(m,"Wait there were new attacks on other people it couldn't be his daughters they were here with you.","Espera, ¿ha habido nuevos ataques contra otras personas? No pudieron ser sus hijas; estaban aquí contigo.");
 ds_map_add(m,"I'm sorry miss will you have to come with me or you will have increased the time in jail-farm.","Lo siento, señorita, tendrá que acompañarme o le aumentarán la condena en la granja-prisión.");
 ds_map_add(m,"Of course not, you closet slut.","Claro que no, zorra reprimida.");
 ds_map_add(m,"But, I don't really care much about those powers.","Pero, la verdad, no me interesan demasiado esos poderes.");
 ds_map_add(m,"Yes, but the good side is that you can buy clothes and absorb them into your sacred clothes, these will change in combat which will improve your half-succubus abilities <3.","Sí, pero lo bueno es que puedes comprar ropa y absorberla en tu vestimenta sagrada. Esta cambiará durante el combate y potenciará tus habilidades de medio súcubo <3.");
 ds_map_add(m,"What?! b-but these clothes are sacred, my father will be very angry :c.","¡¿Qué?! P-pero estas prendas son sagradas. Mi padre se enfadará mucho :c.");
 ds_map_add(m,"Before going to chase the angel, your mother imbue succubus magic in the elven clothes your father gave you.","Antes de ir a perseguir al ángel, tu madre imbuyó magia de súcubo en la ropa élfica que te regaló tu padre.");
 ds_map_add(m,"Oh no, Lili and now what have you done.","Ay, no, Lili. ¿Y ahora qué has hecho?");
 ds_map_add(m,"Emmm. yes .. but there is something I didn't tell you.","Eeem... sí... pero hay algo que no te he contado.");
 ds_map_add(m,"But for what, the magic clothes that my father gave me are enough to fight.","¿Pero para qué? La ropa mágica que me dio mi padre basta para luchar.");
 ds_map_add(m,"Line look a store maybe you can buy new equipment.","Line, mira, una tienda. Quizá puedas comprar equipo nuevo.");
 ds_map_add(m,"Select the 'natural' option.","Selecciona la opción «Natural».");
 ds_map_add(m,"Then you go to equipment and in the section where you have the boots on.","Después, entra en Equipo y ve a la ranura donde tienes equipadas las botas.");
 ds_map_add(m,"You have to go to the menu press enter.","Tienes que abrir el menú pulsando Intro.");
 ds_map_add(m,"Line to take off your boots.","Line, quítate las botas.");
 ds_map_add(m,"Oh ok but that is within the normal :s but if it is required, I can could trie more things.","Ah, vale, pero eso entra dentro de lo normal :s. Aunque, si hace falta, puedo probar más cosas.");
 ds_map_add(m,"Yeah shure, she seemed somewhat annoyed if we help her, she will most likely give us a price cut,are you with me Line?","Claro, sí. Parecía algo molesta; si la ayudamos, seguramente nos hará un descuento. ¿Vienes conmigo, Line?");
 ds_map_add(m,"No! You're wrong, I just want to be a little stronger, nothing more.","¡No! Te equivocas, solo quiero hacerme un poco más fuerte, nada más.");
 ds_map_add(m,"Oh so now you want new stuff, don't pretend to be a saint you wanted to excite your opponents with new clothes.","Ah, ¿así que ahora quieres cosas nuevas? No te hagas la santa; querías poner a tus rivales a cien con ropa nueva.");
 ds_map_add(m,"What are we going to do Lili :s.","¿Qué hacemos, Lili? :s");
 ds_map_add(m,"What the hell! those prices.","¡¿Pero qué demonios?! ¡Menudos precios!");
 ds_map_add(m,"AHHH FORGET WHAT YOU SAW!","¡¡¡AHHH, OLVIDA LO QUE HAS VISTO!!!");
 ds_map_add(m,"Oh, I almost forgot, give these pamphlets to the people.","Ah, casi se me olvida. Reparte estos folletos entre la gente.");
 ds_map_add(m,"I might know where he could be.","Puede que sepa dónde está.");
 ds_map_add(m,"Of course, if she came to this island for the same reason that all tourists come.","Claro, si vino a esta isla por el mismo motivo que vienen todos los turistas.");
 ds_map_add(m,"If I help you, could you help us by getting information from my friend?","Si te ayudo, ¿podrías ayudarnos consiguiendo información de mi amigo?");
 ds_map_add(m,"People have to know that the red tent will open soon so im kinda busy.","La gente tiene que saber que la carpa roja abrirá pronto, así que estoy algo ocupada.");
 ds_map_add(m,"I'm sorry, sweetie but now I can't, I'm going to do stand up to attract some people.","Lo siento, cariño, ahora no puedo. Voy a hacer un monólogo para atraer a gente.");
 ds_map_add(m,"Hi, can you give me a little of your time? I'm looking for a friend.","Hola, ¿puedes dedicarme un momento? Estoy buscando a un amigo.");
 ds_map_add(m,"Give those pamphlets to people while I get ready.","Reparte esos folletos mientras me preparo.");
 ds_map_add(m,"You should have told me that you like these types of shows. we could one of us here <3.","Deberías haberme dicho que te gustaban este tipo de espectáculos. ¡Podríamos haber montado uno aquí juntas <3!");
 ds_map_add(m,"You can see the place while we prepare all.","Puedes echar un vistazo al lugar mientras lo preparamos todo.");
 ds_map_add(m,"oh You don't have to thank me, oh I almost forgot the circus is still in preparation but there a girl with pink hair near the stands that you might like.","Oh, no tienes que darme las gracias. Ah, casi se me olvida: el circo aún está preparándose, pero hay una chica de pelo rosa cerca de las gradas que quizá te interese.");
 ds_map_add(m,"I'm good , and thank for the information and the other thing hehe.","Estoy bien, y gracias por la información... y por lo otro, jeje.");
 ds_map_add(m,"*whisper* oh god the jokes of this bitch.","*En voz baja* Dios mío, los chistes de esta zorra.");
 ds_map_add(m,"Hi Line, how have you bee-n.","Hola, Line. ¿Cómo te ha ido?");
 ds_map_add(m,"Hi MsHonney.","Hola, señorita Honney.");
 ds_map_add(m,"welcome to the green hills hotel at the moment we do not have rooms available","Bienvenida al hotel Green Hills. Por ahora no tenemos habitaciones disponibles.");
 ds_map_add(m,"Welcome to the green hills hotel at the moment we do not have rooms available.","Bienvenido al hotel Green Hills. En este momento no nos quedan habitaciones libres.");
 ds_map_add(m,"Go to the door on the left she will be waiting for you.","Ve a la puerta de la izquierda; ella te estará esperando.");
 ds_map_add(m,"Wow I never thought that a young girl who looks so innocent would go to see her.","Vaya, nunca habría imaginado que una chica tan joven y de aspecto tan inocente iría a verla.");
 ds_map_add(m,"Oh-sorry i havent sleep lately.","Oh, perdona, últimamente no he dormido.");
 ds_map_add(m,"Geez Line control yourself.","Por Dios, Line, contrólate.");
 ds_map_add(m,"What?","¿Qué?");
 ds_map_add(m,"I love you.","Te quiero.");
 ds_map_add(m,"Mshonney have new workers.","La señora Honney tiene nuevos empleados.");
 ds_map_add(m,"Welcome to the green hills hotel.","Bienvenido al hotel Green Hills.");
 ds_map_add(m,"ok ok just give me a sec","Vale, vale, dame un segundo.");
 ds_map_add(m,"I will sell it and be free again.","Lo venderé y volveré a ser libre.");
 ds_map_add(m,"I escaped from jail but I had no place to go or money, this place is my only option, I must win the golden key.","Me escapé de la cárcel, pero no tenía adónde ir ni dinero. Este lugar es mi única opción; tengo que ganar la llave dorada.");
 ds_map_add(m,"I-I can't here callie, you know I'm shy, there are a lot of people here","N-no puedo aquí, Callie. Ya sabes que soy tímida y hay mucha gente.");
 ds_map_add(m,"But your love, you can take it right here.","Pero puedes demostrarme tu amor aquí mismo.");
 ds_map_add(m,"My children are the best <3 tell him that here it is not so bad, they even pay me to produce milk.","Mis hijos son los mejores <3. Dile que este lugar no está tan mal; hasta me pagan por producir leche.");
 ds_map_add(m,"Oh ok, your kids send you good vibes since they can't come.","Ah, vale. Tus hijos te mandan buenas vibras aunque no puedan venir.");
 ds_map_add(m,"Sorry here just let us say moo.","Lo siento, aquí solo podemos decir «muuu».");
 ds_map_add(m,"Whaaat?.","¿Quééé?");
 ds_map_add(m,"Mooo.","Muuu.");
 ds_map_add(m,"Hey Line come here.","¡Eh, Line, ven aquí!");
 ds_map_add(m,"Yes, she wants me to stay close to her since I am 18 years old and she doesn't want me to go to places that were previously restricted to me on the island.","Sí, quiere que me quede cerca de ella porque acabo de cumplir 18 años y no quiere que vaya a los lugares de la isla que antes tenía prohibidos.");
 ds_map_add(m,"Wait are you the saleswoman's son?","Espera, ¿eres el hijo de la vendedora?");
 ds_map_add(m,"Bye I have to go","Adiós, tengo que irme.");
 ds_map_add(m,"No, but I know that north from here they did the same to a fox girl.","No, pero sé que al norte de aquí le hicieron lo mismo a una chica zorro.");
 ds_map_add(m,"Wait do you know who did this to you?","Espera, ¿sabes quién te hizo esto?");
 ds_map_add(m,"Thanks I have to go.","Gracias, tengo que irme.");
 ds_map_add(m,"Oh do not worry I will take that thing from you.","Ah, no te preocupes, te quitaré eso de encima.");
 ds_map_add(m,"yeah she went to the cultivation of nana leaves.","Sí, se fue a la zona donde cultivan hojas de nana.");
 ds_map_add(m,"Thank you lady unicorn but be careful that cat likes to prank people :c.","Gracias, señora unicornio, pero ten cuidado: a esa gata le gusta gastar bromas :c.");
 ds_map_add(m,"Oh I just got to the town but if I see it I'll let you know <3.","Ah, acabo de llegar al pueblo, pero si la veo te avisaré <3.");
 ds_map_add(m,"Mmm no, and have you seen a blue cat by chance?","Mmm, no. Por cierto, ¿has visto por casualidad a una gata azul?");
 ds_map_add(m,"Hello by chance have you seen someone with wings on their head?","Hola, ¿has visto por casualidad a alguien con alas en la cabeza?");
 ds_map_add(m,"yeah just give use the money","Sí, solo tienen que darnos el dinero.");
 ds_map_add(m,"That is, if they do not return with the money on time you will have to work in the village dairy farm to pay it","Es decir, si no vuelven con el dinero a tiempo, tendrán que trabajar en la granja lechera del pueblo para pagarlo.");
 ds_map_add(m,"We take the money","Nos quedamos con el dinero.");
 ds_map_add(m,"sounds really easy actually","La verdad es que parece bastante fácil.");
 ds_map_add(m,"It's easy, I'll lend you money and you return it to me later with an extra 10%","Es sencillo: te prestaré el dinero y luego me lo devolverás con un 10 % extra.");
 ds_map_add(m,"Oh ok what do we have to do?","Ah, vale. ¿Qué tenemos que hacer?");
 ds_map_add(m,"I don't know Line having money is always good","No sé, Line. Tener dinero siempre viene bien.");
 ds_map_add(m,"Me mmm .. not really","Yo... mmm... no, la verdad.");
 ds_map_add(m,"Hey you look like you need money.","Eh, parece que necesitas dinero.");
 ds_map_add(m,"Great just sign here.","Perfecto, firma aquí.");
 ds_map_add(m,"Amazing, it's great to do deals with you.","¡Increíble! Da gusto hacer negocios contigo.");
 ds_map_add(m,"I gave you 1000 arcs plus 10%, you should give me back 1100.","Te presté 1000 Arcs más un 10 %; deberías devolverme 1100.");
 ds_map_add(m,"No, sorry you will have the money later.","No, lo siento, tendrás el dinero más adelante.");
 ds_map_add(m,"Yes, here is your money.","Sí, aquí tienes tu dinero.");
 ds_map_add(m,"You are going to give my money back?","¿Vas a devolverme el dinero?");
 ds_map_add(m,"Sure just sign here","Claro, firma aquí.");
 ds_map_add(m,"He-hello could you lend me money again?","H-hola, ¿podrías volver a prestarme dinero?");
 ds_map_add(m,"Maybe later.","Quizá más tarde.");
 ds_map_add(m,"Ask for money.","Pedir dinero.");
