 ds_map_add(m,"Do not believe her little girl, she is joking.","No la creas, pequeña. Está bromeando.");
 ds_map_add(m,"Lili!","¡Lili!");
 ds_map_add(m,"That's true, especially someone like Line she is a freak.","Es verdad, sobre todo alguien como Line. Es una rarita.");
 ds_map_add(m,"My mom told me not to talk to strangers.","Mi mamá me dijo que no hablara con desconocidos.");
 ds_map_add(m,"Please help miss traveler.","Por favor, ayúdeme, señorita viajera.");
 ds_map_add(m,"And you fucking inoperative social parasite you should learn how to do your fucking job before you put people in jail-farm.","Y tú, parásito social de mierda que no sirve para nada, aprende a hacer tu puto trabajo antes de mandar a la gente a la granja-prisión.");
 ds_map_add(m,"Could you say hello to my mommy if you go near the jail-farm the children can't go out beyond the town.","¿Podrías saludar a mi mamá si pasas cerca de la granja-prisión? Los niños no podemos salir del pueblo.");
 ds_map_add(m,"Thanks for helping my family.","Gracias por ayudar a mi familia.");
 ds_map_add(m,"Those are weird clothes for an elf, come on in","Qué ropa tan rara para una elfa. Pasa.");
 ds_map_add(m,"Not now, I'm watching that none of these cows attempt a breakout.","Ahora no, estoy vigilando que ninguna de estas vacas intente escaparse.");
