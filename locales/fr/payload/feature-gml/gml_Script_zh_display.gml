var s=string(argument0);
if(!variable_global_exists("zh_display_map"))global.zh_display_map=-1;
if(!ds_exists(global.zh_display_map,ds_type_map)){
 global.zh_display_map=ds_map_create();
 var m=global.zh_display_map;
 ds_map_add(m,"Piercing","Perforant");
 ds_map_add(m,"Cut","Tranchant");
 ds_map_add(m,"Hp","PV");
 ds_map_add(m,"Mp","PM");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Oh là là, Bigg Daddy... J'espère qu'un jour, il me traitera comme sa petite fille.");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","Elle connaissait mon nom, allez savoir comment. Si je la retrouve, je pourrai peut-être comprendre pourquoi elle me connaît.");
 ds_map_add(m,"Ms honney","Mme Honney");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","Ohh <3, Mme Honney est géniale ! Rien qu'en me voyant, elle a compris qui j'étais vraiment. Oh, j'allais oublier : elle m'a aussi aidée à obtenir des renseignements. ");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","Oh, Rynn ! Je me souviens, elle était complètement ivre à la taverne et racontait je ne sais quoi sur l'Empire qui aurait effacé une partie de l'Histoire. Enfin, je n'écoutais pas vraiment : j'étais trop occupée à admirer ses abdos.");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","Oh, je me souviens de cette pauvre petite ! Lili l'a prise pour une gamine et elle a piqué une de ces colères. Ah, pourquoi cette fée me fourre-t-elle toujours dans des histoires pareilles...");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","Alina attend toujours son amie. J'espère qu'elles pourront bientôt se retrouver.");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","C'était une démone très agressive, qui défendait férocement son territoire. Le seul moyen de la battre était de lui aspirer son énergie grâce à mes pouvoirs de succube, héhé. Ça ne me déplairait pas de la revoir, mais Lili me tuerait.");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","Je m'en veux tellement pour Callie. Je l'ai fait tomber amoureuse de moi alors que je voulais seulement coucher avec elle pour tenter l'expérience, et elle veut même me présenter à ses enfants. Parfois, j'aimerais ne pas être à moitié succube. Je fais tellement de mal aux gens.");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","Baina Salasaki... Un rêve devenu réalité ! Même ma mère la connaissait, et j'ai eu la chance de passer un moment avec elle <3. Même si, franchement, j'ai trouvé ça un peu cher.");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","Oh, cette chatte ! À cause d'elle, je suis maintenant curieuse de l'asphyxie érotique. Heureusement que Lili reste toujours près de moi, au cas où ça tournerait mal.");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","Pauvre Pussiel... À cause de moi, elle a dû travailler trois fois plus :c.");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","Lina était furieuse d'avoir perdu contre ce chat-slime. Elle m'a même demandé de l'aider à s'entraîner, alors que je doute que mon style de combat puisse lui servir.");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","Hynoxia... Je crois que c'est la femme qui a vendu le pistolet hypnotique à Lili. Je me demande ce qu'elle a d'autre à vendre.");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","Mon héroïne de Tricotex ! Je n'arrive pas à croire qu'on l'ait retrouvée sur cette île. J'espère pouvoir l'aider à nouveau un jour, mais cette fois dans sa ville <3.");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","C'est Sieki qui dirige toutes les femmes de l'espace VIP du bar. Je me demande comment on arrive à obtenir un poste pareil.");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","Vasuki est arrivée dans cette dimension par hasard. Je l'ai aidée à trouver les failles dimensionnelles pour qu'elle puisse rentrer chez elle. Mais, pour une raison qui m'échappe, elle a décidé de rester ici avec moi. Ça ne me dérange pas vraiment... Je suis peut-être une horrible personne.");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","Comment pourrais-je l'oublier ? Elle allie parfaitement autorité et douceur. J'espère qu'elle trouvera les cigarettes qu'elle aime. Mais si elle n'en trouve pas, on pourrait peut-être se revoir, héhé.");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","Kamiko est exactement comme Lili. La seule différence, c'est qu'elle fait à peu près ma taille. Enfin, elles ne sont pas si semblables : Lili a quand même quelques bons côtés.");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","Elle voulait m'aider à devenir une meilleure succube, mais elle passe presque tout son temps à baiser, alors je la vois à peine. Peut-être qu'elle m'apprend à ne pas perdre mon temps quand on est une succube ? Ah, pourquoi faut-il que tout soit si compliqué !");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","Maruia est une orque très honnête. Elle a tenu parole après que je l'ai battue. Hmm... Si je trouvais un moyen de la faire combattre à nouveau... Non ! Mais à quoi je pense ? Mauvaise idée, dehors, DEHORS !");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","Il est comme moi : nous sommes timides, mais nous avons tous les deux notre petit jardin secret. J'espère qu'il arrivera mieux que moi à sauver les apparences.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","Maman !!! J'aime ma maman !!!");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","Une personne formidable, qui tient énormément au grand capitaine.");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","Faye doit être la personne la plus désagréable que j'aie jamais rencontrée. Heureusement qu'on a fini par coucher ensemble, sinon j'aurais perdu la tête.");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","Bell a une si belle mission. J'espère qu'il réussira à faire repousser davantage de ces fleurs disparues.");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","Lucy est formidable. J'espère que tu ne la décevras pas avec son roman.");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","Mlle Marael m'a montré un aspect des succubes que personne n'avait jamais voulu me révéler. Je lui en suis reconnaissante.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","Lemmy a dit à Lili que ZONE-tam était apparemment un journaliste très connu. Hmm, maintenant que j'y pense, pourquoi Lili et Lemmy s'entendent-ils aussi bien ?");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","Gildfried est génial et il a une bite énorme... Euh, j'en étais où, déjà ?");
 ds_map_add(m,"Dannie perky","Dannie Perky");
 ds_map_add(m,"Dede restrun","Dede Restrun");
 ds_map_add(m,"Danyelle dower","Danyelle Dower");
 ds_map_add(m,"Debu Euler ku","Debu Euler Ku");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","Voici Futaba, ta futanari de confiance :0");
 ds_map_add(m,"Pink Slime","Slime rose");
 ds_map_add(m,"Purple Slime","Slime violet");
 ds_map_add(m,"Orange Slime","Slime orange");
 ds_map_add(m,"Controls","Commandes");
 ds_map_add(m,"Settings","Paramètres");
 ds_map_add(m,"Natural","Naturel");
 ds_map_add(m,"Quest complete.","Quête terminée.");
 ds_map_add(m,"Use Vodka","Utiliser la vodka");
 ds_map_add(m,"Use Ron","Utiliser le rhum");
 ds_map_add(m,"Use Beer","Utiliser la bière");
 ds_map_add(m,"Use Milch","Utiliser le lait fermenté");
 ds_map_add(m,"there no items here yet","Il n'y a encore aucun objet ici.");
 ds_map_add(m,"Fish","Poisson");
 ds_map_add(m,"it is raw we can not eat it like this Lili, maybe it is better to give it to someone else.","Il est cru, on ne peut pas le manger comme ça, Lili. On ferait peut-être mieux de le donner à quelqu'un.");
 ds_map_add(m,"Circus flyers","Prospectus du cirque");
 ds_map_add(m,"I have a lot of pamphlets to deliver, hopefully delivering a few will be enough.","J'ai encore plein de prospectus à distribuer. J'espère qu'en en donnant quelques-uns, ça suffira.");
 ds_map_add(m,"This is my favorite is not that strong <3","C'est mon préféré, il n'est pas si fort <3");
 ds_map_add(m,"Rum","Rhum");
 ds_map_add(m,"My Mother Always say rum is like men, the older the better. Mmmm maybe that is why she is with my father, elves live for a long time.","Ma mère dit toujours que le rhum ressemble aux hommes : plus il vieillit, meilleur il est. Mmmm... C'est peut-être pour ça qu'elle est avec mon père : les elfes vivent très longtemps.");
 ds_map_add(m,"Beer","Bière");
 ds_map_add(m,"Iugg, i do not like beer, the worst thing is that when you go to the bathroom, the pee smells very strong.","Beurk, je n'aime pas la bière. Le pire, c'est qu'après, quand on va aux toilettes, l'urine sent vraiment très fort.");
 ds_map_add(m,"Magic Broom","Balai magique");
 ds_map_add(m,"I love this broom <3, my little feet won't hurt anymore.","J'adore ce balai <3. Mes petits pieds ne me feront plus mal !");
 ds_map_add(m,"Tricotex money","Argent de Tricotex");
 ds_map_add(m,"Sam gave me this money, it is 10 dollars to use in Tricotex. I will keep it, who knows if i ever pass by.","Sam m'a donné cet argent : ce sont 10 dollars utilisables à Tricotex. Je vais le garder, qui sait si je n'y passerai pas un jour.");
 ds_map_add(m,"Autographed photo of Sam","Photo dédicacée de Sam");
 ds_map_add(m,"I still can not believe Sam gave me a picture with his autograph <3.","Je n'arrive toujours pas à croire que Sam m'ait donné une photo avec sa dédicace <3.");
 ds_map_add(m,"BDSM Master/Slave Contract","Contrat BDSM maître/esclave");
 ds_map_add(m,"My contract with Lili, because of my problems I begged her to be my master and help me to practice my succubus powers and force me to try new things <3.","Mon contrat avec Lili. À cause de mes problèmes, je l'ai suppliée de devenir ma maîtresse, de m'aider à développer mes pouvoirs de succube et de me forcer à essayer de nouvelles choses <3.");
 ds_map_add(m,"Raspberry pie","Tarte aux framboises");
 ds_map_add(m,"I am supposed to recognize the scent of this foot and then guide me through the forest to Marael's house.","Je suis censée reconnaître l'odeur de ce pied, puis la suivre à travers la forêt jusqu'à la maison de Marael.");
 ds_map_add(m,"Haigure Gun!","Pistolet Haigure !");
 ds_map_add(m,"This gun makes move in a very vulgar way, Just the thought of people watching me, moving uncontrollably while I make a fool of myself makes me so horny.","Ce pistolet fait bouger le corps de façon très vulgaire. Rien que d'imaginer des gens me regarder me trémousser malgré moi et me ridiculiser, ça m'excite énormément.");
 ds_map_add(m,"Holy Grail","Saint Graal");
 ds_map_add(m,"One of the relics of the islands. I can feel energy emanating from it.","C'est l'une des reliques de l'île. Je peux sentir l'énergie qui s'en dégage.");
 ds_map_add(m,"Crystal sphere","Sphère de cristal");
 ds_map_add(m,"I found this half buried next to some cats, it looks like something valuable, maybe it will be useful for something.","J'ai trouvé ça à moitié enterré près de quelques chats. On dirait quelque chose de précieux. Ça pourrait peut-être servir à quelque chose.");
 ds_map_add(m,"Oniric incense","Encens onirique");
 ds_map_add(m,"This is the best thing in the world! If I use it before I go to sleep I can have lucid dreams of things that happened to me <3.","C'est la meilleure chose au monde ! Si j'en utilise avant de dormir, je peux faire des rêves lucides sur des événements que j'ai vécus <3.");
 ds_map_add(m,"Gilfried briefcase","Mallette de Gilfried");
 ds_map_add(m,"I have to return this briefcase to Gilfried immediately.","Je dois rendre cette mallette à Gilfried immédiatement.");
 ds_map_add(m,"Golden Key","Clé dorée");
 ds_map_add(m,"There is something strange about this key, I feel like it takes my energy somehow.","Cette clé a quelque chose d'étrange. J'ai l'impression qu'elle aspire mon énergie d'une manière ou d'une autre.");
 ds_map_add(m,"Smoosher uniforms","Uniformes Smoosher");
 ds_map_add(m,"The uniform of the Smoosher restaurant smells a little funny.","L'uniforme du restaurant Smoosher sent un peu bizarre.");
 ds_map_add(m,"Aphrodisiac mushroom.","Champignon aphrodisiaque");
 ds_map_add(m,"Moo Premium Milk","Lait Moo Premium");
 ds_map_add(m,"Fura Fura Fruit","Fruit Fura Fura");
 ds_map_add(m,"The fura fura fruit has the effect of creating a penis if eaten by a woman.","Le fruit Fura Fura fait pousser un pénis chez les femmes qui en mangent.");
 ds_map_add(m,"Hea Hea Fruit","Fruit Hea Hea");
 ds_map_add(m,"The hea hea fruit has a very powerful aphrodisiac effect that will make anyone who eats it come into heat.","Le fruit Hea Hea a un effet aphrodisiaque très puissant : quiconque en mange entre en chaleur.");
 ds_map_add(m,"Smuggled fabrics","Tissus de contrebande");
 ds_map_add(m,"I understand there was a convict who wanted to sell this, they ended up taking it from her and reselling it themselves (speaking of irony).","J'ai cru comprendre qu'une détenue voulait vendre ces tissus. On les lui a confisqués, puis ceux qui les avaient saisis les ont revendus eux-mêmes. Quelle ironie !");
 ds_map_add(m,"Sewing machine","Machine à coudre");
 ds_map_add(m,"Blue crystal key","Clé de cristal bleue");
 ds_map_add(m,"It is a key that was found inside a strange slime.","Une clé trouvée à l'intérieur d'un slime étrange.");
 ds_map_add(m,"Purple crystal key","Clé de cristal violette");
 ds_map_add(m,"Pink crystal key","Clé de cristal rose");
 ds_map_add(m,"Cum jar","Pot de sperme");
 ds_map_add(m,"Ñom yum yum it looks delicious I will let it ripen a bit before eating <3.","Miam miam, ça a l'air délicieux ! Je vais le laisser mûrir encore un peu avant de le manger <3.");
 ds_map_add(m,"Elf Gloves","Gants elfiques");
 ds_map_add(m,"Elf Boots","Bottes elfiques");
 ds_map_add(m,"Elf Leotard","Combinaison elfique");
 ds_map_add(m,"Elf Tank Top","Débardeur elfique");
 ds_map_add(m,"Elf Tights","Collants elfiques");
 ds_map_add(m,"Elf Panties","Culotte elfique");
 ds_map_add(m,"Limbo Leotard","Combinaison du Limbo");
 ds_map_add(m,"Limbo Boots","Bottes du Limbo");
 ds_map_add(m,"Cow Bras","Soutien-gorge de vache");
 ds_map_add(m,"Cow Stockings","Bas de vache");
 ds_map_add(m,"Cow Bell","Clochette de vache");
 ds_map_add(m,"Cow Panties","Culotte de vache");
 ds_map_add(m,"OH Bunny Heels","Talons de bunny girl OH");
 ds_map_add(m,"OH Bunny Tights","Collants de bunny girl OH");
 ds_map_add(m,"OH Bunny Top","Haut de bunny girl OH");
 ds_map_add(m,"OH Bunny Ears","Oreilles de bunny girl OH");
 ds_map_add(m,"Face Mask","Masque");
 ds_map_add(m,"Cat Ears","Oreilles de chat");
 ds_map_add(m,"Knight Chain Mail","Cotte de mailles de chevalier");
 ds_map_add(m,"Knight Boots","Bottes de chevalier");
 ds_map_add(m,"Knight Gloves","Gants de chevalier");
 ds_map_add(m,"The Perverted Coat","Le manteau du pervers");
 ds_map_add(m,"Haigure Leotard","Combinaison Haigure");
 ds_map_add(m,"Limbo Gloves","Gants du Limbo");
 ds_map_add(m,"Smoosher-T-Shirt","T-shirt Smoosher");
 ds_map_add(m,"Smoosher Shorts","Short Smoosher");
 ds_map_add(m,"Dark Greaves","Jambières sombres");
 ds_map_add(m,"Dark Tiara","Diadème sombre");
 ds_map_add(m,"FurrHead","Tête de furry");
 ds_map_add(m,"FurrTop","Haut de furry");
 ds_map_add(m,"FurrPants","Pantalon de furry");
 ds_map_add(m,"FurrBoots","Bottes de furry");
 ds_map_add(m,"Nun Hat","Coiffe de nonne");
 ds_map_add(m,"Nun Dress","Robe de nonne");
 ds_map_add(m,"Nun Socks","Chaussettes de nonne");
 ds_map_add(m,"Nun Boots","Bottes de nonne");
 ds_map_add(m,"Pelletclad Blade","Lame cuirassée");
 ds_map_add(m,"Place Holder Quest","Quête provisoire");
 ds_map_add(m,"Finally, you muster the courage to embark on an adventure with your fairy familiar to find and bring back your childhood best friend.","Enfin, tu trouves le courage de partir à l'aventure avec ta fée familière pour retrouver et ramener ton amie d'enfance, ta meilleure amie.");
 ds_map_add(m,"Check the cat woman's shop; there might be something that interests you.","Va voir la boutique de la femme-chat ; tu y trouveras peut-être quelque chose qui t'intéresse.");
 ds_map_add(m,"The cat woman who runs the shop is somewhat grumpy because she hasn't had the chance to eat lunch.","La femme-chat qui tient la boutique est d'assez mauvaise humeur : elle n'a pas encore pu déjeuner.");
 ds_map_add(m,"You managed to read the sinful thoughts of the fisherman. Perhaps this is your chance to explore your powers.","Tu as réussi à lire les pensées coupables du pêcheur. C'est peut-être l'occasion d'explorer tes pouvoirs.");
 ds_map_add(m,"Lili pushes you to be more proactive in training your succubus powers, so she sends you to try to seduce the cat woman who runs the shop. It should be easier since you know her.","Lili te pousse à t'entraîner plus sérieusement à utiliser tes pouvoirs de succube. Elle t'envoie donc essayer de séduire la femme-chat qui tient la boutique. Ça devrait être plus facile puisque tu la connais déjà.");
 ds_map_add(m,"There is a high-rank demon who has been stealing alcohol shipments. You decide to find and defeat her to see if you can get information about Ava.","Une démone de haut rang vole des cargaisons d'alcool. Tu décides de la retrouver et de la vaincre pour tenter d'obtenir des informations sur Ava.");
 ds_map_add(m,"You're very lucky! You recognized one of the women who appeared in your mother's XXX magazines! She says she'll give you a special service for old times' sake.","Quelle chance ! Tu reconnais l'une des femmes qui apparaissaient dans les magazines porno XXX de ta mère ! Pour les bons vieux souvenirs, elle te promet un service spécial.");
 ds_map_add(m,"You found a woman with violet pigtails at the corner of the bar. She says she can lend you money, but you must pay her back with an additional ten percent.","Au fond du bar, tu as rencontré une femme aux couettes violettes. Elle propose de te prêter de l'argent, à condition que tu lui rembourses avec dix pour cent d'intérêts.");
 ds_map_add(m,"There's a cat woman playing very mean pranks on the villagers, and they're blaming Callie's daughter. Find the real culprit and save Callie's daughter!","Une femme-chat joue de très mauvais tours aux villageois, qui accusent la fille de Callie. Trouve la véritable coupable et sauve la fille de Callie !");
 ds_map_add(m,"The plant woman from the shop told you she's very thirsty, and Lili suggested buying her beer to see if she'll give you discounts while drunk.","La femme-plante de la boutique t'a confié qu'elle mourait de soif. Lili te suggère de lui acheter de la bière pour voir si, une fois ivre, elle t'accordera une réduction.");
 ds_map_add(m,"A dragon woman fell from the sky among the prisoners and seems to be fighting to prevent a crystal from being stolen. Lili suggests we help her; maybe they'll reward us with something valuable.","Une femme-dragon est tombée du ciel au milieu des prisonniers. Elle semble se battre pour empêcher qu'on lui vole un cristal. Lili propose de l'aider : on pourrait peut-être recevoir une récompense de valeur.");
 ds_map_add(m,"There's a strange woman with pink hair hiding in a corner of the circus. Find out why people are talking about her.","Une étrange femme aux cheveux roses se cache dans un coin du cirque. Découvre pourquoi tout le monde parle d'elle.");
 ds_map_add(m,"You found your favorite heroine! Sam, the protector of Tricotex. Prove that you have what it takes to embark on a capture mission with her.","Tu as retrouvé ton héroïne préférée ! Sam, la protectrice de Tricotex. Prouve que tu as l'étoffe nécessaire pour partir avec elle en mission de capture.");
 ds_map_add(m,"Someone is impersonating a knight of Elira to scam people. Catch them and be the heroine you always wanted to be!","Quelqu'un se fait passer pour un chevalier d'Elira afin d'escroquer les gens. Attrape cette personne et deviens l'héroïne que tu as toujours voulu être !");
 ds_map_add(m,"Kristoff, a VIP customer at the bar, is very angry and asks if you can buy him some premium cigarettes to help him calm down.","Kristoff, un client VIP du bar, est furieux. Il te demande si tu peux lui acheter des cigarettes haut de gamme pour l'aider à se calmer.");
 ds_map_add(m,"The hotel secretary informs you that you've caught the attention of a woman who will be waiting for you on the top floor of the hotel. Hmm, what could she want? It might be important.","La secrétaire de l'hôtel t'informe qu'une femme a remarqué ta présence et t'attendra au dernier étage. Hmm, que peut-elle bien te vouloir ? Ça pourrait être important.");
 ds_map_add(m,"You've become a minion of a seemingly powerful individual! They order you to bring the dimensional fracture, which looks like a floating crystal, to leave this dimension.","Te voilà devenu le larbin d'une personne qui semble très puissante ! Elle t'ordonne de lui apporter la fracture dimensionnelle, qui ressemble à un cristal flottant, afin de quitter cette dimension.");
 ds_map_add(m,"There was a collapse in the cave, leaving many miners trapped. Wait until the knight of Elira clears the passage.","Un éboulement a eu lieu dans la grotte et de nombreux mineurs sont coincés. Attends que le chevalier d'Elira dégage le passage.");
 ds_map_add(m,"There are some rumors of strange sounds coming from the Silent Forest at night. What could it be?","Des rumeurs parlent de bruits étranges provenant de la Forêt silencieuse pendant la nuit. Qu'est-ce que ça peut bien être ?");
 ds_map_add(m,"An Onahole is desperate to buy a boat and is selling her body to do so. As an act of charity, help her.","Une poupée sexuelle veut désespérément acheter un bateau et vend son corps pour y parvenir. Fais preuve de charité et aide-la.");
 ds_map_add(m,"Ivy, a honey slime, recognizes you as an adventurer who helps people and asks if you can help her find a part of herself that hasn't returned.","Ivy, un slime au miel, t'a reconnu comme une aventurière qui aide les gens. Elle te demande de l'aider à retrouver une partie d'elle-même qui n'est toujours pas revenue.");
 ds_map_add(m,"You heard the Grand Captain of the Elira Guards arguing with a woman about the ineptitude of the knights. Maybe if you help them, they can assist you in your quest.","Tu as entendu le grand capitaine de la garde d'Elira se disputer avec une femme au sujet de l'incompétence des chevaliers. Si tu les aides, ils pourront peut-être te donner un coup de main dans ta quête.");
 ds_map_add(m,"You encountered Faye, a space-dimensional traveler trapped in your dimension. You decided to help her because you felt sorry for her.","Tu as rencontré Faye, une voyageuse entre les dimensions spatiales, coincée dans la tienne. Tu décides de l'aider parce qu'elle te fait de la peine.");
 ds_map_add(m,"Vasuki tells you that something bad is happening at the mushroom house in the magenta swamp. Upon investigating, it seems that there may be human trafficking and drug activities occurring there.","Vasuki t'apprend qu'il se passe quelque chose de louche dans la maison-champignon du marais magenta. Après enquête, il semblerait qu'il y ait du trafic d'êtres humains et de la drogue sur place.");
 ds_map_add(m,"You found someone smelling the flowers, but as soon as you spoke to them, they attacked you. Find out what's really going on!","Tu as aperçu quelqu'un en train de sentir les fleurs, mais cette personne t'a attaquée dès que tu lui as parlé. Découvre ce qui se passe vraiment !");
 ds_map_add(m,"There's something about Marael that doesn't quite convince you. Look into what she's really hiding.","Quelque chose chez Marael ne te convainc pas tout à fait. Enquête pour découvrir ce qu'elle cache réellement.");
 ds_map_add(m,"A letter addressed to Marael gives you clues that a woman named Willow also contacted Ava. Look for her to gather more information.","Une lettre adressée à Marael révèle qu'une femme nommée Willow a également pris contact avec Ava. Retrouve-la pour obtenir davantage d'informations.");
 ds_map_add(m,"There's a bard woman looking for an adventurer to inspire her. Show her that you're a worthy adventurer capable of inspiring others!","Une femme barde cherche une aventurière qui puisse lui inspirer une chanson. Montre-lui que tu es une aventurière digne de ce nom, capable d'inspirer les autres !");
 ds_map_add(m,"After being attacked by a pervert who opened his leather coat and showed you everything, something awakened inside of you.","Après avoir été agressée par un pervers qui a ouvert son manteau en cuir pour tout te montrer, quelque chose s'est éveillé en toi.");
 ds_map_add(m,"The island is cordoned off because someone stole the relics from the church. As part of the deal to stay on the island, you agree to help the knights of Elira search for the relics.","L'île est bouclée parce que quelqu'un a volé les reliques de l'église. En échange du droit de rester sur l'île, tu acceptes d'aider les chevaliers d'Elira à retrouver les reliques.");
 ds_map_add(m,"An Onahole stuck to the wall in the VIP area of the bar tells you that if you buy her entire outfit, she'll give you a rimjob!","Dans l’espace VIP du bar, une poupée sexuelle fixée au mur te promet un anulingus si tu lui achètes toute sa tenue !");
 ds_map_add(m,"Lili says you're very stinky and need a bath.","Lili dit que tu pues vraiment et que tu as besoin d'un bain.");
 ds_map_add(m,"The librarian is lost, and no one knows where she is. Look for her, and perhaps you'll find more information about the people who go missing on the island.","La bibliothécaire a disparu et personne ne sait où elle se trouve. Pars à sa recherche : tu découvriras peut-être davantage de choses sur les disparitions sur l'île.");
 ds_map_add(m,"Gildfried, a businessman on vacation on the island, unfortunately lost his briefcase, which is very important to him.","Gildfried, un homme d'affaires en vacances sur l'île, a malheureusement perdu sa mallette, qui compte énormément pour lui.");
 ds_map_add(m,"Lemmy, a green monster outside an automated carriage, talks to Lili and asks for help because his mistress is having trouble.","Lemmy, un monstre vert qui se trouve près d'une calèche automatisée, parle à Lili et demande de l'aide : sa maîtresse a des ennuis.");
 ds_map_add(m,"Sakura is working at the renowned fast food restaurant Smooshers! She asks for your help in searching for the lost uniforms.","Sakura travaille dans le célèbre fast-food Smooshers ! Elle te demande de l'aider à retrouver les uniformes disparus.");
 ds_map_add(m,"One of Vasera's clones has gained autonomy. Vasera will go search for it and neutralize it. She advises you to kill it if you encounter it.","L'un des clones de Vasera a acquis sa propre volonté. Vasera va partir à sa recherche pour le neutraliser. Elle te conseille de le tuer si tu le croises.");
 ds_map_add(m,"Sieki got angry with you because even though she already paid the debt to MsHonney, you're still in the VIP area. Now you follow her orders to avoid making her angrier.","Sieki s'est mise en colère contre toi : elle a déjà remboursé ta dette auprès de Mme Honney, mais tu traînes encore dans l'espace VIP. Tu obéis désormais à ses ordres pour éviter de l'énerver davantage.");
 ds_map_add(m,"The farmer confesses that she would like to work with less clothing. How could you help her work more comfortably?","La fermière t'avoue qu'elle aimerait travailler avec moins de vêtements. Comment pourrais-tu l'aider à travailler plus confortablement ?");
 ds_map_add(m,"The fortune teller confessed to you that she would like to have a red crystal orb because with it she could see her own future.","La voyante t'a confié qu'elle aimerait posséder un orbe de cristal rouge, car elle pourrait ainsi voir son propre avenir.");
 ds_map_add(m,"The water nymph who works at the bar is looking for love but is insecure because she doesn't know if people approach her for the beer or if they genuinely want something with her.","La nymphe aquatique qui travaille au bar cherche l'amour, mais manque d'assurance : elle ne sait pas si les gens l'approchent pour sa bière ou s'ils veulent vraiment quelque chose avec elle.");
 ds_map_add(m,"Accidentally, you ruin Naoki's concoction just as he's entering mating season, so you decide to help him.","Tu gâches accidentellement la préparation de Naoki juste au moment où il entre dans sa saison des amours. Tu décides donc de lui venir en aide.");
 ds_map_add(m,"Lucy the bard is having trouble with an Onahole, so you decide to help her with whatever she needs.","Lucy, la barde, a des ennuis avec une poupée sexuelle. Tu décides de l’aider comme elle en aura besoin.");
 ds_map_add(m,"There are portals for self-satisfaction in the VIP area of the bar, but a witch won't let you use them.","Il y a des portails destinés au plaisir solitaire dans l'espace VIP du bar, mais une sorcière refuse de te laisser les utiliser.");
 ds_map_add(m,"Sieki has a big problem and makes you a deal you can't refuse: you just have to attend to the clients in the VIP area while she's away, and you'll become a VIP customer.","Sieki a un gros problème et te propose un marché impossible à refuser : il te suffit de t'occuper des clients de l'espace VIP pendant son absence, et tu deviendras toi-même cliente VIP.");
 ds_map_add(m,"A hospital robot offers anal cleaning services for just three thousand Arcs. It's not a bad idea to keep clean every now and then.","Un robot de l'hôpital propose un nettoyage anal pour seulement 3 000 Arcs. Ce n'est pas une mauvaise idée de rester propre de temps en temps.");
 ds_map_add(m,"A story you read in the library seems strange to you, so you decide to look for more information about it.","Une histoire que tu as lue à la bibliothèque te semble étrange. Tu décides donc de chercher davantage d'informations à son sujet.");
 ds_map_add(m,"There's a guy offering his services to make fursuits, which catches your attention, so you decide to save up for one.","Un homme propose ses services pour fabriquer des costumes de furry. L'idée t'intéresse et tu décides d'économiser pour t'en offrir un.");
 ds_map_add(m,"There's an Onahole that has the same tone as you, which strangely excites you.","Il existe une poupée sexuelle dont la teinte est exactement la même que la tienne. Pour une raison étrange, ça t’excite.");
 ds_map_add(m,"In a nightclub, you find two gothic girls with big butts dancing, something you can't let pass in your life.","Dans une boîte de nuit, tu découvres deux filles gothiques aux grosses fesses en train de danser. Impossible de laisser passer une occasion pareille !");
 ds_map_add(m,"Upon entering the usually closed public restroom, you find an idol vomiting, with many people screaming and demanding the show. What could be happening?","En entrant dans les toilettes publiques, d'habitude fermées, tu découvres une idole en train de vomir. De nombreuses personnes crient et réclament le spectacle. Que se passe-t-il ?");
 ds_map_add(m,"There is a proliferation of slimes attacking and kidnapping women. Do your best to help and get to the bottom of this!","Les slimes se multiplient et attaquent des femmes pour les enlever. Fais de ton mieux pour les aider et découvrir ce qui se trame !");
 ds_map_add(m,"A being living in the pond enters Line's mind and psychologically strips her bare with questions she's not prepared to hear or face.","Un être vivant dans l'étang pénètre dans l'esprit de Line et la met psychologiquement à nu avec des questions auxquelles elle n'est pas prête à répondre ni à faire face.");
 ds_map_add(m,"You don't know what's happening; you have mental gaps, and days and nights seem to pass in seconds.","Tu ne comprends pas ce qui t'arrive : tu as des trous de mémoire et les jours comme les nuits semblent défiler en quelques secondes.");
 ds_map_add(m,"You have committed serious mistakes that haunt you at night, so you decide to confess to expiate your sins.","Tu as commis de graves erreurs qui te hantent la nuit. Tu décides donc de te confesser pour expier tes péchés.");
 ds_map_add(m,"Callie invites you to meet her family, which seems more serious than what you're looking for, but it would be rude not to go.","Callie t'invite à rencontrer sa famille. Ça semble plus sérieux que ce que tu recherches, mais ce serait impoli de refuser.");
 ds_map_add(m,"You found a place that can serve you for sleeping while you investigate the island.","Tu as trouvé un endroit où dormir pendant que tu enquêtes sur l'île.");
 ds_map_add(m,"You need more power, so you beg Marael to help you unlock your succubus powers.","Tu as besoin de plus de puissance. Tu supplies donc Marael de t'aider à libérer tes pouvoirs de succube.");
 ds_map_add(m,"The thieves on the island aren't just any criminals; they were actually stealing to maintain an orphanage, without which everything would collapse.","Les voleurs de l'île ne sont pas de simples criminels : ils volaient en réalité pour financer un orphelinat, sans lequel tout s'effondrerait.");
 ds_map_add(m,"You met Futaba your trusted futanari in the forest, what could she be doing?","Tu as rencontré Futaba, ta futanari de confiance, dans la forêt. Mais qu'est-ce qu'elle peut bien y faire ?");
 ds_map_add(m,"The barn is very busy due to the issues happening on the island. Help them however you can so that the barn can open.","La grange est débordée à cause des problèmes qui secouent l'île. Aide-les autant que possible pour qu'ils puissent rouvrir la grange.");
 ds_map_add(m,"Rynn is frustrated because the last fight with you didn't end, so she challenges you to a beer drinking duel.","Rynn est frustrée parce que votre dernier combat est resté inachevé. Elle te défie donc à un concours de bière.");
 ds_map_add(m,"Lili is angry with Line because she believes Line is completely ignorant about sex, and challenges her to a competition to see who is the better onahole.","Lili est furieuse contre Line, car elle la croit totalement ignorante en matière de sexe. Elle la défie à un concours pour savoir laquelle est la meilleure poupée sexuelle.");
 ds_map_add(m,"The milk on this island has very strange properties.","Le lait de cette île possède des propriétés très étranges.");
 ds_map_add(m,"A fat ugly bastard bothering Rynn at the bar he leaves but you can't stop thinking about him.","Un gros salaud moche qui embêtait Rynn au bar est parti, mais tu n'arrives pas à arrêter de penser à lui.");
