 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","この子がフタバ、頼れるフタナリだよ :0");
 ds_map_add(m,"Pink Slime","ピンクスライム");
 ds_map_add(m,"Purple Slime","パープルスライム");
