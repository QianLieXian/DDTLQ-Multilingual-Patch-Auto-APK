 ds_map_add(m,"Cuervo","쿠에르보");
 ds_map_add(m,"Enigma","에니그마");
 ds_map_add(m,"Moshy","모시");
 ds_map_add(m,"Sheepy","쉬피");
 ds_map_add(m,"Katerine","캐서린");
 ds_map_add(m,"Lima","리마");
 ds_map_add(m,"Carrot","캐럿");
 ds_map_add(m,"Lizzy","리지");
 ds_map_add(m,"Mire","미어");
 ds_map_add(m,"Coco","코코");
 ds_map_add(m,"Leafy","리피");
 ds_map_add(m,"Mara","마라");
 ds_map_add(m,"Charity","채리티");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","어쩐지 그녀는 내 이름을 알고 있었어. 그녀를 찾으면 왜 나를 아는지 더 알아낼 수 있을지도 몰라.");
 ds_map_add(m,"Ms honney","허니 부인");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","아아<3, 허니 부인은 정말 최고야. 날 한 번 보기만 하고도 진짜 내 모습을 알아봤어. 아, 정보도 알아봐 주셨지. 깜빡할 뻔했네.");
 ds_map_add(m,"Rynn Draken","린 드레이큰");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","아, 린! 선술집에서 엄청 취해서 제국이 역사의 일부를 지웠다느니 뭐라느니 횡설수설하던 게 기억나. 뭐, 난 별로 귀 기울이지 않았어. 복근 구경하느라 정신이 팔렸거든.");
 ds_map_add(m,"Star","스타");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","아, 이 불쌍한 키 작은 아가씨 기억난다. 릴리가 어린애로 착각했더니 화가 폭발했지. 아아, 이 요정은 왜 맨날 날 곤란하게 만드는 거야…");
 ds_map_add(m,"Alina","알리나");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","알리나는 아직 친구를 기다리고 있어. 부디 곧 만날 수 있으면 좋겠네.");
 ds_map_add(m,"Siness","시네스");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","그녀는 공격적이고 영역 의식이 아주 강한 악마였어. 이기는 방법은 서큐버스의 힘으로 그녀의 에너지를 빨아들이는 것뿐이었지. 헤헤. 다시 만나도 싫진 않겠지만, 릴리가 날 죽이려 들 거야.");
 ds_map_add(m,"Callie","캘리");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","캘리한테는 정말 미안해. 난 그저 경험 삼아 함께 있고 싶었을 뿐인데 그녀를 사랑에 빠지게 했어. 이제는 자기 아이들에게 나를 소개하고 싶어 하기까지 해. 가끔은 내가 반쪽짜리 서큐버스가 아니었으면 좋겠어. 난 사람들에게 너무 큰 상처를 줘.");
 ds_map_add(m,"Baina Salasaki","베이나 살라사키");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","베이나 살라사키, 내 인생의 꿈 같은 사람이야. 엄마도 그녀를 알고 있었는데, 내가 그녀와 함께하게 되다니<3. 그래도 가격은 좀 비싸긴 했어.");
 ds_map_add(m,"Melina","멜리나");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","아, 이 고양이! 이 여자 때문에 에로틱 질식 플레이에 호기심이 생겨 버렸어. 무슨 일이 생기면 늘 곁에 릴리가 있어서 다행이야.");
 ds_map_add(m,"Pussiel","푸시엘");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","불쌍한 푸시엘. 나 때문에 일이 세 배나 많아졌어 :c.");
 ds_map_add(m,"Lina","리나");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","그 슬라임 고양이한테 지고 리나는 엄청 화가 났어. 내 전투 방식이 도움이 될 것 같진 않은데도 나한테 훈련을 도와 달라고 했지.");
 ds_map_add(m,"Hynoxia","하이녹시아");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","하이녹시아, 릴리에게 최면총을 판 여자가 바로 그녀인 것 같아. 다른 건 또 뭘 팔고 있을까?");
 ds_map_add(m,"Sam","샘");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","트리코텍스의 나의 영웅! 섬에서 샘을 찾게 될 줄은 정말 몰랐어. 언젠가 다시 도와줄 수 있으면 좋겠어. 이번엔 그녀의 도시에서 말이야<3.");
 ds_map_add(m,"Sieki","시에키");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","술집 VIP 구역의 여자들을 모두 관리하는 사람이 바로 시에키야. 어떻게 그런 자리에 오르게 된 걸까?");
 ds_map_add(m,"Elena","엘레나");
 ds_map_add(m,"Vasuki","바수키");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","바수키는 우연히 이 차원에 오게 됐어. 고향으로 돌아갈 수 있도록 차원 균열을 찾는 걸 도와줬지. 그런데 어쩐 일인지 여기 남아서 나와 함께 있기로 했어. 사실 난 별로 싫지 않아. 어쩌면 내가 정말 못된 사람일지도 몰라.");
 ds_map_add(m,"Kristoff","크리스토프");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","그녀를 어떻게 잊겠어? 지배적인 면과 섬세함이 완벽하게 어우러져 있어. 그녀가 좋아하는 담배를 찾았으면 좋겠어. 못 찾는다면… 헤헤, 다시 만날 수도 있겠지.");
 ds_map_add(m,"Kamiko","카미코");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","카미코는 릴리와 똑같아. 다른 점이라면 내 키만 하다는 것뿐이지. 음, 완전히 똑같진 않네. 릴리에게도 좋은 구석은 있으니까.");
 ds_map_add(m,"Choco","초코");
 ds_map_add(m,"Sakura","사쿠라");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","그녀는 내가 더 나은 서큐버스가 되도록 도와주고 싶어 해. 하지만 대부분의 시간을 섹스하면서 보내서 거의 만나지도 못하지. 어쩌면 서큐버스답게 시간을 낭비하지 말라고 가르치는 걸까? 아아, 왜 모든 게 이렇게 복잡한 거야!");
 ds_map_add(m,"Maruia","마루이아");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","마루이아는 정말 정직한 오크야. 싸움에서 내가 이긴 뒤에도 약속을 지켰거든. 으음, 어떻게든 다시 싸우게 만들면… 아니, 내가 무슨 생각을! 나쁜 생각아, 나가! 당장 나가!");
 ds_map_add(m,"Naoki","나오키");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","그는 나와 똑같아. 우리 둘 다 수줍음이 많지만, 숨겨 둔 면도 있지. 적어도 나보다는 겉모습을 잘 유지했으면 좋겠어.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","엄마!!! 우리 엄마 사랑해!!!");
 ds_map_add(m,"Alura Fey","알루라 페이");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","대장님을 무척 아끼는 정말 좋은 사람이야.");
 ds_map_add(m,"Faye","페이");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","페이는 내가 만난 사람 중 가장 불쾌한 사람이었을 거야. 적어도 결국 같이 섹스하긴 했으니 망정이지. 안 그랬으면 미쳐 버렸을 거야.");
 ds_map_add(m,"Bell","벨");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","벨의 사명은 정말 아름다워. 멸종한 이 꽃들을 더 많이 피워 낼 수 있으면 좋겠어.");
 ds_map_add(m,"Viola","비올라");
 ds_map_add(m,"Lucy Monroe","루시 먼로");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","루시는 정말 멋진 사람이야. 그녀의 소설과 관련해서 실망시키지 않았으면 좋겠어.");
 ds_map_add(m,"Marael","마라엘");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","마라엘 부인은 그동안 아무도 내게 보여 주려 하지 않았던 서큐버스의 한 면을 보여 줬어. 그 점이 정말 고마워.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","레미는 릴리에게 ZONE-tam이 유명한 뉴스 기자라고 말했어. 음, 생각해 보니 릴리와 레미는 왜 그렇게 잘 맞는 걸까?");
 ds_map_add(m,"Gildfried","길드프리드");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","길드프리드는 정말 대단하고 좆도 엄청 커… 내가 무슨 말을 하고 있었더라?");
 ds_map_add(m,"Aqua","아쿠아");
 ds_map_add(m,"Cassidy","캐시디");
 ds_map_add(m,"Destiny","운명");
 ds_map_add(m,"Noel","노엘");
