 ds_map_add(m,"Line ask the bartender if she knows where we can buy premium cigarettes.","라인, 바텐더에게 고급 담배를 어디서 살 수 있는지 아는지 물어봐.");
 ds_map_add(m,"OHh, Hi, mmm  I Have to go now, ehh sorry.","아, 안녕. 음, 이제 가 봐야 해. 어, 미안.");
 ds_map_add(m,"To the lady over there.","저기 있는 여자분께요.");
 ds_map_add(m,"What! to whom?","뭐라고요! 누구에게요?");
