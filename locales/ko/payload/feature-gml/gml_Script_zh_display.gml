 ds_map_add(m,"A wena :D.","좋네 :D.");
 ds_map_add(m,"Wena cochino larry.","야, 이 변태 래리.");
 ds_map_add(m,"Why is this girl taking so long?","이 여자애는 왜 이렇게 오래 걸리지?");
 ds_map_add(m,"Oh, cutie I can upgrade a block of hearts every so often on the grid in addition to doing some cut damage.","귀염둥이, 나도 가끔 격자판의 하트 블록 하나를 강화할 수 있어. 베기 피해도 조금 줄 수 있고.");
 ds_map_add(m,"No but, could you tell me again how you fight?","아니, 그게 아니라 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"No right now actually.","아니, 지금은 안 돼.");
 ds_map_add(m,"Yes Big sis <3!","네, 언니 <3!");
 ds_map_add(m,"You want a little break cutie","잠깐 쉬고 싶어, 귀염둥이?");
 ds_map_add(m,"No thanks, could you tell me again how you fight?","괜찮아요, 고마워요. 전투 방식이 어떤지 다시 설명해 주실래요?");
 ds_map_add(m,"Sorry big sis not rigt now.","미안해요, 언니. 지금은 안 돼요.");
 ds_map_add(m,"Yes, Big Sis.","네, 언니.");
 ds_map_add(m,"Do you want me to help you in battles?","전투할 때 내가 도와줄까?");
 ds_map_add(m,"So do your best Line <3.","그러니까 최선을 다해, 라인 <3.");
 ds_map_add(m,"A training battle will do.","훈련 전투면 돼.");
 ds_map_add(m,"First of all I need to see your current status as a succubus in a more precise way.","우선 네가 지금 서큐버스로서 어느 정도인지 좀 더 정확히 알아야겠어.");
 ds_map_add(m,"So how do we start?","그럼 어떻게 시작하지?");
 ds_map_add(m,"Well said! <3","말 잘했어! <3");
 ds_map_add(m,"I know .. I guess it will hurt my mother if I never get better as a succubus.","알아…… 서큐버스로서 계속 발전하지 못하면 엄마가 속상해하실 거야.");
 ds_map_add(m,"But line, beautiful, it is your culture we gain power and energy having sex, you must start thinking about yourself.","하지만 라인, 예쁜아. 우리 종족은 성관계로 힘과 에너지를 얻는 게 관습이야. 이제 너 자신도 생각해야지.");
 ds_map_add(m,"And my father is a very respectable elf. What would he think of me, I don't want to hurt him?","그리고 아버지는 아주 존경받는 엘프야. 아버지가 날 어떻게 생각하시겠어? 상처 드리고 싶지 않아.");
 ds_map_add(m,"But I was always such a shy girl, that I never asked my mother to teach me.","하지만 난 늘 너무 수줍음이 많아서 엄마한테 가르쳐 달라고 한 번도 부탁하지 못했어.");
 ds_map_add(m,"I ... I want to be a better succubus","나…… 나 더 나은 서큐버스가 되고 싶어.");
 ds_map_add(m,"hey quiet fairy, I just want to teach your friend some tricks so that she is a little more prepared for the world.","이봐, 조용한 요정. 난 네 친구가 세상에 좀 더 잘 대비할 수 있도록 요령 몇 가지를 가르쳐 주려는 것뿐이야.");
 ds_map_add(m,"Hey! What's wrong? Line is a great succubus!","이봐! 왜 그래? 라인은 훌륭한 서큐버스라고!");
 ds_map_add(m,"You are a succubus but I see that you have a long way to go, your power is minimal compared to others.","넌 서큐버스지만 아직 갈 길이 멀어. 다른 서큐버스에 비하면 네 힘은 아주 미약하거든.");
 ds_map_add(m,"Help me with what?","뭘 도와준다는 거야?");
 ds_map_add(m,"I made this little meeting to help you.","널 도와주려고 이 작은 만남을 마련했어.");
 ds_map_add(m,"Why did you want to see me?","왜 날 만나고 싶었던 거야?");
 ds_map_add(m,"Mmm?( this woman does not give me confidence )","음? (이 여자는 왠지 믿음이 안 가는데.)");
 ds_map_add(m,"If only you knew what I was my little fairy.","내가 어떤 존재였는지 알면 놀랄걸, 꼬마 요정아.");
 ds_map_add(m,"How do you know who Line is and what she is?","라인이 누군지, 어떤 존재인지 어떻게 아는 거야?");
 ds_map_add(m,"Oh.. thanks hehe.","아…… 고마워, 헤헤.");
 ds_map_add(m,"Yes, and you are a cute little half succubus you right Line.","그래, 넌 귀여운 하프 서큐버스잖아. 그렇지, 라인?");
 ds_map_add(m,"Lili","릴리");
 ds_map_add(m,"E-excuse me, did you leave a message to the receptionist for me?","저, 실례합니다. 접수원에게 저를 찾는 사람이 있다고 전해 달라고 하셨나요?");
 ds_map_add(m,"Come on Line try again I need to know better your current state I know you can do more.","자, 라인. 다시 해 봐. 네 현재 상태를 더 정확히 알아야 해. 네가 더 잘할 수 있다는 걸 알고 있어.");
 ds_map_add(m,"Just give me one second.","잠깐만 기다려 줘.");
 ds_map_add(m,"Mmmm... Hehe ok big Sis I will do my best <3","으음…… 헤헤, 알겠어요, 언니. 최선을 다할게요 <3");
 ds_map_add(m,"Great Line you already know something about the case more than I do find them and I'll give you a prize Tehehehe.","잘했어, 라인. 이제 네가 사건에 대해 나보다 더 많이 알고 있네. 그것들을 찾아와. 그러면 상을 줄게. 헤헤헤.");
 ds_map_add(m,"I already know that story.","그 이야기는 이미 알아.");
 ds_map_add(m,"A Slime Cat is apparently stealing it.","슬라임 고양이 한 마리가 훔쳐 가는 모양이야.");
 ds_map_add(m,"Well, if you want me to help Line become a better succubus, first help me recover the clothes from the restaurant.","좋아. 라인을 더 나은 서큐버스로 만들어 주길 바란다면, 먼저 식당에서 옷을 되찾아 와.");
 ds_map_add(m,"The truth is that I do know but I hope you don't do it simply because it's moral 101.","사실 나도 알고 있어. 그래도 최소한의 도덕심이 있다면 그러지는 않았으면 해.");
 ds_map_add(m,"It's for the greater good plus I eat well here if you know what I mean.","다 같이 잘되자고 하는 일이야. 게다가 무슨 뜻인지 알지? 여기서 난 꽤 잘 먹고살거든.");
 ds_map_add(m,"Oh, don't get mad, I'm working so I don't always sleep in that pigsty you call a house.","아, 화내지 마. 일하고 있잖아. 네가 집이라고 부르는 그 돼지우리에서 늘 자지 않아도 되게 말이야.");
 ds_map_add(m,"I mean, weren't you supposed to help Line become a better succubus or something?","그러니까, 라인을 더 나은 서큐버스로 만들어 주겠다고 도와주려던 거 아니었어?");
 ds_map_add(m,"Big Sis, what are you doing here?","언니, 여기서 뭐 해요?");
 ds_map_add(m,"Did you find the Outfits?","옷은 찾았어?");
 ds_map_add(m,"I will give you a prize, just come behind the counter.","상을 줄게. 카운터 뒤로 와.");
 ds_map_add(m,"Oh... it is ok.","아…… 괜찮아.");
 ds_map_add(m,"That cat is a thief and we need them for the waitresses as we are full.","그 고양이는 도둑이야. 식당은 손님으로 꽉 찼고, 웨이트리스들이 입을 유니폼이 필요해.");
 ds_map_add(m,"Oops, you look great but I'll need them back.","어머, 잘 어울리긴 하는데 돌려받아야겠어.");
 ds_map_add(m,"Mmmm yeah, I took it from a slime cat, I think it looks pretty good on me.","응, 슬라임 고양이한테서 가져왔어. 나한테 꽤 잘 어울리는 것 같아.");
 ds_map_add(m,"Wow Line those Smoosher outfits?","와, 라인. 그거 스무셔 유니폼이야?");
 ds_map_add(m,"All right, come behind the counter.","좋아, 카운터 뒤로 와.");
 ds_map_add(m,"Big Sis found them! Wh-which ones my prize hehe?","언니가 찾았네요! 그, 그런데 제 상은 뭐예요? 헤헤.");
 ds_map_add(m,"I do the basics, cut damage and every so often I upgrade a cut cube.","기본적인 기술은 할 줄 알아. 베기 피해를 주고, 가끔 베기 큐브 하나를 강화하지.");
 ds_map_add(m,"No.","아니.");
 ds_map_add(m,"Yes.","응.");
 ds_map_add(m,"You are tired alredy?","벌써 지쳤어?");
 ds_map_add(m,"Sorry, I cant right now u.u.","미안, 지금은 안 돼 u.u.");
 ds_map_add(m,"mmm ok.","음, 알겠어.");
 ds_map_add(m,"Hey I am bored Wanna do something?","야, 심심한데 뭐라도 할래?");
 ds_map_add(m,"Is that you Line? c'mon in","라인이야? 어서 들어와.");
 ds_map_add(m,"Moo","음메");
 ds_map_add(m,"I recommend you to improve your life so you don't die with one of my attacks.","내 공격 한 번에 죽지 않으려면 생명력을 올리는 게 좋겠어.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but big of the damage I do to the enemy you get it too, sadly I'm not good at team fighting.","내 전투 방식은 평범해. 마법 피해를 많이 주지만, 적에게 입히는 피해의 상당 부분을 너도 받게 돼. 안타깝게도 난 협동 전투에 능숙하지 않아.");
 ds_map_add(m,"No thanks.","괜찮아, 고마워.");
 ds_map_add(m,"Yes I need to do something by my own sorry :c","응, 혼자 처리해야 할 일이 있어. 미안 :c");
 ds_map_add(m,"You look tired, do you want to rest?","피곤해 보이네. 쉴래?");
 ds_map_add(m,"I recommend you to improve your life and nature so that I am the one doing the damage while you concentrate on surviving my attacks and those of the enemies.","생명력과 자연 속성을 올리는 게 좋겠어. 그러면 난 공격을 맡고, 넌 내 공격과 적들의 공격을 버티는 데 집중하면 돼.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but half of the damage I do to the enemy you get it too, I'm not good at team fighting.","내 전투 방식은 평범해. 마법 피해를 많이 주지만, 적에게 입히는 피해의 절반은 너도 받게 돼. 난 협동 전투에 능숙하지 않아.");
 ds_map_add(m,"Not really hehe but thanks.","딱히 그런 건 아니야, 헤헤. 그래도 고마워.");
 ds_map_add(m,"Can you help me in my adventure <3?.","내 모험에 함께해 줄래? <3?");
 ds_map_add(m,"Thanks for the help, you need something?","도와줘서 고마워. 필요한 거 있어?");
 ds_map_add(m,"That depends on them and their resistance.","그건 상대와 저항력에 달렸어.");
 ds_map_add(m,".... Mhmm Sir? please don't kill anyone.","……으음, 선생님? 제발 아무도 죽이지 마세요.");
 ds_map_add(m,"Ohh you are so kind and thoughtful <3 hehe.","정말 친절하고 사려 깊으시네요 <3 헤헤.");
 ds_map_add(m,"I told your fairy that I would get money.","네 요정에게 돈을 구해 오겠다고 말했어.");
 ds_map_add(m,"Mr. Vasera, what are you doing here?","바세라 씨, 여기서 뭐 하세요?");
 ds_map_add(m,"If you want to go with me to look for him, I won't stop you, but I won't defend you either, you should take care of yourselves.","그를 찾으러 나와 함께 가고 싶다면 말리진 않겠어. 하지만 너희를 지켜 주지도 않을 거야. 스스로 조심해야 해.");
 ds_map_add(m,"How thoughtful. <3","정말 배려심 깊으시네요. <3");
 ds_map_add(m,"The truth is I am already looking for it, I just told them to be careful.","사실 나도 이미 그걸 찾고 있어. 그냥 조심하라고 말해 준 것뿐이야.");
 ds_map_add(m,"Hey wait we could help you look for it so you can absorb it again and get your full strength.","잠깐, 우리가 같이 찾아 주면 되잖아! 다시 흡수해서 온전한 힘을 되찾으면 되지!");
 ds_map_add(m,"Oh this is not good.","아, 이거 좋지 않은데.");
 ds_map_add(m,"Somehow got consciousness and I don't know what it is capable of but if it has a part of my strength it is better to prepare yourself.","어떻게 된 건지 의식이 생겼어. 뭘 할 수 있는지는 모르겠지만, 내 힘의 일부를 지녔다면 대비하는 게 좋겠어.");
 ds_map_add(m,"Mmm there is something wrong with this godless dimension the clones I previously used on you, they all came back to me and I absorbed them except for one.","음, 이 신 없는 차원에 뭔가 문제가 생겼어. 전에 너에게 사용했던 분신들은 전부 내게 돌아와서 흡수했는데, 하나만 돌아오지 않았어.");
 ds_map_add(m,"What wh-why!","뭐, 왜!");
 ds_map_add(m,"Line I must inform you that if you see me again you must kill me if you get the chance.","라인, 알려 둬야겠어. 나를 다시 보게 된다면 기회가 있을 때 반드시 죽여야 해.");
 ds_map_add(m,"si quieren acompañarme a buscarlo no las detendre pero tampoco las defendere deben cuidarse por utedes misma","저와 함께 그걸 찾으러 가고 싶다면 말리진 않겠어요. 하지만 지켜 주지도 않을 테니 스스로 조심하세요.");
 ds_map_add(m,"Que considerado <3","정말 배려심 깊으시네요 <3");
 ds_map_add(m,"yo ya lo estoy buscando la verdad solo les dije que tengan cuidado","사실 저도 이미 찾고 있어요. 그냥 조심하라고 말한 것뿐이에요.");
 ds_map_add(m,"oye espera no puede ayudarno a buscarlo asi lo vuelves a absorver y consigues toda tu fuerza","잠깐, 우리가 찾아 주면 다시 흡수해서 온전한 힘을 되찾을 수 있잖아!");
 ds_map_add(m,"pe-pe pero.","그, 그치만……");
 ds_map_add(m,"de alguna forma consiguio consencia y nose de que es capaz pero si tiene una parte de mi fuerza mejor es que te preparez.","어떻게 된 건지 자의식이 생겼어. 뭘 할 수 있는지는 모르겠지만, 내 힘의 일부를 지녔다면 미리 대비하는 게 좋겠어.");
 ds_map_add(m,"Mmm hay algo malo en esta dimension sin dioses los clones que anteriormente use contigo todos volvieron a mi y los absorvi excepto uno.","음, 이 신 없는 차원에 뭔가 문제가 생겼어. 전에 너에게 사용했던 분신들은 전부 내게 돌아와서 흡수했는데, 하나만 돌아오지 않았어.");
 ds_map_add(m,"Que porque!","왜, 어째서!");
 ds_map_add(m,"Line debo informarte que si me ves denuevo debes matarme si esque tienes la oportunidad.","라인, 미리 말해 둘게. 나를 다시 보게 되면 기회가 있을 때 반드시 죽여야 해.");
 ds_map_add(m,"Please... Help me, I need those crystals to go back home.","제발…… 도와주세요. 집에 돌아가려면 그 수정들이 필요해요.");
 ds_map_add(m,"Well I do moderate piercing damage and upgrade a piercing cube on the grid every so often.","난 중간 정도의 관통 피해를 주고, 가끔 격자판의 관통 큐브 하나를 강화할 수 있어.");
 ds_map_add(m,"I still want you to accompany me.","그래도 네가 나와 함께해 줬으면 해.");
 ds_map_add(m,"Yes please, I have other things to do.","네, 부탁해요. 다른 할 일이 있거든요.");
 ds_map_add(m,"Do you want me to stay here for a while?","여기서 잠시 기다려 줄까?");
 ds_map_add(m,"Sorry, I have other things to do.","미안해요. 다른 할 일이 있어요.");
 ds_map_add(m,"join me vasuki <3.","나와 함께하자, 바수키 <3.");
 ds_map_add(m,"Oh you need something?","아, 필요한 거라도 있어?");
 ds_map_add(m,"The quest will be available in later updates.","이 퀘스트는 추후 업데이트에서 이용할 수 있습니다.");
 ds_map_add(m,"Great ... I ran out of cigarettes.","잘됐네…… 담배가 다 떨어졌거든.");
 ds_map_add(m,"Here, it's 100 Arcs just... dont blow it.","자, 100아크야. 그냥…… 허튼짓은 하지 마.");
 ds_map_add(m,"Of course there is no problem, count on me.","물론이지, 문제없어. 나만 믿어.");
 ds_map_add(m,"If you can bring some premium cigarettes, you would do me a favor, since this is my last day on the island.","고급 담배를 좀 가져다주면 고맙겠어. 오늘이 이 섬에 머무는 마지막 날이거든.");
 ds_map_add(m,"This day has been terrible, my personal onahole is sick and I also ran out of cigarettes.","오늘은 정말 최악이야. 내 전용 오나홀이 아픈 데다 담배까지 떨어졌어.");
 ds_map_add(m,"Wh-what?","뭐, 뭐라고요?");
 ds_map_add(m,"Hey wait.","이봐, 잠깐만.");
 ds_map_add(m,"But its ok, im leaving.","뭐, 괜찮아. 난 떠날 거니까.");
 ds_map_add(m,"Oh so-sorry I am good helping people.","아, 죄, 죄송해요. 전 사람들을 돕는 걸 잘해요.");
 ds_map_add(m,"What do you care.","네가 뭘 신경 써?");
 ds_map_add(m,"So-so something happend?","그, 그러니까 무슨 일이라도 있었어요?");
 ds_map_add(m,"hurry up i'm running out of patience.","빨리해. 인내심이 바닥나고 있어.");
 ds_map_add(m,"To the ground now!","당장 바닥에 엎드려!");
 ds_map_add(m,"What?!","뭐라고?!");
 ds_map_add(m,"Hey, what I'm saying we'll do right here, right now.","이봐, 내 말은 바로 여기서, 지금 당장 하자는 거야.");
 ds_map_add(m,"Oh its ok.","아, 괜찮아요.");
 ds_map_add(m,"Oh, haha I like the idea but I don't have much time left I have to leave now.","오, 하하. 좋은 생각이긴 한데 시간이 별로 없어요. 지금 떠나야 해요.");
 ds_map_add(m,"I could b-be your onahole fo-for wasting your time.","시간을 낭비하게 한 보답으로 제, 제가 오나홀이 되어 드릴 수도 있어요.");
 ds_map_add(m,"In what way?","어떤 식으로?");
 ds_map_add(m,"Wh-wait im very sorry maybe i ca-can help in another way.","자, 잠깐만요. 정말 죄송해요. 다른 방법으로 도와드릴 수 있을지도 몰라요.");
 ds_map_add(m,"Damn this is all a waste of time, thanks for nothing.","젠장, 시간만 낭비했잖아. 아무 도움도 안 됐네.");
 ds_map_add(m,"I regret to inform you that the cigarettes you are looking for do not exist on the island :c.","유감스럽게도 찾으시는 담배는 이 섬에 없어요 :c.");
 ds_map_add(m,"Please don't bring me bad news.","제발 나쁜 소식만은 전하지 말아 줘.");
 ds_map_add(m,"Umm kristoff.","어, 크리스토프.");
 ds_map_add(m,"What are you looking at!","뭘 쳐다봐!");
 ds_map_add(m,"What are you looking at!?","뭘 쳐다보는 거야!?");
 ds_map_add(m,"Well lady have a good day.","그럼, 숙녀분. 좋은 하루 보내세요.");
 ds_map_add(m,"*Kamiko grabs Line tightly and kisses her for a long minute*","*카미코가 라인을 꽉 끌어안고 한참 동안 입을 맞춘다*");
 ds_map_add(m,"Oh ok. (at least it's something)","아, 알겠어요. (적어도 뭐라도 받았네.)");
 ds_map_add(m,"But the kiss will be a french kiss.","하지만 혀를 넣는 프렌치 키스여야 해.");
 ds_map_add(m,"Oh ok great. (I thought, she would think of something better :/ )","아, 좋아요. (더 좋은 걸 생각할 줄 알았는데 :/)");
 ds_map_add(m,"Hmmm, Aren't you the cutest thing?, just a kiss from you would be enough.","음, 정말 귀엽네. 네가 키스 한 번만 해 줘도 충분해.");
 ds_map_add(m,"isn't there some other way to pay it? *wink wink*","통행료를 다른 방식으로 낼 수는 없을까? *윙크 윙크*");
 ds_map_add(m,"You don't have enough arcs, get out of here and let people with money pass.","아크가 부족하잖아. 꺼져, 돈 있는 사람들 지나가게.");
 ds_map_add(m,"Excellent lady, have a nice day <3.","훌륭해요, 숙녀분. 좋은 하루 보내세요 <3.");
 ds_map_add(m,"Do you really think you idiots can catch me? Haha, I have done this all over Elira. I'll just have to shut you up.","너희 멍청이들이 날 잡을 수 있다고 진심으로 생각해? 하하, 엘리라 전역에서 이런 짓을 해 왔어. 입을 다물게 해 줘야겠네.");
 ds_map_add(m,"I told you Line, let's capture her maybe the guards give us money.","라인, 내가 말했잖아. 저 여자를 잡자. 경비대가 돈을 줄지도 몰라.");
 ds_map_add(m,"Stop ... Haha looks like you're not the smart one on the team Line.","그만…… 하하, 라인. 네가 우리 팀에서 머리 쓰는 역할은 아닌가 보네.");
 ds_map_add(m,"No Line! I will bring the great captain, she is the criminal they are looking for.","안 돼, 라인! 내가 대장을 데려올게. 저 여자가 그들이 찾는 범죄자야.");
 ds_map_add(m,"O-oh ok i will pay.","아, 알겠어요. 돈을 낼게요.");
 ds_map_add(m,"Look... I hate taking people there, we can make a deal, if you give me the rate plus the fine and 200 arcs to keep our little secret, I'll let you go.","있잖아…… 사람들을 거기로 보내는 건 싫어. 거래하자. 통행료와 벌금에다 우리 비밀을 지키는 대가로 아크 200개를 더 내면 보내 줄게.");
 ds_map_add(m,"Lili! Do you see what you have done!","릴리! 네가 무슨 짓을 했는지 봤어?!");
 ds_map_add(m,"It's over now, I'll have to take you to the jail-farm, for repeated harassment to Elira's authority.","이제 끝이야. 엘리라의 공권력을 반복해서 방해했으니 감옥 농장으로 데려가야겠어.");
 ds_map_add(m,"Line don't be so naive, she has only a glove and a shoulder pad from the outfit of a guard.","라인, 너무 순진하게 굴지 마. 저 여자는 경비대 유니폼의 장갑 하나와 어깨 보호대만 걸치고 있잖아.");
 ds_map_add(m,"Whaaat!?","뭐어어?!");
 ds_map_add(m,"The truth is that it is too late, I will have to fine you with 100 arcs for lack of respect for authority.","사실 이미 늦었어. 공권력을 무시한 죄로 아크 100개를 벌금으로 내야 해.");
 ds_map_add(m,"LiLi do not offend the guard.","릴리, 경비병을 자극하지 마.");
 ds_map_add(m,"What? Ha ha? just look at my guard outfit you must be mistaking me with someone else.","뭐? 하하? 내 경비대 유니폼 좀 봐. 분명 다른 사람과 착각한 거겠지.");
 ds_map_add(m,"Exit","나가기");
 ds_map_add(m,"Bribe her with something. (Lili's idea)","뭔가로 그녀를 매수한다. (릴리의 생각)");
 ds_map_add(m,"Pay the fare. (500 Arcs)","통행료를 낸다. (아크 500개)");
 ds_map_add(m,"This is the bitch from the wanted poster! (Lili say)","저 여자가 수배 전단에 나온 그년이야! (릴리의 말)");
 ds_map_add(m,"Line","라인");
 ds_map_add(m,"Due to the high use of the bridge, it started to require maintenance, so I'm here to collect the toll.","다리 이용량이 많아져서 유지 보수가 필요해졌거든. 그래서 통행료를 걷고 있어.");
 ds_map_add(m,"I'm not very good at fighting is not my style but I do what I can since I'm half wyvern I use poison, it's not very powerful but I cut their healing by 50% and I strike a punch or two even though I'm not very strong.","난 싸움에 별로 소질이 없어. 내 스타일도 아니지만, 할 수 있는 건 해. 반쪽짜리 와이번이라 독을 쓰거든. 그리 강하진 않지만 적의 회복량을 50% 줄이고, 힘은 약해도 주먹 한두 방은 날릴 수 있어.");
 ds_map_add(m,"No, could you tell me again how you fight?","아니, 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"You wanna quit for the day?","오늘은 여기까지 할까?");
 ds_map_add(m,"Sorry, I cant right now.","미안, 지금은 안 돼.");
 ds_map_add(m,"Of course <3.","물론이지 <3.");
 ds_map_add(m,"Ready to make some mess?","한바탕 난장판을 벌일 준비 됐어?");
 ds_map_add(m,"Come back when you have Arcs.","아크를 가지고 다시 와.");
 ds_map_add(m,"There you have it, you little rascal.","자, 여기 있다. 이 말썽꾸러기야.");
 ds_map_add(m,"Not now.","지금은 안 돼.");
 ds_map_add(m,"Ok","알겠어.");
 ds_map_add(m,"Unfortunately I can't find him, I'll sell it to you for a thousand Arcs if you want it so badly.","아쉽게도 그 사람을 찾지 못했어. 그렇게 갖고 싶다면 아크 1,000개에 팔게.");
 ds_map_add(m,"You want to buy the briefcase I have? I was thinking of blackmailing the guy who lost it.","내가 가진 이 서류 가방을 사고 싶어? 잃어버린 사람을 협박할 생각이었는데.");
 ds_map_add(m,"And don't even think of taking a single Arc out of here, don't you see that why we have worked so hard, so that I can sleep like my ancestors. Yep Surrounded by money.","여기서 아크 하나라도 가져갈 생각은 하지 마. 우리가 왜 그렇게 열심히 일했는지 모르겠어? 내가 조상들처럼 잠들 수 있게 하려는 거야. 그래, 돈에 파묻혀서 말이지.");
 ds_map_add(m,"Hey Line you figured out where I keep all my Arcs.","이봐, 라인. 내가 아크를 전부 어디에 보관하는지 알아냈구나.");
 ds_map_add(m,"Umm eh em. h-hi.","으음, 어, 그, 안녕하세요.");
 ds_map_add(m,"Theres nothing to explain, you blew up those girls!","설명할 것도 없어. 네가 그 여자애들을 폭발시켰잖아!");
 ds_map_add(m,"Please let me explain.","제발 설명하게 해 주세요.");
 ds_map_add(m,"Well the truth is that I don't like to fight, but I can support you by recovering 10% of your life from time to time.","사실 난 싸우는 걸 싫어해. 그래도 가끔 네 생명력을 10% 회복시켜서 도와줄 수 있어.");
 ds_map_add(m,"No never.","아니, 절대 안 돼.");
 ds_map_add(m,"you want to rest?","쉬고 싶어?");
 ds_map_add(m,"Actually yes,could you tell me again how you fight?","사실 그래. 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"This Quest is only for patreons.","이 퀘스트는 패트리온 후원자 전용입니다.");
 ds_map_add(m,"Remember, if you find her, bring her with me in the sencond Floor of the hotel even if she doesn't want to.","기억해. 그녀를 찾으면 호텔 2층에 있는 나에게 데려와. 본인이 싫다고 해도 말이야.");
 ds_map_add(m,"How annoying you are!.","정말 성가시네!");
 ds_map_add(m,"Oh you still have the strength to fight? I guess it will be a second round.","오, 아직 싸울 힘이 남았어? 그럼 2차전이겠네.");
 ds_map_add(m,"Yes, yes I understand you, sorry for wasting your time :c.","네, 네. 무슨 말인지 알겠어요. 시간 낭비하게 해서 죄송해요 :c.");
 ds_map_add(m,"Thanks Line but I'm looking for an adventurer a little more mmmm.... recognizable one that wherever he goes, people will recognize him, you know what I mean right?","고마워, 라인. 하지만 난 조금 더…… 음…… 유명한 모험가를 찾고 있어. 어딜 가든 사람들이 알아보는 그런 사람 말이야. 무슨 뜻인지 알겠지?");
 ds_map_add(m,"Oh well, I don't know, but still, if you need help, uh a-here I am.","아, 글쎄요. 잘 모르겠지만, 그래도 도움이 필요하시면 어…… 저, 제가 여기 있어요.");
 ds_map_add(m,"Really? I don't see you being the adventurous type.","정말? 넌 모험가처럼 보이진 않는데.");
 ds_map_add(m,"Oh.. ehmm h-hi i am Line I am adventurer","아…… 어…… 아, 안녕하세요. 저는 라인이고, 모험가예요.");
 ds_map_add(m,"Uff this novel will practically write itself.","후, 이 소설은 거의 저절로 써지겠는데.");
 ds_map_add(m,"I am also half succubus :v.","저는 반쪽짜리 서큐버스이기도 해요 :v.");
 ds_map_add(m,"OHh, an orthodox elf who discovers her sexuality, Line your life is gold.","오오, 자신의 성적 욕망을 깨닫는 정통파 엘프라니! 라인, 네 인생은 그야말로 대박 소재야.");
 ds_map_add(m,"Hey, hey hey  she is not a whore she is just exploring her sexuality.","이봐, 이봐! 라인은 창녀가 아니야. 그냥 자신의 성적 취향을 알아가는 중이라고.");
 ds_map_add(m,"Wow Line you are such a whore you must have a million stories please let me join you on your journey.","와, 라인. 너 정말 걸레구나. 이야기가 백만 개는 있겠어! 네 여정에 나도 끼워 줘.");
 ds_map_add(m,"Lili! ( Please someone kill me )","릴리! (제발 누가 날 죽여 줘.)");
 ds_map_add(m,"HAHAHA because they don't have it, she defeated the demon by taking her energy by giving her a rimjob.","하하하, 그들에겐 그게 없으니까. 그 여자는 악마에게 애널링구스를 해 주고 기운을 빨아들여서 악마를 쓰러뜨렸어.");
 ds_map_add(m,"Wow I had no idea that elves could summon sacred fires.","와, 엘프가 신성한 불꽃을 소환할 수 있는 줄은 몰랐어.");
 ds_map_add(m,"Well you know... fire ehh sacred ... of elf (Iam a terrible liar :C).","그게 말이지…… 불, 어…… 신성한…… 엘프의 불이랄까. (난 정말 거짓말을 못 해 :C.)");
 ds_map_add(m,"OHHH and what is this super attack?!","오오! 그럼 이 엄청난 공격은 뭐야?!");
 ds_map_add(m,"OHh. that, I ahemm. We fought an epic battle where I was on the verge of losing but luckily I channeled all my strength into one last attack and BAM I knocked her down and she fell unconscious.","오, 그건 말이지. 크흠. 우리는 장대한 전투를 벌였어. 내가 질 뻔했지만, 다행히 마지막 공격에 모든 힘을 쏟아부었지. 그리고 쾅! 그녀를 쓰러뜨렸고, 그녀는 기절했어.");
 ds_map_add(m,"How did you defeat the white demon in the forest? The whole town is talking about you winning her but nobody knows exactly how?","숲의 하얀 악마를 어떻게 물리친 거야? 온 마을이 네가 그 악마를 이겼다는 얘기로 떠들썩한데, 정확히 어떻게 이겼는지는 아무도 몰라.");
 ds_map_add(m,"OHh hu-hu-hu wha-what kind of experiences do you need.","오오, 흐, 흐흐. 어, 어떤 경험을 원하시는데요?");
 ds_map_add(m,"PLEASE let me join you on your journey my novel depends on you I need all the experience you can give me.","제발 네 모험에 끼워 줘! 내 소설은 너한테 달렸어. 네가 들려줄 수 있는 경험은 전부 필요해.");
 ds_map_add(m,"Ehh yes I am she hehe.","어, 네. 제가 바로 그 사람이에요, 헤헤.");
 ds_map_add(m,"Hey, are you the traveler who defeated the demon that stole the alcohol supplies?!","이봐, 술을 훔쳐 간 악마를 물리친 여행자가 바로 너야?!");
 ds_map_add(m,"Well I do moderate magic damage and upgrade a magic cube on the grid every so often.","난 중간 정도의 마법 피해를 주고, 가끔 격자판의 마법 큐브 하나를 강화할 수 있어.");
 ds_map_add(m,"Yes I need to do something by my own sorry. :c","응, 혼자 해야 할 일이 있어. 미안해. :c");
 ds_map_add(m,"You want to rest?","쉬고 싶어?");
 ds_map_add(m,"Can you help me in my adventure. <3?.","내 모험에 함께해 줄래? <3?");
 ds_map_add(m,"Oh hehe thanks <3.","아, 헤헤. 고마워 <3.");
 ds_map_add(m,"The world is a better place with you in it, whether you like it or not.","네가 인정하든 말든, 네가 이 세상에 있다는 것만으로 세상은 더 나은 곳이야.");
 ds_map_add(m,"Really? well that would help me a lot and don't worry it's the first time I've seen a fairy like that haha.\nWell, if you find it, please do not view its content, it is classified from my work.","정말요? 그럼 큰 도움이 되겠네요. 걱정 마세요. 저도 그런 요정은 처음 봤거든요, 하하.\n찾게 되더라도 안에 든 내용은 보지 말아 주세요. 제 업무 기밀이거든요.");
 ds_map_add(m,"Lili! \n Oh I am so-sorry she is a bit aggressive but she has a good heart if you want we can help you look for your briefcase.","릴리!\n아, 죄, 죄송해요. 조금 사납긴 하지만 마음은 착해요. 원하신다면 저희가 서류 가방을 찾는 걸 도와드릴게요.");
 ds_map_add(m,"Ya great but I didn't ask you about your life","그래, 잘됐네. 하지만 네 인생 얘기를 물어본 건 아니야.");
 ds_map_add(m,"Sorry I had a horrible day I lost my briefcase and I had a lot of important information in it now I have to start from scratch.","죄송해요. 오늘은 정말 최악이에요. 서류 가방을 잃어버렸는데, 안에 중요한 정보가 잔뜩 들어 있었거든요. 이제 처음부터 다시 시작해야 해요.");
 ds_map_add(m,"Lili do not say it like that!","릴리, 그런 식으로 말하지 마!");
 ds_map_add(m,"Hey shut up, you're in a library.","이봐, 조용히 해. 여긴 도서관이야.");
 ds_map_add(m,"AHh I'll have to start all over again.\nWhere can my briefcase be?","아, 처음부터 다시 해야겠네.\n내 서류 가방은 대체 어디에 있는 거지?");
 ds_map_add(m,"Did you find my briefcase?","내 서류 가방 찾았어?");
 ds_map_add(m,"My briefcase should be here somewhere","내 서류 가방은 분명 이 근처 어딘가에 있을 텐데.");
 ds_map_add(m,"Well I do moderate Impact damage to the enemy and between each fight I can try to win more Arcs.","난 적에게 중간 정도의 충격 피해를 줄 수 있고, 전투가 끝날 때마다 아크를 더 벌 기회를 노릴 수도 있어.");
 ds_map_add(m,"Actually could you tell me again how you fight?","사실, 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"No now.","지금은 안 돼.");
 ds_map_add(m,"Yes please I am a little tired.","네, 부탁해요. 조금 피곤하거든요.");
 ds_map_add(m,"Are we done for the day?","오늘은 이만하면 될까?");
 ds_map_add(m,"In a fight I do moderate impact damage plus I can make the enemy give us double the Arcs for the trouble he gave us..","전투에서는 중간 정도의 충격 피해를 주고, 우리를 괴롭힌 적에게서 아크를 두 배로 받아낼 수도 있어.");
 ds_map_add(m,"Do you need something line?","라인, 필요한 거 있어?");
 ds_map_add(m,"But once they atone for their sins they will be returned to them is the law of the island.","하지만 그들이 죄를 뉘우치면 다시 돌려받게 돼. 이 섬의 법이야.");
 ds_map_add(m,"Oh no, hahaha that would be crazy. I just steal their eyes and place them on my body.","아니, 하하하. 그건 너무 엽기적이잖아. 난 그들의 눈을 훔쳐서 내 몸에 붙일 뿐이야.");
 ds_map_add(m,"And how are you supposed to do your justice, you don't kill them... right?","그럼 정의를 어떻게 실현하는데? 설마 죽이는 건 아니지……?");
 ds_map_add(m,"As I pray I can hear the prayers of women in trouble and bring justice.","기도를 드리면 곤경에 처한 여자들의 기도가 들려. 그러면 내가 정의를 실현하러 가는 거야.");
 ds_map_add(m,"I am Ragnuda the dodomeki and I judge men who cheat on their wives.","나는 도도메키 라그누다야. 아내를 두고 바람피우는 남자들을 심판하지.");
 ds_map_add(m,"Oh I am sorry it's just weird to see someone here at night... and naked. :v","아, 미안해. 그냥 밤에 여기서 누군가를 보는 게…… 그것도 알몸으로. 좀 이상해서. :v");
 ds_map_add(m,"You interrupted my prayers.","네가 기도를 방해했어.");
 ds_map_add(m,"What a brave boy ;c","정말 용감한 소년이네 ;c");
 ds_map_add(m,"MOooOOOo!","음메에에에!");
 ds_map_add(m,"Line Look","라인, 저기 봐.");
 ds_map_add(m,"A somewhat ironic ending I guess Hahaha.","참 아이러니한 결말이네. 하하하.");
 ds_map_add(m,"Shale vale :v.","참 별일이네 :v.");
 ds_map_add(m,"I was told that I can earn some money by selling my own 'milk'.","내 '우유'를 팔면 돈을 벌 수 있다고 들었어.");
 ds_map_add(m,"And now I have no money to go back home ;c.","이제 집에 돌아갈 돈도 없어 ;c.");
 ds_map_add(m,"Well... I came on vacation to this island but I spent my money driking milk.","그게…… 휴가를 보내려고 이 섬에 왔는데 우유를 마시느라 돈을 다 써 버렸어.");
 ds_map_add(m,"What happened to you?","무슨 일이야?");
 ds_map_add(m,"Ah I really don't want to do this.","아, 정말 이러고 싶지 않아.");
 ds_map_add(m,"Oh he doesn't have a cow outfit.","아, 그는 소 의상이 없네.");
 ds_map_add(m,"Haha its ok take care.","하하, 괜찮아. 잘 지내.");
 ds_map_add(m,"Oh, yeah sorry it will have to be for another day :c.","아, 그래. 미안하지만 다음에 해야겠어 :c.");
 ds_map_add(m,"Line! focus on your objective, we are looking for your friend.","라인! 목표에 집중해. 우린 네 친구를 찾으러 온 거야.");
 ds_map_add(m,"Oh I am not really a drinking person hehe but if you want I can.... join you you know.","아, 난 술을 자주 마시는 편은 아니야, 헤헤. 그래도 네가 원한다면…… 같이 마셔 줄 수는 있어. 무슨 뜻인지 알지?");
 ds_map_add(m,"Hi, sweetie, would you like to join me for a drink?","안녕, 자기. 나랑 한잔할래?");
 ds_map_add(m,"make me bitch","덤벼, 이년아.");
 ds_map_add(m,"Get the hell out of my territory you thot","내 구역에서 꺼져, 이 걸레 같은 년아.");
 ds_map_add(m,"It may already be time to get back to work, I miss announcing the news.","이제 슬슬 일하러 돌아갈 때가 된 것 같아. 뉴스를 발표하던 때가 그립네.");
 ds_map_add(m,"I wouldn't miss it for anything in the world.","무슨 일이 있어도 놓치지 않을 거야.");
 ds_map_add(m,"Mmm.. hi there will be a mini show at the circus I would appreciate it if you could go.","음…… 안녕하세요. 서커스에서 작은 공연을 할 예정인데, 와 주시면 정말 감사하겠어요.");
 ds_map_add(m,"*blushed* th-thank you it is a relief that you liked it.","*얼굴을 붉히며* 고, 고마워요. 마음에 드셨다니 안심이에요.");
 ds_map_add(m,"That was a great show.","정말 멋진 공연이었어.");
 ds_map_add(m,"Sorry (but I didn't do anything :c).","죄송해요. (하지만 전 아무것도 안 했는데요 :c.)");
 ds_map_add(m,"She is very sorry, say sorry *covers Line's mouth*","정말 죄송하대요. 사과해. *라인의 입을 막는다*");
 ds_map_add(m,"Oh, well if you wan..","아, 그러니까 네가 원한다면……");
 ds_map_add(m,"Excuse me? that no way of speaking if I were your mother I would punish you.","뭐라고요? 그런 식으로 말하면 안 되죠. 제가 당신 어머니였다면 벌을 줬을 거예요.");
 ds_map_add(m,"Shit! Line look at that ass.","젠장! 라인, 저 엉덩이 좀 봐.");
 ds_map_add(m,"Finally I finished cleaning this floor, Mr.Cabello will be happy <3.","드디어 이 층 청소를 끝냈어. 카베요 씨가 기뻐하시겠지 <3.");
 ds_map_add(m,"Thanks Line for the help <3.","도와줘서 고마워, 라인 <3.");
 ds_map_add(m,"MMm where to go next, what place will inspire me? to write my next hit.","음, 다음엔 어디로 가지? 다음 베스트셀러를 쓸 영감을 얻을 만한 곳이 어디 있을까?");
 ds_map_add(m,"But, what?...well whatever. I hope you can accomplish your mission miss but if it gets too dangerous run away please I don't want my book to be tainted by someone dying or getting lost in the woods.","하지만, 뭐라고?…… 뭐, 어쨌든. 아가씨, 임무를 잘 완수하길 바라. 하지만 너무 위험해지면 도망쳐. 누군가 죽거나 숲에서 길을 잃는 일로 내 책을 망치고 싶진 않거든.");
 ds_map_add(m,"I will do my best I will be worthy of the sword *reverence*.","최선을 다하겠습니다. 이 검에 걸맞은 사람이 되겠습니다. *경례*");
 ds_map_add(m,"What are you talking about? I never said you were going to look for her, and I don't really care either, no one has taken her out so far.","무슨 소리야? 난 네가 그녀를 찾으러 간다고 한 적 없어. 사실 별로 관심도 없어. 지금까지 아무도 그걸 뽑아 내지 못했거든.");
 ds_map_add(m,"Thank you very much I will not let you down and I will bring the sword.","정말 감사합니다. 실망시키지 않고 반드시 검을 가져오겠습니다.");
 ds_map_add(m,"Well one enters the forest and must follow these directions up, down, left, left, left, right, down and finally up. But beware that even if I am not here, the spiritual energy of one of my ancestors may try to deny you passage..","숲에 들어가면 이 순서대로 움직여야 해. 위, 아래, 왼쪽, 왼쪽, 왼쪽, 오른쪽, 아래, 마지막으로 위. 하지만 조심해. 내가 여기 없어도 조상 중 한 분의 영력이 네 앞길을 막을 수 있어……");
 ds_map_add(m,"And how I got there!","그럼 난 어떻게 거기까지 갔는데!");
 ds_map_add(m,"Yes, but there came a time when I really understood that she didn't need me to take care of her, she was quite lost in the forest and to get her out you have to have the requirements I wrote down, even so I don't understand how that helps to get the sword out.","그래. 하지만 어느 순간 그녀를 돌봐 줄 필요가 없다는 걸 깨달았어. 그녀는 숲에서 길을 잃었고, 그녀를 데려오려면 내가 적어 둔 조건을 갖춰야 해. 그래도 그게 검을 뽑는 데 어떻게 도움이 되는지는 모르겠어.");
 ds_map_add(m,"What the heck?!","대체 뭐야?!");
 ds_map_add(m,"Oh relax you will be surprised to know that it is true my family was the one who took care of the sword although we never managed to get it off the anvil.","아, 진정해. 사실이라는 걸 알면 놀랄 거야. 우리 가족은 그 검을 지켜 왔어. 물론 모루에서 뽑아 내는 데는 한 번도 성공하지 못했지만.");
 ds_map_add(m,"Uh sorry sir my friend fell out of the crib when she was a baby we won't bother you anymore eh hehe ehh..","어, 죄송합니다. 제 친구는 아기였을 때 아기 침대에서 떨어진 적이 있어요. 더는 귀찮게 하지 않을게요. 헤헤, 어……");
 ds_map_add(m,"YES! You know that when I read your story I did not feel that the sword is true and I can feel it on the island.","그래! 네 이야기를 읽었을 때는 그 검이 진짜라고 생각하지 않았어. 그런데 이제 이 섬에서 그 기운이 느껴져.");
 ds_map_add(m,"Mmmm yes I am surprised to find fans here, was it because of the back cover?","음, 여기서 팬을 만날 줄은 몰랐네. 뒷표지를 보고 온 건가?");
 ds_map_add(m,"Hello sir, are you by any chance the author of The Pelletclad Blade?","안녕하세요, 선생님. 혹시 《펠릿클래드 블레이드》를 쓰신 작가분이신가요?");
 ds_map_add(m,"You say that because of the sheets in his hand...I guess it's worth a try.","손에 든 종이 몇 장만 보고 그렇게 말하는 거야……? 뭐, 한번 시도해 볼 가치는 있겠네.");
 ds_map_add(m,"Looks like a writer?","작가처럼 보여?");
 ds_map_add(m,"Ehh it must be because of the years it was stored out in the open hehe.","어, 오랫동안 야외에 보관돼 있어서 그런가 봐요. 헤헤.");
 ds_map_add(m,"What, you managed to get the sword I'm glad it has a new owner but why does it smell so strange?","뭐라고, 검을 찾아냈다고? 새 주인이 생겨서 기쁘긴 한데, 왜 이렇게 이상한 냄새가 나지?");
 ds_map_add(m,"Hey do you want something really chingon?.","이봐, 진짜 끝내주는 물건을 원해?");
 ds_map_add(m,"Oh give me a second I'm getting my suit ready.","아, 잠깐만. 지금 슈트를 준비하고 있어.");
 ds_map_add(m,"Mmmhe MMMhe I understand I will have it ready when I bring the 5000 arcs leave it all to me.","음흠, 음흠. 알겠어. 아크 5000개를 가져오면 준비해 둘게. 전부 나한테 맡겨.");
 ds_map_add(m,"Mmmm ok but I want this for my furrsuit *whispering* shp shp shp shapa shapa shapa.","으음, 좋아. 하지만 내 퍼슈트는 이렇게 해 줬으면 해. *속삭임* 슈프 슈프 슈 샤파 샤파 샤파.");
 ds_map_add(m,"I know it's expensive but understand that the suit is custom made with all the specifications you want.","비싼 건 알지만, 네가 원하는 사양에 맞춰 주문 제작하는 슈트라는 걸 알아줬으면 해.");
 ds_map_add(m,"Great it's only 5000 Arcs","좋아, 겨우 아크 5000개면 되네.");
 ds_map_add(m,"You've already convinced me how much it costs!","얼마나 드는지는 이미 충분히 설명했잖아!");
 ds_map_add(m,"I'm not going to lie to you, it's expensive, but if it's any incentive Miss Marael says that sex in a furrisuit is quite an experience.","솔직히 말하면 비싸. 그래도 마음이 움직일 만한 얘기를 하나 해 줄게. 마라엘 씨 말로는 퍼슈트를 입고 하는 섹스가 꽤 색다른 경험이래.");
 ds_map_add(m,"Now I want to be a furry!","나도 이제 퍼리 팬이 되고 싶어!");
 ds_map_add(m,"Yes haha she was part of the furry community before deciding to live life as a goat woman.","그래, 하하. 그녀는 염소 여자로 살기로 결심하기 전까지 퍼리 커뮤니티의 일원이었어.");
 ds_map_add(m,"Really?!","정말?!");
 ds_map_add(m,"Oh you talk about Miss Marael what a nice woman she was my first time.","아, 마라엘 씨 말이구나. 정말 좋은 여자였지. 내 첫 경험도 그분과 함께였어.");
 ds_map_add(m,"Mmm... I am half succubus and I cannot even transform myself to the taste of others, I met a succubus who decided to live life as a black goat woman, I would really like to change my form and know how it would be like to be a real succubus.","음…… 난 반쪽짜리 서큐버스인데도 다른 사람 취향에 맞춰 변신조차 못 해. 검은 염소 여자로 살기로 한 서큐버스를 만난 적이 있어. 나도 모습을 바꿔서 진짜 서큐버스가 된 기분을 느껴 보고 싶어.");
 ds_map_add(m,"Not all of us are lucky enough to be born as one or transform ourselves but with these costumes we have the opportunity to live life from a different perspective.","태어날 때부터 그런 모습이거나 스스로 변신할 수 있는 행운을 누리는 사람만 있는 건 아니야. 하지만 이런 의상을 입으면 다른 관점에서 삶을 경험할 기회가 생기지.");
 ds_map_add(m,"Well, it all depends on whether you admire atropomorphic animals like wolves.","음, 늑대 같은 의인화 동물을 좋아하는지에 달렸지.");
 ds_map_add(m,"Mmm I do not know what's in it for me?","음, 잘 모르겠는데요. 제가 얻는 게 뭐죠?");
 ds_map_add(m,"I don't know Line looks like a weirdo.","모르겠어. 라인, 저 사람 좀 이상한데.");
 ds_map_add(m,"Would you like to be part of our community?","우리 커뮤니티의 일원이 되고 싶어?");
 ds_map_add(m,"OH how cute I love your fluffy little ears <3.","아, 너무 귀여워! 네 보송보송한 작은 귀가 정말 좋아 <3.");
 ds_map_add(m,"Indeed, I am an honorable member of the furry community.","맞아. 난 퍼리 커뮤니티의 명예로운 회원이지.");
 ds_map_add(m,"... H-hi e- that's a costume?","……아, 아, 안녕하세요. 저, 그거 의상인가요?");
 ds_map_add(m,"Ohmm HI I am Snugglepaws!","어흠, 안녕! 난 스너글포즈야!");
 ds_map_add(m,"No I am still short of money :c.","아니, 아직 돈이 부족해 :c.");
 ds_map_add(m,"Did you get the money?","돈은 마련했어?");
 ds_map_add(m,"Thank you very much Mr. Snugglepaws.","정말 감사합니다, 스너글포즈 씨.");
 ds_map_add(m,"Let's go home Lili, I need your help!","릴리, 집에 가자. 네 도움이 필요해!");
 ds_map_add(m,"Ohhhh I love it I love it I love it I love it that's all I wanted <3!","오오오! 너무 좋아, 정말 좋아, 정말 좋아! 내가 원하던 게 바로 이거야 <3!");
 ds_map_add(m,"Here it is, your furrsuit of rabbit woman with movable mouth, automatic blinking, with soft light blue magenta hair!","자, 여기 있어. 움직이는 입과 자동 눈 깜빡임 기능이 있고, 부드러운 연한 파란색과 마젠타색 털이 달린 토끼 여성형 퍼슈트야!");
 ds_map_add(m,"Oh it's okay I'll wait here <3.","아, 괜찮아. 여기서 기다릴게 <3.");
 ds_map_add(m,"Yes, everything is here. (pay 5000 Arcs)","네, 전부 여기 있어요. (아크 5000개 지불)");
 ds_map_add(m,"Not yet.","아직이야.");
 ds_map_add(m,"Thank you very much but I am no longer Line now call me Bluebell.","정말 고마워요. 하지만 이제 저는 라인이 아니에요. 블루벨이라고 불러 주세요.");
 ds_map_add(m,"Go Line I know what you want to do.","가, 라인. 네가 뭘 하려는지 알아.");
 ds_map_add(m,"... good, thank you.","……좋아, 고마워.");
 ds_map_add(m,"Oh Bluebell did you like the suit?","아, 블루벨. 슈트 마음에 들어?");
 ds_map_add(m,"Oh hehe we really have a very similar voice, masturbating thinking about my own voice will be something very strange hehe although something exciting.","아, 헤헤. 우리 목소리가 정말 비슷하네. 내 목소리를 생각하면서 자위한다니 꽤 이상하겠어. 헤헤, 그래도 뭔가 흥분되긴 하겠다.");
 ds_map_add(m,"Wow you sound a lot like me, haha ,well I have a fura fura fruit if you want to eat one.","와, 너 나랑 목소리가 정말 비슷하다, 하하. 참, 원한다면 내게 후라후라 열매가 하나 있는데 먹어 볼래?");
 ds_map_add(m,"No, no, no, no, I-I want to hehe sorry for overthinking it.","아니, 아니, 아니. 저, 저는 먹고 싶어요. 헤헤. 너무 깊이 생각해서 죄송해요.");
 ds_map_add(m,"If you don't want to, it's okay, lady.","원하지 않으시면 괜찮아요, 아가씨.");
 ds_map_add(m,"Oh Mmmm (exactly, pretend to think so they don't find out you're desperate).","아, 으음…… (그래, 생각하는 척해. 네가 얼마나 절박한지 들키지 않게.)");
 ds_map_add(m,"Hello Miss, by any chance do you want to use my hole?","안녕하세요, 아가씨. 제 구멍을 사용해 보시겠어요?");
 ds_map_add(m,"Only the family may enter this sanctuary.","이 성소에는 가족만 들어갈 수 있다.");
 ds_map_add(m,"Come on Run! I bet 1000 Arcs on you Hu HU HU HU HUghg!.","어서 달려! 네게 아크 1000개를 걸었단 말이야! 후후후후후!");
 ds_map_add(m,"I'll do it sir, don't worry. Line now you've gone too far give it some space.","선생님, 제가 할게요. 걱정 마세요. 라인, 이번엔 네가 너무 심했어. 거리를 좀 둬.");
 ds_map_add(m,"Please someone get this girl out of my vital space.","누가 이 여자를 내 사적인 공간에서 좀 치워 줘요. 제발.");
 ds_map_add(m,"OH! *approaches at too uncomfortable a distance* thank you thank you thank you very much sir I will use your wisdom with care.","오! *몹시 불편할 정도로 가까이 다가온다* 감사합니다, 감사합니다, 정말 감사합니다, 선생님! 선생님의 지혜를 신중하게 활용하겠습니다.");
 ds_map_add(m,"Eheee... I guess every time I'm going to do something that involves force I pound my chest for some reason it makes me feel stronger.","에헤…… 힘을 써야 하는 일을 할 때마다 가슴을 두드리는 것 같아. 이유는 모르겠지만 그러면 더 강해진 기분이 들어.");
 ds_map_add(m,"Can you tell me how to get the strength of a gorilla please please pleaseeeeee?","고릴라의 힘을 얻는 방법을 알려 주실 수 있나요? 제발요, 제발, 제에에발요?");
 ds_map_add(m,"... The last time I checked, I was indeed.","……마지막으로 확인했을 때는, 확실히 그랬어.");
 ds_map_add(m,"Ho hello are you a gorilla?","아, 안녕하세요. 고릴라세요?");
 ds_map_add(m,"No no no we are just travelers looking for our friend ;c.","아니, 아니, 아니. 저희는 그냥 친구를 찾으러 온 여행자예요 ;c.");
 ds_map_add(m,"Oh I *hip* see, you are allies of the empire trying to erase part of history.","아, *딸꾹* 그렇군. 너희는 역사의 일부를 지우려는 제국의 동맹이구나.");
 ds_map_add(m,"hey miss hero we're a little busy it was good your story and all, but we have to keep moving.","이봐, 여전사 아가씨. 우린 좀 바빠. 네 이야기는 잘 들었지만, 계속 가야 해.");
 ds_map_add(m,"doesn't matter! you should know this world is forgetting *hip*roes and I'll make them remember.","상관없어! 이 세상은 영*딸꾹*웅들을 잊어 가고 있어. 내가 그들을 기억하게 만들겠어.");
 ds_map_add(m,"Mmm ... n-no, i didn't know i'm half elf half succubus actually.","음…… 아, 아니요. 사실 전 반쪽은 엘프고 반쪽은 서큐버스예요.");
 ds_map_add(m,"Thats nice really nice you *hip* know my father protect all the humanity and they dont even know *hip*t.","정말 멋지군, 정말 멋져. 너도 *딸꾹* 알잖아. 내 아버지는 인류 전체를 지키시는데, 사람들은 그 사실조차 *딸꾹* 모르지.");
 ds_map_add(m,"Eh, I'm not the bartender but if you want I'll call her.","어, 전 바텐더가 아니지만 원하시면 그녀를 불러 드릴게요.");
 ds_map_add(m,"Hey, yo skinny girl do something good and bring me some beer *hip*.","이봐, 야, 빼빼 마른 아가씨. 좋은 일 좀 해. 맥주 가져와 *딸꾹*.");
 ds_map_add(m,"You know what, I'm not going to go kill the demon that steals the beer shipments. it's my freaking vacation!","있잖아, 맥주 보급품을 훔치는 악마를 잡으러 가긴 싫어. 젠장, 난 휴가 중이라고!");
 ds_map_add(m,"AHHGG! I came to relax on the only island that has no alcohol.","아아악! 술이 없는 유일한 섬에서 쉬려고 여기까지 왔는데.");
 ds_map_add(m,"Line ... let's get out of here.","라인…… 여기서 나가자.");
 ds_map_add(m,"Oh don't worry i have being in this place before. i will repair it and problem solve.","아, 걱정 마. 예전에 여기 와 본 적 있어. 내가 고치면 문제도 해결될 거야.");
 ds_map_add(m,"I-it's not funny, you broke the table with the fight","이, 이건 웃을 일이 아니야. 너희가 싸우다가 탁자를 부쉈잖아.");
 ds_map_add(m,"And I think with this fight the effect of the beer were off Hahaha.","이번 싸움으로 맥주 기운도 다 날아간 것 같네. 하하하.");
 ds_map_add(m,"You fight very well, I don't think you're with the weaklings of the empire.","싸움 실력이 꽤 좋군. 제국의 약골들과 한패는 아닌 것 같아.");
 ds_map_add(m,"I will repair it after a few drinks haha.","술 몇 잔 더 마신 다음에 고칠게. 하하.");
 ds_map_add(m,"it doesn't matter break his ass Line!","상관없어! 라인, 놈의 엉덩이를 박살 내!");
 ds_map_add(m,"Woomy!","우미!");
 ds_map_add(m,"So you are the prankster!","네가 바로 그 장난꾸러기구나!");
 ds_map_add(m,"Ngyes!","응예스!");
 ds_map_add(m,"I need you to come with me because of you an innocent woman will go to jail!","나와 함께 가야겠어. 너 때문에 무고한 여자가 감옥에 갈 판이야!");
 ds_map_add(m,"Woomy Woomy!","우미, 우미!");
 ds_map_add(m,"I guess as long as she doesn't make any more trouble it's okay for her to stay here.","더 이상 말썽을 피우지 않는다면 여기 있어도 괜찮을 것 같아.");
 ds_map_add(m,"I guess when he fled he found this cave.","그가 도망치다가 이 동굴을 발견했나 봐.");
 ds_map_add(m,"Why is it here anyway?","그런데 대체 그게 왜 여기 있지?");
 ds_map_add(m,"Oh... could happen to anyone.","아…… 누구에게나 일어날 수 있는 일이야.");
 ds_map_add(m,"I also remember when you beat him, he attacked you and you fainted and pissed yourself, what a day.","네가 그놈을 이겼을 때도 기억나. 놈이 반격해서 네가 기절하고 바지에 오줌까지 쌌잖아. 참 대단한 날이었지.");
 ds_map_add(m,"Look Lili is the cat that almost put Callie in jail, well, she end up in jail anyways but you know.","저기 봐, 릴리야. 캘리를 감옥에 보낼 뻔했던 그 고양이. 뭐, 캘리는 결국 감옥에 갔지만, 무슨 말인지 알지?");
 ds_map_add(m,"RAWR!","크르릉!");
 ds_map_add(m,"I hope Whipsie is doing well on Tricotex.","윕시가 트리코텍스에서 잘 지내고 있으면 좋겠어.");
 ds_map_add(m,"This farm reminds me of home.","이 농장을 보니 고향 생각이 나.");
 ds_map_add(m,"Take it for granted me and Line can against everything!","걱정 마. 나와 라인이 힘을 합치면 뭐든 해낼 수 있어!");
 ds_map_add(m,"I guess a little help wouldn't hurt, but I'll have to see if they are both up to the task to be my partner.","조금 도와주는 건 나쁘지 않겠지. 하지만 둘 다 내 파트너가 될 자격이 있는지는 확인해 봐야겠어.");
 ds_map_add(m,"Sorry sam for her lack of delicacy, she a big fan of you.. and so am I, but I mean who doesn't hehe.","샘, 저 애가 무례하게 굴어서 미안해요. 당신의 열렬한 팬이거든요…… 저도 그렇고요. 뭐, 누가 팬이 아니겠어요? 헤헤.");
 ds_map_add(m,"Wow really can we help to capture it ?!","와, 정말요? 저희도 그걸 잡는 걸 도와드려도 돼요?!");
 ds_map_add(m,"For now she is the one who takes care of the city, I come to this island because a Tricotex criminal came here.","지금은 그녀가 도시를 지키고 있어. 난 트리코텍스의 범죄자가 이 섬으로 도망쳐 와서 여기 온 거야.");
 ds_map_add(m,"Yeah and where is your partner Whipsy :c?","그런데 파트너인 윕시는 어디 있어요? :c");
 ds_map_add(m,"Oh well, actually we are not from here, but we knew your stories of how you saved the streets of Tricotex while we travel.","아, 사실 저희는 여기 출신이 아니에요. 여행 중에 트리코텍스의 거리를 구해 낸 당신의 이야기를 들었어요.");
 ds_map_add(m,"Wow, I didn't think anyone would recognize me around here.","와, 여기서 나를 알아보는 사람이 있을 줄은 몰랐어.");
 ds_map_add(m,"H-hi you are Sa-Sam the hero o-of the Tricotex right :O?","아, 안녕하세요. 트, 트리코텍스의 영웅 샘, 맞으시죠? :O");
 ds_map_add(m,"You come for the rematch?","설욕하러 왔어?");
 ds_map_add(m,"Haha it's very simple, I do a lot of impact damage.","하하, 아주 간단해. 난 충격 피해를 많이 줘.");
 ds_map_add(m,"I still want to accompany you.","그래도 난 너와 함께하고 싶어.");
 ds_map_add(m,"sorry same I have other things to do.","미안해, 샘. 다른 할 일이 있어.");
 ds_map_add(m,"If you don't have time to catch the criminal, we can part ways for a while.","범인을 잡을 시간이 없다면 잠시 따로 움직여도 돼.");
 ds_map_add(m,"No sorry, could you tell me again how you fight?","아니, 미안해. 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"Sorry same I have other things to do.","미안해, 샘. 다른 할 일이 있어.");
 ds_map_add(m,"Let's catch that criminal <3.","그 범인을 잡으러 가자 <3.");
 ds_map_add(m,"Now you have time to help me catch the criminal?","이제 범인을 잡는 걸 도와줄 시간은 있어?");
 ds_map_add(m,"Come back as you were!","원래 모습으로 돌아와!");
 ds_map_add(m,"I do a lot of magic damage that's all you need to know.","난 마법 피해를 많이 줘. 네가 알아야 할 건 그게 전부야.");
 ds_map_add(m,"I am sorry I have to go to the bathroom :c.","미안, 화장실에 가야 해 :c.");
 ds_map_add(m,"Sorry but, could you tell me again how you fight?","미안한데, 네 전투 방식이 어떤지 다시 설명해 줄래?");
 ds_map_add(m,"I really want to help you Faye.","정말 널 돕고 싶어, 페이.");
 ds_map_add(m,"Hey, if you don't have time to help me just say it, it will be faster for me to look for myself.","이봐, 도와줄 시간이 없으면 그냥 말해. 내가 직접 찾는 게 더 빠를 테니까.");
 ds_map_add(m,"Oh ok.. lets go.","아, 알겠어…… 가자.");
 ds_map_add(m,"I don't want to waste your time. :c","네 시간을 낭비하고 싶지 않아. :c");
 ds_map_add(m,"If you want to help me just don't waste my time.","도와주고 싶다면 내 시간 낭비만 하지 마.");
 ds_map_add(m,"I will rest a little here.","여기서 잠깐 쉴게.");
 ds_map_add(m,"I think it's southeast from here.","여기서 남동쪽인 것 같아.");
 ds_map_add(m,"Where is she now?","그녀는 지금 어디 있어?");
 ds_map_add(m,"Yes, I think a cow that escaped from the farm ran into the idiot that did this to me.","그래. 농장에서 탈출한 소 한 마리가 나를 이렇게 만든 그 멍청이와 부딪친 것 같아.");
 ds_map_add(m,"Do you know where he went or if anyone saw him?","그가 어디로 갔는지, 아니면 본 사람이 있는지 알아?");
 ds_map_add(m,"Thanks, I came to buy some milk and something covered me in this stuff.","고마워. 우유를 사러 왔는데, 누군가 이걸 온몸에 뒤집어씌웠어.");
 ds_map_add(m,"Calm down, I will help you.","진정해. 내가 도와줄게.");
 ds_map_add(m,"Shit somebody help me get this out","젠장, 누가 이거 좀 벗겨 줘!");
 ds_map_add(m,"Yeah, she went to the cultivation of nana leaves","응, 그녀는 나나 잎을 재배하는 곳으로 갔어.");
 ds_map_add(m,"Thanks, I came from buying some special milk and something covered me with this thing.","고마워. 특제 우유를 사 왔는데, 누군가 이걸 온몸에 뒤집어씌웠어.");
 ds_map_add(m,"Shit somebody help me get this out.","젠장, 누가 이거 좀 벗겨 줘!");
 ds_map_add(m,"Oh ok, if that is what you want but let me tell you that I fight a little different than the rest.","아, 좋아. 네가 원한다면야. 하지만 내 전투 방식은 다른 사람들과 조금 달라.");
 ds_map_add(m,"You beat him ?! Please fight me in a sparring match.","그를 이겼다고?! 제발 나와 대련해 줘.");
 ds_map_add(m,"I know you will, with enough practice you will beat him like I did <3.","넌 분명 해낼 거야. 충분히 연습하면 나처럼 그를 이길 수 있을 거야 <3.");
 ds_map_add(m,"I would like to be stronger to face it again.","다시 맞서 싸울 수 있도록 더 강해지고 싶어.");
 ds_map_add(m,"I am happy to hear you are ok.","네가 무사하다니 기뻐.");
 ds_map_add(m,"Thanks for the help, traveler.","도와줘서 고마워, 여행자.");
 ds_map_add(m,"*Line blushes* Y-yes probably not hehe.","*라인이 얼굴을 붉힌다* 아, 네. 아마 안 될 것 같아요, 헤헤.");
 ds_map_add(m,"Besides, I don't think your way of fighting will work for me anyway hahaha.","게다가 네 전투 방식은 어차피 나한테 안 통할 것 같아. 하하하.");
 ds_map_add(m,"I need to practice more but thanks anyway.","아직 더 연습해야겠어. 그래도 고마워.");
 ds_map_add(m,"Proklyat'ye.","젠장.");
 ds_map_add(m,"AHhh. my head how did I get here, Hi-Hikari is that you?","아아…… 머리가 아파. 내가 어떻게 여기 온 거지? 히, 히카리, 너야?");
 ds_map_add(m,"I love this part of town, although playing pachinco nothing beats it. You should come to my store maybe you will win a prize <3","난 이 동네가 좋아. 그래도 파친코만큼 재밌는 건 없지. 우리 가게에 와 봐. 경품을 탈지도 몰라 <3.");
 ds_map_add(m,"Isn't it precious? This river is so peaceful, a perfect view for my retirement.","정말 아름답지 않아? 이 강은 참 평화로워. 은퇴 후에 보기 딱 좋은 풍경이야.");
 ds_map_add(m,"When you have the money come see me on the top floor of the hotel.","돈이 준비되면 호텔 꼭대기 층으로 날 찾아와.");
 ds_map_add(m,"If you can get 1000 arcs I'll give you a girlfriend deal hehe.","아크 1000개를 가져오면 여자친구 패키지를 해 줄게. 헤헤.");
 ds_map_add(m,"How much?","얼마나?");
 ds_map_add(m,"Haha so cute I'm sorry but I charged large amounts of money.","하하, 귀엽기도 하지. 미안하지만 난 비싸게 받아.");
 ds_map_add(m,"hey she's a shy succubus why don't you help her out for old times.","이봐, 수줍음 많은 서큐버스잖아. 옛정도 있는데 좀 도와주지 그래?");
 ds_map_add(m,"Yes but that was a long time ago.","맞아. 하지만 아주 오래전 일이야.");
 ds_map_add(m,"Yes- yes I think you were this escort for shy succubus.","네, 네. 당신은 수줍음 많은 서큐버스를 상대하는 에스코트였던 것 같아요.");
 ds_map_add(m,"Oh so you do know me.","아, 그럼 날 알고 있구나.");
 ds_map_add(m,"Oh! I remembered she was in the XXX magazines that your mother had.","아! 네 엄마가 갖고 있던 성인 잡지에서 본 것 같아.");
 ds_map_add(m,"I don't think a girl with such innocent looks knows who I am.","이렇게 순진해 보이는 아가씨가 내가 누군지 알 리 없다고 생각했어.");
 ds_map_add(m,"He-hello, do I know you from somewhere?","저, 저기요. 우리 어디선가 만난 적 있나요?");
 ds_map_add(m,"I can't wait for you to have the money line, haha I haven't done this for a long time.","라인, 네가 돈을 가져오길 기다릴 수가 없네. 하하, 이런 건 정말 오랜만이거든.");
 ds_map_add(m,"And you already know the prize <3.","그리고 상품은 이미 알고 있겠지 <3.");
 ds_map_add(m,"The first to undress the other wins.","먼저 상대의 옷을 벗기는 사람이 이기는 거야.");
 ds_map_add(m,"If you fail to undress I will take off one of your clothes.","옷을 벗기는 데 실패하면 네 옷 중 하나를 내가 벗길 거야.");
 ds_map_add(m,"You will have attempts to undress me and you have to pay attention to where to touch.","내 옷을 벗길 기회는 몇 번 있어. 어디를 만져야 하는지 잘 살펴봐.");
 ds_map_add(m,"Oh you don't have enough Arcs.","아, 아크가 부족하네.");
 ds_map_add(m,"Oh ok i will waiting here.","아, 좋아. 여기서 기다릴게.");
 ds_map_add(m,"Well to start heating things up we'll play a little game.","분위기를 달구기 위해 먼저 작은 게임을 하자.");
 ds_map_add(m,"No right now.","지금은 안 돼.");
 ds_map_add(m,"So Line you want to buy ten minute in heaven <3?","그래서, 라인. '천국에서의 10분'을 살래? <3");
 ds_map_add(m,"sorry it's a bad habit from the past let's try again <3.","미안해. 예전 버릇이 나왔네. 다시 해 보자 <3.");
 ds_map_add(m,"You left me alone and naked in bed, and the maid also saw me ;C.","날 침대에 알몸으로 혼자 내버려 뒀잖아. 하녀까지 날 봤다고 ;C.");
 ds_map_add(m,"haha it looks like you learned a lot <3.","하하, 많이 배운 것 같네 <3.");
 ds_map_add(m,"Oh but something bad will happen but not to me.","아, 나쁜 일이 생기긴 하겠지. 하지만 나한테 일어나는 건 아니야.");
 ds_map_add(m,"She says get out of this place oh you're an idiot something could happen to you.","그녀가 여기서 나가라고 하잖아. 이 바보야, 무슨 일이 생길 수도 있다고.");
 ds_map_add(m,"Excuse? What the fuck did you say.","뭐라고요? 방금 씨발 뭐라고 했어?");
 ds_map_add(m,"Hey, what are you doing here? This is not a place for children.","이봐, 여기서 뭐 하는 거야? 여긴 어린애가 올 곳이 아니야.");
 ds_map_add(m,"And Baku still hasn't come back from the bathroom I'm starting to lose my patience.","바쿠는 아직도 화장실에서 안 돌아왔어. 슬슬 인내심이 바닥나겠는데.");
 ds_map_add(m,"This sucks, there is no alcohol and everyone thinks I'm a minor.","최악이야. 술도 없고, 다들 날 미성년자로 생각해.");
 ds_map_add(m,"I think the next thing I'll do is go to the farm, dress like a cow and get milked.","다음엔 농장에 가서 소처럼 차려입고 젖을 짜 달라고 해야겠어.");
 ds_map_add(m,"She says get out of this place something could happen to you.","그녀가 여기서 나가라고 해. 무슨 일이 생길 수도 있대.");
 ds_map_add(m,"Excuse me, What the fuck did you say?.","실례라고요? 방금 씨발 뭐라고 했어요?");
 ds_map_add(m,"Fuck you.","엿 먹어.");
 ds_map_add(m,"Looks Like you have nowhere to run.","보아하니 도망칠 곳은 없는 것 같군.");
 ds_map_add(m,"Hu-hu-hu.","후, 후, 후.");
 ds_map_add(m,"Mmm...","음……");
 ds_map_add(m,"After this I hope you rectify what you said.","이 일이 끝나면 네가 했던 말을 바로잡길 바라.");
 ds_map_add(m,"So she's probably fine.","그럼 그녀는 괜찮을 거야.");
 ds_map_add(m,"Well.. this is an island to free yourself and explore sexuality freely. Most likely, she's been fucking someone since yesterday.","음…… 이 섬은 자유롭게 자신을 해방하고 성적 욕망을 탐구하는 곳이잖아. 그녀는 아마 어제부터 누군가와 떡을 치고 있을걸.");
 ds_map_add(m,"I guess you're right thanks that calms me down a bit.","네 말이 맞는 것 같아. 고마워, 조금 진정됐어.");
 ds_map_add(m,"Stay calm if something bad has happened, the most likely thing is that the guards would have already told you something.","진정해. 무슨 나쁜 일이 생겼다면 경비병들이 벌써 너한테 알려 줬을 가능성이 커.");
 ds_map_add(m,"LiLi calm Alina","릴리가 알리나를 진정시킨다");
 ds_map_add(m,"Line calm Alina","라인이 알리나를 진정시킨다");
 ds_map_add(m,"I won a contest to travel to this island with my girlfriend but she went out yesterday to buy and has not returned yet.","여자친구와 이 섬으로 여행을 갈 수 있는 대회에서 우승했어. 그런데 여자친구가 어제 물건을 사러 나간 뒤 아직 돌아오지 않았어.");
 ds_map_add(m,"But why would it be a bad idea to come? seems like a nice place.","그런데 왜 여기 오면 안 된다는 거야? 좋은 곳 같은데.");
 ds_map_add(m,"Oh sorry I heard as I passing by.","아, 미안해. 지나가다가 들었어.");
 ds_map_add(m,"Coming to this island was a bad idea.","이 섬에 온 건 실수였어.");
 ds_map_add(m,"Lili!! ok im sorry for everything ok bye.","릴리!! 알았어, 다 미안해. 됐지? 잘 있어.");
 ds_map_add(m,"Yeah there's no need to fight.","그래, 싸울 필요는 없어.");
 ds_map_add(m,"I'm sorry for making a fight, it was wrong.","싸움을 일으켜서 미안해. 내가 잘못했어.");
 ds_map_add(m,"Thank you you are nothing like your fairy friend.","고마워. 네 요정 친구와는 딴판이네.");
 ds_map_add(m,"While I'm looking for my friend I'll look for yours, don't worry, everything will be fine.","내 친구를 찾는 동안 네 친구도 찾아볼게. 걱정 마. 다 잘될 거야.");
 ds_map_add(m,"I'm so sorry for what my fairy said.","내 요정이 한 말은 정말 미안해.");
 ds_map_add(m,"It has been a tiring day I will go to look for her after a nap.","오늘은 너무 피곤해. 잠깐 낮잠을 자고 나서 그녀를 찾으러 갈게.");
 ds_map_add(m,"Oh poor little thing it's ok if it's true I will help you.","아이고, 가엾기도 해라. 괜찮아. 사실이라면 내가 도와줄게.");
 ds_map_add(m,"Blub blub blip :c","뽀글뽀글, 삑 :c");
 ds_map_add(m,"AHHHH that's what he said! Believe me or not that's your problem.","아아아! 그가 그렇게 말했다고! 믿든 말든 네 마음이지.");
 ds_map_add(m,"Mmm really he said? I do not believe you at all Lili, do you know the story of peter and the wolf?","음, 정말 그랬다고? 릴리, 난 네 말을 전혀 믿지 않아. '양치기 소년' 이야기 알아?");
 ds_map_add(m,"He said that his owner is out of control, they went to drink but on the way someone stole the key that his mistress uses as a demonic seal.","주인이 통제력을 잃었다고 했어. 술을 마시러 가던 길에 누군가 여주인이 악마 봉인에 쓰는 열쇠를 훔쳐 갔대.");
 ds_map_add(m,"What did he say?","뭐라고 했어?");
 ds_map_add(m,"Bleb Bleb blub blub bleb,blub blub, blip blop blop.","뽀글뽀글 뽀글뽀글 뽀글, 뽀글뽀글, 삑뽁뽁.");
 ds_map_add(m,"Ya easy, I'll take care of it \nHey what's going on? Why is that thing moving like crazy if you're having sex in there at least try to keep a low profile.","그래, 간단하네. 내가 처리할게.\n이봐, 무슨 일이야? 안에서 왜 저렇게 미친 듯이 움직이는 거야? 안에서 섹스라도 하는 거면 적어도 조용히 좀 해.");
 ds_map_add(m,"Blob blip blop D:!","뽀글 삑뽁뽁 D:!");
 ds_map_add(m,"Oh Mmmm blup, blep blip?","아, 으음, 뽀글. 뽀글 삑?");
 ds_map_add(m,"Bleb Bleb blub blub bleb.","뽀글뽀글 뽀글뽀글 뽀글.");
 ds_map_add(m,"Blurpblupblip?","뽀글뽀글?");
 ds_map_add(m,"Blupblurulip!","뽀글뽀글!");
 ds_map_add(m,"Fuck it Line is fight or nothing!","젠장, 라인. 싸우든가, 아니면 끝장이야!");
 ds_map_add(m,"Dissa-what?!","사라… 뭐라고?!");
 ds_map_add(m,"Bu-but I do not have much money ;c.","하, 하지만 돈이 별로 없어요 ;c.");
 ds_map_add(m,"I'm sorry but you have to disappear or pay your bill as a member.","죄송하지만 사라지시거나 회원으로서 요금을 지불하셔야 합니다.");
 ds_map_add(m,"This is a secret place for members only, and the cost to be one is 10.000 arcs per month.","이곳은 회원 전용 비밀 장소이며, 회원 가입비는 한 달에 10.000 아크입니다.");
 ds_map_add(m,"I am Sieki and I really meant how you got here?","난 시에키야. 내가 정말 궁금한 건 네가 어떻게 여기 들어왔느냐는 거야.");
 ds_map_add(m,"Ohmm... a friend told me here I could get some information about the girls on the island? I am looking for Sieki.","으음…… 친구가 여기서 섬에 사는 여자들에 대한 정보를 얻을 수 있다고 했어요. 시에키를 찾고 있어요.");
 ds_map_add(m,"You are the traveler what are you doing here?!","네가 그 여행자구나. 여긴 어떻게 온 거야?!");
 ds_map_add(m,"Wait for me in the forest south of the hospital.","병원 남쪽 숲에서 날 기다려.");
 ds_map_add(m,"Dont worry I will take care of this demond","걱정 마. 이 악마는 내가 처리할게.");
 ds_map_add(m,"Thank you very much for helping us so much we started it for you when we started selling the special milk of these cows.","그동안 정말 많이 도와줘서 고마워. 우리가 이 소들의 특제 우유를 팔기 시작한 것도 너 덕분이야.");
 ds_map_add(m,"Um, yeah, it is okay,","음, 네. 괜찮아요.");
 ds_map_add(m,"Can you return it to the church? I would appreciate it a lot since I'm still organizing the cases of the other relics.","그걸 교회에 돌려줄 수 있나요? 다른 성유물 사건들도 정리 중이라 정말 큰 도움이 될 거예요.");
 ds_map_add(m,"(Phew, how stressful.) Well, it does not matter. The important thing is that the relic is back.","(휴, 정말 긴장되네.) 뭐, 상관없어. 중요한 건 성유물이 돌아왔다는 거야.");
 ds_map_add(m,"Hmm, well, when the robbery happened, you weren't even on the island. I guess I can rule you out as a suspect.","음, 강도 사건이 일어났을 때 넌 섬에 오지도 않았잖아. 용의선상에서 제외해도 되겠어.");
 ds_map_add(m,"*Starts to sweat but maintains eye contact *... Crazy, right?","*땀을 흘리기 시작하지만 시선은 피하지 않는다*…… 말도 안 되지?");
 ds_map_add(m,"But your story still seems strange...","그래도 네 이야기는 여전히 좀 수상해……");
 ds_map_add(m,"Hmm, the witnesses said the thief went south of the church.","음, 목격자들 말로는 도둑이 교회 남쪽으로 갔다고 해.");
 ds_map_add(m,"I-it's possible that the person got l-lost or went m-mad in the forest and ended up l-leaving it behind. I-I didn't find anything else besides the relic.","그, 그 사람이 숲에서 길을 잃거나 미, 미쳐 버려서 거기에 두고 갔을 수도 있어요. 저, 저는 성유물 말고는 아무것도 찾지 못했어요.");
 ds_map_add(m,"Wait, but how is that possible? Why would it be lying there?!","잠깐, 그게 어떻게 가능하지? 왜 거기에 놓여 있었던 거야?!");
 ds_map_add(m,"Captain, I found a relic in the forest.","대장님, 숲에서 성유물을 발견했습니다.");
 ds_map_add(m,"Have you left the relic at the church already?","성유물은 이미 교회에 가져다 놓았어?");
 ds_map_add(m,"Yes, we will be exemplary citizens of society!","네, 저희는 사회의 모범 시민이 될 거예요!");
 ds_map_add(m,"We already know what to do Line!","라인, 이제 어떻게 해야 할지 알겠어!");
 ds_map_add(m,"Very well, I appreciate you staying safe.","좋아. 무사히 돌아와 줘서 고맙다.");
 ds_map_add(m,"I won't even think about the place, that's how dedicated I am to not making trouble!","그 장소는 생각조차 하지 않겠어. 문제를 일으키지 않겠다는 내 의지가 얼마나 확고한지 알겠지!");
 ds_map_add(m,"Lastly, there is a scammer posing as a guard you can see her description on the flyers around town and if I were to say one place you shouldn't go it would be the bridge that leads to the magenta swamp.","마지막으로, 경비병을 사칭하는 사기꾼이 있어. 마을 곳곳의 전단지에서 인상착의를 확인할 수 있지. 한 곳만 피해야 한다면 마젠타 늪으로 이어지는 다리야.");
 ds_map_add(m,"I think I'm familiar with your description, we'll stay out of it <3","말씀하신 사람, 어디서 본 것 같아요. 그쪽은 피할게요 <3.");
 ds_map_add(m,"Sometimes from time to time, a foreign heroine comes to catch criminals escaping from her sector, so if you see a lady in a bikini with light blue hair around here in the jail-farm, don't bother her.","가끔 다른 지역의 여영웅이 자기 관할에서 도망친 범죄자를 잡으러 오기도 해. 그러니 감옥 농장 근처에서 연한 파란 머리에 비키니를 입은 여자를 보더라도 방해하지 마.");
 ds_map_add(m,"Noted :O","명심할게요 :O");
 ds_map_add(m,"Right, first of all stay away from the group of guards in the bar where they are planning how to defeat a demon that steals supplies.","그래. 우선 술집에 있는 경비병 무리부터 피해. 보급품을 훔치는 악마를 어떻게 물리칠지 의논하고 있거든.");
 ds_map_add(m,"... and which places should we not go to stay out of the way :v?","……그럼 방해하지 않으려면 어디로 가야 하죠? :v");
 ds_map_add(m,"No, stay out of the issue, citizens.","안 돼. 시민들은 이 일에 끼어들지 마.");
 ds_map_add(m,"Hey, what if we help solve those problems?","이봐, 우리가 그 문제들을 해결하는 걸 도우면 어때?");
 ds_map_add(m,"The barn will be up and running again once we have dealt with the problems.","문제들을 해결하고 나면 헛간도 다시 운영할 수 있을 거야.");
 ds_map_add(m,"We are at the limit because of the increase in crime on the islands.","섬의 범죄가 늘어나서 우리도 한계에 다다랐어.");
 ds_map_add(m,"Now you cannot enter the barn.","이제 헛간에 들어갈 수 없어.");
 ds_map_add(m,"Remember, don't be heroes, not everyone can be a guard of Elira.","기억해. 영웅 행세는 하지 마. 누구나 엘리라의 경비병이 될 수 있는 건 아니야.");
 ds_map_add(m,"But you can ask local owners or even artists on the streets.","하지만 현지 상인이나 길거리 예술가들에게 물어볼 수는 있지.");
 ds_map_add(m,"I see a lot of people a day, so I couldn't tell you that I did see her.","하루에도 정말 많은 사람을 만나서, 그 여자를 본 적이 있다고는 말 못 하겠어.");
 ds_map_add(m,"Oh thank you very much, by chance you have seen a woman with wings on her head.","아, 정말 감사합니다. 혹시 머리에 날개가 달린 여자를 보셨나요?");
 ds_map_add(m,"Welcome to the cariel town.","카리엘 마을에 오신 걸 환영합니다.");
 ds_map_add(m,"Oh-ok :c.","아, 알겠어요 :c.");
 ds_map_add(m,"I'm sorry miss but it's closed for now.","죄송합니다, 아가씨. 지금은 문을 닫았습니다.");
 ds_map_add(m,"The great captain gave the order to take care of the town while she searches for the demon.","대장님께서 악마를 찾으러 가시는 동안 마을을 지키라고 명령하셨어요.");
 ds_map_add(m,"Then what do we do?","그럼 우린 어떻게 하지?");
 ds_map_add(m,"That bastard.","그 개자식.");
 ds_map_add(m,"Everything indicates that so far.","지금까지는 모든 정황이 그렇게 말해 주고 있어.");
 ds_map_add(m,"Is the cause of alcohol not reaching the town?","술이 마을에 도착하지 않는 이유가 그거야?");
 ds_map_add(m,"The traveler defeated a succubus but this is a high rank demon.","여행자가 서큐버스를 물리쳤다고는 하지만, 이번엔 고위 악마야.");
 ds_map_add(m,"A demon? I heard a traveler beat her.","악마라고? 여행자가 그 여자를 이겼다고 들었는데.");
 ds_map_add(m,"Yes, apparently there is something on the outskirts of town.","그래. 마을 외곽에 뭔가 있는 모양이야.");
 ds_map_add(m,"What seriously?","뭐라고, 정말?");
 ds_map_add(m,"This for you traveler!!!","여행자, 이건 너를 위한 거야!!!");
 ds_map_add(m,"I think this is the last beer in the bar.","이게 술집에 남은 마지막 맥주인 것 같아.");
 ds_map_add(m,"I'm finall *hip* drunk enough to tell Callie to go out with me.","드디어 *딸꾹* 캘리에게 데이트 신청을 할 만큼 취했어.");
 ds_map_add(m,"No drinks.. no courage.","술이 없으면…… 용기도 없어.");
 ds_map_add(m,"Life makes sense again <3 !!","이제야 인생이 다시 의미 있어졌어 <3!!");
 ds_map_add(m,"I should patrol while I wait for the next shipment.","다음 보급품이 도착할 때까지 순찰이나 해야겠어.");
 ds_map_add(m,"Finally Beer!!!!","드디어 맥주다!!!!");
 ds_map_add(m,"This is so boring.","정말 지루해.");
 ds_map_add(m,"yes unfortunately, that's why I must hurry","그래, 안타깝게도 맞아. 그래서 서둘러야 해.");
 ds_map_add(m,"what and were there people there ?!","뭐라고? 거기에 사람이 있었다고?!");
 ds_map_add(m,"I'm sorry miss there was a landslide will be available when I manage to open the way.","죄송합니다, 아가씨. 산사태가 났어요. 길을 뚫으면 다시 지나갈 수 있을 겁니다.");
 ds_map_add(m,"Please, can you go see how the miners are, I would go but I'm very tired.","부탁인데 광부들이 괜찮은지 가서 확인해 줄래? 나도 가고 싶지만 너무 지쳤어.");
 ds_map_add(m,"Sound cooler.","그게 더 멋지게 들리네.");
 ds_map_add(m,"Why Lilian?","왜 릴리안이라고 부르지?");
 ds_map_add(m,"Lilian for you.","넌 날 릴리안이라고 불러.");
 ds_map_add(m,"Understood Miss Faery.","알겠습니다, 요정 아가씨.");
 ds_map_add(m,"The great captain told me to stay here until she came back.","대장님이 돌아오실 때까지 여기서 기다리라고 하셨어.");
 ds_map_add(m,"there is a dangerous demon prowling, I advise you to go to the town which is a safer place","위험한 악마가 주변을 돌아다니고 있어. 더 안전한 마을로 돌아가는 게 좋겠어.");
 ds_map_add(m,"Sorry Miss the pass to the forest is closed.","죄송합니다, 아가씨. 숲으로 가는 통로는 폐쇄됐습니다.");
 ds_map_add(m,"Now let us pass!","이제 지나가게 해!");
 ds_map_add(m,"Excuse me? We are the bounty hunters hired by the great captain to kill the demond.","뭐라고요? 저희는 대장님께 고용되어 악마를 죽이러 온 현상금 사냥꾼입니다.");
 ds_map_add(m,"I'll stay here guarding.","난 여기서 경비를 설게.");
 ds_map_add(m,"I will rest here a little.","여기서 잠깐 쉴게.");
 ds_map_add(m,"Excuse me?","뭐라고요?");
 ds_map_add(m,"these guards are idiots they didn't even see the trail.","이 경비병들은 멍청해. 흔적조차 못 알아봤잖아.");
 ds_map_add(m,"I will go see maybe we will find something.","내가 가서 볼게. 뭔가 찾을 수 있을지도 몰라.");
 ds_map_add(m,"Look Line there's a trace of this thing coming behind the red tent.","라인, 저기 봐. 저것의 흔적이 빨간 천막 뒤쪽으로 이어져 있어.");
 ds_map_add(m,"Ok calm down I will help you get this thing off.","좋아, 진정해. 내가 이걸 벗겨 줄게.");
 ds_map_add(m,"I would not know very well which of her children it could be, but I do know that it was a lady cat.","그녀의 자식들 중 누구인지는 잘 모르겠지만, 범인은 고양이 여성이었어.");
 ds_map_add(m,"Sir, did you see where the culprit went, was it really the daughter of the cat that sells clothes the culprit?.","선생님, 범인이 어디로 갔는지 보셨나요? 정말 옷을 파는 고양이 여자의 딸이 범인인가요?");
 ds_map_add(m,"Seems to be waking up.","깨어나려는 것 같아.");
 ds_map_add(m,"Hey look Lili.","이봐, 릴리. 저것 좀 봐.");
 ds_map_add(m,"Tell me something I do not know.","내가 모르는 걸 말해 봐.");
 ds_map_add(m,"We are the best guards in town.","우린 마을 최고의 경비병이야.");
 ds_map_add(m,"Let's look for the guard who was left unconscious.","의식을 잃은 채 남겨진 경비병을 찾아보자.");
 ds_map_add(m,"Yea even the culprit could know something about Ava and the strange things that happen on the island.","그래. 범인도 에이바에 관한 일이나 섬에서 벌어지는 이상한 일들에 대해 뭔가 알고 있을지 몰라.");
 ds_map_add(m,"Lili we must help them they do not seem to be lying.","릴리, 저들을 도와야 해. 거짓말하는 것 같지는 않아.");
 ds_map_add(m,"Mama I swear I didn't it was a blue cat.","엄마, 맹세코 제가 한 게 아니에요. 파란 고양이였어요.");
 ds_map_add(m,"What!!","뭐라고!!");
 ds_map_add(m,"Due  she is a minor, you will have to pay the fine at the jail-farm.","그녀는 미성년자이므로 감옥 농장에서 벌금을 내셔야 합니다.");
 ds_map_add(m,"One of her daughter's pranks left one of the guards unconscious.","그녀의 딸이 벌인 장난 때문에 경비병 한 명이 의식을 잃었습니다.");
 ds_map_add(m,"I'm afraid that is more serious than that.","유감스럽게도 그보다 더 심각한 문제입니다.");
 ds_map_add(m,"Now leave if you are not going to buy something.","물건을 살 게 아니라면 이제 나가 주세요.");
 ds_map_add(m,"Oh c'mon are just pranks how serious it can be.","아, 제발요. 그냥 장난이잖아요. 얼마나 심각하겠어요?");
 ds_map_add(m,"Miss I must inform your daughter she has been seen making pranks to the people of this town.","부인, 따님이 마을 사람들을 상대로 장난을 치는 모습이 목격됐다는 사실을 알려 드려야겠습니다.");
 ds_map_add(m,"Mom!! are you listening to me? ;c Mom!!!.","엄마!! 내 말 듣고 있어? ;c 엄마!!!");
 ds_map_add(m,"And the guards are blaming me.","그런데 경비병들은 나를 범인으로 몰고 있어.");
 ds_map_add(m,"Mom there is a cat doing pranks to people.","엄마, 누군가 고양이가 사람들에게 장난을 치고 있어.");
 ds_map_add(m,"leave my mommy alone.","우리 엄마 괴롭히지 마.");
 ds_map_add(m,"I'm not going to that place with that sucking milk machine 2000.","흡유기 2000이 있는 그곳에는 절대 안 갈 거야.");
 ds_map_add(m,"Come on miss, accompany me to jail-farm.","자, 아가씨. 저와 함께 감옥 농장으로 가시죠.");
 ds_map_add(m,"Calm love, I'll be back in a few days.","걱정 마, 여보. 며칠 뒤면 돌아올게.");
 ds_map_add(m,"But mommy ;c","하지만 엄마 ;c");
 ds_map_add(m,"I don't care, it's was worthed.","상관없어. 그만한 가치가 있었어.");
 ds_map_add(m,"I will take you to the jail-farm for assault on social security entities.","치안 유지 공무원을 폭행했으니 감옥 농장으로 데려가겠습니다.");
 ds_map_add(m,"And you fucking inoperative social parasite you should learn how to do your fucking job before you put people in jail.","그리고 이 빌어먹을 무능한 사회의 기생충아, 사람들을 감옥에 넣기 전에 네 빌어먹을 일부터 제대로 하는 법을 배워!");
 ds_map_add(m,"Of course they are innocent, children cover your ears.","그녀들은 당연히 무고해. 얘들아, 귀를 막으렴.");
 ds_map_add(m,"Really? It seems her daughters were innocent after all.","정말? 결국 그녀의 딸들은 무고했던 모양이네.");
 ds_map_add(m,"Wait there were new attacks on other people it couldn't be his daughters they were here with you.","잠깐, 다른 사람들도 새로 공격당했어. 그 딸들이 범인일 리 없어. 그 애들은 여기서 너와 함께 있었잖아.");
 ds_map_add(m,"I'm sorry miss will you have to come with me or you will have increased the time in jail-farm.","죄송합니다, 아가씨. 저와 함께 가셔야 합니다. 거부하시면 감옥 농장에 머무는 기간이 더 늘어날 겁니다.");
 ds_map_add(m,"Of course not, you closet slut.","속으로는 밝히는 걸레야.");
 ds_map_add(m,"But, I don't really care much about those powers.","하지만 난 그 능력들에 별로 관심이 없어.");
 ds_map_add(m,"Yes, but the good side is that you can buy clothes and absorb them into your sacred clothes, these will change in combat which will improve your half-succubus abilities <3.","그래. 하지만 좋은 점은 옷을 사서 네 성의에 흡수시킬 수 있다는 거야. 전투 중에 성의가 변하면서 네 하프 서큐버스 능력을 강화해 줄 거야 <3.");
 ds_map_add(m,"What?! b-but these clothes are sacred, my father will be very angry :c.","뭐라고?! 하, 하지만 이건 신성한 성의야. 아버지가 정말 화내실 거야 :c.");
 ds_map_add(m,"Before going to chase the angel, your mother imbue succubus magic in the elven clothes your father gave you.","천사를 쫓아가기 전에 네 엄마가 아버지에게 받은 엘프 의복에 서큐버스 마법을 불어넣었어.");
 ds_map_add(m,"Oh no, Lili and now what have you done.","아이고, 릴리. 이번엔 또 무슨 짓을 한 거야?");
 ds_map_add(m,"Emmm. yes .. but there is something I didn't tell you.","으음, 맞아…… 하지만 한 가지 말하지 않은 게 있어.");
 ds_map_add(m,"But for what, the magic clothes that my father gave me are enough to fight.","하지만 왜? 아버지가 주신 마법 의복만으로도 싸우기엔 충분해.");
 ds_map_add(m,"Line look a store maybe you can buy new equipment.","라인, 저기 가게가 있어. 새 장비를 살 수 있을지도 몰라.");
 ds_map_add(m,"Select the 'natural' option.","'자연' 옵션을 선택하세요.");
 ds_map_add(m,"Then you go to equipment and in the section where you have the boots on.","그다음 장비 메뉴로 가서 부츠가 장착된 칸을 선택하세요.");
 ds_map_add(m,"You have to go to the menu press enter.","메뉴를 열고 엔터 키를 눌러야 해.");
 ds_map_add(m,"Line to take off your boots.","라인, 부츠를 벗어.");
 ds_map_add(m,"Oh ok but that is within the normal :s but if it is required, I can could trie more things.","아, 알겠어. 하지만 그건 평범한 범위 안의 일이잖아 :s. 그래도 필요하다면 다른 것도 시도해 볼게.");
 ds_map_add(m,"Yeah shure, she seemed somewhat annoyed if we help her, she will most likely give us a price cut,are you with me Line?","물론이지. 그녀는 좀 짜증 난 것 같았어. 우리가 도와주면 가격을 깎아 줄지도 몰라. 라인, 같이 갈래?");
 ds_map_add(m,"No! You're wrong, I just want to be a little stronger, nothing more.","아니야! 오해야. 난 그냥 조금 더 강해지고 싶을 뿐이야. 그게 전부라고.");
 ds_map_add(m,"Oh so now you want new stuff, don't pretend to be a saint you wanted to excite your opponents with new clothes.","오, 이제 새 옷을 원하시는구나? 성녀인 척하지 마. 새 옷으로 상대를 흥분시키고 싶었던 거잖아.");
 ds_map_add(m,"What are we going to do Lili :s.","릴리, 우리 어떡하지? :s");
 ds_map_add(m,"What the hell! those prices.","뭐야, 이 가격은!");
 ds_map_add(m,"AHHH FORGET WHAT YOU SAW!","아아아! 네가 본 건 잊어버려!");
 ds_map_add(m,"Oh, I almost forgot, give these pamphlets to the people.","아, 깜빡했네. 이 전단지를 사람들에게 나눠 줘.");
 ds_map_add(m,"I might know where he could be.","그가 어디 있는지 알 것 같아.");
 ds_map_add(m,"Of course, if she came to this island for the same reason that all tourists come.","물론이지. 그녀도 다른 관광객들과 같은 이유로 이 섬에 왔다면 말이야.");
 ds_map_add(m,"If I help you, could you help us by getting information from my friend?","내가 도와주면, 네 친구에게서 정보를 알아봐 주는 식으로 우리도 도와줄 수 있어?");
 ds_map_add(m,"People have to know that the red tent will open soon so im kinda busy.","사람들에게 빨간 천막이 곧 문을 연다고 알려야 해서 좀 바빠.");
 ds_map_add(m,"I'm sorry, sweetie but now I can't, I'm going to do stand up to attract some people.","미안해, 자기. 지금은 안 돼. 사람들을 모으려고 스탠드업 코미디를 하러 갈 거야.");
 ds_map_add(m,"Hi, can you give me a little of your time? I'm looking for a friend.","안녕하세요. 잠깐 시간 좀 내 주실 수 있나요? 친구를 찾고 있어요.");
 ds_map_add(m,"Give those pamphlets to people while I get ready.","내가 준비하는 동안 사람들에게 이 전단지를 나눠 줘.");
 ds_map_add(m,"You should have told me that you like these types of shows. we could one of us here <3.","네가 이런 공연을 좋아한다고 미리 말하지 그랬어. 우리도 여기서 직접 해 볼 수 있었을 텐데 <3.");
 ds_map_add(m,"You can see the place while we prepare all.","우리가 준비하는 동안 이곳을 둘러봐도 돼.");
 ds_map_add(m,"oh You don't have to thank me, oh I almost forgot the circus is still in preparation but there a girl with pink hair near the stands that you might like.","아, 고마워할 필요 없어. 아, 깜빡할 뻔했네. 서커스는 아직 준비 중이지만 관람석 근처에 분홍 머리 여자애가 있어. 네 마음에 들지도 몰라.");
 ds_map_add(m,"I'm good , and thank for the information and the other thing hehe.","전 잘 지내요. 정보도 고맙고, 그 일도 고마워요. 헤헤.");
 ds_map_add(m,"*whisper* oh god the jokes of this bitch.","*속삭임* 세상에, 저년의 농담이라니.");
 ds_map_add(m,"Hi Line, how have you bee-n.","안녕, 라인. 어때, 잘 지냈어-?");
 ds_map_add(m,"Hi MsHonney.","안녕하세요, 허니 부인.");
 ds_map_add(m,"welcome to the green hills hotel at the moment we do not have rooms available","그린 힐스 호텔에 오신 것을 환영합니다. 현재 이용 가능한 객실이 없습니다.");
 ds_map_add(m,"Welcome to the green hills hotel at the moment we do not have rooms available.","그린 힐스 호텔에 오신 것을 환영합니다. 현재 빈 객실이 없습니다.");
 ds_map_add(m,"Go to the door on the left she will be waiting for you.","왼쪽 문으로 가. 그녀가 거기서 기다리고 있을 거야.");
 ds_map_add(m,"Wow I never thought that a young girl who looks so innocent would go to see her.","와, 저렇게 순진해 보이는 어린 아가씨가 그녀를 만나러 갈 줄은 몰랐네.");
 ds_map_add(m,"Oh-sorry i havent sleep lately.","아, 미안해. 요즘 잠을 못 잤어.");
 ds_map_add(m,"Geez Line control yourself.","세상에, 라인. 정신 좀 차려.");
 ds_map_add(m,"What?","뭐?");
 ds_map_add(m,"I love you.","사랑해.");
 ds_map_add(m,"Mshonney have new workers.","허니 부인에게 새 직원이 생겼어요.");
 ds_map_add(m,"Welcome to the green hills hotel.","그린 힐스 호텔에 오신 것을 환영합니다.");
 ds_map_add(m,"ok ok just give me a sec","알았어, 알았어. 잠깐만 기다려.");
 ds_map_add(m,"I will sell it and be free again.","그걸 팔고 다시 자유로워질 거야.");
 ds_map_add(m,"I escaped from jail but I had no place to go or money, this place is my only option, I must win the golden key.","감옥에서 탈출했지만 갈 곳도 돈도 없었어. 여기가 내 유일한 선택지야. 황금 열쇠를 반드시 따야 해.");
 ds_map_add(m,"I-I can't here callie, you know I'm shy, there are a lot of people here","나, 나 여기서는 못 해, 캘리. 나 수줍음 많은 거 알잖아. 여기 사람이 너무 많아.");
 ds_map_add(m,"But your love, you can take it right here.","하지만 네 사랑은 바로 여기서 받을 수 있잖아.");
 ds_map_add(m,"My children are the best <3 tell him that here it is not so bad, they even pay me to produce milk.","내 아이들은 최고야 <3. 여기 나쁘지 않다고 그에게 말해 줘. 우유를 생산하는 대가로 돈까지 받거든.");
 ds_map_add(m,"Oh ok, your kids send you good vibes since they can't come.","아, 알겠어. 아이들이 올 수는 없지만 엄마에게 응원을 보내는구나.");
 ds_map_add(m,"Sorry here just let us say moo.","죄송해요. 여기서는 그냥 음메라고만 말할 수 있어요.");
 ds_map_add(m,"Whaaat?.","뭐어어?");
 ds_map_add(m,"Mooo.","음메.");
 ds_map_add(m,"Hey Line come here.","이봐, 라인. 이리 와.");
 ds_map_add(m,"Yes, she wants me to stay close to her since I am 18 years old and she doesn't want me to go to places that were previously restricted to me on the island.","네. 제가 이제 18살이라서 엄마가 곁에 붙어 있으라고 하세요. 섬에서 예전에는 출입이 제한됐던 곳에 제가 가는 걸 원하지 않으시거든요.");
 ds_map_add(m,"Wait are you the saleswoman's son?","잠깐, 너 그 판매원의 아들이야?");
 ds_map_add(m,"Bye I have to go","잘 있어. 난 가 봐야 해.");
 ds_map_add(m,"No, but I know that north from here they did the same to a fox girl.","아니, 하지만 여기서 북쪽에 있는 여우 소녀도 똑같은 일을 당했다는 건 알아.");
 ds_map_add(m,"Wait do you know who did this to you?","잠깐, 누가 너를 이렇게 만들었는지 알아?");
 ds_map_add(m,"Thanks I have to go.","고마워. 나 가야 해.");
 ds_map_add(m,"Oh do not worry I will take that thing from you.","아, 걱정 마. 내가 그걸 네게서 떼어 줄게.");
 ds_map_add(m,"yeah she went to the cultivation of nana leaves.","그래, 그녀는 나나 잎을 재배하는 곳으로 갔어.");
 ds_map_add(m,"Thank you lady unicorn but be careful that cat likes to prank people :c.","고마워요, 유니콘 아가씨. 하지만 조심하세요. 그 고양이는 사람들에게 장난치는 걸 좋아해요 :c.");
 ds_map_add(m,"Oh I just got to the town but if I see it I'll let you know <3.","아, 방금 마을에 도착했어요. 하지만 그걸 보면 알려 드릴게요 <3.");
 ds_map_add(m,"Mmm no, and have you seen a blue cat by chance?","음, 아니요. 혹시 파란 고양이를 보셨나요?");
 ds_map_add(m,"Hello by chance have you seen someone with wings on their head?","안녕하세요. 혹시 머리에 날개가 달린 사람을 보셨나요?");
 ds_map_add(m,"yeah just give use the money","그래, 우리한테 돈만 주면 돼.");
 ds_map_add(m,"That is, if they do not return with the money on time you will have to work in the village dairy farm to pay it","그러니까, 제때 돈을 갚지 못하면 마을 낙농장에서 일해서 빚을 갚아야 해.");
 ds_map_add(m,"We take the money","우리가 돈을 가져간다.");
 ds_map_add(m,"sounds really easy actually","생각보다 정말 간단하네.");
 ds_map_add(m,"It's easy, I'll lend you money and you return it to me later with an extra 10%","간단해. 내가 돈을 빌려줄 테니 나중에 10%를 더해서 갚으면 돼.");
 ds_map_add(m,"Oh ok what do we have to do?","아, 알겠어. 우리가 뭘 하면 되지?");
 ds_map_add(m,"I don't know Line having money is always good","모르겠어, 라인. 돈이 있으면 언제나 좋잖아.");
 ds_map_add(m,"Me mmm .. not really","나? 으음…… 별로.");
 ds_map_add(m,"Hey you look like you need money.","이봐, 돈이 필요한 것 같은데.");
 ds_map_add(m,"Great just sign here.","좋아. 여기 서명만 해.");
 ds_map_add(m,"Amazing, it's great to do deals with you.","정말 대단해. 너와 거래해서 즐거웠어.");
 ds_map_add(m,"I gave you 1000 arcs plus 10%, you should give me back 1100.","내가 아크 1000개에 10%를 더해 빌려줬으니, 1100개를 돌려줘야 해.");
 ds_map_add(m,"No, sorry you will have the money later.","아니, 미안해. 돈은 나중에 줄게.");
