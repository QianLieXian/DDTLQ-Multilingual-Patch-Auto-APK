 ds_map_add(m,"Revive my Love!","내 사랑을 되살려!");
 ds_map_add(m,"The Slime seekers warned us One of them is compatible with you it's now or never!","슬라임 추적자들이 경고했어. 그중 하나가 너와 맞을 거야. 지금이 아니면 기회는 없어!");
 ds_map_add(m,"Consume, this means... this blood?!","삼켜라, 이건... 이 피를 말하는 거야?!");
 ds_map_add(m,"Eleonor my love Consume them, please, one more time.","엘레노어, 내 사랑. 그녀들을 삼켜 줘. 제발, 한 번만 더.");
 ds_map_add(m,"NOOO! This cannot end here!","안 돼애애! 여기서 끝날 수는 없어!");
 ds_map_add(m,"Raise your hands where I can see them and come with me!","두 손을 들어 내가 볼 수 있게 하고, 나와 함께 가!");
 ds_map_add(m,"You are under arrest by the power granted to me by the great captain of Elira!","엘리라 대대장에게 부여받은 권한으로 너를 체포하겠다!");
 ds_map_add(m,"Hey! You're the one behind all this!","이봐! 이 모든 일의 배후가 너였어!");
 ds_map_add(m,"Wha-what is all this blood?","이, 이 피는 다 뭐야?");
 ds_map_add(m,"CONSUME THEM ELEONOR!","엘레노어, 그녀들을 삼켜!");
 ds_map_add(m,"Don't you dare talk to my wife like that!","감히 내 아내에게 그런 식으로 말하지 마!");
 ds_map_add(m,"This thing needs to be taken care of first!","우선 저걸 처리해야 해!");
 ds_map_add(m,"Ahhhhh ok but we'll go together, maybe this way you'll have more time to drain all the energy from that thing!","아아, 알았어. 하지만 우리 함께 가자. 그래야 네가 저것의 에너지를 전부 빨아들일 시간을 더 벌 수 있을지도 몰라!");
 ds_map_add(m,"Vasuki, if I don't do it we will die anyway.","바수키, 내가 하지 않으면 어차피 우린 죽어.");
 ds_map_add(m,"Are you done talking? surrender to Eleonor and bring her back to life!","말은 다 끝났나? 엘레노어에게 항복하고 그녀를 되살려!");
 ds_map_add(m,"I have no other options.","다른 방법이 없어.");
 ds_map_add(m,"And if you are compatible you will end up becoming that psychopath's wife.","그리고 네가 적합하다면 그 미치광이의 아내가 되겠지.");
 ds_map_add(m,"You are completely crazy if you are not the compatible she will kill you.","완전히 미쳤군. 네가 적합하지 않으면 그녀가 널 죽일 거야.");
 ds_map_add(m,"Vasuki I have an idea, if I come in contact with her, I can drain her energy and thus defeat her or at least incapacitate her.","바수키, 좋은 생각이 있어. 그녀와 접촉하면 에너지를 빨아들여 쓰러뜨릴 수 있어. 적어도 움직이지 못하게 할 수는 있겠지.");
 ds_map_add(m,"El-eleonor yo-you changed we are so close to your resurrection.","엘, 엘레노어... 너, 변했어. 부활이 얼마 남지 않았는데.");
 ds_map_add(m,"We cannot defeat it","우린 저걸 이길 수 없어.");
 ds_map_add(m,"Is too strong!","너무 강해!");
 ds_map_add(m,"The message does not go public because of the scrutiny of one of the parties involved to catch the accused.","피고인 체포에 관여한 관계자 중 한 명의 검토로 해당 메시지는 공개되지 않았다.");
 ds_map_add(m,"'Do you really think your life is worth more than all those women!?'","'정말 네 목숨이 그 모든 여자들의 목숨보다 더 가치 있다고 생각하나!?'");
 ds_map_add(m,"Before the accused lost all his sanity, he wrote a message in blood on the wall of his cell.","피고인은 이성을 완전히 잃기 전, 감방 벽에 피로 메시지를 남겼다.");
 ds_map_add(m,"The number of missing women associated with the case is in the dozens and growing as the investigation progresses.","이 사건과 관련된 실종 여성은 수십 명에 달하며, 수사가 진행될수록 그 수는 계속 늘고 있다.");
 ds_map_add(m,"Hours after the mother slime died, all the slimes created by it perished.","슬라임의 어미가 죽고 몇 시간 뒤, 어미가 만들어 낸 슬라임들도 모두 죽었다.");
 ds_map_add(m,"Dr. Isic Arumov did not face justice due to his mental state.","이시크 아루모프 박사는 정신 상태 때문에 법의 심판을 받지 않았다.");
 ds_map_add(m,"The attack of the Slimes has finally ceased and the citizens feel a little safer again.","슬라임의 습격은 마침내 멈췄고, 시민들은 다시 조금이나마 안심하게 되었다.");
 ds_map_add(m,"Raise your hands and come with me.","손을 들고 나와 함께 가.");
 ds_map_add(m,"*Read the name on his coat* Doctor Isic Arumov you are under arrest for crimes against humanity.","*코트에 적힌 이름을 읽는다* 이시크 아루모프 박사, 반인류 범죄 혐의로 체포합니다.");
 ds_map_add(m,"Do not let him get into your head Line, he is responsible for all of this.","라인, 그가 네 정신을 흔들게 두지 마. 이 모든 일은 그자의 책임이야.");
 ds_map_add(m,"Bu-ut I just wanted to stop this, I-I am a hero I did not want to doom anyone.","하, 하지만 난 그저 이 일을 막고 싶었을 뿐이야. 나, 난 영웅이야. 누구도 파멸시키고 싶지 않았어.");
 ds_map_add(m,"You selfish fool, you condemned all the women who became Slime!","이기적인 멍청이! 네가 슬라임이 된 모든 여자를 죽음으로 몰아넣었어!");
 ds_map_add(m,"M-my intention was only t-to incapacitate her, I did not think she woul-","나, 내 의도는 그저 그녀를 움직이지 못하게 하려던 거였어. 그, 그녀가 그렇게 될 줄은...");
 ds_map_add(m,"I-it seems to have worked.","성, 성공한 것 같아.");
 ds_map_add(m,"Wha-what have they done to you my love, Eleonor, why... why? you didn't have to die.","그, 그들이 당신에게 무슨 짓을 한 거야, 내 사랑 엘레노어. 왜... 왜? 당신은 죽지 않아도 됐는데.");
 ds_map_add(m,"If we do everything right, there should be no problems.","모든 걸 제대로 처리하면 문제는 없을 거야.");
 ds_map_add(m,"I will have to accelerate the investigation for Eleonor's sake and mine.","엘레노어와 나를 위해 연구를 서둘러야겠어.");
 ds_map_add(m,"The great captain announced that the happy bad omen sect, after years of not knowing about them, had caused one of the most grotesque crime of the last decade on the island.","대대장은 수년간 자취를 감췄던 '행복한 불길한 징조' 교단이 섬에서 지난 10년간 가장 끔찍한 범죄 중 하나를 저질렀다고 발표했다.");
 ds_map_add(m,"They murdered all the women in Big Dream.","그들은 빅 드림의 여성들을 모조리 살해했다.");
 ds_map_add(m,"It's going to be a long night.","긴 밤이 되겠군.");
 ds_map_add(m,"In the room there is a chair in front of a table, sit there.","방 안에 탁자 앞 의자가 있어. 거기 앉아.");
 ds_map_add(m,"T-Then what do we do?!","그, 그럼 우린 어떻게 해요?!");
 ds_map_add(m,"If you go out now you could run into one of them, you could be possessed or worse so you can't leave that office.","지금 나가면 그들 중 하나와 마주칠 수 있어. 빙의당하거나 더 끔찍한 일을 당할 수도 있으니 그 사무실에서 나가면 안 돼.");
 ds_map_add(m,"But at night they become very aggressive.","하지만 밤이 되면 그들은 매우 공격적으로 변해.");
 ds_map_add(m,"Thi-this place is cursed at night by... people I hold dear to my heart.","이, 이곳은 밤이 되면... 내게 소중한 사람들이 저주하는 곳이야.");
 ds_map_add(m,"AH decide woman!","아, 빨리 결정해, 이 여자야!");
 ds_map_add(m,"NO, stop! don't leave!","안 돼, 멈춰! 가지 마!");
 ds_map_add(m,"Let's go Line I feel that there is something very wrong here!","가자, 라인. 여기 뭔가 심각하게 잘못된 것 같아!");
 ds_map_add(m,"What? oh no this is very bad I'm so sorry.","뭐? 아, 안 돼. 이건 정말 심각하네. 정말 미안해.");
 ds_map_add(m,"OH No no no why are they there and at night! this place is closed to the public it is very dangerous!","아, 안 돼, 안 돼, 안 돼! 왜 그들이 밤에 거기 있는 거야?! 여긴 일반인에게 개방되지 않는 곳이야. 정말 위험해!");
 ds_map_add(m,"Alo who is it?","여보세요, 누구세요?");
 ds_map_add(m,"I think it comes from the ventilation.","환풍구에서 나는 소리인 것 같아.");
 ds_map_add(m,"A-aloooo.","여, 여보세요오.");
 ds_map_add(m,"AHHhhHH","아아아아!");
 ds_map_add(m,"AAahHH","아아아!");
 ds_map_add(m,"WHO IS THERE?!","거기 누구야?!");
 ds_map_add(m,"Hey Hey, Don't stand up so fast you've been unconscious for quite a while.","이봐, 이봐. 그렇게 빨리 일어나지 마. 꽤 오랫동안 의식을 잃고 있었어.");
 ds_map_add(m,"Enough woman! if I had an arc for every time you fall for being distracted I would have 2 arcs wich is not a lot but is weird that it happend twice.","그만 좀 해, 여자야! 네가 한눈팔아서 넘어질 때마다 아크를 하나씩 받았다면 지금쯤 2아크는 모았겠지. 별것 아니지만 두 번이나 그랬다는 게 참 이상하네.");
 ds_map_add(m,"This time Uhgg, I do not think so.","이번엔... 으윽, 안 될 것 같아.");
 ds_map_add(m,"LINE ARE YOU OK?!","라인, 괜찮아?!");
 ds_map_add(m,"AgHHHH SHIKAWAGA.","아아아아, 시카와가.");
 ds_map_add(m,"Quieres empezar?","시작할래?");
 ds_map_add(m,"Best of luck girls...","아가씨들, 행운을 빌어...");
 ds_map_add(m,"Once the sun rises we can talk more.","해가 뜨면 더 이야기하자.");
 ds_map_add(m,"Shit... you watch the cameras and give me the signal to close the doors.","젠장... 네가 카메라를 감시해. 문을 닫으라는 신호를 보내.");
 ds_map_add(m,"Lili I am so scared ;c.","릴리, 나 너무 무서워 ;c.");
 ds_map_add(m,"That's the problem you have to last until dawn and I know the energy won't last that long so only close them when it's really necessary!","그게 문제야. 새벽까지 버텨야 하는데 에너지가 그만큼 오래가지 못할 거야. 그러니 정말 필요할 때만 문을 닫아!");
 ds_map_add(m,"So much drama just to tell us to close the doors!","그냥 문을 닫으라는 말 하나 하려고 이렇게 호들갑을 떤 거야?!");
 ds_map_add(m,"Watch for ghosts with the cameras and if they get too close, close the doors.","카메라로 유령들을 감시하다가 너무 가까이 오면 문을 닫아.");
 ds_map_add(m,"What, then what do I do :c?","뭐, 그럼 난 어떻게 해야 해 :c?");
 ds_map_add(m,"Unfortunately, this was a long time ago so I don't know how much time you have, with energy.","안타깝게도 아주 오래전 일이라 남은 에너지로 얼마나 버틸 수 있을지 모르겠어.");
 ds_map_add(m,"Where you are is the safest place there is, the knights of Elira have cordoned off the place and placed generators that activate doors reinforced with magic.","너희가 있는 곳이 가장 안전해. 엘리라 기사단이 주변을 봉쇄했고, 마법으로 강화된 문을 작동시키는 발전기도 설치했어.");
 ds_map_add(m,"There is not much time this is what you should do.","시간이 많지 않아. 네가 해야 할 일은 이거야.");
 ds_map_add(m,"Oh, great ehh I guess ;c","아, 잘됐네. 어... 그런가 봐 ;c.");
 ds_map_add(m,"In spite of all the bad things you are lucky tonight they are very calm but you can't let your guard down.","온갖 안 좋은 일이 있었지만 오늘 밤은 운이 좋네. 그들은 아주 얌전해. 그래도 경계를 늦추면 안 돼.");
 ds_map_add(m,"Now listen to me, this is very important.","자, 내 말을 잘 들어. 아주 중요해.");
 ds_map_add(m,"It's a bad idea to leave this room.","이 방에서 나가는 건 좋은 생각이 아니야.");
}
if(ds_map_exists(global.zh_display_map,s))return ds_map_find_value(global.zh_display_map,s);
return s;
