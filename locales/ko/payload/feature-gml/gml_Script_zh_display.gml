 ds_map_add(m,"PornSoulLike","포르노 소울라이크");
 ds_map_add(m,"Thanks for being a Patreon <3","Patreon 후원자가 되어 주셔서 감사합니다 <3");
 ds_map_add(m,"Version ","버전");
 ds_map_add(m,"Android Version ","안드로이드 버전");
 ds_map_add(m,"Critical","치명타");
 ds_map_add(m,"Weaker Attack","약화된 공격");
 ds_map_add(m,"Weak Attack","약한 공격");
 ds_map_add(m,"Critical Attack","치명타 공격");
 ds_map_add(m,"que vola guacho qliao","뭐 하냐, 이 자식아?");
 ds_map_add(m,"achievement unlocked :","업적 달성: ");
 ds_map_add(m,"Quest Started :","퀘스트 시작: ");
 ds_map_add(m,"Quest Completed :","퀘스트 완료: ");
 ds_map_add(m,"pan con queso","치즈빵");
 ds_map_add(m,"I used my last strength to summon some tentacles and take her to bed","마지막 남은 힘을 쥐어짜 촉수를 소환해 그녀를 침대로 데려갔다.");
 ds_map_add(m,"The last thing that was heard about her is that she was on Elira, an island well known for its properties of uniting people.","그녀에 관한 마지막 소식은 사람들을 하나로 이어 주는 특성으로 유명한 엘리라라는 섬에 있었다는 것이었다.");
 ds_map_add(m,"When Line turned 18 she received her fairy companion. Toguether, they set out to search for Line's Friend.","라인이 열여덟 살이 되던 해, 요정 동료를 받았다. 둘은 함께 라인의 친구를 찾기 위한 여정을 떠났다.");
 ds_map_add(m,"The years passed and she still did not return...","세월이 흘렀지만 그녀는 여전히 돌아오지 않았다……");
 ds_map_add(m,"'I am doing this for you, be strong'.","'널 위해서 이러는 거야. 강해져.'");
 ds_map_add(m,"One day without warning one of the friends left the village, leaving a note for the other saying.","어느 날, 두 친구 중 한 명이 아무런 예고도 없이 마을을 떠났다. 다른 친구에게 다음과 같은 쪽지를 남긴 채였다.");
 ds_map_add(m,"Despite their differences, they were best friends.","서로 달랐지만, 그들은 가장 친한 친구였다.");
 ds_map_add(m,"One of was strong and empowered, the other was quiet and shy.","한 명은 강하고 자신감이 넘쳤고, 다른 한 명은 조용하고 수줍음이 많았다.");
 ds_map_add(m,"Many years ago there were two inseparable girls.","아주 오래전, 서로 떨어질 수 없는 두 소녀가 있었다.");
 ds_map_add(m,"Joined the Party","파티 참가");
 ds_map_add(m,"Sam Hero of Tricotex","트리코텍스의 영웅 샘");
 ds_map_add(m,"Yeah so-sorry you are right.","응, 미, 미안. 네 말이 맞아.");
 ds_map_add(m,"Any way you need to focus were really close to find your her.","아무튼 집중해야 해. 그녀를 찾기까지 얼마 남지 않았어.");
 ds_map_add(m,"... Line sometimes you worry me.","……라인, 가끔은 네가 정말 걱정돼.");
 ds_map_add(m,"Right, where did Charity go? she didn't even kiss me to say goodbye.","그러고 보니 채리티는 어디로 간 거야? 작별 키스도 안 해 주고 떠났잖아.");
 ds_map_add(m,"Hey that's great, now you can !#%$% focus!","이봐, 잘됐네! 이제 !#%$% 집중할 수 있겠어!");
 ds_map_add(m,"She's not just any succubus, it's called Charity, she whispered in my ear <3.","그녀는 평범한 서큐버스가 아니야. 채리티라고 해. 내 귀에 직접 속삭여 줬어 <3.");
 ds_map_add(m,"The succubus took all your energy and then you passed out.","서큐버스가 네 기력을 전부 흡수했고, 넌 그대로 기절했어.");
 ds_map_add(m,"Wha-what happened?","뭐, 뭐가 어떻게 된 거야?");
 ds_map_add(m,"Wake up!","정신 차려!");
 ds_map_add(m,"This is bliss, Bliss <3.","이게 바로 황홀경이야. 황홀경이라고 <3.");
 ds_map_add(m,"She is so warm, and she smells so good.","정말 따뜻하고, 냄새도 너무 좋아.");
 ds_map_add(m,"No way, she smells so sweet, I cant think of anything else.","안 돼. 향기가 너무 달콤해. 다른 건 아무것도 생각할 수 없어.");
 ds_map_add(m,"Just enjoy it.","그냥 즐겨.");
 ds_map_add(m,"Wh-why are you ge-getting closer... I am little dizzy.","왜, 왜 점점 가까이 오는 거야…… 조금 어지러워.");
 ds_map_add(m,"but I know I can win in my own way.","하지만 나만의 방식으로 이길 수 있다는 건 알아.");
 ds_map_add(m,"Maybe i'm not as strong as you.","내가 너만큼 강하지는 않을지도 몰라.");
 ds_map_add(m,"You will never beat me in a fight, now get out of my way!","싸움으로는 절대 날 이길 수 없어. 이제 내 앞에서 비켜!");
 ds_map_add(m,"We can't go back, the boat sinks, we just have to continue.","돌아갈 수 없어. 배가 가라앉았으니 계속 나아가는 수밖에 없어.");
 ds_map_add(m,"I hope she is here.","그녀가 여기 있으면 좋겠어.");
 ds_map_add(m,"Pussy","보지");
 ds_map_add(m,"Wha-what why would it make me stronger? Is it a mushroom that we don't even know?.","뭐, 뭐라고? 그걸 먹으면 왜 더 강해지는 건데? 우리도 정체를 모르는 버섯이잖아.");
 ds_map_add(m,"Line look at that mushroom, if you eat it it will make you super strong.","라인, 저 버섯 좀 봐. 먹으면 엄청 강해질 거야.");
 ds_map_add(m,"Oh :c.","아…… :c.");
 ds_map_add(m,"Mmm. Line that's pyrite, another idiot must have thought it was gold and brought it here.","음, 라인. 그건 황철석이야. 또 다른 멍청이가 금인 줄 알고 여기 가져다 놓은 모양이네.");
 ds_map_add(m,"Look _ili gold! we don't need to fight for money anymore <3.","봐, _ili! 금이야! 이제 돈 때문에 싸울 필요가 없어 <3.");
 ds_map_add(m,"Fight!","싸워!");
 ds_map_add(m,"But wait we are not the ones.","하지만 잠깐, 우린 그 사람들이 아니잖아.");
 ds_map_add(m,"Don't worry miners, I will save y'all.","광부 여러분, 걱정하지 마세요! 제가 모두 구해 드릴게요.");
 ds_map_add(m,"What?! no we no.","뭐라고?! 아니, 우린 그런 적 없어.");
 ds_map_add(m,"You! you are the one who made the collapse!","너! 여기 무너진 건 네가 한 짓이잖아!");
 ds_map_add(m,"*Line murmurs his wish in Maria's ear*","*라인이 마리아의 귀에 소원을 속삭인다*");
 ds_map_add(m,"Hmm hehe, well look I want you to do this.","음, 헤헤. 있잖아, 내가 너한테 부탁하고 싶은 게 있어.");
 ds_map_add(m,"That's why I offer you a wish, whatever is within my reach, I will do it.","그래서 네 소원을 들어주겠다고 한 거야. 내가 할 수 있는 일이라면 무엇이든 해 줄게.");
 ds_map_add(m,"But I was wrong and also I lost the battle I must regain my honor.","하지만 내가 틀렸고 전투에서도 졌어. 명예를 되찾아야 해.");
 ds_map_add(m,"When I fight with an enemy it is usually until one of the two dies.","적과 싸우기 시작하면 보통 둘 중 한 명이 죽을 때까지 싸워.");
 ds_map_add(m,"Line and Maruia stay while all the miners leave the cave.","라인과 마루이아는 남고, 모든 광부는 동굴 밖으로 나간다.");
 ds_map_add(m,"Except you.","너만 빼고.");
 ds_map_add(m,"Okay, guys, you can go now, go see your loved ones.","자, 여러분. 이제 가도 돼요. 사랑하는 사람들을 만나러 가세요.");
 ds_map_add(m,"Sorry but it's not me.","미안하지만 그건 내가 아니야.");
 ds_map_add(m,"So you are not the woman who caused the collapse?","그럼 붕괴를 일으킨 여자는 네가 아니라는 거야?");
 ds_map_add(m,"The guard who cleared the place asked us to see how things are here.","현장을 정리한 경비병이 이곳 상황을 확인해 달라고 부탁했어.");
 ds_map_add(m,"Hey stop it, we are not the bad ones!","이봐, 그만해! 우린 나쁜 사람들이 아니야!");
 ds_map_add(m,"Shit you're strong but as long as I'm here I won't let you hurt the miners.","젠장, 정말 강하군. 그래도 내가 여기 있는 한 광부들을 다치게 두진 않겠어.");
 ds_map_add(m,"Well, Line, take care, I'll go to the hospital to see if a miner had a bigger problem.","그럼 라인, 몸조심해. 광부 중에 크게 다친 사람이 있는지 확인하러 병원에 갈게.");
 ds_map_add(m,"I couldn't resist I needed to be between those thighs squeezing me. <3","참을 수가 없었어. 날 조여 오는 그 허벅지 사이에 꼭 끼어 있고 싶었거든 <3.");
 ds_map_add(m,"haha shure you are a weirdo others would ask the same but the other way around.","하하, 그래. 넌 정말 별난 사람이네. 다른 사람들도 같은 부탁을 하긴 하지만 보통은 정반대지.");
 ds_map_add(m,"I don't think entering a house without permission is good idea.","허락도 받지 않고 남의 집에 들어가는 건 좋은 생각이 아닌 것 같아.");
 ds_map_add(m,"oh ok :c","아, 알겠어 :c");
 ds_map_add(m,"I'm sorry miss but it's closed for now","죄송하지만 지금은 문을 닫았습니다.");
 ds_map_add(m,"Yes you're right Lili maybe she could help us.","그래, 네 말이 맞아, 릴리. 어쩌면 그녀가 우릴 도와줄 수도 있겠어.");
 ds_map_add(m,"That woman on top of that box, she probably saw Ava.","저 상자 위에 있는 여자 말이야. 아마 에이바를 봤을지도 몰라.");
 ds_map_add(m,"Hey Line look.","이봐, 라인. 저것 좀 봐.");
 ds_map_add(m,"Fuck no, besides, I'm getting bored.","절대 싫어. 게다가 이제 슬슬 지루해지고 있어.");
 ds_map_add(m,"Maybe give one more to be sure.","확실히 하려면 한 번 더 해 보는 게 어때?");
 ds_map_add(m,"Ok, Line enough, let's go back to that clown.","좋아, 라인. 이쯤이면 됐어. 그 광대에게 돌아가자.");
 ds_map_add(m,"Relics stolen from temples it is better to speak in a private place.","신전에서 도난당한 성유물에 관한 일이야. 사적인 장소에서 이야기하는 편이 좋겠어.");
 ds_map_add(m,"In the city strange things have been happening people disappearing.","도시에서 이상한 일이 벌어지고 있어. 사람들이 사라지고 있거든.");
 ds_map_add(m,"Why so much secrecy?","왜 그렇게 비밀스럽게 구는 거야?");
 ds_map_add(m,"Mmm.. okay go to the hotel to the southwest, there tell the receptionist 'Mshonney have new workers' she will tell you what to do next.","음…… 좋아. 남서쪽에 있는 호텔로 가. 거기서 접수원에게 '허니 부인에게 새 직원이 생겼어요'라고 말하면 다음에 뭘 해야 할지 알려 줄 거야.");
 ds_map_add(m,"Whatever, help us find our friend.","됐고, 우리 친구를 찾는 일이나 도와줘.");
 ds_map_add(m,"Hey Lili dont say that, she is joking please just ignore her.","이봐, 릴리. 그런 말 하지 마. 농담이니까 그냥 무시해 줘.");
 ds_map_add(m,"Enough!! your jokes are boring for us.","그만해!! 너희 농담은 이제 지겨워.");
 ds_map_add(m,"Mmm-no and that's just a stereotype.","음, 아니. 그건 그냥 고정관념일 뿐이야.");
 ds_map_add(m,"aca lili y wea saltalo :v","여기 릴리 어쩌고저쩌고, 그냥 넘겨 :v");
 ds_map_add(m,"Ah of course the jokes of double meaning, since you are a succubus right?","아, 물론 중의적인 농담이겠지. 네가 서큐버스니까, 그렇지?");
 ds_map_add(m,"Oh-sorry I guess I like other kinds of jokes.","아, 미안. 난 다른 종류의 농담을 좋아하나 봐.");
 ds_map_add(m,"You don't seem to like my comedy huh.","내 개그가 별로 마음에 안 드나 보네?");
 ds_map_add(m,"Don't destroy your brain with these stupid jokes,OK? ","이런 멍청한 농담으로 머리 망가뜨리지 마, 알겠지?");
 ds_map_add(m,"This show sure really stings, isn't it?","이번 공연은 꽤 따끔하죠?");
 ds_map_add(m,"Thanks god its end.","하느님 감사합니다. 드디어 끝났네요.");
 ds_map_add(m,"Thank you for joining the show and make sure to BEE-hydrated all the time, everyone!","공연을 함께해 주셔서 감사합니다! 여러분, 항상 꿀벌처럼 수분 보충하는 것도 잊지 마세요!");
 ds_map_add(m,"Hahahahahahahahahaha","하하하하하하하하하하");
 ds_map_add(m,"See? This is how cactus pollinate, everyone..","보셨죠, 여러분? 선인장은 이렇게 수분을 시켜요……");
 ds_map_add(m,"But you know what happens next? The thief then runs and gets hit by a big cactus in front of him! Now, he's crying like a ba-bee!.","그런데 다음에 무슨 일이 일어나는지 아세요? 도둑이 도망치다가 앞에 있는 커다란 선인장에 부딪히죠! 이제 아기 벌처럼 엉엉 울고 있네요!");
 ds_map_add(m,"Please stop","그만해 주세요.");
 ds_map_add(m,"The thief then taunts 'Mind your bees-ness, Bee-tchs!'","그러자 도둑이 이렇게 놀렸죠. '벌 일이나 신경 써, 이 벌년들아!'");
 ds_map_add(m,"And then the guards try to catch him. But the thief pours all the honey to the ground and the guards then slip and get stuck!","그다음 경비병들이 도둑을 잡으려 해요. 그런데 도둑이 꿀을 전부 땅에 쏟아 버리고, 경비병들은 미끄러져 넘어져서 꼼짝 못 하게 되죠!");
 ds_map_add(m,"Somebody stole all of them! Un-bee-lievable!","누군가 전부 훔쳐 갔어요! 정말 벌 믿을 수가 없네요!");
 ds_map_add(m,"Have you ever heard about our new honey products that just released on our nearest market?","가까운 시장에 새로 출시된 저희 꿀 제품에 대해 들어 보셨나요?");
 ds_map_add(m,"Oh fuck.","아, 젠장.");
 ds_map_add(m,"Come a little closer, people. I promise I won't sting ya.","여러분, 조금 더 가까이 오세요. 쏘지 않을 테니 걱정 마세요.");
 ds_map_add(m,"Oh no.","아, 안 돼.");
 ds_map_add(m,"Hey, greetings our fellow BEEINGS!","이봐요, 우리 벌 친구 여러분! 모두 반가워요!");
 ds_map_add(m,"Mmm.. okay go to the hotel to the southwest, there tell the receptionist 'Mshonney has new workers' she will tell you what to do next.","음…… 좋아. 남서쪽에 있는 호텔로 가. 거기서 접수원에게 '허니 부인에게 새 직원이 생겼어요'라고 말하면 다음에 뭘 해야 할지 알려 줄 거야.");
 ds_map_add(m,"Finally the show ends and the people leave.","마침내 공연이 끝나고 사람들이 떠난다.");
 ds_map_add(m,"But Line is the only one who does not laugh.","하지만 라인만은 웃지 않는다.");
 ds_map_add(m,"The act seems to be a success and the public is dying of laughter.","공연은 성공한 듯했고 관객들은 웃다가 숨이 넘어갈 지경이었다.");
 ds_map_add(m,"Line and Lili arrive just in time to hear the show.","라인과 릴리는 공연을 들을 수 있는 딱 좋은 순간에 도착했다.");
 ds_map_add(m,"Oh-ok but help me in what you can.","아, 알겠어. 네가 할 수 있는 만큼 도와줘.");
 ds_map_add(m,"The cat lady that we gave him the fish and gave us a discount to buy clothes.","우리가 생선을 주고 옷을 살 때 할인까지 해 준 그 고양이 아가씨 말이야.");
 ds_map_add(m,"W-who?","누, 누구?");
 ds_map_add(m,"Don't worry Line we'll start with someone you know.","걱정하지 마, 라인. 네가 아는 사람부터 시작할게.");
 ds_map_add(m,"B-but you always do all the work, Lili you are my familiar it is your duty.","하, 하지만 늘 네가 다 하잖아, 릴리. 넌 내 사역마고, 그게 네 의무잖아.");
 ds_map_add(m,"Not this time, i will help you seduce your first person as sucubus.","이번엔 아니야. 네가 서큐버스로서 처음 누군가를 유혹할 수 있도록 내가 도와줄게.");
 ds_map_add(m,"You will help me meet another interesting person hehe?","헤헤, 또 다른 흥미로운 사람을 만날 수 있게 도와줄 거야?");
 ds_map_add(m,"Hey Line I know you have a hard time taking the first step talking to people.","이봐, 라인. 네가 먼저 다가가 사람들과 이야기하는 걸 어려워한다는 건 알고 있어.");
 ds_map_add(m,"Well if you really want to do that come behind the store but I still need to work.","정말 그러고 싶다면 가게 뒤로 와. 하지만 난 아직 일해야 해.");
 ds_map_add(m,"I did not know that someone loved me so much to go to these extremes.","누군가 나를 이렇게까지 사랑해 줄 줄은 몰랐어.");
 ds_map_add(m,"T-the thing is I see you working so hard and I would like to give you a good time but-but if you do not want to, I understand.","그, 그게…… 네가 너무 열심히 일하는 걸 봤어. 즐거운 시간을 보내게 해 주고 싶었거든. 하, 하지만 네가 원하지 않는다면 이해할게.");
 ds_map_add(m,"What!.","뭐라고!");
 ds_map_add(m,"I'm sorry for meddling, she wants to give you an oral because she loves you so much.","끼어들어서 미안해요. 그녀는 당신을 정말 사랑해서 구강성교를 해 주고 싶어 해요.");
 ds_map_add(m,"Ah well is mmm...","아, 그게…… 음……");
 ds_map_add(m,"What do you mean Line?","무슨 뜻이야, 라인?");
 ds_map_add(m,"I-I would like us to take this to something mo-more private.","나, 나는 우리 둘이 조, 좀 더 사적인 곳으로 갔으면 좋겠어.");
 ds_map_add(m,"I blush just to see you <3.","널 보기만 해도 얼굴이 빨개져 <3.");
 ds_map_add(m,"Wow Line you are a better person than I thought and you are always so attentive to me.","와, 라인. 넌 내가 생각했던 것보다 훨씬 좋은 사람이네. 게다가 언제나 나를 세심하게 챙겨 주잖아.");
 ds_map_add(m,"I'll see how she attends and I'll tell you how quickly you lick her, just be attentive.","그녀가 손님을 어떻게 대하는지 살펴보고, 얼마나 빠르게 핥아야 할지 알려 줄게. 집중해서 잘 봐.");
 ds_map_add(m,"Ok Line get down and get under the counter.","좋아, 라인. 몸을 낮춰서 카운터 밑으로 들어가.");
 ds_map_add(m,"Go talk to Callie.","캘리와 이야기해.");
 ds_map_add(m,"let's see how well you did.","얼마나 잘했는지 한번 보자.");
 ds_map_add(m,"But Lili :c.","하지만 릴리 :c.");
 ds_map_add(m,"Ah, don't worry Line we figure it out.","아, 걱정하지 마, 라인. 우리가 방법을 찾아낼게.");
 ds_map_add(m,"Bu-but what are we going to do?","하, 하지만 이제 어떻게 해야 하지?");
 ds_map_add(m,"Yeah maybe It wasn't the best person to improve your succubus powers.","그래, 어쩌면 네 서큐버스 능력을 키우는 데 그 사람이 가장 적합한 상대는 아니었을지도 몰라.");
 ds_map_add(m,"She wants to introduce me to her children and start a new family.","그녀는 자기 아이들에게 나를 소개하고 새로운 가족을 만들고 싶어 해.");
 ds_map_add(m,"I th-think we went to far.","내, 내 생각엔 우리가 너무 지나쳤어.");
 ds_map_add(m,"Wait Lili.","잠깐, 릴리.");
 ds_map_add(m,"Accept that you are half succubus, for God's sake you are already twenty.","제발 네가 반쪽 서큐버스라는 사실을 받아들여. 맙소사, 너도 벌써 스무 살이잖아.");
 ds_map_add(m,"O-ok I will use it as a last resort you know how shy i am.","아, 알겠어. 최후의 수단으로 사용할게. 내가 얼마나 수줍음이 많은지 너도 알잖아.");
 ds_map_add(m,"You have to use your succubus skills in combat to improve the changes of winning.","승리할 가능성을 높이려면 전투에서 서큐버스 기술을 사용해야 해.");
 ds_map_add(m,"Worth investigating but you can't lose again.","조사해 볼 가치는 있어. 하지만 다시 패배해서는 안 돼.");
 ds_map_add(m,"Of the demon there was already a one who knew Ava, maybe he knows something too.","그 악마들 중에 에이바를 아는 녀석이 있었어. 그 녀석도 뭔가 알고 있을지 몰라.");
 ds_map_add(m,"About what?","무엇에 관해서?");
 ds_map_add(m,"Lili, we have to do something.","릴리, 우린 뭔가 해야 해.");
 ds_map_add(m,"Saving the game will change the time of day, and there are certain events that only happen at specific times.","게임을 저장하면 시간이 바뀝니다. 특정 시간대에만 발생하는 이벤트도 있습니다.");
 ds_map_add(m,"Inside, you can save your game on a mattress that's on the floor.","안으로 들어가면 바닥에 놓인 매트리스에서 게임을 저장할 수 있습니다.");
 ds_map_add(m,"The warehause will be your personal home.","이 창고를 네 개인 집으로 사용하게 될 거야.");
 ds_map_add(m,"Uhhh, honestly, I do not like the idea, but it is better than nothing. ;c","으음…… 솔직히 그 생각은 마음에 들지 않지만, 아무것도 없는 것보다는 낫겠지. ;c");
 ds_map_add(m,"Oh, it was nothing... Hey, this cellar doesn't look so bad\nwe could use it as a home while we're on the island.","아, 별것도 아니야…… 이봐, 이 지하실 생각보다 나쁘지 않은데.\n섬에 머무는 동안 여기를 집으로 사용해도 되겠어.");
 ds_map_add(m,"You are a hero, Lili! <3.","릴리, 넌 정말 영웅이야! <3.");
 ds_map_add(m,"Take the baww, you adorable fwuff!","자, 공 받아! 귀여운 털뭉치야!");
 ds_map_add(m,"Hmm... I think he wants that ball on the roof, I'll get it down.","음…… 저 녀석은 지붕 위에 있는 공을 원하는 것 같아. 내가 내려 줄게.");
 ds_map_add(m,"Why did the dog bring us here?","개가 왜 우리를 여기로 데려온 거지?");
 ds_map_add(m,"Cariel Town","카리엘 마을");
 ds_map_add(m,"Welcome to the town of Cariel number one place for honeymoons, sexual discovery and acceptance by all.","카리엘 마을에 오신 것을 환영합니다! 신혼여행과 성적 취향의 탐구, 그리고 모든 사람을 향한 포용으로 유명한 최고의 장소입니다.");
 ds_map_add(m,"The idea is to give her to drink alcohol so that she is drunk enough to give us some good discounts.","술을 마시게 해서 적당히 취하게 만들면 우리에게 좋은 할인을 해 줄 거라는 생각이야.");
 ds_map_add(m,"I know it doesn't hydrate!","술이 수분을 보충해 주지 않는다는 건 나도 알아!");
 ds_map_add(m,"B-but that does not hydrate :c.","하, 하지만 술은 수분 보충이 안 되잖아 :c.");
 ds_map_add(m,"What we are going to do is buy alcohol at the bar.","우리가 할 일은 술집에서 술을 사는 거야.");
 ds_map_add(m,"Not that stupid! You see, that's why I'm the one in charge in this duo.","그렇게 멍청한 뜻이 아니잖아! 봐, 그래서 이 둘 중에서는 내가 책임자인 거야.");
 ds_map_add(m,"Yeah, I had planned to fill a bottle of water in the river","응, 강에서 물병에 물을 채울 생각이었어");
 ds_map_add(m,"Did you hear that line? she wants something to drink.","라인, 들었어? 저 여자가 마실 것을 원하잖아.");
 ds_map_add(m,"Thanks Lili you are the best <3.","고마워, 릴리. 네가 최고야 <3.");
 ds_map_add(m,"Of course Line go and have fun <3.","당연하지, 라인. 가서 즐겁게 놀아 <3.");
 ds_map_add(m,"Mmm.. ca-can I go now?.","음…… 저, 이제 가도 될까요?");
 ds_map_add(m,"Yeah, I only plan to have a discount. Maybe I have powers that exceed my own understanding.","응, 난 그저 할인을 받을 생각이었을 뿐이야. 어쩌면 내 능력이 내가 이해하는 수준을 넘어선 걸지도 모르겠네.");
 ds_map_add(m,"I think that woman wants to break my ass but in a good way","저 여자는 내 엉덩이를 부숴 버릴 생각인 것 같아. 물론 좋은 의미로.");
 ds_map_add(m,"Line.. what the fuck just happened?.","라인…… 대체 방금 무슨 일이 있었던 거야?");
 ds_map_add(m,"And just so you know I'm the one in charge here.","그리고 미리 말해 두겠는데, 여기서는 내가 책임자야.");
 ds_map_add(m,"Wha-Wha-Whaaat!","뭐, 뭐, 뭐라고!");
 ds_map_add(m,"You are very pretty, I guess your effort was worth it haha.","정말 예쁘시네요. 노력한 보람이 있었겠어요. 하하.");
 ds_map_add(m,"Ah!?","아!?");
 ds_map_add(m,"Do you know that it is also inappropriate? having sex behind my store.","내 가게 뒤에서 섹스하는 것도 부적절한 행동이라는 건 알고 있나요?");
 ds_map_add(m,"AHHhh. no-it was not intentional.. I am really sorry it was really inappropriate.","아아…… 아, 아니, 일부러 그런 건 아니었어요. 정말 죄송해요. 너무 부적절했어요.");
 ds_map_add(m,"I say I'm not stupid, notice how you undress me with your eyes from head to toe.","내가 바보인 줄 알아? 네가 머리부터 발끝까지 눈으로 내 옷을 벗기고 있는 게 다 보이는데.");
 ds_map_add(m,"What-what does that mean hehe.","그, 그게 무슨 뜻이에요? 헤헤.");
 ds_map_add(m,"And I love people with resilience.","그리고 난 끈기 있는 사람이 좋아.");
 ds_map_add(m,"I never thought after so many failed compliments you will buy some much drinks for me.","그렇게 엉터리 칭찬을 많이 해 놓고 나한테 술을 이렇게 많이 사 줄 줄은 몰랐어.");
 ds_map_add(m,"Now, shut up, I've been holding back all this time and I can't take it anymore.","이제 조용히 해. 지금까지 계속 참고 있었는데 더는 못 참겠어.");
 ds_map_add(m,"Don't worry, my pet will scare away anyone who come here.","걱정하지 마. 내 반려동물이 여기 오는 사람은 누구든 쫓아낼 거야.");
 ds_map_add(m,"I-I am somewhat shy, I do not know if I can do it here, someone could see us.","나, 나는 조금 수줍음이 많아. 여기서 해도 괜찮을지 모르겠어. 누군가 우리를 볼 수도 있잖아.");
 ds_map_add(m,"God, you're slow, why are you taking so long?","세상에, 정말 느리네. 대체 왜 이렇게 오래 걸리는 거야?");
 ds_map_add(m,"Well whatever, it was the first time i had such aggressive sex <3","뭐, 어쨌든 이렇게 거친 섹스는 처음이었어 <3.");
 ds_map_add(m,"... No.","……아니.");
 ds_map_add(m,"There is no possibility that she is also half succubus right?","설마 그녀도 반쪽 서큐버스일 가능성이 있는 건 아니겠지?");
 ds_map_add(m,"For the love of God, Line, you were the one who fainted at the climax, aren't you ashamed to be a succubus?","맙소사, 라인. 절정에 이르렀을 때 기절한 건 너였잖아. 서큐버스라는 게 부끄럽지도 않아?");
 ds_map_add(m,"Sure Sam <3.","물론이지, 샘 <3.");
 ds_map_add(m,"Oh wait Lilly could you go to the hotel and get my wallet for me? it's room 001.","아, 잠깐, 릴리. 호텔에 가서 내 지갑 좀 가져다줄래? 001호실이야.");
 ds_map_add(m,"That sounds good, let's get in.","괜찮은 생각이네. 들어가자.");
 ds_map_add(m,"If you want to rest before leaving, we can enter.","떠나기 전에 쉬고 싶다면 안으로 들어가도 돼.");
 ds_map_add(m,"Not quite, I use it to sleep from time to time.","완전히 빈 곳은 아니야. 가끔 여기서 잠을 자거든.");
 ds_map_add(m,"Hey Line, This place is empty?","이봐, 라인. 여긴 아무도 안 사는 곳이야?");
 ds_map_add(m,"Great go to the second floor of the hotel I'll wait for you there. <3","좋아. 호텔 2층으로 가. 거기서 기다리고 있을게. <3");
 ds_map_add(m,"It would be an honor lucy. <3","영광이에요, 루시. <3");
 ds_map_add(m,"I wanted you to see it before I publish it if you don't mind.","괜찮다면 출판하기 전에 네게 먼저 보여 주고 싶었어.");
 ds_map_add(m,"Thanks to you I had enough inspiration to finish my novel and well","네 덕분에 소설을 완성할 만큼 충분한 영감을 얻었어. 그래서 말인데……");
 ds_map_add(m,"Yes, what do you need?","네, 무슨 일이죠?");
 ds_map_add(m,"Line you have a moment.","라인, 잠깐 시간 있어?");
 ds_map_add(m,"I'm counting on you, we're short-handed due to the theft of the relics so just try to help out and stay out of trouble.","너희를 믿고 맡길게. 성유물 도난 사건 때문에 인력이 부족하니 할 수 있는 만큼 도와주고 문제만 일으키지 마.");
 ds_map_add(m,"Oh, ok I will do it.(I just hope Ava is on the island)","아, 알겠어요. 그렇게 할게요. (에이바가 이 섬에 있기만을 바라야겠어.)");
 ds_map_add(m,"And if you see any person on the island with a problem that you can solve, you will also offer your help.","그리고 섬에서 네가 해결할 수 있는 문제를 가진 사람을 만나면 그 사람도 도와줘야 해.");
 ds_map_add(m,"Mmmmm let me think... I know what you could do to help us look for the relic!","으음…… 생각 좀 해 볼게…… 그래, 성유물을 찾는 일을 도와주면 되겠어!");
 ds_map_add(m,"Wait isn't there a way to stay on the island since you know we are innocent?","잠깐, 우리가 무죄라는 걸 알고 있으면서도 섬에 머물 방법은 없는 거야?");
 ds_map_add(m,"I will escort you to your boat.","당신들을 배까지 안내하겠습니다.");
 ds_map_add(m,"If you stay you will hinder the search that is why the island is closed.","당신들이 남아 있으면 수색에 방해가 됩니다. 그래서 섬을 폐쇄한 겁니다.");
 ds_map_add(m,"A relic was recently stolen from the island and the witness was able to identify that the perpetrator had horns.","최근 섬에서 성유물 하나가 도난당했습니다. 목격자는 범인이 뿔을 가지고 있었다고 진술했죠.");
 ds_map_add(m,"Wh-what why?","뭐, 뭐라고요? 왜요?");
 ds_map_add(m,"I am sorry but I will have to ask you to leave the island.","죄송하지만 섬에서 나가 주셔야겠습니다.");
 ds_map_add(m,"Oh I ju-just arrived on a raft.","아, 저, 저는 뗏목을 타고 방금 도착했어요.");
 ds_map_add(m,"I have never seen you on this island before.","이 섬에서 당신을 본 적이 없습니다.");
 ds_map_add(m,"Ho-hello is there a problem?","아, 안녕하세요. 무슨 문제라도 있나요?");
 ds_map_add(m,"Hey you unihorn, come here now!","이봐, 외뿔 녀석! 당장 이리 와!");
 ds_map_add(m,"And-we could pick up where we left off <3.","그리고…… 전에 하다 만 일을 이어서 할 수도 있겠지 <3.");
 ds_map_add(m,"Great it will be the four of us, as soon as you get to the house, I'll make something you'll love!","정말 잘됐어! 우리 네 명이 함께하는 거야. 집에 도착하면 네가 정말 좋아할 만한 걸 만들어 줄게!");
 ds_map_add(m,"I-I would love to Callie.","캘리, 나, 나도 정말 그러고 싶어.");
 ds_map_add(m,"( I-I do not want to give her false hope, I really do not want to hurt her but to reject her would also be rude. )","(나, 나는 그녀에게 헛된 희망을 주고 싶지 않아. 정말 상처 주고 싶지도 않지만, 거절하는 것도 무례한 일이겠지.)");
 ds_map_add(m,"Hey Line, I was wondering if you wanted to have lunch with me and my son at my house today?","이봐, 라인. 오늘 우리 집에서 나와 내 아들과 함께 점심을 먹으면 어떨까 해서.");
 ds_map_add(m,"That's okay, at least I'll keep my oldest son, he'll keep his old mother company.","괜찮아. 적어도 큰아들은 곁에 남아 있잖아. 늙은 엄마 곁을 지켜 줄 테니까.");
 ds_map_add(m,"Oh... Callie I am so sorry.","아…… 캘리, 정말 미안해.");
 ds_map_add(m,"... Someone had to take care of them while I was away.","……내가 없는 동안 누군가는 아이들을 돌봐야 했으니까.");
 ds_map_add(m,"Well, sort of, I got out just in time to see my kids leave with their dad.","뭐, 어느 정도는 그렇지. 마침 집에서 나왔을 때 아이들이 아빠와 함께 떠나는 걸 봤어.");
 ds_map_add(m,"I am so glad Callie, now you can be with your children.","정말 기뻐, 캘리. 이제 아이들과 함께 지낼 수 있겠네.");
 ds_map_add(m,"Yeah haha, it's not like I did anything serious enough to stay there any longer.","그래, 하하. 더 오래 갇혀 있어야 할 만큼 심각한 짓을 한 건 아니었거든.");
 ds_map_add(m,"Callie, you are finally out of the jail-farm!","캘리, 드디어 감옥 농장에서 나왔구나!");
 ds_map_add(m,"Oh-Mmmm... but I've always been here.","아, 으음…… 하지만 난 계속 여기 있었는데.");
 ds_map_add(m,"Who are you? You should not be here.","당신은 누구죠? 여기에 있어서는 안 됩니다.");
 ds_map_add(m,"Hey everyone, come on in, the best store is open for everyone!","여러분, 어서 들어오세요! 최고의 가게가 모두에게 열려 있습니다!");
 ds_map_add(m,"Ah why, what did I say?","아니, 왜요? 제가 뭐라고 했죠?");
