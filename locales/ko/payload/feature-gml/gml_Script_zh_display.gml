 ds_map_add(m,"Oh shit!","아, 젠장!");
 ds_map_add(m,"Hey you pull up your pants before we break your ass. And you slut, you will come with us whether you want to or not!","야, 엉덩이 박살 나기 전에 바지부터 올려! 그리고 너, 이 걸레야. 싫든 좋든 우리와 함께 가야 해!");
 ds_map_add(m,"Ivy said if she refuses to come with us we can use force.","아이비가 말했어. 우리와 함께 가길 거부하면 강제로 데려가도 된다고.");
 ds_map_add(m,"Calm down it's not like she's not enjoying this right now.","진정해. 지금 저 여자도 꽤 즐기고 있는 것 같잖아.");
 ds_map_add(m,"Here you are you little slut, is time to go back were you belong.","여기 있었구나, 이 작은 걸레야. 네가 있어야 할 곳으로 돌아갈 시간이야.");
 ds_map_add(m,"Yes let's go back to mommy hehe.","그래, 엄마한테 돌아가자. 헤헤.");
 ds_map_add(m,"Well done Line, now let's get back to Ivy.","잘했어, 라인. 이제 아이비에게 돌아가자.");
 ds_map_add(m,"Now Line take a bottle off the shelf and catch it!","자, 라인. 선반에서 병 하나를 꺼내서 잡아!");
 ds_map_add(m,"Naoki go to the basement of the hospital where the generators are there we will tell you what to do next.","나오키, 발전기가 있는 병원 지하실로 가. 다음에 뭘 해야 할지는 거기서 알려 줄게.");
 ds_map_add(m,"Oh.. ok.","아…… 알겠어.");
 ds_map_add(m,"Fine, whatever. But if he screws things up worse, I'm blaming you.","좋아, 마음대로 해. 하지만 그가 일을 더 망치면 네 탓으로 돌릴 거야.");
 ds_map_add(m,"Nooo Faye, he is an excellent magician who practices day and night manipulating his magic in different ways is perfect for the task.","아니야, 페이. 그는 훌륭한 마법사야. 밤낮으로 마법을 여러 방식으로 다루는 연습을 해 왔어. 이 일에 딱 맞는 사람이야.");
 ds_map_add(m,"Oh I-I am sorry, you better find a be-better wizard Line.","아, 저, 죄송해요. 라인, 더, 더 나은 마법사를 찾는 게 좋겠어요.");
 ds_map_add(m,"He doesn't look nearly as powerful as the magicians from my time; are they actually that good?","그는 내 시대의 마법사들만큼 강해 보이지 않는데, 정말 실력이 그렇게 좋아?");
 ds_map_add(m,"Well ... hehehe who knows the truth. but I need your help urgently Naoki.","글쎄…… 헤헤, 누가 알겠어. 하지만 나오키, 네 도움이 급하게 필요해.");
 ds_map_add(m,"Oh, were you looking for me? I'm sorry I asked MsHonney for a place to practice my show. Although practicing is a bit difficult here it smells strange and everything is wet.","아, 날 찾고 있었어? 미안해. 허니 부인에게 공연 연습할 장소를 부탁했거든. 그런데 여긴 연습하기가 좀 힘들어. 냄새도 이상하고 온통 축축해.");
 ds_map_add(m,"Naoki we finally find you!","나오키, 드디어 찾았어!");
 ds_map_add(m,"Hey!! only residents can access that section of the hotel.","이봐!! 호텔의 저 구역은 투숙객만 들어갈 수 있어.");
 ds_map_add(m,"Hey!! only the staff can access that section of the hotel.","이봐!! 호텔의 저 구역은 직원만 출입할 수 있어.");
 ds_map_add(m,"Also that is the floor where baina stays, if something goes wrong we can ask her for help.","그리고 바이나가 그 층에 머물고 있어. 일이 잘못되면 그녀에게 도움을 청할 수도 있어.");
 ds_map_add(m,"I don't think it hurts here is a safe place after all.","여긴 안전한 곳이니 별일 없을 거야.");
 ds_map_add(m,"What do you say line?","라인, 어떻게 생각해?");
 ds_map_add(m,"Calm I know MsHonney, returning to the subject, it seems she is not from here she had very strange clothes and that's all I know.","진정해. 난 허니 부인을 알아. 다시 본론으로 돌아가서, 그 여자는 이곳 출신이 아닌 것 같아. 옷차림이 아주 특이했어. 내가 아는 건 그게 전부야.");
 ds_map_add(m,"Lili !! do not be-believe her, that is false it was not like that.","릴리!! 그, 그녀 말을 믿지 마. 그건 거짓말이야. 그런 일은 없었어.");
 ds_map_add(m,"Hey! But tell us what she want, the last time I left you alone with a woman in this hotel I found my friend in a puddle of pee!","이봐! 그 여자가 뭘 원하는지 말해 줘. 지난번에 이 호텔에서 너와 어떤 여자를 단둘이 두고 갔다가, 돌아와 보니 내 친구가 오줌 웅덩이에 빠져 있었잖아!");
 ds_map_add(m,"Oh no, it seems a lady saw you in the town and asked me if you could find her on the third floor.","아니, 그게 아니라. 마을에서 한 여성이 널 보고는 3층에서 자신을 찾아올 수 있겠냐고 물어봤어.");
 ds_map_add(m,"Yes, does MsHonney ne-need me again <3?","허니 부인께서 또 저, 저를 필요로 하시나요? <3");
 ds_map_add(m,"Hey you are Line aren't you?","이봐, 네가 라인 맞지?");
 ds_map_add(m,"Hey you! the girl with blue hair with the fairy.","이봐, 너! 요정과 함께 다니는 파란 머리 여자!");
 ds_map_add(m,"oh cierto losiento lili u.u","아, 맞아. 미안해, 릴리 u.u");
 ds_map_add(m,"no maldita idiota la informacion sobre tu amiga!","아니, 이 빌어먹을 멍청아! 네 친구에 관한 정보 말이야!");
 ds_map_add(m,"si con le pedire un role play de mama <3","응, 그녀에게 엄마 역할극을 부탁할 거야 <3.");
 ds_map_add(m,"bien hecho Line ahora busquemos a ivy por la recompensa","잘했어, 라인. 이제 보상을 받으러 아이비를 찾아가자.");
 ds_map_add(m,"Hey tu la de pelo azul","이봐, 파란 머리 여자!");
 ds_map_add(m,"Ok that's it!","좋아, 그만해!");
 ds_map_add(m,"Hey chill,  we can help you clean jeez girl.","진정해. 청소하는 걸 도와줄 수 있어. 아이고, 아가씨.");
 ds_map_add(m,"Now Mr.Cabello will return tired from his work and he will see that I did nothing!!","이제 카베요 씨가 퇴근하고 피곤한 몸으로 돌아올 텐데, 내가 아무것도 안 한 걸 보게 될 거야!!");
 ds_map_add(m,"You know how long it took me to clean this floor!","내가 이 바닥을 청소하는 데 얼마나 오래 걸렸는지 알아?");
 ds_map_add(m,"Ups. I am really really sorry.","앗. 정말 정말 죄송해요.");
 ds_map_add(m,"What are you doing?!.","뭐 하는 거야?!");
 ds_map_add(m,"The three of them managed to get every little mound of dust off the second floor.","세 사람은 2층의 작은 먼지더미 하나까지 전부 치워 냈다.");
 ds_map_add(m,"After 15 minutes of thorough cleaning.","15분 동안 꼼꼼하게 청소한 뒤.");
 ds_map_add(m,"The three of them start cleaning.","세 사람은 청소를 시작했다.");
 ds_map_add(m,"Yes, whatever I can clean in the small spaces.","그래, 좁은 틈새는 내가 청소할 수 있어.");
 ds_map_add(m,"Lili you are going to help us <3?!","릴리, 우리를 도와주려는 거야 <3?!");
 ds_map_add(m,"No, between the three of us we can really clean it up in minutes.","아니, 우리 셋이면 몇 분 안에 깨끗하게 치울 수 있어.");
 ds_map_add(m,"But I know that between the two of us we can clean this up in minutes <3.","그래도 우리 둘이 힘을 합치면 몇 분 만에 청소할 수 있을 거야 <3.");
 ds_map_add(m,"Thank , and I'm sorry for getting so angry I always try to give 100% in my work and things like this really annoy me.","고마워. 그리고 너무 화내서 미안해. 난 항상 일에 100%를 쏟으려고 하는데, 이런 일이 생기면 정말 짜증이 나거든.");
 ds_map_add(m,"I am sorry it was all my fault I will clean all this up.","미안해. 전부 내 잘못이야. 내가 다 치울게.");
 ds_map_add(m,"I guess I have nothing left but to clean everything again.","아무래도 모든 걸 다시 청소하는 수밖에 없겠네.");
 ds_map_add(m,"How could I forget, come Line, Mommy has something just for you hehe..","어떻게 잊겠니. 이리 와, 라인. 엄마가 너만을 위해 준비한 게 있단다. 헤헤.");
 ds_map_add(m,"hey don't you owe something to my friend?","이봐, 내 친구한테 빚진 거 있지 않아?");
 ds_map_add(m,"It feels great to have my height back <3.","원래 키로 돌아오니 정말 좋다 <3.");
 ds_map_add(m,"*Line uncaps the bottle and Ivy is back to her original height*","*라인이 병뚜껑을 열자 아이비가 원래 키로 돌아온다*");
 ds_map_add(m,"Oh I put it in a bottle, wait for me a second.","아, 병에 담아 뒀어. 잠깐만 기다려.");
 ds_map_add(m,"Great and where is it?","좋아, 어디 있는데?");
 ds_map_add(m,"Ivy, We found her <3!","아이비, 찾았어 <3!");
 ds_map_add(m,"I thought you went to the house sorry LilI :c.","네가 집에 간 줄 알았어. 미안해, 릴리 :c.");
 ds_map_add(m,"Line you dirty slut, you made me wait here while I hear you say, yes mommy I love you and stuff and you ask me what I'm waiting for?","라인, 이 더러운 걸레야. 네가 안에서 '네, 엄마. 사랑해요' 같은 말을 하는 걸 듣느라 여기서 기다렸잖아. 그런데 나한테 뭘 기다리냐고 묻는 거야?");
 ds_map_add(m,"Mmm, and what are you waiting for?","음, 뭘 기다리고 있는데?");
 ds_map_add(m,"Yeah,I'll be waiting for you there.","그래, 거기서 기다릴게.");
 ds_map_add(m,"With this we will enter the sabbath?","이걸로 사바스에 들어갈 수 있는 거야?");
 ds_map_add(m,"Finally you arrived, take this armor and put it near the night club, it is a bit heavy.","드디어 왔군. 이 갑옷을 받아서 나이트클럽 근처에서 입어. 조금 무거울 거야.");
 ds_map_add(m,"Silently lucy stops telling the story and gets into bed with Line.","루시는 조용히 이야기를 멈추고 라인과 함께 침대에 들어갔다.");
 ds_map_add(m,"Due to the story and seeing lucy getting hotter and hotter Line starts touching himself in front of lucy.","이야기를 듣고 점점 더 흥분하는 루시를 보던 라인은 루시 앞에서 자위를 시작했다.");
 ds_map_add(m,"Lucy is visibly more agitated with the description of the sex scene.","섹스 장면을 묘사하는 이야기가 이어지자 루시는 눈에 띄게 더 흥분했다.");
 ds_map_add(m,"Suddenly the narrative starts to get hotter and hotter.","갑자기 이야기는 점점 더 뜨거워지기 시작했다.");
 ds_map_add(m,"The story is about a half-succubus elf who is the servant of a king.","그 이야기는 왕의 하인이 된 반쪽 서큐버스 엘프에 관한 것이었다.");
 ds_map_add(m,"Lucy takes the book but instead of letting Line read it she begins to narrate it.","루시는 책을 가져갔지만, 라인에게 읽게 하는 대신 직접 이야기를 들려주기 시작했다.");
 ds_map_add(m,"Hehe you are so excited, I want to know how my adventures inspired you. <3","헤헤, 정말 신났구나. 내 모험이 네게 어떤 영감을 줬는지 알고 싶어 <3.");
 ds_map_add(m,"Line you finally arrived, please come to my room. <3","라인, 드디어 왔구나. 내 방으로 와 줘 <3.");
 ds_map_add(m,"* gulp-gulp *","*꿀꺽꿀꺽*");
 ds_map_add(m,"Now your talking my little succubus <3, now get ready i will grow a perfect penis for newbies <3 a technique that only the best succubus can do.","바로 그거야, 나의 작은 서큐버스 <3. 이제 준비해. 초보자에게 딱 맞는 완벽한 자지를 만들어 줄게 <3. 최고의 서큐버스만 할 수 있는 기술이지.");
 ds_map_add(m,"I do-do not think there is a problem i mean the only person who goes up here is Baina","나, 난 별문제 없을 것 같은데. 여기 위층에 올라오는 사람은 바이나뿐이잖아.");
 ds_map_add(m,"You see Line your fairy even agrees with me, a cardio session at full power with me will do wonders for you. <3","봤지, 라인? 네 요정도 내 말에 동의하잖아. 나와 함께 전력을 다해 유산소 운동을 하면 네게 큰 도움이 될 거야 <3.");
 ds_map_add(m,"You wanted to get into this mess, also I think he is right, even if you are a succubus or you faint or you are the first to finish.","네가 이 일에 끼어들고 싶어 했잖아. 그리고 내 생각에도 그가 맞아. 네가 서큐버스라도 기절하거나 네가 먼저 끝나거나 둘 중 하나겠지.");
 ds_map_add(m,"WHAT, but here and now ?!","뭐라고? 하, 하지만 여기서 지금 당장?!");
 ds_map_add(m,"You will have a session five positions and in each one I will finish which you must transform the semen into energy.","다섯 가지 자세로 훈련할 거야. 각 자세에서 내가 한 번씩 사정할 테니, 넌 정액을 에너지로 바꿔야 해.");
 ds_map_add(m,"We are gonna have sex of course <3","당연히 섹스하지 <3.");
 ds_map_add(m,"Oh okay then what are we gonna do Big sis?","아, 알겠어. 그럼 이제 뭘 할 거야, 언니?");
 ds_map_add(m,"Please call me Big sis.","나를 언니라고 불러 줘.");
 ds_map_add(m,"Thanks sakura hehe. <3","고마워, 사쿠라. 헤헤 <3.");
 ds_map_add(m,"I mean your stamina haha, don't worry line you are beautiful just the way you are. <3","네 체력을 말한 거야, 하하. 걱정 마, 라인. 넌 지금 모습 그대로도 아름다워 <3.");
 ds_map_add(m,"hey watch your mauth! Line is not chubby, she is full of love","이봐, 말조심해! 라인은 통통한 게 아니야. 사랑이 가득한 거라고.");
 ds_map_add(m,"I know, that you I gained a little weight :c","알아. 나 조금 살이 찌긴 했어 :c.");
 ds_map_add(m,"But first of all you have a horrible physical condition right now you are panting","하지만 우선 네 체력이 지금 너무 엉망이야. 벌써 숨을 헐떡이고 있잖아.");
 ds_map_add(m,"It was great <3! Although your succubus skills are not the best, your elf side makes up for what you lack.","정말 좋았어 <3! 서큐버스 기술은 아직 최고 수준이 아니지만, 엘프의 힘이 부족한 부분을 채워 주는구나.");
 ds_map_add(m,"* gasping * so- so what do you think sakura.","*헐떡이며* 그, 그래서 어떻게 생각해, 사쿠라?");
 ds_map_add(m,"Sakura the succubus Queen of another world","사쿠라, 이세계의 서큐버스 여왕.");
 ds_map_add(m,"Hehe, it sounds good, I'll see you there <3","헤헤, 괜찮은데. 거기서 보자 <3.");
 ds_map_add(m,"We live in an abandoned storage, warehouse or something like that, you can stay but you have to get yourself a job we don't even have to buy food for ourselves.","우린 버려진 창고인지 보관소인지 하는 곳에서 살아. 머물러도 되지만 직접 일자리를 구해야 해. 우리도 먹을 것 살 돈조차 없거든.");
 ds_map_add(m,"I guess it's okay where can I find you again?","그 정도면 괜찮을 것 같아. 다음에 어디서 널 찾으면 돼?");
 ds_map_add(m,"let her rest, it's the first time she lasted so long.","그녀를 쉬게 둬. 이렇게 오래 버틴 건 처음이니까.");
 ds_map_add(m,"Hey but cute the training is not over yet.","잠깐만, 귀염둥이. 훈련은 아직 끝나지 않았어.");
 ds_map_add(m,"Uff that was  great and really  exausting.","후우, 정말 좋았어. 엄청 지치긴 했지만.");
 ds_map_add(m,"Don't worry I'll give you the best death an elf can have.","걱정 마. 엘프가 누릴 수 있는 최고의 죽음을 선사해 줄게.");
 ds_map_add(m,"Wa-wait! you are forgetting about me.","자, 잠깐! 나를 잊었잖아.");
 ds_map_add(m,"I don't wanna die, this is your fault!","죽고 싶지 않아. 이건 네 잘못이야!");
 ds_map_add(m,"Hu-Hu a little pink snack.","후후, 분홍빛 작은 간식이네.");
 ds_map_add(m,"*whispering* It's perfect Line, she doesn't know you're a succubus drain her until she falls asleep and we'll win.","*속삭이며* 완벽해, 라인. 그녀는 네가 서큐버스인 걸 몰라. 잠들 때까지 정기를 빨아들이면 우리가 이길 거야.");
 ds_map_add(m,"Dont worry, you'll live as long as you keep satisfying me <3.","걱정 마. 계속 날 만족시켜 주기만 하면 살아 있을 수 있어 <3.");
 ds_map_add(m,"Line you will never beat her in a fight.","라인, 넌 그녀와 싸워서 절대 이길 수 없어.");
 ds_map_add(m,"Dagnabbit is to strong!","젠장, 너무 강하잖아!");
 ds_map_add(m,"By the way I am half succubus and it helps me to fight differently don't think anything strange. :c","참, 난 반쪽 서큐버스야. 그래서 조금 다른 방식으로 싸울 수 있어. 이상하게 생각하지 마 :c.");
 ds_map_add(m,"I'll keep it in a safe place where it won't make any trouble.","문제를 일으키지 않도록 안전한 곳에 보관할게.");
 ds_map_add(m,"All right, but don't kill the demon, we have questions for her.","좋아. 하지만 악마를 죽이지는 마. 그녀에게 물어볼 게 있어.");
 ds_map_add(m,"Well everything it turn ok plus you help me with this problem I will make the guards find this friends of yours.","모든 일이 잘 해결됐고 너희가 이 문제까지 도와줬으니, 경비병들에게 너희 친구를 찾아보라고 시키겠어.");
 ds_map_add(m,"Cof cof... returning to the topic.","콜록콜록…… 다시 본론으로 돌아가서.");
 ds_map_add(m,"Great, you are just another pervert.","잘됐네. 너도 그냥 변태였구나.");
 ds_map_add(m,"I was waiting for the right moment to attack when your friend ... you know, I lost concentration..","네 친구가…… 알잖아. 내가 집중력을 잃어버렸을 때, 적절한 공격 기회를 기다리고 있었어.");
 ds_map_add(m,"What?! You stared us, while we almost die!","뭐라고?! 우리가 죽을 뻔했는데 계속 구경만 했다고?!");
 ds_map_add(m,"Wha-what? you saw me do-doing those sthings.","뭐, 뭐라고? 내가 그런 짓을 하는 걸 봤어?");
 ds_map_add(m,"I must say it's a peculiar way of fighting.","독특한 전투 방식이라고 해야겠군.");
 ds_map_add(m,"I know, I've been watching all this time.","알아. 줄곧 지켜보고 있었어.");
 ds_map_add(m,"Yeah and don't play the victim, we beat the demon!","그래, 피해자인 척하지 마. 우리가 악마를 물리쳤잖아!");
 ds_map_add(m,"I am sorry we came to know if she had information about our friend.","미안해요. 그녀가 우리 친구에 관한 정보를 알고 있는지 확인하러 왔어요.");
 ds_map_add(m,"So you are the adventurer giving false orders to my guards?.","그러니까 경비병들에게 거짓 명령을 내린 모험가가 바로 당신인가?");
 ds_map_add(m,"I am also perfect baby.","나도 완벽해, 자기야.");
 ds_map_add(m,"Fuck no, she said that I was a corrupt fairy because I seem to curse a lot.","아니, 젠장. 그 여자가 내가 욕을 자주 한다는 이유로 타락한 요정이라고 했어.");
 ds_map_add(m,"Won't you pray to the goddess of fairies?","요정의 여신께 기도하지 않을 거야?");
 ds_map_add(m,"* praying * oh incubus god and elf goddess I beg you to bless us so that everything goes well for us.","*기도하며* 오, 인큐버스의 신과 엘프의 여신이여, 저희를 축복하시어 모든 일이 잘 풀리게 해 주소서.");
 ds_map_add(m,"Lili what is happening to you? You are not like that, well I will take them but not for your reasons if not because he asked them.","릴리, 대체 왜 그래? 너답지 않잖아. 좋아, 가져올게. 하지만 네가 말한 이유 때문이 아니라 그가 부탁했기 때문이야.");
 ds_map_add(m,"You know forget it if it kills us it will be your fault but let's take all the wines we can, maybe it won't kill us that way.","됐어, 잊어버려. 이게 우릴 죽이면 네 책임이야. 그래도 와인은 가능한 한 많이 가져가자. 그러면 죽이지 않을지도 모르잖아.");
 ds_map_add(m,"But didn't you see how he yell at you before ?!","하지만 아까 그가 너한테 소리 지르는 거 못 봤어?!");
 ds_map_add(m,"* surprise * Oh, Lili .. did you just judge someone without even knowing him?","*놀라며* 어머, 릴리…… 그 사람을 알지도 못하면서 벌써 판단한 거야?");
 ds_map_add(m,"Damn Line! look at his appearance the guy could not look more dangerous.","젠장, 라인! 저 모습을 봐. 저 사람은 더 위험해 보일 수가 없을 정도야.");
 ds_map_add(m,"Well, we are here, and if it was so dangerous, why not, did he attack us before?","글쎄, 우린 여기까지 왔잖아. 그렇게 위험하다면 아까 우리를 공격하지 않았겠어?");
 ds_map_add(m,"Line I think he apologizes for us to do what he needs and not because he really is sorry.","라인, 그가 사과한 건 정말 미안해서가 아니라 우리가 자기 일을 해 주게 만들려는 것 같아.");
 ds_map_add(m,"Nooo! He needs help also, you saw how I did apologize and if a person manages to apologize I don't think it's as bad as you say.","아니야! 그 사람도 도움이 필요하잖아. 네가 봤듯이 나한테 사과도 했어. 사과할 줄 아는 사람이라면 네가 말한 만큼 나쁘지는 않을 거야.");
 ds_map_add(m,"Line I know that you are a little naive for this world but I think it would be better not to go back to that guy.","라인, 네가 이 세상에 조금 순진하다는 건 알아. 하지만 그 남자에게 다시 가지 않는 게 좋겠어.");
 ds_map_add(m,"We got it  lili <3!.","찾았어, 릴리 <3!");
 ds_map_add(m,"I'm sorry but we can't, someone else needs this crystal to return home","미안하지만 안 돼. 다른 사람이 집으로 돌아가는 데 이 수정이 필요해.");
 ds_map_add(m,"Why is it that every time I find a crystal, you are in the middle?","왜 내가 수정을 찾을 때마다 네가 끼어드는 거야?");
 ds_map_add(m,"This Crystal belongs to the Red Team.","이 수정은 레드 팀 소유야.");
 ds_map_add(m,"No Lili, that poor man needs our help, if not, he will never return to his dimension","안 돼, 릴리. 저 불쌍한 사람은 도움이 필요해. 그러지 않으면 자기 차원으로 영영 돌아갈 수 없을 거야.");
 ds_map_add(m,"Line let her take it and let's go on our way","라인, 그녀가 가져가게 두고 우리 갈 길을 가자.");
 ds_map_add(m,"DEV: Sorry dude, the gallery is only for the full game you will have to put away that dingledong.","개발자: 미안, 친구. 갤러리는 정식 게임에서만 이용할 수 있어. 그 고추는 집어넣어 둬.");
 ds_map_add(m,"Saving the game do not turn off the console...","게임을 저장하는 중입니다. 콘솔 전원을 끄지 마세요……");
 ds_map_add(m,"Gallery.","갤러리.");
 ds_map_add(m,"Do you want to sleep and save the game?","잠을 자고 게임을 저장하시겠습니까?");
 ds_map_add(m,"I know that is why I want to give you this, my friend Laura loves it.","알아. 그래서 이걸 주고 싶은 거야. 내 친구 로라가 정말 좋아하거든.");
 ds_map_add(m,"Oh theres no problem I did it because I wanted to be close to you, i gues hehe.","아, 괜찮아. 그냥 너와 가까워지고 싶어서 그랬던 것 같아. 헤헤.");
 ds_map_add(m,"Line, I wanted to thank you for helping me catch that criminal.","라인, 그 범인을 잡는 데 도와줘서 고맙다는 말을 하고 싶었어.");
 ds_map_add(m,"I could not agree more haha.","나도 전적으로 동의해, 하하.");
 ds_map_add(m,"I must say it was a pleasure to be so close to her <3.","그녀와 그렇게 가까이 있을 수 있어서 정말 즐거웠어 <3.");
 ds_map_add(m,"Oh look what she gave me before he left, it's an autographed photo of her and 30 buppy bucks if we go to tricotex someday.","아, 그녀가 떠나기 전에 내게 뭘 줬는지 봐. 사인 사진이랑, 언젠가 트리코텍스에 가면 쓸 수 있는 바피 벅스 30개야.");
 ds_map_add(m,"Dont worry about me Lili, I do not think saying goodbye was necessary <3.","걱정 마, 릴리. 작별 인사를 꼭 할 필요는 없었다고 생각해 <3.");
 ds_map_add(m,"Oh Line you fell asleep, and you couldn't you said goodbye to Sam.","라인, 잠들어 버렸네. 그래서 샘에게 작별 인사도 못 했어.");
 ds_map_add(m,"Line realizes that she is in her bed and understands that Sam left her there.","라인은 자신이 침대에 누워 있다는 걸 깨닫고, 샘이 자신을 데려다 놓았다는 사실을 알아차린다.");
 ds_map_add(m,"Lili wakes up Line.","릴리가 라인을 깨운다.");
 ds_map_add(m,"Give me everything you got!","네가 가진 걸 전부 보여 줘!");
 ds_map_add(m,"Ca-calm Line I... I.. I can not contain myself anymore.","진, 진정해, 라인. 나…… 나…… 더는 참을 수 없어.");
 ds_map_add(m,"The fruit made you gro-grow a really big penis.","그 과일 때문에 네게 엄청나게 큰 자지가 자라났어.");
 ds_map_add(m,"I would not know how to do it, please help me, I can no longer contain myself.","어떻게 해야 할지 모르겠어. 제발 도와줘. 더는 참을 수가 없어.");
 ds_map_add(m,"You-your fruit made me grow this.","네, 네 과일 때문에 이런 게 자라났어.");
 ds_map_add(m,"Please Vasuki I don't think I can't masturbate.","제발, 바수키. 나 혼자서는 자위도 못 할 것 같아.");
 ds_map_add(m,"I will go to that corner until the effect passes be-because I think the e-effect is increasing.","효과가 사라질 때까지 저 구석에 가 있을게. 효, 효과가 점점 강해지는 것 같거든.");
 ds_map_add(m,"Line no I... I can't cheat on my husband.","라인, 안 돼. 나…… 남편을 배신할 수는 없어.");
 ds_map_add(m,"Vasuki, please, I think I can't take it anymore.","바수키, 제발. 더는 못 참을 것 같아.");
 ds_map_add(m,"I'm-sorry, I'm not a lesbian and I-have a family.","죄, 죄송해요. 저는 레즈비언도 아니고 가, 가족도 있어요.");
 ds_map_add(m,"Oh Vasuki, I really would like to kiss that angelic face of yours.","아, 바수키. 네 천사 같은 얼굴에 정말 입 맞추고 싶어.");
 ds_map_add(m,"Yeah I think mine is an aphrodisiac, I-I feel kinda hot.","그래, 내 과일은 최음제인 것 같아. 나, 몸이 좀 달아오르는 것 같아.");
 ds_map_add(m,"Ohh... Vasuki these fruits have something strange about them.","아…… 바수키, 이 과일들 뭔가 이상해.");
 ds_map_add(m,"Vasuki and Line eat the exotic fruits.","바수키와 라인이 이국적인 과일을 먹는다.");
 ds_map_add(m,"Ok i will eat the red one.","좋아, 난 빨간 걸 먹을게.");
 ds_map_add(m,"I want to eat the long one.","난 긴 걸 먹고 싶어.");
 ds_map_add(m,"The cows gave it to me, so that I could sell them instead of eating them, but since we don't have anything else.","소들이 먹지 말고 팔라고 준 거야. 그런데 다른 먹을 게 없으니까.");
 ds_map_add(m,"Wow i've never seen these fruits before.","와, 이런 과일은 처음 봐.");
 ds_map_add(m,"Look Line, aren't these fruits strange? hehe.","라인, 이것 좀 봐. 과일들이 정말 이상하지 않아? 헤헤.");
 ds_map_add(m,"Also I think there is something more that want me to stay.","그리고 나를 여기 붙잡아 두려는 다른 이유도 있는 것 같아.");
 ds_map_add(m,"My husband is the King he will protect the children, now I just want to be with you Line <3.","남편은 왕이니까 아이들을 지켜 줄 거야. 이제 난 너와 함께 있고 싶어, 라인 <3.");
 ds_map_add(m,"Wha-what about-your family?","그, 그럼 네 가족은?");
 ds_map_add(m,"You know what, I could stay here a while longer and be with you.","있잖아, 여기 조금 더 머물면서 너와 함께 있어도 될 것 같아.");
 ds_map_add(m,"Yes, love was the best, too bad you have to go.","그래, 자기야. 정말 좋았어. 네가 떠나야 한다니 아쉽네.");
 ds_map_add(m,"Ohh. Line th-that was great..","아…… 라인. 저, 정말 좋았어……");
 ds_map_add(m,"Although, it is not that bad.","그래도 그렇게 나쁘지는 않아.");
 ds_map_add(m,"*Takes off his boots*  Uhhh it seems that I have walked a lot this smell is very strong.","*부츠를 벗는다* 어…… 많이 걸었나 봐. 냄새가 정말 심하네.");
 ds_map_add(m,"A well-deserved rest after helping every DAM islander you bump into!","섬에서 마주치는 주민마다 죄다 도와줬으니, 이제 쉴 자격은 충분해!");
 ds_map_add(m,"Ohh finally I will be able to rest a bit","아…… 드디어 조금 쉴 수 있겠어.");
 ds_map_add(m,"Help me please! I feel like I'm going to explode, I really need it!","제발 도와줘! 터질 것 같아. 정말 필요해!");
 ds_map_add(m,"Ya ssh sh I need you to put it in, I can't wait!","그래, 쉿, 쉿. 넣어 줘. 더는 기다릴 수 없어!");
 ds_map_add(m,"bu-but.","그, 그런데.");
 ds_map_add(m,"Now! Lili uses your weapon to create a mega cock!","지금이야! 릴리, 네 무기로 거대한 자지를 만들어!");
 ds_map_add(m,"I don't recognize you...","당신이 누군지 모르겠는데……");
 ds_map_add(m,"Oh fuck you and do not talk to me about this subject anymore!","엿이나 먹어. 이 얘기는 다시는 꺼내지 마!");
 ds_map_add(m,"I didn't think something like this could happen, Line even has people here and you didn't give a crap!","이런 일이 벌어질 줄은 몰랐어. 라인, 여기 다른 사람들도 있는데 넌 전혀 신경도 안 썼잖아!");
 ds_map_add(m,"Shut up, I can quit this, whenever I want, did you not say you would help me in whatever I need!","닥쳐. 난 원할 때 언제든 그만둘 수 있어. 내가 필요한 건 뭐든 도와주겠다고 네가 말했잖아!");
 ds_map_add(m,"But it hasn't been long since the last time you had sex... Line I think you have to stop this for a while.","하지만 마지막으로 섹스한 지 얼마 되지도 않았잖아…… 라인, 한동안은 이걸 그만둬야 할 것 같아.");
 ds_map_add(m,"I had not had sex in a while.","한동안 섹스하지 않았어.");
 ds_map_add(m,"Line, are you okay, did you relax? It's the first time I've seen you like this.","라인, 괜찮아? 좀 진정됐어? 네가 이렇게 된 건 처음 봐.");
 ds_map_add(m,"I didn't think something like this could happen.","이런 일이 일어날 줄은 몰랐어.");
 ds_map_add(m,"AHHH MY BALLLS!!","아아아, 내 불알!!!");
 ds_map_add(m,"I am so sorry ;c I trie my best to contain her rage.","정말 미안해 ;c. 그녀의 분노를 억누르려고 최선을 다했어.");
 ds_map_add(m,"Shit that woman hit me in the balls in the Sabbath.","젠장, 그 여자가 사바스에서 내 불알을 걷어찼어.");
 ds_map_add(m,"Yes, we are not priority because they are unconscious by magic, but I want to know if they will be alright anyway..","그래, 마법 때문에 의식을 잃은 상태라 우선순위가 높지는 않아. 그래도 괜찮을지 알고 싶어……");
 ds_map_add(m,"Naoki, are you still waiting here?","나오키, 아직도 여기서 기다리고 있어?");
 ds_map_add(m,"I'm half elf so I think it comes from that ahah.","난 반쪽 엘프거든. 아마 그 때문일 거야. 하하.");
 ds_map_add(m,"Oh Maruia you are a very good orc. <3","아, 마루이아. 넌 정말 좋은 오크야 <3.");
 ds_map_add(m,"I am waiting, that they attend one of the miners.","광부 한 명을 치료해 주길 기다리고 있어.");
 ds_map_add(m,"Good, thanks for asking and what are you doing?.","잘 지내. 물어봐 줘서 고마워. 넌 뭐 하고 있어?");
 ds_map_add(m,"Oh Line, how's everything going?","아, 라인. 모든 일이 잘되고 있어?");
 ds_map_add(m,"Oh okay do not worry, if it is just raising a lever I do not think it won't take more than 2 minutes","아, 알겠어. 걱정 마. 레버만 올리면 되는 거라면 2분도 안 걸릴 거야.");
 ds_map_add(m,"It is, our reserve generators went off and I need you to lift a lever to turn them on. They are in the left basement of the hospital.","맞아. 예비 발전기가 멈췄어. 다시 켜려면 레버를 올려야 해. 병원 왼쪽 지하실에 있어.");
 ds_map_add(m,"Mmmm well, if it is something small","음, 작은 일이라면야.");
 ds_map_add(m,"If you don't need anything, could you do me a little favor?","필요한 게 없다면 부탁 하나만 들어줄래?");
 ds_map_add(m,"Oh ,well the truth no, but thanks.","아, 사실은 아니야. 그래도 고마워.");
 ds_map_add(m,"Hello, good morning, are you coming for a check-up?","안녕하세요, 좋은 아침이에요. 진찰받으러 오셨나요?");
 ds_map_add(m,"Something like that, he told me he had to train privately for his show so I think he went to find a new hiding place to practice his magic.","비슷해요. 공연을 위해 따로 연습해야 한다고 했으니, 마법을 연습할 새로운 은신처를 찾으러 간 것 같아요.");
 ds_map_add(m,"And he said where was he going?","그가 어디로 간다고 했나요?");
 ds_map_add(m,"It seemed that he had something to do so I told him to leave, and I will wait for my sister.","할 일이 있는 것 같아서 먼저 가라고 했어요. 저는 언니를 기다릴게요.");
 ds_map_add(m,"Hi Equinox, have you seen Naoki?","안녕, 이퀴녹스. 나오키 봤어?");
 ds_map_add(m,"Iugg Lili kill me please *covers her face in shame*.","으으, 릴리. 차라리 날 죽여 줘. *부끄러워 얼굴을 가린다*");
 ds_map_add(m,"I recommend less sex if you are not going to take care of your hygiene.","위생 관리를 할 생각이 없다면 섹스 횟수를 줄이는 걸 권해요.");
 ds_map_add(m,"Uhhh... is it okay, I am sorry *sobs*.","어…… 괜찮을까요? 죄송해요. *흐느낀다*");
 ds_map_add(m,"Summary, High amount of sexual intercourse plus never having had a cleaning before will raise the price to a whopping amount.","정리하자면, 성관계 횟수가 많고 한 번도 세척한 적이 없다면 비용이 엄청나게 올라가요.");
 ds_map_add(m,"since it would be your first time, it would probably take more than usual, plus I've worked long enough to know that you've already had sex, which raises the price.","처음 받는 거라면 평소보다 시간이 더 걸릴 거예요. 그리고 이 일을 오래 해 와서 아는데, 이미 성관계를 해 본 적이 있으니 비용이 더 올라가겠네요.");
 ds_map_add(m,"WHAT THEE!","뭐라고요?!");
 ds_map_add(m,"Perfect, it is only 3000 Arcs","좋아요. 비용은 아크 3,000개뿐이에요.");
 ds_map_add(m,"Ehhh hehe maybe it wouldn't be bad if I had a cleanup, it would be my first time.","으음, 헤헤. 세척을 받아도 나쁘지 않을 것 같아요. 처음이거든요.");
 ds_map_add(m,"It can be done without it but it is not recommended.","세척 없이도 할 수는 있지만 권장하지 않아요.");
 ds_map_add(m,"Mmmm so if someone does it for that place is it necessary what you offer me?","음, 그러니까 그 부위를 누군가가 해 준다면 당신이 제공하는 서비스가 꼭 필요한 건가요?");
 ds_map_add(m,"Sorry I thought it was one of those low life women. usually they come to clean up to keep working properly.","죄송해요. 보통은 제대로 일할 수 있도록 세척을 받으러 오는 밑바닥 여자들 중 한 명인 줄 알았어요.");
 ds_map_add(m,"Oh m-me? no I just got a little lost hehe.","아, 저, 저요? 아니에요. 그냥 조금 길을 잃었어요. 헤헤.");
 ds_map_add(m,"Welcome, are you coming for an anal cleansing?","어서 오세요. 항문 세척을 받으러 오셨나요?");
 ds_map_add(m,"You still don't have the money? don't worry, I can wait until you get it.","아직 돈이 부족하세요? 걱정 마세요. 돈을 마련할 때까지 기다려 드릴게요.");
 ds_map_add(m,"Because of the amount I will use, you may resist, it will help me make the process go faster and also it may make the slime pop a little so you won't stain your clothes.","사용할 양이 많아서 몸이 저항감을 느낄 수도 있어요. 그러면 과정이 빨라지고, 슬라임이 조금 튀어나와 옷을 더럽히지 않을 수도 있거든요.");
 ds_map_add(m,"What, why?","뭐라고요? 왜요?");
 ds_map_add(m,"All right, please take off your clothes, turn around and I'll have to tie you up with this.","좋아요. 옷을 벗고 뒤돌아 주세요. 이걸로 묶어야겠어요.");
 ds_map_add(m,"All right, I'll be waiting here if you change your mind.","좋아요. 마음이 바뀌면 여기서 기다리고 있을게요.");
 ds_map_add(m,"No thanks, right now I need the Arcs.","아니요, 괜찮아요. 지금은 아크가 필요해요.");
 ds_map_add(m,"Yes please (pay for the service).","네, 부탁해요. (서비스 비용을 지불한다.)");
 ds_map_add(m,"Do you want to pay for anal cleaning services?","항문 세척 서비스를 결제하시겠습니까?");
 ds_map_add(m,"When I clean everything here, you can have another cleaning.","여기 있는 걸 전부 청소하면, 한 번 더 세척받을 수 있어요.");
 ds_map_add(m,"Slime","슬라임");
 ds_map_add(m,"Wha-what!","뭐, 뭐라고!");
 ds_map_add(m,"I can't do much about your weird new look, but I think I might be able to beat some sense back into your head-- *cracks knuckles*","네 이상한 새 모습은 어쩔 수 없지만, 네 머릿속에 정신이 돌아오도록 한 대 때려 줄 수는 있을 것 같아. *주먹 관절을 꺾는다*");
 ds_map_add(m,"Hold on, squirt: YOU'RE trying to help ME? It looks like time travel can screw up your body AND your brain!","잠깐, 꼬맹아. 네가 날 도우려고 한다고? 시간 여행은 몸뿐 아니라 머리까지 망가뜨리는 모양이군!");
 ds_map_add(m,"Oh Lily, she looks really disoriented.","아, 릴리. 저 여자 정말 정신을 못 차리는 것 같아.");
 ds_map_add(m,"Ta-Talia ?! What happened to you? The King never told us that time travel could change our appearances!","타, 탈리아?! 대체 어떻게 된 거야? 왕은 시간 여행이 외모까지 바꿀 수 있다고 말한 적이 없는데!");
 ds_map_add(m,"Eh.. a-are you ok?(Wow is very pretty)","어…… 괘, 괜찮아? (와, 정말 예쁘다.)");
 ds_map_add(m,"RGHhhh... ugh, my head's killing me! I don't remember the King saying time travel would hurt...","으으…… 아, 머리가 깨질 것 같아! 시간 여행이 아프다고 왕이 말했던 기억은 없는데……");
 ds_map_add(m,"What that fuck!","이게 대체 무슨 지랄이야!");
 ds_map_add(m,"Faye super Soldier of the king","왕의 초강력 병사 페이");
 ds_map_add(m,"Let's get on with it already then!","그럼 이제 빨리 시작하자!");
 ds_map_add(m,"No, we will have to find one.","아니, 우리가 직접 찾아야 해.");
 ds_map_add(m,"Sure, sure. Enough chatting, though. Do you know a magician who can manipulate the rift?","그래, 그래. 잡담은 그만하고, 균열을 다룰 수 있는 마법사를 알아?");
 ds_map_add(m,"What are you a hero or something?","너 영웅이라도 되는 거야?");
 ds_map_add(m,"Look, time is of the essence. Every minute I spend here, is a minute less I have left to take over-- save my Kingdom.","들어 봐, 시간이 없어. 여기서 1분을 더 보내면 내 왕국을 차지하러-- 구하러 갈 시간이 그만큼 줄어드는 거야.");
 ds_map_add(m,"Yeas yes yes whatever Lili , what do you need beautiful redhead <3?","그래그래, 알았어, 릴리. 그래서 아름다운 빨간 머리 아가씨, 뭐가 필요해? <3");
 ds_map_add(m,"Hey line, are you really gonna help this brat?","이봐, 라인. 정말 이 꼬맹이를 도와줄 거야?");
 ds_map_add(m,"Alright, get to it then already!","좋아, 그럼 어서 시작해!");
 ds_map_add(m,"Yes, leave it to me and Lili.","그래, 나와 릴리에게 맡겨.");
 ds_map_add(m,"( What the fuck is she talking about? We beat you like 10 seconds ago )","(이 여자가 대체 무슨 소릴 하는 거야? 방금 10초 전에 우리가 널 박살 냈잖아.)");
 ds_map_add(m,"Are you really going to help a stranger who kicked your ass?","네 엉덩이를 걷어찬 낯선 사람을 정말 도와주겠다고?");
 ds_map_add(m,"Mmm I have, helped others to return to their dimension and I-If you want you can call me Talia since it is the name that you murmur so much.","음, 다른 사람들이 자기 차원으로 돌아가도록 도와준 적은 있어. 그, 원한다면 탈리아라고 불러도 돼. 네가 그 이름을 하도 중얼거리잖아.");
 ds_map_add(m,"* Faye begins to sob *","*페이가 흐느끼기 시작한다*");
 ds_map_add(m,"What's the true.","진실이 뭐야?");
 ds_map_add(m,"The saddest thing that you didn't even make it to the year 3000 of this dimension.","가장 안타까운 건 네가 이 차원의 서기 3000년까지도 도달하지 못했다는 거야.");
 ds_map_add(m,"Rgh... if Talia made it through, then there's no way I'm going to catch up to her. I can't let that happen, she can't beat me--","으윽... 탈리아가 성공했다면 난 절대 따라잡을 수 없어. 그렇게 둘 순 없어. 날 이길 수는 없다고--");
 ds_map_add(m,"When you arrived, that crystal was created, it usually happens when someone reaches this dimension by mistake.","네가 도착했을 때 그 수정이 생겨났어. 누군가 실수로 이 차원에 도착하면 보통 그런 일이 일어나.");
 ds_map_add(m,"Are you SURE this isn't the year 3000 AD?","여기가 정말 서기 3000년이 아니라고?");
 ds_map_add(m,"No, sorry actually it's 201 AO.","아니, 미안. 사실은 AO 201년이야.");
 ds_map_add(m,"This DIMENSION? You're telling me I traveled through space, not time? Shit...","이 차원이라고? 내가 시간 여행이 아니라 공간을 이동했다는 거야? 젠장...");
 ds_map_add(m,"Calm down Lili, she was disoriented from traveling to this dimension.","진정해, 릴리. 이 차원으로 이동하느라 정신이 없었던 거야.");
 ds_map_add(m,"Dumbass, we've been telling you that from the beginning!","멍청아, 처음부터 계속 말해 줬잖아!");
 ds_map_add(m,"Wait a minute... you're not Talia.","잠깐... 넌 탈리아가 아니잖아.");
 ds_map_add(m,"Yes, thank you very much Line, I will continue training for my show, you know where to find me if you need something else.","그래, 정말 고마워, 라인. 난 공연 연습을 계속할게. 다른 도움이 필요하면 어디서 날 찾을지 알지?");
 ds_map_add(m,"Finally, Faye We did it, you see Naoki you had the power to do it.","드디어 해냈어, 페이! 나오키, 봤지? 네게 해낼 힘이 있었잖아.");
 ds_map_add(m,"Done The dimensional rift is already Ready To get to the year 3000 AD.","끝났어. 차원 균열이 서기 3000년으로 갈 준비를 마쳤어.");
 ds_map_add(m,"Ohh Faye you are a sweetheart <3.","오, 페이. 넌 정말 다정하구나 <3.");
 ds_map_add(m,"This is all very different from my time but, I am glad you are here to help me Thanks Talia.","내 시대와는 모든 게 많이 다르지만, 네가 도와주러 와 줘서 기뻐. 고마워, 탈리아.");
 ds_map_add(m,"Ohmmm...","오옴...");
 ds_map_add(m,"I am sorry to show you this facet Faye, but there was no other option to help you.","이런 모습을 보여 줘서 미안해, 페이. 하지만 널 도울 다른 방법이 없었어.");
 ds_map_add(m,"Oh right, you didn't know Line is half succubus is what she does best, although she acts like a saint.","아, 맞다. 넌 몰랐지? 라인은 반쪽 서큐버스야. 성녀처럼 굴지만, 이게 바로 그 애가 제일 잘하는 일이거든.");
 ds_map_add(m,"Wow, the King told us the year 3000 is full of perverts, but is EVERYWHERE full of them besides 1000 AD?","와, 왕은 서기 3000년에는 변태가 넘쳐난다고 했는데, 서기 1000년 말고는 어디든 다 그런 거야?");
 ds_map_add(m,"* Naoki finally calms down when he ejaculates and begins to modify the rift correctly *","*나오키는 사정하고 나서야 진정하고 균열을 제대로 조정하기 시작한다*");
 ds_map_add(m,"Don't worry, this will calm you down * Line grabs naoki from behind and masturbates him until he ejaculates * ","걱정 마, 진정시켜 줄게. *라인이 뒤에서 나오키를 끌어안고 사정할 때까지 자위시켜 준다*");
 ds_map_add(m,"Oh well I-I don't know *Line strips naked and walks over to naoki and starts taking off his clothes*","아, 그게... 나, 나도 모르겠어. *라인이 옷을 벗고 나오키에게 다가가 그의 옷을 벗기기 시작한다*");
 ds_map_add(m,"Calm Naoki you want me to help you with your nerves, as before.","진정해, 나오키. 전처럼 내가 긴장을 풀어 줄까?");
 ds_map_add(m,"Is she alright? No magicians I've ever known had to chant stuff to cast magic.","저 사람 괜찮은 거야? 내가 아는 마법사들은 마법을 쓰려고 주문을 외우는 법이 없었는데.");
 ds_map_add(m,"I-I will Try*Naoki start to shake because of nerves*.","나, 노력해 볼게. *나오키가 긴장해서 떨기 시작한다*");
 ds_map_add(m,"Hmm... would these earrings of mine work? They're from where I come from, 1000 AD. Maybe you can use that as a marker in time and then jump forward 2000 years?","음... 내 귀걸이를 써 보면 어떨까? 서기 1000년, 내가 살던 시대에서 가져온 거야. 이걸 시간의 기준점으로 삼아서 2000년 뒤로 이동하면 되지 않을까?");
 ds_map_add(m,"What?! But I have never done this, at least you have an object of that dimension that would help me to have a time reference?","뭐라고?! 하지만 난 이런 걸 해 본 적이 없어. 적어도 네가 가진 그 차원의 물건이 시간 기준을 잡는 데 도움이 되지 않을까?");
 ds_map_add(m,"We need the dimensional rift to open in the year 3000 AD of that dimension.","그 차원의 서기 3000년에 차원 균열을 열어야 해.");
 ds_map_add(m,"B-but you haven't told me what to do.","하, 하지만 뭘 해야 하는지 말해 주지 않았잖아.");
 ds_map_add(m,"Alright, so let's see some magic!","좋아, 그럼 마법을 보여 줘!");
 ds_map_add(m,"Is Talia that desperate to keep me from beating her? Sending weird robots to attack me? Sheesh.","탈리아가 내가 이기지 못하게 하려고 그렇게까지 하는 거야? 이상한 로봇까지 보내서 날 공격하게 하다니. 참나.");
 ds_map_add(m,"Look like the kettle thing doesn't want you to go to your dimension Faye.","저 주전자 같은 녀석은 페이가 자기 차원으로 돌아가는 걸 원하지 않는 것 같아.");
 ds_map_add(m,"W-800 Series Gratters like myself have been employed to seal the dimensional holes created by violators, on behalf of the World Organization for Reformation of the Masses.","나와 같은 W-800 시리즈 그래터는 세계 대중 개조 기구를 대신해, 위반자들이 만든 차원 구멍을 봉쇄하도록 고용되었습니다.");
 ds_map_add(m,"One of you violated the dimensional agreement; this is a parallel timeline had agreed to distance itself from our own. I am The Timekeper W.O.R.M System model 101","너희 중 한 명이 차원 협정을 위반했다. 이곳은 우리 시간선과 거리를 두기로 합의한 평행 시간선이다. 나는 시간지기 W.O.R.M 시스템 모델 101이다.");
 ds_map_add(m,"What the hell?!","대체 뭐야?!");
 ds_map_add(m,"I seems so. Hopefully I don't end up somewhere even weirder this time, no offense.","그런가 보네. 이번에는 더 이상한 곳에 떨어지지 않았으면 좋겠어. 기분 나쁘게 들으라는 건 아니고.");
 ds_map_add(m,"Well it seems this is the goodbye.","이제 작별할 때가 된 것 같네.");
 ds_map_add(m,"AAAHHHHHHH Whatever, fine, it's not like anything else is working. Weird ass dimensional weirdos... * Faye takes her clothes off *","아아아아! 됐어, 마음대로 해. 어차피 다른 방법도 안 통하잖아. 이 괴상한 차원 괴짜들 같으니... *페이가 옷을 벗는다*");
 ds_map_add(m,"Please Faye Believe in me is the only way. (this is my only chance to have sex with her!)","제발, 페이. 날 믿어 줘. 이 방법밖에 없어. (이게 그녀와 섹스할 유일한 기회야!)");
 ds_map_add(m,"You really ARE all perverts. Get sex off your mind, and let's blow this thing up!","너희는 정말 하나같이 변태구나. 머릿속에서 섹스 생각 좀 치우고 이거나 날려 버리자!");
 ds_map_add(m,"Faye We have to let ourselves lose!","페이, 우리 일부러 져 줘야 해!");
 ds_map_add(m,"* Line begins to recognize a smell coming from the robot. *MHmm ... those tanks ... those tentacles, oh I know what to do!","*라인이 로봇에게서 나는 냄새를 알아차리기 시작한다.* 음... 저 탱크들... 저 촉수들... 아, 뭘 해야 할지 알겠어!");
 ds_map_add(m,"What are you thinking so much?","뭘 그렇게 오래 생각해?");
 ds_map_add(m,"Mhmmm...","음흠...");
 ds_map_add(m,"It would be a good idea, if we had done some damage!","우리가 피해라도 줄 수 있었다면 좋은 생각이었겠지!");
 ds_map_add(m,"How is this thing shrugging off everything we're throwing at it?  Change of strategy; Line, destroy those cylinders on it; maybe that's where its energy comes from.","우리가 퍼붓는 공격을 어떻게 전부 버텨 내는 거지? 작전을 바꾸자. 라인, 저 녀석 몸에 붙은 원통들을 부숴. 에너지가 거기서 나오는 걸지도 몰라.");
 ds_map_add(m,"Very proud of you Line.","정말 자랑스러워, 라인.");
 ds_map_add(m,"Shhhh Lili.","쉿, 릴리.");
 ds_map_add(m,"Hey Line, if they only needed your milk to beat the robot, why did you make her get naked too?","이봐, 라인. 로봇을 쓰러뜨리는 데 네 젖만 필요했다면, 왜 페이까지 옷을 벗게 한 거야?");
 ds_map_add(m,"Bye...","잘 가...");
 ds_map_add(m,"Goodbye Line, it's time to go.","잘 가, 라인. 이제 떠날 시간이야.");
 ds_map_add(m,"Hehe yeah, that's my name <3 and Kick that Talia's ass, Faye I will wait for your return.","헤헤, 그래. 그게 내 이름이야 <3. 탈리아 엉덩이를 걷어차 줘, 페이. 네가 돌아오길 기다릴게.");
 ds_map_add(m,"Yeah, once I've got this future weapon I'm looking for, I want to see you again and thank you properly Ta-sorry your name is Line isn't it?","그래. 찾고 있는 미래의 무기를 손에 넣으면 다시 만나서 제대로 고맙다고 인사하고 싶어. 타... 미안, 네 이름이 라인이었지?");
 ds_map_add(m,"It sounds like you're leaving.","떠나는 것처럼 들리네.");
 ds_map_add(m,"We finally had a stroke of luck now it's all over.","이제야 운이 좀 따르나 했더니, 모든 게 끝나 버렸네.");
 ds_map_add(m,"We were lucky that instead of stopping it, it exploded.","녀석을 막는 대신 폭발해 버려서 오히려 다행이었지.");
 ds_map_add(m,"Well I deduced that the robot used milk as energy just like a succubus if we allowed ourselves to be milked my milk would consume the energy of the robot's stored milk.","로봇이 서큐버스처럼 젖을 에너지로 쓴다는 걸 알아냈어. 우리가 젖을 짜이게 두면 내 젖이 로봇 안에 저장된 젖의 에너지를 흡수할 거라고 생각했지.");
 ds_map_add(m,"That didn't explain anything.","그건 아무 설명도 안 됐잖아.");
 ds_map_add(m,"Hehe I-I guess <3.","헤헤, 그, 그런가 봐 <3.");
 ds_map_add(m,"Wow, Line you have a brain.","와, 라인. 너한테도 뇌가 있긴 하네.");
 ds_map_add(m,"Well, my succubus powers helped me to know that inside those cylinders there was woman's milk and the tentacles had a substance that stimulates milk production like succubus saliva.","내 서큐버스 능력 덕분에 원통 안에 여성의 젖이 들어 있고, 촉수에는 서큐버스의 침처럼 젖 분비를 촉진하는 물질이 있다는 걸 알아냈어.");
 ds_map_add(m,"Ahnn... mmmmnn... t-that was intense. Line, how did you know that'd destroy him?","아흐... 음... 저, 정말 격렬했어. 라인, 그게 로봇을 파괴할 줄 어떻게 알았어?");
 ds_map_add(m,"I don't know how to tell Eleanor about this but I'd better finish our research and then I'll explain everything to her.","이 일을 엘레노어에게 어떻게 설명해야 할지 모르겠지만, 우선 연구를 마무리하고 나서 전부 이야기하는 게 좋겠어.");
 ds_map_add(m,"A body in a vegetable state... or did they mean that it had no soul? it could do so, but even a body without a soul would still have consciousness.","식물인간 상태의 몸... 아니면 영혼이 없다는 뜻이었을까? 그럴 수도 있겠지만, 영혼이 없는 몸에도 의식은 남아 있을 텐데.");
 ds_map_add(m,"they asked me for a body .... without a conscience but alive... I don't really know what they meant.","그들은 몸을 하나 구해 달라고 했어... 의식은 없지만 살아 있는 몸을... 무슨 뜻인지 정말 모르겠어.");
 ds_map_add(m,"They appeared.","그들이 나타났다.");
 ds_map_add(m,"* The book is dirty and only a few pages are readable *","*책이 더러워서 몇 페이지만 읽을 수 있다*");
 ds_map_add(m,"Clearly not a success but they work for now. If I catch the target I can use them to verify the individual.","분명 성공작은 아니지만, 지금은 쓸 만하다. 표적을 붙잡으면 이걸로 그 개체의 신원을 확인할 수 있다.");
 ds_map_add(m,"Although these beings are able to accomplish their sole objective, they lack the ability to reason, making them unable to move from the place where they are prostrate.","이 존재들은 유일한 목표를 수행할 수는 있지만 추론 능력이 없다. 그래서 엎드려 있는 자리에서 움직일 수 없다.");
 ds_map_add(m,"Have only one objective, to catch and verify that the host is compatible with Eleonor.","목표는 단 하나, 숙주를 붙잡아 엘레노어와 호환되는지 확인하는 것이다.");
 ds_map_add(m,"I was able to create the first primitive, circular body by surface tension.","표면 장력을 이용해 최초의 원시적인 원형 몸체를 만들어 낼 수 있었다.");
 ds_map_add(m,"Kamiko the wyvern","와이번 카미코");
 ds_map_add(m,"Well, thanks to you, the town is much safer, besides that you solved the alcohol problem, I guess that's fine.","네 덕분에 마을이 훨씬 안전해졌어. 술 문제까지 해결했으니, 뭐, 괜찮은 셈이지.");
 ds_map_add(m,"I will also bring her to be milked.","그녀도 데려와서 젖을 짜게 하겠다.");
 ds_map_add(m,"Can I take this criminal with me? It would be a great help.","이 범죄자를 데려가도 될까요? 큰 도움이 될 것 같습니다.");
 ds_map_add(m,"Oh never mind, I have a better idea.","아, 됐어요. 더 좋은 생각이 났어요.");
 ds_map_add(m,"*Kamiko let's out an embarrassing moan as her tits are being milked dry. She stands defeated*","*젖이 완전히 짜이는 동안 카미코는 부끄러운 신음을 내고, 패배한 모습으로 서 있다*");
 ds_map_add(m,"Please shut up, we are talking here.","제발 조용히 해 주세요. 지금 이야기 중이잖아요.");
 ds_map_add(m,"MOOO! - MOOO! Nghgh - MOOOooo~ ","음머어! - 음머어! 으응 - 음머어어~ ");
 ds_map_add(m,"Traveler I'm sorry to tell you that right now I don't have all the reward.","여행자님, 죄송하지만 지금은 보상금을 전부 마련하지 못했습니다.");
 ds_map_add(m,"MOOO! - MOOOooo~ ngh...","음머어! - 음머어어~ 으응...");
 ds_map_add(m,"Uuughh.. m-moo... mo-Nghh!~ Mooo-mooo","으으... 머, 음머... 으응!~ 음머, 음머.");
 ds_map_add(m,"H-hngh!!... Dammit-ahh~ How did it come to this?!","흐, 흐응!!... 젠장, 아아~ 어쩌다 이렇게 된 거야?!");
 ds_map_add(m,"Hey here you don't talk you damn cow!","이봐, 여기선 네가 말할 차례가 아니야, 이 빌어먹을 암소야!");
 ds_map_add(m,"You'll pay for this!!","이 일은 반드시 대가를 치르게 될 거야!!");
 ds_map_add(m,"Are you listening?!.","듣고 있어?!");
 ds_map_add(m,"Hey! What the fuck are you doing?!","이봐! 대체 무슨 짓을 하는 거야?!");
 ds_map_add(m,"(I don't think they dared to turn it on)","(기계를 켤 엄두는 못 냈을 거야.)");
 ds_map_add(m,"I think our little friend has not made her daily milk quota.","우리 작은 친구가 하루 할당량을 아직 채우지 못한 모양이군.");
 ds_map_add(m,"Go turn on the machine.","가서 기계를 켜.");
 ds_map_add(m,"Ehh .. and how?","어... 어떻게?");
 ds_map_add(m,"It seems that we will have to make her speak.","아무래도 입을 열게 만들어야겠군.");
 ds_map_add(m,"(Big thing i just won't say anything)","(뭐 어때, 그냥 아무 말도 안 하면 되지.)");
 ds_map_add(m,"Oh yes, listen Lili if they say something else I think they increase the time in jail.","아, 맞다. 릴리, 잘 들어. 다른 말을 하면 감옥에 더 오래 있어야 할지도 몰라.");
 ds_map_add(m,"Line, I understand that cows can only say moo.","라인, 내가 알기로 암소는 '음머'밖에 못 해.");
 ds_map_add(m,"Ah go fuck yourself.","아, 엿이나 먹어.");
 ds_map_add(m,"hehe clearly it is Lili.","헤헤, 역시 릴리였네.");
 ds_map_add(m,"Uyy look Line is not a cute cow <3?","어머, 라인. 귀여운 암소 맞지? <3");
 ds_map_add(m,"What do you want?!","뭘 원해?!");
 ds_map_add(m,"Ohh of course we will go to see her haha.","오, 물론이지. 보러 갈게. 하하.");
 ds_map_add(m,"If you want, you can go see the criminal while I count the money.","원한다면 내가 돈을 세는 동안 범죄자를 보러 가도 돼.");
 ds_map_add(m,"Sure just give me a second.","좋아, 잠깐만.");
 ds_map_add(m,"Lili, manners.","릴리, 예의 좀 지켜.");
 ds_map_add(m,"Where is the reward?","보상은 어디 있지?");
 ds_map_add(m,"*whispering * Line turn on the machine and let's get the hell out of here.","*속삭이며* 라인, 기계를 켜고 여기서 당장 꺼지자.");
 ds_map_add(m,"What...?","뭐...?");
 ds_map_add(m,"In a way I'm here because I want hu-hu-hu.","어쩌면 난 여기에 있고 싶어서 온 걸지도 몰라. 흐, 흐, 흐.");
 ds_map_add(m,"Oh darling there is no guard here who dares to raise his voice to me.","오, 자기야. 여기엔 감히 내게 목소리를 높일 경비병이 없어.");
 ds_map_add(m,"Hey I have a question, why are you talking shouldn't you say moo?","이봐, 궁금한 게 있는데. 왜 말을 해? 음머라고 해야 하는 거 아니야?");
 ds_map_add(m,"Now you can turn on that machine I have a lot of milk in these udders.","이제 기계를 켜도 돼. 이 젖통에 젖이 가득하거든.");
 ds_map_add(m,"Oh thanks.","아, 고마워.");
 ds_map_add(m,"I will not tell a soul.","아무에게도 말하지 않을게.");
 ds_map_add(m,"Oh no-no need, uhh.. could you do not tell anyone what I did to beat you hehe.. ple-please.","아, 아뇨, 괜찮아요. 어... 제가 당신을 이긴 방법은 아무에게도 말하지 말아 주세요. 헤헤... 부, 부탁이에요.");
 ds_map_add(m,"But you came and you made me feel so, so good hu-hu.","하지만 네가 와서 날 그렇게, 그렇게 기분 좋게 해 줬잖아. 흐, 흐.");
 ds_map_add(m,"I like the place, maybe I killed and drank so much because I was frustrated.","이곳이 마음에 들어. 어쩌면 예전엔 좌절감 때문에 그렇게 많은 사람을 죽이고 술을 마셨는지도 몰라.");
 ds_map_add(m,"Calm down, I have no grudge towards my little half succubus.","진정해. 내 작은 반쪽 서큐버스에게 원한은 없어.");
 ds_map_add(m,"Uh.. hello, do you... enjoy the place? I mean ... hello :c.","어... 안녕. 여기... 마음에 들어? 그러니까... 안녕 :c.");
 ds_map_add(m,"It seems that we meet again.","또 만나게 됐군.");
 ds_map_add(m,"Turn on the machine Line see if she shut up.","라인, 기계를 켜 봐. 저 여자가 입을 다무는지 보자.");
 ds_map_add(m,"Tristan is not a puppet!.","트리스탄은 꼭두각시가 아니야!");
 ds_map_add(m,"Looking at the bright side they let you keep the puppet.","좋은 쪽으로 생각해. 적어도 인형은 가져가게 해 줬잖아.");
 ds_map_add(m,"And that fairy i guess.","요정도 말이지, 아마.");
 ds_map_add(m,"When I come out I will take revenge on you and Sam!.","나가면 너와 샘에게 복수할 거야!");
 ds_map_add(m,"Oh it's you, you really think i'll stay here forever.","오, 너구나. 내가 여기 영원히 갇혀 있을 거라고 생각해?");
 ds_map_add(m,"Is this a reference?.","이거 무슨 패러디야?");
 ds_map_add(m,"Beep bo bop.","삐빅, 뽀밥.");
 ds_map_add(m,"Plz do-do not do it (uff yeah, God yes, I want to scream and moan while everyone looks at me)","제발, 그, 그러지 마. (으흐, 그래, 세상에, 맞아. 모두가 날 보는 앞에서 소리 지르고 신음하고 싶어.)");
 ds_map_add(m,"Not even if they tickle you while they suck your milk.","젖을 짜면서 간지럽혀도 말 안 할 거야?");
 ds_map_add(m,"Mm-m moo (what's planned?)","음, 음머 (무슨 계획이야?)");
 ds_map_add(m,"hey cows just say moo!","이봐, 암소는 '음머'라고만 하라고!");
 ds_map_add(m,"Lili .. n-do-do not do anything weird please.","릴리... 이, 이상한 짓은 하지 말아 줘. 제발.");
 ds_map_add(m,"I'll turn on the machine.","내가 기계를 켤게.");
 ds_map_add(m,"Mmm.. yeah. I already have it on.","음... 그래. 이미 켜 놨어.");
 ds_map_add(m,"Did you put on your cow clothes?","암소 옷은 입었어?");
 ds_map_add(m,"Go to the upper left corner, there will be a machine waiting for you to suck your milk.","왼쪽 위 구석으로 가. 네 젖을 빨아들일 기계가 기다리고 있을 거야.");
 ds_map_add(m,"Take this, you will have to eat this fruit has a special effect that makes you produce more milk than if you were pregnant.","이걸 받아. 이 과일을 먹어야 해. 특별한 효과가 있어서 임신했을 때보다도 젖이 더 많이 나오게 해 줘.");
 ds_map_add(m,"(Wow, just say you want to get milked to the brain)","(와, 그냥 뇌까지 젖을 짜이고 싶다고 말하지 그래.)");
 ds_map_add(m,"... The truth is that I think I deserve the punishment, she gave me a lot of money, I feel guilty that people suffered for it.","... 사실 난 벌을 받아 마땅하다고 생각해. 그녀가 내게 돈을 많이 줬고, 그 때문에 사람들이 고통받았으니까 죄책감이 들어.");
 ds_map_add(m,"So the only option you have is to be milked to pay your sentence and I'll set you free.","그러니 네가 선택할 수 있는 유일한 방법은 젖을 짜이며 형기를 채우는 거야. 그러면 풀어 줄게.");
 ds_map_add(m,"Look, I can't let her go without serving some kind of sentence.","들어 봐. 아무런 형벌도 받지 않고 그녀를 풀어 줄 수는 없어.");
 ds_map_add(m,"Hey hey low the voice that others will think of me, Ehemm! well back to the topic, until now she has been a remarkable citizen.","이봐, 목소리 좀 낮춰. 다른 사람들이 나를 어떻게 생각하겠어. 크흠! 아무튼 본론으로 돌아가자. 지금까지 그녀는 훌륭한 시민이었어.");
 ds_map_add(m,"Plus she rimmed the white demon to capture her while you stared and did nothing!","게다가 네가 멀뚱히 구경만 하는 동안, 그 흰 악마를 붙잡으려고 그 악마의 항문까지 핥았잖아!");
 ds_map_add(m,"Hey come on, give us a warning, we have done more than any citizen of Elira.","이봐, 한 번만 경고하고 넘어가면 안 돼? 우린 엘리라의 어떤 시민보다도 많은 일을 했다고.");
 ds_map_add(m,"That rat said everything to have less sentence time, Line was the only one who made a deal with her.","그 쥐새끼는 형량을 줄이려고 모든 걸 불었어. 그녀와 거래한 건 라인뿐이야.");
 ds_map_add(m,"Wait and how do you know that they made a loan to Line.","잠깐, 그들이 라인에게 돈을 빌려줬다는 건 어떻게 안 거야?");
 ds_map_add(m,"She is a thief and to launder the money she makes illegal loans, by law the borrower also has a penalty.","그녀는 도둑이고, 돈세탁을 하려고 불법 대출을 해. 법적으로 돈을 빌린 사람도 처벌받아.");
 ds_map_add(m,"You see that woman with purple hair.","보라색 머리를 한 여자 보이지?");
 ds_map_add(m,"WHAT!?","뭐라고?!");
 ds_map_add(m,"Line... sorry to tell you that you are under arrest.","라인... 유감이지만 널 체포해야겠어.");
 ds_map_add(m,"Ay Lili, don't be paranoid, we are heroes, maybe she called us to catch another criminal.","아, 릴리. 너무 의심하지 마. 우린 영웅이잖아. 어쩌면 다른 범죄자를 잡으라고 부른 걸 수도 있어.");
 ds_map_add(m,"It seems serious, we better escape.","심각한 일인 것 같아. 도망치는 게 좋겠어.");
 ds_map_add(m,"Could you come for a moment.","잠깐 이리 와 주시겠어요?");
 ds_map_add(m,"Line!","라인!");
 ds_map_add(m,"shut up.","닥쳐.");
 ds_map_add(m,"Hey now you have your mother's long tongue when you are completely aroused.","완전히 흥분하면 네 엄마처럼 혀가 길어지는구나.");
 ds_map_add(m,"Ok line that's all we need you can go","좋아, 라인. 필요한 건 다 끝났으니 가도 돼.");
 ds_map_add(m,"Moo moo ranch","무무 목장");
 ds_map_add(m,"Welcome to the Moo moo ranch prison and producer of the best breast milk of all dimensions. we also hire women and sell the best aphrodisiac fruits to fulfill any sexual desire <3.","무무 목장 감옥에 오신 것을 환영합니다. 이곳은 모든 차원에서 최고로 맛있는 모유를 생산합니다. 여성 직원을 모집하고 있으며, 모든 성적 욕망을 채워 줄 최고의 최음 과일도 판매합니다 <3.");
 ds_map_add(m,"What!?.","뭐라고?!");
 ds_map_add(m,"Nyann!.","냐앙!");
 ds_map_add(m,"We already beat you, surrender like a good kitten.","우린 이미 널 이겼어. 착한 고양이처럼 항복해.");
 ds_map_add(m,"Stop thinking with your horn we have to go back.","뿔로 생각하는 건 그만하고 돌아가야 해.");
 ds_map_add(m,"She did not stay with me :c hopefully I can see her again hehe.","그녀는 나와 함께 남지 않았어 :c. 헤헤, 언젠가 다시 볼 수 있으면 좋겠다.");
 ds_map_add(m,"She escaped I stayed here taking care of you.","그녀는 도망쳤고, 난 여기에 남아서 널 돌봤어.");
 ds_map_add(m,"Where did the lady cat go?","그 고양이 아가씨는 어디로 갔어?");
 ds_map_add(m,"Shit Line you pass out.","젠장, 라인. 네가 기절했어.");
 ds_map_add(m,"In the meantime you can enjoy the activities the island has to offer.","그동안 섬에서 즐길 수 있는 여러 활동을 체험하셔도 됩니다.");
 ds_map_add(m,"Oh, I didn't know :c.","아, 몰랐어 :c.");
 ds_map_add(m,"Sorry miss, right now the great captain is busy looking for a con artist posing as one of us.","죄송합니다, 아가씨. 지금 위대한 대장님은 우리 중 한 명인 척하며 사기를 치는 범인을 찾느라 바쁘십니다.");
 ds_map_add(m,"Great let's go right away someone could be in danger.","좋아요. 당장 가요. 누군가 위험에 처했을지도 몰라요.");
 ds_map_add(m,"I do Sam :D, it is east of town, passing the bridge of lovers.","알아, 샘 :D. 마을 동쪽에 있어. 연인의 다리를 건너면 돼.");
 ds_map_add(m,"Ok going back to the topic, I was informed that the criminal would be in the magenta swamp, do you know where it is?","자, 다시 본론으로 돌아가자. 범죄자가 자홍색 늪지에 있다고 들었는데, 어디인지 알아?");
 ds_map_add(m,"Maybe you could hahaha.","어쩌면 네가 할 수도 있겠네. 하하하.");
 ds_map_add(m,"Really? because I want to live in your armpits o.O.","정말? 네 겨드랑이 안에서 살고 싶거든 o.O.");
 ds_map_add(m,"Don't worry Lili, it happens to me often and in fact it flatters me.","걱정 마, 릴리. 나도 자주 겪는 일이야. 사실 꽤 기분 좋기도 해.");
 ds_map_add(m,"Jeez Line self control.","세상에, 라인. 자제 좀 해.");
 ds_map_add(m,"*Line can't stop leering at Sam muscular and sweaty body*","*라인은 샘의 근육질에 땀에 젖은 몸을 음흉하게 쳐다보느라 정신이 없다*");
 ds_map_add(m,"Oh by the way I think something happened to your friend.","아, 그러고 보니 네 친구에게 무슨 일이 생긴 것 같아.");
 ds_map_add(m,"Yeah Sam we can handle it all <3 .","맞아, 샘. 우리에게 맡겨 <3.");
 ds_map_add(m,"Wow, you weren't lying, you two are really strong.","와, 거짓말이 아니었네. 너희 둘 정말 강하구나.");
 ds_map_add(m,"Please help me, don't let her take the crystal.","제발 도와줘. 그녀가 수정을 가져가지 못하게 해 줘.");
 ds_map_add(m,"Hey leave her alone!","이봐, 그녀를 놔줘!");
 ds_map_add(m,"Help the dragon maybe she gives us a reward.","저 용을 도와주자. 보상을 줄지도 몰라.");
 ds_map_add(m,"Lili what do we do?","릴리, 어떻게 하지?");
 ds_map_add(m,"For now we block the exit until the guards arrive.","우선 경비병들이 올 때까지 출구를 막자.");
 ds_map_add(m,"We are prisoners if we get into someone else's fight they will increase our sentence.","우린 죄수야. 남의 싸움에 끼어들면 형량이 늘어날 거야.");
 ds_map_add(m,"And why don't you help her?!","그럼 넌 왜 도와주지 않는 건데?!");
 ds_map_add(m,"That dragon woman fell from the sky and the lamia seems to have stole something from her.","저 용 여자는 하늘에서 떨어졌고, 라미아가 뭔가를 훔친 것 같아.");
 ds_map_add(m,"Hey! what's happening here?","이봐! 여기서 무슨 일이 벌어지고 있지?");
 ds_map_add(m,"Vasuki The Silver Dragon of Luminous","루미너스의 은룡, 바수키");
 ds_map_add(m,"Thank you very much you are very kind <3.","정말 고마워. 넌 정말 친절하구나 <3.");
 ds_map_add(m,"We know where it is, we will help you to return home.","어디 있는지 알아. 집으로 돌아갈 수 있게 도와줄게.");
 ds_map_add(m,"This one came with me, the other one from what I could see ended up in a place with many bright blue rocks.","이 수정 하나는 나와 함께 왔고, 다른 하나는 내가 보기엔 밝은 파란색 바위가 많은 곳에 떨어졌어.");
 ds_map_add(m,"Oh don't worry, the truth is I would like to go back but this crystal is only half the fracture.","아, 걱정하지 마. 사실 나도 돌아가고 싶지만, 이 수정은 균열의 절반에 불과해.");
 ds_map_add(m,"Lili! Excuse her, she was born without touch.","릴리! 사과할게. 저 애는 원래 눈치가 없어.");
 ds_map_add(m,"Wow.. it's a lot to digest but at least you already have the crystal to return to that horrible place.","와... 소화하기 힘든 이야기지만, 적어도 그 끔찍한 곳으로 돌아갈 수정은 이미 갖고 있네.");
 ds_map_add(m,"Yes, my dimension is called Luminous, right now a corrupt god is wreaking havoc and that is why my dimension has these dimensional fractures.","그래. 내 차원의 이름은 루미너스야. 지금 타락한 신이 그곳을 난장판으로 만들고 있어. 그래서 우리 차원에 균열이 생긴 거야.");
 ds_map_add(m,"Wait do you come from another dimension?","잠깐, 너 다른 차원에서 온 거야?");
 ds_map_add(m,"That crystal is really a dimensional rift and my only way to get back home.","그 수정은 실제로 차원 균열이야. 내가 집으로 돌아갈 유일한 방법이지.");
 ds_map_add(m,"That crystal, why is it so important to you?","그 수정 말이야. 왜 그렇게 중요한 거야?");
 ds_map_add(m,"Relax, it was nothing.","진정해. 별일 아니었어.");
 ds_map_add(m,"Yes, Thanks for helping me, I didn't have any more energy to fight.","응, 도와줘서 고마워. 더는 싸울 기운이 없었거든.");
 ds_map_add(m,"Are you ok?","괜찮아?");
 ds_map_add(m,"Oh sorry I will go take it now.","아, 미안. 지금 가서 가져올게.");
 ds_map_add(m,"Wait you forgot to take the crystal.","잠깐, 수정 가져가는 걸 잊었잖아.");
 ds_map_add(m,"Ahhhh you are right let's do it.","아아, 맞다. 어서 가자.");
 ds_map_add(m,"Come on line just look at her, undress her with your dirty eyes, don't you want to see her like this all the time?","어서, 라인. 그녀를 봐. 그 더러운 눈으로 옷을 벗겨 보라고. 항상 저런 모습으로 있는 걸 보고 싶지 않아?");
 ds_map_add(m,"But I do not understand, why do all that?","하지만 왜 그런 일을 해야 하는지 모르겠어.");
 ds_map_add(m,"Look, if they find you before you start the robbery they will only give you a warning and the farmer will be able to work naked.","봐, 도둑질을 시작하기 전에 들키면 경고만 받고 끝날 거야. 그러면 농장주는 알몸으로 일할 수 있게 되겠지.");
 ds_map_add(m,"....Whhaat?","...뭐라고?");
 ds_map_add(m,"Exactly..","바로 그거야...");
 ds_map_add(m,"You are insane! I do not want to go to jail.","미쳤어?! 감옥에 가고 싶지 않아.");
 ds_map_add(m,"Look, if the farmer wants to be more comfortable at work, why don't you try to steal this milk?","농장 여자가 더 편하게 일하고 싶어 한다면, 우유를 훔쳐 보는 건 어때?");
 ds_map_add(m,"What is it?","무슨 일인데?");
 ds_map_add(m,"Hey Line I think I have an idea.","이봐, 라인. 좋은 생각이 났어.");
 ds_map_add(m,"Hey you people, what are you doing!","이봐, 너희들! 지금 뭐 하는 거야!");
 ds_map_add(m,"Ohh.... fine..","아아... 알았어...");
 ds_map_add(m,"get naked, if that doesn't get you noticed, nothing will.","옷을 벗어. 그래도 눈길을 끌지 못한다면 다른 방법은 없을 거야.");
 ds_map_add(m,"What do we do then?","그럼 어떻게 하지?");
 ds_map_add(m,"Mmm this woman does not realize what is going on around her, no wonder the inmates are escaping.","음, 이 여자는 주변에서 무슨 일이 벌어지는지 전혀 모르는군. 죄수들이 탈옥하는 것도 당연해.");
 ds_map_add(m,"Ohh ok I will just move it from one side to the other..","아, 알겠어. 그냥 이쪽에서 저쪽으로 옮기기만 하면 되는 거지...");
 ds_map_add(m,"Wait Line Do not take it out of the box just move it.","잠깐, 라인. 상자에서 꺼내지 말고 그냥 옮기기만 해.");
 ds_map_add(m,"Line starts to take out the milk bucket.","라인이 우유 양동이를 꺼내기 시작한다.");
 ds_map_add(m,"What act?","무슨 연기?");
 ds_map_add(m,"Ah shut up the act is over.","아, 닥쳐. 연극은 끝났어.");
 ds_map_add(m,"Why did you untie me?!","왜 날 풀어 준 거야?!");
 ds_map_add(m,"She says she understands and will never do it again.","다시는 그러지 않겠다고, 이제 알겠다고 하네요.");
 ds_map_add(m,"Mmmhemm hemmmMmmm.","음흠, 으흠음.");
 ds_map_add(m,"I will give you only one warning but if you steal again I swear I will take you to the guards.","이번 한 번만 경고하겠어. 또 훔치면 맹세코 경비병에게 넘길 거야.");
 ds_map_add(m,"Have a nice day Miss the prison-farm is a good place to buy aphrodisiacs as well as exemplifying the sentences of people who break the law.","좋은 하루 보내세요, 아가씨. 감옥 농장은 최음제를 사기에도 좋고, 법을 어긴 사람들이 어떤 형벌을 받는지 보여 주는 곳이기도 합니다.");
 ds_map_add(m,"You found one of the stolen relics! I'll give the news to the captain, you can go and return it to the church and I know they will be grateful.","도난당한 성유물 중 하나를 찾으셨군요! 대장에게 소식을 전하겠습니다. 교회에 돌려주셔도 됩니다. 분명 감사해할 거예요.");
 ds_map_add(m,"Oh it's out of order, I really want to go to the bathroom :c.","아, 고장 났네. 화장실에 정말 가고 싶은데 :c.");
 ds_map_add(m,"Well, it is out of order anyway.","어차피 고장 나서 쓸 수 없어.");
 ds_map_add(m,"I cannot get in here, it is the men's room.","여긴 들어갈 수 없어. 남자 화장실이야.");
 ds_map_add(m,"Hey watchout!","이봐, 조심해!");
 ds_map_add(m,"No, over my dead body you ruin my whole plan!","안 돼! 내 계획을 전부 망치게 둘 순 없어. 그러려면 내 시체를 밟고 지나가!");
 ds_map_add(m,"Ehhh... Agh it's ok what should I do.","으음... 아, 좋아. 이제 어떻게 해야 하지?");
 ds_map_add(m,"Not anymore, Line owes me.","이제는 아니야. 라인은 내게 빚졌거든.");
 ds_map_add(m,"WHAT? But I'm the one who has to do it.","뭐라고? 하지만 그건 내가 해야 하는 일이잖아.");
 ds_map_add(m,"Line? I need your help damn it, go to my place now!","라인? 도움이 필요해, 젠장. 당장 내 가게로 와!");
 ds_map_add(m,"Oh that's a bit aggressive.","와, 말투가 꽤 공격적인데.");
 ds_map_add(m,"That's what worries me, you bloody gambler, if I see that you've turned the place into a casino I swear I'll kill you!","바로 그게 걱정이야, 이 빌어먹을 도박꾼아. 여기를 카지노로 바꿔 놓은 걸 보기만 해 봐. 맹세코 죽여 버릴 거야!");
 ds_map_add(m,"Don't worry SieKi I will run the place even better than you.","걱정 마, 시에키. 네가 하던 것보다 훨씬 잘 운영할게.");
 ds_map_add(m,"Shit, I really don't want to but I didn't have time to look for someone.","젠장, 정말 하기 싫지만 다른 사람을 찾을 시간이 없었어.");
 ds_map_add(m,"Then she will take your place for a while, Sieki?","시에키, 그럼 한동안 그녀가 네 자리를 대신하면 되겠네?");
 ds_map_add(m,"Stay out of my business!","내 일에 끼어들지 마!");
 ds_map_add(m,"and let me make it clear you are working so be professional and don't touch anything on my desk!","그리고 확실히 말해 두겠는데, 넌 일하러 온 거야. 프로답게 행동하고 내 책상 위에 있는 건 건드리지 마!");
 ds_map_add(m,"Oh I am sorry I am sorry I am running right now.","아, 죄송해요, 죄송해요. 지금 바로 뛰어갈게요.");
 ds_map_add(m,"Line what are you waiting for stop talking and go to work!","라인, 뭐 하고 있어? 그만 떠들고 일하러 가!");
 ds_map_add(m,"Of course, there is no problem <3.","물론이지. 문제없어 <3.");
 ds_map_add(m,"W-would you really come ;c?","너, 정말 와 줄 거야? ;c");
 ds_map_add(m,"Oh, okay, I-I will visit you when you do.","아, 알겠어. 네가 자리 잡으면 나, 나도 보러 갈게.");
 ds_map_add(m,"Ahhh fuck you, I'll make my own secret club with gambling and pachinko!","아아, 엿 먹어! 도박과 파친코가 있는 비밀 클럽을 내가 직접 만들 거야!");
 ds_map_add(m,"Thank you for opening your mind to me. It's been a long time since people came to see me. I'll give you advice as a gift. I see an evil being behind you, exposing your weakness. A shell of a being. If you don't find your ego, it will take its place, and you'll lose the little bit of individuality you have now.","마음을 열어 줘서 고마워요. 사람들이 저를 찾아온 지도 오래됐군요. 선물로 조언을 하나 드릴게요. 당신 뒤에 사악한 존재가 보여요. 당신의 약점을 드러내게 만들고 있군요. 껍데기뿐인 존재예요. 당신이 자아를 찾지 못하면 그것이 당신의 자리를 차지하고, 지금 당신에게 남아 있는 얼마 안 되는 개성마저 잃게 될 거예요.");
 ds_map_add(m,"Ah, I-I'm sorry, Line. No, no, I can't. My head, ah, it hurts. I don't know what's happening.","아, 라, 라인. 미안해. 안 돼, 안 돼. 못 하겠어. 머리가, 아, 너무 아파. 무슨 일이 일어나는지 모르겠어.");
 ds_map_add(m,"Sh-shut up! I do not understand anything, Lili. Attack the serpent, please! I need you, please, make it stop!","그, 그만해! 아무것도 이해할 수 없어, 릴리. 제발 뱀을 공격해! 네가 필요해. 제발 이걸 멈춰 줘!");
 ds_map_add(m,"You're a shallow, flat shell of a person. It's hard to even call you an individual. Your super ego in society makes people idolize you like a hero, a role model. But when you're alone, your id surfaces, revealing nothing more than an animal devoid of any reasoning.","넌 얕고 텅 빈 껍데기 같은 인간이야. 독립된 인격체라고 부르기도 어려워. 사회에서 네 초자아는 사람들로 하여금 널 영웅이나 본보기처럼 숭배하게 만들지. 하지만 혼자 있을 때면 네 이드가 드러나고, 이성이라고는 조금도 없는 짐승만 남아.");
 ds_map_add(m,"P-p-please, do not m-make me think about my family anymore. I-I beg you, get out of my head.","제, 제발. 더는 가, 가족 생각을 하게 하지 마. 부, 부탁이야. 내 머릿속에서 나가 줘.");
 ds_map_add(m,"Please, get out of my head. I do not want to hear anymore.","제발 내 머릿속에서 나가. 더는 듣고 싶지 않아.");
 ds_map_add(m,"You're right. You're a slut, and you're a saint. Your life has been about living between two extremes.","네 말이 맞아. 넌 걸레이자 성녀야. 네 인생은 그 두 극단 사이에서 살아온 삶이지.");
 ds_map_add(m,"Line, calm down. Ahh, my head, what's happening?","라인, 진정해. 아아, 머리가 아파. 무슨 일이야?");
 ds_map_add(m,"IT'S A LIE! I-I-I was always a good daughter in the village, a model daughter! I never did anything to shame my father!","거짓말이야! 나, 나, 난 마을에서 언제나 착한 딸이었어. 모범적인 딸이었다고! 아버지를 부끄럽게 한 적은 한 번도 없어!");
 ds_map_add(m,"Do you really want them to know what you are? A shameless woman whose only motive is carnal relief. Your father is better off without knowing you; your mother saved him from seeing his daughter fall into a hopeless pit.","정말 네 본모습을 그들이 알길 바라? 육체적 욕구를 채우는 것만이 목적인 뻔뻔한 여자라는 걸? 네 아버지는 네가 어떤 사람인지 모르는 편이 나아. 어머니는 딸이 구제할 수 없는 구렁텅이에 빠지는 모습을 아버지가 보지 않도록 막아 준 거야.");
 ds_map_add(m,"Wh-what! No, she w-wanted to h-help me get to kn-know myself, to t-truly experience and s-shape myself through int-interacting with other people!","뭐, 뭐라고! 아니야. 어, 어머니는 내가 자, 자신을 알도록 도와주려 했어. 다른 사람들과 교류하면서 진, 진정으로 경험하고 스스로를 만들어 가도록 말이야!");
 ds_map_add(m,"Your mother helped you leave the village just so you wouldn't cause problems for your father.","네 어머니는 네가 아버지에게 문제를 일으키지 않도록 마을을 떠나게 도와준 것뿐이야.");
 ds_map_add(m,"Line, are you okay?!","라인, 괜찮아?!");
 ds_map_add(m,"Ah!? Why do I hear you in my head?","아!? 왜 네 목소리가 머릿속에서 들리는 거지?");
 ds_map_add(m,"But you're just a nymphomaniac without morals, the nightmare of your father and the mistake of your mother.","하지만 넌 도덕도 없는 색정광일 뿐이야. 네 아버지에게는 악몽이고, 네 어머니에게는 실수였지.");
 ds_map_add(m,"*Starts to cry* Sniff, sniff, th-thank you, really. I thought I was a j-joke, just a nymphomaniac in the form of an elf who can not even be a w-woman of values like my f-father wanted.","*울기 시작한다* 훌쩍, 훌쩍. 저, 정말 고마워. 난 내가 웃음거리인 줄 알았어. 아버지가 바라던 품위 있는 여자가 되지도 못하는, 엘프 모습을 한 색정광일 뿐이라고 생각했어.");
 ds_map_add(m,"You're in a place where everyone gets what they want\nyour powers can't have an effect when everyone is already at the highest level of ecstasy.","넌 모두가 원하는 것을 얻는 곳에 있어.\n모두가 이미 최고의 황홀경에 도달해 있다면 네 능력은 아무런 효과도 낼 수 없어.");
 ds_map_add(m,"B-ut I am succubus, they should be the ones desiring me more!","하, 하지만 난 서큐버스잖아. 사람들이 날 더 원해야 하는 거 아니야!");
 ds_map_add(m,"The most accurate thing is that your friend was a warrior dragon, something not commonly seen in those places. You shouldn't worry; they just desired her more.","정확히 말하자면 네 친구가 전투 용이었기 때문이야. 그런 곳에서는 흔히 볼 수 없는 존재지. 걱정할 것 없어. 사람들이 그 친구를 더 원했을 뿐이야.");
 ds_map_add(m,"Being half succubus doesn't necessarily mean you have to be the best in the sex. It could be due to various factors that VIPs liked your friend more than you.","반쪽 서큐버스라고 해서 반드시 섹스를 가장 잘해야 하는 건 아니야. VIP들이 너보다 네 친구를 더 좋아한 데에는 여러 이유가 있을 수 있지.");
 ds_map_add(m,"Th-the thing is, it seemed like people enjoyed being with her more than with me, and, well, being half succubus makes me feel like I am a disgrace, as if it were a mistake or something like that.","그, 그러니까 사람들이 나보다 그 애와 함께 있는 걸 더 즐기는 것 같았어. 그리고 반쪽 서큐버스라는 사실 때문에 내가 수치스러운 존재 같아. 마치 잘못 태어난 것처럼 말이야.");
 ds_map_add(m,"Oh? Emm I think I have a question... *looks around* Not long ago, a friend and I were working in a VIP area on the island as onaholes.","어? 음, 질문이 하나 있는데... *주변을 둘러본다* 얼마 전 친구와 함께 섬의 VIP 구역에서 오나홀로 일했어.");
 ds_map_add(m,"Hello, I'm Veritus and I can answer any question!","안녕하세요. 저는 베리투스입니다. 어떤 질문이든 답해 드릴 수 있어요!");
 ds_map_add(m,"It sticking out its little tongue, it is so adorable! <3","작은 혀를 내밀고 있잖아. 너무 귀여워! <3");
 ds_map_add(m,"Look at the sea serpent, it is so cute! <3","저 바다뱀 좀 봐. 정말 귀엽다! <3");
 ds_map_add(m,"Verity Pond","베리티 연못");
 ds_map_add(m,"Warning! $%&/(%/ &$#%% in the Pond: Speaking to it is akin to facing a mirror of your innermost self. It can answer questions, but its cost is unknown and can negatively affect people. Caution and respect are advised, avoiding deceit. Enjoy the pond with care and consideration.","경고! 연못 속의 $%&/(%/ &$#%%: 그것과 대화하는 것은 자신의 가장 깊은 내면을 비추는 거울을 마주하는 것과 같습니다. 질문에 답해 줄 수 있지만, 그 대가는 알려져 있지 않으며 사람들에게 부정적인 영향을 미칠 수 있습니다. 속임수 없이 신중하고 존중하는 태도로 대하세요. 연못을 즐길 때도 주의와 배려를 잊지 마세요.");
 ds_map_add(m,"Maybe I better leave.","그냥 떠나는 게 낫겠어.");
 ds_map_add(m,"Lili, did I wake up before you?","릴리, 내가 너보다 먼저 일어난 거야?");
 ds_map_add(m,"Ugh, what a horrible nightmare has happened?","으, 정말 끔찍한 악몽이었어. 무슨 일이 있었던 거지?");
 ds_map_add(m,"Lovers bridge","연인의 다리");
 ds_map_add(m,"Hey you cannot pass without paying the toll.","이봐, 통행료를 내지 않으면 지나갈 수 없어.");
 ds_map_add(m,"Hey! What do you think you're doing?","이봐! 지금 무슨 짓을 하는 거야?");
 ds_map_add(m,"It's the only thing you deserve for having the nerve to believe you can catch me.","감히 날 잡을 수 있다고 생각한 네가 받을 만한 건 이것뿐이야.");
 ds_map_add(m,"Here you have my stinking foot","자, 내 냄새나는 발이나 받아라.");
 ds_map_add(m,"Like the closet thirsty succubus that you are.","겉으로 점잖은 척하면서 속으로는 욕정에 굶주린 서큐버스답군.");
 ds_map_add(m,"You will have to touch yourself here in front of passersby.","여기서 지나가는 사람들 앞에 놓고 자위해야 할 거야.");
 ds_map_add(m,"Hehe I know a way that you can save your little friend.","헤헤, 네 작은 친구를 구할 방법을 알고 있어.");
 ds_map_add(m,"Please do not take Lili.","제발 릴리를 데려가지 마.");
 ds_map_add(m,"I'll keep your fairy, it will sell very well on the black market.","네 요정은 내가 데려가겠어. 암시장에 팔면 꽤 좋은 값을 받겠지.");
 ds_map_add(m,"I told you that your attempt to catch me was useless.","널 잡으려는 시도는 소용없다고 말했잖아.");
 ds_map_add(m,"Well it does not matter I will go to your base.","뭐, 상관없어. 네 기지로 가겠어.");
 ds_map_add(m,"But it seems you wanted it to come to this.","하지만 이렇게 되길 바란 건 너인 것 같군.");
 ds_map_add(m,"Hahaha you disgust me if you told me that before you would have saved yourself the humiliation.","하하하, 역겨워. 진작 그렇게 말했으면 이런 굴욕을 당하지 않았을 텐데.");
 ds_map_add(m,"Yes! and I'll take out the wanted posters.","좋아! 수배 포스터도 전부 철거할게.");
 ds_map_add(m,"Ple-please do not take Lili, we have a base you can hide.","부, 부탁이야. 릴리를 데려가지 마. 숨을 수 있는 우리 기지가 있어.");
 ds_map_add(m,"Do not worry, we will give you 1000 Arcs as a reward, you just have to go and pick it up at the jail-farm.","걱정하지 마. 보상으로 아크 1000개를 줄게. 감옥 농장에 가서 받기만 하면 돼.");
 ds_map_add(m,"Lili! do not be rude.","릴리! 무례하게 굴지 마.");
 ds_map_add(m,"And our reward?","그럼 우리 보상은?");
 ds_map_add(m,"Oh.. there is nothing to be thankful for.","아... 고마워할 것까지는 없어.");
 ds_map_add(m,"Thank you again, traveler, and this is the third criminal that we arrest thanks to you.","다시 한번 고맙네, 여행자. 너희 덕분에 체포한 범죄자가 벌써 세 번째야.");
 ds_map_add(m,"But calm down if you lick the sweat you can pass your humiliation faster.","그래도 진정해. 땀을 핥아 내면 이 굴욕도 더 빨리 끝낼 수 있어.");
 ds_map_add(m,"The only way you can get rid of this is by reaching climax.","여기서 벗어날 수 있는 유일한 방법은 절정에 도달하는 거야.");
 ds_map_add(m,"Ple-please let me go I can not continue like this.","제, 제발 보내 줘. 더는 이렇게 못 하겠어.");
 ds_map_add(m,"I am a special Type of wyvern that can secrete an aphrodisiac and use it at will..","난 최음제를 분비해서 마음대로 사용할 수 있는 특별한 종류의 와이번이야...");
 ds_map_add(m,"Bu-but why do I feel like this?","그, 그런데 왜 내가 이런 기분이 드는 거지?");
 ds_map_add(m,"Haha and what if I'm not for the others you are just perverts who skipped the toll.","하하, 내가 그런 사람이 아니라면 어쩔 건데? 다른 사람들 눈에는 너희가 통행료를 내지 않은 변태들일 뿐이야.");
 ds_map_add(m,"Shit, you're not a guard!","젠장, 넌 경비병이 아니잖아!");
 ds_map_add(m,"Do you really think that I would let go without paying?","돈도 내지 않고 그냥 보내 줄 거라고 생각했어?");
 ds_map_add(m,"What the hell AHHHH.","뭐야, 젠장! 아아아!");
 ds_map_add(m,"I-I'm sorry Lili I ca-can not contain myself I do not know what's happening to me.","미, 미안해, 릴리. 자, 자제할 수가 없어. 나한테 무슨 일이 일어나는지 모르겠어.");
 ds_map_add(m,"What the hell damn pervert !? do not touch yourself in public have some dignity!","뭐야, 이 빌어먹을 변태야?! 공공장소에서 자위하지 마. 체면 좀 차려!");
 ds_map_add(m,"I do not know, I feel very hot.","모르겠어. 몸이 너무 뜨거워.");
 ds_map_add(m,"Ah?.","어?");
 ds_map_add(m,"Oh .. Lili I do-do not feel good.","아... 릴리, 나, 나 몸이 안 좋아.");
 ds_map_add(m,"Just what I like to hear, from now on you'll help me cover all my tracks, haha~.","바로 그거야. 이제부터 내 흔적을 전부 지우는 걸 도와줘. 하하~.");
 ds_map_add(m,"Yes! and I will take out all the wanted posters for the liberation of Line.","좋아! 라인을 풀어 주도록 수배 포스터를 전부 철거하겠어.");
 ds_map_add(m,"We have a base where you can hide, but at least free Lili.","숨을 수 있는 기지가 있어. 하지만 적어도 릴리부터 풀어 줘.");
 ds_map_add(m,"I know that you are the person who is in the wanted posters.","네가 수배 포스터에 나온 바로 그 사람이라는 걸 알고 있어.");
 ds_map_add(m,"Wait please let me talk.","잠깐, 제발 내 말 좀 들어 줘.");
 ds_map_add(m,"Uhh I see you finished how about a second round.","어, 끝난 것 같네. 한 번 더 할까?");
 ds_map_add(m,"It would help me a lot to write my new novel, as I need new sources of inspiration, thank you for listening to my request, that's all I had to say, now I will continue with my next song.","새 소설을 쓰는 데 큰 도움이 될 거예요. 새로운 영감의 원천이 필요했거든요. 제 부탁을 들어줘서 고마워요. 할 말은 여기까지예요. 이제 다음 곡을 연주할게요.");
 ds_map_add(m,"Before I start my next song if anyone knows a hero or adventurer would you be so kind to introduce him to me.","다음 곡을 시작하기 전에, 혹시 영웅이나 모험가를 아는 분이 있다면 소개해 주시겠어요?");
 ds_map_add(m,"Thank you all so much for listening <3.","들어 주셔서 정말 감사합니다 <3.");
 ds_map_add(m,"Lucy Monroe the wandering bard","떠돌이 음유시인 루시 먼로");
 ds_map_add(m,"NOOOOOOOOOOOOOO!","안 돼애애애애애!");
 ds_map_add(m,"Lili, I need a coat, like right right now.","릴리, 당장, 정말 당장 코트가 필요해.");
 ds_map_add(m,"OH no, please Line, NO!","아, 안 돼. 제발, 라인. 안 돼!");
 ds_map_add(m,"I think this experience has just awakened something inside me, something bad.","이번 경험이 내 안의 무언가를 깨운 것 같아. 좋지 않은 무언가를.");
 ds_map_add(m,"Yeah?","응?");
 ds_map_add(m,"... Lili.","... 릴리.");
 ds_map_add(m,"Uff thats my signal.","후우, 내 차례라는 신호네.");
 ds_map_add(m,"That's all I'll call the guards","그만해. 경비병을 부를 거야.");
 ds_map_add(m,"Yes! I mean no, I dont know D:.","맞아! 아니, 내 말은... 모르겠어 D:.");
 ds_map_add(m,"Fuck no you weirdo.","씨발, 절대 싫어. 이 괴짜야.");
 ds_map_add(m,"You like what you see hehehe.","네가 보는 게 마음에 들지? 헤헤헤.");
 ds_map_add(m,":O Lili she squirt in front of us!",":O 릴리, 우리 앞에서 분수처럼 쌌어!");
 ds_map_add(m,"What that hell are you doing?!","대체 무슨 짓을 하는 거야?!");
 ds_map_add(m,"Yes wait, I have something to show you, where is it? oh it's here!","그래, 잠깐만. 보여 줄 게 있는데, 어디 있더라? 아, 여기 있다!");
 ds_map_add(m,"Oh di-did you call me?","어, 나, 나 불렀어?");
 ds_map_add(m,"Yes you, the one with blue hair!","그래, 너 말이야! 파란 머리 한 사람!");
 ds_map_add(m,"Ah?","응?");
 ds_map_add(m,"Hey you, come here!","이봐, 너! 이리 와!");
 ds_map_add(m,"I've never done this you dirty pervert! Now go do what you came here to do!","이런 짓은 한 번도 해 본 적 없어, 이 더러운 변태야! 이제 네가 여기 온 목적이나 처리해!");
 ds_map_add(m,"Lili, you are a genius. Are you sure you haven't done this before?","릴리, 너 천재구나. 정말 전에 이런 걸 해 본 적 없어?");
 ds_map_add(m,"If you do so with no one in front of you, you may attract the attention of a guard.","앞에 아무도 없는데 그런 짓을 하면 경비병의 주의를 끌 수도 있어.");
 ds_map_add(m,"Just yell and get someone's attention will come and when they are in front of you open your coat.","그냥 소리쳐서 누군가의 관심을 끌어. 그 사람이 네 앞에 오면 코트를 열어.");
 ds_map_add(m,"But I need someone to come, what do I do then?","하지만 누군가를 불러야 하잖아. 그럼 어떻게 해야 해?");
 ds_map_add(m,"Ahhh, look I won't look for anyone but I'll be with you.","아아, 잘 들어. 다른 사람을 찾아주진 않을 거야. 그래도 네 곁에는 있어 줄게.");
 ds_map_add(m,"B-but Lili I really need you :c.","그, 그런데 릴리, 난 네가 정말 필요해 :c.");
 ds_map_add(m,"What no way!?","뭐, 말도 안 돼!?");
 ds_map_add(m,"Ehem, I am going to change my clothes, you-you bring someone.","크흠, 난 옷을 갈아입으러 갈게. 너, 너는 누군가 데려와.");
 ds_map_add(m,"I worry about you sometimes Line.","가끔은 네가 걱정돼, 라인.");
 ds_map_add(m,"Hehehehehe Eeeehhhhhh.","헤헤헤헤헤... 으으으으으.");
 ds_map_add(m,"Thank you Lili.","고마워, 릴리.");
 ds_map_add(m,"*Patting Line's head *Oh ya ya, you'll be all right.","*라인의 머리를 쓰다듬으며* 그래, 그래. 괜찮을 거야.");
 ds_map_add(m,"yes, although she pulls my hair in a way that I don't like :c.","응, 그래도 그 애가 내 머리카락을 잡아당기는 방식은 마음에 안 들어 :c.");
 ds_map_add(m,"Don't worry, I just said it to make her go away.","걱정 마. 그냥 그 여자를 쫓아내려고 그렇게 말한 거야.");
 ds_map_add(m,"Ay Lili, where can I hide?","아, 릴리. 어디 숨으면 좋을까?");
 ds_map_add(m,"OH ok :c","아, 알겠어 :c.");
 ds_map_add(m,"Tsk I have to go but if I see you here again, you're dead.","쳇, 이제 가야겠어. 하지만 여기서 또 마주치면 넌 죽은 목숨이야.");
 ds_map_add(m,"Ehh you better hide you made a lot of noise the guards are coming!","어, 얼른 숨어! 네가 너무 시끄럽게 굴어서 경비병들이 오고 있어!");
 ds_map_add(m,"AHh Lili help me!","아아, 릴리! 도와줘!");
 ds_map_add(m,"Who do you think you are? Stealing my place, I've been stripping here for weeks!","네가 뭔데 내 자리를 뺏어? 난 여기서 몇 주째 스트립쇼를 하고 있단 말이야!");
 ds_map_add(m,"Come here you stupid bitch.","이리 와, 이 멍청한 년아.");
 ds_map_add(m,"Me? I am not doing anything, I swear.","나? 아무것도 안 했어. 맹세해.");
 ds_map_add(m,"What the hell are you doing here? This is my place.","여기서 대체 뭐 하는 거야? 여긴 내 자리야.");
 ds_map_add(m,"Hey you!","이봐, 너!");
 ds_map_add(m,"Mmm... no.","음... 아니.");
 ds_map_add(m,"Shouldn't we take it to the guards?","그걸 경비병에게 가져다줘야 하지 않을까?");
 ds_map_add(m,"Wow it's a scarlet crystal sphere! We could pass it on to the fortune teller since she was looking for it.","와, 진홍색 수정구야! 점쟁이가 찾고 있었으니 그녀에게 가져다주면 되겠어.");
 ds_map_add(m,"Look Lili what I found.","릴리, 내가 뭘 찾았는지 봐.");
 ds_map_add(m,"Mmmmm... no, we could use it for something or sell it :V.","으음... 아니, 어딘가 쓸 데가 있거나 팔 수도 있잖아 :V.");
 ds_map_add(m,"Should not we take it to the guards?","그걸 경비병에게 가져가야 하지 않을까?");
 ds_map_add(m,"Hey! that ball is not the one I handed it to him, it looks like glass.","이봐! 그건 내가 그 사람에게 건네준 공이 아니야. 유리처럼 보이잖아.");
 ds_map_add(m,"Look Lili the red ball!","릴리, 저 빨간 공 좀 봐!");
 ds_map_add(m,"Magenta swamp.","마젠타 늪지.");
 ds_map_add(m,"Welcome to the Magenta swamp, the place where the most brutal mud fights in the world take place!!","마젠타 늪지에 온 걸 환영한다! 이곳은 세계에서 가장 격렬한 진흙 싸움이 벌어지는 곳이다!!");
 ds_map_add(m,"Oh you talk like you don't Like it, looks like Jessi spoiled you alot, you bad little girl.","어머, 말하는 꼴을 보니 싫지는 않은가 봐. 제시가 널 꽤 응석받이로 키웠나 보네, 이 나쁜 꼬마 아가씨.");
 ds_map_add(m,"Playtime is over Elena, leave the puppet and the diaper on the floor and you won't get hurt.","놀이는 끝났어, 엘레나. 인형과 기저귀를 바닥에 내려놔. 그러면 다치지 않을 거야.");
 ds_map_add(m,"Yeah what she said, you will not kidnap anyone while we are here.","그래, 저 말대로야. 우리가 있는 한 누구도 납치하지 못해.");
 ds_map_add(m,"Stop right there you criminal scum!","거기 서라, 이 범죄자 쓰레기야!");
 ds_map_add(m,"Of course Line, there is no problem with that.","물론이지, 라인. 전혀 문제없어.");
 ds_map_add(m,"At least can we accompany you to the entrance of the town?","적어도 마을 입구까지는 우리가 함께 가도 될까?");
 ds_map_add(m,"I'm sorry Line I really have to go.","미안해, 라인. 정말 가 봐야 해.");
 ds_map_add(m,"Oh... I thought we could spend a little more time together but, its ok.","아... 조금만 더 같이 있을 수 있을 줄 알았는데. 뭐, 괜찮아.");
 ds_map_add(m,"I have to return to Tricotex with my partner, sadly being a hero is a job that never ends.","안타깝지만 파트너와 트리코텍스로 돌아가야 해. 영웅이라는 직업은 끝이 없거든.");
 ds_map_add(m,"We made it Sam now that we caught the criminal, but now what will you do?","해냈어, 샘. 범죄자를 잡았는데, 이제 넌 어떻게 할 거야?");
 ds_map_add(m,"Girls. You did a good job. I'll take her to the jail-farm to serve her sentence.","얘들아, 잘했어. 저 여자를 감옥 농장으로 데려가 형기를 치르게 하겠어.");
 ds_map_add(m,"Fairy where?","요정이 어디 있다고?");
 ds_map_add(m,"Well I would have gotten away with it, if it weren't for these nosy kids and their fairy.","이 수다쟁이 꼬맹이들과 그 요정만 아니었어도 무사히 빠져나갔을 텐데.");
 ds_map_add(m,"Yes, there will be no ABC Daycare here on the island!","그래! 이 섬에서 ABC 어린이집 같은 일은 다시는 없을 거야!");
 ds_map_add(m,"Your days kidnapping people are over.","사람들을 납치하던 날들도 이제 끝이야.");
 ds_map_add(m,"Game over Elena we already beat you, you can't escape.","끝났어, 엘레나. 우린 이미 널 이겼어. 도망칠 수 없어.");
 ds_map_add(m,"Please someone help me I don't want to wear a diaper!","제발 누가 좀 도와줘! 기저귀는 입기 싫어!");
 ds_map_add(m,"It seems that I must teach these bad girls how to behave.","이 나쁜 여자들에게 올바른 행동이 뭔지 가르쳐 줘야겠군.");
 ds_map_add(m,"To fight!","싸우자!");
 ds_map_add(m,"Thank you Line, with you helping my I know can get back home.","고마워, 라인. 네가 도와주니 집으로 돌아갈 수 있을 것 같아.");
 ds_map_add(m,"Don't worry Vasuki we will get the crystal.","걱정 마, 바수키. 우리가 수정을 찾아줄게.");
 ds_map_add(m,"Line these two will not leave the crystal we will have to take it by force.","라인, 저 둘은 수정을 넘기지 않을 거야. 힘으로 빼앗아야겠어.");
 ds_map_add(m,"Sorry, but we also need these Crystals for the people we love.","미안하지만 우리도 사랑하는 사람들을 위해 이 수정들이 필요해.");
 ds_map_add(m,"Please, I have family my children await my return.","제발, 나에겐 가족이 있어. 아이들이 내가 돌아오길 기다리고 있다고.");
 ds_map_add(m,"Stop kidding this crystal is the only thing that separates Vasuki from her home.","농담하지 마. 이 수정이 없으면 바수키는 집에 돌아갈 수 없어.");
 ds_map_add(m,"This Crystal belongs to Red Team!","레드 팀의 수정이야!");
 ds_map_add(m,"Why are your so mean?","왜 그렇게 못되게 굴어?");
 ds_map_add(m,"Ay Line you are very kind to me hehe.","아이고, 라인. 정말 친절하네, 헤헤.");
 ds_map_add(m,"Sounds great, I heard they grow special fruits there, I would love to eat something new with you <3.","좋겠다. 거기서 특별한 과일을 재배한다고 들었어. 너와 함께 새로운 걸 먹어 보고 싶어 <3.");
 ds_map_add(m,"Yes. I think it would be for the best, I even have some fruits that the cows gave me.","그래. 그게 최선일 것 같아. 소들에게 받은 과일도 좀 있어.");
 ds_map_add(m,"Come to my house so you can rest and then return to your dimension, Vasuki, something could happen to you if you fall unconscious in the change of dimensions.","바수키, 우리 집에 가서 쉬었다가 네 차원으로 돌아가. 차원 이동 중에 의식을 잃으면 무슨 일이 생길지 몰라.");
 ds_map_add(m,"I have not rested since I came to this dimension.","이 차원에 온 뒤로 한 번도 쉬지 못했어.");
 ds_map_add(m,"Vasuki do you feel good?","바수키, 괜찮아?");
 ds_map_add(m,"Now, I just have to ...","이제 남은 건...");
 ds_map_add(m,"Oh sorry Lili thank you so much to you too.","아, 미안해 릴리. 너도 정말 고마워.");
 ds_map_add(m,"Ehemmmm.","크흠.");
 ds_map_add(m,"Thank you very much Line, I can finally return home.","정말 고마워, 라인. 드디어 집으로 돌아갈 수 있어.");
 ds_map_add(m,"We made it <3!","해냈어 <3!");
 ds_map_add(m,"Count on me Vasuki you will have my full support.","나만 믿어, 바수키. 전적으로 도와줄게.");
 ds_map_add(m,"Line, will you help me to get proof? and thus reveal to the whole island what is going on here.","라인, 증거를 찾는 걸 도와줄래? 그래야 이곳에서 무슨 일이 벌어지는지 섬 전체에 알릴 수 있어.");
 ds_map_add(m,"That so terrible she looked such a good woman.","정말 끔찍하네. 아주 좋은 사람처럼 보였는데.");
 ds_map_add(m,"I believe they are involved.","그들이 연루되어 있다고 생각해.");
 ds_map_add(m,"I went to tell the guards before I started my investigation and they told me that there was nothing unusual going on in this house.","조사를 시작하기 전에 경비병들에게 알리러 갔어. 그런데 그 집에서는 아무런 이상한 일도 일어나지 않는다고 하더군.");
 ds_map_add(m,"What! we must tell the great captain.","뭐라고! 대장님께 알려야 해.");
 ds_map_add(m,"Very bad I'm afraid Lili, I heard things like, money laundering, trafficking of people and drugs.","정말 심각해, 릴리. 돈세탁, 인신매매, 마약 같은 이야기를 들었어.");
 ds_map_add(m,"Come on how bad can this place be it's almost a paradise, well apart from that white demon.","어서, 이곳이 얼마나 나쁘겠어? 거의 낙원이나 다름없잖아. 그 하얀 악마만 빼면 말이야.");
 ds_map_add(m,"Well I work as a bounty hunter to help around the house and in one of my jobs I heard some very bad things about this place.","집안일을 돕기 위해 현상금 사냥꾼으로 일해. 그러다 한 의뢰를 맡았을 때 이곳에 관한 끔찍한 소문을 들었어.");
 ds_map_add(m,"Line... well I'm investigating this place.","라인... 사실 이곳을 조사하고 있어.");
 ds_map_add(m,"Hi Vasuki, what are you doing here?","안녕, 바수키. 여기서 뭐 해?");
 ds_map_add(m,"I don't think entering a house without Vasuki is good idea.","바수키 없이 집에 들어가는 건 좋은 생각이 아닌 것 같아.");
 ds_map_add(m,"Hehe thank you.","헤헤, 고마워.");
 ds_map_add(m,"Bell that is beautiful.","벨, 정말 아름답다.");
 ds_map_add(m,"If I can get it, I could save it from extinction and give a second chance to the island and its people.","그걸 손에 넣으면 멸종을 막고, 섬과 주민들에게 두 번째 기회를 줄 수 있어.");
 ds_map_add(m,"Yes, but when I heard that one of them was still alive I couldn't stop myself from looking for it.","그래. 하지만 그 꽃 중 하나가 아직 살아 있다는 말을 듣고는 찾으러 오지 않을 수 없었어.");
 ds_map_add(m,"So it's just a strange flower? because in this island nowadays everything has aphrodisiacs..","그럼 그냥 이상한 꽃일 뿐이야? 요즘 이 섬에서는 뭐든 최음 효과가 있잖아...");
 ds_map_add(m,"Hehe not really, in ancient times this flower was used for its aphrodisiac properties and because of that the people of the island drove it to extinction.","헤헤, 꼭 그렇지는 않아. 고대에는 이 꽃의 최음 효과 때문에 사용했어. 그 탓에 섬 주민들이 꽃을 멸종시켜 버렸지.");
 ds_map_add(m,"And why are you looking so hard for that flower, does it grant wishes or something?","그런데 그 꽃을 왜 그렇게 열심히 찾는 거야? 소원이라도 들어줘?");
 ds_map_add(m,"Someone must have hidden this path for some reason, maybe the flower is there.","누군가 이유가 있어서 이 길을 숨겼을 거야. 어쩌면 꽃이 안에 있을지도 몰라.");
 ds_map_add(m,"Mmm.. I think I see a path behind the cat tails.","음... 부들 뒤쪽에 길이 있는 것 같아.");
 ds_map_add(m,"Exactly, they shouldn't grow so close together, someone must have planted them there.","맞아. 이렇게 빽빽하게 자랄 리가 없어. 누군가 일부러 심었을 거야.");
 ds_map_add(m,"Yes, there are a many.","그래, 아주 많아.");
 ds_map_add(m,"Line you see those cat tails","라인, 저 부들들 보여?");
 ds_map_add(m,"Lili don't be mean you can fly, besides I have my tights wet :c","릴리, 심술 부리지 마. 넌 날 수 있잖아. 게다가 내 타이츠는 이미 젖었단 말이야 :c.");
 ds_map_add(m,"I do not want to go through all these plants.","이 식물들을 전부 헤치고 지나가고 싶지 않아.");
 ds_map_add(m,"Hey girl! if you want to harvest some mushrooms you better pay to play.","이봐, 아가씨! 버섯을 채집하고 싶으면 참가비부터 내야 해.");
 ds_map_add(m,"Thanks for playing! come and get your Arcs.","게임에 참가해 줘서 고마워! 와서 아크를 받아 가.");
 ds_map_add(m,"OH I almost forgot, since you managed to harvest your first mushroom perfectly, you can keep it.","아, 깜빡할 뻔했네. 첫 버섯을 완벽하게 채집했으니 그건 네가 가져도 돼.");
 ds_map_add(m,"Great wait a second while your opponent arrives.","좋아, 상대가 올 때까지 잠깐 기다려.");
 ds_map_add(m,"The prize for winning is 100 Arcs.","우승 상금은 아크 100개야.");
 ds_map_add(m,"The game ends when one of the contestants makes the opponent pass the boundary line.","참가자 중 한 명이 상대를 경계선 너머로 끌어내면 게임이 끝나.");
 ds_map_add(m,"Once the game starts you must press the button when the bar is at maximum so you will use all your strength to pull the rope.","게임이 시작되면 막대가 최대치에 도달했을 때 버튼을 눌러. 그래야 온 힘을 다해 밧줄을 당길 수 있어.");
 ds_map_add(m,"Hey want to play danglinging-ass-rope? You can play for 50 Arcs.","이봐, 엉덩이 매달기 줄다리기 해 볼래? 참가비는 아크 50개야.");
 ds_map_add(m,"Good luck next time, I look forward to seeing you if you want to play again.","다음엔 행운을 빌게. 다시 하고 싶으면 언제든 찾아와.");
 ds_map_add(m,"Hey to use the onaholes you need a ticket!","이봐, 오나홀을 이용하려면 입장권이 필요해!");
 ds_map_add(m,"Calm lili, but thanks for saying that <3 you are the best fairy a half elf can have.","진정해, 릴리. 그래도 그렇게 말해 줘서 고마워 <3. 넌 반엘프가 가질 수 있는 최고의 요정이야.");
 ds_map_add(m,"A proud half succubus!","자랑스러운 반쪽 서큐버스!");
 ds_map_add(m,"She is a proud half succubus!","그녀는 자랑스러운 반쪽 서큐버스야!");
 ds_map_add(m,"Hey, don't give her money after sex like she's a whore !","이봐! 섹스하고 나서 그녀에게 돈을 주지 마. 창녀 취급하는 것 같잖아!");
 ds_map_add(m,"Keep the money, I have to go now.","돈은 네가 가져. 난 이제 가야 해.");
 ds_map_add(m,"Ohh god I really need that.","아, 세상에. 나 이거 정말 필요했어.");
 ds_map_add(m,"Hi I'm SailorCum just turn around to give you a rimjob.","안녕, 난 세일러컴이야. 엉덩이를 돌려 봐. 애널링구스를 해 줄게.");
 ds_map_add(m,"WHAT ONlY 10 Arcs!? I'm GOING TO KILL YOU DROGITAS!","뭐라고, 고작 아크 10개?! 드로기타스, 너희 다 죽여 버릴 거야!");
 ds_map_add(m,"Ah.. whatever, why not.","아... 뭐, 상관없어. 못 할 것도 없지.");
 ds_map_add(m,"Lili you are a master negotiator. o.O","릴리, 협상의 달인이네. o.O");
 ds_map_add(m,"Virgin of the ears, we will give you 10 arc no more nor less and you must give us a Deviant fruit so Line can grows a penis.","귀만은 처녀인 아가씨, 아크 10개를 주겠어. 한 푼도 더도 덜도 말고. 대신 라인에게 자지가 자라게 할 변이 과일을 줘.");
 ds_map_add(m,"Well, don't you want to use Zoi? to start raising money only 30 Arcs while she is still a virgin.","조이에게 일을 맡기는 건 어때? 아직 처녀일 때 아크 30개만 받고 돈을 벌기 시작하는 거지.");
 ds_map_add(m,"Here you pay with Arcs, seeing the good side at least now you know.","여기선 아크로 결제해. 그래도 좋은 점은, 이제 알게 됐다는 거야.");
 ds_map_add(m,"No wonder they all came to my hole. :c","어쩐지 다들 내 구멍으로 몰려오더라 :c.");
 ds_map_add(m,"The entrance of the town there is a gold mine literally everyone in town has is basically garbage here.","마을 입구에 말 그대로 금광이 있어. 마을 사람들은 누구나 금을 가지고 다녀서, 여기선 사실상 쓰레기나 다름없지.");
 ds_map_add(m,"Explain yourself fairy!!","설명해 봐, 요정!!");
 ds_map_add(m,"Wh-WHAT!?","뭐, 뭐라고!?");
 ds_map_add(m,"Hey I'm sorry to tell you that gold is worth nothing here so you're stranded until you can buy a boat on this island.","안타깝지만 여기서는 금이 아무 가치도 없어. 이 섬에서 배를 살 수 있을 때까지 꼼짝없이 갇혀 있어야 해.");
 ds_map_add(m,"Ohh .. okay but be nice please.","아... 알겠어. 그래도 친절하게 대해 줘.");
 ds_map_add(m,"So you prefer that they make a fool of themselves when buying the boat?","그러니까 배를 살 때 그들이 망신당하는 걸 보고 싶다는 거야?");
 ds_map_add(m,"Do not bother them Lili let's keep going.","방해하지 마, 릴리. 계속 가자.");
 ds_map_add(m,"... Wow, what a dumm ass I will tell her the truth.","... 와, 정말 멍청하네. 내가 진실을 알려 줘야겠어.");
 ds_map_add(m,"Finally we can start our adventure once and for all.","드디어 제대로 모험을 시작할 수 있겠어.");
 ds_map_add(m,"We did it drogitas, we finally have enough gold to buy a boat!","해냈어, 드로기타스! 드디어 배를 살 만큼 금을 모았어!");
 ds_map_add(m,"... You are lucky to be cute Line.","... 귀여워서 다행인 줄 알아, 라인.");
 ds_map_add(m,"I don't think she was a virgin, Lili.","릴리, 난 그녀가 처녀가 아니었던 것 같은데.");
 ds_map_add(m,"DROGITAS!","드로기타스!");
 ds_map_add(m,"New offer a20 arcs since she talks a lot!","새 제안! 말이 너무 많으니 아크 20개!");
 ds_map_add(m,"Hey wait give me a brake that woman left me a little tired.","이봐, 잠깐만. 그 여자가 날 좀 지치게 했어.");
 ds_map_add(m,"New onahole offer at 30 arcs take advantage now that it is still virgin!","신상품 오나홀, 아크 30개! 아직 처녀일 때 서둘러!");
 ds_map_add(m,"Attention everyone!","여러분, 주목해 주세요!");
 ds_map_add(m,"Yeah was great thanks Lili! <3","그래, 정말 좋았어. 고마워, 릴리! <3");
 ds_map_add(m,"So you have fun Line? <3","라인, 즐거웠어? <3");
 ds_map_add(m,"Well that's all and remember I'm not involved in all this so don't you dare come near me!","그게 전부야. 그리고 기억해 둬. 난 이 일과 아무 관련 없어. 그러니 감히 내게 접근하지 마!");
 ds_map_add(m,"Remember they should last 24hrs but even if they lose consciousness you can still go on! and don't worry they have already given their approval.","24시간은 버틸 수 있어야 해. 의식을 잃더라도 계속할 수 있으니 걱정하지 마! 이미 동의도 받았어.");
 ds_map_add(m,"And on the right side, a silver dragon from another dimension, shy but when it comes to fighting, a real beast, and her name is Vasuki!","오른쪽에는 다른 차원에서 온 은룡이 있습니다. 수줍음이 많지만 싸울 때는 진짜 야수죠. 이름은 바수키입니다!");
 ds_map_add(m,"Elf half succubus shy and guess what, she is also a Virgin! (I can't believe I say that)","수줍음 많은 반서큐버스 엘프입니다. 그리고 놀랍게도 아직 처녀랍니다! (내가 이런 말을 하다니 믿을 수가 없군.)");
 ds_map_add(m,"Today we have 2 one of a kind onaholes give a warm welcome to Line!","오늘은 세상에 하나뿐인 오나홀 두 명을 모셨습니다. 라인을 환영해 주세요!");
 ds_map_add(m,"Attention everyone, the 24 hour marathon begins!","여러분, 주목하세요! 24시간 마라톤이 시작됩니다!");
 ds_map_add(m,"yeah yeah whatever.","그래, 그래. 알았어.");
 ds_map_add(m,"It's not like it's a punishment, the money will be collected to pay the women who work here.","벌을 주려는 게 아니야. 여기서 일하는 여성들에게 임금을 지급하려고 돈을 모으는 거지.");
 ds_map_add(m,"Sure, why not.","그래, 좋아. 왜 안 되겠어.");
 ds_map_add(m,"Do you want me to promote the sale of my friends to this band of wankers?","이 자위나 하는 놈들에게 내 친구들을 팔도록 홍보하라는 거야?");
 ds_map_add(m,"Oh and Lili you know a fairy around here is very strange wouldn't you like to be the entertainer?","아, 그리고 릴리. 이 근처에서 요정을 보는 건 아주 드문 일이야. 공연 진행자를 맡아 보는 건 어때?");
 ds_map_add(m,"All right girls get into your poses.","좋아, 아가씨들. 각자 자세를 잡아.");
 ds_map_add(m,"Mmm no nothing Lili let's take vasuki to the house.","음, 아니야. 아무것도 아니야, 릴리. 바수키를 집으로 데려가자.");
 ds_map_add(m,"Something wrong, Line?","무슨 일이야, 라인?");
 ds_map_add(m,"Ah yes and that to...","아, 맞다. 그리고 그것도...");
 ds_map_add(m,"And their dental benefit as well.","치과 혜택도 제공하고.");
 ds_map_add(m,"Mmm yeah... At least she will be happy that all women will get paid.","음, 그래... 적어도 모든 여성이 급여를 받는다는 사실에 그녀도 기뻐하겠지.");
 ds_map_add(m,"Let's take vasuki to the house she is still not awake apparently she was the favorite of the night haha.","바수키를 집으로 데려가자. 아직도 깨어나지 않았어. 하하, 오늘 밤 가장 인기 있었나 봐.");
 ds_map_add(m,"You finally wake up Line..","드디어 깼구나, 라인...");
 ds_map_add(m,"Yes, look for me in the forest south of the hospital I have to prepare some things.","그래. 병원 남쪽 숲에서 날 찾아. 준비할 게 있어.");
 ds_map_add(m,"Really!","정말?!");
 ds_map_add(m,"It may sound crazy but I think I know where she might be.","말도 안 되는 소리처럼 들리겠지만, 그녀가 어디 있을지 알 것 같아.");
 ds_map_add(m,"ehhh, I do not like this but if you can keep it a secret, my friend we are looking for, she is an angel.","으음, 별로 말하고 싶지는 않지만 비밀로 해 준다면 말해 줄게. 우리가 찾는 친구는 천사야.");
 ds_map_add(m,"Line you will have to reveal the truth about Ava otherwise it will take a long time.","라인, 에이바에 관한 진실을 밝혀야 해. 그렇지 않으면 시간이 아주 오래 걸릴 거야.");
 ds_map_add(m,"And filter it by clothing color but it would still be a problem if they did not have their head wings extended they could pass for regular humans.","옷 색깔로도 걸러낼 수 있어. 하지만 머리의 날개를 펼치지 않으면 평범한 인간으로 위장할 수 있다는 문제가 남아.");
