 ds_map_add(m,"Minos","미노스");
 ds_map_add(m,"Futaba","후타바");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","그녀가 바로 후타바야. 믿고 의지할 수 있는 네 후타나리 친구지 :0");
 ds_map_add(m,"Pink Slime","핑크 슬라임");
 ds_map_add(m,"Purple Slime","보라색 슬라임");
 ds_map_add(m,"Orange Slime","주황색 슬라임");
 ds_map_add(m,"Eleneor","엘레노어");
 ds_map_add(m,"Controls","조작 설정");
 ds_map_add(m,"Settings","설정");
 ds_map_add(m,"Natural","원래 모습");
 ds_map_add(m,"Quest complete.","퀘스트 완료.");
 ds_map_add(m,"Use Vodka","보드카 사용");
 ds_map_add(m,"Use Ron","럼 사용");
 ds_map_add(m,"Use Beer","맥주 사용");
 ds_map_add(m,"Use Milch","우유 사용");
 ds_map_add(m,"there no items here yet","아직 여기에 아이템이 없어.");
 ds_map_add(m,"Fish","물고기");
 ds_map_add(m,"it is raw we can not eat it like this Lili, maybe it is better to give it to someone else.","아직 날것이잖아. 릴리, 이렇게는 먹을 수 없어. 다른 사람에게 주는 게 낫겠어.");
 ds_map_add(m,"Circus flyers","서커스 전단지");
 ds_map_add(m,"I have a lot of pamphlets to deliver, hopefully delivering a few will be enough.","전단지가 잔뜩 남았어. 몇 장만 배달해도 충분하면 좋겠는데.");
 ds_map_add(m,"Vodka","보드카");
 ds_map_add(m,"This is my favorite is not that strong <3","내가 제일 좋아하는 술이야. 그렇게 독하지도 않아<3.");
 ds_map_add(m,"Rum","럼");
 ds_map_add(m,"My Mother Always say rum is like men, the older the better. Mmmm maybe that is why she is with my father, elves live for a long time.","엄마는 늘 럼이 남자와 같다고 했어. 오래될수록 좋다고 말이야. 으음… 그래서 엄마가 아빠와 함께 있는 걸까? 엘프는 오래 사니까.");
 ds_map_add(m,"Beer","맥주");
 ds_map_add(m,"Iugg, i do not like beer, the worst thing is that when you go to the bathroom, the pee smells very strong.","으으, 난 맥주가 싫어. 더 최악인 건 화장실에 가면 소변 냄새가 엄청 독하다는 거야.");
 ds_map_add(m,"Magic Broom","마법 빗자루");
 ds_map_add(m,"I love this broom <3, my little feet won't hurt anymore.","이 빗자루 정말 좋아<3. 이제 내 작은 발이 아프지 않겠어.");
 ds_map_add(m,"Tricotex money","트리코텍스 화폐");
 ds_map_add(m,"Sam gave me this money, it is 10 dollars to use in Tricotex. I will keep it, who knows if i ever pass by.","샘이 이 돈을 줬어. 트리코텍스에서 쓸 수 있는 10달러야. 언젠가 그곳에 갈지도 모르니 잘 보관해 둬야겠어.");
 ds_map_add(m,"Autographed photo of Sam","샘의 사인 사진");
 ds_map_add(m,"I still can not believe Sam gave me a picture with his autograph <3.","샘이 사인까지 한 사진을 줬다니 아직도 믿기지 않아<3.");
 ds_map_add(m,"BDSM Master/Slave Contract","BDSM 주인／노예 계약서");
 ds_map_add(m,"My contract with Lili, because of my problems I begged her to be my master and help me to practice my succubus powers and force me to try new things <3.","릴리와 맺은 계약서야. 내 문제 때문에 릴리에게 주인이 되어 달라고 애원했어. 서큐버스의 힘을 익히는 걸 도와주고, 새로운 것들을 시도하도록 강요해 달라고 말이야<3.");
 ds_map_add(m,"Raspberry pie","라즈베리 파이");
 ds_map_add(m,"I am supposed to recognize the scent of this foot and then guide me through the forest to Marael's house.","이 발의 냄새를 기억한 다음, 그 냄새를 따라 숲을 지나 마라엘의 집으로 가야 해.");
 ds_map_add(m,"Haigure Gun!","하이구레 건!");
 ds_map_add(m,"This gun makes move in a very vulgar way, Just the thought of people watching me, moving uncontrollably while I make a fool of myself makes me so horny.","이 총에 맞으면 아주 외설적인 춤을 추게 돼. 사람들이 지켜보는 앞에서 내 의지와 상관없이 몸을 흔들며 망신당한다고 생각만 해도 너무 흥분돼.");
 ds_map_add(m,"Holy Grail","성배");
 ds_map_add(m,"One of the relics of the islands. I can feel energy emanating from it.","섬에 있는 성유물 중 하나야. 여기서 에너지가 뿜어져 나오는 게 느껴져.");
 ds_map_add(m,"Crystal sphere","수정 구슬");
 ds_map_add(m,"I found this half buried next to some cats, it looks like something valuable, maybe it will be useful for something.","고양이 몇 마리 옆에서 반쯤 묻힌 채 발견했어. 값나가는 물건처럼 보이는데, 어쩌면 쓸모가 있을지도 몰라.");
 ds_map_add(m,"Oniric incense","몽환 향");
 ds_map_add(m,"This is the best thing in the world! If I use it before I go to sleep I can have lucid dreams of things that happened to me <3.","세상에서 제일 좋은 물건이야! 잠들기 전에 사용하면 예전에 겪었던 일을 선명한 자각몽으로 다시 볼 수 있어<3.");
 ds_map_add(m,"Gilfried briefcase","길프리드의 서류 가방");
 ds_map_add(m,"I have to return this briefcase to Gilfried immediately.","이 서류 가방은 당장 길프리드에게 돌려줘야 해.");
 ds_map_add(m,"Golden Key","황금 열쇠");
 ds_map_add(m,"There is something strange about this key, I feel like it takes my energy somehow.","이 열쇠는 뭔가 이상해. 어쩐지 내 기운을 빨아들이는 것 같아.");
 ds_map_add(m,"Smoosher uniforms","스무셔 유니폼");
 ds_map_add(m,"The uniform of the Smoosher restaurant smells a little funny.","스무셔 레스토랑 유니폼이야. 냄새가 조금 묘해.");
 ds_map_add(m,"Aphrodisiac mushroom.","최음 버섯");
 ds_map_add(m,"Moo Premium Milk","무 프리미엄 우유");
 ds_map_add(m,"Fura Fura Fruit","후라후라 열매");
 ds_map_add(m,"The fura fura fruit has the effect of creating a penis if eaten by a woman.","여성이 후라후라 열매를 먹으면 음경이 생겨.");
 ds_map_add(m,"Hea Hea Fruit","헤아헤아 열매");
 ds_map_add(m,"The hea hea fruit has a very powerful aphrodisiac effect that will make anyone who eats it come into heat.","헤아헤아 열매는 최음 효과가 아주 강해서 먹는 사람은 누구든 발정하게 돼.");
 ds_map_add(m,"Smuggled fabrics","밀수 원단");
 ds_map_add(m,"I understand there was a convict who wanted to sell this, they ended up taking it from her and reselling it themselves (speaking of irony).","이걸 팔려던 죄수가 있었다고 들었어. 결국 그 사람에게서 빼앗은 뒤 자기들이 다시 팔았다더라. 참 아이러니하지.");
 ds_map_add(m,"Sewing machine","재봉틀");
 ds_map_add(m,"Blue crystal key","푸른 수정 열쇠");
 ds_map_add(m,"It is a key that was found inside a strange slime.","이상한 슬라임의 몸속에서 발견된 열쇠야.");
 ds_map_add(m,"Purple crystal key","보라 수정 열쇠");
 ds_map_add(m,"Pink crystal key","분홍 수정 열쇠");
 ds_map_add(m,"Cum jar","정액 병");
 ds_map_add(m,"Ñom yum yum it looks delicious I will let it ripen a bit before eating <3.","냠냠, 맛있어 보인다! 먹기 전에 조금 더 숙성시켜야겠어<3.");
 ds_map_add(m,"Elf Gloves","엘프 장갑");
 ds_map_add(m,"Elf Boots","엘프 부츠");
 ds_map_add(m,"Elf Leotard","엘프 레오타드");
 ds_map_add(m,"Elf Tank Top","엘프 민소매 상의");
 ds_map_add(m,"Elf Tights","엘프 타이츠");
 ds_map_add(m,"Elf Panties","엘프 팬티");
 ds_map_add(m,"Limbo Leotard","림보 레오타드");
 ds_map_add(m,"Limbo Boots","림보 부츠");
 ds_map_add(m,"Lilium","백합");
 ds_map_add(m,"Cow Bras","암소 브래지어");
 ds_map_add(m,"Cow Stockings","암소 스타킹");
 ds_map_add(m,"Cow Bell","암소 방울");
 ds_map_add(m,"Cow Panties","암소 팬티");
 ds_map_add(m,"OH Bunny Heels","OH 버니 하이힐");
 ds_map_add(m,"OH Bunny Tights","OH 버니 타이츠");
 ds_map_add(m,"OH Bunny Top","OH 버니 상의");
 ds_map_add(m,"OH Bunny Ears","OH 버니 귀");
 ds_map_add(m,"Face Mask","얼굴 마스크");
 ds_map_add(m,"Cat Ears","고양이 귀");
 ds_map_add(m,"Knight Chain Mail","기사 사슬 갑옷");
 ds_map_add(m,"Knight Boots","기사 부츠");
 ds_map_add(m,"Knight Gloves","기사 장갑");
 ds_map_add(m,"The Perverted Coat","음란한 코트");
 ds_map_add(m,"Haigure Leotard","하이구레 레오타드");
 ds_map_add(m,"Limbo Gloves","림보 장갑");
 ds_map_add(m,"Smoosher-T-Shirt","스무셔 티셔츠");
 ds_map_add(m,"Smoosher Shorts","스무셔 반바지");
 ds_map_add(m,"Dark Greaves","암흑 각반");
 ds_map_add(m,"Dark Tiara","암흑 티아라");
 ds_map_add(m,"FurrHead","퍼슈트 머리");
 ds_map_add(m,"FurrTop","퍼슈트 상의");
 ds_map_add(m,"FurrPants","퍼슈트 바지");
 ds_map_add(m,"FurrBoots","퍼슈트 부츠");
 ds_map_add(m,"Nun Hat","수녀 모자");
 ds_map_add(m,"Nun Dress","수녀복");
 ds_map_add(m,"Nun Socks","수녀 양말");
 ds_map_add(m,"Nun Boots","수녀 부츠");
 ds_map_add(m,"Pelletclad Blade","펠릿클래드 블레이드");
 ds_map_add(m,"Place Holder Quest","자리 표시용 퀘스트");
 ds_map_add(m,"Finally, you muster the courage to embark on an adventure with your fairy familiar to find and bring back your childhood best friend.","마침내 요정 사역마와 함께 모험을 떠날 용기를 냈어. 어린 시절 가장 친했던 친구를 찾아 데려오기 위해서야.");
 ds_map_add(m,"Check the cat woman's shop; there might be something that interests you.","고양이 여인의 가게를 살펴봐. 마음에 드는 물건이 있을지도 몰라.");
 ds_map_add(m,"The cat woman who runs the shop is somewhat grumpy because she hasn't had the chance to eat lunch.","가게 주인인 고양이 여인는 점심을 먹을 틈이 없어서 조금 짜증이 나 있어.");
 ds_map_add(m,"You managed to read the sinful thoughts of the fisherman. Perhaps this is your chance to explore your powers.","어부의 음흉한 속마음을 읽는 데 성공했어. 어쩌면 이 기회에 네 능력을 시험해 볼 수 있겠어.");
 ds_map_add(m,"Lili pushes you to be more proactive in training your succubus powers, so she sends you to try to seduce the cat woman who runs the shop. It should be easier since you know her.","릴리는 네가 서큐버스의 힘을 더 적극적으로 훈련하길 바라며, 가게 주인인 고양이 여인를 유혹해 보라고 해. 이미 아는 사이니 좀 더 쉬울 거야.");
 ds_map_add(m,"There is a high-rank demon who has been stealing alcohol shipments. You decide to find and defeat her to see if you can get information about Ava.","높은 계급의 악마가 술을 실은 화물을 계속 훔치고 있어. 그녀를 찾아 쓰러뜨리고, 에이바에 관한 정보를 얻을 수 있는지 알아보기로 했어.");
 ds_map_add(m,"You're very lucky! You recognized one of the women who appeared in your mother's XXX magazines! She says she'll give you a special service for old times' sake.","정말 운이 좋네! 엄마의 XXX 잡지에 나왔던 여자 중 한 명을 알아봤어! 그녀는 옛정을 생각해서 특별 서비스를 해 주겠대.");
 ds_map_add(m,"You found a woman with violet pigtails at the corner of the bar. She says she can lend you money, but you must pay her back with an additional ten percent.","술집 구석에서 보라색 양갈래 머리를 한 여자를 발견했어. 돈을 빌려줄 수 있지만, 갚을 때 원금에 10퍼센트를 더 얹어야 한대.");
 ds_map_add(m,"There's a cat woman playing very mean pranks on the villagers, and they're blaming Callie's daughter. Find the real culprit and save Callie's daughter!","마을 사람들에게 심한 장난을 치는 고양이 여인가 있어. 그런데 모두 캘리의 딸을 범인으로 몰고 있지. 진짜 범인을 찾아 캘리의 딸을 구해 줘!");
 ds_map_add(m,"The plant woman from the shop told you she's very thirsty, and Lili suggested buying her beer to see if she'll give you discounts while drunk.","가게의 식물 여인가 목이 몹시 마르다고 했어. 릴리는 맥주를 사다 주고 취했을 때 할인을 받을 수 있는지 보자고 제안했어.");
 ds_map_add(m,"A dragon woman fell from the sky among the prisoners and seems to be fighting to prevent a crystal from being stolen. Lili suggests we help her; maybe they'll reward us with something valuable.","용의 여자가 하늘에서 죄수들 사이로 떨어졌어. 누군가 수정 하나를 훔치려는 걸 막으려고 싸우는 것 같아. 릴리는 도와주자고 해. 값진 보답을 받을지도 모르잖아.");
 ds_map_add(m,"There's a strange woman with pink hair hiding in a corner of the circus. Find out why people are talking about her.","서커스 구석에 분홍 머리의 수상한 여자가 숨어 있어. 사람들이 왜 그녀 이야기를 하는지 알아봐.");
 ds_map_add(m,"You found your favorite heroine! Sam, the protector of Tricotex. Prove that you have what it takes to embark on a capture mission with her.","네가 가장 좋아하는 여주인공을 찾았어! 트리코텍스의 수호자, 샘이야. 그녀와 함께 포획 임무를 떠날 자격이 있다는 걸 증명해 봐.");
 ds_map_add(m,"Someone is impersonating a knight of Elira to scam people. Catch them and be the heroine you always wanted to be!","누군가 사람들을 속이려고 엘리라의 기사를 사칭하고 있어. 그자를 붙잡고, 늘 꿈꾸던 여주인공이 되어 봐!");
 ds_map_add(m,"Kristoff, a VIP customer at the bar, is very angry and asks if you can buy him some premium cigarettes to help him calm down.","술집의 VIP 손님인 크리스토프가 몹시 화가 나 있어. 진정할 수 있게 고급 담배를 사다 줄 수 있냐고 묻네.");
 ds_map_add(m,"The hotel secretary informs you that you've caught the attention of a woman who will be waiting for you on the top floor of the hotel. Hmm, what could she want? It might be important.","호텔 직원이 네게 한 여자의 눈에 들었다고 알려 줬어. 그녀는 호텔 최상층에서 널 기다린대. 흠, 무슨 용건일까? 중요한 일일지도 몰라.");
 ds_map_add(m,"You've become a minion of a seemingly powerful individual! They order you to bring the dimensional fracture, which looks like a floating crystal, to leave this dimension.","겉보기엔 꽤 강력해 보이는 인물의 부하가 되어 버렸어! 그자는 이 차원을 떠날 수 있도록 떠다니는 수정처럼 생긴 차원 균열을 가져오라고 명령해.");
 ds_map_add(m,"There was a collapse in the cave, leaving many miners trapped. Wait until the knight of Elira clears the passage.","동굴이 무너져 많은 광부가 안에 갇혔어. 엘리라의 기사가 통로를 치울 때까지 기다려.");
 ds_map_add(m,"There are some rumors of strange sounds coming from the Silent Forest at night. What could it be?","밤마다 고요한 숲에서 이상한 소리가 들린다는 소문이 있어. 대체 뭘까?");
 ds_map_add(m,"An Onahole is desperate to buy a boat and is selling her body to do so. As an act of charity, help her.","배를 사려고 안달 난 오나홀이 그 돈을 마련하려고 몸을 팔고 있어. 선행이라 생각하고 도와주자.");
 ds_map_add(m,"Ivy, a honey slime, recognizes you as an adventurer who helps people and asks if you can help her find a part of herself that hasn't returned.","꿀 슬라임 아이비가 널 사람들을 돕는 모험가로 알아보고, 아직 돌아오지 않은 자기 몸의 일부를 찾는 걸 도와줄 수 있냐고 물어봐.");
 ds_map_add(m,"You heard the Grand Captain of the Elira Guards arguing with a woman about the ineptitude of the knights. Maybe if you help them, they can assist you in your quest.","엘리라 경비대의 대장이 기사들의 무능함을 두고 한 여자와 다투는 걸 들었어. 그들을 도와주면 네 모험에도 도움을 받을 수 있을지 몰라.");
 ds_map_add(m,"You encountered Faye, a space-dimensional traveler trapped in your dimension. You decided to help her because you felt sorry for her.","차원 여행자 페이를 만났어. 그녀는 다른 차원에서 왔다가 이곳에 갇혔지. 불쌍한 마음이 들어 도와주기로 했어.");
 ds_map_add(m,"Vasuki tells you that something bad is happening at the mushroom house in the magenta swamp. Upon investigating, it seems that there may be human trafficking and drug activities occurring there.","바수키가 마젠타 늪의 버섯집에서 좋지 않은 일이 벌어지고 있다고 알려 줬어. 조사해 보니 인신매매와 마약 거래가 이루어지고 있는 것 같아.");
 ds_map_add(m,"You found someone smelling the flowers, but as soon as you spoke to them, they attacked you. Find out what's really going on!","꽃향기를 맡고 있는 사람을 발견했는데, 말을 걸자마자 공격해 왔어. 무슨 일이 벌어지고 있는지 밝혀내!");
 ds_map_add(m,"There's something about Marael that doesn't quite convince you. Look into what she's really hiding.","마라엘에게 뭔가 석연치 않은 구석이 있어. 그녀가 진짜로 숨기는 게 뭔지 조사해 봐.");
 ds_map_add(m,"A letter addressed to Marael gives you clues that a woman named Willow also contacted Ava. Look for her to gather more information.","마라엘 앞으로 온 편지에서 윌로라는 여자도 에이바와 연락했다는 단서를 찾았어. 더 많은 정보를 얻으려면 그녀를 찾아봐.");
 ds_map_add(m,"There's a bard woman looking for an adventurer to inspire her. Show her that you're a worthy adventurer capable of inspiring others!","영감을 줄 모험가를 찾는 여성 음유시인이 있어. 다른 이들에게 영감을 줄 만한 훌륭한 모험가라는 걸 보여 줘!");
 ds_map_add(m,"After being attacked by a pervert who opened his leather coat and showed you everything, something awakened inside of you.","가죽 코트를 열어젖히고 알몸을 보여 준 변태에게 습격당한 뒤, 네 안에서 무언가가 깨어났어.");
 ds_map_add(m,"The island is cordoned off because someone stole the relics from the church. As part of the deal to stay on the island, you agree to help the knights of Elira search for the relics.","누군가 교회의 성유물을 훔쳐 섬 전체가 봉쇄됐어. 섬에 머무르는 조건으로 엘리라의 기사들이 성유물을 찾는 일을 돕기로 했어.");
 ds_map_add(m,"An Onahole stuck to the wall in the VIP area of the bar tells you that if you buy her entire outfit, she'll give you a rimjob!","술집 VIP 구역 벽에 붙어 있는 오나홀이 말해. 자기 옷을 전부 사 주면 네게 리밍을 해 주겠대!");
 ds_map_add(m,"Lili says you're very stinky and need a bath.","릴리가 네 몸에서 악취가 난다며 목욕을 해야 한다고 했어.");
 ds_map_add(m,"The librarian is lost, and no one knows where she is. Look for her, and perhaps you'll find more information about the people who go missing on the island.","도서관 사서가 실종됐고, 어디 있는지 아는 사람이 없어. 그녀를 찾아봐. 어쩌면 섬에서 사라진 사람들에 관한 정보도 얻을 수 있을 거야.");
 ds_map_add(m,"Gildfried, a businessman on vacation on the island, unfortunately lost his briefcase, which is very important to him.","섬에서 휴가를 보내던 사업가 길드프리드가 안타깝게도 자신에게 매우 중요한 서류 가방을 잃어버렸어.");
 ds_map_add(m,"Lemmy, a green monster outside an automated carriage, talks to Lili and asks for help because his mistress is having trouble.","자동 마차 밖에 있는 초록색 괴물 레미가 릴리에게 말을 걸어. 자기 여주인에게 문제가 생겼다며 도움을 청하네.");
 ds_map_add(m,"Sakura is working at the renowned fast food restaurant Smooshers! She asks for your help in searching for the lost uniforms.","사쿠라는 유명한 패스트푸드점 스무셔스에서 일하고 있어! 잃어버린 유니폼을 찾는 일을 도와 달래.");
 ds_map_add(m,"One of Vasera's clones has gained autonomy. Vasera will go search for it and neutralize it. She advises you to kill it if you encounter it.","바세라의 복제체 하나가 자아를 갖게 됐어. 바세라는 그 복제체를 찾아 제거하러 갈 거야. 마주치면 죽이라고 충고했어.");
 ds_map_add(m,"Sieki got angry with you because even though she already paid the debt to MsHonney, you're still in the VIP area. Now you follow her orders to avoid making her angrier.","허니 부인에게 진 빚은 시에키가 이미 대신 갚아 줬는데도 네가 VIP 구역에 계속 머물러서 화가 났어. 더 화나게 만들지 않으려면 이제 그녀의 지시를 따라야 해.");
 ds_map_add(m,"The farmer confesses that she would like to work with less clothing. How could you help her work more comfortably?","농부가 옷을 덜 입고 일하고 싶다고 털어놨어. 어떻게 하면 더 편하게 일하도록 도와줄 수 있을까?");
 ds_map_add(m,"The fortune teller confessed to you that she would like to have a red crystal orb because with it she could see her own future.","점쟁이는 붉은 수정 구슬만 있으면 자신의 미래를 볼 수 있다며, 그걸 갖고 싶다고 털어놨어.");
 ds_map_add(m,"The water nymph who works at the bar is looking for love but is insecure because she doesn't know if people approach her for the beer or if they genuinely want something with her.","술집에서 일하는 물의 요정은 사랑을 찾고 있지만 자신감이 없어. 사람들이 맥주 때문에 다가오는 건지, 정말 자신에게 마음이 있는 건지 모르겠대.");
 ds_map_add(m,"Accidentally, you ruin Naoki's concoction just as he's entering mating season, so you decide to help him.","실수로 나오키의 약을 망가뜨렸는데, 하필 그가 발정기에 접어들려던 참이었어. 그래서 도와주기로 했어.");
 ds_map_add(m,"Lucy the bard is having trouble with an Onahole, so you decide to help her with whatever she needs.","음유시인 루시는 오나홀 때문에 곤란을 겪고 있어. 필요한 게 뭐든 도와주기로 했어.");
 ds_map_add(m,"There are portals for self-satisfaction in the VIP area of the bar, but a witch won't let you use them.","술집 VIP 구역에는 혼자 즐길 수 있는 포털이 있지만, 마녀 한 명이 사용하지 못하게 막고 있어.");
 ds_map_add(m,"Sieki has a big problem and makes you a deal you can't refuse: you just have to attend to the clients in the VIP area while she's away, and you'll become a VIP customer.","시에키에게 큰 문제가 생겼고, 거절할 수 없는 거래를 제안했어. 그녀가 자리를 비운 동안 VIP 구역의 손님들을 접대하기만 하면 VIP 고객이 될 수 있대.");
 ds_map_add(m,"A hospital robot offers anal cleaning services for just three thousand Arcs. It's not a bad idea to keep clean every now and then.","병원 로봇이 단돈 3,000아크에 항문 세척 서비스를 제공해. 가끔 깨끗하게 관리해 두는 것도 나쁘지 않겠어.");
 ds_map_add(m,"A story you read in the library seems strange to you, so you decide to look for more information about it.","도서관에서 읽은 이야기가 어딘가 이상하게 느껴져서 더 많은 정보를 찾아보기로 했어.");
 ds_map_add(m,"There's a guy offering his services to make fursuits, which catches your attention, so you decide to save up for one.","퍼슈트를 제작해 주겠다는 남자가 있어. 마음에 들어서 돈을 모아 한 벌 마련하기로 했어.");
 ds_map_add(m,"There's an Onahole that has the same tone as you, which strangely excites you.","너와 피부색이 똑같은 오나홀이 있어. 이상하게도 그게 흥분돼.");
 ds_map_add(m,"In a nightclub, you find two gothic girls with big butts dancing, something you can't let pass in your life.","나이트클럽에서 엉덩이가 큰 고딕풍 여자 둘이 춤추는 걸 봤어. 이런 기회를 인생에서 놓칠 순 없지.");
 ds_map_add(m,"Upon entering the usually closed public restroom, you find an idol vomiting, with many people screaming and demanding the show. What could be happening?","평소에는 닫혀 있는 공중화장실에 들어갔더니 아이돌이 토하고 있었어. 밖에서는 사람들이 소리를 지르며 공연을 요구하고 있네. 대체 무슨 일이지?");
 ds_map_add(m,"There is a proliferation of slimes attacking and kidnapping women. Do your best to help and get to the bottom of this!","슬라임이 떼로 나타나 여성들을 공격하고 납치하고 있어. 최선을 다해 도와주고 사건의 전말을 밝혀내!");
 ds_map_add(m,"A being living in the pond enters Line's mind and psychologically strips her bare with questions she's not prepared to hear or face.","연못에 사는 존재가 라인의 정신 속으로 들어와, 그녀가 들을 준비도 마주할 준비도 되지 않은 질문을 던지며 마음속을 샅샅이 파헤쳐.");
 ds_map_add(m,"You don't know what's happening; you have mental gaps, and days and nights seem to pass in seconds.","무슨 일이 벌어지는지 모르겠어. 기억이 군데군데 비고, 낮과 밤이 몇 초 만에 지나가는 것 같아.");
 ds_map_add(m,"You have committed serious mistakes that haunt you at night, so you decide to confess to expiate your sins.","밤마다 널 괴롭히는 심각한 잘못을 저질렀어. 죄를 씻기 위해 고해성사를 하기로 했어.");
 ds_map_add(m,"Callie invites you to meet her family, which seems more serious than what you're looking for, but it would be rude not to go.","캘리가 가족을 만나러 오라고 초대했어. 네가 생각하는 것보다 진지한 관계가 될 것 같지만, 안 가면 무례하겠지.");
 ds_map_add(m,"You found a place that can serve you for sleeping while you investigate the island.","섬을 조사하는 동안 잠을 자고 쉴 수 있는 장소를 찾았어.");
 ds_map_add(m,"You need more power, so you beg Marael to help you unlock your succubus powers.","더 강한 힘이 필요해. 그래서 마라엘에게 서큐버스의 힘을 해방하도록 도와 달라고 간청했어.");
 ds_map_add(m,"The thieves on the island aren't just any criminals; they were actually stealing to maintain an orphanage, without which everything would collapse.","섬의 도둑들은 평범한 범죄자가 아니었어. 고아원을 유지하려고 물건을 훔쳤던 거야. 그들이 없었다면 모든 게 무너졌을 거야.");
 ds_map_add(m,"You met Futaba your trusted futanari in the forest, what could she be doing?","숲에서 믿음직한 후타나리 친구 후타바를 만났어. 여기서 뭘 하고 있는 걸까?");
 ds_map_add(m,"The barn is very busy due to the issues happening on the island. Help them however you can so that the barn can open.","섬에서 벌어진 여러 사건 때문에 헛간이 무척 바빠졌어. 헛간이 다시 문을 열 수 있도록 할 수 있는 만큼 도와줘.");
 ds_map_add(m,"Rynn is frustrated because the last fight with you didn't end, so she challenges you to a beer drinking duel.","지난번 싸움이 끝나지 않은 게 불만인 린이 맥주 마시기 대결을 신청했어.");
 ds_map_add(m,"Lili is angry with Line because she believes Line is completely ignorant about sex, and challenges her to a competition to see who is the better onahole.","릴리는 라인이 섹스에 대해 아무것도 모른다고 생각해서 화가 났어. 누가 더 훌륭한 오나홀인지 겨뤄 보자며 대결을 신청했지.");
 ds_map_add(m,"The milk on this island has very strange properties.","이 섬의 우유에는 아주 기묘한 효능이 있어.");
 ds_map_add(m,"A fat ugly bastard bothering Rynn at the bar he leaves but you can't stop thinking about him.","술집에서 뚱뚱하고 못생긴 개자식이 린을 귀찮게 굴다가 떠났어. 그런데도 넌 그 남자가 계속 머릿속에서 떠나지 않아.");
