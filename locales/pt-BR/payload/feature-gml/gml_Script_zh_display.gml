 ds_map_add(m,"Line ask the bartender if she knows where we can buy premium cigarettes.","Line, pergunte à bartender se ela sabe onde podemos comprar cigarros premium.");
 ds_map_add(m,"OHh, Hi, mmm  I Have to go now, ehh sorry.","Ahh, oi... mmm, preciso ir agora. É... desculpe.");
 ds_map_add(m,"To the lady over there.","Para aquela senhora ali.");
 ds_map_add(m,"What! to whom?","O quê? Para quem?");
 ds_map_add(m,"I'm sorry, but this product has already been sold.","Desculpe, mas este produto já foi vendido.");
 ds_map_add(m,"You have to be kidding me.","Você só pode estar brincando.");
 ds_map_add(m,"... Shit, and how much does it cost?","... Merda, e quanto custa?");
 ds_map_add(m,"My boss warned me this would happen and told me to remind you of the deals you have whit her, so leave the coat here or buy it.","Meu chefe me avisou que isso poderia acontecer e mandou lembrar você do acordo que tem com ela. Então deixe o casaco aqui ou compre-o.");
 ds_map_add(m,"What are you talking about, you know that by law you must give me the coat?!","Do que está falando? Você sabe que, por lei, precisa me entregar o casaco?!");
 ds_map_add(m,"Sorry but it is now our property, if you want to have it you can buy it.","Desculpe, mas agora ele é nossa propriedade. Se quiser ficar com ele, pode comprá-lo.");
 ds_map_add(m,"Aqua you have to give me that coat is evidence of a case of moral indecency","Aqua, você precisa me entregar esse casaco. Ele é prova de um caso de indecência moral.");
 ds_map_add(m,"Ohhhh... jeez okay :c.","Ahhhh... caramba, está bem :c.");
 ds_map_add(m,"My pride is on the line.","Meu orgulho está em jogo.");
 ds_map_add(m,"Let's drink and the first one to fall unconscious loses.","Vamos beber. Quem desmaiar primeiro perde.");
 ds_map_add(m,"I'm not in the mood for jokes now sit down.","Não estou com vontade de brincadeiras. Sente-se.");
