 ds_map_add(m,"What are you doing?!.","O que você está fazendo?!");
 ds_map_add(m,"The three of them managed to get every little mound of dust off the second floor.","As três conseguiram tirar até o menor montinho de poeira do segundo andar.");
 ds_map_add(m,"After 15 minutes of thorough cleaning.","Depois de 15 minutos de limpeza minuciosa.");
 ds_map_add(m,"The three of them start cleaning.","As três começam a limpar.");
 ds_map_add(m,"Yes, whatever I can clean in the small spaces.","Sim, posso limpar até os cantinhos mais apertados.");
