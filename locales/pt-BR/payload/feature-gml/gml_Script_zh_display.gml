 ds_map_add(m,"I knew with the money you spent coming to see me I knew you were a vip!","Eu sabia! Pelo dinheiro que você gastou para vir me ver, percebi que era uma cliente VIP!");
 ds_map_add(m,"( Ahg, I'll have to use my reserve energy to grow in size otherwise I won't be able to win... shit I never thought I'd use it in something like this )","(Ah, merda. Vou ter que usar minha energia reserva para aumentar de tamanho, senão não vou conseguir vencer... Nunca pensei que fosse usá-la numa coisa dessas.)");
