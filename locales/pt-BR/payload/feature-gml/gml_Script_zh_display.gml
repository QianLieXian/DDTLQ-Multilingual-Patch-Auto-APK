 ds_map_add(m,"Line you dirty slut, you made me wait here while I hear you say, yes mommy I love you and stuff and you ask me what I'm waiting for?","Line, sua vadia imunda! Você me deixou esperando aqui enquanto eu ouvia você dizendo 'sim, mamãe, eu te amo' e coisas do tipo, e ainda me pergunta o que estou esperando?");
 ds_map_add(m,"Mmm, and what are you waiting for?","Mmm, e o que você está esperando?");
 ds_map_add(m,"Yeah,I'll be waiting for you there.","Sim, vou esperar você lá.");
