 ds_map_add(m,"A wena :D.","Boa :D.");
 ds_map_add(m,"Wena cochino larry.","Wena, seu safado, Larry.");
 ds_map_add(m,"Why is this girl taking so long?","Por que essa garota está demorando tanto?");
 ds_map_add(m,"Oh, cutie I can upgrade a block of hearts every so often on the grid in addition to doing some cut damage.","Ah, fofinha, de vez em quando posso aprimorar um cubo de coração no tabuleiro, além de causar um pouco de dano de corte.");
 ds_map_add(m,"No but, could you tell me again how you fight?","Não, mas você poderia me explicar de novo como luta?");
 ds_map_add(m,"No right now actually.","Agora não, na verdade.");
 ds_map_add(m,"Yes Big sis <3!","Sim, mana-irmã <3!");
 ds_map_add(m,"You want a little break cutie","Quer fazer uma pequena pausa, fofinha?");
 ds_map_add(m,"No thanks, could you tell me again how you fight?","Não, obrigada. Pode me explicar de novo como luta?");
 ds_map_add(m,"Sorry big sis not rigt now.","Desculpe, mana-irmã, agora não.");
 ds_map_add(m,"Yes, Big Sis.","Sim, mana-irmã.");
 ds_map_add(m,"Do you want me to help you in battles?","Quer que eu ajude você nas batalhas?");
 ds_map_add(m,"So do your best Line <3.","Então dê o seu melhor, Line <3.");
 ds_map_add(m,"A training battle will do.","Uma batalha de treino já serve.");
 ds_map_add(m,"First of all I need to see your current status as a succubus in a more precise way.","Primeiro, preciso avaliar com mais precisão seu estado atual como súcubo.");
 ds_map_add(m,"So how do we start?","Então, por onde começamos?");
 ds_map_add(m,"Well said! <3","Bem dito! <3");
 ds_map_add(m,"I know .. I guess it will hurt my mother if I never get better as a succubus.","Eu sei... Acho que minha mãe ficaria triste se eu nunca melhorasse como súcubo.");
 ds_map_add(m,"But line, beautiful, it is your culture we gain power and energy having sex, you must start thinking about yourself.","Mas, Line, querida, faz parte da sua natureza: ganhamos poder e energia fazendo sexo. Você precisa começar a pensar em si mesma.");
 ds_map_add(m,"And my father is a very respectable elf. What would he think of me, I don't want to hurt him?","E meu pai é um elfo muito respeitado. O que ele pensaria de mim? Não quero magoá-lo.");
 ds_map_add(m,"But I was always such a shy girl, that I never asked my mother to teach me.","Mas sempre fui tão tímida que nunca pedi à minha mãe que me ensinasse.");
 ds_map_add(m,"I ... I want to be a better succubus","Eu... quero me tornar uma súcubo melhor.");
 ds_map_add(m,"hey quiet fairy, I just want to teach your friend some tricks so that she is a little more prepared for the world.","Ei, fada, quietinha. Só quero ensinar alguns truques à sua amiga para que ela esteja um pouco mais preparada para o mundo.");
 ds_map_add(m,"Hey! What's wrong? Line is a great succubus!","Ei! Qual é o problema? Line é uma ótima súcubo!");
 ds_map_add(m,"You are a succubus but I see that you have a long way to go, your power is minimal compared to others.","Você é uma súcubo, mas ainda tem um longo caminho pela frente. Seu poder é mínimo comparado ao das outras.");
 ds_map_add(m,"Help me with what?","Me ajudar com o quê?");
 ds_map_add(m,"I made this little meeting to help you.","Organizei este pequeno encontro para ajudar você.");
 ds_map_add(m,"Why did you want to see me?","Por que você queria me ver?");
 ds_map_add(m,"Mmm?( this woman does not give me confidence )","Hmm? (Essa mulher não me passa confiança.)");
 ds_map_add(m,"If only you knew what I was my little fairy.","Quem me dera você soubesse o que eu já fui, minha fadinha.");
 ds_map_add(m,"How do you know who Line is and what she is?","Como você sabe quem é Line e o que ela é?");
 ds_map_add(m,"Oh.. thanks hehe.","Ah... obrigada, hehe.");
 ds_map_add(m,"Yes, and you are a cute little half succubus you right Line.","Sim, e você é uma adorável meio-súcubo, não é, Line?");
 ds_map_add(m,"E-excuse me, did you leave a message to the receptionist for me?","C-com licença, você deixou um recado para mim na recepção?");
 ds_map_add(m,"Come on Line try again I need to know better your current state I know you can do more.","Vamos, Line, tente de novo. Preciso entender melhor seu estado atual. Sei que você consegue fazer mais.");
 ds_map_add(m,"Just give me one second.","Espere só um segundo.");
 ds_map_add(m,"Mmmm... Hehe ok big Sis I will do my best <3","Hmm... hehe, está bem, mana-irmã. Vou dar o meu melhor <3");
 ds_map_add(m,"Great Line you already know something about the case more than I do find them and I'll give you a prize Tehehehe.","Ótimo, Line. Você já sabe mais sobre o caso do que eu. Encontre-as e vou lhe dar um prêmio, hehehe.");
 ds_map_add(m,"I already know that story.","Já conheço essa história.");
 ds_map_add(m,"A Slime Cat is apparently stealing it.","Parece que uma Gata Slime está roubando as roupas.");
 ds_map_add(m,"Well, if you want me to help Line become a better succubus, first help me recover the clothes from the restaurant.","Se quer que eu ajude Line a se tornar uma súcubo melhor, primeiro me ajude a recuperar as roupas do restaurante.");
 ds_map_add(m,"The truth is that I do know but I hope you don't do it simply because it's moral 101.","Na verdade, eu sei, mas espero que você não faça isso apenas porque é o mínimo de decência.");
 ds_map_add(m,"It's for the greater good plus I eat well here if you know what I mean.","É pelo bem de todos. Além disso, como você sabe, sou bem alimentada por aqui.");
 ds_map_add(m,"Oh, don't get mad, I'm working so I don't always sleep in that pigsty you call a house.","Ah, não fique brava. Estou trabalhando para não precisar dormir sempre naquele chiqueiro que você chama de casa.");
 ds_map_add(m,"I mean, weren't you supposed to help Line become a better succubus or something?","Não era para você me ajudar a me tornar uma súcubo melhor ou algo assim?");
 ds_map_add(m,"Big Sis, what are you doing here?","Mana-irmã, o que está fazendo aqui?");
 ds_map_add(m,"Did you find the Outfits?","Encontrou os uniformes?");
 ds_map_add(m,"I will give you a prize, just come behind the counter.","Vou lhe dar um prêmio. É só vir para trás do balcão.");
 ds_map_add(m,"Oh... it is ok.","Ah... tudo bem.");
 ds_map_add(m,"That cat is a thief and we need them for the waitresses as we are full.","Aquela gata é uma ladra, e precisamos dos uniformes para as garçonetes, pois estamos lotados.");
 ds_map_add(m,"Oops, you look great but I'll need them back.","Opa, ficou ótimo em você, mas vou precisar deles de volta.");
 ds_map_add(m,"Mmmm yeah, I took it from a slime cat, I think it looks pretty good on me.","Sim, peguei de uma Gata Slime. Acho que ficou muito bom em mim.");
 ds_map_add(m,"Wow Line those Smoosher outfits?","Uau, Line! Esses são os uniformes da Smoosher?");
 ds_map_add(m,"All right, come behind the counter.","Certo, venha para trás do balcão.");
 ds_map_add(m,"Big Sis found them! Wh-which ones my prize hehe?","A mana-irmã encontrou! Q-quais são meus prêmios, hehe?");
 ds_map_add(m,"I do the basics, cut damage and every so often I upgrade a cut cube.","Sei o básico: causo dano de corte e, de vez em quando, aprimoro um cubo de corte.");
 ds_map_add(m,"No.","Não.");
 ds_map_add(m,"Yes.","Sim.");
 ds_map_add(m,"You are tired alredy?","Já está cansada?");
 ds_map_add(m,"Sorry, I cant right now u.u.","Desculpe, não posso agora u.u.");
 ds_map_add(m,"mmm ok.","Hmm, está bem.");
 ds_map_add(m,"Hey I am bored Wanna do something?","Ei, estou entediada. Quer fazer alguma coisa?");
 ds_map_add(m,"Is that you Line? c'mon in","É você, Line? Pode entrar.");
 ds_map_add(m,"Moo","Muu");
 ds_map_add(m,"I recommend you to improve your life so you don't die with one of my attacks.","Recomendo melhorar sua vida para não morrer com um dos meus ataques.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but big of the damage I do to the enemy you get it too, sadly I'm not good at team fighting.","Meu estilo de luta é normal. Causo muito dano mágico, mas você também recebe boa parte do dano que inflijo aos inimigos. Infelizmente, não sou boa em lutas em equipe.");
 ds_map_add(m,"No thanks.","Não, obrigada.");
 ds_map_add(m,"Yes I need to do something by my own sorry :c","Sim, preciso fazer algo sozinha. Desculpe :c");
 ds_map_add(m,"You look tired, do you want to rest?","Você parece cansada. Quer descansar?");
 ds_map_add(m,"I recommend you to improve your life and nature so that I am the one doing the damage while you concentrate on surviving my attacks and those of the enemies.","Recomendo melhorar sua vida e natureza para que eu cause o dano enquanto você se concentra em sobreviver aos meus ataques e aos dos inimigos.");
 ds_map_add(m,"My way of fighting is normal, I do a lot of magic damage but half of the damage I do to the enemy you get it too, I'm not good at team fighting.","Meu estilo de luta é normal. Causo muito dano mágico, mas você recebe metade do dano que inflijo aos inimigos. Não sou boa em lutas em equipe.");
 ds_map_add(m,"Not really hehe but thanks.","Não exatamente, hehe, mas obrigada.");
 ds_map_add(m,"Can you help me in my adventure <3?.","Pode me ajudar na aventura <3?");
 ds_map_add(m,"Thanks for the help, you need something?","Obrigada pela ajuda. Precisa de alguma coisa?");
 ds_map_add(m,"That depends on them and their resistance.","Isso depende deles e da resistência deles.");
 ds_map_add(m,".... Mhmm Sir? please don't kill anyone.",".... Hm, senhor? Por favor, não mate ninguém.");
 ds_map_add(m,"Ohh you are so kind and thoughtful <3 hehe.","Ahh, você é tão gentil e atencioso <3 hehe.");
 ds_map_add(m,"I told your fairy that I would get money.","Eu disse à sua fada que conseguiria dinheiro.");
 ds_map_add(m,"Mr. Vasera, what are you doing here?","Sr. Vasera, o que está fazendo aqui?");
 ds_map_add(m,"If you want to go with me to look for him, I won't stop you, but I won't defend you either, you should take care of yourselves.","Se quiser vir comigo procurá-lo, não vou impedir, mas também não vou proteger vocês. Cuidem de si mesmas.");
 ds_map_add(m,"How thoughtful. <3","Que atencioso. <3");
 ds_map_add(m,"The truth is I am already looking for it, I just told them to be careful.","Na verdade, já estou procurando. Só pedi que tomassem cuidado.");
 ds_map_add(m,"Hey wait we could help you look for it so you can absorb it again and get your full strength.","Espere, podemos ajudar a procurá-lo para que você o absorva de novo e recupere todo o seu poder.");
 ds_map_add(m,"Oh this is not good.","Ah, isso não é bom.");
 ds_map_add(m,"Somehow got consciousness and I don't know what it is capable of but if it has a part of my strength it is better to prepare yourself.","De algum modo, ele ganhou consciência. Não sei do que é capaz, mas, se tem parte do meu poder, é melhor se preparar.");
 ds_map_add(m,"Mmm there is something wrong with this godless dimension the clones I previously used on you, they all came back to me and I absorbed them except for one.","Hmm, há algo errado nesta dimensão sem deuses. Todos os clones que usei antes em você voltaram para mim e foram absorvidos, exceto um.");
 ds_map_add(m,"What wh-why!","O quê? P-por quê?!");
 ds_map_add(m,"Line I must inform you that if you see me again you must kill me if you get the chance.","Line, preciso avisar: se me encontrar de novo, deve me matar caso tenha oportunidade.");
 ds_map_add(m,"si quieren acompañarme a buscarlo no las detendre pero tampoco las defendere deben cuidarse por utedes misma","Se quiserem me acompanhar para procurá-lo, não vou impedi-las, mas também não vou protegê-las. Cuidem de si mesmas.");
 ds_map_add(m,"Que considerado <3","Que consideração <3");
 ds_map_add(m,"yo ya lo estoy buscando la verdad solo les dije que tengan cuidado","Na verdade, já estou procurando. Só pedi que tomassem cuidado.");
 ds_map_add(m,"oye espera no puede ayudarno a buscarlo asi lo vuelves a absorver y consigues toda tu fuerza","Ei, espere! Vocês podem me ajudar a procurá-lo, assim você o absorve de novo e recupera todo o seu poder.");
 ds_map_add(m,"pe-pe pero.","M-mas...");
 ds_map_add(m,"de alguna forma consiguio consencia y nose de que es capaz pero si tiene una parte de mi fuerza mejor es que te preparez.","De algum jeito, ele ganhou consciência. Não sei do que é capaz, mas, se tem parte do meu poder, é melhor se preparar.");
 ds_map_add(m,"Mmm hay algo malo en esta dimension sin dioses los clones que anteriormente use contigo todos volvieron a mi y los absorvi excepto uno.","Hmm, há algo errado nesta dimensão sem deuses. Todos os clones que usei antes em você voltaram para mim e foram absorvidos, exceto um.");
 ds_map_add(m,"Que porque!","O quê, por quê?!");
 ds_map_add(m,"Line debo informarte que si me ves denuevo debes matarme si esque tienes la oportunidad.","Line, preciso avisar: se me vir de novo, deve me matar se tiver a oportunidade.");
 ds_map_add(m,"Please... Help me, I need those crystals to go back home.","Por favor... me ajude. Preciso daqueles cristais para voltar para casa.");
 ds_map_add(m,"Well I do moderate piercing damage and upgrade a piercing cube on the grid every so often.","Bem, causo dano perfurante moderado e, de vez em quando, aprimoro um cubo perfurante na grade.");
 ds_map_add(m,"I still want you to accompany me.","Ainda quero que você me acompanhe.");
 ds_map_add(m,"Yes please, I have other things to do.","Sim, por favor. Tenho outras coisas para fazer.");
 ds_map_add(m,"Do you want me to stay here for a while?","Quer que eu fique aqui por um tempo?");
 ds_map_add(m,"Sorry, I have other things to do.","Desculpe, tenho outras coisas para fazer.");
 ds_map_add(m,"join me vasuki <3.","Venha comigo, Vasuki <3.");
 ds_map_add(m,"Oh you need something?","Ah, precisa de alguma coisa?");
 ds_map_add(m,"The quest will be available in later updates.","A missão ficará disponível em atualizações futuras.");
 ds_map_add(m,"Great ... I ran out of cigarettes.","Ótimo... meus cigarros acabaram.");
 ds_map_add(m,"Here, it's 100 Arcs just... dont blow it.","Aqui, são 100 Arcs. Só... não estrague tudo.");
 ds_map_add(m,"Of course there is no problem, count on me.","Claro, sem problema. Pode contar comigo.");
 ds_map_add(m,"If you can bring some premium cigarettes, you would do me a favor, since this is my last day on the island.","Se puder trazer alguns cigarros premium, você me faria um grande favor, já que hoje é meu último dia na ilha.");
 ds_map_add(m,"This day has been terrible, my personal onahole is sick and I also ran out of cigarettes.","Que dia horrível. Minha boneca sexual particular está doente e meus cigarros também acabaram.");
 ds_map_add(m,"Wh-what?","O-o quê?");
 ds_map_add(m,"Hey wait.","Ei, espere.");
 ds_map_add(m,"But its ok, im leaving.","Mas tudo bem, estou indo embora.");
 ds_map_add(m,"Oh so-sorry I am good helping people.","Ah, d-desculpe. Sou boa em ajudar as pessoas.");
 ds_map_add(m,"What do you care.","O que você tem a ver com isso?");
 ds_map_add(m,"So-so something happend?","E-então aconteceu alguma coisa?");
 ds_map_add(m,"hurry up i'm running out of patience.","Ande logo, estou perdendo a paciência.");
 ds_map_add(m,"To the ground now!","No chão, agora!");
 ds_map_add(m,"What?!","O quê?!");
 ds_map_add(m,"Hey, what I'm saying we'll do right here, right now.","Ei, estou dizendo que vamos resolver isso aqui mesmo, agora.");
 ds_map_add(m,"Oh its ok.","Ah, tudo bem.");
 ds_map_add(m,"Oh, haha I like the idea but I don't have much time left I have to leave now.","Ah, haha, gostei da ideia, mas não tenho muito tempo. Preciso ir agora.");
 ds_map_add(m,"I could b-be your onahole fo-for wasting your time.","Eu poderia ser sua boneca sexual para compensar o tempo que fiz você perder.");
 ds_map_add(m,"In what way?","De que jeito?");
 ds_map_add(m,"Wh-wait im very sorry maybe i ca-can help in another way.","E-espere, me desculpe. Talvez eu possa ajudar de outra maneira.");
 ds_map_add(m,"Damn this is all a waste of time, thanks for nothing.","Que droga, isso tudo foi uma perda de tempo. Obrigado por nada.");
 ds_map_add(m,"I regret to inform you that the cigarettes you are looking for do not exist on the island :c.","Lamento informar que os cigarros que você procura não existem nesta ilha :c.");
 ds_map_add(m,"Please don't bring me bad news.","Por favor, não me traga más notícias.");
 ds_map_add(m,"Umm kristoff.","Hum, Kristoff.");
 ds_map_add(m,"What are you looking at!","O que está olhando?!");
 ds_map_add(m,"What are you looking at!?","O que está olhando!?");
 ds_map_add(m,"Well lady have a good day.","Bem, senhora, tenha um bom dia.");
 ds_map_add(m,"*Kamiko grabs Line tightly and kisses her for a long minute*","*Kamiko segura Line com força e a beija por um longo minuto*");
 ds_map_add(m,"Oh ok. (at least it's something)","Ah, está bem. (Pelo menos é alguma coisa.)");
 ds_map_add(m,"But the kiss will be a french kiss.","Mas o beijo vai ser de língua.");
 ds_map_add(m,"Oh ok great. (I thought, she would think of something better :/ )","Ah, está bem, ótimo. (Achei que ela fosse pensar em algo melhor :/.)");
 ds_map_add(m,"Hmmm, Aren't you the cutest thing?, just a kiss from you would be enough.","Hmmm, você não é a coisinha mais fofa? Um beijo seu já seria suficiente.");
 ds_map_add(m,"isn't there some other way to pay it? *wink wink*","Não existe outra maneira de pagar? *pisca, pisca*");
 ds_map_add(m,"You don't have enough arcs, get out of here and let people with money pass.","Você não tem Arcs suficientes. Saia daqui e deixe quem tem dinheiro passar.");
 ds_map_add(m,"Excellent lady, have a nice day <3.","Excelente, senhora. Tenha um bom dia <3.");
 ds_map_add(m,"Do you really think you idiots can catch me? Haha, I have done this all over Elira. I'll just have to shut you up.","Vocês realmente acham que seus idiotas vão conseguir me pegar? Haha, já fiz isso por toda Elira. Só vou ter que calar a boca de vocês.");
 ds_map_add(m,"I told you Line, let's capture her maybe the guards give us money.","Eu avisei, Line. Vamos capturá-la; talvez os guardas nos deem uma recompensa.");
 ds_map_add(m,"Stop ... Haha looks like you're not the smart one on the team Line.","Pare... Haha, parece que a pessoa esperta da equipe não é você, Line.");
 ds_map_add(m,"No Line! I will bring the great captain, she is the criminal they are looking for.","Não, Line! Vou chamar a Grande Capitã. Ela é a criminosa que estão procurando.");
 ds_map_add(m,"O-oh ok i will pay.","O-oh, está bem, vou pagar.");
 ds_map_add(m,"Look... I hate taking people there, we can make a deal, if you give me the rate plus the fine and 200 arcs to keep our little secret, I'll let you go.","Escute... Odeio levar pessoas para lá. Podemos fazer um acordo: pague a tarifa, a multa e mais 200 Arcs para manter nosso segredinho, e deixo você ir.");
 ds_map_add(m,"Lili! Do you see what you have done!","Lili! Está vendo o que você fez?!");
 ds_map_add(m,"It's over now, I'll have to take you to the jail-farm, for repeated harassment to Elira's authority.","Acabou. Vou ter que levar você para a Fazenda-Prisão por assediar repetidamente as autoridades de Elira.");
 ds_map_add(m,"Line don't be so naive, she has only a glove and a shoulder pad from the outfit of a guard.","Line, não seja tão ingênua. Ela só está usando uma luva e uma ombreira do uniforme dos guardas.");
 ds_map_add(m,"Whaaat!?","O quêêê?!");
 ds_map_add(m,"The truth is that it is too late, I will have to fine you with 100 arcs for lack of respect for authority.","Na verdade, já é tarde demais. Vou aplicar uma multa de 100 Arcs por desrespeito à autoridade.");
 ds_map_add(m,"LiLi do not offend the guard.","Lili, não provoque a guarda.");
 ds_map_add(m,"What? Ha ha? just look at my guard outfit you must be mistaking me with someone else.","O quê? Haha? Olhe só meu uniforme de guarda. Você deve estar me confundindo com outra pessoa.");
 ds_map_add(m,"Exit","Sair");
 ds_map_add(m,"Bribe her with something. (Lili's idea)","Suborná-la com alguma coisa. (Ideia da Lili)");
 ds_map_add(m,"Pay the fare. (500 Arcs)","Pagar a tarifa. (500 Arcs)");
 ds_map_add(m,"This is the bitch from the wanted poster! (Lili say)","Ela é a vadia do cartaz de procurada! (Diz Lili)");
 ds_map_add(m,"Due to the high use of the bridge, it started to require maintenance, so I'm here to collect the toll.","Como a ponte é muito movimentada, começou a precisar de manutenção. Por isso estou aqui cobrando pedágio.");
 ds_map_add(m,"I'm not very good at fighting is not my style but I do what I can since I'm half wyvern I use poison, it's not very powerful but I cut their healing by 50% and I strike a punch or two even though I'm not very strong.","Não sou muito boa em combate, não é meu estilo, mas faço o que posso. Como sou metade wyvern, uso veneno. Não é muito potente, mas reduz a cura dos inimigos em 50%. Também acerto um ou dois socos, embora eu não seja muito forte.");
 ds_map_add(m,"No, could you tell me again how you fight?","Não. Você poderia me explicar de novo como luta?");
 ds_map_add(m,"You wanna quit for the day?","Quer encerrar por hoje?");
 ds_map_add(m,"Sorry, I cant right now.","Desculpe, não posso agora.");
 ds_map_add(m,"Of course <3.","Claro <3.");
 ds_map_add(m,"Ready to make some mess?","Pronta para causar confusão?");
 ds_map_add(m,"Come back when you have Arcs.","Volte quando tiver Arcs.");
 ds_map_add(m,"There you have it, you little rascal.","Aqui está, sua pestinha.");
 ds_map_add(m,"Not now.","Agora não.");
 ds_map_add(m,"Ok","Está bem.");
 ds_map_add(m,"Unfortunately I can't find him, I'll sell it to you for a thousand Arcs if you want it so badly.","Infelizmente, não consigo encontrá-lo. Se quiser tanto assim, vendo para você por mil Arcs.");
 ds_map_add(m,"You want to buy the briefcase I have? I was thinking of blackmailing the guy who lost it.","Quer comprar a maleta que tenho? Eu estava pensando em chantagear o sujeito que a perdeu.");
 ds_map_add(m,"And don't even think of taking a single Arc out of here, don't you see that why we have worked so hard, so that I can sleep like my ancestors. Yep Surrounded by money.","E nem pense em tirar um único Arc daqui. Não vê por que trabalhamos tanto? Para que eu possa dormir como meus ancestrais. Isso mesmo: cercado de dinheiro.");
 ds_map_add(m,"Hey Line you figured out where I keep all my Arcs.","Ei, Line, descobriu onde guardo todos os meus Arcs?");
 ds_map_add(m,"Umm eh em. h-hi.","Hum, é... hã... o-oi.");
 ds_map_add(m,"Theres nothing to explain, you blew up those girls!","Não há nada para explicar. Você explodiu aquelas garotas!");
 ds_map_add(m,"Please let me explain.","Por favor, deixe-me explicar.");
 ds_map_add(m,"Well the truth is that I don't like to fight, but I can support you by recovering 10% of your life from time to time.","Bem, a verdade é que não gosto de lutar, mas posso apoiar você recuperando 10% da sua vida de vez em quando.");
 ds_map_add(m,"No never.","Não, nunca.");
 ds_map_add(m,"you want to rest?","Quer descansar?");
 ds_map_add(m,"Actually yes,could you tell me again how you fight?","Na verdade, sim. Você poderia me explicar de novo como luta?");
 ds_map_add(m,"This Quest is only for patreons.","Esta missão é exclusiva para apoiadores do Patreon.");
 ds_map_add(m,"Remember, if you find her, bring her with me in the sencond Floor of the hotel even if she doesn't want to.","Lembre-se: se encontrá-la, leve-a até mim no segundo andar do hotel, mesmo que ela não queira.");
 ds_map_add(m,"How annoying you are!.","Como você é irritante!");
 ds_map_add(m,"Oh you still have the strength to fight? I guess it will be a second round.","Ah, ainda tem forças para lutar? Então teremos uma segunda rodada.");
 ds_map_add(m,"Yes, yes I understand you, sorry for wasting your time :c.","Sim, sim, entendo. Desculpe por desperdiçar seu tempo :c.");
 ds_map_add(m,"Thanks Line but I'm looking for an adventurer a little more mmmm.... recognizable one that wherever he goes, people will recognize him, you know what I mean right?","Obrigada, Line, mas estou procurando um aventureiro um pouco mais... hmmm... conhecido, alguém que seja reconhecido por onde passa. Você entende, não é?");
 ds_map_add(m,"Oh well, I don't know, but still, if you need help, uh a-here I am.","Ah, bem, não sei, mas, se precisar de ajuda, é... e-estou aqui.");
 ds_map_add(m,"Really? I don't see you being the adventurous type.","Sério? Não vejo em você o tipo aventureiro.");
 ds_map_add(m,"Oh.. ehmm h-hi i am Line I am adventurer","Ah... hum... o-oi, sou Line, uma aventureira.");
 ds_map_add(m,"Uff this novel will practically write itself.","Ufa, praticamente vou poder escrever este romance sem esforço.");
 ds_map_add(m,"I am also half succubus :v.","Também sou metade súcubo :v.");
 ds_map_add(m,"OHh, an orthodox elf who discovers her sexuality, Line your life is gold.","OOOH, uma elfa tradicional que descobre a própria sexualidade! Line, sua vida vale ouro.");
 ds_map_add(m,"Hey, hey hey  she is not a whore she is just exploring her sexuality.","Ei, ei, ei! Ela não é uma prostituta, só está explorando a própria sexualidade.");
 ds_map_add(m,"Wow Line you are such a whore you must have a million stories please let me join you on your journey.","Uau, Line, você é uma tremenda vadia! Deve ter um milhão de histórias. Por favor, deixe-me acompanhar você nessa jornada.");
 ds_map_add(m,"Lili! ( Please someone kill me )","Lili! (Alguém, por favor, me mate.)");
 ds_map_add(m,"HAHAHA because they don't have it, she defeated the demon by taking her energy by giving her a rimjob.","HAHAHA, porque elas não têm isso! Ela derrotou o demônio sugando sua energia ao fazer sexo oral anal nele.");
 ds_map_add(m,"Wow I had no idea that elves could summon sacred fires.","Uau, eu não fazia ideia de que elfos podiam invocar fogo sagrado.");
 ds_map_add(m,"Well you know... fire ehh sacred ... of elf (Iam a terrible liar :C).","Bem, sabe como é... fogo, hã... sagrado... dos elfos. (Sou uma péssima mentirosa :C.)");
 ds_map_add(m,"OHHH and what is this super attack?!","OOOOH, e que superataque foi aquele?!");
 ds_map_add(m,"OHh. that, I ahemm. We fought an epic battle where I was on the verge of losing but luckily I channeled all my strength into one last attack and BAM I knocked her down and she fell unconscious.","Ah, aquilo... eu... cof cof. Travamos uma batalha épica, na qual eu estava prestes a perder, mas, por sorte, concentrei toda a minha força num último ataque e BAM! Derrubei-a, e ela desmaiou.");
 ds_map_add(m,"How did you defeat the white demon in the forest? The whole town is talking about you winning her but nobody knows exactly how?","Como você derrotou o demônio branco na floresta? A cidade inteira está falando da sua vitória, mas ninguém sabe exatamente como aconteceu.");
 ds_map_add(m,"OHh hu-hu-hu wha-what kind of experiences do you need.","OOOH, h-h-hã... que tipo de experiência você precisa?");
 ds_map_add(m,"PLEASE let me join you on your journey my novel depends on you I need all the experience you can give me.","POR FAVOR, deixe-me acompanhar você na sua jornada! Meu romance depende de você. Preciso de todas as experiências que puder me proporcionar.");
 ds_map_add(m,"Ehh yes I am she hehe.","É-é, sim, sou eu, hehe.");
 ds_map_add(m,"Hey, are you the traveler who defeated the demon that stole the alcohol supplies?!","Ei, você é a viajante que derrotou o demônio que roubava os carregamentos de bebidas?!");
 ds_map_add(m,"Well I do moderate magic damage and upgrade a magic cube on the grid every so often.","Bem, causo dano mágico moderado e, de vez em quando, aprimoro um cubo mágico na grade.");
 ds_map_add(m,"Yes I need to do something by my own sorry. :c","Sim, preciso fazer algo por conta própria. Desculpe :c.");
 ds_map_add(m,"You want to rest?","Quer descansar?");
 ds_map_add(m,"Can you help me in my adventure. <3?.","Pode me ajudar na minha aventura? <3");
 ds_map_add(m,"Oh hehe thanks <3.","Ah, hehe, obrigada <3.");
 ds_map_add(m,"The world is a better place with you in it, whether you like it or not.","O mundo é um lugar melhor com você nele, goste ou não.");
 ds_map_add(m,"Really? well that would help me a lot and don't worry it's the first time I've seen a fairy like that haha.\nWell, if you find it, please do not view its content, it is classified from my work.","Sério? Isso me ajudaria muito. E não se preocupe, é a primeira vez que vejo uma fada assim, haha.\nBem, se encontrar a maleta, por favor, não veja o conteúdo. É material confidencial do meu trabalho.");
 ds_map_add(m,"Lili! \n Oh I am so-sorry she is a bit aggressive but she has a good heart if you want we can help you look for your briefcase.","Lili!\nAh, m-me desculpe. Ela é um pouco agressiva, mas tem bom coração. Se quiser, podemos ajudar você a procurar sua maleta.");
 ds_map_add(m,"Ya great but I didn't ask you about your life","Legal, ótimo, mas eu não perguntei sobre sua vida.");
 ds_map_add(m,"Sorry I had a horrible day I lost my briefcase and I had a lot of important information in it now I have to start from scratch.","Desculpe, tive um dia horrível. Perdi minha maleta, que continha muitas informações importantes. Agora vou ter que começar tudo do zero.");
 ds_map_add(m,"Lili do not say it like that!","Lili, não fale assim!");
 ds_map_add(m,"Hey shut up, you're in a library.","Ei, cale a boca. Você está numa biblioteca.");
 ds_map_add(m,"AHh I'll have to start all over again.\nWhere can my briefcase be?","AAH, vou ter que começar tudo de novo.\nOnde será que minha maleta foi parar?");
 ds_map_add(m,"Did you find my briefcase?","Encontrou minha maleta?");
 ds_map_add(m,"My briefcase should be here somewhere","Minha maleta deve estar por aqui em algum lugar.");
 ds_map_add(m,"Well I do moderate Impact damage to the enemy and between each fight I can try to win more Arcs.","Na verdade, causo dano de impacto moderado ao inimigo e, entre uma luta e outra, posso tentar ganhar mais Arcs.");
 ds_map_add(m,"Actually could you tell me again how you fight?","Na verdade, pode me explicar de novo como você luta?");
 ds_map_add(m,"No now.","Agora não.");
 ds_map_add(m,"Yes please I am a little tired.","Sim, por favor. Estou um pouco cansada.");
 ds_map_add(m,"Are we done for the day?","Terminamos por hoje?");
 ds_map_add(m,"In a fight I do moderate impact damage plus I can make the enemy give us double the Arcs for the trouble he gave us..","Em combate, causo dano de impacto moderado e também posso fazer o inimigo pagar o dobro de Arcs por todo o trabalho que nos deu.");
 ds_map_add(m,"Do you need something line?","Precisa de alguma coisa, Line?");
 ds_map_add(m,"But once they atone for their sins they will be returned to them is the law of the island.","Mas, depois que expiarem seus pecados, elas serão devolvidas. Essa é a lei da ilha.");
 ds_map_add(m,"Oh no, hahaha that would be crazy. I just steal their eyes and place them on my body.","Ah, não, hahaha. Isso seria loucura. Eu só roubo os olhos deles e os coloco no meu próprio corpo.");
 ds_map_add(m,"And how are you supposed to do your justice, you don't kill them... right?","E como você pretende fazer justiça? Você não os mata... certo?");
 ds_map_add(m,"As I pray I can hear the prayers of women in trouble and bring justice.","Enquanto rezo, consigo ouvir as preces de mulheres em perigo e levar justiça até elas.");
 ds_map_add(m,"I am Ragnuda the dodomeki and I judge men who cheat on their wives.","Sou Ragnuda, a dodomeki, e julgo homens que traem suas esposas.");
 ds_map_add(m,"Oh I am sorry it's just weird to see someone here at night... and naked. :v","Ah, desculpe. É estranho encontrar alguém aqui à noite... ainda mais sem roupa :v.");
 ds_map_add(m,"You interrupted my prayers.","Você interrompeu minhas orações.");
 ds_map_add(m,"What a brave boy ;c","Que menino corajoso ;c.");
 ds_map_add(m,"MOooOOOo!","Muuuu!");
 ds_map_add(m,"Line Look","Line, olha!");
 ds_map_add(m,"A somewhat ironic ending I guess Hahaha.","Um final um tanto irônico, eu diria. Hahaha.");
 ds_map_add(m,"Shale vale :v.","Que azar :v.");
 ds_map_add(m,"I was told that I can earn some money by selling my own 'milk'.","Disseram que posso ganhar algum dinheiro vendendo meu próprio 'leite'.");
 ds_map_add(m,"And now I have no money to go back home ;c.","E agora não tenho dinheiro para voltar para casa ;c.");
 ds_map_add(m,"Well... I came on vacation to this island but I spent my money driking milk.","Bem... vim passar férias nesta ilha, mas gastei todo o meu dinheiro bebendo leite.");
 ds_map_add(m,"What happened to you?","O que aconteceu com você?");
 ds_map_add(m,"Ah I really don't want to do this.","Ah, eu realmente não quero fazer isso.");
 ds_map_add(m,"Oh he doesn't have a cow outfit.","Ah, ele não tem uma fantasia de vaca.");
 ds_map_add(m,"Haha its ok take care.","Haha, tudo bem. Se cuide.");
 ds_map_add(m,"Oh, yeah sorry it will have to be for another day :c.","Ah, sim, desculpe. Vai ter que ficar para outro dia :c.");
 ds_map_add(m,"Line! focus on your objective, we are looking for your friend.","Line! Concentre-se no seu objetivo. Estamos procurando sua amiga.");
 ds_map_add(m,"Oh I am not really a drinking person hehe but if you want I can.... join you you know.","Ah, não sou muito de beber, hehe, mas, se você quiser, posso... fazer companhia, sabe?");
 ds_map_add(m,"Hi, sweetie, would you like to join me for a drink?","Oi, querida. Gostaria de tomar uma bebida comigo?");
 ds_map_add(m,"make me bitch","Vem me pegar, vadia.");
 ds_map_add(m,"Get the hell out of my territory you thot","Saia da minha área, sua oferecida.");
 ds_map_add(m,"It may already be time to get back to work, I miss announcing the news.","Talvez já esteja na hora de voltar ao trabalho. Sinto falta de apresentar as notícias.");
 ds_map_add(m,"I wouldn't miss it for anything in the world.","Eu não perderia isso por nada neste mundo.");
 ds_map_add(m,"Mmm.. hi there will be a mini show at the circus I would appreciate it if you could go.","Hmm... vai ter uma pequena apresentação no circo. Eu ficaria muito grata se você pudesse ir.");
 ds_map_add(m,"*blushed* th-thank you it is a relief that you liked it.","*corada* O-obrigada. Fico aliviada que tenha gostado.");
 ds_map_add(m,"That was a great show.","Foi uma ótima apresentação.");
 ds_map_add(m,"Sorry (but I didn't do anything :c).","Desculpe (mas eu não fiz nada :c).");
 ds_map_add(m,"She is very sorry, say sorry *covers Line's mouth*","Ela está muito arrependida. Peça desculpas. *cobre a boca de Line*");
 ds_map_add(m,"Oh, well if you wan..","Ah, bem, se você quiser...");
 ds_map_add(m,"Excuse me? that no way of speaking if I were your mother I would punish you.","Como assim? Não se fala desse jeito! Se eu fosse sua mãe, castigaria você.");
 ds_map_add(m,"Shit! Line look at that ass.","Merda! Line, olha aquela bunda.");
 ds_map_add(m,"Finally I finished cleaning this floor, Mr.Cabello will be happy <3.","Finalmente terminei de limpar este andar. O Sr. Cabello vai ficar feliz <3.");
 ds_map_add(m,"Thanks Line for the help <3.","Obrigada pela ajuda, Line <3.");
 ds_map_add(m,"MMm where to go next, what place will inspire me? to write my next hit.","MMm, para onde vou agora? Que lugar vai me inspirar a escrever meu próximo sucesso?");
 ds_map_add(m,"But, what?...well whatever. I hope you can accomplish your mission miss but if it gets too dangerous run away please I don't want my book to be tainted by someone dying or getting lost in the woods.","Mas... o quê? Bem, tanto faz. Espero que consiga cumprir sua missão, senhorita. Mas, se ficar perigoso demais, fuja, por favor. Não quero que meu livro seja manchado pela morte de alguém ou por alguém que se perca na floresta.");
 ds_map_add(m,"I will do my best I will be worthy of the sword *reverence*.","Farei o meu melhor. Serei digna da espada. *faz uma reverência*");
 ds_map_add(m,"What are you talking about? I never said you were going to look for her, and I don't really care either, no one has taken her out so far.","Do que está falando? Nunca disse que você iria procurá-la, e também não me importo muito. Até agora, ninguém conseguiu retirá-la.");
 ds_map_add(m,"Thank you very much I will not let you down and I will bring the sword.","Muito obrigada. Não vou decepcionar você e trarei a espada.");
 ds_map_add(m,"Well one enters the forest and must follow these directions up, down, left, left, left, right, down and finally up. But beware that even if I am not here, the spiritual energy of one of my ancestors may try to deny you passage..","Entre na floresta e siga estas direções: cima, baixo, esquerda, esquerda, esquerda, direita, baixo e, por fim, cima. Mas cuidado: mesmo que eu não esteja aqui, a energia espiritual de um dos meus ancestrais pode tentar impedir sua passagem...");
 ds_map_add(m,"And how I got there!","E como foi que eu cheguei lá?!");
 ds_map_add(m,"Yes, but there came a time when I really understood that she didn't need me to take care of her, she was quite lost in the forest and to get her out you have to have the requirements I wrote down, even so I don't understand how that helps to get the sword out.","Sim, mas chegou uma hora em que entendi que ela não precisava que eu cuidasse dela. Ela estava completamente perdida na floresta, e, para tirá-la de lá, é preciso cumprir os requisitos que anotei. Mesmo assim, não entendo como isso ajuda a retirar a espada.");
 ds_map_add(m,"What the heck?!","Que diabos?!");
 ds_map_add(m,"Oh relax you will be surprised to know that it is true my family was the one who took care of the sword although we never managed to get it off the anvil.","Ah, relaxe. Você vai se surpreender ao saber que é verdade: minha família cuidava da espada, embora nunca tenhamos conseguido tirá-la da bigorna.");
 ds_map_add(m,"Uh sorry sir my friend fell out of the crib when she was a baby we won't bother you anymore eh hehe ehh..","Ah, desculpe, senhor. Minha amiga caiu do berço quando era bebê. Não vamos mais incomodar, hehe...");
 ds_map_add(m,"YES! You know that when I read your story I did not feel that the sword is true and I can feel it on the island.","SIM! Sabe, quando li sua história, não senti que a espada fosse real. Mas agora consigo senti-la na ilha.");
 ds_map_add(m,"Mmmm yes I am surprised to find fans here, was it because of the back cover?","Hmmm, sim. Fico surpreso em encontrar fãs por aqui. Foi por causa da contracapa?");
 ds_map_add(m,"Hello sir, are you by any chance the author of The Pelletclad Blade?","Olá, senhor. Por acaso você é o autor de A Lâmina Revestida de Projéteis?");
 ds_map_add(m,"You say that because of the sheets in his hand...I guess it's worth a try.","Você está dizendo isso por causa dos papéis na mão dele... Acho que vale a pena tentar.");
 ds_map_add(m,"Looks like a writer?","Ele parece um escritor?");
 ds_map_add(m,"Ehh it must be because of the years it was stored out in the open hehe.","É... deve ser por causa dos anos em que ficou guardada ao ar livre, hehe.");
 ds_map_add(m,"What, you managed to get the sword I'm glad it has a new owner but why does it smell so strange?","O quê? Você conseguiu a espada? Fico feliz que ela tenha um novo dono, mas por que está com esse cheiro tão estranho?");
 ds_map_add(m,"Hey do you want something really chingon?.","Ei, quer comprar algo realmente foda?");
 ds_map_add(m,"Oh give me a second I'm getting my suit ready.","Ah, espere um segundo. Estou preparando minha fantasia.");
 ds_map_add(m,"Mmmhe MMMhe I understand I will have it ready when I bring the 5000 arcs leave it all to me.","Mm-hmm, entendi. Deixarei tudo pronto quando você trouxer os 5.000 Arcs. Pode deixar comigo.");
 ds_map_add(m,"Mmmm ok but I want this for my furrsuit *whispering* shp shp shp shapa shapa shapa.","Hmmm, está bem, mas quero isso para minha fantasia furry. *sussurrando* shp shp shp shapa shapa shapa.");
 ds_map_add(m,"I know it's expensive but understand that the suit is custom made with all the specifications you want.","Sei que é caro, mas entenda: a fantasia é feita sob medida, com todas as especificações que você quiser.");
 ds_map_add(m,"Great it's only 5000 Arcs","Ótimo, são só 5.000 Arcs.");
 ds_map_add(m,"You've already convinced me how much it costs!","Você já me convenceu. Quanto custa?!");
 ds_map_add(m,"I'm not going to lie to you, it's expensive, but if it's any incentive Miss Marael says that sex in a furrisuit is quite an experience.","Não vou mentir: é caro. Mas, se servir de incentivo, a senhorita Marael diz que fazer sexo usando uma fantasia furry é uma experiência e tanto.");
 ds_map_add(m,"Now I want to be a furry!","Agora quero ser furry!");
 ds_map_add(m,"Yes haha she was part of the furry community before deciding to live life as a goat woman.","Sim, haha. Ela fazia parte da comunidade furry antes de decidir viver como uma mulher-cabra.");
 ds_map_add(m,"Really?!","Sério?!");
 ds_map_add(m,"Oh you talk about Miss Marael what a nice woman she was my first time.","Ah, você está falando da senhorita Marael. Que mulher incrível; foi minha primeira vez.");
 ds_map_add(m,"Mmm... I am half succubus and I cannot even transform myself to the taste of others, I met a succubus who decided to live life as a black goat woman, I would really like to change my form and know how it would be like to be a real succubus.","Mmm... sou metade súcubo e nem consigo mudar minha forma para agradar aos outros. Conheci uma súcubo que decidiu viver como uma mulher-cabra preta. Eu gostaria muito de mudar de forma e descobrir como seria ser uma súcubo de verdade.");
 ds_map_add(m,"Not all of us are lucky enough to be born as one or transform ourselves but with these costumes we have the opportunity to live life from a different perspective.","Nem todos temos a sorte de nascer assim ou de conseguir mudar de forma, mas, com estas fantasias, podemos experimentar a vida de outra perspectiva.");
 ds_map_add(m,"Well, it all depends on whether you admire atropomorphic animals like wolves.","Bem, tudo depende de você admirar animais antropomórficos, como lobos.");
 ds_map_add(m,"Mmm I do not know what's in it for me?","Mmm, não sei. O que eu ganho com isso?");
 ds_map_add(m,"I don't know Line looks like a weirdo.","Não sei, Line. Ele parece meio esquisito.");
 ds_map_add(m,"Would you like to be part of our community?","Gostaria de fazer parte da nossa comunidade?");
 ds_map_add(m,"OH how cute I love your fluffy little ears <3.","OH, que gracinha! Adoro suas orelhinhas fofas <3.");
 ds_map_add(m,"Indeed, I am an honorable member of the furry community.","De fato, sou um membro honorário da comunidade furry.");
 ds_map_add(m,"... H-hi e- that's a costume?","... O-oi... é-é uma fantasia?");
 ds_map_add(m,"Ohmm HI I am Snugglepaws!","Uhm, olá! Sou o Snugglepaws!");
 ds_map_add(m,"No I am still short of money :c.","Não, ainda estou sem dinheiro suficiente :c.");
 ds_map_add(m,"Did you get the money?","Conseguiu o dinheiro?");
 ds_map_add(m,"Thank you very much Mr. Snugglepaws.","Muito obrigado, Sr. Snugglepaws.");
 ds_map_add(m,"Let's go home Lili, I need your help!","Vamos para casa, Lili. Preciso da sua ajuda!");
 ds_map_add(m,"Ohhhh I love it I love it I love it I love it that's all I wanted <3!","AAAAH, eu adorei! Adorei! Adorei! Era tudo o que eu queria <3!");
 ds_map_add(m,"Here it is, your furrsuit of rabbit woman with movable mouth, automatic blinking, with soft light blue magenta hair!","Aqui está: sua fantasia de mulher-coelha, com boca articulada, piscadas automáticas e pelos macios azul-claros e magenta!");
 ds_map_add(m,"Oh it's okay I'll wait here <3.","Ah, tudo bem. Vou esperar aqui <3.");
 ds_map_add(m,"Yes, everything is here. (pay 5000 Arcs)","Sim, está tudo aqui. (Pagar 5.000 Arcs)");
 ds_map_add(m,"Not yet.","Ainda não.");
 ds_map_add(m,"Thank you very much but I am no longer Line now call me Bluebell.","Muito obrigada, mas agora não sou mais Line. Pode me chamar de Bluebell.");
 ds_map_add(m,"Go Line I know what you want to do.","Vai, Line. Sei o que você quer fazer.");
 ds_map_add(m,"... good, thank you.","... Está bem, obrigada.");
 ds_map_add(m,"Oh Bluebell did you like the suit?","Ah, Bluebell, gostou da fantasia?");
 ds_map_add(m,"Oh hehe we really have a very similar voice, masturbating thinking about my own voice will be something very strange hehe although something exciting.","Ah, hehe, nossas vozes são muito parecidas. Masturbar-me pensando na minha própria voz seria bem estranho, hehe, embora também seja excitante.");
 ds_map_add(m,"Wow you sound a lot like me, haha ,well I have a fura fura fruit if you want to eat one.","Uau, você soa muito parecida comigo, haha. Bem, tenho uma fruta Fura Fura, se quiser comer uma.");
 ds_map_add(m,"No, no, no, no, I-I want to hehe sorry for overthinking it.","Não, não, não... E-eu quero, hehe. Desculpe por pensar demais.");
 ds_map_add(m,"If you don't want to, it's okay, lady.","Se não quiser, tudo bem, moça.");
 ds_map_add(m,"Oh Mmmm (exactly, pretend to think so they don't find out you're desperate).","Ah, hmm... (Isso mesmo, finja que está pensando para não perceberem o quanto você está desesperada.)");
 ds_map_add(m,"Hello Miss, by any chance do you want to use my hole?","Olá, senhorita. Por acaso gostaria de usar meu buraco?");
 ds_map_add(m,"Only the family may enter this sanctuary.","Somente membros da família podem entrar neste santuário.");
 ds_map_add(m,"Come on Run! I bet 1000 Arcs on you Hu HU HU HU HUghg!.","Vamos, corra! Apostei 1.000 Arcs em você! Hu hu hu hu hu!");
 ds_map_add(m,"I'll do it sir, don't worry. Line now you've gone too far give it some space.","Eu cuido disso, senhor, não se preocupe. Line, você passou dos limites. Dê um pouco de espaço a ela.");
 ds_map_add(m,"Please someone get this girl out of my vital space.","Por favor, alguém tire essa garota do meu espaço pessoal.");
 ds_map_add(m,"OH! *approaches at too uncomfortable a distance* thank you thank you thank you very much sir I will use your wisdom with care.","OH! *aproxima-se a uma distância extremamente desconfortável* Obrigado, obrigado, muito obrigado, senhor! Usarei sua sabedoria com cuidado.");
 ds_map_add(m,"Eheee... I guess every time I'm going to do something that involves force I pound my chest for some reason it makes me feel stronger.","Ééé... acho que, sempre que vou fazer algo que exige força, bato no peito por algum motivo. Isso me faz sentir mais forte.");
 ds_map_add(m,"Can you tell me how to get the strength of a gorilla please please pleaseeeeee?","Pode me ensinar a ter a força de um gorila? Por favor, por favor, por favooooor?");
 ds_map_add(m,"... The last time I checked, I was indeed.","... Da última vez que conferi, sim, eu era.");
 ds_map_add(m,"Ho hello are you a gorilla?","O-olá. Você é um gorila?");
 ds_map_add(m,"No no no we are just travelers looking for our friend ;c.","Não, não, não! Somos apenas viajantes procurando nossa amiga ;c.");
 ds_map_add(m,"Oh I *hip* see, you are allies of the empire trying to erase part of history.","Ah, eu *soluço* entendi. Vocês são aliados do império, tentando apagar parte da história.");
 ds_map_add(m,"hey miss hero we're a little busy it was good your story and all, but we have to keep moving.","Ei, senhorita heroína, estamos um pouco ocupados. Sua história foi interessante e tudo mais, mas precisamos continuar andando.");
 ds_map_add(m,"doesn't matter! you should know this world is forgetting *hip*roes and I'll make them remember.","Não importa! Você precisa saber que este mundo está esquecendo os *soluço* heróis, e vou fazer com que se lembrem.");
 ds_map_add(m,"Mmm ... n-no, i didn't know i'm half elf half succubus actually.","Mmm... n-não, eu não sabia. Na verdade, sou metade elfa e metade súcubo.");
 ds_map_add(m,"Thats nice really nice you *hip* know my father protect all the humanity and they dont even know *hip*t.","Que legal, muito legal. Você *soluço* sabia que meu pai protege toda a humanidade e ninguém sequer *soluço* sabe disso?");
 ds_map_add(m,"Eh, I'm not the bartender but if you want I'll call her.","É, não sou a bartender, mas, se quiser, posso chamá-la.");
 ds_map_add(m,"Hey, yo skinny girl do something good and bring me some beer *hip*.","Ei, garota magrela, faça uma coisa boa e traga uma cerveja para mim. *soluço*");
 ds_map_add(m,"You know what, I'm not going to go kill the demon that steals the beer shipments. it's my freaking vacation!","Sabe de uma coisa? Não vou matar o demônio que rouba os carregamentos de cerveja. São minhas malditas férias!");
 ds_map_add(m,"AHHGG! I came to relax on the only island that has no alcohol.","AAAH! Vim relaxar na única ilha que não tem álcool.");
 ds_map_add(m,"Line ... let's get out of here.","Line... vamos sair daqui.");
 ds_map_add(m,"Oh don't worry i have being in this place before. i will repair it and problem solve.","Não se preocupe, já estive neste lugar antes. Vou consertar isso e resolver o problema.");
 ds_map_add(m,"I-it's not funny, you broke the table with the fight","I-isso não tem graça. Vocês quebraram a mesa durante a briga.");
 ds_map_add(m,"And I think with this fight the effect of the beer were off Hahaha.","E acho que, com essa briga, o efeito da cerveja passou. Hahaha.");
 ds_map_add(m,"You fight very well, I don't think you're with the weaklings of the empire.","Você luta muito bem. Não acho que seja um daqueles fracotes do império.");
 ds_map_add(m,"I will repair it after a few drinks haha.","Vou consertar depois de tomar umas bebidas, haha.");
 ds_map_add(m,"it doesn't matter break his ass Line!","Não importa! Arrebenta com ele, Line!");
 ds_map_add(m,"So you are the prankster!","Então você é a encrenqueira!");
 ds_map_add(m,"I need you to come with me because of you an innocent woman will go to jail!","Preciso que venha comigo. Por sua causa, uma mulher inocente vai para a cadeia!");
 ds_map_add(m,"Woomy Woomy!","Woomy, woomy!");
 ds_map_add(m,"I guess as long as she doesn't make any more trouble it's okay for her to stay here.","Acho que, desde que ela não cause mais problemas, tudo bem deixá-la ficar aqui.");
 ds_map_add(m,"I guess when he fled he found this cave.","Acho que, quando fugiu, ele encontrou esta caverna.");
 ds_map_add(m,"Why is it here anyway?","Mas, afinal, por que isso está aqui?");
 ds_map_add(m,"Oh... could happen to anyone.","Ah... isso poderia acontecer com qualquer um.");
 ds_map_add(m,"I also remember when you beat him, he attacked you and you fainted and pissed yourself, what a day.","Também me lembro de quando você o derrotou. Ele atacou você, você desmaiou e mijou nas calças. Que dia, hein?");
 ds_map_add(m,"Look Lili is the cat that almost put Callie in jail, well, she end up in jail anyways but you know.","Olha, Lili, é o gato que quase fez Callie ir para a cadeia. Bem, ela acabou indo para a cadeia mesmo assim, mas você entendeu.");
 ds_map_add(m,"I hope Whipsie is doing well on Tricotex.","Espero que Whipsie esteja bem em Tricotex.");
 ds_map_add(m,"This farm reminds me of home.","Esta fazenda me lembra de casa.");
 ds_map_add(m,"Take it for granted me and Line can against everything!","Pode confiar: eu e Line damos conta de qualquer coisa!");
 ds_map_add(m,"I guess a little help wouldn't hurt, but I'll have to see if they are both up to the task to be my partner.","Acho que uma ajudinha não faria mal, mas preciso ver se vocês duas estão à altura da tarefa para serem minhas parceiras.");
 ds_map_add(m,"Sorry sam for her lack of delicacy, she a big fan of you.. and so am I, but I mean who doesn't hehe.","Desculpe, Sam, pela falta de delicadeza dela. Ela é sua grande fã... e eu também. Mas, quer dizer, quem não é? Hehe.");
 ds_map_add(m,"Wow really can we help to capture it ?!","Uau, sério? Podemos ajudar a capturá-lo?!");
 ds_map_add(m,"For now she is the one who takes care of the city, I come to this island because a Tricotex criminal came here.","Por enquanto, ela é quem cuida da cidade. Vim para esta ilha porque um criminoso de Tricotex veio para cá.");
 ds_map_add(m,"Yeah and where is your partner Whipsy :c?","É, e onde está sua parceira Whipsy :c?");
 ds_map_add(m,"Oh well, actually we are not from here, but we knew your stories of how you saved the streets of Tricotex while we travel.","Bem, na verdade não somos daqui, mas conhecemos suas histórias de como você salvou as ruas de Tricotex enquanto viajávamos.");
 ds_map_add(m,"Wow, I didn't think anyone would recognize me around here.","Uau, não pensei que alguém fosse me reconhecer por aqui.");
 ds_map_add(m,"H-hi you are Sa-Sam the hero o-of the Tricotex right :O?","O-oi, você é o Sa-Sam, o herói de Tricotex, não é :O?");
 ds_map_add(m,"You come for the rematch?","Veio para a revanche?");
 ds_map_add(m,"Haha it's very simple, I do a lot of impact damage.","Haha, é muito simples: causo bastante dano de impacto.");
 ds_map_add(m,"I still want to accompany you.","Ainda quero acompanhar você.");
 ds_map_add(m,"sorry same I have other things to do.","Desculpe, Sam, tenho outras coisas para fazer.");
 ds_map_add(m,"If you don't have time to catch the criminal, we can part ways for a while.","Se você não tem tempo para capturar o criminoso, podemos nos separar por um tempo.");
 ds_map_add(m,"No sorry, could you tell me again how you fight?","Não, desculpe. Pode me explicar de novo como você luta?");
 ds_map_add(m,"Sorry same I have other things to do.","Desculpe, Sam, tenho outras coisas para fazer.");
 ds_map_add(m,"Let's catch that criminal <3.","Vamos capturar aquele criminoso <3.");
 ds_map_add(m,"Now you have time to help me catch the criminal?","Agora você tem tempo para me ajudar a capturar o criminoso?");
 ds_map_add(m,"Come back as you were!","Volte a ser como antes!");
 ds_map_add(m,"I do a lot of magic damage that's all you need to know.","Causo bastante dano mágico. É só isso que você precisa saber.");
 ds_map_add(m,"I am sorry I have to go to the bathroom :c.","Desculpe, preciso ir ao banheiro :c.");
 ds_map_add(m,"Sorry but, could you tell me again how you fight?","Desculpe, mas pode me explicar de novo como você luta?");
 ds_map_add(m,"I really want to help you Faye.","Quero muito ajudar você, Faye.");
 ds_map_add(m,"Hey, if you don't have time to help me just say it, it will be faster for me to look for myself.","Ei, se não tem tempo para me ajudar, é só dizer. Assim será mais rápido eu procurar sozinha.");
 ds_map_add(m,"Oh ok.. lets go.","Ah, está bem... vamos.");
 ds_map_add(m,"I don't want to waste your time. :c","Não quero desperdiçar seu tempo :c.");
 ds_map_add(m,"If you want to help me just don't waste my time.","Se quiser me ajudar, simplesmente não desperdice meu tempo.");
 ds_map_add(m,"I will rest a little here.","Vou descansar um pouco aqui.");
 ds_map_add(m,"I think it's southeast from here.","Acho que fica a sudeste daqui.");
 ds_map_add(m,"Where is she now?","Onde ela está agora?");
 ds_map_add(m,"Yes, I think a cow that escaped from the farm ran into the idiot that did this to me.","Sim, acho que uma vaca que fugiu da fazenda esbarrou no idiota que fez isso comigo.");
 ds_map_add(m,"Do you know where he went or if anyone saw him?","Sabe para onde ele foi ou se alguém o viu?");
 ds_map_add(m,"Thanks, I came to buy some milk and something covered me in this stuff.","Obrigada. Vim comprar leite e alguma coisa me cobriu com essa coisa.");
 ds_map_add(m,"Calm down, I will help you.","Calma, vou ajudar você.");
 ds_map_add(m,"Shit somebody help me get this out","Merda, alguém me ajude a tirar isso!");
 ds_map_add(m,"Yeah, she went to the cultivation of nana leaves","Sim, ela foi para a plantação de folhas de nana.");
 ds_map_add(m,"Thanks, I came from buying some special milk and something covered me with this thing.","Obrigada. Acabei de comprar um pouco de leite especial e alguma coisa me cobriu com esta coisa.");
 ds_map_add(m,"Shit somebody help me get this out.","Merda, alguém me ajude a tirar isso!");
 ds_map_add(m,"Oh ok, if that is what you want but let me tell you that I fight a little different than the rest.","Ah, está bem, se é isso que você quer. Mas preciso avisar que luto de um jeito um pouco diferente dos outros.");
 ds_map_add(m,"You beat him ?! Please fight me in a sparring match.","Você o derrotou?! Por favor, lute comigo numa partida amistosa.");
 ds_map_add(m,"I know you will, with enough practice you will beat him like I did <3.","Sei que vai conseguir. Com prática suficiente, você vai derrotá-lo como eu fiz <3.");
 ds_map_add(m,"I would like to be stronger to face it again.","Quero ficar mais forte para enfrentá-lo novamente.");
 ds_map_add(m,"I am happy to hear you are ok.","Fico feliz em saber que você está bem.");
 ds_map_add(m,"Thanks for the help, traveler.","Obrigada pela ajuda, viajante.");
 ds_map_add(m,"*Line blushes* Y-yes probably not hehe.","*Line fica corada* S-sim, provavelmente não, hehe.");
 ds_map_add(m,"Besides, I don't think your way of fighting will work for me anyway hahaha.","Além disso, não acho que seu estilo de luta funcionaria para mim de qualquer maneira, hahaha.");
 ds_map_add(m,"I need to practice more but thanks anyway.","Preciso praticar mais, mas, mesmo assim, obrigada.");
 ds_map_add(m,"Proklyat'ye.","Maldição.");
 ds_map_add(m,"AHhh. my head how did I get here, Hi-Hikari is that you?","AAAh, minha cabeça... como vim parar aqui? H-Hikari, é você?");
 ds_map_add(m,"I love this part of town, although playing pachinco nothing beats it. You should come to my store maybe you will win a prize <3","Adoro esta parte da cidade, embora nada supere jogar pachinko. Você devia visitar minha loja; talvez ganhe um prêmio <3.");
 ds_map_add(m,"Isn't it precious? This river is so peaceful, a perfect view for my retirement.","Não é precioso? Este rio é tão tranquilo, uma vista perfeita para minha aposentadoria.");
 ds_map_add(m,"When you have the money come see me on the top floor of the hotel.","Quando tiver o dinheiro, venha me ver no último andar do hotel.");
 ds_map_add(m,"If you can get 1000 arcs I'll give you a girlfriend deal hehe.","Se conseguir juntar 1.000 Arcs, faço um pacote de namorada para você, hehe.");
 ds_map_add(m,"How much?","Quanto?");
 ds_map_add(m,"Haha so cute I'm sorry but I charged large amounts of money.","Haha, que gracinha. Desculpe, mas cobro caro.");
 ds_map_add(m,"hey she's a shy succubus why don't you help her out for old times.","Ei, ela é uma súcubo tímida. Por que não dá uma mãozinha a ela, pelos velhos tempos?");
 ds_map_add(m,"Yes but that was a long time ago.","Sim, mas isso foi há muito tempo.");
 ds_map_add(m,"Yes- yes I think you were this escort for shy succubus.","Sim, sim, acho que você era a garota de programa da súcubo tímida.");
 ds_map_add(m,"Oh so you do know me.","Ah, então você me conhece.");
 ds_map_add(m,"Oh! I remembered she was in the XXX magazines that your mother had.","Ah! Lembrei: ela aparecia nas revistas XXX que sua mãe tinha.");
 ds_map_add(m,"I don't think a girl with such innocent looks knows who I am.","Não acho que uma garota com uma aparência tão inocente saiba quem eu sou.");
 ds_map_add(m,"He-hello, do I know you from somewhere?","O-olá, será que conheço você de algum lugar?");
 ds_map_add(m,"I can't wait for you to have the money line, haha I haven't done this for a long time.","Mal posso esperar que você consiga o dinheiro, Line. Haha, faz muito tempo que não faço isso.");
 ds_map_add(m,"And you already know the prize <3.","E você já sabe qual é o prêmio <3.");
 ds_map_add(m,"The first to undress the other wins.","Quem despir a outra primeiro vence.");
 ds_map_add(m,"If you fail to undress I will take off one of your clothes.","Se você não conseguir tirar uma peça de roupa, eu tirarei uma das suas.");
 ds_map_add(m,"You will have attempts to undress me and you have to pay attention to where to touch.","Você terá algumas tentativas para me despir e precisa prestar atenção em onde tocar.");
 ds_map_add(m,"Oh you don't have enough Arcs.","Ah, você não tem Arcs suficientes.");
 ds_map_add(m,"Oh ok i will waiting here.","Ah, está bem. Vou esperar aqui.");
 ds_map_add(m,"Well to start heating things up we'll play a little game.","Bem, para esquentar as coisas, vamos jogar um joguinho.");
 ds_map_add(m,"No right now.","Agora não.");
 ds_map_add(m,"So Line you want to buy ten minute in heaven <3?","Então, Line, quer comprar dez minutos no paraíso <3?");
 ds_map_add(m,"sorry it's a bad habit from the past let's try again <3.","Desculpe, é um mau hábito antigo. Vamos tentar de novo <3.");
 ds_map_add(m,"You left me alone and naked in bed, and the maid also saw me ;C.","Você me deixou sozinha e nua na cama, e a empregada também me viu ;C.");
 ds_map_add(m,"haha it looks like you learned a lot <3.","Haha, parece que você aprendeu bastante <3.");
 ds_map_add(m,"Oh but something bad will happen but not to me.","Ah, mas alguma coisa ruim vai acontecer, só que não comigo.");
 ds_map_add(m,"She says get out of this place oh you're an idiot something could happen to you.","Ela diz para sair daqui. Ah, você é uma idiota! Alguma coisa pode acontecer com você.");
 ds_map_add(m,"Excuse? What the fuck did you say.","Como é? Que porra você disse?");
 ds_map_add(m,"Hey, what are you doing here? This is not a place for children.","Ei, o que está fazendo aqui? Este não é lugar para crianças.");
 ds_map_add(m,"And Baku still hasn't come back from the bathroom I'm starting to lose my patience.","E Baku ainda não voltou do banheiro. Estou começando a perder a paciência.");
 ds_map_add(m,"This sucks, there is no alcohol and everyone thinks I'm a minor.","Que droga, não tem álcool e todo mundo acha que sou menor de idade.");
 ds_map_add(m,"I think the next thing I'll do is go to the farm, dress like a cow and get milked.","Acho que a próxima coisa que vou fazer é ir à fazenda, vestir uma fantasia de vaca e ser ordenhada.");
 ds_map_add(m,"She says get out of this place something could happen to you.","Ela diz para sair daqui. Alguma coisa pode acontecer com você.");
 ds_map_add(m,"Excuse me, What the fuck did you say?.","Com licença, o que foi que você disse?!");
 ds_map_add(m,"Fuck you.","Vai se foder.");
 ds_map_add(m,"Looks Like you have nowhere to run.","Parece que você não tem para onde fugir.");
 ds_map_add(m,"Mmm...","Hmm...");
 ds_map_add(m,"After this I hope you rectify what you said.","Depois disso, espero que você retire o que disse.");
 ds_map_add(m,"So she's probably fine.","Então ela provavelmente está bem.");
 ds_map_add(m,"Well.. this is an island to free yourself and explore sexuality freely. Most likely, she's been fucking someone since yesterday.","Bem... esta ilha existe para que as pessoas se libertem e explorem a própria sexualidade. É bem provável que ela esteja transando com alguém desde ontem.");
 ds_map_add(m,"I guess you're right thanks that calms me down a bit.","Acho que você tem razão. Obrigada, isso me deixa um pouco mais tranquila.");
 ds_map_add(m,"Stay calm if something bad has happened, the most likely thing is that the guards would have already told you something.","Fique calma. Se algo ruim tivesse acontecido, provavelmente os guardas já teriam contado a você.");
 ds_map_add(m,"LiLi calm Alina","Lili acalma Alina");
 ds_map_add(m,"Line calm Alina","Line acalma Alina");
 ds_map_add(m,"I won a contest to travel to this island with my girlfriend but she went out yesterday to buy and has not returned yet.","Ganhei um concurso para viajar a esta ilha com minha namorada, mas ela saiu ontem para fazer compras e ainda não voltou.");
 ds_map_add(m,"But why would it be a bad idea to come? seems like a nice place.","Mas por que seria uma má ideia vir para cá? Parece um lugar agradável.");
 ds_map_add(m,"Oh sorry I heard as I passing by.","Ah, desculpe, ouvi enquanto passava.");
 ds_map_add(m,"Coming to this island was a bad idea.","Vir para esta ilha foi uma péssima ideia.");
 ds_map_add(m,"Lili!! ok im sorry for everything ok bye.","Lili!! Está bem, desculpe por tudo, está bem? Tchau.");
 ds_map_add(m,"Yeah there's no need to fight.","Isso, não precisamos brigar.");
 ds_map_add(m,"I'm sorry for making a fight, it was wrong.","Desculpe por ter começado uma briga. Foi errado da minha parte.");
 ds_map_add(m,"Thank you you are nothing like your fairy friend.","Obrigada. Você não é nem um pouco parecida com sua amiga fada.");
 ds_map_add(m,"While I'm looking for my friend I'll look for yours, don't worry, everything will be fine.","Enquanto procuro minha amiga, também vou procurar a sua. Não se preocupe, vai ficar tudo bem.");
 ds_map_add(m,"I'm so sorry for what my fairy said.","Sinto muito pelo que minha fada disse.");
 ds_map_add(m,"It has been a tiring day I will go to look for her after a nap.","Foi um dia cansativo. Vou tirar uma soneca e depois procurar por ela.");
 ds_map_add(m,"Oh poor little thing it's ok if it's true I will help you.","Ah, coitadinha. Tudo bem, se for verdade, vou ajudar você.");
 ds_map_add(m,"AHHHH that's what he said! Believe me or not that's your problem.","AAAAH! Foi isso que ele disse! Acredite ou não, o problema é seu.");
 ds_map_add(m,"Mmm really he said? I do not believe you at all Lili, do you know the story of peter and the wolf?","Hmm, foi isso mesmo que ele disse? Não acredito em você nem um pouco, Lili. Conhece a história do Pedro e o Lobo?");
 ds_map_add(m,"He said that his owner is out of control, they went to drink but on the way someone stole the key that his mistress uses as a demonic seal.","Ele disse que a dona dele está fora de controle. Eles iam beber, mas, no caminho, alguém roubou a chave que a senhora usa como selo demoníaco.");
 ds_map_add(m,"What did he say?","O que ele disse?");
 ds_map_add(m,"Bleb Bleb blub blub bleb,blub blub, blip blop blop.","Bleb bleb blub blub bleb, blub blub, blip blop blop.");
 ds_map_add(m,"Ya easy, I'll take care of it \nHey what's going on? Why is that thing moving like crazy if you're having sex in there at least try to keep a low profile.","Tá, fácil. Deixa comigo.\nEi, o que está acontecendo? Por que essa coisa está se mexendo feito louca? Se vocês estão transando aí dentro, pelo menos tentem não chamar atenção.");
 ds_map_add(m,"Oh Mmmm blup, blep blip?","Ah, hmm, blup, blep blip?");
 ds_map_add(m,"Bleb Bleb blub blub bleb.","Bleb bleb blub blub bleb.");
 ds_map_add(m,"Fuck it Line is fight or nothing!","Foda-se, Line. Ou lutamos ou não conseguimos nada!");
 ds_map_add(m,"Dissa-what?!","Desaparecer... o quê?!");
 ds_map_add(m,"Bu-but I do not have much money ;c.","M-mas não tenho muito dinheiro ;c.");
 ds_map_add(m,"I'm sorry but you have to disappear or pay your bill as a member.","Sinto muito, mas você precisa desaparecer ou pagar sua mensalidade como membro.");
 ds_map_add(m,"This is a secret place for members only, and the cost to be one is 10.000 arcs per month.","Este é um lugar secreto, exclusivo para membros. A mensalidade custa 10.000 Arcs.");
 ds_map_add(m,"I am Sieki and I really meant how you got here?","Sou Sieki. E eu perguntei mesmo: como você chegou aqui?");
 ds_map_add(m,"Ohmm... a friend told me here I could get some information about the girls on the island? I am looking for Sieki.","Hum... uma amiga me disse que eu poderia conseguir informações sobre as garotas da ilha aqui. Estou procurando Sieki.");
 ds_map_add(m,"You are the traveler what are you doing here?!","Você é a viajante! O que está fazendo aqui?!");
 ds_map_add(m,"Wait for me in the forest south of the hospital.","Espere por mim na floresta ao sul do hospital.");
 ds_map_add(m,"Dont worry I will take care of this demond","Não se preocupe, vou cuidar desse demônio.");
 ds_map_add(m,"Thank you very much for helping us so much we started it for you when we started selling the special milk of these cows.","Muito obrigada por toda a ajuda. Começamos a vender o leite especial dessas vacas por sua causa.");
 ds_map_add(m,"Um, yeah, it is okay,","Hum, sim, tudo bem.");
 ds_map_add(m,"Can you return it to the church? I would appreciate it a lot since I'm still organizing the cases of the other relics.","Pode devolvê-la à igreja? Eu ficaria muito agradecida, pois ainda estou organizando os casos das outras relíquias.");
 ds_map_add(m,"(Phew, how stressful.) Well, it does not matter. The important thing is that the relic is back.","(Ufa, que estresse.) Bem, não importa. O importante é que a relíquia voltou.");
 ds_map_add(m,"Hmm, well, when the robbery happened, you weren't even on the island. I guess I can rule you out as a suspect.","Hmm, bem, quando o roubo aconteceu, você nem estava na ilha. Acho que posso descartá-la como suspeita.");
 ds_map_add(m,"*Starts to sweat but maintains eye contact *... Crazy, right?","*Começa a suar, mas mantém contato visual*... Loucura, não é?");
 ds_map_add(m,"But your story still seems strange...","Mas sua história ainda parece estranha...");
 ds_map_add(m,"Hmm, the witnesses said the thief went south of the church.","Hmm, as testemunhas disseram que o ladrão foi para o sul da igreja.");
 ds_map_add(m,"I-it's possible that the person got l-lost or went m-mad in the forest and ended up l-leaving it behind. I-I didn't find anything else besides the relic.","É-é possível que a pessoa tenha se p-perdido ou enlouquecido na floresta e a tenha d-deixado para trás. E-eu não encontrei nada além da relíquia.");
 ds_map_add(m,"Wait, but how is that possible? Why would it be lying there?!","Espere, mas como isso é possível? Por que ela estaria jogada ali?!");
 ds_map_add(m,"Captain, I found a relic in the forest.","Capitã, encontrei uma relíquia na floresta.");
 ds_map_add(m,"Have you left the relic at the church already?","Você já deixou a relíquia na igreja?");
 ds_map_add(m,"Yes, we will be exemplary citizens of society!","Sim, seremos cidadãos exemplares!");
 ds_map_add(m,"We already know what to do Line!","Já sabemos o que fazer, Line!");
 ds_map_add(m,"Very well, I appreciate you staying safe.","Muito bem. Agradeço por terem tomado cuidado.");
 ds_map_add(m,"I won't even think about the place, that's how dedicated I am to not making trouble!","Nem vou pensar naquele lugar. É assim que estou comprometida a não causar problemas!");
 ds_map_add(m,"Lastly, there is a scammer posing as a guard you can see her description on the flyers around town and if I were to say one place you shouldn't go it would be the bridge that leads to the magenta swamp.","Por último, há uma golpista se passando por guarda. Você pode ver a descrição dela nos panfletos espalhados pela cidade. E, se eu tivesse que indicar um lugar onde vocês não deveriam ir, seria a ponte que leva ao Pântano Magenta.");
 ds_map_add(m,"I think I'm familiar with your description, we'll stay out of it <3","Acho que reconheço essa descrição. Vamos ficar longe disso <3");
 ds_map_add(m,"Sometimes from time to time, a foreign heroine comes to catch criminals escaping from her sector, so if you see a lady in a bikini with light blue hair around here in the jail-farm, don't bother her.","De vez em quando, uma heroína estrangeira aparece para capturar criminosos que escaparam de seu território. Então, se vir uma mulher de biquíni e cabelo azul-claro perto da Fazenda-Prisão, não a incomode.");
 ds_map_add(m,"Noted :O","Entendido :O");
 ds_map_add(m,"Right, first of all stay away from the group of guards in the bar where they are planning how to defeat a demon that steals supplies.","Certo. Primeiro, fiquem longe do grupo de guardas no bar. Eles estão planejando como derrotar um demônio que rouba carregamentos de suprimentos.");
 ds_map_add(m,"... and which places should we not go to stay out of the way :v?","... E quais lugares devemos evitar para não atrapalhar? :v");
 ds_map_add(m,"No, stay out of the issue, citizens.","Não. Fiquem fora disso, cidadãos.");
 ds_map_add(m,"Hey, what if we help solve those problems?","Ei, e se ajudássemos a resolver esses problemas?");
 ds_map_add(m,"The barn will be up and running again once we have dealt with the problems.","O celeiro voltará a funcionar quando resolvermos os problemas.");
 ds_map_add(m,"We are at the limit because of the increase in crime on the islands.","Estamos no limite por causa do aumento da criminalidade nas ilhas.");
 ds_map_add(m,"Now you cannot enter the barn.","Agora você não pode entrar no celeiro.");
 ds_map_add(m,"Remember, don't be heroes, not everyone can be a guard of Elira.","Lembre-se: não banque o herói. Nem todo mundo pode ser um guarda de Elira.");
 ds_map_add(m,"But you can ask local owners or even artists on the streets.","Mas você pode perguntar aos comerciantes locais ou até aos artistas de rua.");
 ds_map_add(m,"I see a lot of people a day, so I couldn't tell you that I did see her.","Vejo muita gente todos os dias, então não posso afirmar que a tenha visto.");
 ds_map_add(m,"Oh thank you very much, by chance you have seen a woman with wings on her head.","Ah, muito obrigada. Por acaso você viu uma mulher com asas na cabeça?");
 ds_map_add(m,"Welcome to the cariel town.","Bem-vindo à cidade de Cariel.");
 ds_map_add(m,"Oh-ok :c.","Ah, está bem :c.");
 ds_map_add(m,"I'm sorry miss but it's closed for now.","Desculpe, senhorita, mas está fechado por enquanto.");
 ds_map_add(m,"The great captain gave the order to take care of the town while she searches for the demon.","A Grande Capitã ordenou que cuidássemos da cidade enquanto ela procura o demônio.");
 ds_map_add(m,"Then what do we do?","Então, o que fazemos?");
 ds_map_add(m,"That bastard.","Aquele desgraçado.");
 ds_map_add(m,"Everything indicates that so far.","Até agora, tudo aponta para isso.");
 ds_map_add(m,"Is the cause of alcohol not reaching the town?","É por isso que o álcool não está chegando à cidade?");
 ds_map_add(m,"The traveler defeated a succubus but this is a high rank demon.","A viajante derrotou uma súcubo, mas este é um demônio de alto escalão.");
 ds_map_add(m,"A demon? I heard a traveler beat her.","Um demônio? Ouvi dizer que uma viajante a derrotou.");
 ds_map_add(m,"Yes, apparently there is something on the outskirts of town.","Sim, aparentemente há alguma coisa nos arredores da cidade.");
 ds_map_add(m,"What seriously?","O quê? Sério?");
 ds_map_add(m,"This for you traveler!!!","Isto é para você, viajante!!!");
 ds_map_add(m,"I think this is the last beer in the bar.","Acho que esta é a última cerveja do bar.");
 ds_map_add(m,"I'm finall *hip* drunk enough to tell Callie to go out with me.","Finalmente estou *soluç* bêbado o bastante para convidar Callie para sair.");
 ds_map_add(m,"No drinks.. no courage.","Sem bebida... sem coragem.");
 ds_map_add(m,"Life makes sense again <3 !!","A vida voltou a fazer sentido <3!!");
 ds_map_add(m,"I should patrol while I wait for the next shipment.","Devo patrulhar enquanto espero o próximo carregamento.");
 ds_map_add(m,"Finally Beer!!!!","Finalmente, cerveja!!!!");
 ds_map_add(m,"This is so boring.","Que tédio.");
 ds_map_add(m,"yes unfortunately, that's why I must hurry","Sim, infelizmente. Por isso preciso me apressar.");
 ds_map_add(m,"what and were there people there ?!","O quê? E havia pessoas lá?!");
 ds_map_add(m,"I'm sorry miss there was a landslide will be available when I manage to open the way.","Sinto muito, senhorita. Houve um deslizamento de terra. O caminho estará disponível quando eu conseguir desobstruí-lo.");
 ds_map_add(m,"Please, can you go see how the miners are, I would go but I'm very tired.","Por favor, pode verificar como estão os mineiros? Eu iria, mas estou muito cansado.");
 ds_map_add(m,"Sound cooler.","Soa mais legal.");
 ds_map_add(m,"Why Lilian?","Por que Lilian?");
 ds_map_add(m,"Lilian for you.","Para você, sou Lilian.");
 ds_map_add(m,"Understood Miss Faery.","Entendido, senhorita fada.");
 ds_map_add(m,"The great captain told me to stay here until she came back.","A Grande Capitã mandou que eu ficasse aqui até ela voltar.");
 ds_map_add(m,"there is a dangerous demon prowling, I advise you to go to the town which is a safer place","Há um demônio perigoso rondando por aqui. Recomendo que vá para a cidade, que é mais segura.");
 ds_map_add(m,"Sorry Miss the pass to the forest is closed.","Desculpe, senhorita, a passagem para a floresta está fechada.");
 ds_map_add(m,"Now let us pass!","Agora deixe-nos passar!");
 ds_map_add(m,"Excuse me? We are the bounty hunters hired by the great captain to kill the demond.","Como assim? Somos caçadores de recompensa contratados pela Grande Capitã para matar o demônio.");
 ds_map_add(m,"I'll stay here guarding.","Vou ficar aqui de guarda.");
 ds_map_add(m,"I will rest here a little.","Vou descansar um pouco aqui.");
 ds_map_add(m,"Excuse me?","Com licença?");
 ds_map_add(m,"these guards are idiots they didn't even see the trail.","Esses guardas são idiotas. Nem perceberam o rastro.");
 ds_map_add(m,"I will go see maybe we will find something.","Vou dar uma olhada. Talvez encontremos alguma coisa.");
 ds_map_add(m,"Look Line there's a trace of this thing coming behind the red tent.","Olha, Line! Há um rastro dessa coisa vindo de trás da tenda vermelha.");
 ds_map_add(m,"Ok calm down I will help you get this thing off.","Calma, vou ajudar você a tirar isso.");
 ds_map_add(m,"I would not know very well which of her children it could be, but I do know that it was a lady cat.","Não sei exatamente qual dos filhos dela poderia ser, mas sei que era uma mulher-gato.");
 ds_map_add(m,"Sir, did you see where the culprit went, was it really the daughter of the cat that sells clothes the culprit?.","Senhor, viu para onde o culpado foi? Foi mesmo a filha da mulher-gato que vende roupas?");
 ds_map_add(m,"Seems to be waking up.","Parece que está acordando.");
 ds_map_add(m,"Hey look Lili.","Ei, olha, Lili.");
 ds_map_add(m,"Tell me something I do not know.","Me conte algo que eu ainda não saiba.");
 ds_map_add(m,"We are the best guards in town.","Somos os melhores guardas da cidade.");
 ds_map_add(m,"Let's look for the guard who was left unconscious.","Vamos procurar o guarda que foi deixado inconsciente.");
 ds_map_add(m,"Yea even the culprit could know something about Ava and the strange things that happen on the island.","Sim, até o culpado pode saber alguma coisa sobre Ava e sobre as coisas estranhas que acontecem na ilha.");
 ds_map_add(m,"Lili we must help them they do not seem to be lying.","Lili, precisamos ajudá-los. Eles não parecem estar mentindo.");
 ds_map_add(m,"Mama I swear I didn't it was a blue cat.","Mamãe, juro que não fui eu. Foi um gato azul.");
 ds_map_add(m,"What!!","O quê?!");
 ds_map_add(m,"Due  she is a minor, you will have to pay the fine at the jail-farm.","Como ela é menor de idade, você terá que pagar a multa na Fazenda-Prisão.");
 ds_map_add(m,"One of her daughter's pranks left one of the guards unconscious.","Uma das pegadinhas da filha dela deixou um dos guardas inconsciente.");
 ds_map_add(m,"I'm afraid that is more serious than that.","Receio que seja mais grave do que isso.");
 ds_map_add(m,"Now leave if you are not going to buy something.","Agora vá embora, se não pretende comprar nada.");
 ds_map_add(m,"Oh c'mon are just pranks how serious it can be.","Ah, qual é? São só pegadinhas. Quão grave isso pode ser?");
 ds_map_add(m,"Miss I must inform your daughter she has been seen making pranks to the people of this town.","Senhora, preciso informar que sua filha foi vista pregando peças nas pessoas desta cidade.");
 ds_map_add(m,"Mom!! are you listening to me? ;c Mom!!!.","Mamãe!! Você está me ouvindo? ;c Mamãe!!!");
 ds_map_add(m,"And the guards are blaming me.","E os guardas ainda estão me culpando.");
 ds_map_add(m,"Mom there is a cat doing pranks to people.","Mãe, tem um gato fazendo pegadinhas com as pessoas.");
 ds_map_add(m,"leave my mommy alone.","Deixe minha mamãe em paz.");
 ds_map_add(m,"I'm not going to that place with that sucking milk machine 2000.","Não vou para aquele lugar com aquela máquina de ordenha 2000.");
 ds_map_add(m,"Come on miss, accompany me to jail-farm.","Vamos, senhorita, acompanhe-me até a Fazenda-Prisão.");
 ds_map_add(m,"Calm love, I'll be back in a few days.","Calma, meu amor. Volto em alguns dias.");
 ds_map_add(m,"But mommy ;c","Mas, mamãe... ;c");
 ds_map_add(m,"I don't care, it's was worthed.","Não me importo. Valeu a pena.");
 ds_map_add(m,"I will take you to the jail-farm for assault on social security entities.","Vou levá-la à Fazenda-Prisão por agredir agentes responsáveis pela segurança pública.");
 ds_map_add(m,"And you fucking inoperative social parasite you should learn how to do your fucking job before you put people in jail.","E você, seu parasita social inútil do caralho, devia aprender a fazer seu maldito trabalho antes de mandar as pessoas para a prisão!");
 ds_map_add(m,"Of course they are innocent, children cover your ears.","É claro que são inocentes. Crianças, tapem os ouvidos.");
 ds_map_add(m,"Really? It seems her daughters were innocent after all.","Sério? Parece que, afinal, as filhas dela eram inocentes.");
 ds_map_add(m,"Wait there were new attacks on other people it couldn't be his daughters they were here with you.","Espere, houve novos ataques contra outras pessoas. Não podem ter sido as filhas dela, elas estavam aqui com você.");
 ds_map_add(m,"I'm sorry miss will you have to come with me or you will have increased the time in jail-farm.","Sinto muito, senhorita, mas terá que vir comigo, ou sua pena na Fazenda-Prisão vai aumentar.");
 ds_map_add(m,"Of course not, you closet slut.","Claro que não, sua vadia enrustida.");
 ds_map_add(m,"But, I don't really care much about those powers.","Mas, na verdade, não me interesso muito por esses poderes.");
 ds_map_add(m,"Yes, but the good side is that you can buy clothes and absorb them into your sacred clothes, these will change in combat which will improve your half-succubus abilities <3.","Sim, mas a parte boa é que você pode comprar roupas e absorvê-las em suas vestes sagradas. Elas mudarão durante o combate e aprimorarão suas habilidades de meio-súcubo <3.");
 ds_map_add(m,"What?! b-but these clothes are sacred, my father will be very angry :c.","O quê?! M-mas essas roupas são sagradas, meu pai vai ficar muito bravo :c.");
 ds_map_add(m,"Before going to chase the angel, your mother imbue succubus magic in the elven clothes your father gave you.","Antes de sair atrás do anjo, sua mãe imbuiu de magia súcubo as roupas élficas que seu pai lhe deu.");
 ds_map_add(m,"Oh no, Lili and now what have you done.","Ah, não... Lili, o que você aprontou agora?");
 ds_map_add(m,"Emmm. yes .. but there is something I didn't tell you.","Ééé... sim... mas tem uma coisa que não contei.");
 ds_map_add(m,"But for what, the magic clothes that my father gave me are enough to fight.","Mas para quê? As roupas mágicas que meu pai me deu já são suficientes para lutar.");
 ds_map_add(m,"Line look a store maybe you can buy new equipment.","Line, olha! Uma loja. Talvez você possa comprar equipamentos novos.");
 ds_map_add(m,"Select the 'natural' option.","Selecione a opção 'Natural'.");
 ds_map_add(m,"Then you go to equipment and in the section where you have the boots on.","Depois, entre em Equipamento e vá até o espaço onde ficam as botas.");
 ds_map_add(m,"You have to go to the menu press enter.","Você precisa abrir o menu e apertar Enter.");
 ds_map_add(m,"Line to take off your boots.","Line, tire as botas.");
 ds_map_add(m,"Oh ok but that is within the normal :s but if it is required, I can could trie more things.","Ah, está bem, mas isso ainda está dentro do normal :s. Se for necessário, posso tentar outras coisas.");
 ds_map_add(m,"Yeah shure, she seemed somewhat annoyed if we help her, she will most likely give us a price cut,are you with me Line?","Claro! Ela parece meio irritada. Se a ajudarmos, provavelmente vai nos dar um desconto. Está comigo, Line?");
 ds_map_add(m,"No! You're wrong, I just want to be a little stronger, nothing more.","Não! Você entendeu errado. Só quero ficar um pouco mais forte, nada além disso.");
 ds_map_add(m,"Oh so now you want new stuff, don't pretend to be a saint you wanted to excite your opponents with new clothes.","Ah, então agora você quer coisas novas? Não finja ser uma santa. Você queria deixar seus oponentes excitados com roupas novas.");
 ds_map_add(m,"What are we going to do Lili :s.","O que vamos fazer, Lili? :s");
 ds_map_add(m,"What the hell! those prices.","Que porra é essa?! Olha esses preços!");
 ds_map_add(m,"AHHH FORGET WHAT YOU SAW!","AAAAH, ESQUEÇA O QUE VOCÊ VIU!");
 ds_map_add(m,"Oh, I almost forgot, give these pamphlets to the people.","Ah, quase esqueci: distribua estes panfletos para as pessoas.");
 ds_map_add(m,"I might know where he could be.","Talvez eu saiba onde ele pode estar.");
 ds_map_add(m,"Of course, if she came to this island for the same reason that all tourists come.","Claro, se ela veio a esta ilha pelo mesmo motivo que todos os turistas vêm.");
 ds_map_add(m,"If I help you, could you help us by getting information from my friend?","Se eu ajudar você, poderia nos ajudar conseguindo informações com minha amiga?");
 ds_map_add(m,"People have to know that the red tent will open soon so im kinda busy.","As pessoas precisam saber que a tenda vermelha vai abrir em breve, então estou meio ocupada.");
 ds_map_add(m,"I'm sorry, sweetie but now I can't, I'm going to do stand up to attract some people.","Sinto muito, querida, mas agora não posso. Vou fazer um show de stand-up para atrair algumas pessoas.");
 ds_map_add(m,"Hi, can you give me a little of your time? I'm looking for a friend.","Oi, pode me dar um minutinho? Estou procurando uma amiga.");
 ds_map_add(m,"Give those pamphlets to people while I get ready.","Distribua esses panfletos enquanto eu me preparo.");
 ds_map_add(m,"You should have told me that you like these types of shows. we could one of us here <3.","Você devia ter me contado que gosta desse tipo de show. A gente podia fazer um por aqui também <3.");
 ds_map_add(m,"You can see the place while we prepare all.","Pode conhecer o lugar enquanto preparamos tudo.");
 ds_map_add(m,"oh You don't have to thank me, oh I almost forgot the circus is still in preparation but there a girl with pink hair near the stands that you might like.","Ah, não precisa agradecer. Quase esqueci: o circo ainda está sendo preparado, mas há uma garota de cabelo rosa perto das arquibancadas de quem você talvez goste.");
 ds_map_add(m,"I'm good , and thank for the information and the other thing hehe.","Estou bem, obrigada pelas informações... e pela outra coisa também, hehe.");
 ds_map_add(m,"*whisper* oh god the jokes of this bitch.","*sussurrando* Meu Deus, que piadas idiotas dessa vadia.");
 ds_map_add(m,"Hi Line, how have you bee-n.","Oi, Line, como você teeem passado?");
 ds_map_add(m,"Hi MsHonney.","Oi, Sra. Honney.");
 ds_map_add(m,"welcome to the green hills hotel at the moment we do not have rooms available","Bem-vindo ao Hotel Colinas Verdes. No momento, não temos quartos disponíveis.");
 ds_map_add(m,"Welcome to the green hills hotel at the moment we do not have rooms available.","Bem-vindo ao Hotel Colinas Verdes. No momento, não temos quartos disponíveis.");
 ds_map_add(m,"Go to the door on the left she will be waiting for you.","Vá até a porta à esquerda. Ela estará esperando por você.");
 ds_map_add(m,"Wow I never thought that a young girl who looks so innocent would go to see her.","Uau, nunca imaginei que uma garota tão jovem e com aparência tão inocente fosse visitá-la.");
 ds_map_add(m,"Oh-sorry i havent sleep lately.","Ah, desculpe. Não tenho dormido direito ultimamente.");
 ds_map_add(m,"Geez Line control yourself.","Caramba, Line, se controle.");
 ds_map_add(m,"What?","O quê?");
 ds_map_add(m,"I love you.","Eu te amo.");
 ds_map_add(m,"Mshonney have new workers.","A Sra. Honney tem novos funcionários.");
 ds_map_add(m,"Welcome to the green hills hotel.","Bem-vindo ao Hotel Colinas Verdes.");
 ds_map_add(m,"ok ok just give me a sec","Está bem, está bem, só me dê um segundo.");
 ds_map_add(m,"I will sell it and be free again.","Vou vendê-la e finalmente ficar livre.");
 ds_map_add(m,"I escaped from jail but I had no place to go or money, this place is my only option, I must win the golden key.","Fugi da prisão, mas não tinha para onde ir nem dinheiro. Este lugar é minha única opção. Preciso ganhar a chave dourada.");
 ds_map_add(m,"I-I can't here callie, you know I'm shy, there are a lot of people here","E-eu não posso fazer isso aqui, Callie. Você sabe que sou tímida, tem muita gente por aqui.");
 ds_map_add(m,"But your love, you can take it right here.","Mas, meu amor, você pode demonstrar seu carinho por mim bem aqui.");
 ds_map_add(m,"My children are the best <3 tell him that here it is not so bad, they even pay me to produce milk.","Meus filhos são maravilhosos <3. Diga a ele que aqui nem é tão ruim assim. Até me pagam para produzir leite.");
 ds_map_add(m,"Oh ok, your kids send you good vibes since they can't come.","Ah, está bem. Seus filhos mandam boas energias, já que não podem vir.");
 ds_map_add(m,"Sorry here just let us say moo.","Desculpe, aqui só podemos dizer 'mu'.");
 ds_map_add(m,"Whaaat?.","O quêêê?");
 ds_map_add(m,"Mooo.","Muuu.");
 ds_map_add(m,"Hey Line come here.","Ei, Line, venha aqui.");
 ds_map_add(m,"Yes, she wants me to stay close to her since I am 18 years old and she doesn't want me to go to places that were previously restricted to me on the island.","Sim. Ela quer que eu fique por perto porque tenho 18 anos e não quer que eu vá a lugares da ilha que antes eram proibidos para mim.");
 ds_map_add(m,"Wait are you the saleswoman's son?","Espere, você é filho da vendedora?");
 ds_map_add(m,"Bye I have to go","Tchau, preciso ir.");
 ds_map_add(m,"No, but I know that north from here they did the same to a fox girl.","Não, mas sei que, ao norte daqui, fizeram a mesma coisa com uma garota-raposa.");
 ds_map_add(m,"Wait do you know who did this to you?","Espere, você sabe quem fez isso com você?");
 ds_map_add(m,"Thanks I have to go.","Obrigado, preciso ir.");
 ds_map_add(m,"Oh do not worry I will take that thing from you.","Ah, não se preocupe. Vou tirar essa coisa de você.");
 ds_map_add(m,"yeah she went to the cultivation of nana leaves.","Sim, ela foi para a plantação de folhas de nana.");
 ds_map_add(m,"Thank you lady unicorn but be careful that cat likes to prank people :c.","Obrigada, senhora unicórnio, mas cuidado: aquele gato gosta de pregar peças nas pessoas :c.");
 ds_map_add(m,"Oh I just got to the town but if I see it I'll let you know <3.","Ah, acabei de chegar à cidade, mas, se eu a vir, aviso você <3.");
 ds_map_add(m,"Mmm no, and have you seen a blue cat by chance?","Hmm, não. Por acaso você viu um gato azul?");
 ds_map_add(m,"Hello by chance have you seen someone with wings on their head?","Olá, por acaso você viu alguém com asas na cabeça?");
 ds_map_add(m,"yeah just give use the money","Isso mesmo, é só nos dar o dinheiro.");
 ds_map_add(m,"That is, if they do not return with the money on time you will have to work in the village dairy farm to pay it","Ou seja, se não voltarem com o dinheiro no prazo, terão que trabalhar na fazenda leiteira da vila para pagar a dívida.");
 ds_map_add(m,"We take the money","Nós ficamos com o dinheiro.");
 ds_map_add(m,"sounds really easy actually","Na verdade, parece bem fácil.");
 ds_map_add(m,"It's easy, I'll lend you money and you return it to me later with an extra 10%","É simples: empresto o dinheiro e você me devolve depois, com mais 10%.");
 ds_map_add(m,"Oh ok what do we have to do?","Ah, está bem. O que precisamos fazer?");
 ds_map_add(m,"I don't know Line having money is always good","Não sei, Line. Ter dinheiro é sempre bom.");
 ds_map_add(m,"Me mmm .. not really","Eu? Hmmm... não muito.");
 ds_map_add(m,"Hey you look like you need money.","Ei, você está precisando de dinheiro, não é?");
 ds_map_add(m,"Great just sign here.","Ótimo, é só assinar aqui.");
 ds_map_add(m,"Amazing, it's great to do deals with you.","Incrível! É ótimo fazer negócios com você.");
 ds_map_add(m,"I gave you 1000 arcs plus 10%, you should give me back 1100.","Emprestei 1.000 Arcs, mais 10%. Você deve me devolver 1.100.");
 ds_map_add(m,"No, sorry you will have the money later.","Não, desculpe. Você receberá o dinheiro mais tarde.");
 ds_map_add(m,"Yes, here is your money.","Sim, aqui está seu dinheiro.");
 ds_map_add(m,"You are going to give my money back?","Veio devolver meu dinheiro?");
 ds_map_add(m,"Sure just sign here","Claro, é só assinar aqui.");
 ds_map_add(m,"He-hello could you lend me money again?","O-olá, poderia me emprestar dinheiro de novo?");
