 ds_map_add(m,"Rynn are you, drinking what happened to the table you broke?","Rynn, você está bebendo? E a mesa que você quebrou, o que aconteceu com ela?");
 ds_map_add(m,"Ah you're coming for a rematch?! Well, that's good hahaha.","Ah, veio pedir revanche?! Muito bem, hahaha.");
 ds_map_add(m,"Hey relax skinny girl what happened in the bathroom stays in the bathroom.","Ei, relaxa, magricela. O que acontece no banheiro fica no banheiro.");
