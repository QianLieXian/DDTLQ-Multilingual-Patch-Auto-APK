 ds_map_add(m,"Hey you pull up your pants before we break your ass. And you slut, you will come with us whether you want to or not!","Ei, levante as calças antes que a gente arrebente sua bunda. E você, vadia, vai vir conosco, querendo ou não!");
 ds_map_add(m,"Ivy said if she refuses to come with us we can use force.","Ivy disse que, se ela se recusasse a vir conosco, poderíamos usar a força.");
 ds_map_add(m,"Calm down it's not like she's not enjoying this right now.","Calma. Não é como se ela não estivesse gostando disso agora.");
 ds_map_add(m,"Here you are you little slut, is time to go back were you belong.","Aqui está você, sua vadiazinha. Está na hora de voltar para o lugar a que pertence.");
 ds_map_add(m,"Yes let's go back to mommy hehe.","Isso mesmo. Vamos voltar para a mamãe, hehe.");
