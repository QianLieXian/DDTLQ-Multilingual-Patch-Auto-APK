 ds_map_add(m,"*Blurp* only if a draw is a win for you skinny girl yeah.","*Arrota* Só se um empate contar como vitória para você, magricela.");
 ds_map_add(m,"OoOoOHHhh I think I win?","OOOOHHH, acho que ganhei?");
 ds_map_add(m,"Uh... yeah... I think I want to go to the bathroom too.","É... sim... acho que também quero ir ao banheiro.");
 ds_map_add(m,"Oh before I go, hehe, I think you've had too many drinks, why not drink some water?","Ah, antes de ir, hehe, acho que você bebeu demais. Que tal tomar um pouco de água?");
 ds_map_add(m,"Ohh... thanks a lot Rynn I will stay away from there.","Ahh... muito obrigada, Rynn. Vou ficar longe daquele lugar.");
 ds_map_add(m,"All right, but just to be sure, *Slurrrp* don't go behind the hospital, there's that old creep, I don't want anything to happen to you.","Está bem, mas, só por precaução, *glup*, não vá para os fundos do hospital. Aquele velho tarado está lá, e não quero que nada aconteça com você.");
 ds_map_add(m,"I will not. I will be good.","Não vou. Vou me comportar.");
 ds_map_add(m,"*Glup glup* Ahhhh Well but I promised the fairy that you wouldn't get in trouble. *Slurrrp*","*Glup, glup* Ahhh... bem, mas prometi à fada que você não se meteria em encrenca. *glup*");
 ds_map_add(m,"Oh, really I wanted to continue exploring the island.","Ah, sério? Eu queria continuar explorando a ilha.");
 ds_map_add(m,"Hey skinny let's drink While we wait for your friend.","Ei, magricela, vamos beber enquanto esperamos sua amiga.");
 ds_map_add(m,"Come on Lili I am not a child.","Vamos, Lili. Não sou criança.");
 ds_map_add(m,"-_-II that doesn't calm me down.","-_-II isso não me tranquiliza.");
 ds_map_add(m,"Yeah don't worry, she will be with me if she needs help with anything or to talk to anyone, I will be here.","É, não se preocupe. Ela ficará comigo. Se precisar de ajuda com alguma coisa ou quiser conversar com alguém, estarei aqui.");
