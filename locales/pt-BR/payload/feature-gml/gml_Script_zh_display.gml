 ds_map_add(m,"How could I forget, come Line, Mommy has something just for you hehe..","Como eu poderia esquecer? Venha, Line. A mamãe tem algo só para você, hehe...");
 ds_map_add(m,"hey don't you owe something to my friend?","Ei, você não está devendo alguma coisa à minha amiga?");
 ds_map_add(m,"It feels great to have my height back <3.","É ótimo ter minha altura de volta <3.");
 ds_map_add(m,"*Line uncaps the bottle and Ivy is back to her original height*","*Line destampa o frasco, e Ivy volta à sua altura original*");
 ds_map_add(m,"Oh I put it in a bottle, wait for me a second.","Ah, coloquei num frasco. Espere um segundo.");
