 ds_map_add(m,"So get out of here, you fat, filthy creep!","Então caia fora daqui, seu velho gordo, imundo e tarado!");
 ds_map_add(m,"HEY, LISTEN TO ME, YOU FUCKING SCUMBAG! She'll do what she wants with her body, but she'll never sell it.","EI, ESCUTE AQUI, SEU DESGRAÇADO DO CARALHO! Ela faz o que quiser com o próprio corpo, mas nunca vai vendê-lo.");
 ds_map_add(m,"Eheheh and what about you Miss Elf? I have five Thousand Arcs here-","Hehehe, e você, senhorita elfa? Tenho cinco mil Arcs aqui...");
 ds_map_add(m,"EIHhh!","EIIHH!");
 ds_map_add(m,"I DON'T WANT TO HAVE SEX WITH HIM FOR MONEY, ESPECIALLY IF HE'S A FAT UGLY BASTARD LIKE YOU!","EU NÃO QUERO FAZER SEXO COM ELE POR DINHEIRO, PRINCIPALMENTE SE ELE FOR UM BASTARDO GORDO E FEIO COMO VOCÊ!");
 ds_map_add(m,"This disgusting old man stinking of pee and semen can't understand. *Slurrrp*","Esse velho nojento, fedendo a urina e sêmen, não consegue entender. *glup*");
 ds_map_add(m,"Wha-what happened Rynn?","O-o que aconteceu, Rynn?");
 ds_map_add(m,"AHHHGG What a pain in the ass!","AAAAHGG, que dor de cabeça!");
 ds_map_add(m,"Well then let's make this a unique occasion, open your eyes now.","Bem, então vamos tornar esta ocasião única. Abra os olhos agora.");
