 ds_map_add(m,"Forgive her please, she has no filters when she speaks :c.","Por favor, perdoe-a. Ela não tem filtro quando fala :c.");
 ds_map_add(m,"Ahhh Lili shut up already! I mean she might be sick from the swamp.","Ahhh, Lili, já chega! Quero dizer, talvez ela tenha ficado doente por causa do pântano.");
 ds_map_add(m,"And that does not include us, we were born with this hair color.","E isso não inclui a gente. Nascemos com essa cor de cabelo.");
 ds_map_add(m,"Yeah, she is crazy.","Sim, ela é maluca.");
 ds_map_add(m,"Relax Lili she is probably his sister, she looks just like the bartender although she has short red hair, you know what that means.","Calma, Lili. Ela provavelmente é irmã dele. É muito parecida com a bartender, embora tenha cabelo ruivo curto. Você sabe o que isso significa.");
 ds_map_add(m,"Hey but you didn't answer my question!","Ei, mas você não respondeu à minha pergunta!");
 ds_map_add(m,"This place is for VIP clients where they can compete to see what can satisfy the needs of our other clients.","Este lugar é reservado aos clientes VIP, que podem competir para ver quem consegue satisfazer melhor as necessidades dos outros clientes.");
 ds_map_add(m,"Hey, are you the bartender's sister?","Ei, você é irmã da bartender?");
 ds_map_add(m,"Welcome to the 1 V 1 for the GLORY! hole.","Bem-vindos ao 1 contra 1 pela GLÓRIA do glory hole!");
 ds_map_add(m,"The competition to find out who is the best onahole is for VIP customers only.","A competição para descobrir quem é a melhor boneca sexual é exclusiva para clientes VIP.");
 ds_map_add(m,"No thanks, we're just passing by.","Não, obrigada. Estamos só de passagem.");
 ds_map_add(m,"Welcome, are you coming back to compete?","Bem-vinda! Vai voltar para competir?");
 ds_map_add(m,"Haha you're welcome, whatever else you need come see me. (but if you need a foot massage or something, I'm here pretty)","Haha, por nada. Se precisar de mais alguma coisa, venha falar comigo. (Mas, se quiser uma massagem nos pés ou algo assim, estou à disposição, bonitona.)");
