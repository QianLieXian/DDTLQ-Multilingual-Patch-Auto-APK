 ds_map_add(m,"Thank you, to get to the library just follow this road to the west of town.","Obrigado. Para chegar à biblioteca, basta seguir esta estrada em direção ao oeste da cidade.");
 ds_map_add(m,"Mmmm I will see if I can find out anything, do not worry, you can go back to reading your favorite books.","Hmm, vou ver se descubro alguma coisa. Não se preocupe, pode voltar a ler seus livros favoritos.");
 ds_map_add(m,"I don't know, the librarian is missing so the library is closed.","Não sei. O bibliotecário desapareceu, então a biblioteca está fechada.");
 ds_map_add(m,"Oh, why what happened?","Ah, por quê? O que aconteceu?");
 ds_map_add(m,"Aw man, I wanted to go to the library.","Poxa, eu queria ir à biblioteca.");
 ds_map_add(m,"You find anything yet?","Já encontrou alguma coisa?");
 ds_map_add(m,"Mmmmm, oHhh, Ah ha wooooow.\nI forgot I can't read.","Hmmmm, ooooh, ahá, uaaaaau.\nEsqueci que não sei ler.");
