var s=string(argument0);
if(!variable_global_exists("zh_display_map"))global.zh_display_map=-1;
if(!ds_exists(global.zh_display_map,ds_type_map)){
 global.zh_display_map=ds_map_create();
 var m=global.zh_display_map;
 ds_map_add(m,"Piercing","Perfuração");
 ds_map_add(m,"Impact","Impacto");
 ds_map_add(m,"Cut","Corte");
 ds_map_add(m,"Hp","PV");
 ds_map_add(m,"Mp","PM");
 ds_map_add(m,"Nature","Natureza");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Uff, Bigg Daddy... Espero que um dia ele também me trate com carinho, como sua filhinha.");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","De algum jeito, ela descobriu meu nome. Talvez, se eu a encontrar, consiga descobrir por que ela me conhece.");
 ds_map_add(m,"Ms honney","Sra. Honney");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","Ahhh <3, a Sra. Honney é incrível! Bastou olhar para mim para enxergar quem eu realmente sou. Ah, quase esqueci: ela também me ajudou a conseguir informações.");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","Ah, Rynn! Lembro que ela estava completamente bêbada na taverna, resmungando algo sobre o império ter apagado parte da história ou coisa assim. Bom, não prestei muita atenção... fiquei distraída olhando para os abdômens dela.");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","Ah, lembro dessa baixinha coitada. Lili a confundiu com uma garotinha, e ela ficou furiosa na mesma hora. Aff, por que essa fadinha vive me metendo em encrenca...");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","Alina ainda está esperando pela amiga. Tomara que elas consigam se encontrar em breve.");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","Ela era um demônio muito agressivo e territorialista. O único jeito de vencê-la foi sugar sua energia com meus poderes de súcubo, hehe. Não me importaria de vê-la outra vez, mas Lili me mataria.");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","Me sinto muito culpada em relação à Callie. Eu só queria experimentar com ela, mas acabei fazendo com que se apaixonasse por mim. Ela até quer me apresentar aos filhos. Às vezes, queria não ser meio súcubo. Já machuquei tanta gente.");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","Baina Salasaki, meu sonho de consumo! Até minha mãe já ouviu falar dela! E eu realmente consegui passar uma noite com ela <3. Só achei um pouquinho caro.");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","Ahh, essa gata! Por causa dela, agora fiquei curiosa sobre asfixia erótica. Ainda bem que Lili está sempre ao meu lado; se algo der errado, pelo menos alguém poderá me socorrer.");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","Pobre Pussiel. Por minha causa, ela teve que trabalhar três vezes mais :c.");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","Lina ficou furiosa por ter perdido para aquela gata de gosma. Até me pediu ajuda para treinar, embora eu não ache que meu estilo de luta vá servir para ela.");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","Hynoxia... Acho que é a mulher que vendeu a arma hipnótica para Lili. Fico me perguntando o que mais ela tem à venda.");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","Minha heroína de Tricotex! Não acredito que a encontramos nesta ilha. Espero poder ajudá-la de novo algum dia, mas desta vez quero ir até a cidade dela <3.");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","Sieki é quem comanda todas as mulheres da área VIP do bar. Fico curiosa para saber como alguém consegue chegar a esse cargo.");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","Vasuki veio parar nesta dimensão por acaso. Ajudei-a a encontrar as fendas dimensionais para que pudesse voltar para casa. Mas, por algum motivo, ela decidiu ficar aqui comigo. Não vou reclamar, na verdade. Talvez eu seja uma pessoa horrível.");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","Como eu poderia esquecê-la? Ela tem a combinação perfeita de autoridade e delicadeza. Espero que encontre os cigarros de que gosta. Mas, se não encontrar, quem sabe a gente se veja de novo, hehe.");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","Kamiko é igualzinha à Lili. A única diferença é que ela tem mais ou menos o meu tamanho. Bom, pensando bem, não são tão parecidas assim. Afinal, Lili tem suas qualidades.");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","Ela queria me ajudar a me tornar uma súcubo melhor, mas passa a maior parte do tempo transando, então quase nunca consigo vê-la. Será que está tentando me ensinar a não desperdiçar meu tempo sendo súcubo? Ahh, por que tudo precisa ser tão complicado!");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","Maruia é uma orc muito honesta. Depois que a venci numa luta, ela cumpriu sua palavra. Hmm... E se eu desse um jeito de fazer a gente lutar de novo...? Não! O que estou pensando?! Pensamento ruim, saia, saia, SAI!");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","Ele é tímido como eu, mas também tem um lado que mantém escondido. Espero que consiga preservar as aparências melhor do que eu.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","Mamãe!!! Eu amo a minha mamãe!!!");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","Uma pessoa muito boa, que se importa bastante com a Grande Capitã.");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","Faye deve ser a pessoa mais desagradável que já conheci. Pelo menos acabamos transando; senão, eu teria enlouquecido.");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","Bell tem uma missão tão bonita. Espero que consiga fazer mais dessas flores extintas voltarem a brotar.");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","Lucy é ótima, e espero que você não decepcione as expectativas dela em relação ao romance.");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","A Srta. Marael me mostrou um lado dos súcubos que ninguém tinha querido me mostrar antes. Sou muito grata por isso.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","Lemmy contou a Lili que, pelo visto, ZONE-tam é um jornalista muito famoso. Hmm... Agora que penso nisso, por que Lili e Lemmy se dão tão bem?");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","Gildfried é incrível e tem um pau enorme... Espera, do que eu estava falando mesmo?");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","Ela é a Futaba, sua futanari de confiança :0");
 ds_map_add(m,"Pink Slime","Slime Rosa");
 ds_map_add(m,"Purple Slime","Slime Roxo");
 ds_map_add(m,"Orange Slime","Slime Laranja");
 ds_map_add(m,"Controls","Controles");
 ds_map_add(m,"Settings","Configurações");
 ds_map_add(m,"Quest complete.","Missão concluída.");
 ds_map_add(m,"Use Vodka","Usar vodca");
 ds_map_add(m,"Use Ron","Usar rum");
 ds_map_add(m,"Use Beer","Usar cerveja");
 ds_map_add(m,"Use Milch","Usar licor de leite");
 ds_map_add(m,"there no items here yet","Não há itens aqui por enquanto.");
 ds_map_add(m,"Fish","Peixe");
 ds_map_add(m,"it is raw we can not eat it like this Lili, maybe it is better to give it to someone else.","Ainda está cru, Lili. Não podemos comer assim. Talvez seja melhor dar para outra pessoa.");
 ds_map_add(m,"Circus flyers","Panfletos do circo");
 ds_map_add(m,"I have a lot of pamphlets to deliver, hopefully delivering a few will be enough.","Ainda tenho um monte de panfletos para distribuir. Tomara que alguns já sejam suficientes.");
 ds_map_add(m,"Vodka","Vodca");
 ds_map_add(m,"This is my favorite is not that strong <3","Esta é minha bebida favorita. Não é tão forte <3");
 ds_map_add(m,"My Mother Always say rum is like men, the older the better. Mmmm maybe that is why she is with my father, elves live for a long time.","Minha mãe sempre diz que rum é como homem: quanto mais velho, melhor. Hmmm... Talvez seja por isso que ela está com meu pai. Afinal, elfos vivem por muito tempo.");
 ds_map_add(m,"Beer","Cerveja");
 ds_map_add(m,"Iugg, i do not like beer, the worst thing is that when you go to the bathroom, the pee smells very strong.","Eca, não gosto de cerveja. O pior é que, quando vou ao banheiro depois de beber, o xixi fica com um cheiro muito forte.");
 ds_map_add(m,"Magic Broom","Vassoura mágica");
 ds_map_add(m,"I love this broom <3, my little feet won't hurt anymore.","Adoro esta vassoura <3. Meus pezinhos finalmente não vão mais sofrer!");
 ds_map_add(m,"Tricotex money","Dinheiro de Tricotex");
 ds_map_add(m,"Sam gave me this money, it is 10 dollars to use in Tricotex. I will keep it, who knows if i ever pass by.","O dinheiro que Sam me deu: 10 dólares para gastar em Tricotex. Vou guardar. Quem sabe um dia eu não apareça por lá.");
 ds_map_add(m,"Autographed photo of Sam","Foto autografada de Sam");
 ds_map_add(m,"I still can not believe Sam gave me a picture with his autograph <3.","Ainda não consigo acreditar que Sam me deu uma foto autografada <3.");
 ds_map_add(m,"BDSM Master/Slave Contract","Contrato BDSM de Mestre/Escrava");
 ds_map_add(m,"My contract with Lili, because of my problems I begged her to be my master and help me to practice my succubus powers and force me to try new things <3.","Meu contrato com Lili. Por causa dos meus problemas, implorei para que ela fosse minha mestra, me ajudasse a praticar meus poderes de súcubo e me obrigasse a experimentar coisas novas <3.");
 ds_map_add(m,"Raspberry pie","Torta de framboesa");
 ds_map_add(m,"I am supposed to recognize the scent of this foot and then guide me through the forest to Marael's house.","Preciso memorizar o cheiro deste pé para conseguir atravessar a floresta e encontrar a casa de Marael.");
 ds_map_add(m,"Haigure Gun!","Arma Haigure!");
 ds_map_add(m,"This gun makes move in a very vulgar way, Just the thought of people watching me, moving uncontrollably while I make a fool of myself makes me so horny.","Esta arma faz a pessoa se mexer de um jeito muito vulgar. Só de pensar em todo mundo me olhando, enquanto me contorço sem conseguir me controlar e pago o maior mico, já fico excitada.");
 ds_map_add(m,"Holy Grail","Santo Graal");
 ds_map_add(m,"One of the relics of the islands. I can feel energy emanating from it.","Uma das relíquias da ilha. Consigo sentir a energia emanando dela.");
 ds_map_add(m,"Crystal sphere","Esfera de cristal");
 ds_map_add(m,"I found this half buried next to some cats, it looks like something valuable, maybe it will be useful for something.","Encontrei isto meio enterrado perto de alguns gatos. Parece valer bastante. Talvez sirva para alguma coisa.");
 ds_map_add(m,"Oniric incense","Incenso onírico");
 ds_map_add(m,"This is the best thing in the world! If I use it before I go to sleep I can have lucid dreams of things that happened to me <3.","Isto é a melhor coisa do mundo! Se eu usar antes de dormir, posso ter sonhos lúcidos e reviver coisas que aconteceram comigo <3.");
 ds_map_add(m,"Gilfried briefcase","Maleta de Gilfried");
 ds_map_add(m,"I have to return this briefcase to Gilfried immediately.","Preciso devolver esta maleta a Gilfried imediatamente.");
 ds_map_add(m,"Golden Key","Chave dourada");
 ds_map_add(m,"There is something strange about this key, I feel like it takes my energy somehow.","Há algo estranho nesta chave. Sinto que ela suga minha energia de algum jeito.");
 ds_map_add(m,"Smoosher uniforms","Uniforme do restaurante Smoosher");
 ds_map_add(m,"The uniform of the Smoosher restaurant smells a little funny.","O uniforme do restaurante Smoosher tem um cheiro meio esquisito.");
 ds_map_add(m,"Aphrodisiac mushroom.","Cogumelo afrodisíaco.");
 ds_map_add(m,"Moo Premium Milk","Leite Premium Moo");
 ds_map_add(m,"Fura Fura Fruit","Fruta Fura Fura");
 ds_map_add(m,"The fura fura fruit has the effect of creating a penis if eaten by a woman.","Quando uma mulher come a fruta Fura Fura, ela desenvolve um pênis.");
 ds_map_add(m,"Hea Hea Fruit","Fruta Hea Hea");
 ds_map_add(m,"The hea hea fruit has a very powerful aphrodisiac effect that will make anyone who eats it come into heat.","A fruta Hea Hea tem um efeito afrodisíaco muito poderoso, que deixa qualquer pessoa que a coma excitada.");
 ds_map_add(m,"Smuggled fabrics","Tecidos contrabandeados");
 ds_map_add(m,"I understand there was a convict who wanted to sell this, they ended up taking it from her and reselling it themselves (speaking of irony).","Ouvi dizer que uma prisioneira queria vender estas coisas, mas elas foram confiscadas. Depois, quem as confiscou resolveu revendê-las. Que ironia.");
 ds_map_add(m,"Sewing machine","Máquina de costura");
 ds_map_add(m,"Blue crystal key","Chave de cristal azul");
 ds_map_add(m,"It is a key that was found inside a strange slime.","Uma chave encontrada dentro de um slime estranho.");
 ds_map_add(m,"Purple crystal key","Chave de cristal roxo");
 ds_map_add(m,"Pink crystal key","Chave de cristal rosa");
 ds_map_add(m,"Cum jar","Pote de sêmen");
 ds_map_add(m,"Ñom yum yum it looks delicious I will let it ripen a bit before eating <3.","Nhac, nham nham... Parece delicioso! Vou deixar amadurecer só mais um pouquinho antes de comer <3.");
 ds_map_add(m,"Elf Gloves","Luvas élficas");
 ds_map_add(m,"Elf Boots","Botas élficas");
 ds_map_add(m,"Elf Leotard","Collant élfico");
 ds_map_add(m,"Elf Tank Top","Regata élfica");
 ds_map_add(m,"Elf Tights","Meia-calça élfica");
 ds_map_add(m,"Elf Panties","Calcinha élfica");
 ds_map_add(m,"Limbo Leotard","Collant do Limbo");
 ds_map_add(m,"Limbo Boots","Botas do Limbo");
 ds_map_add(m,"Cow Bras","Sutiã de vaca");
 ds_map_add(m,"Cow Stockings","Meias de vaca");
 ds_map_add(m,"Cow Bell","Sino de vaca");
 ds_map_add(m,"Cow Panties","Calcinha de vaca");
 ds_map_add(m,"OH Bunny Heels","Salto alto de coelhinha OH");
 ds_map_add(m,"OH Bunny Tights","Meia-calça de coelhinha OH");
 ds_map_add(m,"OH Bunny Top","Top de coelhinha OH");
 ds_map_add(m,"OH Bunny Ears","Orelhas de coelhinha OH");
 ds_map_add(m,"Face Mask","Máscara facial");
 ds_map_add(m,"Cat Ears","Orelhas de gato");
 ds_map_add(m,"Knight Chain Mail","Cota de malha de cavaleiro");
 ds_map_add(m,"Knight Boots","Botas de cavaleiro");
 ds_map_add(m,"Knight Gloves","Luvas de cavaleiro");
 ds_map_add(m,"The Perverted Coat","O Casaco Pervertido");
 ds_map_add(m,"Haigure Leotard","Collant Haigure");
 ds_map_add(m,"Limbo Gloves","Luvas do Limbo");
 ds_map_add(m,"Smoosher-T-Shirt","Camiseta Smoosher");
 ds_map_add(m,"Smoosher Shorts","Shorts Smoosher");
 ds_map_add(m,"Dark Greaves","Grevas sombrias");
 ds_map_add(m,"Dark Tiara","Tiara sombria");
 ds_map_add(m,"FurrHead","Cabeça de Fursuit");
 ds_map_add(m,"FurrTop","Parte de cima de Fursuit");
 ds_map_add(m,"FurrPants","Calça de Fursuit");
 ds_map_add(m,"FurrBoots","Botas de Fursuit");
 ds_map_add(m,"Nun Hat","Touca de freira");
 ds_map_add(m,"Nun Dress","Vestido de freira");
 ds_map_add(m,"Nun Socks","Meias de freira");
 ds_map_add(m,"Nun Boots","Botas de freira");
 ds_map_add(m,"Pelletclad Blade","Lâmina Revestida de Projéteis");
 ds_map_add(m,"Place Holder Quest","Missão provisória");
 ds_map_add(m,"Finally, you muster the courage to embark on an adventure with your fairy familiar to find and bring back your childhood best friend.","Finalmente, você reúne coragem para partir em uma aventura com sua fada familiar, a fim de encontrar e trazer de volta sua melhor amiga de infância.");
 ds_map_add(m,"Check the cat woman's shop; there might be something that interests you.","Dê uma olhada na loja da mulher-gato; talvez haja algo que desperte seu interesse.");
 ds_map_add(m,"The cat woman who runs the shop is somewhat grumpy because she hasn't had the chance to eat lunch.","A mulher-gato que administra a loja está meio mal-humorada porque ainda não conseguiu almoçar.");
 ds_map_add(m,"You managed to read the sinful thoughts of the fisherman. Perhaps this is your chance to explore your powers.","Você conseguiu ler os pensamentos indecentes do pescador. Talvez esta seja sua chance de explorar seus poderes.");
 ds_map_add(m,"Lili pushes you to be more proactive in training your succubus powers, so she sends you to try to seduce the cat woman who runs the shop. It should be easier since you know her.","Lili insiste para que você seja mais proativa no treinamento dos seus poderes de súcubo e manda você tentar seduzir a mulher-gato que administra a loja. Deve ser mais fácil, já que você já a conhece.");
 ds_map_add(m,"There is a high-rank demon who has been stealing alcohol shipments. You decide to find and defeat her to see if you can get information about Ava.","Há uma demônia de alto escalão roubando carregamentos de bebidas. Você decide encontrá-la e derrotá-la para ver se consegue informações sobre Ava.");
 ds_map_add(m,"You're very lucky! You recognized one of the women who appeared in your mother's XXX magazines! She says she'll give you a special service for old times' sake.","Que sorte! Você reconheceu uma das mulheres que apareciam nas revistas XXX da sua mãe! Ela diz que vai lhe oferecer um serviço especial em nome dos velhos tempos.");
 ds_map_add(m,"You found a woman with violet pigtails at the corner of the bar. She says she can lend you money, but you must pay her back with an additional ten percent.","Você encontrou uma mulher de maria-chiquinhas violetas num canto do bar. Ela diz que pode lhe emprestar dinheiro, mas você terá que devolver com mais dez por cento.");
 ds_map_add(m,"There's a cat woman playing very mean pranks on the villagers, and they're blaming Callie's daughter. Find the real culprit and save Callie's daughter!","Há uma mulher-gato pregando peças cruéis nos moradores, mas estão culpando a filha de Callie. Encontre a verdadeira culpada e salve a filha de Callie!");
 ds_map_add(m,"The plant woman from the shop told you she's very thirsty, and Lili suggested buying her beer to see if she'll give you discounts while drunk.","A mulher-planta da loja disse que está morrendo de sede, e Lili sugeriu comprar cerveja para ela, para ver se consegue um desconto quando estiver bêbada.");
 ds_map_add(m,"A dragon woman fell from the sky among the prisoners and seems to be fighting to prevent a crystal from being stolen. Lili suggests we help her; maybe they'll reward us with something valuable.","Uma mulher-dragão caiu do céu no meio dos prisioneiros e parece estar lutando para impedir que roubem um cristal. Lili sugere que a ajudemos; talvez nos recompensem com algo valioso.");
 ds_map_add(m,"There's a strange woman with pink hair hiding in a corner of the circus. Find out why people are talking about her.","Há uma mulher estranha de cabelo rosa escondida num canto do circo. Descubra por que todos estão falando dela.");
 ds_map_add(m,"You found your favorite heroine! Sam, the protector of Tricotex. Prove that you have what it takes to embark on a capture mission with her.","Você encontrou sua heroína favorita! Sam, a protetora de Tricotex. Prove que está à altura de participar de uma missão de captura ao lado dela.");
 ds_map_add(m,"Someone is impersonating a knight of Elira to scam people. Catch them and be the heroine you always wanted to be!","Alguém está se passando por um cavaleiro de Elira para aplicar golpes. Capture essa pessoa e seja a heroína que você sempre quis ser!");
 ds_map_add(m,"Kristoff, a VIP customer at the bar, is very angry and asks if you can buy him some premium cigarettes to help him calm down.","Kristoff, um cliente VIP do bar, está furioso e pergunta se você pode comprar cigarros premium para ajudá-lo a se acalmar.");
 ds_map_add(m,"The hotel secretary informs you that you've caught the attention of a woman who will be waiting for you on the top floor of the hotel. Hmm, what could she want? It might be important.","A recepcionista do hotel informa que você chamou a atenção de uma mulher que estará esperando por você no último andar. Hmm, o que será que ela quer? Talvez seja importante.");
 ds_map_add(m,"You've become a minion of a seemingly powerful individual! They order you to bring the dimensional fracture, which looks like a floating crystal, to leave this dimension.","Você se tornou capanga de alguém aparentemente poderoso! Essa pessoa ordena que você traga a fratura dimensional, que parece um cristal flutuante, para poder sair desta dimensão.");
 ds_map_add(m,"There was a collapse in the cave, leaving many miners trapped. Wait until the knight of Elira clears the passage.","Houve um desabamento na caverna, deixando muitos mineiros presos. Espere até que a cavaleira de Elira libere a passagem.");
 ds_map_add(m,"There are some rumors of strange sounds coming from the Silent Forest at night. What could it be?","Há rumores de sons estranhos vindos da Floresta Silenciosa durante a noite. O que será?");
 ds_map_add(m,"An Onahole is desperate to buy a boat and is selling her body to do so. As an act of charity, help her.","Uma boneca sexual está desesperada para comprar um barco e está vendendo o próprio corpo para conseguir isso. Faça uma boa ação e ajude-a.");
 ds_map_add(m,"Ivy, a honey slime, recognizes you as an adventurer who helps people and asks if you can help her find a part of herself that hasn't returned.","Ivy, uma slime de mel, reconhece você como uma aventureira que ajuda as pessoas e pergunta se pode ajudá-la a encontrar uma parte de si mesma que ainda não voltou.");
 ds_map_add(m,"You heard the Grand Captain of the Elira Guards arguing with a woman about the ineptitude of the knights. Maybe if you help them, they can assist you in your quest.","Você ouviu a Grande Capitã da Guarda de Elira discutindo com uma mulher sobre a incompetência dos cavaleiros. Talvez, se você os ajudar, eles possam ajudar na sua missão.");
 ds_map_add(m,"You encountered Faye, a space-dimensional traveler trapped in your dimension. You decided to help her because you felt sorry for her.","Você encontrou Faye, uma viajante entre dimensões presa na sua dimensão. Decidiu ajudá-la porque ficou com pena dela.");
 ds_map_add(m,"Vasuki tells you that something bad is happening at the mushroom house in the magenta swamp. Upon investigating, it seems that there may be human trafficking and drug activities occurring there.","Vasuki conta que algo ruim está acontecendo na casa dos cogumelos, no pântano magenta. Ao investigar, parece que pode haver tráfico de pessoas e atividades com drogas por lá.");
 ds_map_add(m,"You found someone smelling the flowers, but as soon as you spoke to them, they attacked you. Find out what's really going on!","Você encontrou alguém cheirando as flores, mas, assim que falou com essa pessoa, ela atacou você. Descubra o que realmente está acontecendo!");
 ds_map_add(m,"There's something about Marael that doesn't quite convince you. Look into what she's really hiding.","Há algo em Marael que não convence você. Investigue o que ela está escondendo de verdade.");
 ds_map_add(m,"A letter addressed to Marael gives you clues that a woman named Willow also contacted Ava. Look for her to gather more information.","Uma carta endereçada a Marael dá pistas de que uma mulher chamada Willow também entrou em contato com Ava. Procure-a para obter mais informações.");
 ds_map_add(m,"There's a bard woman looking for an adventurer to inspire her. Show her that you're a worthy adventurer capable of inspiring others!","Uma barda está procurando uma aventureira que a inspire. Mostre a ela que você é uma aventureira digna, capaz de inspirar outras pessoas!");
 ds_map_add(m,"After being attacked by a pervert who opened his leather coat and showed you everything, something awakened inside of you.","Depois de ser atacada por um pervertido que abriu o sobretudo de couro e mostrou tudo, algo despertou dentro de você.");
 ds_map_add(m,"The island is cordoned off because someone stole the relics from the church. As part of the deal to stay on the island, you agree to help the knights of Elira search for the relics.","A ilha está isolada porque alguém roubou as relíquias da igreja. Como parte do acordo para permanecer na ilha, você aceita ajudar os cavaleiros de Elira a procurar as relíquias.");
 ds_map_add(m,"An Onahole stuck to the wall in the VIP area of the bar tells you that if you buy her entire outfit, she'll give you a rimjob!","Uma boneca sexual presa à parede na área VIP do bar diz que, se você comprar todo o conjunto de roupas dela, ela vai fazer um beijo grego em você!");
 ds_map_add(m,"Lili says you're very stinky and need a bath.","Lili diz que você está fedendo e precisa tomar banho.");
 ds_map_add(m,"The librarian is lost, and no one knows where she is. Look for her, and perhaps you'll find more information about the people who go missing on the island.","A bibliotecária está desaparecida, e ninguém sabe onde ela está. Procure-a; talvez você encontre mais informações sobre as pessoas que desaparecem na ilha.");
 ds_map_add(m,"Gildfried, a businessman on vacation on the island, unfortunately lost his briefcase, which is very important to him.","Gildfried, um empresário de férias na ilha, infelizmente perdeu sua maleta, que é muito importante para ele.");
 ds_map_add(m,"Lemmy, a green monster outside an automated carriage, talks to Lili and asks for help because his mistress is having trouble.","Lemmy, um monstro verde do lado de fora de uma carruagem automática, conversa com Lili e pede ajuda porque sua ama está com problemas.");
 ds_map_add(m,"Sakura is working at the renowned fast food restaurant Smooshers! She asks for your help in searching for the lost uniforms.","Sakura está trabalhando no famoso restaurante de fast-food Smooshers! Ela pede sua ajuda para procurar os uniformes desaparecidos.");
 ds_map_add(m,"One of Vasera's clones has gained autonomy. Vasera will go search for it and neutralize it. She advises you to kill it if you encounter it.","Um dos clones de Vasera desenvolveu autonomia. Vasera vai procurá-lo e neutralizá-lo. Ela aconselha você a matá-lo caso o encontre.");
 ds_map_add(m,"Sieki got angry with you because even though she already paid the debt to MsHonney, you're still in the VIP area. Now you follow her orders to avoid making her angrier.","Sieki ficou brava com você porque, embora já tenha pago sua dívida com a Sra. Honney, você continua na área VIP. Agora você segue as ordens dela para não deixá-la ainda mais irritada.");
 ds_map_add(m,"The farmer confesses that she would like to work with less clothing. How could you help her work more comfortably?","A fazendeira confessa que gostaria de trabalhar com menos roupa. Como você poderia ajudá-la a trabalhar com mais conforto?");
 ds_map_add(m,"The fortune teller confessed to you that she would like to have a red crystal orb because with it she could see her own future.","A cartomante confessou que gostaria de ter uma esfera de cristal vermelha, pois assim poderia ver o próprio futuro.");
 ds_map_add(m,"The water nymph who works at the bar is looking for love but is insecure because she doesn't know if people approach her for the beer or if they genuinely want something with her.","A ninfa aquática que trabalha no bar está procurando amor, mas se sente insegura porque não sabe se as pessoas se aproximam por causa da cerveja ou se realmente querem algo com ela.");
 ds_map_add(m,"Accidentally, you ruin Naoki's concoction just as he's entering mating season, so you decide to help him.","Você estraga acidentalmente a mistura de Naoki justamente quando ele está entrando na época de acasalamento, então decide ajudá-lo.");
 ds_map_add(m,"Lucy the bard is having trouble with an Onahole, so you decide to help her with whatever she needs.","Lucy, a barda, está tendo problemas com uma boneca sexual, então você decide ajudá-la com o que for necessário.");
 ds_map_add(m,"There are portals for self-satisfaction in the VIP area of the bar, but a witch won't let you use them.","Há portais de satisfação pessoal na área VIP do bar, mas uma bruxa não deixa você usá-los.");
 ds_map_add(m,"Sieki has a big problem and makes you a deal you can't refuse: you just have to attend to the clients in the VIP area while she's away, and you'll become a VIP customer.","Sieki está com um problemão e faz uma proposta irrecusável: você só precisa atender os clientes da área VIP enquanto ela estiver fora, e se tornará cliente VIP.");
 ds_map_add(m,"A hospital robot offers anal cleaning services for just three thousand Arcs. It's not a bad idea to keep clean every now and then.","Um robô do hospital oferece serviços de limpeza anal por apenas três mil Arcs. Não é má ideia manter tudo limpinho de vez em quando.");
 ds_map_add(m,"A story you read in the library seems strange to you, so you decide to look for more information about it.","Uma história que você leu na biblioteca parece estranha, então decide procurar mais informações sobre ela.");
 ds_map_add(m,"There's a guy offering his services to make fursuits, which catches your attention, so you decide to save up for one.","Há um sujeito oferecendo serviços de confecção de fursuits. Isso chama sua atenção, então você decide juntar dinheiro para comprar uma.");
 ds_map_add(m,"There's an Onahole that has the same tone as you, which strangely excites you.","Há uma boneca sexual com o mesmo tom de pele que você, o que, estranhamente, deixa você excitada.");
 ds_map_add(m,"In a nightclub, you find two gothic girls with big butts dancing, something you can't let pass in your life.","Em uma boate, você encontra duas garotas góticas dançando e rebolando com bundões enormes. Não dá para deixar uma oportunidade dessas passar.");
 ds_map_add(m,"Upon entering the usually closed public restroom, you find an idol vomiting, with many people screaming and demanding the show. What could be happening?","Ao entrar no banheiro público, que normalmente fica fechado, você encontra uma idol vomitando, enquanto várias pessoas gritam e exigem que o show comece. O que será que está acontecendo?");
 ds_map_add(m,"There is a proliferation of slimes attacking and kidnapping women. Do your best to help and get to the bottom of this!","Há uma proliferação de slimes atacando e sequestrando mulheres. Faça o possível para ajudar e descobrir o que está por trás disso!");
 ds_map_add(m,"A being living in the pond enters Line's mind and psychologically strips her bare with questions she's not prepared to hear or face.","Um ser que vive no lago entra na mente de Line e a deixa psicologicamente nua com perguntas que ela não está preparada para ouvir nem enfrentar.");
 ds_map_add(m,"You don't know what's happening; you have mental gaps, and days and nights seem to pass in seconds.","Você não sabe o que está acontecendo; tem lapsos mentais, e os dias e as noites parecem passar em segundos.");
 ds_map_add(m,"You have committed serious mistakes that haunt you at night, so you decide to confess to expiate your sins.","Você cometeu erros graves que assombram suas noites, então decide confessar para expiar seus pecados.");
 ds_map_add(m,"Callie invites you to meet her family, which seems more serious than what you're looking for, but it would be rude not to go.","Callie convida você para conhecer a família dela. Isso parece mais sério do que você procura, mas seria falta de educação não ir.");
 ds_map_add(m,"You found a place that can serve you for sleeping while you investigate the island.","Você encontrou um lugar onde pode dormir enquanto investiga a ilha.");
 ds_map_add(m,"You need more power, so you beg Marael to help you unlock your succubus powers.","Você precisa de mais poder, então implora a Marael que ajude a desbloquear seus poderes de súcubo.");
 ds_map_add(m,"The thieves on the island aren't just any criminals; they were actually stealing to maintain an orphanage, without which everything would collapse.","Os ladrões da ilha não são criminosos comuns: na verdade, roubavam para manter um orfanato, sem o qual tudo desmoronaria.");
 ds_map_add(m,"You met Futaba your trusted futanari in the forest, what could she be doing?","Você encontrou Futaba, sua futanari de confiança, na floresta. O que será que ela está fazendo ali?");
 ds_map_add(m,"The barn is very busy due to the issues happening on the island. Help them however you can so that the barn can open.","O celeiro está muito movimentado por causa dos problemas que estão acontecendo na ilha. Ajude como puder para que ele possa abrir.");
 ds_map_add(m,"Rynn is frustrated because the last fight with you didn't end, so she challenges you to a beer drinking duel.","Rynn está frustrada porque a última luta entre vocês não terminou, então desafia você para uma competição de quem bebe mais cerveja.");
 ds_map_add(m,"Lili is angry with Line because she believes Line is completely ignorant about sex, and challenges her to a competition to see who is the better onahole.","Lili está brava com Line porque acha que ela não entende absolutamente nada de sexo e a desafia para uma competição para ver quem é a melhor boneca sexual.");
 ds_map_add(m,"The milk on this island has very strange properties.","O leite desta ilha tem propriedades muito estranhas.");
 ds_map_add(m,"A fat ugly bastard bothering Rynn at the bar he leaves but you can't stop thinking about him.","Um gordo e feio desgraçado estava incomodando Rynn no bar. Ele foi embora, mas você não consegue parar de pensar nele.");
