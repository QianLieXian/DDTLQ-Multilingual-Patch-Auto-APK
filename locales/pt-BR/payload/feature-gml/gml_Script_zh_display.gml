 ds_map_add(m,"Ok that's it!","Está bem, chega!");
 ds_map_add(m,"Hey chill,  we can help you clean jeez girl.","Ei, calma. Podemos ajudar você a limpar, caramba, garota.");
 ds_map_add(m,"Now Mr.Cabello will return tired from his work and he will see that I did nothing!!","Agora o senhor Cabello vai voltar cansado do trabalho e vai ver que não fiz nada!!");
