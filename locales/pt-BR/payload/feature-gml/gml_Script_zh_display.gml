 ds_map_add(m,"It really hurt me that you didn't laugh at my jokes.","Fiquei realmente magoada porque você não riu das minhas piadas.");
 ds_map_add(m,"Ok I will cut the act Line.","Está bem, Line. Vou parar com a encenação.");
