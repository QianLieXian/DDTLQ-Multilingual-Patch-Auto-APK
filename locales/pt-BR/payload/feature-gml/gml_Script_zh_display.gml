 ds_map_add(m,"Bye Line and thank you, I guess what you did, it accounts for a bit of my stress.","Tchau, Line, e obrigada. Acho que o que você fez aliviou um pouco meu estresse.");
 ds_map_add(m,"Take care Naoki my name is Line by the way","Cuide-se, Naoki. A propósito, meu nome é Line.");
 ds_map_add(m,"Thanks really my name is Naoki. i will take those two to the hospital to see if nothing serious happened to them.","Obrigado, de verdade. Meu nome é Naoki. Vou levar aquelas duas ao hospital para ver se não aconteceu nada grave.");
 ds_map_add(m,"Oh poor thing, do not worry, it happened to everyone.","Ah, coitadinho. Não se preocupe, isso acontece com todo mundo.");
 ds_map_add(m,"Oh .. I am very shy I come here to practice my magic and when I saw them hidden I panicked. :c","Ah... sou muito tímido. Venho aqui praticar minha magia e, quando vi aquelas duas escondidas, entrei em pânico. :c");
 ds_map_add(m,"Hey, changing the subject, why did you attack us?!","Ei, mudando de assunto, por que você nos atacou?!");
 ds_map_add(m,"Don't really worry I. I even like it.","Não se preocupe, de verdade. Eu até gosto.");
 ds_map_add(m,"I amm sorry it was really my fault, I just want to help you with your erection. :C","Sinto muito, a culpa foi mesmo minha. Só queria ajudar você com sua ereção. :C");
 ds_map_add(m,"No no miss it was my fault I. I cum all over yo your face.","N-não, senhorita, a culpa foi minha. E-eu gozei no seu rosto.");
 ds_map_add(m,"I'm really sorry, I don't know wha-what happened.","Sinto muito mesmo. Não sei o que a-aconteceu.");
 ds_map_add(m,"Go find me at the hotel on the 2nd floor, there I have an armor that I can lend you.","Vá me procurar no segundo andar do hotel. Tenho uma armadura que posso lhe emprestar.");
 ds_map_add(m,"Easy we passed as new guards and we will say that these 2 idiots invited us.","É fácil: vamos nos passar por guardas novos e dizer que aqueles dois idiotas nos convidaram.");
 ds_map_add(m,"Oh ok, and what will we do? If we forcefully pass the other guards will escape.","Ah, está bem. E o que vamos fazer? Se passarmos à força, os outros guardas vão fugir.");
 ds_map_add(m,"And yes, it does have giant tits.","E sim, ela tem peitos enormes.");
 ds_map_add(m,"I think I have seen that orc Kor, I saw her taking care of the night club Sodoma.","Acho que já vi aquela orc, Kor. Vi quando ela estava tomando conta da boate Sodoma.");
 ds_map_add(m,"Line I think I know where the Sabbath is.","Line, acho que sei onde fica o Sabá.");
 ds_map_add(m,"You are in luck, I understand that today it is her turn to guard the entrance to the Sabbath.","Você está com sorte. Pelo que sei, hoje é a vez dela de vigiar a entrada do Sabá.");
 ds_map_add(m,"in that case i will go full anal with her HAHAHA (this mother fucker have being with everyone)","Nesse caso, vou com tudo no anal dela HAHAHA. (Esse filho da puta já ficou com todo mundo.)");
 ds_map_add(m,"Sorry dude in the last sabbath i was with her HAHAHA","Foi mal, cara. No último Sabá, eu fiquei com ela HAHAHA.");
 ds_map_add(m,"And how do you know that about Kor?","E como você sabe disso sobre Kor?");
 ds_map_add(m,"Sorry dude is in my soul","Foi mal, cara. Está na minha alma.");
 ds_map_add(m,"Dude why do you have to do every conversation so weird?","Cara, por que você precisa deixar toda conversa tão esquisita?");
 ds_map_add(m,"*I wish I have bigger tits ;C*","*Queria ter peitos maiores ;C*");
 ds_map_add(m,"What the fuck.","Que porra é essa?");
 ds_map_add(m,"Oh they are, they're like two damn planets and each with two damn moons orbiting it.","Ah, são mesmo. Parecem dois planetas malditos, cada um com duas malditas luas orbitando ao redor.");
 ds_map_add(m,"Ohhh now I want to be with Kor the orc guard they told me she massive tits.","Ohhh, agora quero ficar com Kor, a guarda orc. Disseram que ela tem peitos enormes.");
 ds_map_add(m,"Mmm.. I have never heard that thing on this island.","Mmm... nunca ouvi falar dessa coisa nesta ilha.");
 ds_map_add(m,"Sabbath what the hell is that?","Sabá? Que diabos é isso?");
 ds_map_add(m,"Uff tomorrow when they give us another place let's go back to the Sabbath.","Uff, amanhã, quando nos derem outro posto, vamos voltar ao Sabá.");
 ds_map_add(m,"Yes, but it was worth it HAHAHA.","Sim, mas valeu a pena HAHAHA.");
 ds_map_add(m,"Nothing to do the great captain gave us this as punishment.","Não tem jeito. A Grande Capitã nos deu isso como punição.");
 ds_map_add(m,"Man this is the worst.","Cara, isso é péssimo.");
 ds_map_add(m,"Ok.","Está bem.");
 ds_map_add(m,"I think they are on the verge of boredom, maybe they will leave their possition let's hear what they say.","Acho que estão quase morrendo de tédio. Talvez abandonem seus postos. Vamos ouvir o que estão dizendo.");
 ds_map_add(m,"Good thing I didn't miss anything. * Dam *","Ainda bem que não perdi nada. *Droga*");
 ds_map_add(m,"No, but if you wanted to hear a conversation of who has it bigger then yes.","Não, mas, se queria ouvir uma conversa sobre quem tem o maior, então sim.");
 ds_map_add(m,"I am so-sorry, I was late?","D-desculpe, cheguei atrasada?");
 ds_map_add(m,"Oh... hi?","Ah... oi?");
 ds_map_add(m,"Bell the florist","Bell, florista");
 ds_map_add(m,"Hehe Thanks well then let's head to the magenta swamp, there is a rumor that the flower might be there too.","Hehe, obrigada. Então vamos para o Pântano Magenta. Há um boato de que a flor também pode estar lá.");
 ds_map_add(m,"Oh sure don't worry Lili and I are pretty good at fighting, you'll be safe with us <3.","Ah, claro, não se preocupe. Lili e eu somos muito boas de briga. Você estará segura conosco <3.");
 ds_map_add(m,"The problem is that it can be dangerous... and I need help if something bad happens.","O problema é que pode ser perigoso... e preciso de ajuda caso alguma coisa dê errado.");
 ds_map_add(m,"It's just a flower what do you need us for then?","É só uma flor. Então para que você precisa de nós?");
 ds_map_add(m,"I can still walk, but I do need help I am looking for a very rare flower I heard a rumor that it was here but it seems it was not true.","Ainda consigo andar, mas preciso mesmo de ajuda. Estou procurando uma flor muito rara. Ouvi um boato de que estava aqui, mas parece que não era verdade.");
 ds_map_add(m,"I-If there is anything I can help you with just let me know.","S-se houver alguma coisa em que eu possa ajudar, é só me dizer.");
 ds_map_add(m,"Oh no, I am so so-sorry this is all my fault. I should have he-held back.","Ah, não, sinto muito, muito mesmo. A culpa é toda minha. Eu deveria ter me c-controlado.");
 ds_map_add(m,"Ah, I think I twisted my ankle in the fight.","Ah, acho que torci o tornozelo durante a luta.");
 ds_map_add(m,"Dont worry you didn't know.","Não se preocupe, você não sabia.");
 ds_map_add(m,"Sorry if I ofend you before.","Desculpe se ofendi você antes.");
 ds_map_add(m,"Thank you for understanding <3, my name is Bell I am a florist and my pronouns are they and them if you would be so kind to use them with me.","Agradeço por entender <3. Meu nome é Bell, sou florista e meus pronomes são they/them. Se puder, use-os ao falar comigo.");
 ds_map_add(m,"Oh. see Lili? I knew there was something wrong.","Ah, está vendo, Lili? Eu sabia que tinha alguma coisa errada.");
 ds_map_add(m,"I a-am very sorry these flowers seem to have proproperties that affect the aggressiveness of people.","S-sinto muito. Parece que estas flores têm propriedades que afetam a agressividade das pessoas.");
 ds_map_add(m,"Why are you apologizing? She attacked us out of nowhere!","Por que está se desculpando? Ela nos atacou do nada!");
 ds_map_add(m,"Oh, God, are you okay?","Meu Deus, você está bem?");
 ds_map_add(m,"lili.","Lili.");
 ds_map_add(m,"Oh, Go-god, are you okay?","Oh, meu Deus, você está bem?");
 ds_map_add(m,"tsk, you know I'll follow you anyway, don't act like a hero.","Tsc, você sabe que vou seguir você de qualquer jeito. Não banque a heroína.");
 ds_map_add(m,"Lili you can stay here I will not force you to follow me.","Lili, você pode ficar aqui. Não vou obrigar você a me seguir.");
 ds_map_add(m,"Wow, that idea, may just be crazy enough, to get us all killed!","Uau, essa ideia pode ser louca o bastante para acabar matando todos nós!");
 ds_map_add(m,"My idea is that if you know the smell of the pie maybe you can follow it to her home. I know she cooks one every day so you should be able to find the right way.","Minha ideia é a seguinte: se você conhece o cheiro da torta, talvez consiga segui-lo até a casa dela. Sei que ela prepara uma todos os dias, então você deve conseguir encontrar o caminho certo.");
 ds_map_add(m,"She always brought homemade pie to work and shared it with everyone, she was very good at cooking.","Ela sempre levava torta caseira para o trabalho e dividia com todo mundo. Cozinhava muito bem.");
 ds_map_add(m,"A pie?","Uma torta?");
 ds_map_add(m,"This is all I can offer to help you find her house.","É tudo o que posso oferecer para ajudar você a encontrar a casa dela.");
 ds_map_add(m,"Shit, okay I'll go with you but how are we going to find his house if even his crazy fans haven't found it?","Merda, está bem, vou com você. Mas como vamos encontrar a casa dela se nem os fãs malucos conseguiram?");
 ds_map_add(m,"I-is our only chance Lili","É-é a nossa única chance, Lili.");
 ds_map_add(m,"Marael lives hidden in the forest as she is very popular among the VIPs and did not want to be disturbed at home.","Marael vive escondida na floresta porque é muito popular entre os VIPs e não queria ser incomodada em casa.");
 ds_map_add(m,"I guess it makes sense but what does this crappy forest have to do with anything?!","Acho que faz sentido, mas o que diabos essa floresta horrível tem a ver com isso?!");
 ds_map_add(m,"The only thing that could surprise Marael is a succubus with years of experience would be an angel, I have no doubt.","A única coisa que poderia surpreender Marael, uma súcubo com tantos anos de experiência, seria um anjo. Não tenho dúvidas.");
 ds_map_add(m,"have to understand that in the place where we work we find all types of customers.","Você precisa entender que, no lugar onde trabalhamos, encontramos todo tipo de cliente.");
 ds_map_add(m,"Shhh,When she resigned she looked very happy, she told me that she met someone very special who could help her to get what she really wants in life.","Shhh, quando ela pediu demissão, parecia muito feliz. Disse que conheceu alguém muito especial, que poderia ajudá-la a conseguir o que realmente queria da vida.");
 ds_map_add(m,"What does our search have to do with this succubus?","O que essa súcubo tem a ver com nossa busca?");
 ds_map_add(m,"I really can not imagine a succubus being bored in that place.","Realmente não consigo imaginar uma súcubo ficando entediada naquele lugar.");
 ds_map_add(m,"it wasn't a big surprise she looked depressed a while ago, maybe so many years of working bored her.","Não foi uma grande surpresa. Há algum tempo ela parecia deprimida. Talvez tantos anos trabalhando tenham acabado por entediá-la.");
 ds_map_add(m,"Now listen, a few weeks ago Marael, the most desired VIP succubus, stopped working for me.","Agora escute: algumas semanas atrás, Marael, a súcubo VIP mais desejada, parou de trabalhar para mim.");
 ds_map_add(m,"Yes, but it's your only chance to find your friend.","Sim, mas esta é sua única chance de encontrar sua amiga.");
 ds_map_add(m,"Aren't we not supposed to enter this part of the forest because people disappear?","Não era melhor não entrar nesta parte da floresta porque as pessoas desaparecem aqui?");
 ds_map_add(m,"Sieki, why did you call us to this place?","Sieki, por que você nos chamou para este lugar?");
 ds_map_add(m,"Intertwined forests","Florestas Entrelaçadas");
 ds_map_add(m,"*DANGER*\nDo not go further into the forest.","*PERIGO*\nNão avance mais pela floresta.");
 ds_map_add(m,"Think what you want but if you want to see your destiny you know where I am.","Pense o que quiser, mas, se quiser conhecer seu destino, sabe onde me encontrar.");
 ds_map_add(m,"Too convenient did you really see all that or are you just a pervert?","Conveniente demais. Você realmente viu tudo isso ou é só um pervertido?");
 ds_map_add(m,"Thank you very much destiny is very generous it seems.","Muito obrigada. Parece que o destino é bastante generoso.");
 ds_map_add(m,"Is an incense that helps you to have lucid dreams of your memories.","É um incenso que ajuda você a ter sonhos lúcidos com suas próprias lembranças.");
 ds_map_add(m,"I almost forgot to also take this the crystal sphere also showed me that it gave it to you.","Quase esqueci. Leve isto também. A esfera de cristal me mostrou que eu a entregaria a você.");
 ds_map_add(m,"How interesting, I have never met an elf succubus in my life.","Que interessante. Nunca conheci uma elfa súcubo na vida.");
 ds_map_add(m,"Oh it's because I'm half succubus, it must be my aura that attracts people.","Ah, é porque sou meio súcubo. Deve ser minha aura que atrai as pessoas.");
 ds_map_add(m,"Excellent our destinations were fulfilled, it was strangely pleasant.","Excelente, nossos destinos se cumpriram. Foi estranhamente agradável.");
 ds_map_add(m,"But it'll be worth it, I promise, plus I'll be reading your fortune at a discount from time to time <3","Mas vai valer a pena, prometo. Além disso, de vez em quando vou ler sua sorte com desconto <3.");
 ds_map_add(m,"Oh, well it is better than nothing I guess.","Ah, bem, acho que é melhor do que nada.");
 ds_map_add(m,"Well, hehe, first I have to pay for the tuition and then I will earn money, so it will be a while before I start earning money.","Bem, hehe, primeiro preciso pagar a mensalidade e depois vou começar a ganhar dinheiro. Então ainda vai demorar um pouco até eu receber.");
 ds_map_add(m,"Seriously? I pay a lot for the services of the fortune teller, you will do very well!","Sério? Pago muito pelos serviços da vidente. Você vai se sair muito bem!");
 ds_map_add(m,"Hi Line look at me I found a teacher to practice fortune-telling.","Oi, Line! Olhe para mim, encontrei uma professora para aprender a ler a sorte.");
 ds_map_add(m,"Hey hero! Half price divination, you don't have to thank me hehe.","Ei, heroína! Adivinhação pela metade do preço. Não precisa me agradecer, hehe.");
 ds_map_add(m,"I will make you forget this!","Vou fazer você esquecer isso!");
 ds_map_add(m,"No you should not do something like that, here. * drools *","Não, você não deveria fazer uma coisa dessas aqui. *baba*");
 ds_map_add(m,"What are you doing spying on me, you bloody pervert!","O que está fazendo me espionando, seu pervertido desgraçado?!");
 ds_map_add(m,"Hey, who's there?","Ei, quem está aí?");
 ds_map_add(m,"Finally it was so packed...","Até que enfim! Estava tudo tão lotado...");
 ds_map_add(m,"Ohhh..OoOOOoOOHHHHHHHHH!!","Ohhh... OoOOOoOOHHHHHHHHH!!");
 ds_map_add(m,"What, what's going on?","O quê? O que está acontecendo?");
 ds_map_add(m,"A well ... Bye ....                                            I'm your fan :v.","Ah, bem... tchau....                                            Sou sua fã :v.");
 ds_map_add(m,"I_I have to go now :v","E_eu preciso ir agora :v");
 ds_map_add(m,"Really? I-I can explain it again, I have no proble-","Sério? P-posso explicar de novo, não tem proble-");
 ds_map_add(m,"I understo-","Eu entend-");
 ds_map_add(m,"You do not like it? What I did is use your slogan and well re use i-","Você não gostou? O que fiz foi usar seu bordão e, bem, reutilizá-");
 ds_map_add(m,"You are welcome, because I am Line your Heroine of trust :D.","Não há de quê, porque sou Line, sua heroína de confiança :D.");
 ds_map_add(m,"... Th-thank you very much.","... M-muito obrigada.");
 ds_map_add(m,"Finally Line finishes cleaning up and there is no trace of the embarrassing event.","Finalmente, Line termina a limpeza e não resta nenhum vestígio do incidente constrangedor.");
 ds_map_add(m,"Futaba stands back in horror at the act she is witnessing.","Futaba recua, horrorizada com o que está presenciando.");
 ds_map_add(m,"Line starts to clean the semen puddle as quickly as possible.","Line começa a limpar a poça de sêmen o mais rápido possível.");
 ds_map_add(m,"Do not worry, I think I can help so that no one else knows about this.","Não se preocupe. Acho que posso ajudar para que ninguém mais fique sabendo disso.");
 ds_map_add(m,"But now my career will die, everyone will know that I can't hide my urges and that I ejaculate in spurts :c *snif snfi*.","Mas agora minha carreira vai acabar. Todo mundo vai saber que não consigo controlar meus impulsos e que ejaculo em jatos :c. *snif, snif*");
 ds_map_add(m,"Oh I remember you are from that show! sorry, I am-I am kind of a clumsy. ( I have no idea who the hell she is :v )","Ah, lembrei! Você é daquele programa! Desculpe, sou meio desastrada. (Não faço a menor ideia de quem diabos ela é :v.)");
 ds_map_add(m,"I AM FUTABA YOUR TRUSTED FUTANARI, OFFICIAL PURPLECRIT COMMUNICATOR!","EU SOU FUTABA, SUA FUTANARI DE CONFIANÇA, A COMUNICADORA OFICIAL DA PURPLECRIT!");
 ds_map_add(m,"What do you ask if I'm famous you don't know who you're talking to?!","O que quer dizer com perguntar se sou famosa? Você não sabe com quem está falando?!");
 ds_map_add(m,"Ah, you are famous?","Ah, você é famosa?");
 ds_map_add(m,"Ahh... I-I can't trust anyone if this gets out my career will die.","Ahh... N-não posso confiar em ninguém. Se isso vazar, minha carreira vai acabar.");
 ds_map_add(m,"Hey, calm down, I won't say a word.","Ei, acalme-se. Não vou contar nada.");
 ds_map_add(m,"Shit, you're so strong!","Merda, você é forte demais!");
 ds_map_add(m,"No thanks to you, I was on the verge of cutting off the penis of the one in the position of the helicopter.","Não foi graças a você. Eu estava prestes a cortar o pênis daquele sujeito que estava fazendo a posição do helicóptero.");
 ds_map_add(m,"Thank you so much.","Muito obrigada.");
 ds_map_add(m,"You can have as a reward the armor is better than the few arcs that Tamara would give you.","Pode ficar com esta armadura como recompensa. É melhor do que os poucos Arcs que Tamara daria a você.");
 ds_map_add(m,"Whatever, it was a thing of the past I will report the mission as accomplished.","Tanto faz. Isso já ficou no passado. Vou informar que a missão foi concluída.");
 ds_map_add(m,"You seem to appreciate her a lot.","Parece que você gosta muito dela.");
 ds_map_add(m,"I'm sorry for making me so mad, tamara works so hard and these parasites only give her more work.","Desculpe por ter ficado tão irritada. Tamara trabalha tanto, e esses parasitas só dão mais trabalho a ela.");
 ds_map_add(m,"After a few minutes Alura calms down.","Depois de alguns minutos, Alura se acalma.");
 ds_map_add(m,"All the guards escaped without major problem.","Todos os guardas fugiram sem maiores problemas.");
 ds_map_add(m,"Line and Lili hold alura before something bad happens.","Line e Lili seguram Alura antes que algo ruim aconteça.");
 ds_map_add(m,"Oh ok. :c","Ah, está bem. :c");
 ds_map_add(m,"Shiet Line it's time to intervene!","Caramba, Line, está na hora de intervir!");
 ds_map_add(m,"You leave your position as guards and the only thing you do is give the great captain more work, the only way to do justice is for everyone to die!","Vocês abandonam seus postos como guardas e a única coisa que fazem é dar mais trabalho à Grande Capitã. A única maneira de fazer justiça é matar todo mundo!");
 ds_map_add(m,"I thought it was something small but now I see that y'all are parasites!","Achei que fosse algo pequeno, mas agora vejo que vocês são todos parasitas!");
 ds_map_add(m,"I was sent to Investigate the disappearance of the guards by the great captain!","A Grande Capitã me mandou investigar o desaparecimento dos guardas!");
 ds_map_add(m,"Listen everybody!","Escutem, todos vocês!");
 ds_map_add(m,"... does not matter how.","... Não importa como.");
 ds_map_add(m,":O but how?",":O Mas como?");
 ds_map_add(m,"Oh my god, Line look at that they are doing the helicopter!","Meu Deus, Line, olhe! Eles estão fazendo o helicóptero!");
 ds_map_add(m,"It look like they were doing more thang just hanging out.","Parece que estavam fazendo mais do que apenas passar o tempo juntos.");
 ds_map_add(m,"What that hell!","Que diabos?!");
 ds_map_add(m,"Oh god, YES I am going, I am coming!","Meu Deus, SIM! Estou indo, estou gozando!");
 ds_map_add(m,"Wof WOOF BArK Bakk GRRrr","Au! AU! Au! RRRrr!");
 ds_map_add(m,"Good, that's slutty now bark how happy you are!","Muito bem, isso sim é ser safada. Agora late para mostrar o quanto está feliz!");
 ds_map_add(m,"* drooling * Im rely ejoyig tis Co-cough!","*babando* Tô gostano muinto dis... Cof, cof!");
 ds_map_add(m,"You just enjoy and practice your doggie swim.","Apenas aproveite e pratique seu nado cachorrinho.");
 ds_map_add(m,"You don't need to take off your clothes, I'll make you a hole and that will be enough.","Você não precisa tirar a roupa. Vou fazer um buraco para você, e isso será suficiente.");
 ds_map_add(m,"Look back.","Olhe para trás.");
 ds_map_add(m,"B-both sides?","D-dos dois lados?");
 ds_map_add(m,"Today you will lose your virginity on both sides.","Hoje você vai perder a virgindade dos dois lados.");
 ds_map_add(m,"I love it I hope you can stand this.","Adoro! Espero que você aguente.");
 ds_map_add(m,"Ehh well yes it i-it's m-my first time (AHhhh I am a horrible hypocrite).","É... bem, sim. É a m-minha primeira vez. (AAhhh, sou uma hipócrita terrível.)");
 ds_map_add(m,"Hehe you look like a very innocent girl.","Hehe, você parece uma garota muito inocente.");
 ds_map_add(m,"Now we just have to find proof of what is going on here.","Agora só precisamos encontrar provas do que está acontecendo aqui.");
 ds_map_add(m,"Ah there's no need to thanks me hehe.","Ah, não precisa me agradecer, hehe.");
 ds_map_add(m,"Well done Lili. <3","Muito bem, Lili. <3");
 ds_map_add(m,"...(fucking fairy)","... (Fada maldita.)");
 ds_map_add(m,"Oh of course you don't want to know.","Ah, claro que você não quer saber.");
 ds_map_add(m,"I don't want to know.","Não quero saber.");
 ds_map_add(m,"We'll take some time, we'll be doing girl things.","Vamos demorar um pouco. Vamos fazer coisas de garotas.");
 ds_map_add(m,"That' s enough! go to the goddamn bathroom.","Já chega! Vá para aquele maldito banheiro.");
 ds_map_add(m,"Hold on Line and we'll see what we can do.","Aguente firme, Line. Vamos ver o que podemos fazer.");
 ds_map_add(m,"Hey hey,I don't want to be part of this conversation anymore.","Ei, ei, não quero mais fazer parte desta conversa.");
 ds_map_add(m,"Hey, I don't have those tas!","Ei, não tenho esse tipo de fetiche!");
 ds_map_add(m,"Well if you want to see my friend pee herself that's fine, I don't judge other people's tastes.","Bem, se você quer ver minha amiga fazendo xixi nas calças, tudo bem. Não julgo os gostos dos outros.");
 ds_map_add(m,"I can't let anyone pass.","Não posso deixar ninguém passar.");
 ds_map_add(m,"Please we need your help? or do you want to see her pee.","Por favor, precisamos da sua ajuda. Ou você quer vê-la fazendo xixi?");
 ds_map_add(m,"Ohh Lili I can't hold on any longer.","Oh, Lili, não consigo mais segurar.");
 ds_map_add(m,"I am sorry sir, but we need a bathroom urgently for my friend.","Sinto muito, senhor, mas minha amiga precisa urgentemente de um banheiro.");
 ds_map_add(m,"*whispering* relax, I'll take care of this.","*sussurrando* Relaxe, vou cuidar disso.");
 ds_map_add(m,"OH I-I do not think we think this through very well.","OH, a-acho que não pensamos muito bem nisso.");
 ds_map_add(m,"Hey, what are you doing here?!","Ei, o que você está fazendo aqui?!");
 ds_map_add(m,"haha okay","Haha, está bem.");
 ds_map_add(m,"I will, but not because you told me to.","Vou, mas não porque você mandou.");
 ds_map_add(m,"Lili, you can break the light bulb, maybe that way the guard won't see us pass by.","Lili, você pode quebrar a lâmpada? Talvez assim o guarda não nos veja passar.");
 ds_map_add(m,"Go to the other room!","Vá para a outra sala!");
 ds_map_add(m,"I have an idea *picks up the gun from the table*","Tive uma ideia. *pega a arma da mesa*");
 ds_map_add(m,"Now how do we get him to leave his post?","Agora, como vamos fazer com que ele abandone o posto?");
 ds_map_add(m,"Mmm.. must be in the room that the guard is guarding.","Mmm... deve estar no cômodo que o guarda está vigiando.");
 ds_map_add(m,"If all this money exists, we can't let them use it, more people could be in danger.","Se todo esse dinheiro existe, não podemos deixar que eles o usem. Mais pessoas podem acabar em perigo.");
 ds_map_add(m,"Line we have to look for the rest of the arcs and burn them all.","Line, precisamos procurar o restante dos Arcs e queimar tudo.");
 ds_map_add(m,"So far all the rumors have been true.","Até agora, todos os boatos se confirmaram.");
 ds_map_add(m,"We will take everything as evidence.","Vamos levar tudo como prova.");
 ds_map_add(m,"How terrible, then you were right.","Que horror... então você estava certa.");
 ds_map_add(m,"These are... dental records of humans.","Estes são... registros odontológicos de humanos.");
 ds_map_add(m,"They seem to be in a hurry.","Parece que estão com pressa.");
 ds_map_add(m,"What a disaster.","Que desastre.");
 ds_map_add(m,"Oh sorry.","Ah, desculpe.");
 ds_map_add(m,"Hey, the guard will be able to see you if you walk by.","Ei, o guarda vai conseguir ver você se passar por ali.");
 ds_map_add(m,"Oh sorry","Ah, desculpe.");
 ds_map_add(m,"Hey if we don't go now we won't be able to find evidence of what's going on here.","Ei, se não formos agora, não vamos conseguir encontrar provas do que está acontecendo aqui.");
 ds_map_add(m,"Unfortunately Vasuki Line and Lili end up cornered.","Infelizmente, Vasuki, Line e Lili acabam encurraladas.");
 ds_map_add(m,"Vasuki incinerates all the arcs before the guards arrive.","Vasuki incinera todos os Arcs antes que os guardas cheguem.");
 ds_map_add(m,"quick Vasuki use your fire breath.","Rápido, Vasuki! Use seu sopro de fogo!");
 ds_map_add(m,"Hey what are you doing over there!","Ei! O que você está fazendo aí?!");
 ds_map_add(m,"Oh ok just try to keep the fire under control.","Ah, está bem. Tente manter o fogo sob controle.");
 ds_map_add(m,"We have already made this far we have to burn it all down.","Já chegamos até aqui. Precisamos queimar tudo.");
 ds_map_add(m,"Lo-look Vasuki, the table is full of Arcs.","O-olhe, Vasuki, a mesa está cheia de Arcs.");
 ds_map_add(m,"Well everything is ready, go to the VIP lounge of the bar and I will tell you what to do.","Está tudo pronto. Vá para a área VIP do bar e vou dizer o que fazer.");
 ds_map_add(m,"Oh Line you are such a good person I guess that's why I like you hehe.","Ah, Line, você é uma pessoa tão boa. Acho que é por isso que gosto de você, hehe.");
 ds_map_add(m,"No vasuki, I was also part of all this, I will help you in everything. <3 (please don't leave me out of this).","Não, Vasuki, eu também fiz parte de tudo isso. Vou ajudar você em tudo. <3 (Por favor, não me deixe de fora disso.)");
 ds_map_add(m,"Wait Line didn't do anything I brought her with me it was all my fault.","Espere, Line não fez nada. Eu a trouxe comigo. A culpa foi toda minha.");
 ds_map_add(m,"Perfect because I manage the vip section of the bar and my idea is to create a special day in which you will be the onaholes, 24 hours uninterrupted and the Vip will continue even if you are unconscious and I guess we would make enough money to solve all this problem.","Perfeito, porque sou responsável pela área VIP do bar. Minha ideia é criar um dia especial em que vocês serão as bonecas sexuais: 24 horas sem interrupção, e os VIPs continuarão usando vocês mesmo que desmaiem. Acho que conseguiríamos dinheiro suficiente para resolver todo esse problema.");
 ds_map_add(m,"Whatever it takes for those women to get paid. :c","Não importa o que seja preciso, desde que aquelas mulheres recebam o pagamento. :c");
 ds_map_add(m,"Wait I have an idea of how they could get all that money.","Espere, tive uma ideia de como eles podem ter conseguido todo aquele dinheiro.");
 ds_map_add(m,"Sorry but both will have to go to the jail-farm.","Desculpe, mas vocês duas terão que ir para a Fazenda-Prisão.");
 ds_map_add(m,"Even worse, you burned all the money that was going to be given to the onahole for their work.","E pior: você queimou todo o dinheiro que seria pago às bonecas sexuais pelo trabalho delas.");
 ds_map_add(m,"Th-then it was all a misunderstanding.","E-então foi tudo um mal-entendido.");
 ds_map_add(m,"No, thank you very much aunty.","Não, muito obrigada, tia.");
 ds_map_add(m,"Oh, ho ho sorry to bother I spilled the flour in the kitchen and the guards helped me clean it up a little bit, but nothing happened to the cake, don't worry, anyone want some?","Ah, ho ho, desculpem incomodar. Derramei a farinha na cozinha e os guardas me ajudaram a limpar um pouco, mas nada aconteceu com o bolo, não se preocupem. Alguém quer um pedaço?");
 ds_map_add(m,"An-and what about th-the guards with the white dust in their hands?","E-e quanto aos guardas com aquele pó branco nas mãos?");
 ds_map_add(m,"Is part of the onahole contract is their dental insurance and records.","Faz parte do contrato das bonecas sexuais: inclui o seguro odontológico e os registros dentários delas.");
 ds_map_add(m,"What, but what do you need dental records for??","O quê? Mas para que vocês precisam dos registros dentários??");
 ds_map_add(m,"No you donkey, it's the money you earn for the VIP services under the bar even Line knows the place.","Não, sua mula! É o dinheiro que você ganha pelos serviços VIP no subsolo do bar. Até Line conhece aquele lugar.");
 ds_map_add(m,"B-but what about the women and the dental records, weren't they selling them?!","M-mas e as mulheres e os registros dentários? Não estavam vendendo essas pessoas?!");
 ds_map_add(m,"You are completly insane! when a business makes too much money it moves to a safe place to lower the likelihood of theft on the premises in addition to correctly applying the taxes.","Você é completamente louca! Quando um negócio ganha dinheiro demais, ele o transfere para um lugar seguro, reduzindo o risco de roubo no estabelecimento e pagando os impostos corretamente.");
 ds_map_add(m,"The worst thing is that you ask me that kind of question when there were a lot of arcs at this table.","O pior é você me fazer esse tipo de pergunta quando havia um monte de Arcs em cima daquela mesa.");
 ds_map_add(m,"Women were entering and leaving with chains and necklaces and some guards were leaving this house with white powder residue on their hands.","Mulheres entravam e saíam usando correntes e colares, e alguns guardas saíam desta casa com resíduos de pó branco nas mãos.");
 ds_map_add(m,"I'm not an idiot before I heard the rumors I took a closer look at this house.","Não sou idiota. Antes mesmo de ouvir os boatos, investiguei esta casa mais de perto.");
 ds_map_add(m,"But you're crazy! at least you have proof of it?!","Mas você é louca! Pelo menos tem provas disso?!");
 ds_map_add(m,"Don't play dumb, Vasuki told me that this house is used for human trafficking in addition to selling drugs.","Não se faça de boba. Vasuki me contou que esta casa é usada para tráfico de pessoas, além de vender drogas.");
 ds_map_add(m,"What the hell are you talking about?","Do que diabos você está falando?");
 ds_map_add(m,"We trusted you great captain but what you are doing here is simply dreadful.","Confiamos em você, Grande Capitã, mas o que está fazendo aqui é simplesmente horrível.");
 ds_map_add(m,"Yeah!","Isso!");
 ds_map_add(m,"What any person would do, justice!","O que qualquer pessoa faria: justiça!");
 ds_map_add(m,"What do you think you are doing?!","O que você pensa que está fazendo?!");
 ds_map_add(m,"Let's keep looking for clues, I need to corroborate if they are trafficking people.","Vamos continuar procurando pistas. Preciso confirmar se estão traficando pessoas.");
 ds_map_add(m,"Mmmm ok.","Mmmm, está bem.");
 ds_map_add(m,"Line don't touch anything, it fell a little in the bag with the arcs let's take that as evidence.","Line, não toque em nada. Um pouco caiu da bolsa com os Arcs. Vamos levar isso como prova.");
 ds_map_add(m,"Eh I don't think anyone bakes with a bag full of Arcs next to them.","É... não acho que alguém asse alguma coisa com uma bolsa cheia de Arcs ao lado.");
 ds_map_add(m,"looks like someone is baking something.","Parece que alguém está assando alguma coisa.");
 ds_map_add(m,"Mmm it must be nothing I must be a little paranoid.","Mmm, não deve ser nada. Acho que estou um pouco paranoica.");
 ds_map_add(m,"Yes... but these are strange, I've never seen them moving like this.","Sim... mas estas são estranhas. Nunca as vi se mexerem assim.");
 ds_map_add(m,"But as long as we don't touch them we'll be fine, right?","Mas, desde que não toquemos nelas, vai ficar tudo bem, certo?");
 ds_map_add(m,"Those flowers are the same ones I picked where we met, the ones that produce aggression.","Aquelas flores são iguais às que colhi no lugar onde nos conhecemos, as que provocam agressividade.");
 ds_map_add(m,"Wh-what is wrong?","O-o que foi?");
 ds_map_add(m,"Mmm yes line. but there is something strange.","Mmm, sim, Line. Mas há algo estranho.");
 ds_map_add(m,"Bell is that the flower you are looking for?","Bell, é essa a flor que você está procurando?");
 ds_map_add(m,"*The flower starts to shake* Eh?","*A flor começa a tremer* Hã?");
 ds_map_add(m,"Take *coughs* the flower Line quickly please.","Pegue... *tosse* a flor, Line. Rápido, por favor.");
 ds_map_add(m,"*coughs* No, it's already kicking in.","*tosse* Não, o efeito já está começando.");
 ds_map_add(m,"Are you ok Bell?!","Bell, você está bem?!");
 ds_map_add(m,"I can't resist any longer either, I need to do it. *Bell puts his foot on Line's head*","Também não consigo mais resistir. Preciso fazer isso. *Bell apoia o pé na cabeça de Line*");
 ds_map_add(m,"Oh god, I can not containt myself, I WANNA DOIT.","Meu Deus, não consigo me controlar! EU QUERO FAZER!");
 ds_map_add(m,"Oh OHH, this tingling sensation all over my body.","Oh, oh! Esta sensação de formigamento pelo corpo todo...");
 ds_map_add(m,"Ah Line this is not good.","Ah, Line, isso não é bom.");
 ds_map_add(m,"*The flower releases a purple smoke*","*A flor libera uma fumaça roxa*");
 ds_map_add(m,"Thank you so much Line I don't know how I could return the favor.","Muito obrigada, Line. Não sei como poderia retribuir esse favor.");
 ds_map_add(m,"The flower took a lot of damage, but I can still save it.","A flor sofreu muitos danos, mas ainda consigo salvá-la.");
 ds_map_add(m,"I am... more than perfect. *gasping*","Estou... além da perfeição. *ofegante*");
 ds_map_add(m,"I'm sorry Line the flowers made me more aggressive, are you okay?","Sinto muito, Line. As flores me deixaram mais agressiva. Você está bem?");
 ds_map_add(m,"Oh... Oh, god my ass.","Oh... Meu Deus, minha bunda.");
 ds_map_add(m,"maybe two penises, like shark men?","Talvez dois pênis, como os homens-tubarão?");
 ds_map_add(m,"Ya, made me grow a penis... wonder what would happen if a guy ate one?","É, fez crescer um pênis em mim... Fico imaginando o que aconteceria se um homem comesse uma delas.");
 ds_map_add(m,"Didn't you eat those fruits with Vasuki?","Você não comeu aquelas frutas com Vasuki?");
 ds_map_add(m,"great let's get moving? I-i don't have a whole lot of time...~","Ótimo, vamos logo? Eu-eu não tenho muito tempo...~");
 ds_map_add(m,"*Line feels naoki's precum from being in heat.* Do not worry, I-i will look for them as soon as possible.","*Line sente o líquido pré-ejaculatório de Naoki, que está no cio.* Não se preocupe, eu-eu vou procurá-los o mais rápido possível.");
 ds_map_add(m,"If you can grab some purple mushrooms, fura fura and hea hea fruit um... and milk. I think I can grab the rest. You can probably find the mushrooms one in the swamp, t-the milk and the fruits from the farm...","Se puder pegar alguns cogumelos roxos, frutas Fura Fura e Hea Hea, hum... e leite. Acho que consigo pegar o resto. Você provavelmente encontra os cogumelos no pântano, e o-o leite e as frutas na fazenda...");
 ds_map_add(m,"So? what do we need to grab then?","Então? O que precisamos pegar?");
 ds_map_add(m,"I-i mean... if I want to get it done before the urge gets too bad... th-then yes... I-ill need help. Need to gather a bunch of ingredients again.","Quero dizer... se eu quiser terminar antes que a vontade fique forte demais... e-então sim... v-vou precisar de ajuda. Preciso reunir um monte de ingredientes de novo.");
 ds_map_add(m,"Well? Do you need any help? With the potion perhaps?","E então? Precisa de ajuda? Talvez com a poção?");
 ds_map_add(m,"N-no! G-guys c-can get t-that urge!~ mhm! definitely!... at least I-i do...~","N-não! H-homens t-também p-podem sentir e-essa vontade!~ Uhum! Com certeza!... Pelo menos eu s-sinto...~");
 ds_map_add(m,"Arnt you a guy though? Isn't that a girl thing?","Mas você não é homem? Isso não é coisa de mulher?");
 ds_map_add(m,"N-no!~ I-i um... Im gonna start going into heat soon and in the mating season werewolves are somewhat more aggressive than usual.","N-não!~ Eu, hum... Estou prestes a entrar no cio, e, durante a época de acasalamento, os lobisomens ficam um pouco mais agressivos que o normal.");
 ds_map_add(m,"Hot? why do you need a werewolf to cool down?","Com calor? Por que você precisa de um lobisomem para se refrescar?");
 ds_map_add(m,"*Looks at the ground* O-okay... I-I'm a-a little... h-hot right now...~","*Olha para o chão* T-tá bem... E-eu estou u-um pouco... q-quente agora...~");
 ds_map_add(m,"Are we really ganna do this again? *Crosses arms*","Vamos mesmo fazer isso de novo? *Cruza os braços*");
 ds_map_add(m,"Ehh, forget what I said, it's really n-nothing!~~","Ehh, esqueça o que eu disse. Não é n-nada!~~");
 ds_map_add(m,"Wait a minute, why pacify him with a potion you could perfectly well stop them with your magic?","Espere um pouco. Por que acalmá-lo com uma poção se você poderia simplesmente detê-los com sua magia?");
 ds_map_add(m,"Oh no! there are dangerous werewolves on the loose?","Ah, não! Tem lobisomens perigosos à solta?");
 ds_map_add(m,"F-f-fine!~ I-i was going to use it to... p-pacify a w-werewolf...","T-t-tá bom!~ E-eu ia usar isso para... a-acalmar um l-lobisomem...");
 ds_map_add(m,"A potion that dose nothing, come one its gatta do soooomething.","Uma poção que não faz nada? Ah, qual é, ela tem que fazer alguma coisa.");
 ds_map_add(m,"N-n-nothing!!~~ *Blushing*","N-n-nada!!~~ *Corando*");
 ds_map_add(m,"A potion!? What does it do huh.","Uma poção?! O que ela faz, hein?");
 ds_map_add(m,"Oh... u-um n-not much. W-was j-just trying to make a new p-potion","Ah... h-hum, n-nada demais. S-só estava t-tentando criar uma nova p-poção.");
 ds_map_add(m,"We just saw you and wanted to see what you were working on.","Nós só vimos você e quisemos saber no que estava trabalhando.");
 ds_map_add(m,"So... um... C-can I ask wh-why your both here? a-and um... how you found me?","Então... hum... P-posso perguntar p-por que vocês dois estão aqui? E-e como me encontraram?");
 ds_map_add(m,"I-I'm fine.","E-estou bem.");
 ds_map_add(m,"Na-naoki are you okay?","N-Naoki, você está bem?");
 ds_map_add(m,"Did you get the materials Line?","Conseguiu os materiais, Line?");
 ds_map_add(m,"Look line there is another werewolf a-after all this y-you need a pay off too~ T-they will be a bit more a-aggressive b-but you like i-it rough? R-right?~~ *Naoki releases the bindings and lets the werewolves pounce them and have their way*","Olhe, Line, há outro lobisomem. D-depois de tudo isso, v-você também merece uma recompensa~ E-eles serão um pouco mais a-agressivos, m-mas você gosta de algo mais b-bruto, n-não é?~~ *Naoki desfaz as amarras e deixa os lobisomens avançarem sobre eles e fazerem o que quiserem.*");
 ds_map_add(m,"All set now they won't cause any problems although as you can see they are still very energetic *points to the bulge in the wolf's pants*.","Pronto. Agora eles não vão causar problemas, embora, como pode ver, ainda estejam cheios de energia. *Aponta para o volume na calça do lobisomem.*");
 ds_map_add(m,"Naoki uses a chain magic to stop them and administer the pacifying potion.","Naoki usa uma magia de correntes para detê-los e administrar a poção calmante.");
 ds_map_add(m,"Suddenly, two unleashed werewolves appear with a large bulge visible in their pants.","De repente, aparecem dois lobisomens à solta, com grandes volumes visíveis nas calças.");
 ds_map_add(m,"Line Lili and Naoki wait for the werewolves.","Line, Lili e Naoki esperam pelos lobisomens.");
 ds_map_add(m,"*Starts to get red* Then l-lest hurry i-its s-starting t-to be too much~ *He rubs his crotch through his clothes, a bulge visible","*Começa a ficar vermelha* E-então v-vamos nos apressar. J-já está f-ficando demais para mim~ *Ele esfrega a virilha por cima da roupa, com um volume visível");
 ds_map_add(m,"It is very tempting especially for that last part~","É muito tentador, principalmente aquela última parte~");
 ds_map_add(m,"Sounds interesting and we can stay around for the show? (Oh no I am  a furry)","Parece interessante. Podemos ficar por aqui para assistir ao espetáculo? (Ah, não, sou um furry.)");
 ds_map_add(m,"You want to help me hunt down and subdue a werewolf? That's all we needed.","Quer me ajudar a caçar e subjugar um lobisomem? Era exatamente disso que precisávamos.");
 ds_map_add(m,"The potion is ready.","A poção está pronta.");
 ds_map_add(m,"Uff it is a little hot in here hehe.","Uff, está um pouquinho quente aqui, hehe.");
 ds_map_add(m,"Wow naoki you're so hot you're spurting precum","Nossa, Naoki, você está tão excitado que está soltando líquido pré-ejaculatório.");
 ds_map_add(m,"Great, give me the ingredients and I'll do the rest.","Ótimo, me dê os ingredientes e cuido do resto.");
 ds_map_add(m,"Naoki we get everything you need!","Naoki, conseguimos tudo de que você precisa!");
 ds_map_add(m,"Good show girls and boys it's time to go Line.","Bom espetáculo, meninas e meninos. Line, está na hora de ir.");
 ds_map_add(m,"Ye.e.es, I-I'm going to rest for a while","S-s-sim, v-vou descansar um pouco.");
 ds_map_add(m,"Oh yes.. we tranquilized the werewolves or something like that.","Ah, sim... tranquilizamos os lobisomens, ou algo assim.");
 ds_map_add(m,"The astray path","O Caminho Errante");
 ds_map_add(m,"It has been reported that many people have been lost in this part of the forest if you are lost and manage to find this sign, take the path to the right.","Foi relatado que muitas pessoas se perderam nesta parte da floresta. Se você se perder e conseguir encontrar esta placa, siga pelo caminho à direita.");
 ds_map_add(m,"OOOOKKKKKK!","TÁÁÁÁÁÁ BOM!");
 ds_map_add(m,"Yes, be careful not to stumble.","Sim, cuidado para não tropeçar.");
 ds_map_add(m,"It seems that the scent is coming from down here.","Parece que o cheiro vem daqui de baixo.");
 ds_map_add(m,"Uy sorry.","Ui, desculpe.");
 ds_map_add(m,"Line gets out of there, you will fall down!","Line, saia daí, você vai cair!");
 ds_map_add(m,"Yes, do not worry, I fell in these plants by luck.","Sim, não se preocupe. Por sorte, caí em cima destas plantas.");
 ds_map_add(m,"Line for God's sake, are you okay?!","Line, pelo amor de Deus, você está bem?!");
 ds_map_add(m,"Follow me.","Siga-me.");
 ds_map_add(m,"How about we talk everything over at my place and you can even try some of my pie.","Que tal conversarmos sobre tudo lá em casa? Você ainda pode experimentar um pouco da minha torta.");
 ds_map_add(m,"Aww dear you don't know much about succubus do you?","Ah, querida, você não sabe muito sobre súcubos, sabe?");
 ds_map_add(m,"You-you are Marael? you do not look like a succubus.","V-você é Marael? Não parece uma súcubo.");
 ds_map_add(m,"Wait you were looking for me?","Espere, você estava procurando por mim?");
 ds_map_add(m,"Yes, Line then we can continue looking for Marael.","Sim, Line. Depois podemos continuar procurando Marael.");
 ds_map_add(m,"Come to my house darling, you still haven't regained all your strength.","Venha à minha casa, querida. Você ainda não recuperou todas as suas forças.");
 ds_map_add(m,"Wait a little while I'll help you stand up.","Espere um pouco. Vou ajudar você a se levantar.");
 ds_map_add(m,"Do not worry, luckily I fell into this pile of flowers.","Não se preocupe. Por sorte, caí neste monte de flores.");
 ds_map_add(m,"Line please dont die!","Line, por favor, não morra!");
 ds_map_add(m,"Uhhhh I think so.","Uhhhh, acho que sim.");
 ds_map_add(m,"Are you ok darling?","Está bem, querida?");
 ds_map_add(m,"Oh my goodness!","Meu Deus!");
 ds_map_add(m,"So close to knowing something about your missing friend fills you with determination and I guess it also tuns you on or something like that.","Estar tão perto de descobrir algo sobre sua amiga desaparecida enche você de determinação... e acho que também deixa você excitada, ou algo assim.");
 ds_map_add(m,"Uhmm.. it looks like there is a cave behind the barrier.","Hum... parece que há uma caverna atrás da barreira.");
 ds_map_add(m,"Why would someone put this here?","Por que alguém colocaria isso aqui?");
 ds_map_add(m,"A magic barrier is blocking the way.","Uma barreira mágica está bloqueando o caminho.");
 ds_map_add(m,"She doesn't even have a chair for her husband.","Ela nem sequer tem uma cadeira para o marido.");
 ds_map_add(m,"A single chair for a family table.","Uma única cadeira para a mesa da família.");
 ds_map_add(m,"hehe how can I forget that","Hehe, como eu poderia esquecer?");
 ds_map_add(m,"Remember the magazines your mother used to have?","Lembra das revistas que sua mãe costumava ter?");
 ds_map_add(m,"Not the books you would expect from a succubus.","Não são os livros que você esperaria encontrar na casa de uma súcubo.");
 ds_map_add(m,"Cookbooks, how to raise a child and romance novels.","Livros de receitas, sobre como criar uma criança e romances.");
 ds_map_add(m,"No, I asked you to help me bring out my succubus side, not to be a criminal!","Não, pedi que me ajudasse a explorar meu lado súcubo, não a virar criminosa!");
 ds_map_add(m,"didn't you ask me to help you do new things?","Você não me pediu para ajudar a fazer coisas novas?");
 ds_map_add(m,"Lili, you are a very bad influence, you know that?","Lili, você é uma péssima influência, sabia?");
 ds_map_add(m,"Are you going to steal one?","Vai roubar um?");
 ds_map_add(m,"Wow here ... she keeps her erotic books.","Nossa, aqui... é onde ela guarda os livros eróticos.");
 ds_map_add(m,"yeah, there's something weir here.","É, tem alguma coisa estranha aqui.");
 ds_map_add(m,"how strange this must have been purchased before the cave collapse.","Que estranho. Isso deve ter sido comprado antes do desabamento da caverna.");
 ds_map_add(m,"Line look at this she has enough food to live here for months!","Line, olhe só. Ela tem comida suficiente para viver aqui por meses!");
 ds_map_add(m,"Until next time, your favorite succubus -Willow Adams.","Até a próxima, sua súcubo favorita, Willow Adams.");
 ds_map_add(m,"Just volunteer as a guard and we'll have our girls night out. <3","É só se voluntariar para ser guarda e teremos nossa noite das garotas. <3");
 ds_map_add(m,"Come visit me if you feel sad or if you want to talk about what we will do after the angel grants us our wishes.","Venha me visitar se estiver triste ou se quiser conversar sobre o que faremos depois que o anjo realizar nossos desejos.");
 ds_map_add(m,"Hi Marael I hope you are well, I want you to know that I will be at the abandoned Big Dream building like in the old days.","Oi, Marael. Espero que esteja bem. Quero que saiba que estarei no prédio abandonado do Big Dream, como nos velhos tempos.");
 ds_map_add(m,"I'm sorry Line I can't talk to you right now, I'm preparing a surprise for you <3.","Desculpe, Line, não posso falar com você agora. Estou preparando uma surpresa para você. <3");
 ds_map_add(m,"If you need me, I'll be in the kitchen.","Se precisar de mim, estarei na cozinha.");
 ds_map_add(m,"haha it will be just like home.","Haha, vai ser como estar em casa.");
 ds_map_add(m,"I have a room that I use as a storage room, you can sleep there.","Tenho um quarto que uso como depósito. Você pode dormir lá.");
 ds_map_add(m,"Thank you very much Miss Marael for everything. <3","Muito obrigada por tudo, senhorita Marael. <3");
 ds_map_add(m,"Hey, don't be sad, darling, I can teach you some succubus stuff if it makes you feel better.","Ei, não fique triste, querida. Posso ensinar algumas coisas sobre súcubos se isso fizer você se sentir melhor.");
 ds_map_add(m,"Ohh I guess there's nothing left to do but wait. :c","Ohh, acho que não nos resta nada a fazer além de esperar. :c");
 ds_map_add(m,"But don't worry, the guards should be working to open the exit.","Mas não se preocupe, os guardas devem estar trabalhando para abrir a saída.");
 ds_map_add(m,"I am sorry but you will not be able to leave, there was a cave-in in the caverns that block the road to the town.","Sinto muito, mas vocês não vão conseguir sair. Houve um desabamento nas cavernas, bloqueando a estrada para a cidade.");
 ds_map_add(m,"dear wait.","Querida, espere.");
 ds_map_add(m,"This is terrible, thank you very much for everything Miss Marael but we will have to go, we have to continue with the search of our friend.","Que horror. Muito obrigada por tudo, senhorita Marael, mas precisamos ir. Temos que continuar procurando nossa amiga.");
 ds_map_add(m,"He... he works off the island so I was very surprised that he came to visit me so unexpectedly.","Ele... trabalha fora da ilha, então fiquei muito surpresa quando veio me visitar tão de repente.");
 ds_map_add(m,"Mhmm and where is he now?","Hmm, e onde ele está agora?");
 ds_map_add(m,"Oh well I ran into my husband in town haha I haven't seen him in a long time. ","Ah, bem, encontrei meu marido na cidade, haha. Faz muito tempo que não o vejo.");
 ds_map_add(m,"But then who was the person you met who surprised you so much!? Sieki said it had to be someone very special.","Mas então quem foi a pessoa que você encontrou e que a surpreendeu tanto?! Sieki disse que tinha que ser alguém muito especial.");
 ds_map_add(m,"Nice to meet you both and about your friend unfortunately I have not seen her.","Prazer em conhecer vocês duas. Quanto à amiga de vocês, infelizmente não a vi.");
 ds_map_add(m,"I-I am so sorry I did not introduce myself before, I am Line and this is my fairy's familiar her name is Lili.","E-eu sinto muito por não ter me apresentado antes. Sou Line, e esta é a familiar da minha fada. O nome dela é Lili.");
 ds_map_add(m,"Oh... your name was Line right?","Ah... seu nome era Line, certo?");
 ds_map_add(m,"We need your help we are looking for my friend Ava she is an angel and Saeki said you might know about her.","Precisamos da sua ajuda. Estamos procurando minha amiga Ava. Ela é um anjo, e Sieki disse que talvez você soubesse algo sobre ela.");
 ds_map_add(m,"You're welcome, I haven't seen people from a while ago, you can eat whatever you want and stay as long as you want <3.","Por nada. Faz um tempo que não recebo visitas. Podem comer o que quiserem e ficar o tempo que quiserem. <3");
 ds_map_add(m,"Thank you Marael for inviting us to your home.","Obrigada por nos receber em sua casa, Marael.");
 ds_map_add(m,"Let's search the house she must have another way out of this place.","Vamos vasculhar a casa. Ela deve ter outra saída deste lugar.");
 ds_map_add(m,"FUCK Line don't lose your sanity let's try to stay cool maybe we can get out of this.","PORRA, Line, não perca a cabeça. Vamos manter a calma. Talvez consigamos sair dessa.");
 ds_map_add(m,"If so, Sieki is helping by taking easy and desperate prey like us!","Se for isso, então Sieki está ajudando a capturar presas fáceis e desesperadas como nós!");
 ds_map_add(m,"Was the only thing in that cave, maybe she uses that hole to trap people.","Aquilo era a única coisa naquela caverna. Talvez ela use aquele buraco para prender pessoas.");
 ds_map_add(m,"Shit you remember when you fell, you fell in a bed of flowers!","Merda, lembra quando você caiu? Você caiu num canteiro de flores!");
 ds_map_add(m,"Do you think she is the kidnapper of the forest D:?","Você acha que ela é a sequestradora da floresta? D:?");
 ds_map_add(m,"Yes, I noticed that too.","Sim, também percebi.");
 ds_map_add(m,"Lili, do not you think there is something odd going on here?","Lili, você não acha que tem alguma coisa estranha acontecendo aqui?");
 ds_map_add(m,"I don't think so, she's in the kitchen, just watch and act like you don't know anything, when she goes to sleep we keep looking.","Acho que não. Ela está na cozinha. Fique de olho e aja como se não soubesse de nada. Quando ela dormir, continuamos procurando.");
 ds_map_add(m,"Do you think she heard us?","Você acha que ela nos ouviu?");
 ds_map_add(m,"LINEE! I have something for you come to the kitchen.","LINE! Tenho uma coisa para você. Venha à cozinha!");
 ds_map_add(m,"mhmm I don't know but I'm seeing a pattern here just look at this place Marael is also hiding.","Hmm, não sei, mas estou percebendo um padrão. Olhe só para este lugar: Marael também está escondida.");
 ds_map_add(m,"Not that I know, besides, why is this succubus hiding?","Que eu saiba, não. Além disso, por que essa súcubo está escondida?");
 ds_map_add(m,"Can Ava do that?","Ava consegue fazer isso?");
 ds_map_add(m,"But what is this about an angel granting wishes?","Mas o que é essa história de um anjo realizar desejos?");
 ds_map_add(m,"Uff at least she is not a crazy psychopath.","Uff, pelo menos ela não é uma psicopata maluca.");
 ds_map_add(m,"Lili this is what she was hiding she knows Ava!","Lili, é isso que ela estava escondendo. Ela conhece Ava!");
 ds_map_add(m,"Don't worry it was my fault and always will be.","Não se preocupe. A culpa foi minha e sempre será.");
 ds_map_add(m,"I am so sorry I didnt want to come to this I am very sorry for your husband.","Sinto muito. Não queria que as coisas chegassem a esse ponto. Lamento muito pelo seu marido.");
 ds_map_add(m,"Poor little girl this is not the pie I was going to give you but here eat this fruit and release yourself with me.","Pobre garotinha. Esta não é a torta que eu ia lhe dar, mas venha, coma esta fruta e se alivie comigo.");
 ds_map_add(m,"Miss Marael no matter how much I masturbate in front of you-I can not stop and I can't finish.","Senhorita Marael, não importa quantas vezes eu me masturbe na sua frente... não consigo parar e nem chegar ao orgasmo.");
 ds_map_add(m,"OHhh is my all my fault it must be my powers succubus darling, I've been here alone for so long that I haven't suppressed my powers.","OH, a culpa é toda minha! Devem ser meus poderes de súcubo, querida. Estou sozinha aqui há tanto tempo que não tenho reprimido meus poderes.");
 ds_map_add(m,"*starts masturbating* I am so sorry, Miss Marael, but can not resist being near you, it turns me on so much I do not know why.","*começa a se masturbar* Sinto muito, senhorita Marael, mas não consigo resistir quando estou perto de você. Isso me excita tanto, e não sei por quê.");
 ds_map_add(m,"Oh.... Line.","Oh... Line.");
 ds_map_add(m,"UHhh Line I dont think is talking about that pie. *Line please don't do anything stupid.*","Uhhh, Line, acho que ela não está falando daquela torta. *Line, por favor, não faça nenhuma besteira.*");
 ds_map_add(m,"YO-YO-YOU WANT ME TO EAT YOUR PLUM, WARM, MOIST,PIE!","VOCÊÊÊ... QUER QUE EU COMA SUA TORTA DE AMEIXA, QUENTE E ÚMIDA?!");
 ds_map_add(m,"Oh dont worry would you like some 'PIE', Darling....?","Oh, não se preocupe. Gostaria de um pouco de 'TORTA', querida...?");
 ds_map_add(m,"Ohh mmm yeah I-I am so sorry I got carried away *what is wrong with me just being near her I am losing my mind*","Ohh, hmm, sim... D-desculpe, me deixei levar. *O que há de errado comigo? Só de ficar perto dela, estou perdendo a cabeça.*");
 ds_map_add(m,"OHhh Line haha, you're so excited, you told me mom how cute you are <3","OH, Line, haha! Você está tão animada! Até me chamou de mamãe. Que gracinha! <3");
 ds_map_add(m,"Excited is not enough to describe what I'm feeling right now, momy.","Animada não chega nem perto de descrever o que estou sentindo agora, mamãe.");
 ds_map_add(m,"Are you excited about the gift I'm going to give you darling?","Está animada com o presente que vou lhe dar, querida?");
 ds_map_add(m,"Just act normal and stop looking at her ass! *whispering*","Aja normalmente e pare de olhar para a bunda dela! *sussurrando*");
 ds_map_add(m,"Wow Lili she just has an apron and she has a big *glup* bum *whispering*.","Nossa, Lili, ela só está usando um avental e tem uma bunda enooorme. *glup* *sussurrando*");
 ds_map_add(m,"Yes yes I am sorry :c","Sim, sim, desculpe. :c");
 ds_map_add(m,"Wake up Line! you really want to find Ava! *whispering*","Acorde, Line! Você ainda quer encontrar Ava?! *sussurrando*");
 ds_map_add(m,"Uhh no way, I'm exhausted, let's do it better tomorrow.","Ah, nem pensar. Estou exausta. É melhor deixarmos para amanhã.");
 ds_map_add(m,"It is. Let's look around the house for more clues now that she's asleep.","É verdade. Agora que ela está dormindo, vamos procurar mais pistas pela casa.");
 ds_map_add(m,"Mhmm that's a little strange","Hmm, isso é um pouco estranho.");
 ds_map_add(m,"Marael went to sleep and told us not to go out until the morning.","Marael foi dormir e nos disse para não sairmos até de manhã.");
 ds_map_add(m,"Ah ahmmm wh-what?","Ah, ah... h-hã? O quê?");
 ds_map_add(m,"Line! Line! wake up! *whispering*","Line! Line! Acorde! *sussurrando*");
 ds_map_add(m,"Very well I'm going to go to my room to sleep good night. <3","Muito bem, vou para o meu quarto dormir. Boa noite. <3");
 ds_map_add(m,"Ok ok I'll tell Line when she wakes up.","Está bem, está bem. Vou contar a Line quando ela acordar.");
 ds_map_add(m,"It is important so I will repeat it, do not leave this room until morning.","É importante, então vou repetir: não saia deste quarto até de manhã.");
 ds_map_add(m,"Oh and don't leave the room there are so many boxes you could bump into and break something.","Ah, e não saia do quarto. Há tantas caixas que você pode esbarrar em alguma coisa e quebrar algo.");
 ds_map_add(m,"She will most likely wake up in the morning she needs to regain a lot of energy.","Ela provavelmente só vai acordar de manhã. Precisa recuperar muita energia.");
 ds_map_add(m,"Yes, don't worry, I'll take care of her (does she really have a husband, wouldn't he have already looked for help to get home?)","Sim, não se preocupe, vou cuidar dela. (Ela realmente tem um marido? Se tivesse, ele já não teria procurado ajuda para voltar para casa?)");
 ds_map_add(m,"The poor thing couldn't even reach climax on her own and dont worry I'll tell my husband later, he knows I'm a succubus.","A coitadinha nem conseguia chegar ao orgasmo sozinha. E não se preocupe, vou contar ao meu marido mais tarde. Ele sabe que sou uma súcubo.");
 ds_map_add(m,"Lili takes care of Line I think I overdid it a little when I took her energy but how could I not hold back haha it's been a while since my last time haha.","Lili, cuide da Line. Acho que exagerei um pouco quando absorvi a energia dela, mas como poderia me conter? Haha, faz tempo que não transo, haha.");
 ds_map_add(m,"Good night darling.","Boa noite, querida.");
 ds_map_add(m,"let's wait for Marael to go to sleep to investigate further.","Vamos esperar Marael dormir para investigar melhor.");
 ds_map_add(m,"It looks like there is a door behind these boxes.","Parece que há uma porta atrás destas caixas.");
 ds_map_add(m,"Lili Look!","Lili, olhe!");
 ds_map_add(m,"I cannot leave yet without knowing something about Ava.","Ainda não posso ir embora sem descobrir alguma coisa sobre Ava.");
 ds_map_add(m,"Wha :v?","Hã? :v");
 ds_map_add(m,"What-what the fuck are you doing?","O-o que diabos você está fazendo?");
 ds_map_add(m,"*Start praying*","*Começa a rezar*");
 ds_map_add(m,"Yeah, for better or for worse.","É, para o bem ou para o mal.");
 ds_map_add(m,"These pies helped us to find marael.","Estas tortas nos ajudaram a encontrar Marael.");
 ds_map_add(m,"it is now or never we are going to find out what is behind all this.","Agora ou nunca. Vamos descobrir o que está por trás de tudo isso.");
 ds_map_add(m,"And the boxes that cover the door are gone.","E as caixas que cobriam a porta desapareceram.");
 ds_map_add(m,"Lili Marael is not in her room sleeping.","Lili, Marael não está dormindo no quarto dela.");
 ds_map_add(m,"I guess I am doing it for me too, so I will not fail to help her.","Acho que também estou fazendo isso por mim. Não vou falhar em ajudá-la.");
 ds_map_add(m,"I did not know about the downside of being a succubus, I want to help her as much as I can... if something like this happens to me someday, maybe I can be a little more prepared than her.","Eu não sabia das desvantagens de ser uma súcubo. Quero ajudá-la tanto quanto puder... Se um dia algo assim acontecer comigo, talvez eu esteja um pouco mais preparada do que ela.");
 ds_map_add(m,"And what are you going to do with Marael, it's a giant promise you made to her?","E o que você vai fazer em relação a Marael? Você fez uma promessa e tanto a ela.");
 ds_map_add(m,"And your mother managed to form a nice family with your father, even if she didn't teach you anything about how to be a succubus, she did have a happy ending.","E sua mãe conseguiu formar uma bela família com seu pai. Mesmo que não tenha ensinado nada a você sobre como ser uma súcubo, ela teve um final feliz.");
 ds_map_add(m,"I don't know Line, but you're only a half succubus, who knows what will happen in the future.","Não sei, Line. Mas você é só meio súcubo. Quem sabe o que pode acontecer no futuro?");
 ds_map_add(m,"Do you think I could end up like miss marael?","Você acha que posso acabar como a senhorita Marael?");
 ds_map_add(m,"Yes Line?","Sim, Line?");
 ds_map_add(m,"This will increase your damage but reduce the amount of life you recover.","Isso aumentará seu dano, mas reduzirá a quantidade de vida que você recupera.");
 ds_map_add(m,"If Line gets a large amount of match in a fight, Lewdserker will be activated.","Se Line conseguir muitas combinações durante uma luta, o Lewdserker será ativado.");
 ds_map_add(m,"Line feels an energy coming from inside her along with a great burning from her womb.","Line sente uma energia vindo de dentro de si, junto com uma intensa sensação de queimação no útero.");
 ds_map_add(m,"... I will not promise but if I can do something I will let you know.","... Não vou prometer, mas, se puder fazer alguma coisa, aviso você.");
 ds_map_add(m,"Oh beautiful, it's not necessary, I really don't think I can bear another promise that doesn't come true, I really love that you think of me, but you have to know when to give up.","Ah, querida, não precisa. Realmente não acho que conseguiria suportar outra promessa não cumprida. Fico muito feliz que pense em mim, mas você precisa saber quando desistir.");
 ds_map_add(m,"... I know I am lucky and I will try to make that luck come to you too.","... Sei que tenho sorte e vou tentar fazer essa sorte chegar até você também.");
 ds_map_add(m,"You are very lucky to have someone by your side who cares about you and supports you.","Você tem muita sorte de ter alguém ao seu lado que se importa com você e a apoia.");
 ds_map_add(m,"So true Lili <3 !","É verdade, Lili! <3");
 ds_map_add(m,"Knowing yourself is part of life Marael, it may bring you problems but we'll work it out together right Line?","Conhecer a si mesma faz parte da vida, Marael. Isso pode trazer problemas, mas vamos resolver tudo juntas, não é, Line?");
 ds_map_add(m,"Miss Marael, thank you so much, but it's something I really needed to do. I will always remember you as another mother figure to me <3.","Senhorita Marael, muito obrigada, mas era algo que eu realmente precisava fazer. Sempre vou me lembrar de você como uma segunda mãe para mim. <3");
 ds_map_add(m,"... the hunger that you feel is the gluttony of the succubus, as you are half elf it is not necessary that you copulate to get energy but the feeling of emptiness always exists... Line you are a very good girl I really hope this action doesn't bring you any tragedy.","... Essa fome que você sente é a gula da súcubo. Como você é meio elfa, não precisa copular para obter energia, mas a sensação de vazio está sempre presente... Line, você é uma garota muito boa. Espero sinceramente que essa atitude não lhe traga nenhuma tragédia.");
 ds_map_add(m,"Aghh I feel strange, a little more awake and very hungry.","Aghh, estou me sentindo estranha, um pouco mais desperta e com muita fome.");
 ds_map_add(m,"That it is good to see new faces for a change.","É bom ver rostos novos de vez em quando.");
 ds_map_add(m,"I did not insist anymore, I told her that I was fine and if she had time to visit them that it would do her good.","Não insisti mais. Disse a ela que eu estava bem e que, se tivesse tempo para visitá-los, isso lhe faria bem.");
 ds_map_add(m,"She said she had no energy and wanted some time alone.","Ela disse que estava sem energia e queria passar um tempo sozinha.");
 ds_map_add(m,"But I failed.","Mas fracassei.");
 ds_map_add(m,"We talked, I tried to explain to her that they needed help without specifying that without her help all would be lost.","Conversamos. Tentei explicar que eles precisavam de ajuda, sem dizer que, sem a ajuda dela, tudo estaria perdido.");
 ds_map_add(m,"I know that Ms. Marael is praying for someone to save her and for that reason I feel that this will be positive for her.","Sei que a senhorita Marael está rezando para que alguém a salve, e por isso acho que isso será positivo para ela.");
 ds_map_add(m,"But she was sadder than usual, she just did not seem to be helping anyone.","Mas ela estava mais triste do que de costume. Parecia que simplesmente não conseguia ajudar ninguém.");
 ds_map_add(m,"I know that she more than anyone else will want to help these children.","Sei que, mais do que qualquer outra pessoa, ela vai querer ajudar essas crianças.");
 ds_map_add(m,"She was surprised to learn of the situation of the orphans and their caregivers.","Ela ficou surpresa ao saber da situação dos órfãos e de seus cuidadores.");
 ds_map_add(m,"I told Ms. Marael everything.","Contei tudo à senhorita Marael.");
 ds_map_add(m,"I am really sorry.","Sinto muito mesmo.");
 ds_map_add(m,"Don't d-do this to me, I-I beg you.","N-não faça isso comigo, p-por favor. E-eu imploro.");
 ds_map_add(m,"Line please, this is my last chance to be happy in life..","Line, por favor. Esta é minha última chance de ser feliz na vida...");
 ds_map_add(m,"I am sorry Miss Marael, you will have to give me that relic, I will return it to the Knights of Elira.","Sinto muito, senhorita Marael, mas você terá que me entregar essa relíquia. Vou devolvê-la aos Cavaleiros de Elira.");
 ds_map_add(m,"Line listen to me I know I have told many lies since you arrived but you know in your heart that I am a good person please come back to the house.","Line, escute. Sei que contei muitas mentiras desde que você chegou, mas, no fundo, você sabe que sou uma boa pessoa. Por favor, volte para casa.");
 ds_map_add(m,"No! the games are over, we know you know Ava as well as the wish the angel will grant you.","Não! Chega de joguinhos. Sabemos que você também conhece Ava e sabemos do desejo que o anjo vai realizar para você.");
 ds_map_add(m,"darling you need to get out of here, then we can talk more calmly about this.","Querida, você precisa sair daqui. Depois podemos conversar com mais calma.");
 ds_map_add(m,"Don't come any closer!","Não se aproxime!");
 ds_map_add(m,"Line, what are you doing here?!","Line, o que você está fazendo aqui?!");
 ds_map_add(m,"Miss Marael-that's one of the stolen relics!","Senhorita Marael... essa é uma das relíquias roubadas!");
 ds_map_add(m,"I used my last strength to summon some tentacles and take her to bed.","Usei minhas últimas forças para invocar alguns tentáculos e levá-la para a cama.");
 ds_map_add(m,"It seemed that she was carrying a great burden and was finally able to reveal it to someone else.","Parecia que ela carregava um enorme fardo e finalmente conseguira desabafar com outra pessoa.");
 ds_map_add(m,"When Marael stopped crying she fell asleep.","Quando Marael parou de chorar, adormeceu.");
 ds_map_add(m,"And I promise I will do everything I can to help you so you can have a beautiful and loving family.","E prometo que farei tudo o que puder para ajudar você a ter uma família linda e cheia de amor.");
 ds_map_add(m,"But I honestly don't think she has the power to grant wishes.","Mas, sinceramente, não acho que ela tenha o poder de realizar desejos.");
 ds_map_add(m,"And I am sorry for all that Ava has put you through.","E sinto muito por tudo o que Ava fez você passar.");
 ds_map_add(m,"I will take the relic and say that I found it in the forest.","Vou levar a relíquia e dizer que a encontrei na floresta.");
 ds_map_add(m,"Is ok, everithing will be ok.","Está tudo bem. Vai ficar tudo bem.");
 ds_map_add(m,"I'm really sorry I'm sorry I just wanted to be happy!","Sinto muito, sinto muito mesmo! Eu só queria ser feliz!");
 ds_map_add(m,"With the wish I would ask to meet that special someone for me!","Com o desejo, eu pediria para conhecer alguém especial para mim!");
 ds_map_add(m,"I-I just wanted to start a family raise my children and go out with my husband!","E-eu só queria formar uma família, criar meus filhos e sair com meu marido!");
 ds_map_add(m,"I-I'm really sorry, but-but what choice did I have?","E-eu sinto muito, mas... mas que escolha eu tinha?");
 ds_map_add(m,"That's when I met your friend, she promised me that if I stole the relic and fed it with energy, she would grant me a wish.","Foi então que conheci sua amiga. Ela me prometeu que, se eu roubasse a relíquia e a alimentasse com energia, realizaria um desejo meu.");
 ds_map_add(m,"I even learned how to cook so that they would at least fall in love with me for my cooking, but that didn't happen either.","Até aprendi a cozinhar para que pelo menos gostassem de mim pela minha comida, mas nem isso deu certo.");
 ds_map_add(m,"For the people I was nothing more than a piece of meat that could satisfy their needs.","Para aquelas pessoas, eu não passava de um pedaço de carne capaz de satisfazer suas necessidades.");
 ds_map_add(m,"I never met anyone who saw me more than a succubus.","Nunca conheci alguém que enxergasse algo além de uma súcubo em mim.");
 ds_map_add(m,"My husband does not exist I made him up and I was completely miserable in my job.","Meu marido não existe. Eu o inventei, e eu era completamente infeliz no meu trabalho.");
 ds_map_add(m,"No darling, you are wrong, I have nothing to lose, because I have nothing.","Não, querida, você está enganada. Não tenho nada a perder, porque não tenho nada.");
 ds_map_add(m,"Miss Marael why did you steal the relic, you had everything, a husband, a dream job and you are good at cooking, why risk everything you have done in life for this?","Senhorita Marael, por que roubou a relíquia? Você tinha tudo: um marido, o emprego dos sonhos e ainda cozinha muito bem. Por que arriscar tudo o que construiu na vida por causa disso?");
 ds_map_add(m,"Guau.","Uau.");
 ds_map_add(m,"Yeah, BAD, BAD DOGGY!","Isso! CACHORRO MAU! CACHORRO MAU!");
 ds_map_add(m,"This dog seems to be grounded :O.","Parece que este cachorro está de castigo :O.");
 ds_map_add(m,"I'm sorry, Miss, but the library is closed..","Sinto muito, senhorita, mas a biblioteca está fechada...");
 ds_map_add(m,"Line get up, you are naked in the middle of the street, the guards can take you prisoner!","Line, levante-se! Você está nua no meio da rua. Os guardas podem prender você!");
 ds_map_add(m,"Oh thanks I guess, bye Lemmy.","Ah, obrigada, eu acho. Tchau, Lemmy.");
 ds_map_add(m,"Hey fairy, I'll leave your friend here, she had a good time, she resisted Lemmy well.","Ei, fada, vou deixar sua amiga aqui. Ela se divertiu bastante e aguentou bem as investidas de Lemmy.");
 ds_map_add(m,"*Gulp* I'm going to get out of the carriage, I'll wait for you outside Line. :v","*Engole em seco* Vou sair da carruagem. Espero por você lá fora, Line. :v");
 ds_map_add(m,"...HELLo?","... ALÔ?");
 ds_map_add(m,"Ehh I'm sure Lemmy isn't big enough to cover all the walls.","Ehh, tenho certeza de que Lemmy não é grande o bastante para cobrir todas as paredes.");
 ds_map_add(m,"Where did so many tentacles come from, was it you lemmy?","De onde vieram tantos tentáculos? Foi você, Lemmy?");
 ds_map_add(m,"Wow it looks like seeing Lemmy's dick hasn't destroyed your mind, it might be a good reward since you helped me so much.","Nossa, parece que ver o pau de Lemmy não acabou com sua sanidade. Talvez seja uma boa recompensa, já que você me ajudou tanto.");
 ds_map_add(m,"God mother fucking, DAMN.","Puta que pariu, CARALHO!");
 ds_map_add(m,"Unsheathe boy and don't look at it for too long it might be a bit much for mortals.","Puxe para fora, garoto, e não fique olhando por muito tempo. Pode ser demais para os mortais.");
 ds_map_add(m,"I hope you don't mind me calling Lemmy but I need to relax after all that has happened.","Espero que não se importe que eu chame Lemmy, mas preciso relaxar depois de tudo o que aconteceu.");
 ds_map_add(m,"Yes, my name is ZONE-tan and I came to this island to rest and have a good time but it all ended so badly.","Sim, meu nome é ZONE-tan. Vim para esta ilha descansar e me divertir, mas tudo acabou dando muito errado.");
 ds_map_add(m,"Wh-who are you Lemmy's mistress?!","Q-quem é você? A amante de Lemmy?!");
 ds_map_add(m,"Just a little bit more!!!","Só mais um pouquinho!!!");
 ds_map_add(m,"AHhhhh the key is absorbing that thing.","AAAhhh, a chave está absorvendo aquilo.");
 ds_map_add(m,"Ah, ah ah here it is.","Ah, ah, ah, aqui está.");
 ds_map_add(m,"Shit Line pulls out the key!","Merda, Line, tire a chave!");
 ds_map_add(m,"It is quite big here, what's that?!","Este lugar é bem grande. O que é aquilo?!");
 ds_map_add(m,"*Line and Lili enter the carriage*","*Line e Lili entram na carruagem*");
 ds_map_add(m,"Ah fine.","Ah, está bem.");
 ds_map_add(m,"Wait! Is it too late to forget about this?","Espere! Ainda dá tempo de desistir disso?");
 ds_map_add(m,"Do not worry Lemmy, your mistress will be fine.","Não se preocupe, Lemmy. Sua dona vai ficar bem.");
 ds_map_add(m,"He wants us to get into the carriage.","Ele quer que entremos na carruagem.");
 ds_map_add(m,"AHhh what did he say?","AAAh, o que ele disse?");
 ds_map_add(m,"Lemmy we brought the key to your mistress.","Lemmy, trouxemos a chave para sua dona.");
 ds_map_add(m,"Ohh Ok, this is my first time in such a public place.","Oh, está bem. É minha primeira vez fazendo isso em um lugar tão público.");
 ds_map_add(m,"Don't worry, I've done it many times and she's always in her own world and besides her there's no one in the library.","Não se preocupe, já fiz isso muitas vezes. Ela está sempre no mundo da lua e, além dela, não há ninguém na biblioteca.");
 ds_map_add(m,"But what about the librarian?","Mas e a bibliotecária?");
 ds_map_add(m,"Haha Well, I wouldn't mind doing it here, in fact.","Haha, bem, na verdade eu não me importaria de fazer isso aqui.");
 ds_map_add(m,"... I don't know why I ask, go on.","... Não sei por que perguntei. Continue.");
 ds_map_add(m,"Wait Line, you really don't want the 1000 Arcs?","Espere, Line, você realmente não quer os 1.000 Arcs?");
 ds_map_add(m,"Wa-wait it is not necessary, Mmm maybe if you reward me with something else.","E-espera, não precisa. Hmmm, talvez se você me recompensar com outra coisa...");
 ds_map_add(m,"...Ahh fine, at least it's cheaper than the vip under the bar.","... Ah, está bem. Pelo menos é mais barato do que o VIP no subsolo do bar.");
 ds_map_add(m,"Yes, packed full of pictures of you fucking monster girls!","Sim, está cheio de fotos suas transando com garotas-monstro!");
 ds_map_add(m,"What?! You saw what was in the briefcase!","O quê?! Você viu o que havia na maleta?!");
 ds_map_add(m,"What! NO it will be 10,000 Arcs we saw your dirty secret.","O quê?! NÃO! Serão 10.000 Arcs. Vimos seu segredinho sujo.");
 ds_map_add(m,"Oh you saved my life take 1000 Arcs for your trouble.","Ah, você salvou minha vida. Fique com 1.000 Arcs pelo trabalho.");
 ds_map_add(m,"Gilfried we found your briefcase.","Gilfried, encontramos sua maleta.");
 ds_map_add(m,"Gilfried The Monster Fucker.","Gildfried, o Fodedor de Monstros.");
 ds_map_add(m,"Ok it's time to go, if you want to see her again go to this address that's where we sleep.","Está bem, hora de ir. Se quiser vê-la de novo, vá a este endereço. É lá que estamos dormindo.");
 ds_map_add(m,"Yeah Oohw, I swear it's the first time it's happened.","É, uuh, juro que é a primeira vez que isso acontece.");
 ds_map_add(m,"You said that the librarian is always in her own world.","Você disse que a bibliotecária está sempre no mundo da lua.");
 ds_map_add(m,"Wha what happend?","O-o que aconteceu?");
 ds_map_add(m,"Ehhh Gilfried?","Ehhh, Gilfried?");
 ds_map_add(m,"Dude she is half succubus.","Cara, ela é meio súcubo.");
 ds_map_add(m,"Yeah that was better than I imagine you are not a just a regular elf.","É, foi melhor do que eu imaginava. Você não é uma elfa qualquer.");
 ds_map_add(m,"Ohh it felt so good in my poopa.","Ohh, foi tão gostoso no meu bumbum.");
 ds_map_add(m,"The sword in the anvil of the purple and green forest remains a mystery to most, but its magic endures, waiting to be discovered by those truly worthy. This legend inspires generations to seek wisdom, purity, and strength in their hearts, in pursuit of a greater purpose in this magical corner of the world.","A espada na bigorna da Floresta Roxa e Verde continua sendo um mistério para a maioria. Mas sua magia perdura, à espera de ser descoberta por alguém verdadeiramente digno. Essa lenda inspira gerações a buscar sabedoria, pureza e força em seus corações, em busca de um propósito maior neste canto mágico do mundo.");
 ds_map_add(m,"The brave who venture into this forest must make a gesture of peace, imitate the purity of a rabbit, and show the strength of a gorilla to lift the sword from the anvil at its purple center. Only a few throughout the centuries have been worthy of this feat and become guardians of the forest, destined to protect peace and harmony in the world.","Os bravos que se aventuram nesta floresta devem fazer um gesto de paz, imitar a pureza de um coelho e demonstrar a força de um gorila para retirar a espada da bigorna em seu centro roxo. Ao longo dos séculos, apenas alguns foram dignos desse feito e se tornaram guardiões da floresta, destinados a proteger a paz e a harmonia do mundo.");
 ds_map_add(m,"In a remote forest with a purple center and shimmering green trees, lies a legendary sword forged by The one Horned god. This unique sword, with an unusual hilt made of balls, can only be claimed by those who demonstrate wisdom, purity, and strength.","Em uma floresta remota, com um centro roxo e árvores verdes cintilantes, encontra-se uma espada lendária forjada pelo Deus de Um Chifre. Essa espada única, com um punho incomum feito de bolas, só pode ser reivindicada por quem demonstrar sabedoria, pureza e força.");
 ds_map_add(m,"The Pelletclad Blade.","A Lâmina Revestida de Projéteis.");
 ds_map_add(m,"*snif snif* Ok :c.","*snif, snif* Está bem. :c");
 ds_map_add(m,"Let's go get it, before you get scolded again for yelling and screaming.","Vamos buscá-la antes que você leve outra bronca por gritar e fazer escândalo.");
 ds_map_add(m,"Oh I am sorry I am sorry I am sorry :c.","Ah, desculpe, desculpe, desculpe! :c");
 ds_map_add(m,"Lili the author lives on the island!","Lili, o autor mora na ilha!");
 ds_map_add(m,"Story written by Clifftop Vegando currently lives quietly on the island of Elira.","História escrita por Clifftop Vegando, que atualmente vive tranquilamente na ilha de Elira.");
 ds_map_add(m,"Read the back cover.","Leia a contracapa.");
 ds_map_add(m,"Read the tale.","Leia a história.");
 ds_map_add(m,"It's ok but let's read the story again, maybe we'll find something we missed that could help us.","Tudo bem, mas vamos ler a história de novo. Talvez encontremos alguma coisa que deixamos passar e que possa nos ajudar.");
 ds_map_add(m,"Well, if we are passing through the forest, I do not see why we should look for it.","Bem, já que vamos atravessar a floresta, não vejo por que não procurar por ela.");
 ds_map_add(m,"Do you want to look for the sword?","Quer procurar a espada?");
 ds_map_add(m,"Yes but how many have a story written about them.","É, mas quantas espadas têm uma história escrita especialmente sobre elas?");
 ds_map_add(m,"Mmm I thought it was normal on this island since almost every place has high energy points.","Mmm, achei que isso fosse normal nesta ilha, já que quase todos os lugares têm pontos de alta energia.");
 ds_map_add(m,"It is not that, well actually yes but I really feel a great energy from the forest that is south of the hospital.","Não é isso... Bem, na verdade, também é, mas sinto mesmo uma energia enorme vindo da floresta ao sul do hospital.");
 ds_map_add(m,"Please tell me you don't believe this.","Por favor, me diga que você não acredita nisso.");
 ds_map_add(m,"I don't think entering the church without permission is good idea.","Não acho uma boa ideia entrar na igreja sem permissão.");
 ds_map_add(m,"They even stole our sign.","Até roubaram nossa placa.");
 ds_map_add(m,"I am sorry but due to the theft of the sacred relics the church is closed to the public for the time being.","Sinto muito, mas, devido ao roubo das relíquias sagradas, a igreja ficará fechada ao público por enquanto.");
 ds_map_add(m,"Yes, I think that would cheer her up and... Thank you Lili for always being with me.","Sim, acho que isso vai animá-la e... Obrigada, Lili, por estar sempre comigo.");
 ds_map_add(m,"Let's give you the good news","Vamos dar a boa notícia para Marael.");
 ds_map_add(m,"Hey let's go see Marael in theory everything has been solved.","Ei, vamos visitar Marael. Em teoria, tudo já foi resolvido.");
 ds_map_add(m,"... yes Lili?","... Sim, Lili?");
 ds_map_add(m,"Hey Line.","Ei, Line.");
 ds_map_add(m,"But it's okay, I'll get over it.","Mas tudo bem. Vou superar isso.");
 ds_map_add(m,"Mmm my head hurts a little.","Mmm, minha cabeça dói um pouco.");
 ds_map_add(m,"Is there something wrong Line?","Tem alguma coisa errada, Line?");
 ds_map_add(m,"Here you go, all the father's semen I saved just for you, now you have no excuse to say that a succubus didn't do anything for you <3.","Aqui está: todo o sêmen do padre que guardei só para você. Agora não tem mais desculpa para dizer que uma súcubo nunca fez nada por você. <3");
 ds_map_add(m,"Go away champion.","Vá embora, campeã.");
 ds_map_add(m,"*Criying* What-are-you-doing? sniff sniff.","*Chorando* O-o que você está fazendo? snif, snif.");
 ds_map_add(m,"Ohhhh YES ahhh. Wh-What are you doing here?!","Ohhhh, ISSO! Ahhh. O-o que você está fazendo aqui?!");
 ds_map_add(m,"F-Father why did you call me here?","P-pai, por que me chamou aqui?");
 ds_map_add(m,"Slup shlup-shhhp shlup.","Slup, shlup-shhhp, shlup.");
 ds_map_add(m,"Eh-eh it's okay * pulls down his pants.","É-é, tudo bem. *puxa as calças para baixo.");
 ds_map_add(m,"Easy she'll never know * stroking his penis.","Calma, ela nunca vai descobrir. *acariciando o pênis.");
 ds_map_add(m,"Miss Line, if I came here it is to stop this, I love Sister Nero,Ahh.. and why are you dressed as one of the sisters?","Senhorita Line, se vim até aqui foi para impedir isso. Amo a irmã Nero... Ahh... E por que você está vestida como uma das irmãs?");
 ds_map_add(m,"Hello father.","Olá, padre.");
 ds_map_add(m,"No, I-I don't want to, I-I'll stay here.","Não, e-eu não quero. V-vou ficar aqui.");
 ds_map_add(m,"Shit, you're so annoying are you part of this yes or no?!","Porra, você é muito irritante! Vai participar ou não?!");
 ds_map_add(m,"PLEASE don't put on the nun's outfit Line this is what marael warned us about, Please Stop, you will regret it for the REST of your LIFE.","POR FAVOR, não vista o hábito de freira, Line! Foi disso que Marael nos avisou. Por favor, pare! Você vai se arrepender pelo RESTO DA VIDA.");
 ds_map_add(m,"(What's going on, why did I make Lili cry, what did I do during the day?! Oh Lili please forgive me)","(O que está acontecendo? Por que fiz Lili chorar? O que eu fiz durante o dia?! Ah, Lili, por favor, me perdoe.)");
 ds_map_add(m,"Line st-stop please this is not you you would never h-hurt someone like that. *begins to sob*.","Line, p-pare, por favor! Essa não é você. Você nunca machucaria alguém desse jeito. *começa a soluçar*");
 ds_map_add(m,"Stop meddling in my life, I'll only do what I'm made for, now get out!","Pare de se meter na minha vida! Só vou fazer aquilo para que fui feita. Agora saia!");
 ds_map_add(m,"I know you are angry, but don't screw with the father.","Sei que você está com raiva, mas não desconte no padre.");
 ds_map_add(m,"But-","Mas...");
 ds_map_add(m,"Stop it Line, stop playing dumb I beg you please don't do it!","Pare com isso, Line! Pare de fingir que não entende. Eu imploro, por favor, não faça isso!");
 ds_map_add(m,"What, what's wrong, it wasn't daytime, why, it's nighttime?","O quê? O que está acontecendo? Ainda não era dia? Por quê? Já está de noite?");
 ds_map_add(m,"Stop! Please don't do this, if you do something like this you will regret it forever!","Pare! Por favor, não faça isso. Se fizer uma coisa dessas, vai se arrepender para sempre!");
 ds_map_add(m,"Mo-mother?.","M-mãe?");
 ds_map_add(m,"He-HeHE.","He-heHE.");
 ds_map_add(m,"Hehe I guess that is fun <3. take care of yourself.","Hehe, acho que isso é divertido. <3 Cuide-se.");
 ds_map_add(m,"Yes I also got myself assigned here, now the sisters will have to see me every day to get to their precious place, Hahaha it fills my heart with joy to make them rage at least a little bit.","Sim, sim, consegui ser transferida para cá. Agora as irmãs terão que me ver todos os dias para chegar ao lugar precioso delas. Hahaha, meu coração se enche de alegria só de deixá-las um pouquinho furiosas.");
 ds_map_add(m,"Well I guess it is something.","Bem, acho que já é alguma coisa.");
 ds_map_add(m,"Mmmm nope for now, but once I finish my sentence I will stay working here if I can, it's not too bad, most of the guards do almost nothing.","Mmmm, por enquanto não. Mas, quando terminar de cumprir minha pena, vou continuar trabalhando aqui, se puder. Não é tão ruim; a maioria dos guardas quase não faz nada.");
 ds_map_add(m,"So you will not make any money?","Então você não vai ganhar dinheiro?");
 ds_map_add(m,"Haha yes, well the truth is that while looking for a job I was arrested and I asked for community service to pay off my debt to society and... here I am.","Haha, sim. Bem, a verdade é que, enquanto procurava emprego, fui presa e pedi para cumprir serviço comunitário para pagar minha dívida com a sociedade... e aqui estou.");
 ds_map_add(m,"But how, if you are a criminal, how did you end up as a guard?","Mas como? Se você é uma criminosa, como acabou virando guarda?");
 ds_map_add(m,"Haha Hi Line, look where I got a job.","Haha, oi, Line. Olha só onde consegui um emprego.");
 ds_map_add(m,"Yes, yes, yes I have one eye open relax.","Sim, sim, sim. Estou de olho, relaxe.");
 ds_map_add(m,"What do you mean, relaxed? You should be attentive, you're a guard!","Como assim, relaxada? Você deveria ficar atenta, é uma guarda!");
 ds_map_add(m,"You know what? I never thought the day would come when I would feel relaxed. Thank you for helping me and the kids.","Sabe de uma coisa? Nunca pensei que chegaria o dia em que me sentiria tranquila. Obrigada por ajudar a mim e às crianças.");
 ds_map_add(m,"...(For the first time in my life, I felt the desire to harm someone) I will go leave the relic.","... (Pela primeira vez na vida, senti vontade de machucar alguém.) Vou devolver a relíquia.");
 ds_map_add(m,"I'm very sure. Her presence was like a miasma; it can't bring anything good. That's how they are, those of her kind.","Tenho certeza. A presença dela era como um miasma; não poderia trazer nada de bom. Gente da espécie dela é assim.");
 ds_map_add(m,"(This woman just wants to give the demon a hard time.) Are you sure she could really be related to this? Remember, we can't waste time on other things.","(Essa mulher só quer atormentar o demônio.) Tem certeza de que ela realmente pode estar envolvida nisso? Lembre-se, não podemos perder tempo com outras coisas.");
 ds_map_add(m,"It's the island's librarian, daughter of a demon. She couldn't stop talking about the light our goddess emitted.","É a bibliotecária da ilha, filha de um demônio. Ela não parava de falar sobre a luz que nossa deusa emanava.");
 ds_map_add(m,"Hmm, I only know one person who started spending a lot of time here when our prophet made her first presence. I always found it a bit strange, but she spent a lot of time admiring her like the rest of us.","Hmm, só conheço uma pessoa que começou a passar muito tempo aqui quando nossa profetisa apareceu pela primeira vez. Sempre achei um pouco estranho, mas ela passava muito tempo admirando-a, como todos nós.");
 ds_map_add(m,"...I want to save her, but I need help. Any information about where the other relics are will be useful.","... Quero salvá-la, mas preciso de ajuda. Qualquer informação sobre o paradeiro das outras relíquias será útil.");
 ds_map_add(m,"(Ava, what are you planning? Is this really part of your plan, or are you truly in danger?)","(Ava, o que você está planejando? Isso realmente faz parte do seu plano ou você está mesmo em perigo?)");
 ds_map_add(m,"Save her, for yourself, for all of us, for the world. *Starts praying.*","Salve-a, por você, por todos nós, pelo mundo. *Começa a rezar.*");
 ds_map_add(m,"That's why she needs you. You are part of her prophecy. Get the remaining three relics and save her.","É por isso que ela precisa de você. Você faz parte da profecia dela. Pegue as três relíquias restantes e salve-a.");
 ds_map_add(m,"That's right, she, our prophet, will die...","Isso mesmo. Ela, nossa profetisa, vai morrer...");
 ds_map_add(m,"B-b-but if she can't get out-","M-m-mas, se ela não conseguir sair...");
 ds_map_add(m,"It's a sacred room linked to the relics. Once they were stolen, the room sealed itself.","É uma sala sagrada ligada às relíquias. Quando foram roubadas, a sala se selou sozinha.");
 ds_map_add(m,"The day all the relics were stolen, she was behind this door.","No dia em que todas as relíquias foram roubadas, ela estava atrás desta porta.");
 ds_map_add(m,"What? But how?!","O quê? Mas como?!");
 ds_map_add(m,"...Unfortunately, that can't be done right now. She is currently imprisoned.","... Infelizmente, isso não pode ser feito agora. Ela está presa neste momento.");
 ds_map_add(m,"Hmm, before returning the relic, I need to know... Where is the angel? I know it's here.","Hmm, antes de devolver a relíquia, preciso saber... Onde está o anjo? Sei que está aqui.");
 ds_map_add(m,"Give her the relic, so we can move faster from this hause of stupidity.","Entregue a relíquia a ela, para podermos sair logo desta casa de estupidez.");
 ds_map_add(m,"I-I do not know what you Are talking about. (Oh no, she not only knows I'm a demon but also that I'm a succubus. :c)","N-não sei do que você está falando. (Ah, não! Ela não só sabe que sou um demônio, como também sabe que sou uma súcubo. :c)");
 ds_map_add(m,"I admit her actions are admirable.\nBut if she plans to enter the house of God, she should at least not arrive with the scent of a woman of the night.","Admito que as atitudes dela são admiráveis.\nMas, se pretende entrar na casa de Deus, deveria ao menos não chegar com o cheiro de uma mulher da vida.");
 ds_map_add(m,"(It is clear she dislikes me. Even though I appear as an elf, I still have a demon's horn.)","(Está claro que ela não gosta de mim. Mesmo parecendo uma elfa, ainda tenho um chifre de demônio.)");
 ds_map_add(m,"Hey, who do you think you are! Line has helped the people on the island, even you! What does it matter how she looks.","Ei, quem você pensa que é?! Line ajudou as pessoas da ilha, até você! Que diferença faz a aparência dela?");
 ds_map_add(m,"Oh, nothing. It's just that I never thought the hero would be s-someone with... your characteristics.","Ah, nada. É só que nunca imaginei que a heroína seria a-alguém com... as suas características.");
 ds_map_add(m,"Oh, wh-what's happening?","Ah, o-o que está acontecendo?");
 ds_map_add(m,"*Line takes a step forward* Miss, could you tell me- *The nun takes a step back with a disgusted look*.","*Line dá um passo à frente* Senhorita, poderia me dizer... *A freira dá um passo para trás, com uma expressão de nojo.*");
 ds_map_add(m,"(Ava also lied to the entire church, she told them a prophecy and manipulated the succubi to make it come true.)","(Ava também mentiu para a igreja inteira. Contou a eles uma profecia e manipulou as súcubos para fazê-la se tornar realidade.)");
 ds_map_add(m,"She prophesied the arrival of a hero who would return our sacred relics once they leave the house of God.","Ela profetizou a chegada de uma heroína que devolveria nossas relíquias sagradas depois que elas deixassem a casa de Deus.");
 ds_map_add(m,"Our goddess has spoken to us through the light of a thousand colors.","Nossa deusa falou conosco por meio da luz de mil cores.");
 ds_map_add(m,"And how do you know we were coming?","E como vocês sabiam que estávamos vindo?");
 ds_map_add(m,"H-h-how do you kn-know my name?","C-c-como você s-sabe meu nome?");
 ds_map_add(m,"We were waiting for you, Line.","Estávamos esperando por você, Line.");
 ds_map_add(m,"At last, you've arrived.","Finalmente, você chegou.");
 ds_map_add(m,"*slaps her face* shut up you slut and get out of here.","*dá um tapa no rosto dela* Cale a boca, sua vadia, e saia daqui.");
 ds_map_add(m,"I am sick and tired of you demigrating me just for being a-","Estou farta de vocês me humilharem só por eu ser uma...");
 ds_map_add(m,"Impossible for someone like you to understand what love is, you are no more than an animal, in fact, you are less than an animal, at least they can feel love for their owners.","Alguém como você é incapaz de entender o que é o amor. Você não passa de um animal. Na verdade, é menos que um animal. Pelo menos eles conseguem amar seus donos.");
 ds_map_add(m,"What-what are you doing? You can't do that here, it's a sin!","O-o que você está fazendo? Não pode fazer isso aqui, é pecado!");
 ds_map_add(m,"What are you doing here, you filthy blood?","O que está fazendo aqui, sangue imundo?");
 ds_map_add(m,"I think it's this way.","Acho que é por aqui.");
 ds_map_add(m,"Ay Line speaks clearly, you're an adult for fuck's sake.","Ei, Line, fale direito. Você é adulta, porra!");
 ds_map_add(m,"That thing, which adults do.","Aquela coisa que os adultos fazem.");
 ds_map_add(m,"What the hell Line, what do you mean?","Que diabos, Line? O que você quer dizer?");
 ds_map_add(m,"It's, that smell you know, when you do that thing.","É... aquele cheiro, sabe, quando você faz aquilo.");
 ds_map_add(m,"What, what thing?","O quê? Que coisa?");
 ds_map_add(m,"Hey, you do not feel that?","Ei, você não está sentindo isso?");
 ds_map_add(m,"I swear that woman will pay for everything she has done to me.","Juro que aquela mulher vai pagar por tudo o que fez comigo.");
 ds_map_add(m,"*hug* all right, let's get out of here.","*abraço* Está bem, vamos sair daqui.");
 ds_map_add(m,"*clenches his fist in anger* I swear that woman will pay for this.","*fecha o punho com raiva* Juro que aquela mulher vai pagar por isso.");
 ds_map_add(m,"Line are you ok?","Line, você está bem?");
 ds_map_add(m,"I'd better go","É melhor eu ir.");
 ds_map_add(m,"And about what you saw, I have no position to ask you to keep silent but if something like this becomes known we could lose everything.","Quanto ao que você viu, não estou em posição de pedir que fique em silêncio, mas, se algo assim vier a público, podemos perder tudo.");
 ds_map_add(m,"Then she ended up in the street because of his parents' abandonment.","Então ela acabou na rua porque os pais a abandonaram.");
 ds_map_add(m,"Miss Line I beg your pardon, she has an aversion to succubus since her parents were separated by one.","Senhorita Line, peço desculpas. Ela tem aversão a súcubos porque os pais dela foram separados por uma.");
 ds_map_add(m,"I'm leaving.","Estou indo embora.");
 ds_map_add(m,"I will do it for you father, but not for this creature from hell.","Farei isso pelo senhor, padre, mas não por essa criatura saída do inferno.");
 ds_map_add(m,"NOW, BOTH OF YOU STOP!","AGORA, VOCÊS DOIS, PAREM!");
 ds_map_add(m,"Shut up you racist asshole.","Cale a boca, seu babaca racista.");
 ds_map_add(m,"Cursed hooker.","Prostituta maldita.");
 ds_map_add(m,"Line, let's get us out of here, remember that Ava needs you.","Line, vamos sair daqui. Lembre-se de que Ava precisa de você.");
 ds_map_add(m,"Enough of both of you!","Chega! Os dois já passaram dos limites!");
 ds_map_add(m,"Now I just need to find him","Agora só preciso encontrá-lo.");
 ds_map_add(m,"I will get more money extorting him with the contents of the briefcase and I will make much more money than selling it hahaha.","Vou conseguir muito mais dinheiro extorquindo-o com o conteúdo da maleta do que vendendo tudo, hahaha.");
 ds_map_add(m,"A businessman forgot his briefcase in the bar and ended up taking it to me to sell it, but its contents were much better than I thought.","Um empresário esqueceu a maleta no bar, e alguém acabou trazendo-a para mim para vender. Mas o conteúdo era muito melhor do que eu imaginava.");
 ds_map_add(m,"I ended up selling the key to the secret fight club hidden in the forest.","Acabei vendendo a chave do clube de luta secreto escondido na floresta.");
 ds_map_add(m,"Luckily it was nighttime and she and what I assume is her bodyguard were distracted going to the bar so I just ran and stole the key, though for some reason they didn't follow me.","Por sorte, era noite, e ela e quem suponho ser seu guarda-costas estavam distraídos indo ao bar. Então corri e roubei a chave, embora, por algum motivo, não tenham vindo atrás de mim.");
 ds_map_add(m,"On the way to my lair, I saw a Zone-tan celebrity. she was carrying a giant golden key that I simply couldn't resist stealing.","A caminho do meu esconderijo, vi uma celebridade chamada Zone-tan. Ela carregava uma enorme chave dourada que simplesmente não consegui resistir à tentação de roubar.");
 ds_map_add(m,"(is all blank)","(Está tudo em branco.)");
 ds_map_add(m,"Exit.","Sair.");
 ds_map_add(m,"Briefcase Black Mail.","Chantagem da Maleta.");
 ds_map_add(m,"Giant Gold Key!.","Chave de Ouro Gigante!");
 ds_map_add(m,"False bridge guards switcheroo.","Troca dos Guardas Falsos da Ponte.");
 ds_map_add(m,"Heist book","Livro do Assalto");
 ds_map_add(m,"(Line opens the briefcase in two and finds hundreds of pictures)","(Line abre a maleta e encontra centenas de fotos.)");
 ds_map_add(m,"I-I am doing it!","E-estou fazendo isso!");
 ds_map_add(m,"Open it! open it now!","Abra! Abra agora!");
 ds_map_add(m,"What must be inside for him to be this desperate?","O que será que tem aí dentro para deixá-lo tão desesperado?");
 ds_map_add(m,"Yes, he looked very desperate.","Sim, ele parecia desesperado mesmo.");
 ds_map_add(m,"Well you found Gilfried's briefcase now we just have to return it.","Bem, você encontrou a maleta de Gilfried. Agora só precisamos devolvê-la.");
 ds_map_add(m,"* Line receives the key * ... thanks.","*Line recebe a chave* ... Obrigada.");
 ds_map_add(m,"Bring the solid gold key to The Bitch","Leve a chave de ouro maciço para A Vadia.");
 ds_map_add(m,"B-but, I told you that. Ahh whatever.","M-mas eu já tinha contado isso a você. Ah, tanto faz.");
 ds_map_add(m,"The Bitch.","A Vadia.");
 ds_map_add(m,"On behalf of the secret fight club, I declare the title of.","Em nome do clube de luta secreto, declaro que você recebe o título de...");
 ds_map_add(m,"Yes, yes, whatever.","Sim, sim, tanto faz.");
 ds_map_add(m,"Thank you very much,but do not say the B word.","Muito obrigada, mas não diga a palavra com V.");
 ds_map_add(m,"You are in another level Softy, you beat every single bitch in here.","Você está em outro nível, Molenga. Derrotou todas as vadias daqui.");
 ds_map_add(m,"AHHHH.","AAAAH!");
 ds_map_add(m,"RUN!!!","CORRAM!!!");
 ds_map_add(m,"What!?","O quê?!");
 ds_map_add(m,"Run.","Corra.");
 ds_map_add(m,"She just hiss at me?","Ela acabou de sibilar para mim?");
 ds_map_add(m,"HiZzZz!","HISSS!");
 ds_map_add(m,"Hello kitty <3","Olá, gatinha. <3");
 ds_map_add(m,"AAHHHHHH!","AAAAHHHH!");
 ds_map_add(m,"Hey isn't that the clothes stolen from smooshers?!","Ei, aquelas não são as roupas roubadas da Smooshers?!");
 ds_map_add(m,"Hello kitty. <3","Olá, gatinha. <3");
 ds_map_add(m,"No! we must help him.","Não! Precisamos ajudá-lo.");
 ds_map_add(m,"Let's get the fuck out of here line!","Line, vamos dar o fora daqui, porra!");
 ds_map_add(m,"You can go Line, it can be a lot for you.","Pode ir, Line. Isso pode ser demais para você.");
 ds_map_add(m,"I can feel it, it's here.","Posso sentir. Está aqui.");
 ds_map_add(m,"I will not forgive you for all the people you hurt!","Nunca vou perdoar você por todas as pessoas que machucou!");
 ds_map_add(m,"Come on Line it's time to finish this.","Vamos, Line. Está na hora de acabar com isso.");
 ds_map_add(m,"I hope you enjoyed your time alive.","Espero que tenha aproveitado seu tempo entre os vivos.");
 ds_map_add(m,"I'm going to wipe you completely off the face of existence.","Vou apagar você completamente da existência.");
 ds_map_add(m,"You are wrong I don't want to absorb an inferior version of myself.","Está enganada. Não quero absorver uma versão inferior de mim mesmo.");
 ds_map_add(m,"Your own minions defying your orders, pathetic.","Até seus próprios subordinados desafiam suas ordens. Patético.");
 ds_map_add(m,"Do you want me to go back to a pathetic being like you?","Quer que eu volte a ser um ser patético como você?");
 ds_map_add(m,"Please, Mr. Vasera, let me help you.","Por favor, senhor Vasera, deixe-me ajudar.");
 ds_map_add(m,"What are you doing here? You're going to get yourself killed!","O que está fazendo aqui? Você vai acabar morrendo!");
 ds_map_add(m,"Ohh shut up :s!","Ahh, cale a boca! :s");
 ds_map_add(m,"I thought it was your favorite of the clones, you kept sucking like crazy.","Achei que aquela fosse sua clone favorita. Você não parava de chupá-la feito louco.");
 ds_map_add(m,"Do you really want to kill me Line?","Você realmente quer me matar, Line?");
 ds_map_add(m,"Thank you Mr. Vasera I will do my best with the armor. <3","Obrigada, senhor Vasera. Vou fazer o melhor que puder com a armadura. <3");
 ds_map_add(m,"Mmm you are, but you're not just any minion, you're the only one who would go on a suicide mission like trying to stop my clone.","Mmm, você é, mas não é uma subordinada qualquer. É a única que aceitaria uma missão suicida como tentar deter meu clone.");
 ds_map_add(m,"Oh thank you but why give me this, I thought I was just a simple subditee?","Ah, obrigada, mas por que está me dando isto? Achei que eu fosse apenas uma subordinada qualquer.");
 ds_map_add(m,"You won't have armor like mine since it is destroyed but it might be of some use to you.","Você não terá uma armadura como a minha, pois ela foi destruída, mas talvez isto ainda seja útil para você.");
 ds_map_add(m,"I could observe that your garments absorb different clothes and help you for the combat.","Percebi que suas roupas absorvem outras vestimentas e ajudam você em combate.");
 ds_map_add(m,"I want you to keep it.","Quero que fique com ela.");
 ds_map_add(m,"Is the remainder of my clone's armor.","É o que restou da armadura do meu clone.");
 ds_map_add(m,"What is that?","O que é isso?");
 ds_map_add(m,"Line come.","Line, venha.");
 ds_map_add(m,"I don't need something as pathetic as you.","Não preciso de algo tão patético quanto você.");
 ds_map_add(m,"I am stronger than before you need me!","Estou mais forte do que antes. Você precisa de mim!");
 ds_map_add(m,"I beg you. Absorb me and you will be much more powerful than before we were divided.","Eu imploro. Absorva-me e você ficará muito mais poderosa do que antes de nos dividirmos.");
 ds_map_add(m,"Please don't kill me.","Por favor, não me mate.");
 ds_map_add(m,"Then Show it!","Então prove!");
 ds_map_add(m,"N-no I am not a coward and I'm a succubus!!! *Eat the fruit*","N-não sou covarde! E sou uma súcubo!!! *Come a fruta*");
 ds_map_add(m,"... I'm sorry Line, the truth is that I don't know if we really should continue with this whole 'looking for your succubus side', it seems that it only attracts more problems than anything else.","... Sinto muito, Line. A verdade é que não sei se deveríamos continuar com toda essa história de 'explorar seu lado súcubo'. Parece que isso só traz mais problemas do que qualquer outra coisa.");
 ds_map_add(m,"Lili... say.. something .","Lili... diga... alguma coisa.");
 ds_map_add(m,"You are pathetic get out of here.","Você é patética. Saia daqui.");
 ds_map_add(m,"Then I was wrong about you, you're just an elf trying to be a succubus.","Então eu estava enganado sobre você. Você é só uma elfa tentando ser uma súcubo.");
 ds_map_add(m,"No-no I cannot do it Big sis.","N-não, não consigo, mana.");
 ds_map_add(m,"Plus don't worry about the customers, the waitresses keep them sufficiently distracted.","Além disso, não se preocupe com os clientes. As garçonetes conseguem distraí-los muito bem.");
 ds_map_add(m,"Well, if you want to be a good succubus you must be prepared to do it everywhere.","Bem, se quiser ser uma boa súcubo, precisa estar preparada para fazer isso em qualquer lugar.");
 ds_map_add(m,"What?! I am no-not going to do it here, a-are you crazy?","O quê?! Eu n-não vou fazer isso aqui! V-você está louca?");
 ds_map_add(m,"Here Line Eat this.","Aqui, Line. Coma isto.");
 ds_map_add(m,"Thanks Big Sis <3 and good luck in your work. <3","Obrigada, mana. <3 Boa sorte no trabalho. <3");
 ds_map_add(m,"That's great Line I love that you understand how great one can feel when roles are switched.","Que ótimo, Line! Adoro que você tenha entendido como é bom quando os papéis se invertem.");
 ds_map_add(m,"To be the one who wants his desire fulfilled and who wants it now.","Ser aquela que quer ter o próprio desejo realizado, e quer isso agora.");
 ds_map_add(m,"Yes, yes, I can feel it, the rush, the power, I think I just realized what it means.","Sim, sim, estou sentindo! A emoção, o poder... Acho que finalmente entendi o que isso significa.");
 ds_map_add(m,"Sometimes you have to be the dominant one.","Às vezes, você precisa ser quem está no controle.");
 ds_map_add(m,"I just want you to be more active not everyone likes a scared or shy girl.","Só quero que você tome mais iniciativa. Nem todo mundo gosta de uma garota assustada ou tímida.");
 ds_map_add(m,"I am sorry for what I said before.","Desculpe pelo que eu disse antes.");
 ds_map_add(m,"Ohhh so strong.","Ohhh, que força!");
 ds_map_add(m,"you can't enter here sorry.","Desculpe, você não pode entrar aqui.");
 ds_map_add(m,"Line beutiful.","Line, linda.");
 ds_map_add(m,"Be aware of what the clients want, if they want dry kisses or kisses with a lot of saliva and if they are fast or slow <3.","Preste atenção ao que os clientes querem: se preferem beijos secos ou beijos com muita saliva, e se gostam de algo rápido ou devagar. <3");
 ds_map_add(m,"Line you want to earn some money just give some good smoosh <3!","Line, quer ganhar um dinheiro? É só dar uns bons beijos! <3");
 ds_map_add(m,"He tipped you 50 Arcs!","Ele deixou 50 Arcs de gorjeta para você!");
 ds_map_add(m,"You are a natural Smoosher Line!","Você nasceu para ser uma Smoosher, Line!");
 ds_map_add(m,"At least he tipped you 10 Arcs.","Pelo menos ele deixou 10 Arcs de gorjeta.");
 ds_map_add(m,"Oh... Don't worry Line, you didn't do too bad.","Oh... Não se preocupe, Line. Você não foi tão mal.");
 ds_map_add(m,"Watch out Vasuki!","Cuidado, Vasuki!");
 ds_map_add(m,"I don't know, the guards hired me because they are busy with the relics problem.","Não sei. Os guardas me contrataram porque estão ocupados com o problema das relíquias.");
 ds_map_add(m,"But why are they doing that?","Mas por que estão fazendo isso?");
 ds_map_add(m,"An abnormal number of slimes have appeared on the island and are attacking women, so far nothing has happened, but it seems that they want to kidnap them.","Um número anormal de Slimes apareceu na ilha e está atacando mulheres. Até agora, nada aconteceu, mas parece que querem sequestrá-las.");
 ds_map_add(m,"Watch out for that slime.","Cuidado com aquela Slime.");
 ds_map_add(m,"What, what's wrong?!","O quê? O que foi?!");
 ds_map_add(m,"Watch out Line! be on the alert!","Cuidado, Line! Fique alerta!");
 ds_map_add(m,"Vasuki What are you doing here?!","Vasuki, o que está fazendo aqui?!");
 ds_map_add(m,"Regardless of where she got it from, we have to go to the next location!","Independentemente de onde ela conseguiu isso, precisamos ir ao próximo local!");
 ds_map_add(m,"Maybe she stole it","Talvez ela tenha roubado.");
 ds_map_add(m,"Mmmm it had a key inside.","Mmmm, havia uma chave lá dentro.");
 ds_map_add(m,"Yes, look there is something inside the slime.","Sim, olhe! Tem alguma coisa dentro da Slime.");
 ds_map_add(m,"What's wrong Line?","O que foi, Line?");
 ds_map_add(m,"Wait!","Espere!");
 ds_map_add(m,"Okay, the next place will be at the entrance to the town, that's where the guards told me there might be another one.","Está bem, o próximo local será na entrada da cidade. Foi lá que os guardas disseram que talvez houvesse outra.");
 ds_map_add(m,"Hahaha Line you were awesome. <3","Hahaha, Line, você foi incrível! <3");
 ds_map_add(m,"No, I insist I could not leave you alone.","Não, insisto. Não posso deixar você sozinha.");
 ds_map_add(m,"Don't worry Line, I really do it for what you have done for me, for the problems I gave you with the law by burning all those arcs and also with this work maybe I could improve the house a little bit.","Não se preocupe, Line. Faço isso para retribuir tudo o que você fez por mim, inclusive os problemas que causei com a lei quando queimamos todos aqueles Arcs. E, com este trabalho, talvez eu consiga melhorar um pouco a casa.");
 ds_map_add(m,"Vasuki you work too much let me help you.","Vasuki, você trabalha demais. Deixe-me ajudar.");
 ds_map_add(m,"Yes, but the guards should be here any minute now and they will take her to jail before she wakes up with all her energy.","Sim, mas os guardas devem chegar a qualquer momento e vão levá-la para a prisão antes que ela recupere toda a energia.");
 ds_map_add(m,"Then they will get back on their feet and fight with the same energy as before?","Então elas vão se levantar e lutar com a mesma energia de antes?");
 ds_map_add(m,"Calm down Lili according to the guards when they beat one they end up in a state of recovery.","Calma, Lili. Segundo os guardas, quando derrotam uma delas, ela entra em estado de recuperação.");
 ds_map_add(m,"Hey, is that slime going to be okay? it's kind of lost its shape.","Ei, aquela Slime vai ficar bem? Ela meio que perdeu a forma.");
 ds_map_add(m,"There is nothing to stop us!","Nada pode nos deter!");
 ds_map_add(m,"We did it!","Conseguimos!");
 ds_map_add(m,"Yes, don't WOOORRRRYYY.","Sim, NÃO SE PREOCUPEEEE!");
 ds_map_add(m,"Be careful this place looks in very bad shape we don't know what could happen.","Cuidado, este lugar parece estar em péssimas condições. Não sabemos o que pode acontecer.");
 ds_map_add(m,"Y-yes, here we will know more information about Ava.","S-sim, aqui vamos descobrir mais coisas sobre Ava.");
 ds_map_add(m,"Don't worry Line, for now we could investigate the island, maybe there is more information about Ava.","Não se preocupe, Line. Por enquanto, podemos investigar a ilha. Talvez haja mais informações sobre Ava.");
 ds_map_add(m,"Do you really want to enter?","Você realmente quer entrar?");
 ds_map_add(m,"This gives me a bad vibe.","Este lugar me dá uma sensação ruim.");
 ds_map_add(m,"This is the place, I think.","Acho que é aqui.");
 ds_map_add(m,"For the future, the children and us I will give my best too!","Pelo futuro, pelas crianças e por nós, também darei o meu melhor!");
 ds_map_add(m,"You won't be alone in this Red count me in!","Você não vai ficar sozinha nessa, Red. Pode contar comigo!");
 ds_map_add(m,"If so, I will give my all and find a job!","Se é assim, vou dar tudo de mim e encontrar um emprego!");
 ds_map_add(m,"... Ah, look, I can help in getting 3.000 Arcs, but you will have to promise me to work in a noble way.","... Ah, olhe, posso ajudar a conseguir 3.000 Arcs, mas você terá que me prometer que vai trabalhar honestamente.");
 ds_map_add(m,"But they said that since we are children of sin we deserved our destiny.","Mas disseram que, por sermos filhos do pecado, merecíamos esse destino.");
 ds_map_add(m,"It was the first thing we did.","Foi a primeira coisa que fizemos.");
 ds_map_add(m,"Do you think we are idiots?!","Você acha que somos idiotas?!");
 ds_map_add(m,"And about this you could give the children to the church and you will have to look for a decent job to earn money legitimately even if it is your last option to go to the VIP area.","E quanto a isso, você poderia entregar as crianças à igreja. Depois, terá que procurar um emprego decente e ganhar dinheiro honestamente, mesmo que sua última opção seja trabalhar na área VIP.");
 ds_map_add(m,"... Hey I-I will not turn you over but you all will have to stop stealing.","... Ei, n-não vou denunciar vocês, mas todos terão que parar de roubar.");
 ds_map_add(m,"We are finished.","Estamos acabados.");
 ds_map_add(m,"And now the hero of the island will deliver us to justice.","E agora a heroína da ilha vai nos entregar à justiça.");
 ds_map_add(m,"We are 3.000 Arcs under budget that would give us a little time but not much.","Estamos 3.000 Arcs abaixo do orçamento. Isso nos daria um pouco mais de tempo, mas não muito.");
 ds_map_add(m,"But that doesn't matter anymore, we don't have the money to feed the children or pay for their education.","Mas isso já não importa. Não temos dinheiro para alimentar as crianças nem pagar a educação delas.");
 ds_map_add(m,"We also do not want to work in the VIP area and continue with the cycle.","Também não queremos trabalhar na área VIP e continuar nesse ciclo.");
 ds_map_add(m,"I, Naga and Cuevo are one of those children, we wanted to give a future to these children but we don't know how to do anything but steal.","Eu, Naga e Cuervo somos alguns dessas crianças. Queríamos dar um futuro a elas, mas não sabemos fazer nada além de roubar.");
 ds_map_add(m,"Unwanted children born and end up on the streets to survive on its own.","Crianças indesejadas, que nascem e acabam nas ruas, tendo que sobreviver sozinhas.");
 ds_map_add(m,"... Look I opened this orphanage because of the high sexual activity on this island ... Mistakes happen.","... Olhe, abri este orfanato por causa da intensa atividade sexual nesta ilha... Acidentes acontecem.");
 ds_map_add(m,"Lili!.","Lili!");
 ds_map_add(m,"Well they don't do a great job even we live better.","Bem, eles não fazem um trabalho tão bom assim. Até nós vivemos melhor.");
 ds_map_add(m,"Do not tell me that you were stealing to keep this place alive and these children.","Não me diga que vocês roubavam para manter este lugar e estas crianças vivas.");
 ds_map_add(m,"... Well it doesn't matter it's all over now.","... Bem, não importa. Agora tudo acabou.");
 ds_map_add(m,"I could not let you take the crystals, my friends need them to return to their dimensions.","Não posso deixar vocês levarem os cristais. Meus amigos precisam deles para voltar às suas dimensões.");
 ds_map_add(m,"And you are the hero, who screwed up all our plans.","E você é a heroína que estragou todos os nossos planos.");
 ds_map_add(m,"You are the thieves I've seen them all over the island what is all this?!","Vocês são os ladrões! Já vi vocês por toda a ilha. O que é tudo isso?!");
 ds_map_add(m,"And to make matters worse, they found our hideout.","E, para piorar, encontraram nosso esconderijo.");
 ds_map_add(m,"We were not able to steal any crystal.","Não conseguimos roubar nenhum cristal.");
 ds_map_add(m,"We are running out of money.","Estamos ficando sem dinheiro.");
 ds_map_add(m,"What are we going to do now?","O que vamos fazer agora?");
 ds_map_add(m,"Lili not now, I feel I have been given a big responsibility, now I just want to leave.","Lili, agora não. Sinto que me deram uma responsabilidade enorme. Só quero ir embora.");
 ds_map_add(m,"Hey Line, will you really accept this offe-?","Ei, Line, você realmente vai aceitar esta ofer-?");
 ds_map_add(m,"Thank you very much, if you can do it we would really appreciate it, even if there is a price to pay.","Muito obrigada. Se conseguir fazer isso, ficaremos muito gratas, mesmo que tenhamos que pagar um preço.");
 ds_map_add(m,"... I will try to help in any way I can but each of you must get a job or none of this will help.","... Vou tentar ajudar de todas as maneiras possíveis, mas cada uma de vocês precisa conseguir um emprego, senão nada disso vai adiantar.");
 ds_map_add(m,"The three of us will give you our most precious moment, please help us.","Nós três vamos oferecer a você nosso momento mais precioso. Por favor, ajude-nos.");
 ds_map_add(m,"Stop it, I will give you the same, please help us.","Pare com isso. Eu também vou oferecer a mesma coisa. Por favor, ajude-nos.");
 ds_map_add(m,"I-I I really do not know if I have the ability to get-","E-eu realmente não sei se consigo conseguir...");
 ds_map_add(m,"Wait please, I offer you the same, this is all for us with those 10.000 Arcs I know we will have time to find a job.","Espere, por favor! Ofereço a mesma coisa. Isso é tudo o que temos. Com esses 10.000 Arcs, sei que teremos tempo para encontrar um emprego.");
 ds_map_add(m,"Agh, Look I am a succubus yes, but still 10.000 Arcs is a lot, the truth even if I want I do not know if I can get-.","Agh, olhe, eu sou uma súcubo, sim, mas 10.000 Arcs é muito dinheiro. Sinceramente, mesmo que eu queira, não sei se consigo conseguir...");
 ds_map_add(m,"I-I'll give you my virginity, I know you're a succubus and I'm sure taking the virginity of someone who's been taking care of it for 21 years must be very attractive to you.","E-eu vou lhe dar minha virgindade. Sei que você é uma súcubo e tenho certeza de que a virgindade de alguém que a preservou por 21 anos deve ser muito atraente para você.");
 ds_map_add(m,"But you do not have money, what could you give us?","Mas vocês não têm dinheiro. O que poderiam nos oferecer?");
 ds_map_add(m,"I beg you, if you get another 10.000 Arcs we can pay for the children's education and improve this place, I will repay you.","Eu imploro. Se conseguir mais 10.000 Arcs, poderemos pagar a educação das crianças e melhorar este lugar. Vou recompensar você.");
 ds_map_add(m,"Wait! all is not lost, we gain some more time with your 3.000 Arcs!","Espere! Nem tudo está perdido. Com seus 3.000 Arcs, ganhamos mais algum tempo!");
 ds_map_add(m,"This is a disaster.","Isso é um desastre.");
 ds_map_add(m,"Basically, we are still at the same point as before...","Basicamente, continuamos no mesmo ponto de antes...");
 ds_map_add(m,"they didn't give me a job because apparently working with 'bandages' instead of clothes is not appropriate. But what could i do? all my money goes to this place i don't have money to buy clothes :c.","Não me deram emprego porque, aparentemente, trabalhar usando 'ataduras' em vez de roupas não é apropriado. Mas o que eu podia fazer? Todo o meu dinheiro vai para este lugar. Não tenho dinheiro para comprar roupas. :c");
 ds_map_add(m,"I tried to be a fortune teller but it seems that you have to learn to be one, it seems that it is not enough just to be a lamia. :p","Tentei ser vidente, mas parece que é preciso estudar para isso. Pelo visto, não basta ser uma lamia. :p");
 ds_map_add(m,"Look, we have a bad reputation and they just don't want to give us work.","Olhe, temos uma reputação ruim e simplesmente não querem nos dar trabalho.");
 ds_map_add(m,"What do you mean it did not work?!","Como assim não deu certo?!");
 ds_map_add(m,"Yes, about that it did not work.","Sim, sobre isso... não deu certo.");
 ds_map_add(m,"Well hehe.","Bem, hehe.");
 ds_map_add(m,"It's not necessary, as long as the three of you work together now without hurting anyone, it will be fine.","Não é necessário. Desde que vocês três trabalhem juntas daqui para frente, sem machucar ninguém, está tudo bem.");
 ds_map_add(m,"I-I really don't know how to thank you for this.","E-eu realmente não sei como agradecer por isso.");
 ds_map_add(m,"Wait here girls I think I have the solution to all this.","Esperem aqui, meninas. Acho que encontrei a solução para tudo isso.");
 ds_map_add(m,"And who better for a family than Miss Marael! You are a genius!","E quem seria melhor para dar uma família a elas do que a senhorita Marael?! Você é um gênio!");
 ds_map_add(m,"But you can feel the love and the heart that is here, they are complete strangers to each other but they are still a family.","Mas dá para sentir o amor e o carinho que existem aqui. Elas eram completas estranhas umas para as outras, mas ainda assim são uma família.");
 ds_map_add(m,"Come on Line just look at this place it's a mess-","Vamos, Line, olhe só para este lugar. Está uma bagunça...");
 ds_map_add(m,"What, but who Lili?!","O quê? Mas quem, Lili?!");
 ds_map_add(m,"You know what, I think I know who can help.","Sabe de uma coisa? Acho que conheço alguém que pode ajudar.");
 ds_map_add(m,"We will earn worse with these jobs, the money you got will be gone in a few days and we will be back to the same point as before if we don't steal.","Com esses empregos, vamos ganhar ainda menos. O dinheiro que você conseguiu vai acabar em poucos dias e voltaremos ao mesmo ponto de antes se não roubarmos.");
 ds_map_add(m,"What but why?!","O quê? Mas por quê?!");
 ds_map_add(m,"Thanks for everything Line the money and the second chance, but the truth is that we will continue working and stealing.","Obrigada por tudo, Line: pelo dinheiro e pela segunda chance. Mas, para falar a verdade, vamos continuar trabalhando e roubando.");
 ds_map_add(m,"What, what's wrong?","O quê? O que foi?");
 ds_map_add(m,"hahaha.. ha...","Hahaha... ha...");
 ds_map_add(m,"I will be a decent guard which is already a lot for this island haha.","Vou ser uma guarda decente, o que já é muito para esta ilha, haha.");
 ds_map_add(m,"And I will be the best fortune teller!","E vou me tornar a melhor vidente!");
 ds_map_add(m,"I will be the best clown on the island! <3.","Vou ser o melhor palhaço da ilha! <3");
 ds_map_add(m,"Hehe I am glad I noticed that you all have honorable jobs and you are all role models for these children.","Hehe, fico feliz por ter percebido que todos vocês conseguiram empregos honestos e agora são exemplos para essas crianças.");
 ds_map_add(m,"You will be my role to follow <3.","Vou seguir seu exemplo. <3");
 ds_map_add(m,"Oh you are the best of all heroes!","Ah, você é a melhor de todas as heroínas!");
 ds_map_add(m,"I really meant that you don't really think about giving them 10000 arcs? but mmm well you know it doesn't matter.","Na verdade, eu queria perguntar se você realmente pensa em dar 10.000 Arcs a elas. Mas, hmm, tudo bem, deixa para lá.");
 ds_map_add(m,"I see that you really care about this place and Lili I would not mess with someone who is at her most fragile moment.","Vejo que você realmente se importa com este lugar e com Lili. Não vou mexer com alguém que está em seu momento mais frágil.");
 ds_map_add(m,"Hey Line, you really didn't think-","Ei, Line, você realmente não achou que-");
 ds_map_add(m,"I only ask to go somewhere else where no one can see us.","Só peço que vamos para algum lugar onde ninguém possa nos ver.");
 ds_map_add(m,"We will follow you until the end.","Vamos seguir você até o fim.");
 ds_map_add(m,"I say the same Red.","Digo o mesmo, Red.");
 ds_map_add(m,"You are the best fri-sisters I could have ever had.","Vocês são as melhores ami-irmãs que eu poderia ter.");
 ds_map_add(m,"Remember we do this for the children and the future we did not have we can give to them.","Lembrem-se: fazemos isso pelas crianças e pelo futuro que não tivemos, mas que podemos dar a elas.");
 ds_map_add(m,"It's more than we deserve.","É mais do que merecemos.");
 ds_map_add(m,"Thank you very much hero.","Muito obrigada, heroína.");
 ds_map_add(m,"We kept this place as long as we could, thanks to Line this place can be rebuilt.","Mantivemos este lugar funcionando pelo máximo de tempo que conseguimos. Graças a Line, ele poderá ser reconstruído.");
 ds_map_add(m,"Well it looks like the day has finally arrived girls.","Bem, parece que finalmente chegou o dia, meninas.");
 ds_map_add(m,"See what you have done here. You are the hero you always wanted to be.","Veja o que você fez aqui. Você se tornou a heroína que sempre quis ser.");
 ds_map_add(m,"You will take my place over my filthy, pissing corpse!","Você só vai tomar meu lugar passando por cima do meu cadáver imundo e mijado!");
 ds_map_add(m,"Great go to the center of the circle of those people.","Ótimo. Vá para o centro do círculo formado por aquelas pessoas.");
 ds_map_add(m,"I will, this is one more step towards becoming a true succubus!","Vou fazer isso! É mais um passo para me tornar uma verdadeira súcubo!");
 ds_map_add(m,"NOOOOO, BLEEh","NÃÃÃÃO, BLEÉÉH!");
 ds_map_add(m,"Will you do it or not!","Vai fazer ou não?!");
 ds_map_add(m,"They really mean. * whispers *","O que elas realmente querem dizer é... *sussurrando*");
 ds_map_add(m,"*Face Palm* Line are not that kind of watersport just look out over there.","*Põe a mão no rosto* Line, não é esse tipo de esporte aquático. Olhe ali.");
 ds_map_add(m,"Do not worry, I am a great swimmer and I will win these watersports!","Não se preocupe, sou uma ótima nadadora e vou vencer esses esportes aquáticos!");
 ds_map_add(m,"The most I can give you is Arcs since you don't owe me anything anymore.","O máximo que posso lhe dar são Arcs, já que você não me deve mais nada.");
 ds_map_add(m,"What about me, can I help?","E eu? Posso ajudar?");
 ds_map_add(m,"Whatever, go away, I have to close the place, the idol of the place is sick and can't continue.","Tanto faz, vá embora. Preciso fechar o lugar. A atração principal está doente e não pode continuar.");
 ds_map_add(m,"Believe me she plays dumb but she really is smart... sometimes.","Acredite, ela se faz de boba, mas é muito esperta... às vezes.");
 ds_map_add(m,"UGH BLEEEh.","UGH, BLEÉÉH.");
 ds_map_add(m,"Would not it be better to have a swimming pool?","Não seria melhor ter uma piscina?");
 ds_map_add(m,"Line, this is a facade. It's another section for VIPs who enjoy, well, you know, 'watersports.","Line, isso é só um disfarce. É outra área VIP para clientes que gostam de... bem, você sabe, 'esportes aquáticos'.");
 ds_map_add(m,"I came through that door. It's the first time I've seen this bathroom open, and I really needed to pee, hehe","Entrei por aquela porta. É a primeira vez que vejo este banheiro aberto e eu estava mesmo precisando fazer xixi, hehe.");
 ds_map_add(m,"Line, what are you doing here? Wait, how did you get in?","Line, o que está fazendo aqui? Espere, como conseguiu entrar?");
 ds_map_add(m,"Ehhh hi.","Ehhh, oi.");
 ds_map_add(m,"Stay there for a while. I'll take you to the hospital after resolving all of this.","Fique aí por um tempo. Vou levar você ao hospital depois de resolver tudo isso.");
 ds_map_add(m,"Nonsense, I already feel UGH, fine.","Bobagem, já estou me sentindo... UGH, está bem.");
 ds_map_add(m,"Well, this place is useless if you have a stomach ache.","Bem, este lugar não serve para nada se você estiver com dor de barriga.");
 ds_map_add(m,"Hey I fought for this place and no one will urgh, uagh take it away.","Ei, lutei por este lugar e ninguém vai... urgh, uagh... tirá-lo de mim.");
 ds_map_add(m,"Ahh, I told you that you needed to take a few days.","Ahh, eu disse que você precisava tirar alguns dias de descanso.");
 ds_map_add(m,"MMmmmm I can sing but I am not the best, here goes.","Mmmmmm, sei cantar, mas não sou a melhor. Lá vai.");
 ds_map_add(m,"*Crowd* Can't you do something else? Yeah, like dancing or something?","*Multidão* Não consegue fazer outra coisa? É, tipo dançar ou algo assim?");
 ds_map_add(m,"*Crowd* ... is far from being our idol, well it is what it is, Yeah, I will be the first, what? No I will be!","*Multidão* ... está longe de ser nosso ídolo. Bem, fazer o quê? É, eu vou primeiro! O quê? Não, eu vou!");
 ds_map_add(m,"Ready, now what do I open my mouth? AHHHHHHHH.","Pronto. Agora é só abrir a boca? AAAAAAAAAH!");
 ds_map_add(m,"*Crowd* Just kneel down, yes and quickly, let's see how good you are, yes new idol!","*Multidão* É só se ajoelhar. Isso, e rápido! Vamos ver se você é boa mesmo, nossa nova ídola!");
 ds_map_add(m,"Well then, what now?","Bem, e agora?");
 ds_map_add(m,"Phew, a lot of pee, and what a strong smell, hehe.","Ufa, foi muito xixi. E que cheiro forte, hehe.");
 ds_map_add(m,"Wait, her future what?! ugh, URGH.","Espere, o futuro dela... o quê?! Ugh, URGH.");
 ds_map_add(m,"*Crowd* EHHHHHHH THAT'S THE WAY TO TALK, THAT'S OUR FUTURE IDOL!!!!","*Multidão* EHHHHHH! É ASSIM QUE SE FALA! NOSSA FUTURA ÍDOLA!!!!");
 ds_map_add(m,"I swear I will try again if you give me the opportunity.","Juro que vou tentar de novo se você me der uma oportunidade.");
 ds_map_add(m,":c that's the nicest thing anyone has ever said to me in a fake bathroom full of elite people with weird tastes <3.",":c Essa é a coisa mais gentil que alguém já me disse em um banheiro falso cheio de gente da elite com gostos esquisitos. <3");
 ds_map_add(m,"*Crowd* Yes, you filled us with pride. Your voice is horrible, but it was evident that you sang and drank with your heart <3.","*Multidão* Sim, você nos encheu de orgulho. Sua voz é horrível, mas ficou claro que você cantou e bebeu com o coração. <3");
 ds_map_add(m,"Eh-e- really?","É-é sério?");
 ds_map_add(m,"Relax you did the best you could <3, yes you were a great backup idol, love the innocence!","Relaxe, você fez o melhor que pôde. <3 Sim, foi uma ótima ídola substituta. Adoro essa inocência!");
 ds_map_add(m,"I am-sorry I could not drink it.","Desculpe, não consegui beber.");
 ds_map_add(m,"URGH, Gulp, BLEEEh.","URGH, GULP, BLEÉÉH!");
 ds_map_add(m,"No one will take my sweet sunray-colored nectar from me!","Ninguém vai tirar de mim meu doce néctar cor de raio de sol!");
 ds_map_add(m,"Don't take my place urhhhhhggg BLEEh!","Não tome meu lugar! Urhhhh, BLEÉÉH!");
 ds_map_add(m,"Yes, don't worry, I'll stay with her while she recovers.","Sim, não se preocupe. Vou ficar com ela enquanto se recupera.");
 ds_map_add(m,"S-she will be okay?","E-ela vai ficar bem?");
 ds_map_add(m,"Yes <3","Sim. <3");
 ds_map_add(m,"If we put our feet together will you shut up?","Se juntarmos nossos pés, você fica quieto?");
 ds_map_add(m,"It is sad but true.","É triste, mas é verdade.");
 ds_map_add(m,"No, I cannot pee in a new place if Lili does not hold my hand ;c.","Não, não consigo fazer xixi em um lugar novo se Lili não segurar minha mão. ;c");
 ds_map_add(m,"Ahh ya buckle down and pee like a doggie.","Ah, vamos, agache e faça xixi como uma cachorrinha.");
 ds_map_add(m,"I can not hold on anymore!","Não consigo mais segurar!");
 ds_map_add(m,"Uff tell me about it.","Uff, nem me fale.");
 ds_map_add(m,"Ahhh how can you make so much trouble.","Ahhh, como você consegue causar tanta confusão?");
 ds_map_add(m,"No-no, I can stand on my feet.","N-não, consigo ficar de pé.");
 ds_map_add(m,"AY don not bother me, I drank too much","EI, não me incomode. Bebi demais.");
 ds_map_add(m,"Do you have narcolepsy or what? You always fall asleep or lose consciousness.","Você tem narcolepsia ou o quê? Está sempre dormindo ou desmaiando.");
 ds_map_add(m,"Wha-what's going on?","O-o que está acontecendo?");
 ds_map_add(m,"Hey Line wake up!","Ei, Line, acorde!");
 ds_map_add(m,"*Throws his clothes* MY GREAT INGENUITY!","*Joga as roupas* MINHA GRANDE INGENUIDADE!");
 ds_map_add(m,"I know you think I am a fool, so I want you to see this.","Sei que você me acha um idiota, então quero que veja isto.");
 ds_map_add(m,"Well now that we are here what do we do now?","Bem, já que chegamos, o que fazemos agora?");
 ds_map_add(m,"Well, if we're done here, we'd better get going.","Bem, se terminamos aqui, é melhor irmos embora.");
 ds_map_add(m,"No, I can't draw the sword.","Não, não consigo tirar a espada.");
 ds_map_add(m,"Ahhhhgggggg!","Aaaaaaahhhh!");
 ds_map_add(m,"I can't give up hope, I won't give in to despair, it was all an accident, now I need to get her back.","Não posso perder a esperança nem me entregar ao desespero. Tudo não passou de um acidente. Agora preciso trazê-la de volta.");
 ds_map_add(m,"But why did you have to die. If there is a god in this world, would he be angry with us?","Mas por que você teve que morrer? Se existe um deus neste mundo, será que ele estaria zangado conosco?");
 ds_map_add(m,"Our intention was good, it was to help people.","Nossa intenção era boa. Queríamos ajudar as pessoas.");
 ds_map_add(m,"I'll have to ignore it and continue with the research and eventually they will show up I guess.","Vou ignorar isso e continuar a pesquisa. Uma hora elas devem aparecer, imagino.");
 ds_map_add(m,"But... something has me anxious, the investigation was sponsored by a sect here on the island, but no matter how much I ask no one knows about it..","Mas... há algo que me deixa inquieto. A pesquisa foi financiada por uma seita aqui da ilha, mas, por mais que eu pergunte, ninguém sabe nada sobre ela...");
 ds_map_add(m,"It's a research that will change the course of human history, I can't be happier than to do this with my wife.","É uma pesquisa que mudará o rumo da história humana. Não poderia estar mais feliz por fazer isso ao lado da minha esposa.");
 ds_map_add(m,"If we manage to discover its secrets we can improve the health of any living being and even grow body parts and even organs!","Se conseguirmos descobrir seus segredos, poderemos melhorar a saúde de qualquer ser vivo e até fazer membros e órgãos crescerem novamente!");
 ds_map_add(m,"Finally we arrive on the island Eleonor and I will start the work of our lives!","Finalmente chegamos à ilha. Eleonor e eu vamos começar o trabalho de nossas vidas!");
 ds_map_add(m,"They asked me for a body .... without a conscience but alive... I don't really know what they meant.","Pediram que eu conseguisse um corpo... sem consciência, mas vivo... Não entendi muito bem o que quiseram dizer.");
 ds_map_add(m,"And finish quickly, you do not want your mother to see you <3.","E termine logo. Você não quer que sua mãe veja, não é? <3");
 ds_map_add(m,"Hey but don't get the wrong idea, I'm your mother I just want to help you, hehe well I have to go now Aldo *kiss on the forehead*.","Ei, não pense besteira. Sou sua mãe, só quero ajudar, hehe. Bem, preciso ir agora, Aldo. *beijo na testa*");
 ds_map_add(m,"Th-thank you.","O-obrigado.");
 ds_map_add(m,"So improve that mood Aldo! and I'll try to get you a door so you have a little more privacy <3.","Então anime-se, Aldo! Vou tentar conseguir uma porta para você ter um pouco mais de privacidade. <3");
 ds_map_add(m,"I will tell you a secret that may alleviate your embarrassment, I am half succubus and maybe that affected you when we were eating together.","Vou contar um segredo que talvez alivie seu constrangimento: sou meio súcubo, e talvez isso tenha afetado você quando comemos juntos.");
 ds_map_add(m,"It is okay aldo you do not have to be embarrassed.","Está tudo bem, Aldo. Você não precisa ficar envergonhado.");
 ds_map_add(m,"This is really embarrassing and lame.","Isso é muito constrangedor e ridículo.");
 ds_map_add(m,"Beside I really do not mind at all.","Além disso, não me incomodo nem um pouco.");
 ds_map_add(m,"But it is normal to do such a thing at your age, Aldo.","Mas é normal fazer uma coisa dessas na sua idade, Aldo.");
 ds_map_add(m,"( I will try to fix this like a good stepmother. ) Hey, that must be really embarrassing having your mother girlfriend see that...","(Vou tentar resolver isso como uma boa madrasta.) Ei, deve ser muito constrangedor sua mãe e a namorada dela verem aquilo...");
 ds_map_add(m,"OHhhh... Please no.","OHhhh... Por favor, não.");
 ds_map_add(m,"I-I am sorry I heard a strange sound I came to see if you were okay.","E-eu sinto muito. Ouvi um barulho estranho e vim ver se você estava bem.");
 ds_map_add(m,"Ahh! what are you doing here?!","Ahh! O que você está fazendo aqui?!");
 ds_map_add(m,"It doesn't seem to be a simple headache. I'll go get you a glass of water go relax a little.","Não parece ser uma simples dor de cabeça. Vou buscar um copo d'água para você. Tente relaxar um pouco.");
 ds_map_add(m,"My-my head hurts a little bit.","M-minha cabeça está doendo um pouco.");
 ds_map_add(m,"What-what's up Line?","O-o que foi, Line?");
 ds_map_add(m,"Ahh! - I-I do not feel well.","Ahh! E-eu não estou me sentindo bem.");
 ds_map_add(m,"So I accepted, now Callie is my girlfriend and she looked very happy.","Então aceitei. Agora Callie é minha namorada, e ela ficou muito feliz.");
 ds_map_add(m,"I hope to do my best, maybe this is my place.","Espero dar o meu melhor. Talvez este seja o meu lugar.");
 ds_map_add(m,"Speaking of him, he was the only son that was there, he seemed a little shy but from the little we talked, our age difference was small.","Falando nele, era o único filho que estava lá. Parecia um pouco tímido, mas, pelo pouco que conversamos, nossa diferença de idade era pequena.");
 ds_map_add(m,"The truth is that I really see myself being his girlfriend and I do see his daughters calling me mother, including the older son haha.","A verdade é que consigo me imaginar como namorada dela, e também consigo imaginar as filhas dela me chamando de mãe, inclusive o filho mais velho, haha.");
 ds_map_add(m,"Especially Callie, I do not know but now that I see her I think I like her, how she has sacrificed so much for her children by working and taking care of them.","Principalmente Callie. Não sei por quê, mas agora que a vejo, acho que gosto dela. Ela se sacrificou tanto pelos filhos, trabalhando e cuidando deles.");
 ds_map_add(m,"We laughed and talked at the table and it was really a wonderful time.","Rimos e conversamos à mesa. Foi um momento realmente maravilhoso.");
 ds_map_add(m,"The food was delicious it was a bag of chips for each of us.","A comida estava deliciosa: um pacote de salgadinhos para cada um.");
 ds_map_add(m,"or because I can't have sex with her right now.","Ou porque não posso transar com ela agora.");
 ds_map_add(m,"I cried silently, not really knowing if I was crying because I was turning into such a mess of a person.","Chorei em silêncio, sem saber ao certo se chorava porque estava me tornando uma pessoa tão destruída.");
 ds_map_add(m,"This is what marael said, thinking this way will only destroy my relationships.","Foi isso que Marael disse: pensar assim só vai destruir meus relacionamentos.");
 ds_map_add(m,"I turned away and held back my tears as best I could.","Virei o rosto e segurei as lágrimas o melhor que pude.");
 ds_map_add(m,"Clearly she wanted to be with me, but not yet in the way I wanted.","Estava claro que ela queria ficar comigo, mas ainda não da maneira que eu queria.");
 ds_map_add(m,"I don't invite you to have sex and even less if one of my children is at home.","Não estou convidando você para fazer sexo, muito menos com um dos meus filhos em casa.");
 ds_map_add(m,"She angrily took my hand and with anger she told me.","Ela segurou minha mão com raiva e falou comigo, furiosa.");
 ds_map_add(m,"But nothing, so I took the initiative and started touching her hips little by little kissing her on the neck, SHIT I NEED HER.","Mas nada aconteceu. Então tomei a iniciativa e comecei a tocar seus quadris aos poucos, beijando seu pescoço. MERDA, EU PRECISO DELA.");
 ds_map_add(m,"Touch me Touch me Touch me please I beg you TOUCH ME I'm here for you touch me Callie DO NOT YOU LOVE ME!?","Me toque, me toque, me toque, por favor! Eu imploro, ME TOQUE! Estou aqui por você. Me toque, Callie! VOCÊ NÃO ME AMA?!");
 ds_map_add(m,"I was so frustrated that my mind was filled with lassive thoughts.","Eu estava tão frustrada que minha mente se encheu de pensamentos lascivos.");
 ds_map_add(m,"But that was it, then she turned off the light and nothing else happened.","Mas foi só isso. Depois ela apagou a luz e nada mais aconteceu.");
 ds_map_add(m,"We lay on the bed and kissed like crazy and he even told me that my mouth tasted funny haha.","A gente se deitou na cama e se beijou feito louco. Até ouvi que minha boca tinha um gosto estranho, haha.");
 ds_map_add(m,"*blush* oh sure I would really love that... honey <3.","*corando* Ah, claro. Eu adoraria... querida. <3");
 ds_map_add(m,"You look very pretty Line a little messy haha, Mmm don't you want to sleep here today?","Você está muito bonita, Line, só um pouco descabelada, haha. Mmm, não quer dormir aqui hoje?");
 ds_map_add(m,"Hehehe hello.","Hehehe, olá.");
 ds_map_add(m,"*blush* Hey do not say those things you could be heard ( Shit I am so horny I need to masturbate. )","*corando* Ei, não diga essas coisas. Alguém pode ouvir. (Merda, estou com tanto tesão que preciso me masturbar.)");
 ds_map_add(m,"Oh sure Honey and if we are alone we can take a bath together hehehe.","Ah, claro, querida. E, se estivermos sozinhas, podemos tomar banho juntas, hehehe.");
 ds_map_add(m,"Callie could you lend me your bathroom? I want to take a bath I think I have been sweating a lot.","Callie, você pode me emprestar seu banheiro? Quero tomar um banho. Acho que suei demais.");
 ds_map_add(m,"The best thing I can do for this family is to disappear without doing any more harm.","A melhor coisa que posso fazer por esta família é desaparecer sem causar mais danos.");
 ds_map_add(m,"I will end the relationship with Callie and tell Aldo the truth and this nightmare will end.","Vou terminar meu relacionamento com Callie e contar a verdade a Aldo. Assim, este pesadelo vai acabar.");
 ds_map_add(m,"I need to fix everything in private.","Preciso resolver tudo em particular.");
 ds_map_add(m,"Before I left the house I told Aldo that I would visit him in his room that night.","Antes de sair de casa, disse a Aldo que iria visitá-lo no quarto naquela noite.");
 ds_map_add(m,"I am destroying a family","Estou destruindo uma família.");
 ds_map_add(m,"Have I always been like this, or did everything change when I came to this island?","Sempre fui assim ou tudo mudou quando cheguei a esta ilha?");
 ds_map_add(m,"I know there is something wrong with me.","Sei que há algo errado comigo.");
 ds_map_add(m,"I, I, I love you too Aldo even you touch me more than your mother I prefer you Aldo my DEAR Son.","Eu, eu, eu também te amo, Aldo. Você me toca mais do que sua mãe... Eu prefiro você, Aldo, meu QUERIDO filho.");
 ds_map_add(m,"I-I want to do this, I need it so bad I love you-I love you mommy!","E-eu quero fazer isso. Preciso tanto... Eu te amo, eu te amo, mamãe!");
 ds_map_add(m,"Oh, oh Aldo, you are such a bad baby you should not be doing this with your new mommy!","Oh, oh, Aldo, você é um bebê tão levado. Não deveria fazer isso com sua nova mamãe!");
 ds_map_add(m,"Line is this is the best, better than masturbating. * penetrates harder *","Line, isso é maravilhoso, melhor do que me masturbar. *penetra com mais força*");
 ds_map_add(m,"Sh shhh *whispers* Aldo-Aldo yes she knows but-but play along, be the son who steals his mother's girlfriend, use your penis and fuck my brains out!","Shh, shhh. *sussurrando* Aldo, Aldo, sim, ela sabe, mas... mas entre no jogo. Seja o filho que rouba a namorada da própria mãe. Use seu pênis e me foda até eu perder a cabeça!");
 ds_map_add(m,"*whispers* Hey, does mom know about you being a succ-?","*sussurrando* Ei, sua mãe sabe que você é um súcu-?");
 ds_map_add(m,"Ohhh MORE STRONGER, I do not NOT think about him, I just thought on him because we were talking.","Ohhh, MAIS FORTE! Não, eu NÃO estou pensando nele. Só pensei nele porque estávamos falando sobre ele.");
 ds_map_add(m,"Hey, you're not masturbating thinking about him, are you?!","Ei, você não está se masturbando pensando nele, está?!");
 ds_map_add(m,"OH, YES, YES, THE precious ALDO I WILL REMEMBER not to do it WHEN HE is home. WE DO NOT want our baby to hear ME.","OH, SIM, SIM! MEU QUERIDO ALDO! Vou me lembrar de não fazer isso QUANDO ELE estiver em casa. NÃO QUEREMOS QUE NOSSO BEBÊ ME OUÇA.");
 ds_map_add(m,"Shit Line, ahhg, I don't know why I guess because I like you so much I'll let you slide on this, but you're lucky Aldo's not in the house, don't even think about doing something like that if there's someone besides me in the house!","Merda, Line... Ahh, não sei por quê. Acho que gosto tanto de você que vou deixar passar desta vez. Mas você teve sorte de Aldo não estar em casa. Nem pense em fazer algo assim se houver alguém além de mim na casa!");
 ds_map_add(m,"I, I ( I do not care about anything anymore. ) I am moaning Callie I really needed this.","Eu, eu... (Não me importo mais com nada.) Estou gemendo, Callie. Eu precisava muito disso.");
 ds_map_add(m,"Hey?! Line what are you doing!","Ei?! Line, o que você está fazendo?!");
 ds_map_add(m,"More, hit me harder!","Mais! Bata em mim com mais força!");
 ds_map_add(m,"OH, oh, oh, Yessssss, I needed this!!!!!","OH, OH, OH, SIIIIIM! Eu precisava tanto disso!!!!!");
 ds_map_add(m,"Ohh... A-ALdo... Drop your pants.","Ohh... A-Aldo... Tire a calça.");
 ds_map_add(m,"I know, I know, you said this isn't love it's just sexual relief and that my mother knows you're a succubus.","Eu sei, eu sei. Você disse que isso não é amor, é só alívio sexual, e que minha mãe sabe que você é uma súcubo.");
 ds_map_add(m,"Hey, Aldo please, listen to me.","Ei, Aldo, por favor, me escute.");
 ds_map_add(m,"( I have to stop this! )","(Preciso parar com isso!)");
 ds_map_add(m,"( None of this makes any sense, how could I do something like this, how could I distort my memories? )","(Nada disso faz sentido. Como pude fazer uma coisa dessas? Como pude distorcer minhas próprias lembranças?)");
 ds_map_add(m,"( Th-that is why I was disheveled, that is why I was so hot, Lili re-really heard what happened, that is why she was so weird. )","(E-é por isso que eu estava descabelada, por isso estava com tanto calor. Lili realmente ouviu o que aconteceu. É por isso que estava tão estranha.)");
 ds_map_add(m,"( Th-the night I found him masturbating, I-I seduced him, made him mine, had sex with him, my-my own stepson. )","(N-naquela noite em que o encontrei se masturbando, e-eu o seduzi, fiz dele meu, transei com ele... com meu próprio enteado.)");
 ds_map_add(m,"( It cannot be... I-I remember. I am a creep. )","(Não pode ser... E-eu me lembro. Sou uma pervertida.)");
 ds_map_add(m,"Of course that happe-","É claro que isso acontec-");
 ds_map_add(m,"What-e-? that didn't happen.","O-o quê? Isso não aconteceu.");
 ds_map_add(m,"I told you it was okay and normal to masturbate so you do not feel bad and then I left!","Eu disse que era normal e que não havia problema em se masturbar, para você não se sentir mal, e depois fui embora!");
 ds_map_add(m,"But-but, you did, it was when you came into my room when I was masturbating.","M-mas você fez isso. Foi quando entrou no meu quarto enquanto eu estava me masturbando.");
 ds_map_add(m,"What, when? I never said to come to the bathroom and run your penis up my ass!","O quê, quando? Nunca mandei você ir ao banheiro e enfiar seu pênis na minha bunda!");
 ds_map_add(m,"Y-you told me to come here.","V-você me disse para vir aqui.");
 ds_map_add(m,"Aldo, what are you doing here?","Aldo, o que está fazendo aqui?");
 ds_map_add(m,"*feels a pressure on her butt* Ah?! What's going on?.","*sente uma pressão na bunda* Ah?! O que está acontecendo?");
 ds_map_add(m,"This was a dream, was it not? no-no! it was a nightmare-this never happened.","Isso foi um sonho, não foi? N-não! Foi um pesadelo. Isso nunca aconteceu.");
 ds_map_add(m,"Hi Love eh, this is not what it really looks like haha...ha.","Oi, amor... É, isso não é o que parece, haha... ha.");
 ds_map_add(m,"AHHh, WAIT ALDO! Oh no... HE-HeheheHE.","AAH, ESPERE, ALDO! Ah, não... He-heheheHE.");
 ds_map_add(m,"AHH! I CAN FEEL YOUR THICK AND HOT CUM FILLING ME UP!","AAH! SINTO SEU SÊMEN GROSSO E QUENTE ME PREENCHENDO!");
 ds_map_add(m,"AH, AH-AH, AHHHH, HAVING SEX WITH MY STEPSON IS THE BEST!!!","AH, AH-AH, AHHHH! FAZER SEXO COM MEU ENTEADO É A MELHOR COISA DO MUNDO!!!");
 ds_map_add(m,"TAKE THIS MAMA ACCEPT MY CHILD IN YOUR WOMB!","RECEBA ISSO, MAMÃE! ACEITE MEU FILHO NO SEU VENTRE!");
 ds_map_add(m,"More, HARDER Aldo! STRONGEREEEEEEEEEEEEEEE CLAIM ME AS YOURS!","Mais, COM MAIS FORÇA, Aldo! MAIS FORTEEEEEEEEE! ME FAÇA SUA!");
 ds_map_add(m,"AHh, Ah AHHHH.","AAh, ah, AHHHH.");
 ds_map_add(m,"Look, Aldo, the truth is that...","Olhe, Aldo, a verdade é que...");
 ds_map_add(m,"Shit... I'm afraid of what you have to say.","Merda... Estou com medo do que você tem a dizer.");
 ds_map_add(m,"Yeah, hey we need to talk, it is very serious.","É, ei, precisamos conversar. É muito sério.");
 ds_map_add(m,"You finally came","Finalmente você veio.");
 ds_map_add(m,"Excellent work Line <3.","Excelente trabalho, Line. <3");
 ds_map_add(m,"... Callie asked where you were, you better go see her.","... Callie perguntou onde você estava. É melhor ir falar com ela.");
 ds_map_add(m,"Oh nothing Lili why so serious hehe?","Ah, nada, Lili. Por que tão séria, hehe?");
 ds_map_add(m,"Hey... what were you doing?","Ei... o que você estava fazendo?");
 ds_map_add(m,"... you know very well that this is a lie.","... você sabe muito bem que isso é mentira.");
 ds_map_add(m,"But I assure you we did our best!","Mas garanto que fizemos o melhor que podíamos!");
 ds_map_add(m,"I did what I could with my friend... I am sorry if you know any of those affected.","Minha amiga e eu fizemos o que pudemos... Sinto muito se você conhece alguém que foi afetado.");
 ds_map_add(m,"Hey, i-it's not your fault, I-I am trying to be something of a hero too.","Ei, n-não é sua culpa. E-eu também estou tentando ser uma espécie de herói.");
 ds_map_add(m,"Do I really deserve to be alive?","Eu realmente mereço estar viva?");
 ds_map_add(m,"I... am I a hero? I could have saved them... my life is not worth more than anyone else's.","Eu... sou uma heroína? Poderia tê-las salvado... Minha vida não vale mais do que a de ninguém.");
 ds_map_add(m,"Please listen to me, this is much more than my Eleonor, think of these women's families!","Por favor, me escute. Isso vai muito além da minha Eleonor. Pense nas famílias dessas mulheres!");
 ds_map_add(m,"There is no reason to believe you.","Não há motivo para acreditar em você.");
 ds_map_add(m,"Enough! You psycho, it ends here!","Chega! Sua psicopata, isso acaba aqui!");
 ds_map_add(m,"If I succeed all those women I can revive them as slime, I only need the one who is compatible for my beautiful Eleonor and she will stabilize forever all the women transformed.","Se eu conseguir, poderei reviver todas aquelas mulheres como Slimes. Só preciso encontrar uma compatível com minha bela Eleonor, e ela estabilizará para sempre todas as mulheres transformadas.");
 ds_map_add(m,"I'm not crazy! All these women's lives were steps to bring my Eleonor back to the way she was!","Não sou louco! A vida de todas essas mulheres foi apenas um meio para trazer minha Eleonor de volta ao que era!");
 ds_map_add(m,"I think I am going to throw up.","Acho que vou vomitar.");
 ds_map_add(m,"this lunatic has been abducting women and turning them into slime.","Esse lunático vem sequestrando mulheres e transformando-as em Slimes.");
 ds_map_add(m,"I-it cannot be.","I-isso não pode ser.");
 ds_map_add(m,"Revive my Love!","Ressuscite, meu amor!");
 ds_map_add(m,"The Slime seekers warned us One of them is compatible with you it's now or never!","Os buscadores de Slimes nos avisaram: uma delas é compatível com você. É agora ou nunca!");
 ds_map_add(m,"Consume, this means... this blood?!","Consumir... isso quer dizer... este sangue?!");
 ds_map_add(m,"Eleonor my love Consume them, please, one more time.","Eleonor, meu amor, consuma-as, por favor. Mais uma vez.");
 ds_map_add(m,"NOOO! This cannot end here!","NÃÃÃO! Não pode terminar assim!");
 ds_map_add(m,"Raise your hands where I can see them and come with me!","Mãos para cima, onde eu possa vê-las, e venha comigo!");
 ds_map_add(m,"You are under arrest by the power granted to me by the great captain of Elira!","Você está presa pelo poder que me foi concedido pela Grande Capitã de Elira!");
 ds_map_add(m,"Hey! You're the one behind all this!","Ei! Então é você quem está por trás de tudo isso!");
 ds_map_add(m,"Wha-what is all this blood?","O-o que é todo esse sangue?");
 ds_map_add(m,"CONSUME THEM ELEONOR!","CONSUMA-AS, ELEONOR!");
 ds_map_add(m,"Don't you dare talk to my wife like that!","Não ouse falar assim com minha esposa!");
 ds_map_add(m,"This thing needs to be taken care of first!","Precisamos cuidar desta coisa primeiro!");
 ds_map_add(m,"Ahhhhh ok but we'll go together, maybe this way you'll have more time to drain all the energy from that thing!","Ahhh, está bem, mas vamos juntos. Talvez assim você tenha mais tempo para drenar toda a energia daquela coisa!");
 ds_map_add(m,"Vasuki, if I don't do it we will die anyway.","Vasuki, se eu não fizer isso, vamos morrer de qualquer jeito.");
 ds_map_add(m,"Are you done talking? surrender to Eleonor and bring her back to life!","Já terminou de falar? Renda-se a Eleonor e traga-a de volta à vida!");
 ds_map_add(m,"I have no other options.","Não tenho outra opção.");
 ds_map_add(m,"And if you are compatible you will end up becoming that psychopath's wife.","E, se você for compatível, acabará se tornando a esposa daquele psicopata.");
 ds_map_add(m,"You are completely crazy if you are not the compatible she will kill you.","Você é completamente louca. Se não for compatível, ela vai matar você.");
 ds_map_add(m,"Vasuki I have an idea, if I come in contact with her, I can drain her energy and thus defeat her or at least incapacitate her.","Vasuki, tive uma ideia. Se eu entrar em contato com ela, posso absorver sua energia e derrotá-la, ou pelo menos incapacitá-la.");
 ds_map_add(m,"El-eleonor yo-you changed we are so close to your resurrection.","E-Eleonor, v-você mudou. Estamos tão perto da sua ressurreição.");
 ds_map_add(m,"We cannot defeat it","Não podemos derrotá-la.");
 ds_map_add(m,"Is too strong!","É forte demais!");
 ds_map_add(m,"The message does not go public because of the scrutiny of one of the parties involved to catch the accused.","A mensagem não foi divulgada ao público por consideração a uma das partes envolvidas na captura do acusado.");
 ds_map_add(m,"'Do you really think your life is worth more than all those women!?'","'Você realmente acha que sua vida vale mais do que a de todas aquelas mulheres?!'");
 ds_map_add(m,"Before the accused lost all his sanity, he wrote a message in blood on the wall of his cell.","Antes de perder completamente a razão, o acusado escreveu uma mensagem com sangue na parede de sua cela.");
 ds_map_add(m,"The number of missing women associated with the case is in the dozens and growing as the investigation progresses.","O número de mulheres desaparecidas relacionadas ao caso já chega às dezenas e continua aumentando à medida que a investigação avança.");
 ds_map_add(m,"Hours after the mother slime died, all the slimes created by it perished.","Poucas horas depois da morte da Slime-Mãe, todas as Slimes criadas por ela morreram.");
 ds_map_add(m,"Dr. Isic Arumov did not face justice due to his mental state.","O Dr. Isic Arumov não foi julgado devido ao seu estado mental.");
 ds_map_add(m,"The attack of the Slimes has finally ceased and the citizens feel a little safer again.","O ataque das Slimes finalmente cessou, e os cidadãos voltaram a se sentir um pouco mais seguros.");
 ds_map_add(m,"Raise your hands and come with me.","Mãos para cima e venha comigo.");
 ds_map_add(m,"*Read the name on his coat* Doctor Isic Arumov you are under arrest for crimes against humanity.","*Lê o nome no casaco* Doutor Isic Arumov, você está preso por crimes contra a humanidade.");
 ds_map_add(m,"Do not let him get into your head Line, he is responsible for all of this.","Não deixe que ele entre na sua cabeça, Line. Ele é o responsável por tudo isso.");
 ds_map_add(m,"Bu-ut I just wanted to stop this, I-I am a hero I did not want to doom anyone.","M-mas eu só queria impedir tudo isso. E-eu sou um herói, não queria condenar ninguém.");
 ds_map_add(m,"You selfish fool, you condemned all the women who became Slime!","Seu egoísta idiota! Você condenou todas as mulheres que se transformaram em Slimes!");
 ds_map_add(m,"M-my intention was only t-to incapacitate her, I did not think she woul-","M-minha intenção era apenas incapacitá-la. Não pensei que ela fosse...");
 ds_map_add(m,"I-it seems to have worked.","P-parece que funcionou.");
 ds_map_add(m,"Wha-what have they done to you my love, Eleonor, why... why? you didn't have to die.","O-o que fizeram com você, meu amor? Eleonor, por quê... por quê? Você não precisava ter morrido.");
 ds_map_add(m,"If we do everything right, there should be no problems.","Se fizermos tudo direito, não deve haver problemas.");
 ds_map_add(m,"I will have to accelerate the investigation for Eleonor's sake and mine.","Terei que acelerar a investigação por Eleonor e por mim.");
 ds_map_add(m,"The great captain announced that the happy bad omen sect, after years of not knowing about them, had caused one of the most grotesque crime of the last decade on the island.","A Grande Capitã anunciou que a seita do Presságio Feliz, após anos sem dar notícias, foi responsável por um dos crimes mais grotescos da última década na ilha.");
 ds_map_add(m,"They murdered all the women in Big Dream.","Eles assassinaram todas as mulheres do Big Dream.");
 ds_map_add(m,"It's going to be a long night.","Vai ser uma longa noite.");
 ds_map_add(m,"In the room there is a chair in front of a table, sit there.","Há uma cadeira no quarto, em frente à mesa. Sente-se nela.");
 ds_map_add(m,"T-Then what do we do?!","E-então, o que vamos fazer?!");
 ds_map_add(m,"If you go out now you could run into one of them, you could be possessed or worse so you can't leave that office.","Se sair agora, pode encontrar uma delas. Você pode ser possuída ou algo pior. Portanto, não pode sair deste escritório.");
 ds_map_add(m,"But at night they become very aggressive.","Mas, à noite, elas ficam muito agressivas.");
 ds_map_add(m,"Thi-this place is cursed at night by... people I hold dear to my heart.","Este lugar é amaldiçoado à noite por... pessoas que guardo com carinho no coração.");
 ds_map_add(m,"AH decide woman!","AH, DECIDA-SE, MULHER!");
 ds_map_add(m,"NO, stop! don't leave!","NÃO! Pare! Não vá embora!");
 ds_map_add(m,"Let's go Line I feel that there is something very wrong here!","Vamos, Line. Sinto que há algo muito errado aqui!");
 ds_map_add(m,"What? oh no this is very bad I'm so sorry.","O quê? Ah, não, isso é muito ruim. Sinto muito.");
 ds_map_add(m,"OH No no no why are they there and at night! this place is closed to the public it is very dangerous!","AH, NÃO, NÃO, NÃO! Por que elas estão lá fora à noite?! Este lugar é fechado ao público. É muito perigoso!");
 ds_map_add(m,"Alo who is it?","Alô, quem é?");
 ds_map_add(m,"I think it comes from the ventilation.","Acho que vem da ventilação.");
 ds_map_add(m,"A-aloooo.","A-alôôô.");
 ds_map_add(m,"AHHhhHH","AAHHHH!");
 ds_map_add(m,"AAahHH","AAAHHH!");
 ds_map_add(m,"WHO IS THERE?!","QUEM ESTÁ AÍ?!");
 ds_map_add(m,"Hey Hey, Don't stand up so fast you've been unconscious for quite a while.","Ei, ei, não se levante tão depressa. Você ficou inconsciente por bastante tempo.");
 ds_map_add(m,"Enough woman! if I had an arc for every time you fall for being distracted I would have 2 arcs wich is not a lot but is weird that it happend twice.","Chega, mulher! Se eu ganhasse um Arc cada vez que você cai por se distrair, teria dois Arcs. Não é muita coisa, mas é estranho ter acontecido duas vezes.");
 ds_map_add(m,"This time Uhgg, I do not think so.","Desta vez, uhgg, acho que não.");
 ds_map_add(m,"LINE ARE YOU OK?!","LINE, VOCÊ ESTÁ BEM?!");
 ds_map_add(m,"AgHHHH SHIKAWAGA.","AGHHHH, SHIKAWAGA.");
 ds_map_add(m,"Quieres empezar?","Quer começar?");
 ds_map_add(m,"Best of luck girls...","Boa sorte, meninas...");
 ds_map_add(m,"Once the sun rises we can talk more.","Quando o sol nascer, poderemos conversar melhor.");
 ds_map_add(m,"Shit... you watch the cameras and give me the signal to close the doors.","Merda... Fique de olho nas câmeras e me dê o sinal para fechar as portas.");
 ds_map_add(m,"Lili I am so scared ;c.","Lili, estou com tanto medo. ;c");
 ds_map_add(m,"That's the problem you have to last until dawn and I know the energy won't last that long so only close them when it's really necessary!","Esse é o problema: vocês precisam aguentar até o amanhecer, e sei que a energia não vai durar tanto. Então só feche as portas quando for realmente necessário!");
 ds_map_add(m,"So much drama just to tell us to close the doors!","Todo esse drama só para dizer que devemos fechar as portas!");
 ds_map_add(m,"Watch for ghosts with the cameras and if they get too close, close the doors.","Fique de olho nos fantasmas pelas câmeras e, se chegarem perto demais, feche as portas.");
 ds_map_add(m,"What, then what do I do :c?","O quê? Então o que eu faço? :c");
 ds_map_add(m,"Unfortunately, this was a long time ago so I don't know how much time you have, with energy.","Infelizmente, isso aconteceu há muito tempo, então não sei quanto tempo de energia ainda resta.");
 ds_map_add(m,"Where you are is the safest place there is, the knights of Elira have cordoned off the place and placed generators that activate doors reinforced with magic.","O lugar onde vocês estão é o mais seguro que existe. Os Cavaleiros de Elira isolaram a área e instalaram geradores que ativam portas reforçadas com magia.");
 ds_map_add(m,"There is not much time this is what you should do.","Não temos muito tempo. É isto que você deve fazer.");
 ds_map_add(m,"Oh, great ehh I guess ;c","Ah, ótimo... eu acho. ;c");
 ds_map_add(m,"In spite of all the bad things you are lucky tonight they are very calm but you can't let your guard down.","Apesar de tudo de ruim que aconteceu, vocês têm sorte: esta noite elas estão muito calmas. Mas não podem baixar a guarda.");
 ds_map_add(m,"Now listen to me, this is very important.","Agora escute. Isto é muito importante.");
 ds_map_add(m,"It's a bad idea to leave this room.","Não é uma boa ideia sair deste quarto.");
}
if(ds_map_exists(global.zh_display_map,s))return ds_map_find_value(global.zh_display_map,s);
return s;
