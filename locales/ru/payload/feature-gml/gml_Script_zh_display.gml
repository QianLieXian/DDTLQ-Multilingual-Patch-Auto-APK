 ds_map_add(m,"Mp","Мана");
 ds_map_add(m,"Nature","Природа");
 ds_map_add(m,"Vasera","Васера");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Уф, Бигг Дэдди! Надеюсь, однажды он будет обращаться со мной как с родной дочкой.");
 ds_map_add(m,"Naga","Нага");
