 ds_map_add(m,"Best of luck girls...","Bol şans kızlar...");
 ds_map_add(m,"Once the sun rises we can talk more.","Güneş doğunca daha fazla konuşabiliriz.");
 ds_map_add(m,"Shit... you watch the cameras and give me the signal to close the doors.","Lanet olsun... Kameraları izle ve kapıları kapatmam için bana işaret ver.");
 ds_map_add(m,"Lili I am so scared ;c.","Lili, çok korkuyorum ;c.");
 ds_map_add(m,"That's the problem you have to last until dawn and I know the energy won't last that long so only close them when it's really necessary!","Sorun da bu; şafağa kadar dayanmanız gerek. Enerjinin o kadar uzun süre yetmeyeceğini biliyorum, bu yüzden kapıları yalnızca gerçekten gerektiğinde kapat!");
 ds_map_add(m,"So much drama just to tell us to close the doors!","Sırf kapıları kapatmamızı söylemek için bu kadar tantana çıkarmışlar!");
 ds_map_add(m,"Watch for ghosts with the cameras and if they get too close, close the doors.","Kameralardan hayaletleri izle; fazla yaklaşırlarsa kapıları kapat.");
 ds_map_add(m,"What, then what do I do :c?","Ne, peki o zaman ne yapacağım :c?");
 ds_map_add(m,"Unfortunately, this was a long time ago so I don't know how much time you have, with energy.","Ne yazık ki bu olay çok uzun zaman önce yaşandı; bu yüzden enerjinizle ne kadar süre dayanabileceğinizi bilmiyorum.");
 ds_map_add(m,"Where you are is the safest place there is, the knights of Elira have cordoned off the place and placed generators that activate doors reinforced with magic.","Bulunduğunuz yer olabilecek en güvenli yer. Elira Şövalyeleri bölgeyi kordon altına aldı ve büyüyle güçlendirilmiş kapıları çalıştıran jeneratörler yerleştirdi.");
 ds_map_add(m,"There is not much time this is what you should do.","Fazla zaman yok. Yapman gerekenler şunlar.");
 ds_map_add(m,"Oh, great ehh I guess ;c","Ah, harika... sanırım ;c");
 ds_map_add(m,"In spite of all the bad things you are lucky tonight they are very calm but you can't let your guard down.","Bunca kötü şeye rağmen bu gece şanslısınız. Çok sakinler ama yine de gardınızı düşürmemelisiniz.");
 ds_map_add(m,"Now listen to me, this is very important.","Şimdi beni dinle, bu çok önemli.");
 ds_map_add(m,"It's a bad idea to leave this room.","Bu odadan çıkmak kötü bir fikir.");
}
if(ds_map_exists(global.zh_display_map,s))return ds_map_find_value(global.zh_display_map,s);
return s;
