 ds_map_add(m,"* I do not like the presence of those hands.","* Bu ellerin varlığından hoşlanmıyorum.");
 ds_map_add(m,"* They are becoming more and more aggressive","* Giderek daha saldırganlaşıyorlar.");
 ds_map_add(m,"* They are everywhere, they do not leave me alone.","* Her yerdeler, peşimi bırakmıyorlar.");
 ds_map_add(m,"* Is a lot of money for just one person.","* Tek bir kişi için çok fazla para.");
