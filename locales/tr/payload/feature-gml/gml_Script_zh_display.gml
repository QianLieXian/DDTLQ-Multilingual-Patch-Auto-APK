 ds_map_add(m,"Defeat the pink slime that is trying to enter the hospital.","Hastaneye girmeye çalışan pembe slime'ı yen.");
 ds_map_add(m,"According to the information from the guards, there is a slime near the hospital.","Muhafızlardan alınan bilgiye göre hastanenin yakınında bir slime var.");
 ds_map_add(m,"Defeat the slime that is trying to capture the plant woman.","Bitki kadını yakalamaya çalışan slime'ı yen.");
