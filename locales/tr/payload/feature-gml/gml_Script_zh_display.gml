 ds_map_add(m,"The story is about a half-succubus elf who is the servant of a king.","Hikâye, bir kralın hizmetinde olan yarı succubus bir elf hakkında.");
 ds_map_add(m,"Lucy takes the book but instead of letting Line read it she begins to narrate it.","Lucy kitabı alır ama Line'ın okumasına izin vermek yerine ona anlatmaya başlar.");
 ds_map_add(m,"Hehe you are so excited, I want to know how my adventures inspired you. <3","Hehe, çok heyecanlısın. Maceralarımın sana nasıl ilham verdiğini merak ediyorum. <3");
 ds_map_add(m,"Line you finally arrived, please come to my room. <3","Line, sonunda geldin. Lütfen odama gel. <3");
