 ds_map_add(m,"no maldita idiota la informacion sobre tu amiga!","Hayır, lanet olası aptal, arkadaşın hakkındaki bilgiyi soruyorum!");
 ds_map_add(m,"si con le pedire un role play de mama <3","Evet, ondan anne rolü yapmasını isteyeceğim <3.");
 ds_map_add(m,"bien hecho Line ahora busquemos a ivy por la recompensa","Aferin Line, şimdi ödül için Ivy'yi bulalım.");
 ds_map_add(m,"Hey tu la de pelo azul","Hey sen, mavi saçlı olan!");
 ds_map_add(m,"Ok that's it!","Tamam, bu kadar!");
 ds_map_add(m,"Hey chill,  we can help you clean jeez girl.","Hey, sakin ol. Temizlemene yardım edebiliriz, Tanrım kızım.");
 ds_map_add(m,"Now Mr.Cabello will return tired from his work and he will see that I did nothing!!","Şimdi Bay Cabello işten yorgun argın dönecek ve hiçbir şey yapmadığımı görecek!!");
 ds_map_add(m,"You know how long it took me to clean this floor!","Bu zemini temizlemenin ne kadar sürdüğünü biliyor musun?!");
 ds_map_add(m,"Ups. I am really really sorry.","Ayy. Gerçekten çok çok özür dilerim.");
 ds_map_add(m,"What are you doing?!.","Ne yapıyorsun?!");
 ds_map_add(m,"The three of them managed to get every little mound of dust off the second floor.","Üçü, ikinci kattaki en ufak toz yığınlarını bile temizlemeyi başardı.");
 ds_map_add(m,"After 15 minutes of thorough cleaning.","On beş dakikalık titiz temizliğin ardından.");
