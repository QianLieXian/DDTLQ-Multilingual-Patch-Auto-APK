 ds_map_add(m,"Uff that was  great and really  exausting.","Off, harikaydı ama gerçekten çok yorucuydu.");
 ds_map_add(m,"Don't worry I'll give you the best death an elf can have.","Merak etme, sana bir elfin yaşayabileceği en güzel ölümü tattıracağım.");
