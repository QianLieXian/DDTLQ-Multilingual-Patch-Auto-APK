 ds_map_add(m,"My first fursuit <3","İlk fursuit'im <3");
 ds_map_add(m,"Get the sacred sword from the forest south of the hospital! Directions : up, down, left, left, right, down and finally up.","Kutsal kılıcı hastanenin güneyindeki ormandan al! Yönler: yukarı, aşağı, sol, sol, sağ, aşağı ve son olarak yukarı.");
 ds_map_add(m,"look for a gorilla to teach you how to channel the force like them.","Gücü onlar gibi yönlendirmeyi sana öğretecek bir goril bul.");
