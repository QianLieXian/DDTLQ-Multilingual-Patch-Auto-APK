 ds_map_add(m,"I thought you went to the house sorry LilI :c.","Eve gittiğini sanmıştım, üzgünüm Lili :c.");
 ds_map_add(m,"Line you dirty slut, you made me wait here while I hear you say, yes mommy I love you and stuff and you ask me what I'm waiting for?","Line, seni pis sürtük! Burada beni beklettin; içeride 'Evet anneciğim, seni seviyorum' falan dediğini duydum. Sonra da bana ne beklediğimi mi soruyorsun?");
 ds_map_add(m,"Mmm, and what are you waiting for?","Hımm, peki neyi bekliyorsun?");
