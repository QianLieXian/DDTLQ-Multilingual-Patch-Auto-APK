 ds_map_add(m,"Hu-Hu a little pink snack.","Hu hu, pembe renkli küçük bir atıştırmalık.");
 ds_map_add(m,"*whispering* It's perfect Line, she doesn't know you're a succubus drain her until she falls asleep and we'll win.","*Fısıldayarak* Mükemmel Line. Succubus olduğunu bilmiyor. Uyuyana kadar enerjisini em, böylece kazanırız.");
 ds_map_add(m,"Dont worry, you'll live as long as you keep satisfying me <3.","Merak etme, beni tatmin etmeye devam ettiğin sürece yaşayacaksın. <3");
 ds_map_add(m,"Line you will never beat her in a fight.","Line, onunla dövüşerek asla kazanamazsın.");
 ds_map_add(m,"Dagnabbit is to strong!","Kahretsin, çok güçlü!");
 ds_map_add(m,"By the way I am half succubus and it helps me to fight differently don't think anything strange. :c","Bu arada yarı succubus'um. Bu da farklı bir şekilde dövüşmeme yardımcı oluyor. Aklına tuhaf bir şey getirme. :c");
 ds_map_add(m,"I'll keep it in a safe place where it won't make any trouble.","Sorun çıkarmayacağı güvenli bir yerde saklayacağım.");
