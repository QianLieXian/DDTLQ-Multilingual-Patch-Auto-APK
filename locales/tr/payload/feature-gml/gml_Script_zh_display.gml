 ds_map_add(m,"At night he goes to the window adjoining Aldo's room.","Gece, Aldo'nun odasına bitişik pencereye gider.");
 ds_map_add(m,"After sleeping with callie you feel dirty go take a bath in her shower.","Callie'yle yattıktan sonra kendini kirli hissediyorsun; git, onun duşunda yıkan.");
 ds_map_add(m,"It looks like Callie wants to talk to you, go to her.","Callie seninle konuşmak istiyor gibi görünüyor. Yanına git.");
 ds_map_add(m,"Explore Callie's home..","Callie'nin evini keşfet..");
 ds_map_add(m,"Callie invited you to have lunch, go to her house during the day.","Callie seni öğle yemeğine davet etti. Gündüz vakti evine git.");
 ds_map_add(m,"A beautiful family","Güzel Bir Aile");
 ds_map_add(m,"Where will the sister be?","Rahibe nerede olabilir?");
 ds_map_add(m,"What do I do now? I want her to think of me, I want her to hate me, I want her to think of me, I want her to hate me, I want my image to never leave her head again!.","Şimdi ne yapacağım? Beni düşünmesini istiyorum, benden nefret etmesini istiyorum, beni düşünmesini istiyorum, benden nefret etmesini istiyorum, görüntümün bir daha aklından hiç çıkmamasını istiyorum!.");
 ds_map_add(m,"Go to church for confession with the sister.","Rahibeyle günah çıkarmak için kiliseye git.");
