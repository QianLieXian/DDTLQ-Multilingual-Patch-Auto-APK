var s=string(argument0);
if(!variable_global_exists("zh_display_map"))global.zh_display_map=-1;
if(!ds_exists(global.zh_display_map,ds_type_map)){
 global.zh_display_map=ds_map_create();
 var m=global.zh_display_map;
 ds_map_add(m,"Piercing","Delme");
 ds_map_add(m,"Impact","Darbe");
 ds_map_add(m,"Cut","Kesme");
 ds_map_add(m,"Hp","Can");
 ds_map_add(m,"Mp","Mana");
 ds_map_add(m,"Nature","Doğa");
 ds_map_add(m,"Uff Bigg Daddy I hope someday he treats me like his little daughter.","Of, Bigg Daddy! Umarım bir gün bana küçük kızıymışım gibi davranır.");
 ds_map_add(m,"She knew my name somehow maybe if I find her I can get more information on why she knows me.","Adımı bir şekilde biliyordu. Belki onu bulursam beni nereden tanıdığını öğrenebilirim.");
 ds_map_add(m,"Ms honney","Honney Hanım");
 ds_map_add(m,"ohh <3, Ms honney is the best just by seeing me she knew the real me, oh I almost forgot she also helped me to get information. ","Aaa <3, Honney Hanım harika! Beni görür görmez gerçek beni anladı. Aa, az kalsın unutuyordum, bilgi toplamama da yardım etti.");
 ds_map_add(m,"Oh Rynn I remember she was super drunk in the tavern and babbling something about the empire erasing part of history or something, well I didn't pay much attention I got distracted looking at her abs.","Ah, Rynn! Onu meyhanede fena halde sarhoşken, imparatorluğun tarihin bir kısmını sildiği falan diye gevezelik ederken hatırlıyorum. Pek kulak asmadım; gözüm karın kaslarına takılmıştı.");
 ds_map_add(m,"Oh I remember this poor shortstack, Lili mistook her for a little girl and she exploded with rage. ahh why does this fairy always get me in trouble...","Ah, şu zavallı minyonu hatırladım. Lili onu küçük bir kız sanınca öfkeden deliye dönmüştü. Ah, bu peri neden hep başımı belaya sokuyor...");
 ds_map_add(m,"Alina is still waiting for her friend, hopefully she will be able to see her soon.","Alina hâlâ arkadaşını bekliyor. Umarım yakında görüşebilirler.");
 ds_map_add(m,"She was a very aggressive and territorial demon. The only way to beat her was to suck her energy out with my succubus powers hehe, I would not mind seeing her again, but Lili would kill me.","Çok saldırgan ve bölgeci bir iblisti. Onu yenmenin tek yolu, sukkubus güçlerimle enerjisini emmekti, hehe. Onu yeniden görmeye hayır demezdim ama Lili beni öldürürdü.");
 ds_map_add(m,"I regret Callie so much, I made her fall in love with me when I just wanted to be with her to experiment and she even wants to introduce me to her children. Sometimes I wish I was not half succubus, I hurt people so much.","Callie konusunda kendimi çok kötü hissediyorum. Sadece onunla deney yapmak istemiştim ama onu kendime âşık ettim; hatta beni çocuklarıyla tanıştırmak istiyor. Bazen keşke yarı sukkubus olmasaydım diyorum. İnsanları çok incitiyorum.");
 ds_map_add(m,"Baina Salasaki, a dream in life even my mother knew about her and I got to be with her <3 although I still found it a bit expensive.","Baina Salasaki... Hayatımın hayaliydi; annem bile onu tanıyordu ve ben onunla birlikte olabildim <3. Yine de biraz pahalı buldum.");
 ds_map_add(m,"Ohh this cat! because of her I am now curious about erotic asphyxiation, good thing Lili is always by my side if something bad happens.","Ah, bu kedi! Onun yüzünden erotik boğulmayı merak etmeye başladım. Neyse ki kötü bir şey olursa Lili hep yanımda.");
 ds_map_add(m,"Poor Pussiel because of me I made her work three times harder :c.","Zavallı Pussiel, benim yüzümden üç kat daha fazla çalışmak zorunda kaldı :c.");
 ds_map_add(m,"Lina was so angry about losing to that slime cat, she even asked me to help her train even though I don't think my fighting style will help her.","Lina o slime kediye yenilince çok sinirlendi; dövüş tarzımın ona pek faydası olacağını sanmasam da benden antrenman yapmasına yardım etmemi istedi.");
 ds_map_add(m,"Hynoxia I think she is the woman who sold the hypnotic gun to Lili, I wonder what else she has for sale?","Hynoxia, sanırım Lili'ye hipnoz silahını satan kadın oydu. Acaba başka neler satıyor?");
 ds_map_add(m,"My heroine of Tricotex, I can't believe we found her on the island. I hope someday to help her again but in her city <3.","Tricotex'teki kahramanım! Onu adada bulduğumuza inanamıyorum. Umarım bir gün ona yine yardım edebilirim, ama bu kez kendi şehrinde <3.");
 ds_map_add(m,"Sieki is the one who controls all the women in the VIP part of the bar, I wonder how someone gets to that position.","Barın VIP bölümündeki tüm kadınları Sieki yönetiyor. Acaba insan böyle bir konuma nasıl gelir?");
 ds_map_add(m,"Vasuki came to this dimension by chance, I helped her to find the dimensional rifts so that she could return home. But she decided to stay here with me for some reason, it dos not bother me really, maybe I am a horrible person.","Vasuki bu boyuta tesadüfen gelmişti. Eve dönebilmesi için boyut yarıklarını bulmasına yardım ettim. Ama nedense benimle burada kalmaya karar verdi. Aslında bundan rahatsız değilim. Belki de korkunç bir insanım.");
 ds_map_add(m,"How can I forget her, she has the perfect combination of dominance and delicacy, I hope she finds the cigarettes she likes, although if she does not find them maybe we could meet again hehe.","Onu nasıl unutabilirim ki? Baskınlık ve zarafetin kusursuz birleşimi. Umarım sevdiği sigaraları bulur. Bulamazsa belki yeniden karşılaşırız, hehe.");
 ds_map_add(m,"kamiko is exactly the same as lili the only difference is that she is my size, well not so much the same Lili does have her good side.","Kamiko, Lili'nin tıpatıp aynısı; tek farkı benim boyumda olması. Gerçi o kadar da aynı değiller. Lili'nin iyi yanları da var.");
 ds_map_add(m,"She wanted to help me become a better succubus, although she spends most of her time having sex that I hardly see her. Maybe she is teaching me not to waste my time as a succubus? ahh why everything must be so complicated!","Daha iyi bir sukkubus olmama yardım etmek istiyordu ama zamanının çoğunu seks yaparak geçiriyor; onu neredeyse hiç göremiyorum. Belki de bir sukkubus olarak vaktimi boşa harcamamayı öğretiyordur? Ah, neden her şey bu kadar karmaşık!");
 ds_map_add(m,"Maruia is a very honest orc she kept her word when I beat her in a fight. Mmm if somehow I get us to fight noo, what am I thinking bad thought out out OUT!","Maruia çok dürüst bir ork. Dövüşte onu yendiğimde sözünü tuttu. Hımm, acaba onu yeniden dövüşmeye ikna etsem... Hayır! Ne düşünüyorum ben? Kötü düşünce, defol, defol, DEFOL!");
 ds_map_add(m,"he is the same as me we are shy, but we have our secret side hopefully he will do better keeping up appearances than me.","O da benim gibi; ikimiz de utangacız ama gizli bir yanımız var. Umarım dışarıya karşı rol yapmayı benden daha iyi becerir.");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","Anne!!! Annemi çok seviyorum!!!");
 ds_map_add(m,"A very good person who cares a lot about the great captain.","Büyük Kaptan'ı çok önemseyen, gerçekten iyi biri.");
 ds_map_add(m,"Faye must be the most unpleasant person I Have ever met, at least we ended up having sex or else I would have gone crazy.","Faye hayatımda tanıdığım en çekilmez insan olmalı. En azından sonunda seks yaptık; yoksa aklımı kaçırırdım.");
 ds_map_add(m,"Bell has such a beautiful mission and I hope he can sprout more of these extinct flowers.","Bell'in görevi ne kadar güzel. Umarım soyu tükenmiş bu çiçeklerden daha fazlasını yeniden yetiştirebilir.");
 ds_map_add(m,"Lucy is great and I hope you do not let her down with her novel.","Lucy harika biri. Umarım romanıyla onu hayal kırıklığına uğratmazsın.");
 ds_map_add(m,"Miss Marael showed me a side of the succubus that nobody wanted to show me before and for that I am grateful.","Marael Hanım bana sukkubusların kimsenin daha önce göstermek istemediği bir yönünü gösterdi. Bunun için minnettarım.");
 ds_map_add(m,"Lemmy told Lili that apparently ZONE-tam is a famous news reporter. Mmm now that I think about it why do Lili and Lemmy get along so well?","Lemmy, ZONE-tam'ın ünlü bir haber muhabiri olduğunu söylemişti. Hımm, şimdi düşününce Lili ile Lemmy neden bu kadar iyi anlaşıyor?");
 ds_map_add(m,"Gildfried is awesome and has a giant penis and what was I saying?","Gildfried harika biri, üstelik kocaman bir penisi var... Ben ne diyordum?");
 ds_map_add(m,"Dannie perky","Dannie Perky");
 ds_map_add(m,"Dede restrun","Dede Restrun");
 ds_map_add(m,"Danyelle dower","Danyelle Dower");
 ds_map_add(m,"Debu Euler ku","Debu Euler Ku");
 ds_map_add(m,"Ella es Futaba tu futanari de Confianza :0","İşte Futaba, güvenilir futanarin :0");
