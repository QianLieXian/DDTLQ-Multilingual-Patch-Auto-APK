 ds_map_add(m,"Thanks sakura hehe. <3","Teşekkürler Sakura, hehe. <3");
 ds_map_add(m,"I mean your stamina haha, don't worry line you are beautiful just the way you are. <3","Dayanıklılığından bahsediyorum, haha. Merak etme Line, olduğun hâlinle güzelsin. <3");
 ds_map_add(m,"hey watch your mauth! Line is not chubby, she is full of love","Hey, ağzına dikkat et! Line tombul değil, sevgiyle dolu.");
