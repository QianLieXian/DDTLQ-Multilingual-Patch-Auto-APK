 ds_map_add(m,"With this we will enter the sabbath?","Bununla cadılar ayinine katılabilecek miyiz?");
 ds_map_add(m,"Finally you arrived, take this armor and put it near the night club, it is a bit heavy.","Sonunda geldin. Bu zırhı al ve gece kulübünün yakınında giy. Biraz ağır.");
