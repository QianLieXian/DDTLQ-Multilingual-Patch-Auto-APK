q.QueueReplace("gml_Script_qa_axis","switch(argument1){case gp_axislh:return global.qa_lx;case gp_axislv:return global.qa_ly;case gp_axisrh:return global.qa_rx;case gp_axisrv:return global.qa_ry;}return 0;");
