qa_pad_reset();zh_pad_init();zh_pad_poll();
qa_assert(global.zh_pad_ready,"neutral-connect");
global.qa_lx=0.15;global.qa_ly=-0.18;zh_pad_poll();qa_assert(!zh_pad_key(vk_up,0)&&!zh_pad_key(vk_right,0),"stick-deadzone");
global.qa_ly=-0.8;zh_pad_poll();qa_assert(zh_pad_key(vk_up,1)&&zh_pad_key(ord("W"),0),"stick-up-and-alias");
zh_pad_poll();qa_assert(!zh_pad_key(vk_up,1),"direction-first-edge");
repeat(22)zh_pad_poll();qa_assert(zh_pad_key(vk_up,1),"direction-repeat");
global.qa_ly=-0.23;zh_pad_poll();qa_assert(zh_pad_key(vk_up,0),"stick-hysteresis");
global.qa_ly=-0.19;zh_pad_poll();qa_assert(!zh_pad_key(vk_up,0),"stick-release-threshold");
qa_pad_reset();zh_pad_poll();global.qa_buttons[0]=true;zh_pad_poll();
qa_assert(zh_keyboard_check_pressed(ord("Z"))&&zh_keyboard_check_pressed(ord("K"))&&zh_keyboard_check_pressed(vk_space),"A-confirm-all-schemes");
for(var qa_scheme=0;qa_scheme<3;qa_scheme+=1){global.controls=qa_scheme;with(o_brain_dressup){scr_input();qa_assert(key_accept,"native-scr-input-confirm-"+string(global.controls));}}
zh_pad_poll();qa_assert(!zh_keyboard_check_pressed(ord("Z"))&&zh_keyboard_check(ord("Z")),"confirm-no-repeat");
qa_pad_reset();zh_pad_poll();global.qa_buttons[1]=true;zh_pad_poll();qa_assert(zh_keyboard_check_pressed(ord("X"))&&zh_keyboard_check_pressed(ord("Q")),"B-back");
qa_pad_reset();zh_pad_poll();global.qa_buttons[9]=true;zh_pad_poll();qa_assert(zh_keyboard_check_pressed(vk_enter)&&zh_keyboard_check_pressed(vk_tab),"Start-pause");
qa_pad_reset();zh_pad_poll();global.qa_buttons[3]=true;zh_pad_poll();zh_helper_step();qa_assert(panel&&global.zh_panel,"Y-open-helper");
zh_pad_poll();zh_helper_step();qa_assert(panel,"held-Y-no-retoggle");
qa_pad_reset();zh_pad_poll();global.qa_buttons[1]=true;zh_pad_poll();zh_helper_step();qa_assert(!panel&&!global.zh_panel,"B-close-helper");
qa_pad_reset();zh_pad_poll();global.qa_buttons[8]=true;zh_pad_poll();zh_helper_step();qa_assert(panel,"View-open-helper");
qa_pad_reset();zh_pad_poll();global.qa_buttons[1]=true;zh_pad_poll();zh_helper_step();
qa_pad_reset();zh_pad_poll();global.zh_input_cooldown=0;panel=true;global.zh_panel=true;zh_choice=2;
var qa_money=Arcs;global.qa_buttons[0]=true;zh_pad_poll();zh_helper_step();qa_assert(Arcs==qa_money+100000,"helper-A-selected-action");
panel=false;global.zh_panel=false;global.zh_input_cooldown=0;qa_pad_reset();zh_pad_poll();
global.zh_pad_cursor=true;global.zh_pad_x=100;global.zh_pad_y=100;global.qa_rx=1;zh_pad_poll();qa_assert(global.zh_pad_x==103,"right-stick-cursor");
global.qa_buttons[4]=true;zh_pad_poll();qa_assert(global.zh_pad_x==104,"LB-precision");
global.qa_buttons[4]=false;global.qa_buttons[5]=true;zh_pad_poll();qa_assert(global.zh_pad_x==110,"RB-fast-cursor");
global.zh_pad_x=display_get_gui_width()-1;zh_pad_poll();qa_assert(global.zh_pad_x==display_get_gui_width()-1,"cursor-clamp");
qa_pad_reset();zh_pad_poll();global.qa_buttons[7]=true;zh_pad_poll();qa_assert(zh_mouse_raw(mb_left,1)&&zh_mouse_check_button(mb_left),"RT-left-press");
zh_pad_poll();qa_assert(zh_mouse_raw(mb_left,0)&&!zh_mouse_raw(mb_left,1),"RT-drag-hold");
global.qa_buttons[2]=true;global.qa_buttons[7]=false;zh_pad_poll();qa_assert(zh_mouse_raw(mb_left,0)&&!zh_mouse_raw(mb_left,2),"X-RT-shared-hold");
global.qa_buttons[2]=false;zh_pad_poll();qa_assert(zh_mouse_raw(mb_left,2)&&!zh_mouse_raw(mb_left,0),"left-release");
global.qa_buttons[6]=true;zh_pad_poll();qa_assert(zh_mouse_raw(mb_right,1)&&!zh_mouse_raw(mb_left,0),"LT-right-click");
global.zh_panel=true;qa_assert(!zh_mouse_check_button(mb_right)&&!zh_keyboard_check(ord("Z")),"helper-modal-input-gate");global.zh_panel=false;
global.qa_focus=false;zh_pad_poll();qa_assert(!global.zh_pad_cursor&&!zh_mouse_raw(mb_right,0)&&global.zh_pad_released[9],"focus-loss-release");
global.qa_focus=true;global.qa_buttons[0]=true;zh_pad_poll();qa_assert(!zh_pad_key(ord("Z"),0),"focus-regain-held-button-block");
qa_pad_reset();zh_pad_poll();global.qa_buttons[0]=true;zh_pad_poll();qa_assert(zh_pad_key(ord("Z"),1),"neutral-rearm");
qa_pad_reset();zh_pad_poll();global.qa_buttons[7]=true;zh_pad_poll();global.qa_connected=false;zh_pad_poll();qa_assert(global.zh_pad_device==-1&&zh_mouse_raw(mb_left,2),"disconnect-release");
global.qa_connected=true;zh_pad_poll();qa_assert(!global.zh_pad_ready&&!zh_mouse_raw(mb_left,0),"reconnect-held-trigger-block");
qa_pad_reset();zh_pad_poll();global.zh_pad_room=room+1;global.qa_buttons[0]=true;zh_pad_poll();qa_assert(!zh_pad_key(ord("Z"),0),"scene-change-rearm");
qa_pad_reset();zh_pad_poll();global.qa_buttons[12]=true;zh_pad_poll();qa_assert(zh_pad_key(vk_up,1),"dpad-up");
global.qa_buttons[13]=true;zh_pad_poll();qa_assert(!zh_pad_key(vk_up,0)&&!zh_pad_key(vk_down,0),"opposing-directions-neutral");
qa_pad_reset();zh_pad_poll();global.qa_mouse=true;global.qa_mouse_press=true;qa_assert(zh_mouse_raw(mb_left,1),"physical-first-edge");
global.qa_mouse_press=false;global.qa_buttons[7]=true;zh_pad_poll();qa_assert(!zh_mouse_raw(mb_left,1)&&zh_mouse_raw(mb_left,0),"physical-plus-pad-no-double-press");
global.qa_mouse=false;global.qa_mouse_release=true;zh_pad_poll();qa_assert(!zh_mouse_raw(mb_left,2)&&zh_mouse_raw(mb_left,0),"physical-release-pad-held");
global.qa_mouse_release=false;global.qa_buttons[7]=false;zh_pad_poll();qa_assert(zh_mouse_raw(mb_left,2),"last-source-release");
qa_pad_reset();zh_pad_poll();global.qa_buttons[7]=true;zh_pad_poll();zh_pad_poll();global.qa_mouse=true;global.qa_mouse_press=true;
qa_assert(!zh_mouse_raw(mb_left,1),"pad-plus-physical-no-double-press");
global.qa_mouse_press=false;global.qa_buttons[7]=false;zh_pad_poll();qa_assert(!zh_mouse_raw(mb_left,2)&&zh_mouse_raw(mb_left,0),"pad-release-physical-held");
global.qa_mouse=false;global.qa_mouse_release=true;qa_assert(zh_mouse_raw(mb_left,2),"physical-last-release");
qa_pad_reset();zh_pad_poll();
qa_pad_reset();zh_pad_poll();panel=false;global.zh_panel=false;global.zh_input_cooldown=0;
var qa_old_view=view_enabled;view_enabled=false;
var qa_tile=instance_create_depth(96,196,-100,o_square);
qa_tile.image_alpha=1;qa_tile.state="stable";qa_tile.chain_block=0;
var qa_hx=96,qa_hy=196,qa_hit=false;
for(var qa_x=qa_tile.bbox_left;qa_x<=qa_tile.bbox_right && !qa_hit;qa_x+=1)
 for(var qa_y=qa_tile.bbox_top;qa_y<=qa_tile.bbox_bottom && !qa_hit;qa_y+=1)
  if(collision_point(qa_x,qa_y,o_square,true,true)==qa_tile){qa_hx=qa_x;qa_hy=qa_y;qa_hit=true;}
qa_assert(qa_hit,"real-tile-hit-mask");
global.zh_pad_cursor=true;global.zh_pad_x=qa_hx/room_width*display_get_gui_width();global.zh_pad_y=qa_hy/room_height*display_get_gui_height();
global.qa_buttons[7]=true;zh_pad_poll();qa_assert(qa_tile.state=="dragging"&&qa_tile.selected==1,"RT-real-mouse-event-starts-tile-drag");
global.qa_buttons[7]=false;zh_pad_poll();qa_assert(qa_tile.state=="stable"&&qa_tile.selected==0,"RT-release-ends-tile-drag");
global.zh_panel=true;with(qa_tile)event_perform(ev_mouse,ev_left_press);qa_assert(qa_tile.state=="stable","helper-blocks-native-mouse-event");
global.zh_panel=false;global.zh_input_cooldown=3;with(qa_tile)event_perform(ev_mouse,ev_left_press);qa_assert(qa_tile.state=="stable","cooldown-blocks-native-mouse-event");
global.zh_input_cooldown=0;global.zh_load_active=true;with(qa_tile)event_perform(ev_mouse,ev_left_press);qa_assert(qa_tile.state=="stable","load-blocks-native-mouse-event");global.zh_load_active=false;
qa_pad_reset();zh_pad_poll();global.zh_pad_cursor=true;global.zh_pad_x=qa_hx/room_width*display_get_gui_width();global.zh_pad_y=qa_hy/room_height*display_get_gui_height();
global.qa_buttons[7]=true;zh_pad_poll();zh_pad_poll();global.qa_mouse=true;global.qa_mouse_press=true;
global.qa_mouse=false;global.qa_mouse_press=false;global.qa_mouse_release=true;with(qa_tile)event_perform(ev_mouse,ev_left_release);
qa_assert(qa_tile.state=="dragging","physical-release-keeps-pad-drag");
global.qa_mouse_release=false;global.qa_buttons[7]=false;zh_pad_poll();qa_assert(qa_tile.state=="stable","final-source-release-clears-real-tile");
with(qa_tile)instance_destroy();view_enabled=qa_old_view;qa_pad_reset();zh_pad_poll();
global.controls=0;global.qa_connected=false;zh_pad_poll();
show_debug_message("R7_GAMEPAD_TESTS="+string(global.qa_checks)+"|FAIL="+string(global.qa_failures));
game_end();
