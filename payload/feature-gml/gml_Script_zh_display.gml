 ds_map_add(m,"Maybe you could hahaha.","也许，你还真可以，哈哈哈。");
 ds_map_add(m,"Really? because I want to live in your armpits o.O.","真的？因为我想住在你的腋窝里o.O。");
 ds_map_add(m,"Jeez Line self control.","天哪，莱茵，克制一点。");
