 ds_map_add(m,"Defeat Crystal(Pink girl near the gallery in the circus).","打败克莉丝塔（马戏团画廊附近的粉发女孩）。");
 ds_map_add(m,"Grab the crystal.","拿起水晶。");
 ds_map_add(m,"Defeat the treasure hunters Naga.","击败寻宝猎人娜迦。");
 ds_map_add(m,"Talk to the leaf girl.","与叶子女孩交谈。");
