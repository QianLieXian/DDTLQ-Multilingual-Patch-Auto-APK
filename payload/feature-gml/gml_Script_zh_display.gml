 ds_map_add(m,"Ohh ok I will just move it from one side to the other..","哦，好，我只是把它，从一边挪到另一边……");
 ds_map_add(m,"Line starts to take out the milk bucket.","莱茵开始搬出奶桶。");
 ds_map_add(m,"She says she understands and will never do it again.","她说，她明白了，再也不会这样。");
 ds_map_add(m,"Ehhh... Agh it's ok what should I do.","呃……唉，好吧，该怎么做？");
