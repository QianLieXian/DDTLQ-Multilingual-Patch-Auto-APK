 ds_map_add(m,"You don't have enough arcs, get out of here and let people with money pass.","阿克不够，滚开，让有钱人过去。");
 ds_map_add(m,"Stop ... Haha looks like you're not the smart one on the team Line.","等等……哈哈，看来莱茵不是你们队里负责动脑子的那个啊。");
 ds_map_add(m,"Oh well, I don't know, but still, if you need help, uh a-here I am.","哦，那个，我不知道，不过你要是需要帮忙，我、我就在这儿。");
 ds_map_add(m,"Uff this novel will practically write itself.","呼，这小说简直能自己写出来。");
 ds_map_add(m,"OHh, an orthodox elf who discovers her sexuality, Line your life is gold.","哦，一个发现自身性欲的传统派精灵！莱茵，你的人生，简直是金矿。");
 ds_map_add(m,"Lili! ( Please someone kill me )","莉莉！（谁来杀了我吧。）");
 ds_map_add(m,"Wow I had no idea that elves could summon sacred fires.","哇，我都不知道精灵还能召唤圣火。");
 ds_map_add(m,"OHHH and what is this super attack?!","哦——这又是什么超级攻击？！");
 ds_map_add(m,"Ehh yes I am she hehe.","呃，对，就是我，嘿嘿。");
 ds_map_add(m,"You want to rest?","想休息一下吗？");
 ds_map_add(m,"Oh hehe thanks <3.","哦，嘿嘿，谢谢<3。");
 ds_map_add(m,"AHh I'll have to start all over again.\nWhere can my briefcase be?","啊，我得从头再来了。\n我的公文包到底在哪儿？");
 ds_map_add(m,"Actually could you tell me again how you fight?","能再跟我说说，你是怎么战斗的吗？");
 ds_map_add(m,"Are we done for the day?","今天就到这里吗？");
 ds_map_add(m,"Do you need something line?","莱茵，你需要什么？");
 ds_map_add(m,"I am Ragnuda the dodomeki and I judge men who cheat on their wives.","我是百目鬼拉格努妲，专门审判背着妻子偷腥的男人。");
 ds_map_add(m,"You interrupted my prayers.","你打断了我的祈祷。");
 ds_map_add(m,"A somewhat ironic ending I guess Hahaha.","这结局，还真有点讽刺啊，哈哈哈。");
 ds_map_add(m,"And now I have no money to go back home ;c.","现在，我连回家的钱都没有了;c。");
 ds_map_add(m,"Ah I really don't want to do this.","唉，我真的不想这么做。");
 ds_map_add(m,"Oh, yeah sorry it will have to be for another day :c.","哦，嗯，对不起，只能改天了:c。");
 ds_map_add(m,"Get the hell out of my territory you thot","滚出老娘的地盘，贱货。");
 ds_map_add(m,"It may already be time to get back to work, I miss announcing the news.","也该回去工作了，真想念播报新闻的日子。");
 ds_map_add(m,"That was a great show.","真是场精彩的演出。");
 ds_map_add(m,"Sorry (but I didn't do anything :c).","对不起。（可我明明什么都没干:c。）");
 ds_map_add(m,"Shit! Line look at that ass.","操！莱茵，快看那个屁股。");
 ds_map_add(m,"Thanks Line for the help <3.","莱茵，谢谢你帮忙<3。");
 ds_map_add(m,"MMm where to go next, what place will inspire me? to write my next hit.","嗯，接下来去哪儿呢？什么地方能激发灵感，让我再写出一本畅销书？");
 ds_map_add(m,"You say that because of the sheets in his hand...I guess it's worth a try.","就因为他手里拿着那些纸，你就这么说……？算了，试试也无妨。");
 ds_map_add(m,"Hey do you want something really chingon?.","嘿，想要点真正牛逼的东西吗？");
 ds_map_add(m,"Oh give me a second I'm getting my suit ready.","哦，等一下，我在准备兽装。");
 ds_map_add(m,"You've already convinced me how much it costs!","你已经把我说服了，多少钱！");
 ds_map_add(m,"Would you like to be part of our community?","你愿意加入我们的圈子吗？");
 ds_map_add(m,"Indeed, I am an honorable member of the furry community.","没错，我是兽圈的光荣一员。");
 ds_map_add(m,"Ohmm HI I am Snugglepaws!","唔，你好，我叫绒绒爪！");
 ds_map_add(m,"Thank you very much Mr. Snugglepaws.","非常感谢，绒绒爪先生。");
 ds_map_add(m,"... good, thank you.","……好，谢谢。");
 ds_map_add(m,"Oh Bluebell did you like the suit?","哦，蓝铃，喜欢这套兽装吗？");
 ds_map_add(m,"No, no, no, no, I-I want to hehe sorry for overthinking it.","不不不，我、我愿意。嘿嘿，对不起，想太多了。");
 ds_map_add(m,"If you don't want to, it's okay, lady.","你要是不愿意，也没关系，女士。");
 ds_map_add(m,"Hello Miss, by any chance do you want to use my hole?","你好，小姐，要不要用用我的洞？");
 ds_map_add(m,"I'll do it sir, don't worry. Line now you've gone too far give it some space.","先生，我来吧，别担心。莱茵，这次你过分了，给她留点余地。");
 ds_map_add(m,"Can you tell me how to get the strength of a gorilla please please pleaseeeeee?","能教我怎么获得大猩猩的力量吗？拜托拜托，求求你啦？");
 ds_map_add(m,"... The last time I checked, I was indeed.","……至少上次确认的时候，确实是。");
 ds_map_add(m,"AHHGG! I came to relax on the only island that has no alcohol.","啊——！我来放松一下，结果偏偏挑了唯一没酒的岛。");
 ds_map_add(m,"I-it's not funny, you broke the table with the fight","这、这不好笑，你们打架把桌子弄坏了。");
 ds_map_add(m,"You fight very well, I don't think you're with the weaklings of the empire.","你很能打嘛，看来不是帝国那群窝囊废一伙的。");
 ds_map_add(m,"I still want to accompany you.","我还是想陪着你。");
 ds_map_add(m,"If you don't have time to catch the criminal, we can part ways for a while.","你要是没空追捕罪犯，我们可以暂时分开一阵。");
 ds_map_add(m,"Come back as you were!","变回原样！");
 ds_map_add(m,"I am sorry I have to go to the bathroom :c.","抱歉，我得去趟厕所:c。");
 ds_map_add(m,"Oh ok.. lets go.","哦，好……走吧。");
 ds_map_add(m,"I don't want to waste your time. :c","我不想耽误你的时间:c。");
 ds_map_add(m,"I will rest a little here.","我在这里歇一会儿。");
 ds_map_add(m,"Where is she now?","她现在在哪儿？");
 ds_map_add(m,"Thanks, I came to buy some milk and something covered me in this stuff.","谢谢，我来买牛奶，结果被什么东西弄得满身都是。");
 ds_map_add(m,"Shit somebody help me get this out","妈的，谁来帮我把这东西弄掉。");
 ds_map_add(m,"Shit somebody help me get this out.","妈的，谁来帮我把这东西弄掉。");
 ds_map_add(m,"You beat him ?! Please fight me in a sparring match.","你打败他了？！拜托，跟我切磋一下。");
 ds_map_add(m,"I would like to be stronger to face it again.","我想变强，再去挑战它一次。");
 ds_map_add(m,"*Line blushes* Y-yes probably not hehe.","*莱茵脸红*嗯、嗯，可能不太行，嘿嘿。");
 ds_map_add(m,"I need to practice more but thanks anyway.","我还需要多练练，不过还是谢谢。");
 ds_map_add(m,"hey she's a shy succubus why don't you help her out for old times.","嘿，她是只害羞的魅魔，看在老交情上，帮帮她吧。");
 ds_map_add(m,"Oh so you do know me.","哦，原来你认识我。");
 ds_map_add(m,"He-hello, do I know you from somewhere?","你、你好，我们是不是在哪儿见过？");
 ds_map_add(m,"Oh you don't have enough Arcs.","哦，你的阿克不够。");
 ds_map_add(m,"Well to start heating things up we'll play a little game.","那就先玩个小游戏，热热身。");
 ds_map_add(m,"You left me alone and naked in bed, and the maid also saw me ;C.","你把我光着身子一个人留在床上，还被女佣看见了;C。");
 ds_map_add(m,"Hey, what are you doing here? This is not a place for children.","喂，你来这里干什么？这里可不是小孩子该来的地方。");
 ds_map_add(m,"After this I hope you rectify what you said.","这之后，希望你会收回刚才的话。");
 ds_map_add(m,"Oh sorry I heard as I passing by.","哦，抱歉，我路过时听见了。");
 ds_map_add(m,"Coming to this island was a bad idea.","来这座岛，真是个坏主意。");
 ds_map_add(m,"I'm sorry for making a fight, it was wrong.","抱歉，我不该跟人打架。");
 ds_map_add(m,"I'm so sorry for what my fairy said.","我的妖精说了那些话，实在对不起。");
 ds_map_add(m,"Oh poor little thing it's ok if it's true I will help you.","哦，小可怜，没关系。如果是真的，我会帮你的。");
 ds_map_add(m,"Fuck it Line is fight or nothing!","管他呢，莱茵，要么打，要么没得谈！");
 ds_map_add(m,"I'm sorry but you have to disappear or pay your bill as a member.","抱歉，要么消失，要么作为会员，把账付清。");
 ds_map_add(m,"Um, yeah, it is okay,","嗯，是啊，没关系。");
 ds_map_add(m,"But your story still seems strange...","可你的故事，听起来还是有点奇怪……");
 ds_map_add(m,"Very well, I appreciate you staying safe.","很好，谢谢你平安回来。");
 ds_map_add(m,"I think I'm familiar with your description, we'll stay out of it <3","你描述的情况，我好像有点印象。我们会避开的<3。");
 ds_map_add(m,"... and which places should we not go to stay out of the way :v?","……那我们要去哪些地方，才能不碍事呢:v？");
 ds_map_add(m,"We are at the limit because of the increase in crime on the islands.","岛上的犯罪活动激增，我们已经忙到极限了。");
 ds_map_add(m,"I see a lot of people a day, so I couldn't tell you that I did see her.","我每天见到那么多人，可说不准有没有见过她。");
 ds_map_add(m,"Yes, apparently there is something on the outskirts of town.","是啊，镇子外围好像出了什么情况。");
 ds_map_add(m,"No drinks.. no courage.","没酒……就没胆。");
 ds_map_add(m,"Life makes sense again <3 !!","人生又有意义了<3！！");
 ds_map_add(m,"Finally Beer!!!!","终于有啤酒了！！！！");
 ds_map_add(m,"yes unfortunately, that's why I must hurry","很遗憾，是的，所以我得抓紧。");
 ds_map_add(m,"Please, can you go see how the miners are, I would go but I'm very tired.","拜托，能去看看矿工们怎么样了吗？我本来该自己去，可实在太累了。");
 ds_map_add(m,"Sorry Miss the pass to the forest is closed.","抱歉，小姐，通往森林的路已经封锁。");
 ds_map_add(m,"I'll stay here guarding.","我留在这里守着。");
 ds_map_add(m,"I will rest here a little.","我在这里稍微歇会儿。");
 ds_map_add(m,"I will go see maybe we will find something.","我去看看，说不定能发现什么。");
 ds_map_add(m,"Let's look for the guard who was left unconscious.","我们去找那个被打晕的卫兵吧。");
 ds_map_add(m,"Mama I swear I didn't it was a blue cat.","妈妈，我发誓不是我，是只蓝猫。");
 ds_map_add(m,"One of her daughter's pranks left one of the guards unconscious.","她女儿的一次恶作剧，把一名卫兵弄昏了。");
 ds_map_add(m,"Now leave if you are not going to buy something.","不买东西，就请离开。");
 ds_map_add(m,"Mom!! are you listening to me? ;c Mom!!!.","妈妈！！你在听吗？;c妈妈！！！");
 ds_map_add(m,"leave my mommy alone.","别欺负我妈妈。");
 ds_map_add(m,"Come on miss, accompany me to jail-farm.","来吧，小姐，跟我去监狱农场。");
 ds_map_add(m,"I don't care, it's was worthed.","我不在乎，值了。");
 ds_map_add(m,"Of course they are innocent, children cover your ears.","她们当然无辜。孩子们，捂上耳朵。");
 ds_map_add(m,"Really? It seems her daughters were innocent after all.","真的？看来她的女儿们确实是无辜的。");
 ds_map_add(m,"Emmm. yes .. but there is something I didn't tell you.","呃，嗯……不过，有件事我没告诉你。");
 ds_map_add(m,"Select the 'natural' option.","选择“天然”选项。");
 ds_map_add(m,"You have to go to the menu press enter.","得先打开菜单，按回车键。");
 ds_map_add(m,"What the hell! those prices.","什么鬼！这价格！");
 ds_map_add(m,"Oh, I almost forgot, give these pamphlets to the people.","哦，差点忘了，把这些传单发给大家。");
 ds_map_add(m,"Hi, can you give me a little of your time? I'm looking for a friend.","你好，能耽误你一点时间吗？我在找一个朋友。");
 ds_map_add(m,"You can see the place while we prepare all.","我们准备的时候，你可以先四处看看。");
 ds_map_add(m,"I'm good , and thank for the information and the other thing hehe.","我很好，也谢谢你的消息，还有另外那件事，嘿嘿。");
 ds_map_add(m,"welcome to the green hills hotel at the moment we do not have rooms available","欢迎来到青丘旅馆，目前没有空房。");
 ds_map_add(m,"I will sell it and be free again.","我会把它卖掉，重新获得自由。");
 ds_map_add(m,"But your love, you can take it right here.","不过，你的爱意，可以就在这里给我。");
 ds_map_add(m,"Bye I have to go","再见，我得走了。");
 ds_map_add(m,"Wait do you know who did this to you?","等等，你知道是谁把你弄成这样的吗？");
 ds_map_add(m,"Thanks I have to go.","谢谢，我得走了。");
 ds_map_add(m,"yeah she went to the cultivation of nana leaves.","对，她去种娜娜叶的地方了。");
 ds_map_add(m,"Oh I just got to the town but if I see it I'll let you know <3.","哦，我刚到镇上，不过看见的话，会告诉你的<3。");
 ds_map_add(m,"Hey you look like you need money.","喂，你看起来很缺钱。");
 ds_map_add(m,"No, sorry you will have the money later.","抱歉，还不行，钱以后再给你。");
 ds_map_add(m,"You are going to give my money back?","你是来还钱的？");
 ds_map_add(m,"Ok I even liked hehe.","好啊，我还挺喜欢的，嘿嘿。");
 ds_map_add(m,"That's true, especially someone like Line she is a freak.","那倒是真的，尤其莱茵这种怪胎。");
 ds_map_add(m,"It seems you like to see our cows.","看来，你很喜欢看我们的奶牛。");
 ds_map_add(m,"Mmm looking for the purity of a rabbit and how to replicate it?","嗯，在研究兔子的纯洁，以及如何复制这种纯洁？");
 ds_map_add(m,"I love that you liked it.","你喜欢，我很开心。");
 ds_map_add(m,"Oh sure, I've never eaten that kind of food before but it looks delicious.","哦，当然。我以前没吃过这种食物，不过看起来很好吃。");
 ds_map_add(m,"Thank you, to get to the library just follow this road to the west of town.","谢谢，去图书馆的话，沿着这条路，一直往镇子西边走就行。");
 ds_map_add(m,"Oh, why what happened?","哦，怎么了，出了什么事？");
 ds_map_add(m,"You find anything yet?","找到什么了吗？");
 ds_map_add(m,"I will have to show you what I want to save you from","我得让你看看，我究竟想救你远离什么。");
 ds_map_add(m,"calm Line let me continue with this and everything will be solved","冷静，莱茵，让我继续，一切都会解决的。");
 ds_map_add(m,"Line, I do this for you please understand me","莱茵，我都是为了你，请理解我。");
 ds_map_add(m,"Unfortunately we ran out of alcohol a little while ago.","很遗憾，酒刚刚卖完了。");
 ds_map_add(m,"Thanks but it's not necessary.","谢谢，不过不用了。");
 ds_map_add(m,"Hey wait you are the adventurer who defeated the demon that stole alcohol?","嘿，等等，你就是打败那个偷酒恶魔的冒险者？");
 ds_map_add(m,"When the river sounds.","无风不起浪。");
 ds_map_add(m,"Say the secret Password.","说出秘密口令。");
 ds_map_add(m,"We have to tell Kristoff there are no premium cigarettes on this island.","得告诉克里斯托夫，这座岛上没有高级香烟。");
 ds_map_add(m,"Oh I've never done it to someone but I think I can do it.","哦，以前没给别人做过，不过，我应该可以。");
 ds_map_add(m,"I knew with the money you spent coming to see me I knew you were a vip!","我就知道！看你为见我花了那么多钱，我就知道你是贵宾！");
 ds_map_add(m,"Lili stop joking you do not stand a chance.","莉莉，别开玩笑了，你根本没机会赢。");
 ds_map_add(m,"Ahhh Lili shut up already! I mean she might be sick from the swamp.","啊，莉莉，闭嘴啦！我是说，她可能是在沼泽里染上了病。");
 ds_map_add(m,"No thanks, we're just passing by.","不用，谢谢，我们只是路过。");
 ds_map_add(m,"Of course not  I mean somewhere else no here i not a weirdo :S.","当然不是！我是说，在别的地方，不在这里，我又不是什么怪人:S。");
 ds_map_add(m,"LiLi! do not say that ;c.","莉莉！别这么说;c。");
 ds_map_add(m,"Well you heard it Line take off those boots and show those stinky feet.","听见了吧，莱茵，脱掉靴子，让他看看你那双臭脚。");
 ds_map_add(m,"It wasn't that bad don't worry.","也没那么糟，别担心。");
 ds_map_add(m,"Wait she is a half succubus?","等等，她是半魅魔？");
 ds_map_add(m,"Hi dude, I'm Lili and thats my partner Line she is half succubus.","嘿，老兄，我叫莉莉，这是我的搭档莱茵，她是半魅魔。");
 ds_map_add(m,"You are the best Lili <3 and I hope you can talk to me like that more often.","莉莉，你最好了<3。希望你以后也能经常这么跟我说话。");
 ds_map_add(m,"Wow you must be thirsty just doing a footjob you took away all his energy.","哇，你一定很渴吧，光用脚，就把他的能量全吸走了。");
 ds_map_add(m,"Yeah that great Line now give us the fish.","对，真棒，莱茵，现在把鱼给我们。");
 ds_map_add(m,"OHh it's ok if I can come and go. <3","哦，能随时来去，那就没问题<3。");
 ds_map_add(m,"And why would she do that?","她为什么要这么做？");
 ds_map_add(m,"Hey hey wait a minute big boy.","嘿嘿，等一等，大家伙。");
 ds_map_add(m,"They promised for the best sloppy blowjob and gave me a regular and dry one.","明明说好，要给我最棒、最湿滑的口交，结果给的就是普通干巴巴的那种。");
 ds_map_add(m,"No, wait! Let's not start a fight, let's call Sieki!","不，等等！别打架，叫茜姬来吧！");
 ds_map_add(m,"Silence, puta, now go away before I break your face.","闭嘴，婊子，不想被我打烂脸，就滚。");
 ds_map_add(m,"Oh, I was curious about the portals, they were not there before.","哦，我对这些传送门挺好奇的，以前这里没有。");
 ds_map_add(m,"This will help me to destress.","这能帮我减减压。");
 ds_map_add(m,"I bow to you The Bitch.","向您俯首，婊子女王。");
 ds_map_add(m,"Time to go feral!","该撒野了！");
 ds_map_add(m,"Hey softy, are you coming to the battle royal?.","喂，小软蛋，来参加大乱斗吗？");
 ds_map_add(m,"beep beep bop boop.","哔哔，啵，哔啵。");
 ds_map_add(m,"You, You are Perfect!","你，你简直完美！");
 ds_map_add(m,"Analyze... I must analyze.","分析……我必须分析。");
 ds_map_add(m,"Hey ou wat a niht witis papa bar.","嘿，想不想跟熊爸爸共度一晚？");
 ds_map_add(m,"Oh, w-well y-yeah I would like to go.","哦，那、那个，我、我愿意去。");
 ds_map_add(m,"I guess you caught my attention too.","看来，你也引起了我的注意。");
 ds_map_add(m,"AHhh! a-am I that obvious?","啊！我、我表现得有那么明显吗？");
 ds_map_add(m,"Hehe I noticed you've been watching me for quite a while.","嘿嘿，我注意到，你已经盯着我看了很久。");
 ds_map_add(m,"It's not fucking funny.","一点都他妈不好笑。");
 ds_map_add(m,"Na I am kidding hahah <3.","没啦，我开玩笑的，哈哈<3。");
 ds_map_add(m,"I Buy the game leave me alone. *shows you the middle finger*","游戏我买了，别烦我。*朝你竖起中指*");
 ds_map_add(m,"Ah you wonder what are those npc with question mark on the head?","啊，你想知道，那些头顶有问号的NPC是怎么回事？");
 ds_map_add(m,"Give him this face mask or use it yourself if you want.","把这个口罩给他，你想自己用也行。");
 ds_map_add(m,"Shit you're slow, kick his ass she wants to waste our time.","妈的，你反应也太慢了，揍她！她就是想浪费我们时间。");
 ds_map_add(m,"Thanks for nothing idiot, now get out of the way we're in a rush.","真是白谢你了，蠢货。赶紧让开，我们赶时间。");
 ds_map_add(m,"Please, I just want to see my friend.","求你了，我只是想见见我的朋友。");
 ds_map_add(m,"Please Line, just go, do this for me.","莱茵，求你了，离开吧，就当为了我。");
