 ds_map_add(m,"We refill the jars with leftover semen that falls on the floor.","我们会把掉在地上的多余精液，重新装进罐子里。");
 ds_map_add(m,"Stop eating junk food, that semen doesn't look healthy.","少吃点垃圾食品，那精液看起来，不太健康。");
 ds_map_add(m,"Wow that elf even gets naked when she fights.","哇，那个精灵，打架都要脱衣服。");
 ds_map_add(m,"Ok for my magic trick I need you Line really steal and say, haigure!","好，为了我的魔术，莱茵，你得站好别动，然后喊“海格雷”！");
 ds_map_add(m,"Lili tells Mshonney everything behind Line's back.","莉莉背着莱茵，把一切都告诉了霍妮女士。");
 ds_map_add(m,"Sorry, I don't believe you, that elf response you a lot to be your slave.","抱歉，我不信。那个精灵那么爱顶嘴，哪像你的奴隶。");
 ds_map_add(m,"Just do it, it will be great for you, trust me..","做就对了，你会很舒服，相信我……");
 ds_map_add(m,"Oh my god Lili, you are incorrigible! I do not know if I can forgive you.","天啊，莉莉，你真是无可救药！我都不知道，能不能原谅你。");
 ds_map_add(m,"Cuervo, are you working as a clown in the circus?","奎尔沃，你在马戏团当小丑？");
 ds_map_add(m,"I-I really trust you won't tell anyone, my hero.","我、我相信，你不会告诉任何人的，我的英雄。");
 ds_map_add(m,"What, what money I do not understand when I gave money to you?","什么，什么钱，我不明白，我什么时候给过你钱？");
 ds_map_add(m,"Oh, Line about the money.","哦，莱茵，关于那笔钱……");
 ds_map_add(m,"Oh so-sorry sorry.","哦，对、对不起，对不起。");
 ds_map_add(m,"Hey don't get in the line!","喂，别插队！");
 ds_map_add(m,"Mmm what happend?","嗯，发生什么了？");
 ds_map_add(m,"It does not appear to be in operation there is a mess inside.","好像没有营业，里面乱糟糟的。");
 ds_map_add(m,"Mmmm it's closed but I hear music coming from inside.","嗯，关着门，可我听见，里面有音乐。");
 ds_map_add(m,"Hey what's wrong with you! Line although it does not seem is quite strong.","喂，你怎么回事！别看莱茵这样，她其实很强。");
 ds_map_add(m,"Hey this is a private conversation!","喂，这是私人谈话！");
 ds_map_add(m,"Yeah easy, don't worry Tamara.","嗯，轻松点，别担心，塔玛拉。");
 ds_map_add(m,"Lili calm down it's not a big deal.","莉莉，冷静点，没什么大不了。");
 ds_map_add(m,"Hey wait! How do yo pay her and we do it for free?","喂，等等！为什么给她付钱，我们却得白干？");
 ds_map_add(m,"But I need someone to accompany her since she is some what explosive.","可我得找个人陪着她，她脾气有点火爆。");
 ds_map_add(m,"Something happens great captain?","伟大的队长，出什么事了吗？");
 ds_map_add(m,"Although you will have to put a muzzle on your fairy.","不过，你得先给妖精戴个嘴套。");
 ds_map_add(m,"Lili stop being so angry!","莉莉，别这么生气了！");
