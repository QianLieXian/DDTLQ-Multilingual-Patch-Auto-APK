 ds_map_add(m,"A well ... Bye ....                                            I'm your fan :v.","啊，好吧……再见……                                            我是你的粉丝:v。");
 ds_map_add(m,"You are welcome, because I am Line your Heroine of trust :D.","不客气，因为我是莱茵，你值得信赖的女英雄:D。");
 ds_map_add(m,"Futaba stands back in horror at the act she is witnessing.","双叶看着眼前这一幕，惊恐地退了开。");
 ds_map_add(m,"What do you ask if I'm famous you don't know who you're talking to?!","问我出不出名？你不知道，自己在跟谁说话？！");
 ds_map_add(m,"Shit, you're so strong!","妈的，你好强！");
 ds_map_add(m,"I thought it was something small but now I see that y'all are parasites!","本来还以为，是点小事，现在才发现，你们全是寄生虫！");
 ds_map_add(m,"Listen everybody!","所有人，听好了！");
 ds_map_add(m,"Oh my god, Line look at that they are doing the helicopter!","天啊，莱茵，快看，她们在甩直升机！");
 ds_map_add(m,"Oh god, YES I am going, I am coming!","哦，天啊，对，要去了，要来了！");
 ds_map_add(m,"You just enjoy and practice your doggie swim.","你好好享受，练你的狗刨就行。");
 ds_map_add(m,"I love it I hope you can stand this.","我很喜欢，希望你撑得住。");
