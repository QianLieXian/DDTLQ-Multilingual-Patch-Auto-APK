 ds_map_add(m,"Shit, you're not a guard!","妈的，你根本不是卫兵！");
 ds_map_add(m,"Do you really think that I would let go without paying?","你真以为，不付钱就能走？");
 ds_map_add(m,"I do not know, I feel very hot.","不知道，我感觉好热。");
 ds_map_add(m,"Oh .. Lili I do-do not feel good.","哦……莉莉，我、我不舒服。");
 ds_map_add(m,"We have a base where you can hide, but at least free Lili.","我们有个基地，可以让你藏身，但至少，先放了莉莉。");
 ds_map_add(m,"Uhh I see you finished how about a second round.","哦，看来你结束了，要不要再来一轮？");
 ds_map_add(m,"Thank you all so much for listening <3.","谢谢大家，愿意听我说<3。");
