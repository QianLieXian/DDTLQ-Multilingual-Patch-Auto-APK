 ds_map_add(m,"Look at the sea serpent, it is so cute! <3","看那条海蛇，好可爱<3！");
 ds_map_add(m,"Lili, did I wake up before you?","莉莉，我居然醒得比你早？");
 ds_map_add(m,"Hey you cannot pass without paying the toll.","喂，没交过路费，不能过去。");
