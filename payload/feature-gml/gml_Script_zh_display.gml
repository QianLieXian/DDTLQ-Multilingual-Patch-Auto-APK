 ds_map_add(m,"Lili, I need a coat, like right right now.","莉莉，我需要一件大衣，马上，现在就要。");
 ds_map_add(m,"OH no, please Line, NO!","哦，不，求你了，莱茵，不要！");
 ds_map_add(m,"Uff thats my signal.","呼，该我上场了。");
 ds_map_add(m,"That's all I'll call the guards","够了，我要叫卫兵了。");
