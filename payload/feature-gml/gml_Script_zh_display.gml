 ds_map_add(m,"MOOO! - MOOO! Nghgh - MOOOooo~ ","哞——！－哞——！嗯啊－哞~ ");
 ds_map_add(m,"MOOO! - MOOOooo~ ngh...","哞——！－哞~嗯……");
 ds_map_add(m,"Uuughh.. m-moo... mo-Nghh!~ Mooo-mooo","呜嗯……哞、哞……哞——嗯啊！~哞，哞。");
 ds_map_add(m,"H-hngh!!... Dammit-ahh~ How did it come to this?!","嗯、嗯啊！！……可恶，啊~怎么会变成这样？！");
 ds_map_add(m,"Are you listening?!.","听见没有？！");
 ds_map_add(m,"I think our little friend has not made her daily milk quota.","看来，我们的小朋友还没完成今天的产奶指标。");
 ds_map_add(m,"Ohh of course we will go to see her haha.","哦，当然会去看她，哈哈。");
 ds_map_add(m,"Where is the reward?","奖励在哪儿？");
 ds_map_add(m,"In a way I'm here because I want hu-hu-hu.","某种程度上，我是自愿待在这儿的，呵、呵呵。");
 ds_map_add(m,"Hey I have a question, why are you talking shouldn't you say moo?","喂，想问一下，你为什么还在说话，不是该哞哞叫吗？");
 ds_map_add(m,"Uh.. hello, do you... enjoy the place? I mean ... hello :c.","呃……你好，这里……还喜欢吗？我是说……你好:c。");
 ds_map_add(m,"Looking at the bright side they let you keep the puppet.","往好处想，至少让你留下了那个玩偶。");
 ds_map_add(m,"Is this a reference?.","这是在玩什么梗？");
 ds_map_add(m,"It seems serious, we better escape.","好像很严重，还是逃吧。");
 ds_map_add(m,"Hey now you have your mother's long tongue when you are completely aroused.","喂，彻底发情时，你也有你妈妈那条长舌头了。");
 ds_map_add(m,"Stop thinking with your horn we have to go back.","别再用你的角思考了，我们得回去。");
 ds_map_add(m,"She escaped I stayed here taking care of you.","她逃了，我留在这里照顾你。");
 ds_map_add(m,"Where did the lady cat go?","猫女去哪儿了？");
 ds_map_add(m,"In the meantime you can enjoy the activities the island has to offer.","这期间，可以体验一下岛上的各种活动。");
 ds_map_add(m,"I do Sam :D, it is east of town, passing the bridge of lovers.","我知道，萨姆:D，在镇子东边，过了情人桥就到。");
 ds_map_add(m,"Don't worry Lili, it happens to me often and in fact it flatters me.","别担心，莉莉，经常遇到这种事，其实还挺受用。");
 ds_map_add(m,"Yeah Sam we can handle it all <3 .","没错，萨姆，我们什么都能应付<3。");
 ds_map_add(m,"Please help me, don't let her take the crystal.","求你帮帮我，别让她拿走水晶。");
 ds_map_add(m,"For now we block the exit until the guards arrive.","先把出口堵住，等守卫过来。");
 ds_map_add(m,"Wait do you come from another dimension?","等等，你从另一个次元来的？");
 ds_map_add(m,"That crystal is really a dimensional rift and my only way to get back home.","那块水晶，实际上是次元裂隙，也是我回家的唯一途径。");
 ds_map_add(m,"Oh sorry I will go take it now.","哦，对不起，现在就去拿。");
 ds_map_add(m,"Ahhhh you are right let's do it.","啊，你说得对，动手吧。");
 ds_map_add(m,"Hey you people, what are you doing!","喂，你们，在干什么！");
 ds_map_add(m,"What do we do then?","那怎么办？");
 ds_map_add(m,"Wait Line Do not take it out of the box just move it.","等等，莱茵，别从盒子里拿出来，挪一下就好。");
 ds_map_add(m,"Ah shut up the act is over.","啊，闭嘴，戏演完了。");
 ds_map_add(m,"Mmmhemm hemmmMmmm.","嗯哼，嗯嗯嗯……");
 ds_map_add(m,"Well, it is out of order anyway.","反正也坏了，不能用。");
 ds_map_add(m,"I cannot get in here, it is the men's room.","不能进去，这是男厕所。");
 ds_map_add(m,"Not anymore, Line owes me.","现在可不是了，莱茵欠我的。");
 ds_map_add(m,"Oh that's a bit aggressive.","哦，这有点凶啊。");
 ds_map_add(m,"Ahhh fuck you, I'll make my own secret club with gambling and pachinko!","啊，去你的！我自己开秘密俱乐部，赌场、柏青哥，一个都不少！");
 ds_map_add(m,"Please, get out of my head. I do not want to hear anymore.","求你，从我脑子里出去，不想再听了。");
 ds_map_add(m,"Line, are you okay?!","莱茵，你没事吧？！");
 ds_map_add(m,"Ah!? Why do I hear you in my head?","啊！？为什么脑子里有你的声音？");
 ds_map_add(m,"Hello, I'm Veritus and I can answer any question!","你好，我叫维里图斯，什么问题都能回答！");
 ds_map_add(m,"It sticking out its little tongue, it is so adorable! <3","它在吐小舌头，太可爱了！<3");
 ds_map_add(m,"I'll keep your fairy, it will sell very well on the black market.","这只仙子我留下了，黑市上能卖个好价钱。");
 ds_map_add(m,"But it seems you wanted it to come to this.","不过看来，是你非要走到这一步。");
 ds_map_add(m,"Ple-please do not take Lili, we have a base you can hide.","求、求你，别带走莉莉，我们有个据点，能让你藏身。");
 ds_map_add(m,"Oh.. there is nothing to be thankful for.","哦……没什么好谢的。");
 ds_map_add(m,"But calm down if you lick the sweat you can pass your humiliation faster.","不过别急，舔掉这些汗，就能快点熬过这场羞辱。");
 ds_map_add(m,"What the hell AHHHH.","什么鬼，啊啊啊！");
 ds_map_add(m,"Yes! and I will take out all the wanted posters for the liberation of Line.","好！我会撕掉所有通缉海报，还莱茵自由。");
 ds_map_add(m,"I know that you are the person who is in the wanted posters.","我知道，你就是通缉海报上的人。");
 ds_map_add(m,"I think this experience has just awakened something inside me, something bad.","这番经历，好像刚唤醒了我心里的什么东西，不是什么好东西。");
 ds_map_add(m,"Fuck no you weirdo.","才他妈不要，你这个怪人。");
 ds_map_add(m,":O Lili she squirt in front of us!",":O莉莉，她当着我们面潮吹了！");
 ds_map_add(m,"Yes you, the one with blue hair!","对，就是你，蓝头发的那个！");
 ds_map_add(m,"I've never done this you dirty pervert! Now go do what you came here to do!","从没做过这种事，你这个肮脏变态！现在，赶紧办你该办的事去！");
 ds_map_add(m,"But I need someone to come, what do I do then?","可我需要有人来，那该怎么办？");
 ds_map_add(m,"B-but Lili I really need you :c.","可、可是莉莉，我真的需要你:c。");
 ds_map_add(m,"I worry about you sometimes Line.","有时候，真替你担心，莱茵。");
 ds_map_add(m,"yes, although she pulls my hair in a way that I don't like :c.","嗯，不过她扯我头发的方式，我不喜欢:c。");
 ds_map_add(m,"Ehh you better hide you made a lot of noise the guards are coming!","呃，快躲起来，动静太大，守卫要来了！");
 ds_map_add(m,"Me? I am not doing anything, I swear.","我？什么都没做，发誓。");
 ds_map_add(m,"Yeah what she said, you will not kidnap anyone while we are here.","对，就像她说的，只要我们在，谁也别想绑架别人。");
 ds_map_add(m,"At least can we accompany you to the entrance of the town?","至少，让我们陪你走到镇子入口吧？");
 ds_map_add(m,"We made it Sam now that we caught the criminal, but now what will you do?","做到了，萨姆，罪犯已经抓住，接下来你要怎么办？");
 ds_map_add(m,"Yes, there will be no ABC Daycare here on the island!","是啊，不会让岛上再发生ABC托儿所那种事！");
 ds_map_add(m,"Game over Elena we already beat you, you can't escape.","结束了，埃莱娜，我们已经赢了，你逃不掉。");
 ds_map_add(m,"Thank you Line, with you helping my I know can get back home.","谢谢你，莱茵，有你帮忙，相信一定能回家。");
 ds_map_add(m,"Please, I have family my children await my return.","求你了，我还有家人，孩子们都等着我回去。");
 ds_map_add(m,"Vasuki do you feel good?","瓦苏基，感觉还好吗？");
 ds_map_add(m,"Oh sorry Lili thank you so much to you too.","哦，对不起，莉莉，也非常感谢你。");
 ds_map_add(m,"Someone must have hidden this path for some reason, maybe the flower is there.","有人藏起这条路，肯定有原因，说不定花就在里面。");
 ds_map_add(m,"I do not want to go through all these plants.","不想穿过这些植物。");
 ds_map_add(m,"Thanks for playing! come and get your Arcs.","感谢参与！过来领阿克吧。");
 ds_map_add(m,"The prize for winning is 100 Arcs.","获胜的奖品是100阿克。");
 ds_map_add(m,"A proud half succubus!","一个骄傲的半魅魔！");
 ds_map_add(m,"She is a proud half succubus!","她是个骄傲的半魅魔！");
 ds_map_add(m,"Keep the money, I have to go now.","钱你留着，我得走了。");
 ds_map_add(m,"WHAT ONlY 10 Arcs!? I'm GOING TO KILL YOU DROGITAS!","什么，只有10阿克！？毒虫，我要杀了你！");
 ds_map_add(m,"Explain yourself fairy!!","给我解释清楚，仙子！！");
 ds_map_add(m,"Ohh .. okay but be nice please.","哦……好吧，不过请温柔点。");
 ds_map_add(m,"So you prefer that they make a fool of themselves when buying the boat?","所以，你宁愿他们买船的时候出丑？");
 ds_map_add(m,"Finally we can start our adventure once and for all.","终于能正式开始冒险了。");
 ds_map_add(m,"I don't think she was a virgin, Lili.","我觉得她不是处女，莉莉。");
 ds_map_add(m,"New onahole offer at 30 arcs take advantage now that it is still virgin!","新款肉便器，只要30阿克，趁还没开苞，赶快享用！");
 ds_map_add(m,"Today we have 2 one of a kind onaholes give a warm welcome to Line!","今天有两位独一无二的肉便器，热烈欢迎莱茵！");
 ds_map_add(m,"Something wrong, Line?","怎么了，莱茵？");
 ds_map_add(m,"And their dental benefit as well.","还有她们的牙科福利。");
 ds_map_add(m,"You finally wake up Line..","莱茵，你总算醒了……");
 ds_map_add(m,"What you need from me?","要我做什么？");
 ds_map_add(m,"Oh well let us just say he finally found another way to make people laugh hehe.","哦，就说他终于找到了另一种逗人发笑的方式吧，嘿嘿。");
 ds_map_add(m,"Yeah I see you're her type, dumb and pretending to be incocente.","嗯，看得出来，你就是她喜欢的类型，蠢，还装无辜。");
 ds_map_add(m,"Wait, are you here because of MsHonney?","等等，是蜜糖女士让你来的？");
 ds_map_add(m,"Damn, look what that crazy bee got us into!","妈的，瞧那只疯蜜蜂，把我们害成什么样了！");
 ds_map_add(m,"Of course don't worry. <3","当然，放心吧。<3");
 ds_map_add(m,"Bu-but you do not want to do what my friend needs.","可、可你又不愿意，做我朋友需要的事。");
 ds_map_add(m,"What a unpleasant human.","真是个讨厌的人类。");
 ds_map_add(m,"*blushing* Hehe and with your description I already want it to start. ","*脸红*嘿嘿，听你这么形容，已经等不及了。 ");
 ds_map_add(m,"I will go right now to write thank you Lili thank you Line!","现在就去写，谢谢，莉莉！谢谢，莱茵！");
 ds_map_add(m,"Get ready here they come get serious.","做好准备，他们来了，认真点。");
 ds_map_add(m,"*Line opens table drawer* MMmm is full of fruits :v.","*莱茵拉开桌子的抽屉*嗯，里面全是水果:v。");
 ds_map_add(m,"Mmm... I think it was something work-related.","嗯……好像是跟工作有关。");
 ds_map_add(m,"Y'ALL SAW NOTHING... let's get out of here!","你们什么都没看见……快走！");
 ds_map_add(m,"Denada <3 every cc of Cum counts <3 thank you so much for using me.","不客气<3，每一毫升精液都很重要<3，谢谢你尽情使用我。");
 ds_map_add(m,"Let me get comfortable.","先让我换个舒服的姿势。");
 ds_map_add(m,"How does she know my full name D:?!","她怎么知道我的全名D:？！");
 ds_map_add(m,"... let's go home.","……回家吧。");
 ds_map_add(m,"Shit! say who fucking won!","妈的！赶紧说，他妈到底谁赢了！");
 ds_map_add(m,"Thank you very much for waiting, now we will reveal the winner.","感谢各位耐心等候，现在公布获胜者。");
 ds_map_add(m,"Mmmm can you give me a few minutes to decide?","嗯，能给我几分钟，考虑一下吗？");
 ds_map_add(m,"Ahgg, well it's okay to give it to another-","啊，好吧，那给另一个也行——");
 ds_map_add(m,"But Lili, that is for a succubus who really needs it!","可是莉莉，那是给真正需要它的魅魔的！");
 ds_map_add(m,"AGHHH, that fucking disgusting why do you do that?!","啊！他妈恶心死了，为什么要这样？！");
 ds_map_add(m,"... you can take the jar with you, it's full to the brim.","……可以把罐子带走，已经装得满满的了。");
 ds_map_add(m,"Wow seriously Lili? I can't wait to see it <3.","哇，真的，莉莉？已经等不及想看了<3。");
 ds_map_add(m,"Oh thanks <3, now what?","哦，谢谢<3，接下来呢？");
 ds_map_add(m,"Well did you get what you wanted?","怎么样，得到你想要的了吗？");
 ds_map_add(m,"Word contracts also work, here you have just point and shoot.","口头契约也有效，给你，瞄准，开枪就行。");
 ds_map_add(m,"Well, if she's not my slave why does she fight for me?","要是她不是我的奴隶，为什么替我打架？");
 ds_map_add(m,"Now, tell me what you sell.","现在说说，你卖什么。");
 ds_map_add(m,"Line sit on that chair now!","莱茵，立刻坐到那张椅子上！");
 ds_map_add(m,"Come for the laser beam, who is the dominant?","来拿激光的？谁是支配者？");
 ds_map_add(m,"You saying it like you didn't like itt, you Little bitch <3.","说得好像你不喜欢似的，小婊子<3。");
 ds_map_add(m,"Do not worry, life rewards those who work hard <3","别担心，肯努力的人，生活总会回报的<3。");
 ds_map_add(m,"At least you got an honorable job <3","至少，找到了一份体面的工作<3。");
 ds_map_add(m,"Haha you're absolutely right, when did that happen? Haha..ha.","哈哈，说得完全对，那什么时候的事？哈哈……哈。");
 ds_map_add(m,"Again, do you think he will be there?","再去一次？你觉得他会在吗？");
 ds_map_add(m,"Are we going to watch the secret show tonight, right?","今晚，去看那场秘密演出，对吧？");
 ds_map_add(m,"I love this vacation <3.","这个假期，太棒了<3。");
 ds_map_add(m,"I wi-will look for your friend right now .. mommy.","现、现在就去找你的朋友……妈妈。");
 ds_map_add(m,"Lili do not be mean!","莉莉，别欺负人！");
 ds_map_add(m,"Hey, we're busy, what do you want ?!","喂，忙着呢，想干什么？！");
 ds_map_add(m,"Oh.. well I do not really know if I be-beat her at all.","哦……其实，也不知道算不算打败她了。");
 ds_map_add(m,"We don't need a weakling like you now go.","我们不需要你这种弱者，现在就走。");
 ds_map_add(m,"Oh I am so-sorry but I think I can help.","哦，对、对不起，不过我想，能帮得上忙。");
 ds_map_add(m,"..... go do the mission Alura.","……去执行任务，阿露拉。");
 ds_map_add(m,"Find out what makes the guards leave their posts and fix it.","查清守卫为什么擅离职守，解决这个问题。");
 ds_map_add(m,"Ehh .. of course I will help.","呃……当然，愿意帮忙。");
 ds_map_add(m,"Geez Tamarara I am a mercenary let me be.","真是的，塔玛拉，我是佣兵，别管着我。");
 ds_map_add(m,"We have a problem it seems that the guards leave their positions in the day.","有个问题，守卫们好像白天会离岗。");
 ds_map_add(m,"And Lili stops being a complete lunatic.","还有莉莉，别再跟个疯子一样了。");
 ds_map_add(m,"Ok both of you stop, Alura you do have messy hair.","好了，都停下。阿露拉，你头发确实乱。");
 ds_map_add(m,"Thanks I will do my best","谢谢，会尽力的。");
 ds_map_add(m,"Oh your Liying bitch!","哦，你这个撒谎的婊子！");
 ds_map_add(m,"You see we are strong!","看吧，我们很强！");
 ds_map_add(m,"Hi how do you do, fellow guard.","嗨，过得怎么样，守卫同僚。");
 ds_map_add(m,"It was already inside, I managed to get it out, but it wants to get back in.","它已经钻进去了，费劲才弄出来，结果它又想钻回去。");
 ds_map_add(m,"Lili is attacking right now!","莉莉现在就在攻击！");
 ds_map_add(m,"Hand over all your money to the man to try to suck his dick.","把所有钱交给那男人，试着求他，让你吸他的屌。");
 ds_map_add(m,"WHAT I don't have that kind of money please don't do this to me!","什么？！没那么多钱，求求你，别这样对我！");
 ds_map_add(m,"I'm so full of semen and I'm going to explode at any moment.","身体里全是精液，随时都要爆开了。");
 ds_map_add(m,"Oh, I am really sorry.","哦，真的很抱歉。");
 ds_map_add(m,"I-I just wanted to see if nothing wrong is happening here.","我、我只是想确认，这里没出什么事。");
 ds_map_add(m,"Why do you talk like that, you are not going to leave, right?","为什么说这种话，你不会走的，对不对？");
 ds_map_add(m,"This dirty old man could be...","这个脏老头，说不定就是……");
 ds_map_add(m,"I am getting so wet again.","又湿得不行了。");
 ds_map_add(m,"*closes eyes* Its incredible.","*闭上眼睛*不可思议。");
 ds_map_add(m,"I wish I were just an elf.","真希望自己只是个精灵。");
 ds_map_add(m,"Lili is an angel, she is always there for me.","莉莉是天使，总在我需要的时候陪着。");
 ds_map_add(m,"It was truly a heroic act to make him leave.","能让他离开，真的算是英雄之举。");
 ds_map_add(m,"The guy was really not worth it.","那家伙，实在不值得。");
 ds_map_add(m,"* Starts to cry * Lili, why-why aren't you defending me Li-like always.","*开始哭泣*莉莉，为、为什么不像往、往常那样替我说话？");
 ds_map_add(m,"I hope you can handle more than one since I need to speed things up.","希望你不只撑得住一次，得加快进度了。");
 ds_map_add(m,"Undress and get on the trunk.","脱光，爬到树干上。");
 ds_map_add(m,"And I will not do anything to you, for being efficient minions.","至于你们，办事还算利落，就不动你们了。");
 ds_map_add(m,"( D: I should have prayed to the fairy goddess too )","（D:早知道，也该向仙子女神祈祷。）");
 ds_map_add(m,"Oh shit, he looks at us!","靠，他看过来了！");
 ds_map_add(m,"See that wizard? he come here every night to practice his magic.","看见那个巫师了吗？每晚都来这里练习魔法。");
 ds_map_add(m,"Wha-what do you mean?","什、什么意思？");
 ds_map_add(m,"Right Line? Line? are you hearing me idiot!","对吧，莱茵？莱茵？白痴，有没有听见我说话！");
 ds_map_add(m,"Now Line give him the final attack.","现在，莱茵，给他最后一击。");
 ds_map_add(m,"Oh ok, and what will we do? If we forcefully pass the other guards will escape.","哦，好，那怎么办？要是硬闯，其他守卫就会逃走。");
 ds_map_add(m,"Sorry dude in the last sabbath i was with her HAHAHA","抱歉，哥们，上次魔宴，我就跟她在一起，哈哈哈。");
 ds_map_add(m,"Dude why do you have to do every conversation so weird?","哥们，怎么每次说话，都能弄得这么奇怪？");
 ds_map_add(m,"Ohhh now I want to be with Kor the orc guard they told me she massive tits.","哦——现在想找那个兽人守卫柯尔了，听说她奶子大得惊人。");
 ds_map_add(m,"Nothing to do the great captain gave us this as punishment.","没办法，大队长罚我们干这个。");
 ds_map_add(m,"No, but if you wanted to hear a conversation of who has it bigger then yes.","没有，不过要想听谁的更大，那倒是有。");
 ds_map_add(m,"I-If there is anything I can help you with just let me know.","有、有什么帮得上忙的，尽管说。");
 ds_map_add(m,"Ah, I think I twisted my ankle in the fight.","啊，打架时，好像把脚踝扭了。");
 ds_map_add(m,"Dont worry you didn't know.","没关系，之前又不知道。");
 ds_map_add(m,"Wow, that idea, may just be crazy enough, to get us all killed!","哇，这主意可真够疯狂的，说不定能把咱们全害死！");
 ds_map_add(m,"This is all I can offer to help you find her house.","要帮你找到她家，我能提供的，就这么多了。");
 ds_map_add(m,"I really can not imagine a succubus being bored in that place.","实在想不出，一个魅魔待在那种地方，还能觉得无聊。");
 ds_map_add(m,"Sieki, why did you call us to this place?","茜姬，为什么把我们叫到这儿？");
 ds_map_add(m,"Think what you want but if you want to see your destiny you know where I am.","随你怎么想，真想看看自己的命运，知道去哪儿找我。");
 ds_map_add(m,"How interesting, I have never met an elf succubus in my life.","真有意思，这辈子还没见过精灵魅魔。");
 ds_map_add(m,"Excellent our destinations were fulfilled, it was strangely pleasant.","太好了，我们的命运都应验了，意外地令人愉悦。");
 ds_map_add(m,"Oh, well it is better than nothing I guess.","哦，好吧，总比没有强。");
 ds_map_add(m,"Hey hero! Half price divination, you don't have to thank me hehe.","嘿，英雄！占卜半价，不用谢，嘿嘿。");
 ds_map_add(m,"Hey, who's there?","喂，谁在那里？");
 ds_map_add(m,"Finally it was so packed...","总算来了，刚才挤死了……");
 ds_map_add(m,"Really? I-I can explain it again, I have no proble-","真的？可、可以再解释一次，不麻——");
 ds_map_add(m,"... Th-thank you very much.","……谢、谢谢。");
 ds_map_add(m,"Do not worry, I think I can help so that no one else knows about this.","别担心，应该能帮忙，让这件事不被别人知道。");
 ds_map_add(m,"I AM FUTABA YOUR TRUSTED FUTANARI, OFFICIAL PURPLECRIT COMMUNICATOR!","我就是双叶，你信得过的扶她，PURPLECRIT官方通讯员！");
 ds_map_add(m,"Ah, you are famous?","啊，你很有名？");
 ds_map_add(m,"Ahh... I-I can't trust anyone if this gets out my career will die.","啊……不、不能相信任何人，传出去，事业就全毁了。");
 ds_map_add(m,"Thank you so much.","真的太感谢了。");
 ds_map_add(m,"Whatever, it was a thing of the past I will report the mission as accomplished.","算了，已经过去了，就汇报任务完成。");
 ds_map_add(m,"You seem to appreciate her a lot.","你似乎很珍惜她。");
 ds_map_add(m,"All the guards escaped without major problem.","所有守卫都逃走了，没出什么大问题。");
 ds_map_add(m,"Shiet Line it's time to intervene!","靠，莱茵，该插手了！");
 ds_map_add(m,"I was sent to Investigate the disappearance of the guards by the great captain!","大队长派我来，调查守卫失踪的事！");
 ds_map_add(m,"... does not matter how.","……怎么做到的，不重要。");
 ds_map_add(m,"It look like they were doing more thang just hanging out.","看来，他们可不光是在闲逛。");
 ds_map_add(m,"Good, that's slutty now bark how happy you are!","很好，够骚，现在叫两声，告诉大家你有多开心！");
 ds_map_add(m,"Now we just have to find proof of what is going on here.","现在，只要找到这里到底出了什么事的证据。");
 ds_map_add(m,"I don't want to know.","不想知道。");
 ds_map_add(m,"That' s enough! go to the goddamn bathroom.","够了！去那该死的厕所。");
 ds_map_add(m,"Hey, I don't have those tas!","喂，我才没有那种癖好！");
 ds_map_add(m,"I can't let anyone pass.","不能让任何人过去。");
 ds_map_add(m,"Ohh Lili I can't hold on any longer.","哦，莉莉，实在憋不住了。");
 ds_map_add(m,"I am sorry sir, but we need a bathroom urgently for my friend.","对不起，先生，朋友急需一个厕所。");
 ds_map_add(m,"I will, but not because you told me to.","会去，不过不是因为你叫我去。");
 ds_map_add(m,"Now how do we get him to leave his post?","现在，怎么让他离开岗位？");
 ds_map_add(m,"Line we have to look for the rest of the arcs and burn them all.","莱茵，得找到剩下的阿克，一把火全烧了。");
 ds_map_add(m,"We will take everything as evidence.","所有东西，都当证据带走。");
 ds_map_add(m,"They seem to be in a hurry.","看起来，他们很着急。");
 ds_map_add(m,"Unfortunately Vasuki Line and Lili end up cornered.","不幸的是，瓦苏基、莱茵和莉莉，最终被逼进了死角。");
 ds_map_add(m,"Vasuki incinerates all the arcs before the guards arrive.","守卫赶到前，瓦苏基烧毁了所有阿克。");
 ds_map_add(m,"We have already made this far we have to burn it all down.","既然都到这一步了，就得全部烧光。");
 ds_map_add(m,"Whatever it takes for those women to get paid. :c","只要能让那些女人拿到工钱，做什么都行。:c");
 ds_map_add(m,"Sorry but both will have to go to the jail-farm.","抱歉，两位都得去监狱农场。");
 ds_map_add(m,"An-and what about th-the guards with the white dust in their hands?","可、可那些手上有白粉的守卫，又、又是怎么回事？");
 ds_map_add(m,"What, but what do you need dental records for??","什么，可为什么需要牙科档案？？");
 ds_map_add(m,"B-but what about the women and the dental records, weren't they selling them?!","可、可那些女人和牙科档案呢，不是在贩卖她们吗？！");
 ds_map_add(m,"I'm not an idiot before I heard the rumors I took a closer look at this house.","我又不傻，听到那些传闻之前，就把这间屋子仔细查过了。");
 ds_map_add(m,"We trusted you great captain but what you are doing here is simply dreadful.","我们信任你，大队长，可你在这里做的事，简直令人发指。");
 ds_map_add(m,"But as long as we don't touch them we'll be fine, right?","不过，只要不碰，就没事，对吧？");
 ds_map_add(m,"Mmm yes line. but there is something strange.","嗯，莱茵，不过有点奇怪。");
 ds_map_add(m,"*The flower starts to shake* Eh?","*花开始颤动*咦？");
 ds_map_add(m,"Are you ok Bell?!","没事吧，贝尔？！");
 ds_map_add(m,"Oh OHH, this tingling sensation all over my body.","哦，哦——浑身上下，都在发麻。");
 ds_map_add(m,"Ah Line this is not good.","啊，莱茵，这可不妙。");
 ds_map_add(m,"Thank you so much Line I don't know how I could return the favor.","太谢谢了，莱茵，真不知道该怎么报答。");
 ds_map_add(m,"maybe two penises, like shark men?","也许有两根阴茎，像鲨鱼人那样？");
 ds_map_add(m,"great let's get moving? I-i don't have a whole lot of time...~","太好了，快点行动？没、没多少时间……~");
 ds_map_add(m,"Hot? why do you need a werewolf to cool down?","热？为什么得找个狼人，才能凉快？");
 ds_map_add(m,"Are we really ganna do this again? *Crosses arms*","真要再来一遍？*抱起双臂*");
 ds_map_add(m,"Oh no! there are dangerous werewolves on the loose?","哦，不！有危险的狼人跑出来了？");
 ds_map_add(m,"A potion that dose nothing, come one its gatta do soooomething.","什么效果都没有的药？拜托，总得有点用吧。");
 ds_map_add(m,"We just saw you and wanted to see what you were working on.","刚看见你，想来看看你在忙什么。");
 ds_map_add(m,"Did you get the materials Line?","材料找齐了吗，莱茵？");
 ds_map_add(m,"Line Lili and Naoki wait for the werewolves.","莱茵、莉莉和直树，等着狼人到来。");
 ds_map_add(m,"It is very tempting especially for that last part~","很诱人，尤其是最后那部分~");
 ds_map_add(m,"You want to help me hunt down and subdue a werewolf? That's all we needed.","想帮我猎捕、制服一只狼人？正缺这个。");
 ds_map_add(m,"Great, give me the ingredients and I'll do the rest.","太好了，把材料交给我，剩下的我来。");
 ds_map_add(m,"Oh yes.. we tranquilized the werewolves or something like that.","哦，对，把狼人安抚下来了，差不多吧。");
 ds_map_add(m,"It seems that the scent is coming from down here.","香味好像从下面传来。");
 ds_map_add(m,"Yes, do not worry, I fell in these plants by luck.","嗯，别担心，幸好摔到了这些植物上。");
 ds_map_add(m,"Aww dear you don't know much about succubus do you?","哎呀，亲爱的，对魅魔了解得不多吧？");
 ds_map_add(m,"Wait you were looking for me?","等等，在找我？");
 ds_map_add(m,"Come to my house darling, you still haven't regained all your strength.","到家里来吧，亲爱的，力量还没完全恢复呢。");
 ds_map_add(m,"Uhhhh I think so.","呃，应该是。");
 ds_map_add(m,"Not the books you would expect from a succubus.","不像是会出现在魅魔家里的书。");
 ds_map_add(m,"didn't you ask me to help you do new things?","不是求我，带你做点新鲜事吗？");
 ds_map_add(m,"Are you going to steal one?","你要偷一本？");
 ds_map_add(m,"how strange this must have been purchased before the cave collapse.","真奇怪，这个肯定是洞窟坍塌前买的。");
 ds_map_add(m,"Just volunteer as a guard and we'll have our girls night out. <3","去报名当守卫，然后我们就能过个女生之夜了。<3");
 ds_map_add(m,"haha it will be just like home.","哈哈，会跟家里一样。");
 ds_map_add(m,"Oh well I ran into my husband in town haha I haven't seen him in a long time. ","哦，在镇上碰见丈夫了，哈哈，好久没见了。 ");
 ds_map_add(m,"Thank you Marael for inviting us to your home.","玛拉艾尔，谢谢你请我们来家里做客。");
 ds_map_add(m,"If so, Sieki is helping by taking easy and desperate prey like us!","要是这样，茜姬帮忙，就是把我们这种绝望、好下手的人，当猎物抓走！");
 ds_map_add(m,"Shit you remember when you fell, you fell in a bed of flowers!","靠，还记得摔下来时吗？你摔进了花丛里！");
 ds_map_add(m,"Lili, do not you think there is something odd going on here?","莉莉，不觉得这里，有些不对劲吗？");
 ds_map_add(m,"Uff at least she is not a crazy psychopath.","呼，至少不是个疯狂杀人魔。");
 ds_map_add(m,"I am so sorry I didnt want to come to this I am very sorry for your husband.","真的对不起，没想过会闹成这样，你丈夫的事，实在很遗憾。");
 ds_map_add(m,"YO-YO-YOU WANT ME TO EAT YOUR PLUM, WARM, MOIST,PIE!","你、你、你想让我吃你的李子馅饼，又温热、又湿润的馅饼！");
 ds_map_add(m,"OHhh Line haha, you're so excited, you told me mom how cute you are <3","哦，莱茵，哈哈，太兴奋了吧，居然喊我妈妈，真可爱<3。");
 ds_map_add(m,"Just act normal and stop looking at her ass! *whispering*","表现正常点，别再盯着她的屁股！*低声*");
 ds_map_add(m,"Wake up Line! you really want to find Ava! *whispering*","清醒点，莱茵，还想不想找到艾娃了！*低声*");
 ds_map_add(m,"It is. Let's look around the house for more clues now that she's asleep.","确实。趁她睡着，到屋里再找找线索。");
 ds_map_add(m,"Very well I'm going to go to my room to sleep good night. <3","好，回房间睡觉了，晚安。<3");
 ds_map_add(m,"Yeah, for better or for worse.","是啊，无论好坏。");
 ds_map_add(m,"And the boxes that cover the door are gone.","还有，挡门的那些箱子没了。");
 ds_map_add(m,"I guess I am doing it for me too, so I will not fail to help her.","我想，也是为了自己，所以绝不会放弃帮她。");
 ds_map_add(m,"If Line gets a large amount of match in a fight, Lewdserker will be activated.","如果莱茵在一场战斗中，达成大量消除，就会进入淫欲狂战状态。");
 ds_map_add(m,"But she was sadder than usual, she just did not seem to be helping anyone.","可她比平时更难过，看起来，也没能帮上任何人。");
 ds_map_add(m,"darling you need to get out of here, then we can talk more calmly about this.","亲爱的，先离开这里，之后再冷静地谈这件事。");
 ds_map_add(m,"I used my last strength to summon some tentacles and take her to bed.","用最后的力气，召出了几条触手，把她带上床。");
 ds_map_add(m,"But I honestly don't think she has the power to grant wishes.","不过说实话，不觉得她真有实现愿望的能力。");
 ds_map_add(m,"I will take the relic and say that I found it in the forest.","我会拿走圣物，就说是在森林里发现的。");
 ds_map_add(m,"I-I just wanted to start a family raise my children and go out with my husband!","只、只是想成个家，养育孩子，跟丈夫一起出门！");
 ds_map_add(m,"I never met anyone who saw me more than a succubus.","从来没人看见魅魔之外的那个我。");
 ds_map_add(m,"*Gulp* I'm going to get out of the carriage, I'll wait for you outside Line. :v","*咽口水*先下马车，在外面等你，莱茵。:v");
 ds_map_add(m,"Wh-who are you Lemmy's mistress?!","你、你是谁，雷米的女主人？！");
 ds_map_add(m,"AHhhhh the key is absorbing that thing.","啊——钥匙正在吸收那东西。");
 ds_map_add(m,"It is quite big here, what's that?!","这里挺大的，那个是什么？！");
 ds_map_add(m,"Wait! Is it too late to forget about this?","等等！现在反悔，还来得及吗？");
 ds_map_add(m,"AHhh what did he say?","啊，他说了什么？");
 ds_map_add(m,"...Ahh fine, at least it's cheaper than the vip under the bar.","……啊，好吧，至少比酒吧底下的贵宾便宜。");
 ds_map_add(m,"What?! You saw what was in the briefcase!","什么？！看过公文包里的东西了！");
 ds_map_add(m,"Gilfried we found your briefcase.","吉尔德弗里德，找到你的公文包了。");
 ds_map_add(m,"The Pelletclad Blade.","弹丸之刃。");
 ds_map_add(m,"Let's go get it, before you get scolded again for yelling and screaming.","去拿吧，免得又因为大喊大叫挨骂。");
 ds_map_add(m,"Do you want to look for the sword?","想去找那把剑？");
 ds_map_add(m,"Yes but how many have a story written about them.","是啊，可有几把剑，能有个专门为它写的故事？");
 ds_map_add(m,"Please tell me you don't believe this.","拜托，别告诉我，你真信了。");
 ds_map_add(m,"I don't think entering the church without permission is good idea.","不经允许就进教堂，好像不太好。");
 ds_map_add(m,"Let's give you the good news","去告诉她这个好消息。");
 ds_map_add(m,"Hey let's go see Marael in theory everything has been solved.","嘿，去看看玛拉艾尔吧，按说事情都已经解决了。");
 ds_map_add(m,"Mmm my head hurts a little.","嗯，头有点疼。");
 ds_map_add(m,"Go away champion.","走吧，冠军。");
 ds_map_add(m,"Ohhhh YES ahhh. Wh-What are you doing here?!","哦——对，啊。你、你怎么会在这里？！");
 ds_map_add(m,"Slup shlup-shhhp shlup.","啾，啾噜，吸溜，啾噜。");
 ds_map_add(m,"Easy she'll never know * stroking his penis.","放轻松，她永远不会知道。*抚摸他的阴茎*");
 ds_map_add(m,"No, I-I don't want to, I-I'll stay here.","不，不、不要，我、我就待在这儿。");
 ds_map_add(m,"Stop meddling in my life, I'll only do what I'm made for, now get out!","别再插手我的生活！只会做天生该做的事，现在滚出去！");
 ds_map_add(m,"But how, if you are a criminal, how did you end up as a guard?","可是，你不是罪犯吗，怎么成了守卫？");
 ds_map_add(m,"...Unfortunately, that can't be done right now. She is currently imprisoned.","……可惜，现在做不到。她目前被囚禁了。");
 ds_map_add(m,"H-h-how do you kn-know my name?","你、你、你怎么知、知道我的名字？");
 ds_map_add(m,"We were waiting for you, Line.","我们一直在等你，莱茵。");
 ds_map_add(m,"What, what thing?","什么，什么东西？");
 ds_map_add(m,"Hey, you do not feel that?","喂，没感觉到吗？");
 ds_map_add(m,"*clenches his fist in anger* I swear that woman will pay for this.","*愤怒地攥紧拳头*发誓，一定要让那女人付出代价。");
 ds_map_add(m,"NOW, BOTH OF YOU STOP!","现在，你们两个都给我停下！");
 ds_map_add(m,"Enough of both of you!","你们两个，都够了！");
 ds_map_add(m,"I-I am doing it!","我、我在做了！");
 ds_map_add(m,"Open it! open it now!","打开！现在就打开！");
 ds_map_add(m,"Well you found Gilfried's briefcase now we just have to return it.","好了，吉尔德弗里德的公文包找到了，接下来只要还回去。");
 ds_map_add(m,"B-but, I told you that. Ahh whatever.","可、可那明明是我告诉你的。啊，算了。");
 ds_map_add(m,"You are in another level Softy, you beat every single bitch in here.","软妹，你都不是一个档次的，这里每个婊子都被你打败了。");
 ds_map_add(m,"Let's get the fuck out of here line!","莱茵，赶紧离开这鬼地方！");
 ds_map_add(m,"I will not forgive you for all the people you hurt!","那些被你伤害的人，我绝不会替他们原谅你！");
 ds_map_add(m,"You are wrong I don't want to absorb an inferior version of myself.","错了，才不想吸收一个比自己更差的版本。");
 ds_map_add(m,"What are you doing here? You're going to get yourself killed!","在这里做什么？会被杀的！");
 ds_map_add(m,"Thank you Mr. Vasera I will do my best with the armor. <3","谢谢，瓦瑟拉先生，会尽力用好这套盔甲。<3");
 ds_map_add(m,"Is the remainder of my clone's armor.","这是我分身盔甲剩下的部分。");
 ds_map_add(m,"Lili... say.. something .","莉莉……说……句话。");
 ds_map_add(m,"Then I was wrong about you, you're just an elf trying to be a succubus.","那就是看错你了，不过是个想假扮魅魔的精灵。");
 ds_map_add(m,"Sometimes you have to be the dominant one.","有时候，也得当支配别人的那一个。");
 ds_map_add(m,"I am sorry for what I said before.","之前说的那些话，对不起。");
 ds_map_add(m,"Line you want to earn some money just give some good smoosh <3!","莱茵，想赚点钱，给客人来几个舒服的亲亲就行<3！");
 ds_map_add(m,"Oh... Don't worry Line, you didn't do too bad.","哦……别担心，莱茵，做得也没那么差。");
 ds_map_add(m,"But why are they doing that?","可他们为什么那样做？");
 ds_map_add(m,"Watch out for that slime.","小心那只史莱姆。");
 ds_map_add(m,"What, what's wrong?!","怎么，怎么了？！");
 ds_map_add(m,"Watch out Line! be on the alert!","小心，莱茵，提高警惕！");
 ds_map_add(m,"Maybe she stole it","也许是她偷的。");
 ds_map_add(m,"Mmmm it had a key inside.","嗯，里面有把钥匙。");
 ds_map_add(m,"What's wrong Line?","怎么了，莱茵？");
 ds_map_add(m,"Then they will get back on their feet and fight with the same energy as before?","然后，它们又会站起来，跟刚才一样精力充沛地打架？");
 ds_map_add(m,"Be careful this place looks in very bad shape we don't know what could happen.","小心，这地方破得很，不知道会出什么事。");
 ds_map_add(m,"This gives me a bad vibe.","感觉不太妙。");
 ds_map_add(m,"You won't be alone in this Red count me in!","不会让你独自承担的，雷德，算我一个！");
 ds_map_add(m,"We are finished.","我们完了。");
 ds_map_add(m,"And now the hero of the island will deliver us to justice.","现在，岛上的英雄要把我们绳之以法了。");
 ds_map_add(m,"Unwanted children born and end up on the streets to survive on its own.","没人要的孩子，一出生就流落街头，只能自己想办法活下去。");
 ds_map_add(m,"Well they don't do a great job even we live better.","看来做得真不怎么样，连我们都过得比这强。");
 ds_map_add(m,"And to make matters worse, they found our hideout.","更糟的是，还让人找到了藏身处。");
 ds_map_add(m,"We are running out of money.","钱快用光了。");
 ds_map_add(m,"Hey Line, will you really accept this offe-?","喂，莱茵，真要答应这个条——？");
 ds_map_add(m,"But you do not have money, what could you give us?","可你们没有钱，又能拿什么给我们？");
 ds_map_add(m,"Wait! all is not lost, we gain some more time with your 3.000 Arcs!","等等！还没到绝路，有你那3,000阿克，就能再多撑一阵！");
 ds_map_add(m,"Wait here girls I think I have the solution to all this.","姑娘们，在这里等，觉得有办法了。");
 ds_map_add(m,"What, what's wrong?","怎么，怎么了？");
 ds_map_add(m,"I will be a decent guard which is already a lot for this island haha.","我会做个称职的守卫，对这座岛来说，已经很难得了，哈哈。");
 ds_map_add(m,"And I will be the best fortune teller!","我会成为最棒的占卜师！");
 ds_map_add(m,"You will be my role to follow <3.","会把你当作榜样<3。");
 ds_map_add(m,"We will follow you until the end.","我们会追随你，直到最后。");
 ds_map_add(m,"I say the same Red.","我也一样，雷德。");
 ds_map_add(m,"It's more than we deserve.","这比我们应得的，还要多。");
 ds_map_add(m,"Thank you very much hero.","太感谢了，英雄。");
 ds_map_add(m,"Well it looks like the day has finally arrived girls.","好吧，姑娘们，这一天终于来了。");
 ds_map_add(m,"You will take my place over my filthy, pissing corpse!","想取代我，先踩过我这具又脏、又尿淋淋的尸体！");
 ds_map_add(m,"I will, this is one more step towards becoming a true succubus!","会做到的，这是成为真正魅魔的又一步！");
 ds_map_add(m,"The most I can give you is Arcs since you don't owe me anything anymore.","既然已经不欠我什么了，最多就只能给你阿克。");
 ds_map_add(m,"Believe me she plays dumb but she really is smart... sometimes.","相信我，她装傻罢了，其实很聪明……偶尔。");
 ds_map_add(m,"Well, this place is useless if you have a stomach ache.","嗯，要是肚子疼，这里就完全没用了。");
 ds_map_add(m,"MMmmmm I can sing but I am not the best, here goes.","嗯，会唱歌，不过唱得不算好，开始吧。");
 ds_map_add(m,"Ready, now what do I open my mouth? AHHHHHHHH.","准备好了，现在张嘴吗？啊——。");
 ds_map_add(m,"Well then, what now?","好吧，接下来呢？");
 ds_map_add(m,"Phew, a lot of pee, and what a strong smell, hehe.","呼，好多尿，味道也真重，嘿嘿。");
 ds_map_add(m,"*Crowd* EHHHHHHH THAT'S THE WAY TO TALK, THAT'S OUR FUTURE IDOL!!!!","*观众*哦——说得好，这就是我们未来的偶像！！！！");
 ds_map_add(m,"Yes, don't worry, I'll stay with her while she recovers.","放心，会陪着她，直到恢复过来。");
 ds_map_add(m,"No, I cannot pee in a new place if Lili does not hold my hand ;c.","不，莉莉不牵着手，在陌生地方，就尿不出来;c。");
 ds_map_add(m,"No-no, I can stand on my feet.","不、不用，自己站得住。");
 ds_map_add(m,"Wha-what's going on?","怎、怎么回事？");
 ds_map_add(m,"Hey Line wake up!","喂，莱茵，醒醒！");
 ds_map_add(m,"I know you think I am a fool, so I want you to see this.","知道你觉得我傻，所以才想让你看看这个。");
 ds_map_add(m,"This is really embarrassing and lame.","这真的又尴尬，又丢人。");
 ds_map_add(m,"But it is normal to do such a thing at your age, Aldo.","不过，在你这个年纪，做这种事很正常，阿尔多。");
 ds_map_add(m,"Ahh! what are you doing here?!","啊！怎么在这里？！");
 ds_map_add(m,"We laughed and talked at the table and it was really a wonderful time.","我们在餐桌旁有说有笑，真的度过了一段美好的时光。");
 ds_map_add(m,"or because I can't have sex with her right now.","或者，是因为现在没法跟她做爱。");
 ds_map_add(m,"I turned away and held back my tears as best I could.","转过身，拼命忍住眼泪。");
 ds_map_add(m,"I don't invite you to have sex and even less if one of my children is at home.","不是叫你来做爱的，更不可能在孩子还在家的时候。");
 ds_map_add(m,"I was so frustrated that my mind was filled with lassive thoughts.","心里憋得难受，脑中全是下流的念头。");
 ds_map_add(m,"But that was it, then she turned off the light and nothing else happened.","可也就这样了，接着她关掉灯，什么都没再发生。");
 ds_map_add(m,"I need to fix everything in private.","得私下把一切处理好。");
 ds_map_add(m,"*whispers* Hey, does mom know about you being a succ-?","*低语*喂，妈妈知道你是魅——？");
 ds_map_add(m,"Hey, you're not masturbating thinking about him, are you?!","喂，不会在想着他自慰吧？！");
 ds_map_add(m,"Hey?! Line what are you doing!","喂？！莱茵，在干什么！");
 ds_map_add(m,"Ohh... A-ALdo... Drop your pants.","哦……阿、阿尔多……把裤子脱了。");
 ds_map_add(m,"What-e-? that didn't happen.","什、什么？没发生过那种事。");
 ds_map_add(m,"What, when? I never said to come to the bathroom and run your penis up my ass!","什么，什么时候？从没说过，让你到浴室来，把阴茎塞进我屁股里！");
 ds_map_add(m,"Aldo, what are you doing here?","阿尔多，你怎么在这里？");
 ds_map_add(m,"Hi Love eh, this is not what it really looks like haha...ha.","嗨，亲爱的，呃，事情不是看起来这样，哈哈……哈。");
 ds_map_add(m,"TAKE THIS MAMA ACCEPT MY CHILD IN YOUR WOMB!","接好了，妈妈，让我的孩子，住进你的子宫！");
 ds_map_add(m,"More, HARDER Aldo! STRONGEREEEEEEEEEEEEEEE CLAIM ME AS YOURS!","再来，用力点，阿尔多！再用力——把我变成你的！");
 ds_map_add(m,"You finally came","总算来了。");
 ds_map_add(m,"... Callie asked where you were, you better go see her.","……卡莉刚才在问你去哪儿了，最好去见见她。");
 ds_map_add(m,"NOOO! This cannot end here!","不——！不能在这里结束！");
 ds_map_add(m,"Hey! You're the one behind all this!","喂！原来一切都是你干的！");
 ds_map_add(m,"Wha-what is all this blood?","这、这么多血，怎么回事？");
 ds_map_add(m,"This thing needs to be taken care of first!","先解决这东西！");
 ds_map_add(m,"Are you done talking? surrender to Eleonor and bring her back to life!","说完了？臣服于埃莉诺，让她复活！");
 ds_map_add(m,"And if you are compatible you will end up becoming that psychopath's wife.","要是相容，最后就会变成那个疯子的妻子。");
 ds_map_add(m,"El-eleonor yo-you changed we are so close to your resurrection.","埃、埃莉诺，你、你变了，离复活已经那么近了。");
 ds_map_add(m,"'Do you really think your life is worth more than all those women!?'","“难道真觉得，自己的命，比那些女人的命加起来还重要！？”");
 ds_map_add(m,"Raise your hands and come with me.","举起手，跟我走。");
 ds_map_add(m,"Do not let him get into your head Line, he is responsible for all of this.","别让他影响你，莱茵，这一切，全是他的责任。");
 ds_map_add(m,"M-my intention was only t-to incapacitate her, I did not think she woul-","只、只是想让她失、失去行动能力，没想到，她会——");
 ds_map_add(m,"If we do everything right, there should be no problems.","只要一切做对，就不该出问题。");
 ds_map_add(m,"AH decide woman!","啊，做个决定吧，女人！");
 ds_map_add(m,"NO, stop! don't leave!","不，停下！别走！");
 ds_map_add(m,"What? oh no this is very bad I'm so sorry.","什么？哦，不，太糟糕了，实在很抱歉。");
 ds_map_add(m,"I think it comes from the ventilation.","好像是从通风口传来的。");
 ds_map_add(m,"There is not much time this is what you should do.","时间不多，听好，该这么做。");
 ds_map_add(m,"Mommy!!! I love my Mommy!!!","妈妈！！！我爱妈妈！！！");
