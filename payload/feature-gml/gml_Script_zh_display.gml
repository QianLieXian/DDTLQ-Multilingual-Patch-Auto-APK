 ds_map_add(m,"Wow, you weren't lying, you two are really strong.","哇，你没说谎，你们两个真的很强。");
 ds_map_add(m,"Lili what do we do?","莉莉，我们怎么办？");
 ds_map_add(m,"Thank you very much you are very kind <3.","太感谢了，你真好<3。");
 ds_map_add(m,"Yes, Thanks for helping me, I didn't have any more energy to fight.","嗯，谢谢你帮我，我已经没力气继续战斗了。");
 ds_map_add(m,"But I do not understand, why do all that?","可我不明白，为什么要做那些事？");
