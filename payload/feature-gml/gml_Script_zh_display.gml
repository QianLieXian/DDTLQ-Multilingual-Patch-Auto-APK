 ds_map_add(m,"This time Uhgg, I do not think so.","这次，呃，我觉得不行。");
 ds_map_add(m,"Best of luck girls...","姑娘们，祝你们好运……");
 ds_map_add(m,"Shit... you watch the cameras and give me the signal to close the doors.","妈的……你看监控，给我关门信号。");
