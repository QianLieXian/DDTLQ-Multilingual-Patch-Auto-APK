 ds_map_add(m,"Lili talks to you.","莉莉找你说话。");
 ds_map_add(m,"Go back with Callie daugther","回去找卡莉的女儿。");
 ds_map_add(m,"Find the FoxLady","找到狐女。");
 ds_map_add(m,"talk to the victim guard.","与遇袭的守卫交谈。");
 ds_map_add(m,"Go to Baina's room at night.","夜里去拜娜的房间。");
 ds_map_add(m,"talk with the great Captain.","与大队长交谈。");
 ds_map_add(m,"Talk to Callie (the saleswoman in the red store)","与卡莉交谈（红色商店的售货员）。");
 ds_map_add(m,"Finishing the job","完成工作");
 ds_map_add(m,"Talk to the fisherman.","与渔夫交谈。");
 ds_map_add(m,"Give the fish to the catlady.","把鱼交给猫女。");
 ds_map_add(m,"Search for evidence if Marael hides any secrets.","寻找证据，看看玛拉艾尔是否藏着什么秘密。");
 ds_map_add(m,"Go to marael's house and talk to her.","去玛拉艾尔家，和她谈谈。");
 ds_map_add(m,"Follow the scent of the pie to find Marael.","循着馅饼的香味找到玛拉艾尔。");
 ds_map_add(m,"Help Pussiel clean the second floor.","帮助普茜艾尔打扫二楼。");
 ds_map_add(m,"you asked for a loan for the first time.","第一次申请借款。");
 ds_map_add(m,"Save your game the for the first time.","第一次保存游戏。");
 ds_map_add(m,"The angry shortstack","暴躁的矮个大胸妹");
 ds_map_add(m,"The hero berserker","狂战士英雄");
 ds_map_add(m,"Complete all stages.","完成所有关卡。");
 ds_map_add(m,"Complete a stage with all positive stats.","在所有属性为正的状态下完成一个关卡。");
 ds_map_add(m,"Win your first stage.","赢下第一场关卡战斗。");
 ds_map_add(m,"See a monster naked in the Waifsteary.","在魔物娘图鉴中查看一只魔物的裸体。");
 ds_map_add(m,"To see a monster's damage affinity, you can check it in the Waifsteary.","想了解魔物对各种伤害的抗性，可以查看魔物娘图鉴。");
 ds_map_add(m,"Why is this girl taking so long?","这姑娘怎么去了这么久？");
 ds_map_add(m,"No right now actually.","现在确实不行。");
 ds_map_add(m,"You want a little break cutie","想稍微休息一下吗，小可爱？");
 ds_map_add(m,"Sorry big sis not rigt now.","对不起，大姐姐，现在不行。");
 ds_map_add(m,"A training battle will do.","来场训练战就行。");
 ds_map_add(m,"If only you knew what I was my little fairy.","我的小仙女，你要是知道我以前是什么样就好了。");
 ds_map_add(m,"E-excuse me, did you leave a message to the receptionist for me?","打、打扰一下，是你在前台给我留了话吗？");
 ds_map_add(m,"Mmmm... Hehe ok big Sis I will do my best <3","嗯……嘿嘿，好呀，大姐姐，我会努力的<3");
 ds_map_add(m,"I already know that story.","那个故事我已经听过了。");
 ds_map_add(m,"Oops, you look great but I'll need them back.","哎呀，穿着真好看，不过这些衣服得还给我。");
 ds_map_add(m,"Wow Line those Smoosher outfits?","哇，莱茵，那是斯慕舍餐厅的制服？");
 ds_map_add(m,"All right, come behind the counter.","行，来柜台后面。");
 ds_map_add(m,"I do the basics, cut damage and every so often I upgrade a cut cube.","我会些基础招数，造成斩击伤害，偶尔还能升级一个斩击方块。");
 ds_map_add(m,"I recommend you to improve your life so you don't die with one of my attacks.","建议你先提升生命值，免得挨我一下就死。");
 ds_map_add(m,"Thanks for the help, you need something?","谢谢帮忙，有什么需要的吗？");
 ds_map_add(m,".... Mhmm Sir? please don't kill anyone.","……嗯，先生？请别杀人。");
 ds_map_add(m,"Mr. Vasera, what are you doing here?","瓦瑟拉先生，你怎么在这里？");
 ds_map_add(m,"Que considerado <3","真体贴<3");
 ds_map_add(m,"Please... Help me, I need those crystals to go back home.","求求你……帮帮我，我需要那些水晶才能回家。");
 ds_map_add(m,"Yes please, I have other things to do.","好的，拜托了，我还有别的事。");
 ds_map_add(m,"Sorry, I have other things to do.","抱歉，我还有别的事。");
 ds_map_add(m,"Here, it's 100 Arcs just... dont blow it.","给，100阿克……别搞砸了就行。");
 ds_map_add(m,"What do you care.","关你什么事。");
 ds_map_add(m,"To the ground now!","立刻趴下！");
 ds_map_add(m,"Oh, haha I like the idea but I don't have much time left I have to leave now.","哦，哈哈，这主意不错，不过我没时间了，必须走了。");
 ds_map_add(m,"Please don't bring me bad news.","拜托，别给我带来坏消息。");
 ds_map_add(m,"What are you looking at!?","看什么看！？");
 ds_map_add(m,"*Kamiko grabs Line tightly and kisses her for a long minute*","*神子紧紧抱住莱茵，足足吻了她一分钟*");
 ds_map_add(m,"Hmmm, Aren't you the cutest thing?, just a kiss from you would be enough.","嗯，你怎么这么可爱？给我一个吻就够了。");
 ds_map_add(m,"Excellent lady, have a nice day <3.","太好了，女士，祝你今天愉快<3。");
 ds_map_add(m,"I told you Line, let's capture her maybe the guards give us money.","莱茵，我就说吧，把她抓起来，说不定守卫会给我们赏钱。");
 ds_map_add(m,"Sorry, I cant right now.","对不起，现在不行。");
 ds_map_add(m,"Come back when you have Arcs.","有阿克了再来。");
 ds_map_add(m,"Hey Line you figured out where I keep all my Arcs.","嘿，莱茵，你猜到我把阿克全藏在哪儿了吗？");
 ds_map_add(m,"Please let me explain.","请听我解释。");
 ds_map_add(m,"Yes, yes I understand you, sorry for wasting your time :c.","嗯嗯，我明白。对不起，耽误你时间了:c。");
 ds_map_add(m,"Well you know... fire ehh sacred ... of elf (Iam a terrible liar :C).","那个，你懂的……火，呃，神圣的……精灵的火。（我可真不会撒谎:C。）");
 ds_map_add(m,"OHh hu-hu-hu wha-what kind of experiences do you need.","哦，呵、呵呵，你、你需要什么样的经历？");
 ds_map_add(m,"The world is a better place with you in it, whether you like it or not.","不管你愿不愿意承认，有你在，这个世界就更美好了。");
 ds_map_add(m,"Ya great but I didn't ask you about your life","行，真棒，可我没问你的人生故事。");
 ds_map_add(m,"As I pray I can hear the prayers of women in trouble and bring justice.","祈祷时，我能听见遇难女子的祈求，然后前去伸张正义。");
 ds_map_add(m,"What a brave boy ;c","真勇敢的孩子;c");
 ds_map_add(m,"I was told that I can earn some money by selling my own 'milk'.","听说卖自己的“奶”，就能赚点钱。");
 ds_map_add(m,"What happened to you?","你怎么了？");
 ds_map_add(m,"Oh he doesn't have a cow outfit.","哦，他没有奶牛装。");
 ds_map_add(m,"Line! focus on your objective, we are looking for your friend.","莱茵！专心点，我们是来找你朋友的。");
 ds_map_add(m,"Hi, sweetie, would you like to join me for a drink?","嗨，宝贝，要陪我喝一杯吗？");
 ds_map_add(m,"I wouldn't miss it for anything in the world.","说什么我都不会错过。");
 ds_map_add(m,"*blushed* th-thank you it is a relief that you liked it.","*脸红*谢、谢谢，你能喜欢，我就放心了。");
 ds_map_add(m,"Oh, well if you wan..","哦，要是你想……");
 ds_map_add(m,"Excuse me? that no way of speaking if I were your mother I would punish you.","什么？怎么能这样说话！我要是你妈妈，非罚你不可。");
 ds_map_add(m,"I will do my best I will be worthy of the sword *reverence*.","我会尽力，不辜负这把剑。*行礼*");
 ds_map_add(m,"Thank you very much I will not let you down and I will bring the sword.","太感谢了！我不会让你失望，一定会把剑带来。");
 ds_map_add(m,"Hello sir, are you by any chance the author of The Pelletclad Blade?","你好，先生，请问你是《弹丸之刃》的作者吗？");
 ds_map_add(m,"Looks like a writer?","他看着像作家吗？");
 ds_map_add(m,"Well, it all depends on whether you admire atropomorphic animals like wolves.","嗯，得看你喜不喜欢狼这一类拟人动物。");
 ds_map_add(m,"Mmm I do not know what's in it for me?","嗯，不知道，我有什么好处？");
 ds_map_add(m,"I don't know Line looks like a weirdo.","不知道，莱茵，他看着像个怪人。");
 ds_map_add(m,"OH how cute I love your fluffy little ears <3.","哦，好可爱！你毛茸茸的小耳朵，我太喜欢了<3。");
 ds_map_add(m,"... H-hi e- that's a costume?","……你、你好，呃，那是套扮装服？");
 ds_map_add(m,"No I am still short of money :c.","没有，我的钱还不够:c。");
 ds_map_add(m,"Ohhhh I love it I love it I love it I love it that's all I wanted <3!","哦——好喜欢，好喜欢，好喜欢，好喜欢！就是我想要的<3！");
 ds_map_add(m,"Thank you very much but I am no longer Line now call me Bluebell.","非常感谢，不过我已经不叫莱茵了，现在请叫我蓝铃。");
 ds_map_add(m,"Only the family may enter this sanctuary.","只有家族成员能进入这座圣所。");
 ds_map_add(m,"Come on Run! I bet 1000 Arcs on you Hu HU HU HU HUghg!.","快跑啊！我可在你身上押了1000阿克，呼哈哈哈哈！");
 ds_map_add(m,"Ho hello are you a gorilla?","你、你好，你是大猩猩吗？");
 ds_map_add(m,"Oh I *hip* see, you are allies of the empire trying to erase part of history.","哦，我*嗝*懂了，你们是帝国的同伙，想抹掉那段历史。");
 ds_map_add(m,"Mmm ... n-no, i didn't know i'm half elf half succubus actually.","嗯……不、不是，其实我是半精灵、半魅魔。");
 ds_map_add(m,"Hey, yo skinny girl do something good and bring me some beer *hip*.","喂，那个瘦姑娘，做点好事，给我拿杯啤酒来。*嗝*");
 ds_map_add(m,"Line ... let's get out of here.","莱茵……我们走吧。");
 ds_map_add(m,"I will repair it after a few drinks haha.","喝上几杯，我就去修，哈哈。");
 ds_map_add(m,"So you are the prankster!","原来你就是那个捣蛋鬼！");
 ds_map_add(m,"I guess when he fled he found this cave.","我猜，他逃跑的时候发现了这个洞窟。");
 ds_map_add(m,"Why is it here anyway?","话说，它为什么会在这里？");
 ds_map_add(m,"Oh... could happen to anyone.","哦……谁都有可能遇上。");
 ds_map_add(m,"I hope Whipsie is doing well on Tricotex.","希望薇普茜在特里科特克斯过得好。");
 ds_map_add(m,"This farm reminds me of home.","这个农场，让我想起了家。");
 ds_map_add(m,"Take it for granted me and Line can against everything!","放心吧，我和莱茵联手，什么都能摆平！");
 ds_map_add(m,"Wow really can we help to capture it ?!","哇，真的？我们能帮忙抓它吗？！");
 ds_map_add(m,"H-hi you are Sa-Sam the hero o-of the Tricotex right :O?","你、你好，你是萨、萨姆，特、特里科特克斯的英雄，对吧:O？");
 ds_map_add(m,"sorry same I have other things to do.","对不起，萨姆，我还有别的事。");
 ds_map_add(m,"Sorry same I have other things to do.","对不起，萨姆，我还有别的事。");
 ds_map_add(m,"Let's catch that criminal <3.","去抓那个罪犯吧<3。");
 ds_map_add(m,"I do a lot of magic damage that's all you need to know.","我会造成大量魔法伤害，你知道这些就够了。");
 ds_map_add(m,"I really want to help you Faye.","我真的想帮你，菲伊。");
 ds_map_add(m,"If you want to help me just don't waste my time.","想帮忙，就别浪费我的时间。");
 ds_map_add(m,"I think it's southeast from here.","我想，应该在这儿的东南方。");
 ds_map_add(m,"I know you will, with enough practice you will beat him like I did <3.","你会做到的。只要勤加练习，你也能像我一样打败他<3。");
 ds_map_add(m,"Thanks for the help, traveler.","谢谢帮忙，旅行者。");
 ds_map_add(m,"Besides, I don't think your way of fighting will work for me anyway hahaha.","再说，我觉得你的战斗方式，反正也不适合我，哈哈哈。");
 ds_map_add(m,"Isn't it precious? This river is so peaceful, a perfect view for my retirement.","是不是很美？这条河这么宁静，正适合让我退休后天天欣赏。");
 ds_map_add(m,"If you can get 1000 arcs I'll give you a girlfriend deal hehe.","攒到1000阿克，我就给你来个女友套餐，嘿嘿。");
 ds_map_add(m,"Yes but that was a long time ago.","是啊，不过已经是很久以前的事了。");
 ds_map_add(m,"Oh! I remembered she was in the XXX magazines that your mother had.","哦！想起来了，你妈妈那些色情杂志里有她。");
 ds_map_add(m,"And you already know the prize <3.","奖品你也已经知道了<3。");
 ds_map_add(m,"If you fail to undress I will take off one of your clothes.","要是没能脱掉衣服，我就脱掉你身上的一件。");
 ds_map_add(m,"Oh ok i will waiting here.","哦，好，我在这儿等。");
 ds_map_add(m,"So Line you want to buy ten minute in heaven <3?","所以，莱茵，想买十分钟的天堂之旅吗<3？");
 ds_map_add(m,"haha it looks like you learned a lot <3.","哈哈，看来你学了不少嘛<3。");
 ds_map_add(m,"This sucks, there is no alcohol and everyone thinks I'm a minor.","糟透了，没酒喝，所有人还都以为我没成年。");
 ds_map_add(m,"Excuse me, What the fuck did you say?.","什么？你他妈刚才说什么？");
 ds_map_add(m,"Looks Like you have nowhere to run.","看来你没地方逃了。");
 ds_map_add(m,"I guess you're right thanks that calms me down a bit.","我想你说得对，谢谢，听了心里舒服多了。");
 ds_map_add(m,"Yeah there's no need to fight.","对，没必要打架。");
 ds_map_add(m,"Thank you you are nothing like your fairy friend.","谢谢，你跟你那个仙子朋友可一点也不像。");
 ds_map_add(m,"It has been a tiring day I will go to look for her after a nap.","今天累坏了，我先睡一会儿，醒了再去找她。");
 ds_map_add(m,"Blob blip blop D:!","咕噜咕叽咕噜D:！");
 ds_map_add(m,"Oh Mmmm blup, blep blip?","哦，嗯，咕噜，咕叽咕叽？");
 ds_map_add(m,"Bleb Bleb blub blub bleb.","咕叽咕叽咕噜咕噜咕叽。");
 ds_map_add(m,"Bu-but I do not have much money ;c.","可、可我没多少钱;c。");
 ds_map_add(m,"You are the traveler what are you doing here?!","你就是那个旅行者，怎么跑这里来了？！");
 ds_map_add(m,"Dont worry I will take care of this demond","别担心，这个恶魔交给我。");
 ds_map_add(m,"*Starts to sweat but maintains eye contact *... Crazy, right?","*开始冒汗，却仍强撑着直视对方*……挺离谱吧？");
 ds_map_add(m,"Hmm, the witnesses said the thief went south of the church.","嗯，目击者说，窃贼往教堂南边去了。");
 ds_map_add(m,"Wait, but how is that possible? Why would it be lying there?!","等等，怎么可能？为什么会丢在那里？！");
