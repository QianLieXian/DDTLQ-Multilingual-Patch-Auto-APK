 ds_map_add(m,"(I don't think they dared to turn it on)","（我想，她们应该不敢开机器。）");
 ds_map_add(m,"It seems that we will have to make her speak.","看来，得想办法让她开口了。");
 ds_map_add(m,"Ah go fuck yourself.","啊，去你妈的。");
 ds_map_add(m,"hehe clearly it is Lili.","嘿嘿，当然是莉莉。");
 ds_map_add(m,"What do you want?!","你想干什么？！");
 ds_map_add(m,"If you want, you can go see the criminal while I count the money.","你愿意的话，数钱这段时间，可以去看看那个罪犯。");
 ds_map_add(m,"Oh darling there is no guard here who dares to raise his voice to me.","哦，亲爱的，这里没有哪个卫兵，敢对我大声说话。");
 ds_map_add(m,"I will not tell a soul.","我不会向任何人透露。");
 ds_map_add(m,"But you came and you made me feel so, so good hu-hu.","可你来了，还把我弄得那么、那么舒服，呼呼。");
 ds_map_add(m,"Calm down, I have no grudge towards my little half succubus.","放心，我对自己的小半魅魔，没有怨恨。");
 ds_map_add(m,"Turn on the machine Line see if she shut up.","莱茵，开机器，看看她还能不能闭嘴。");
