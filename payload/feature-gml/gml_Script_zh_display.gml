 ds_map_add(m,"The milk on this island has very strange properties.","这座岛上的牛奶，有着非常奇怪的功效。");
 ds_map_add(m,"* They are becoming more and more aggressive","* 他们越来越咄咄逼人了");
 ds_map_add(m,"* Is it really worth it?","* 这真的值得吗？");
 ds_map_add(m,"* If I change, I will become something less than what I am now?","* 要是改变了，我会变得比现在更不堪吗？");
 ds_map_add(m,"Succubus Gates Open ","魅魔之门已开启 ");
 ds_map_add(m,"Hi, there will be a free show next to the bar fluid heaven go and see it <3","嗨，流蜜天堂酒吧旁边有免费演出，快去看看吧<3");
 ds_map_add(m,"Win the beer drinking competition against Rynn.","在拼酒比赛中战胜琳恩。");
 ds_map_add(m,"Go talk to Marael.","去和玛拉艾尔谈谈。");
 ds_map_add(m,"Collect 3.000 Arcs to help Red, Naga and Cuervo.","攒够3,000阿克，帮助雷德、娜迦和库埃尔沃。");
 ds_map_add(m,"Go back to Marael.","回去找玛拉艾尔。");
 ds_map_add(m,"It looks like Callie wants to talk to you, go to her.","卡莉似乎想找你说话，去见见她吧。");
 ds_map_add(m,"A beautiful family","美满的一家人");
 ds_map_add(m,"Go to the middle of the people in the pee pit.","走到尿池里那群人中间。");
 ds_map_add(m,"Go home and sew your first furrsuit.","回家，缝制你的第一套兽装。");
 ds_map_add(m,"look for a gorilla to teach you how to channel the force like them.","找只大猩猩，学学它们是如何驾驭力量的。");
 ds_map_add(m,"Read the book again for more information on the sword.","再读一遍那本书，了解更多关于剑的事。");
 ds_map_add(m,"Go serve people in the Vip area under the bar at Sieki's booth.","去酒吧下方的贵宾区，在茜姬的摊位接待客人。");
 ds_map_add(m,"Now I'm the top bitch!","现在老娘才是头号骚货！");
 ds_map_add(m,"Find out about the librarian's mysterious disappearance.","调查图书管理员神秘失踪的原因。");
 ds_map_add(m,"Find the stolen relics and return them to the knights of Elira.","找到失窃的圣物，交还给艾莉拉骑士。");
 ds_map_add(m,"Go to the room where Lucy is staying (it's on the second floor of the hotel)","去露西住的房间（在旅馆二楼）。");
 ds_map_add(m,"Go to the table, the voice of the fan will tell you what to do.","走到桌边，粉丝的声音会告诉你该怎么做。");
 ds_map_add(m,"no se que pasa aqui","不知道这里出了什么事");
 ds_map_add(m,"defeat marael to gather the relic.","打败玛拉艾尔，取得圣物。");
 ds_map_add(m,"Go to bed and pretend to be asleep.","上床，装作已经睡着。");
 ds_map_add(m,"Defeat the flower.","击败那朵花。");
 ds_map_add(m,"Look for the flower in the secret place on the magenta swamp.","到洋红沼泽的隐秘地点寻找那朵花。");
 ds_map_add(m,"Defeat the bunny in the Forest.","击败森林里的兔子。");
 ds_map_add(m,"Go to the VIP room under the bar and talk to Sieki.","去酒吧下方的贵宾室，和茜姬谈谈。");
 ds_map_add(m,"Go back and tell Dr.lili that you already turned on the generators.","回去告诉莉莉博士，发电机都已经启动了。");
 ds_map_add(m,"Beat the other Ivy Wilde.","打败另一个艾薇·怀尔德。");
