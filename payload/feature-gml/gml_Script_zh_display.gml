 ds_map_add(m,"I think * sniff sniff * I think I feel better now.","我想，*吸吸鼻子*我想，好多了。");
 ds_map_add(m,"It must have been one of the slaves that manipulates the portal!","肯定是某个操纵传送门的奴隶！");
 ds_map_add(m,"Not now Lili, and how do we give it energy?","现在别说这个，莉莉。那么，该怎么给它补充能量？");
 ds_map_add(m,"Sir we got the crystal.","先生，我们拿到水晶了。");
