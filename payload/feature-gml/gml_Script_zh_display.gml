 ds_map_add(m,"For me, it irritates my cheeks :/.","对我来说，会把两边屁股磨得不舒服:/。");
 ds_map_add(m,"Oh-that was crazy.","哦，刚才太疯狂了。");
 ds_map_add(m,"Ugh... it's ok you can use it.","呃……好吧，你可以用。");
 ds_map_add(m,"But it is only for VIP.","可这只供贵宾使用。");
 ds_map_add(m,"Prieta stop making a scandal and let her use the portals for fuck's sake!","普莉耶妲，别闹了，看在老天的份上，让她用传送门！");
 ds_map_add(m,"Maybe it's in case you get hungry during work.","也许，是怕你工作时饿着。");
 ds_map_add(m,"Let's see, check the table..","看看，检查一下桌子……");
 ds_map_add(m,"Well, here we are.","好，我们到了。");
 ds_map_add(m,"... *struggles not to cry*","……*努力忍住眼泪*");
